# Vault integration (optional)
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_SECRETS_PATH=sentient-factory/dev/api-gateway
VAULT_OVERWRITE_ENV=false

# Database
DATABASE_URL=postgresql://app_user:change_me@localhost:3208/sentient_factory

# JWT Authentication
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Application
PORT=3103
NODE_ENV=development
CORS_ORIGIN=http://localhost:3201

# Redis (BullMQ untuk WA queue, optional)
REDIS_URL=redis://localhost:6379

# WA queue mode (true → enqueue async + retry 3×; false/unset → sync send)
WA_QUEUE_ENABLED=false

# Fonnte WhatsApp gateway (kosong = MockWAProvider)
FONNTE_API_TOKEN=
FONNTE_ACCOUNT_TOKEN=
FONNTE_WEBHOOK_URL=

# Sentry error tracking (optional, kosong = disabled)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Alerting delivery
ALERTING_WA_GROUP_WEBHOOK_URL=
ALERTING_WA_GROUP_WEBHOOK_TOKEN=
ALERTING_WA_PERSONAL_WEBHOOK_URL=
ALERTING_WA_PERSONAL_WEBHOOK_TOKEN=
ALERTING_WA_BAILEYS_ENABLED=false
ALERTING_WA_BAILEYS_AUTH_DIR=
ALERTING_EMAIL_WEBHOOK_URL=
ALERTING_EMAIL_WEBHOOK_TOKEN=
ALERTING_EMAIL_SMTP_HOST=
ALERTING_EMAIL_SMTP_PORT=
ALERTING_EMAIL_SMTP_USER=
ALERTING_EMAIL_SMTP_PASS=
ALERTING_EMAIL_SMTP_SECURE=false
ALERTING_EMAIL_FROM=
ALERTING_SCHEDULER_INTERVAL_MS=60000
ALERTING_DELIVERY_INTERVAL_MS=30000

# Dashboard MyERPPlus MySQL (read-only recommended)
DASHBOARD_MYSQL_HOST=127.0.0.1
DASHBOARD_MYSQL_PORT=3307
DASHBOARD_MYSQL_USER=readonly_user
DASHBOARD_MYSQL_PASSWORD=change_me
DASHBOARD_MYSQL_DATABASE=myerpplus

# Optional absolute path for generated SQL templates
# DASHBOARD_SQL_TEMPLATE_ROOT=/opt/sentient-factory/apps/myerpplus-db-mapping/dashboard-mapping/sql-templates
