  costCenterId                 BigInt?  @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId                   BigInt?  @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId                BigInt?  @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
  projectId                    BigInt?  @map("project_id") // FK -> md_projects (ErpProject)
  metadata                     Json?    @map("metadata")

  registration ErpFaAssetRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("fa_asset_registration_lines")
}

model ErpFaDepreciationRun {
  id         BigInt       @id @default(autoincrement())
  docNumber  String       @unique @map("doc_number")
  legacyCode String?      @map("legacy_code")
  autoNumber String?      @map("auto_number")
  faDocType  ErpFaDocType @default(DEPRECIATION) @map("fa_doc_type")

  branchId       BigInt            @map("branch_id") // FK -> md_branches (ErpBranch)
  runDate        DateTime          @map("run_date") @db.Date
  fiscalPeriodId BigInt            @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  currencyId     BigInt            @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate   Decimal           @map("exchange_rate") @db.Decimal(19, 6)
  description    String?           @map("description")
  status         ErpDocumentStatus @map("status")
  postingStatus  ErpPostingStatus  @map("posting_status")
  postedAt       DateTime?         @map("posted_at") @db.Timestamptz(6)
  ledgerEntryId  BigInt?           @map("ledger_entry_id") // FK -> fin_ledger_entries (posts_dep)
  metadata       Json?             @map("metadata")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  lines ErpFaDepreciationRunLine[]

  @@index([legacyCode])
  @@index([fiscalPeriodId])
  @@index([ledgerEntryId])
  @@index([branchId])
  @@map("fa_depreciation_runs")
}

model ErpFaDepreciationRunLine {
  id                 BigInt  @id @default(autoincrement())
  depreciationRunId  BigInt  @map("depreciation_run_id")
  assetId            BigInt  @map("asset_id")
  lineNo             Int     @map("line_no")
  depreciationNo     Int     @map("depreciation_no")
  depreciationAmount Decimal @map("depreciation_amount") @db.Decimal(19, 4)
  bookValueBefore    Decimal @map("book_value_before") @db.Decimal(19, 4)
  costCenterId       BigInt? @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId         BigInt? @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId      BigInt? @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
  projectId          BigInt? @map("project_id") // FK -> md_projects (ErpProject)
  metadata           Json?   @map("metadata")

  depreciationRun ErpFaDepreciationRun @relation(fields: [depreciationRunId], references: [id], onDelete: Cascade)
  asset           ErpFaAsset           @relation(fields: [assetId], references: [id])

  @@index([depreciationRunId])
  @@index([assetId])
  @@map("fa_depreciation_run_lines")
}

model ErpFaTransfer {
  id         BigInt       @id @default(autoincrement())
  code       String       @unique @map("code")
  legacyCode String?      @map("legacy_code")
  faDocType  ErpFaDocType @default(TRANSFER) @map("fa_doc_type")

  branchId      BigInt            @map("branch_id") // FK -> md_branches (ErpBranch)
  docDate       DateTime          @map("doc_date") @db.Date
  effectiveDate DateTime?         @map("effective_date") @db.Date
  description   String?           @map("description")
  status        ErpDocumentStatus @map("status")
  postingStatus ErpPostingStatus  @map("posting_status")
  metadata      Json?             @map("metadata")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  lines ErpFaTransferLine[]

  @@index([legacyCode])
  @@index([branchId])
  @@map("fa_transfers")
}

model ErpFaTransferLine {
  id               BigInt    @id @default(autoincrement())
  transferId       BigInt    @map("transfer_id")
  assetId          BigInt    @map("asset_id")
  lineNo           Int       @map("line_no")
  fromLocationId   BigInt?   @map("from_location_id") // FK -> md_locations (ErpLocation)
  toLocationId     BigInt?   @map("to_location_id") // FK -> md_locations (ErpLocation)
  fromDepartmentId BigInt?   @map("from_department_id")
  toDepartmentId   BigInt?   @map("to_department_id")
  fromBranchId     BigInt?   @map("from_branch_id") // FK -> md_branches (ErpBranch)
  toBranchId       BigInt?   @map("to_branch_id") // FK -> md_branches (ErpBranch)
  custodian        String?   @map("custodian")
  effectiveDate    DateTime? @map("effective_date") @db.Date
  metadata         Json?     @map("metadata")

  transfer       ErpFaTransfer         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  asset          ErpFaAsset            @relation(fields: [assetId], references: [id])
  fromDepartment ErpFaAssetDepartment? @relation("ErpFaTransferLine_fromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment   ErpFaAssetDepartment? @relation("ErpFaTransferLine_toDepartment", fields: [toDepartmentId], references: [id])

  @@index([transferId])
  @@index([assetId])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@map("fa_transfer_lines")
}

model ErpFaDisposal {
  id         BigInt       @id @default(autoincrement())
  code       String       @unique @map("code")
  legacyCode String?      @map("legacy_code")
  faDocType  ErpFaDocType @default(DISPOSAL) @map("fa_doc_type")

  branchId      BigInt            @map("branch_id") // FK -> md_branches (ErpBranch)
  docDate       DateTime          @map("doc_date") @db.Date
  description   String?           @map("description")
  status        ErpDocumentStatus @map("status")
  postingStatus ErpPostingStatus  @map("posting_status")
  ledgerEntryId BigInt?           @map("ledger_entry_id") // FK -> fin_ledger_entries (derecognition JV)
  metadata      Json?             @map("metadata")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  lines ErpFaDisposalLine[]

  @@index([legacyCode])
  @@index([ledgerEntryId])
  @@index([branchId])
  @@map("fa_disposals")
}

model ErpFaDisposalLine {
  id                BigInt   @id @default(autoincrement())
  disposalId        BigInt   @map("disposal_id")
  assetId           BigInt   @map("asset_id")
  lineNo            Int      @map("line_no")
  disposalType      String   @map("disposal_type")
  proceeds          Decimal? @map("proceeds") @db.Decimal(19, 4)
  gainLossAccountId BigInt?  @map("gain_loss_account_id") // FK -> md_accounts (ErpAccount)
  metadata          Json?    @map("metadata")

  disposal ErpFaDisposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  asset    ErpFaAsset    @relation(fields: [assetId], references: [id])

  @@index([disposalId])
  @@index([assetId])
  @@map("fa_disposal_lines")
}
