model ErpFaAcquisition {
  id         BigInt       @id @default(autoincrement())
  code       String       @unique @map("code")
  legacyCode String?      @map("legacy_code")
  faDocType  ErpFaDocType @default(ACQUISITION) @map("fa_doc_type")

  branchId         BigInt               @map("branch_id") // FK -> md_branches (ErpBranch)
  supplierId       BigInt?              @map("supplier_id") // FK -> md_partners (ErpPartner)
  docDate          DateTime             @map("doc_date") @db.Date
  requisitionId    BigInt?              @map("requisition_id")
  quotationId      BigInt?              @map("quotation_id")
  orderId          BigInt?              @map("order_id")
  currencyId       BigInt?              @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate     Decimal?             @map("exchange_rate") @db.Decimal(19, 6)
  priceMode        ErpPriceMode?        @map("price_mode")
  taxInvoiceNo     String?              @map("tax_invoice_no")
  description      String?              @map("description")
  totalAmount      Decimal?             @map("total_amount") @db.Decimal(19, 4)
  status           ErpDocumentStatus    @map("status")
  postingStatus    ErpPostingStatus     @map("posting_status")
  settlementStatus ErpSettlementStatus? @map("settlement_status")
  settledDate      DateTime?            @map("settled_date") @db.Date
  apPaymentId      BigInt?              @map("ap_payment_id") // FK -> fin_ap_payments (settled_by)
  ledgerEntryId    BigInt?              @map("ledger_entry_id") // FK -> fin_ledger_entries (AP open item)
  metadata         Json?                @map("metadata")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  requisition   ErpFaAssetRequisition?   @relation(fields: [requisitionId], references: [id])
  quotation     ErpFaAssetQuotation?     @relation(fields: [quotationId], references: [id])
  order         ErpFaAssetOrder?         @relation(fields: [orderId], references: [id])
  lines         ErpFaAcquisitionLine[]
  registrations ErpFaAssetRegistration[]

  @@index([legacyCode])
  @@index([requisitionId])
  @@index([quotationId])
  @@index([orderId])
  @@index([apPaymentId])
  @@index([ledgerEntryId])
  @@index([branchId])
  @@map("fa_acquisitions")
}

