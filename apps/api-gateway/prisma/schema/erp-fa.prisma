model ErpFaAsset {
  id         BigInt  @id @default(autoincrement())
  code       String  @unique @map("code")
  name       String  @map("name")
  legacyCode String? @map("legacy_code")

  categoryId    BigInt  @map("category_id")
  tagNumber     String? @map("tag_number")
  linkedItemId  BigInt? @map("linked_item_id") // FK -> md_items (ErpItem)
  branchId      BigInt  @map("branch_id") // FK -> md_branches (ErpBranch)
  locationId    BigInt? @map("location_id") // FK -> md_locations (ErpLocation)
  warehouseId   BigInt? @map("warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  departmentId  BigInt? @map("department_id")
  costCenterId  BigInt? @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId    BigInt? @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId BigInt? @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
  projectId     BigInt? @map("project_id") // FK -> md_projects (ErpProject)

  purchaseDate            DateTime?             @map("purchase_date") @db.Date
  inServiceDate           DateTime?             @map("in_service_date") @db.Date
  quantity                Decimal               @map("quantity") @db.Decimal(19, 4)
  unitId                  BigInt?               @map("unit_id") // FK -> md_units (ErpUnit)
  currencyId              BigInt                @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate            Decimal               @map("exchange_rate") @db.Decimal(19, 6)
  acquisitionCost         Decimal               @map("acquisition_cost") @db.Decimal(19, 4)
  residualValue           Decimal               @map("residual_value") @db.Decimal(19, 4)
  usefulLifeMonths        Int                   @map("useful_life_months")
  monthlyDepreciation     Decimal               @map("monthly_depreciation") @db.Decimal(19, 4)
  accumulatedDepreciation Decimal               @map("accumulated_depreciation") @db.Decimal(19, 4)
  bookValue               Decimal               @map("book_value") @db.Decimal(19, 4)
  depreciationCount       Int                   @map("depreciation_count")
  method                  ErpDepreciationMethod @map("method")
  depreciationTable       String?               @map("depreciation_table")
  isIntangible            Boolean               @default(false) @map("is_intangible")
  isFiscal                Boolean               @default(false) @map("is_fiscal")
  halfMonthConvention     Boolean               @default(false) @map("half_month_convention")
  isDecliningValue        Boolean               @default(false) @map("is_declining_value")

  assetAccountId               BigInt? @map("asset_account_id") // FK -> md_accounts (ErpAccount)
  accumDepreciationAccountId   BigInt? @map("accum_depreciation_account_id") // FK -> md_accounts (ErpAccount)
  depreciationExpenseAccountId BigInt? @map("depreciation_expense_account_id") // FK -> md_accounts (ErpAccount)
  disposalAccountId            BigInt? @map("disposal_account_id") // FK -> md_accounts (ErpAccount)

  manufacturer   String?            @map("manufacturer")
  retirementDate DateTime?          @map("retirement_date") @db.Date
  isDisposed     Boolean            @default(false) @map("is_disposed")
  isLocked       Boolean            @default(false) @map("is_locked")
  status         ErpDocumentStatus  @map("status")
  previousStatus ErpDocumentStatus? @map("previous_status")

  metadata Json? @map("metadata")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  category             ErpFaAssetCategory         @relation(fields: [categoryId], references: [id])
  department           ErpFaAssetDepartment?      @relation(fields: [departmentId], references: [id])
  registration         ErpFaAssetRegistration?    @relation(fields: [registrationId], references: [id])
  registrationId       BigInt?                    @map("registration_id")
  movements            ErpFaAssetMovement[]
  depreciationRunLines ErpFaDepreciationRunLine[]
  transferLines        ErpFaTransferLine[]
  disposalLines        ErpFaDisposalLine[]

  @@index([legacyCode])
  @@index([categoryId])
  @@index([departmentId])
  @@index([registrationId])
  @@index([branchId])
  @@map("fa_assets")
}

model ErpFaAssetMovement {
  id               BigInt               @id @default(autoincrement())
  assetId          BigInt               @map("asset_id")
  movementType     ErpAssetMovementType @map("movement_type")
  sourceDocType    String?              @map("source_doc_type")
  sourceId         BigInt?              @map("source_id")
  docNumber        String?              @map("doc_number")
  movementDate     DateTime             @map("movement_date") @db.Date
  amount           Decimal?             @map("amount") @db.Decimal(19, 4)
  accumulatedAfter Decimal?             @map("accumulated_after") @db.Decimal(19, 4)
  bookValueAfter   Decimal?             @map("book_value_after") @db.Decimal(19, 4)

  costCenterId  BigInt? @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId    BigInt? @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId BigInt? @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
  projectId     BigInt? @map("project_id") // FK -> md_projects (ErpProject)

  status   ErpDocumentStatus @map("status")
  metadata Json?             @map("metadata")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")

  asset ErpFaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, movementDate])
  @@index([sourceDocType, sourceId])
  @@map("fa_asset_movements")
}

