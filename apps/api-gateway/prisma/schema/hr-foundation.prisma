// =====================================================================
// Senti HR (apps/web-hr) — prisma-managed HR schema.
//
// HR live tables (hr_users, hr_worksites, hr_attendance_*, hr_face_*,
// hr_settings …) are raw-SQL, NOT prisma-managed. This file is the FIRST
// prisma-managed HR model, added for the Setting → Tampilan backend
// persistence (1:1 port of ERP `adm_user_preferences`).
//
// Conventions: additive only (0 DROP). Cross-APP reference to the platform
// `User` (m0_users) = scalar Int FK + @@index, NO @relation — keeps this file
// additive (no ALTER on platform.prisma). PK = platform user id (Int, matches
// m0_users.id and the `sub` claim of the sf_token JWT, which is `number`).
//
// ⚠️ The `hr_` prefix is shared with warehouse tables (dim_/obt_/etl_/hr_).
// Hand-write additive migrations + `prisma migrate deploy` only — NEVER
// `prisma migrate dev`/`db push` raw (would risk dropping warehouse tables).
// =====================================================================

// ---------------------------------------------------------------------
// hr_user_preferences — per-user appearance config (Setting → Tampilan).
// Mirrors adm_user_preferences shape: theme/language as columns, the rest of
// the UI tweaks (primary/density/fontScale/sidebar/sidebarMenu/urlRouting)
// stored in `metadata` JSON — exactly what web-hr `use-appearance` sends.
// ---------------------------------------------------------------------
model HrUserPreferences {
  userId    Int      @id @map("user_id")
  theme     String?  @map("theme")
  language  String?  @map("language") @db.VarChar(10)
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("hr_user_preferences")
}
