// ── Report Engine ─────────────────────────────────────────────────────────────
// Custom report templates. Template JSON menyimpan bands, components,
// dan data sources (raw SQL queries) sekaligus.

model ErpRptTemplate {
  id           BigInt    @id @default(autoincrement())
  code         String    @unique @map("code")
  name         String    @map("name")
  module       String    @map("module")
  description  String?   @map("description")
  templateJson Json      @map("template_json")
  // Binds a template to a report (`<module>.<report>`, e.g. `fin.trial-balance`).
  // The matching active template drives that report's PDF; null = unbound (ad-hoc).
  reportKey    String?   @map("report_key")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  BigInt?   @map("created_by_id")
  updatedById  BigInt?   @map("updated_by_id")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([module])
  @@index([isActive])
  @@index([reportKey])
  @@map("rpt_templates")
}

// ── Registry Laporan .mrt (m0_reports) ────────────────────────────────────────
// Katalog satu baris per JENIS laporan hasil ekstraksi/terjemahan template
// Stimulsoft .mrt legacy (instruksi user 2026-10-05). Nama tabel `m0_reports`
// adalah deviasi yang disengaja dari pola DOMAIN_plural CLAUDE.md §1 —
// mewarisi registry legacy MySQL `m0_report`; lihat docs/decisions/reports.md
// (entri "Registry m0_reports — 2026-10-05"). Layout hasil terjemahan tetap
// disimpan di ErpRptTemplate; baris ini menunjuknya via rptTemplateId/reportKey.

model ErpM0Report {
  id                BigInt    @id @default(autoincrement())
  code              String    @unique @map("code")
  legacyModule      String    @map("legacy_module")
  legacyMenu        String?   @map("legacy_menu")
  erpModule         String?   @map("erp_module")
  title             String    @map("title")
  reportName        String    @map("report_name")
  filename          String    @map("filename")
  sourceRelPath     String    @map("source_rel_path")
  variantFiles      Json      @map("variant_files")
  isDefault         Boolean   @default(true) @map("is_default")
  sqlSpec           Json?     @map("sql_spec")
  params            Json      @map("params")
  pageSetup         Json?     @map("page_setup")
  bands             Json      @map("bands")
  bindings          Json      @map("bindings")
  functionsUsed     Json      @map("functions_used")
  flags             Json      @map("flags")
  exportFormats     Json      @map("export_formats")
  templateJson      Json?     @map("template_json")
  rptTemplateId     BigInt?   @map("rpt_template_id")
  reportKey         String?   @map("report_key")
  translationStatus String    @default("PENDING") @map("translation_status")
  isActive          Boolean   @default(true) @map("is_active")
  urutan            Int       @default(0) @map("urutan")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       BigInt?   @map("created_by_id")
  updatedById       BigInt?   @map("updated_by_id")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([legacyModule])
  @@index([erpModule])
  @@index([translationStatus])
  @@index([erpModule, urutan])
  @@index([reportKey])
  @@map("m0_reports")
}
