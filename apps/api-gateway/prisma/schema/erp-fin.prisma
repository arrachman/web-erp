  partnerId       BigInt?              @map("partner_id") // FK -> md_partners (ErpPartner)
  contactPerson   String?              @map("contact_person")
  description     String               @map("description")
  notes           String?              @map("notes")
  currencyId      BigInt               @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate    Decimal              @map("exchange_rate") @db.Decimal(19, 6)
  amount          Decimal              @map("amount") @db.Decimal(19, 4)
  amountFx        Decimal?             @map("amount_fx") @db.Decimal(19, 4)
  paidAmount      Decimal?             @map("paid_amount") @db.Decimal(19, 4)
  paymentStatus   ErpSettlementStatus? @map("payment_status")
  settledDate     DateTime?            @map("settled_date") @db.Date
  budgetDate      DateTime?            @map("budget_date") @db.Date
  status          ErpDocumentStatus    @map("status")
  previousStatus  ErpDocumentStatus?   @map("previous_status")
  revisionCount   Int                  @default(0) @map("revision_count")
  printCount      Int                  @default(0) @map("print_count")
