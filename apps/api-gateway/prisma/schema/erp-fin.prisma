model ErpFinCreditLimit {
  id             BigInt               @id @default(autoincrement())
  partnerId      BigInt               @map("partner_id") // FK -> md_partners (ErpPartner)
  limitAmount    Decimal              @map("limit_amount") @db.Decimal(19, 4)
  currencyId     BigInt               @map("currency_id") // FK -> md_currencies (ErpCurrency)
  action         ErpCreditLimitAction @map("action")
  overrideRoleId BigInt?              @map("override_role_id") // FK -> adm_roles (ErpRole)
  validFrom      DateTime?            @map("valid_from") @db.Date
  validTo        DateTime?            @map("valid_to") @db.Date
  reviewDate     DateTime?            @map("review_date") @db.Date
  notes          String?              @map("notes")
  isActive       Boolean              @default(true) @map("is_active")
  legacyCode     String?              @map("legacy_code")
  metadata       Json?                @map("metadata")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    BigInt?              @map("created_by_id")
  updatedById    BigInt?              @map("updated_by_id")
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)

  @@unique([partnerId])
  @@index([legacyCode])
  @@map("fin_credit_limits")
}

model ErpFinDunningRule {
  id              BigInt          @id @default(autoincrement())
  name            String          @map("name")
  overdueDaysFrom Int             @map("overdue_days_from")
  overdueDaysTo   Int?            @map("overdue_days_to")
  dunningLevel    ErpDunningLevel @map("dunning_level")
  messageTemplate String?         @map("message_template")
  isActive        Boolean         @default(true) @map("is_active")
  sortOrder       Int             @map("sort_order")
  legacyCode      String?         @map("legacy_code")
  metadata        Json?           @map("metadata")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     BigInt?         @map("created_by_id")
  updatedById     BigInt?         @map("updated_by_id")
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)

  collectionActivities ErpFinCollectionActivity[]

  @@index([legacyCode])
  @@map("fin_dunning_rules")
}

model ErpFinCollectionActivity {
  id               BigInt                    @id @default(autoincrement())
  partnerId        BigInt                    @map("partner_id") // FK -> md_partners (ErpPartner)
  activityType     ErpCollectionActivityType @map("activity_type")
  activityDate     DateTime                  @map("activity_date") @db.Date
  dueLedgerEntryId BigInt?                   @map("due_ledger_entry_id")
  dunningRuleId    BigInt?                   @map("dunning_rule_id")
  dunningLevel     ErpDunningLevel?          @map("dunning_level")
  status           ErpCollectionStatus       @map("status")
  assignedToId     BigInt?                   @map("assigned_to_id") // FK -> adm_users (ErpUser)
  notes            String                    @map("notes")
  followUpDate     DateTime?                 @map("follow_up_date") @db.Date
  resolvedAt       DateTime?                 @map("resolved_at") @db.Timestamptz(6)
  resolvedById     BigInt?                   @map("resolved_by_id") // FK -> adm_users (ErpUser)
  resolvedNotes    String?                   @map("resolved_notes")
  legacyCode       String?                   @map("legacy_code")
  metadata         Json?                     @map("metadata")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      BigInt?                   @map("created_by_id")
  updatedById      BigInt?                   @map("updated_by_id")
  deletedAt        DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  dunningRule    ErpFinDunningRule? @relation(fields: [dunningRuleId], references: [id])
  dueLedgerEntry ErpFinLedgerEntry? @relation(fields: [dueLedgerEntryId], references: [id])

  @@index([partnerId])
  @@index([dunningRuleId])
  @@index([dueLedgerEntryId])
  @@index([legacyCode])
  @@map("fin_collection_activities")
}

model ErpFinIntercompanyRule {
  id               BigInt    @id @default(autoincrement())
  fromBranchId     BigInt    @map("from_branch_id") // FK -> md_branches (ErpBranch)
  toBranchId       BigInt    @map("to_branch_id") // FK -> md_branches (ErpBranch)
  dueFromAccountId BigInt    @map("due_from_account_id") // FK -> md_accounts (ErpAccount)
  dueToAccountId   BigInt    @map("due_to_account_id") // FK -> md_accounts (ErpAccount)
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?   @map("notes")
  legacyCode       String?   @map("legacy_code")
  metadata         Json?     @map("metadata")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      BigInt?   @map("created_by_id")
  updatedById      BigInt?   @map("updated_by_id")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  transactions ErpFinIntercompanyTransaction[]

  @@unique([fromBranchId, toBranchId])
  @@index([legacyCode])
  @@map("fin_intercompany_rules")
}

model ErpFinIntercompanyTransaction {
  id                    BigInt                @id @default(autoincrement())
  docNumber             String                @unique @map("doc_number")
  transactionDate       DateTime              @map("transaction_date") @db.Date
  fiscalPeriodId        BigInt                @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  ruleId                BigInt?               @map("rule_id")
  fromBranchId          BigInt                @map("from_branch_id") // FK -> md_branches (ErpBranch)
  toBranchId            BigInt                @map("to_branch_id") // FK -> md_branches (ErpBranch)
  fromJournalEntryId    BigInt?               @map("from_journal_entry_id")
  toJournalEntryId      BigInt?               @map("to_journal_entry_id")
  amount                Decimal               @map("amount") @db.Decimal(19, 4)
  currencyId            BigInt                @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate          Decimal               @map("exchange_rate") @db.Decimal(19, 6)
  description           String                @map("description")
  status                ErpIntercompanyStatus @map("status")
  eliminatedAt          DateTime?             @map("eliminated_at") @db.Timestamptz(6)
  eliminatedById        BigInt?               @map("eliminated_by_id") // FK -> adm_users (ErpUser)
  consolidationPeriodId BigInt?               @map("consolidation_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  notes                 String?               @map("notes")
  legacyCode            String?               @map("legacy_code")
  metadata              Json?                 @map("metadata")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById           BigInt?               @map("created_by_id")
  updatedById           BigInt?               @map("updated_by_id")
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz(6)

  rule             ErpFinIntercompanyRule? @relation(fields: [ruleId], references: [id])
  fromJournalEntry ErpFinJournalEntry?     @relation("ErpFinIntercompanyTransaction_fromJv", fields: [fromJournalEntryId], references: [id])
  toJournalEntry   ErpFinJournalEntry?     @relation("ErpFinIntercompanyTransaction_toJv", fields: [toJournalEntryId], references: [id])

  @@index([fiscalPeriodId])
  @@index([ruleId])
  @@index([fromJournalEntryId])
  @@index([toJournalEntryId])
  @@index([legacyCode])
  @@map("fin_intercompany_transactions")
}

/// Lampiran dokumen pendukung transaksi Finance — generik, berkunci
/// (doc_type, doc_id). doc_id polymorphic lintas tabel transaksi fin
/// (tanpa FK; index saja). File di uploads/erp-transactions (bind-mount host).
model ErpFinTransactionAttachment {
  id          BigInt   @id @default(autoincrement())
  docType     String   @map("doc_type")
  docId       BigInt   @map("doc_id")
  fileName    String   @map("file_name")
  storedName  String   @unique @map("stored_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  note        String?  @map("note")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")

  @@index([docType, docId])
  @@map("fin_transaction_attachments")
}
