model ErpFinJournalEntry {
  id             BigInt             @id @default(autoincrement())
  docNumber      String             @unique @map("doc_number")
  autoNumber     String?            @map("auto_number")
  journalType    ErpJournalType     @map("journal_type")
  branchId       BigInt             @map("branch_id") // FK -> md_branches (ErpBranch)
  locationId     BigInt?            @map("location_id") // FK -> md_locations (ErpLocation)
  source         String?            @map("source")
  entryDate      DateTime           @map("entry_date") @db.Date
  fiscalPeriodId BigInt             @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  partnerId      BigInt?            @map("partner_id") // FK -> md_partners (ErpPartner)
  contactPerson  String?            @map("contact_person")
  description    String             @map("description")
  notes          String?            @map("notes")
  currencyId     BigInt             @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate   Decimal            @map("exchange_rate") @db.Decimal(19, 6)
  status         ErpDocumentStatus  @map("status")
  previousStatus ErpDocumentStatus? @map("previous_status")
  revisionCount  Int                @default(0) @map("revision_count")
  printCount     Int                @default(0) @map("print_count")
  postingStatus  ErpPostingStatus   @map("posting_status")
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedById     BigInt?            @map("posted_by_id") // FK -> adm_users (ErpUser)
  legacyCode     String?            @map("legacy_code")
  metadata       Json?              @map("metadata")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    BigInt?            @map("created_by_id")
  updatedById    BigInt?            @map("updated_by_id")
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  lines ErpFinJournalLine[]

  periodClosings     ErpFinPeriodClosing[]
  fxRevaluationRuns  ErpFinFxRevaluationRun[]
  intercompanyTxFrom ErpFinIntercompanyTransaction[] @relation("ErpFinIntercompanyTransaction_fromJv")
  intercompanyTxTo   ErpFinIntercompanyTransaction[] @relation("ErpFinIntercompanyTransaction_toJv")

  @@index([fiscalPeriodId])
  @@index([entryDate])
  @@index([journalType, status])
  @@index([branchId])
  @@index([partnerId])
  @@index([currencyId])
  @@index([legacyCode])
  @@map("fin_journal_entries")
}

model ErpFinJournalLine {
  id             BigInt   @id @default(autoincrement())
  journalEntryId BigInt   @map("journal_entry_id")
