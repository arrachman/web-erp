  creditFx       Decimal? @map("credit_fx") @db.Decimal(19, 4)
  notes          String?  @map("notes")
  costCenterId   BigInt?  @map("cost_center_id")
  divisionId     BigInt?  @map("division_id")
  subdivisionId  BigInt?  @map("subdivision_id")
  projectId      BigInt?  @map("project_id")
