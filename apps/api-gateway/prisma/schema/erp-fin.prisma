/// Header for a giro register (RG/SG) or clearing (RGC/SGC) document. A REGISTER
/// entry owns the giro instruments it creates (giros via giroEntryId); a CLEAR
/// entry references existing OUTSTANDING giros and marks them CLEARED (giros via
/// clearedByEntryId), posting GL on POST. Mirrors the fin_journal_entries
/// header + the §2.7 workflow state machine. See web-erp DECISIONS.md "§ Giro".
model ErpFinGiroEntry {
  id             BigInt             @id @default(autoincrement())
  docNumber      String             @unique @map("doc_number")
  autoNumber     String?            @map("auto_number")
  kind           ErpGiroEntryKind   @map("kind")
  type           ErpGiroType        @map("type")
  branchId       BigInt             @map("branch_id") // FK -> md_branches (ErpBranch)
  partnerId      BigInt?            @map("partner_id") // FK -> md_partners (ErpPartner)
  entryDate      DateTime           @map("entry_date") @db.Date
  fiscalPeriodId BigInt             @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  bankAccountId  BigInt?            @map("bank_account_id") // FK -> md_accounts (ErpAccount); CLEAR: default settlement bank
  currencyId     BigInt             @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate   Decimal            @map("exchange_rate") @db.Decimal(19, 6)
  description    String?            @map("description")
  notes          String?            @map("notes")
  status         ErpDocumentStatus  @map("status")
  previousStatus ErpDocumentStatus? @map("previous_status")
  postingStatus  ErpPostingStatus   @map("posting_status")
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedById     BigInt?            @map("posted_by_id") // FK -> adm_users (ErpUser)
  legacyCode     String?            @map("legacy_code")
  metadata       Json?              @map("metadata")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    BigInt?            @map("created_by_id")
  updatedById    BigInt?            @map("updated_by_id")
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  registeredGiros ErpFinGiro[] @relation("GiroRegisterEntry")
  clearedGiros    ErpFinGiro[] @relation("GiroClearEntry")

  @@index([kind, type, status])
  @@index([fiscalPeriodId])
  @@index([entryDate])
  @@index([partnerId])
  @@map("fin_giro_entries")
}

model ErpFinGiro {
  id                  BigInt         @id @default(autoincrement())
  giroNumber          String         @unique @map("giro_number")
  type                ErpGiroType    @map("type")
  source              String?        @map("source")
  sourceTransactionId BigInt?        @map("source_transaction_id")
  giroEntryId         BigInt?        @map("giro_entry_id") // FK -> fin_giro_entries (REGISTER entry that created it)
  clearedByEntryId    BigInt?        @map("cleared_by_entry_id") // FK -> fin_giro_entries (CLEAR entry that settled it)
  partnerId           BigInt?        @map("partner_id") // FK -> md_partners (ErpPartner)
  branchId            BigInt?        @map("branch_id") // FK -> md_branches (ErpBranch)
  fiscalPeriodId      BigInt?        @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  bankName            String?        @map("bank_name")
  bankAccountNo       String?        @map("bank_account_no")
