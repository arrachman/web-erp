model ErpTransactionNote {
  id          BigInt                     @id @default(autoincrement())
  code        String                     @unique @map("code")
  name        String                     @map("name")
  isActive    Boolean                    @default(true) @map("is_active")
  legacyCode  String?                    @map("legacy_code")
  metadata    Json?                      @map("metadata")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?                    @map("created_by_id")
  updatedById BigInt?                    @map("updated_by_id")
  deletedAt   DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  details     ErpTransactionNoteDetail[]

  @@index([legacyCode])
  @@map("md_transaction_notes")
}

model ErpTransactionNoteDetail {
  id                BigInt             @id @default(autoincrement())
  transactionNoteId BigInt             @map("transaction_note_id")
  sortOrder         Int                @default(0) @map("sort_order")
  content           String             @map("content")
  legacyCode        String?            @map("legacy_code")
  metadata          Json?              @map("metadata")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  transactionNote   ErpTransactionNote @relation(fields: [transactionNoteId], references: [id], onDelete: Cascade)

  @@index([transactionNoteId])
  @@map("md_transaction_note_details")
}

