model ErpItemInformation {
  id                   BigInt    @id @default(autoincrement())
  itemId               BigInt    @unique @map("item_id")
  longDescription      String?   @map("long_description")
  specifications       String?   @map("specifications")
  manufacturer         String?   @map("manufacturer")
  countryOfOrigin      String?   @map("country_of_origin")
  warrantyPeriodMonths Int?      @map("warranty_period_months")
  tags                 String?   @map("tags")
  notes                String?   @map("notes")
  legacyCode           String?   @map("legacy_code")
  metadata             Json?     @map("metadata")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById          BigInt?   @map("created_by_id")
  updatedById          BigInt?   @map("updated_by_id")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  item                 ErpItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([legacyCode])
  @@map("md_item_informations")
}
