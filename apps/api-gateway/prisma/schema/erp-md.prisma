model ErpBranch {
  id           BigInt    @id @default(autoincrement())
  code         String    @unique @map("code")
  name         String    @map("name")
  addressLine1 String?   @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String?   @map("city")
  postalCode   String?   @map("postal_code")
  phone        String?   @map("phone")
  fax          String?   @map("fax")
  notes        String?   @map("notes")
  isActive     Boolean   @default(true) @map("is_active")
  legacyCode   String?   @map("legacy_code")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  BigInt?   @map("created_by_id")
  updatedById  BigInt?   @map("updated_by_id")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  locations          ErpLocation[]
  userBranchAccess   ErpUserBranchAccess[]
  partners           ErpPartner[]
  items              ErpItem[]             @relation("ItemBranch")
  itemDimBranches    ErpItemDimBranch[]    @relation("ItemDimBranchBranch")
  partnerDimBranches ErpPartnerDimBranch[] @relation("PartnerDimBranchBranch")
  accountDimBranches ErpAccountDimBranch[] @relation("AccountDimBranchBranch")

  @@index([legacyCode])
  @@map("md_branches")
}

model ErpLocation {
  id           BigInt    @id @default(autoincrement())
  code         String    @unique @map("code")
  name         String    @map("name")
  branchId     BigInt    @map("branch_id")
  addressLine1 String?   @map("address_line1")
  city         String?   @map("city")
  postalCode   String?   @map("postal_code")
  phone        String?   @map("phone")
  notes        String?   @map("notes")
  isActive     Boolean   @default(true) @map("is_active")
  legacyCode   String?   @map("legacy_code")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  BigInt?   @map("created_by_id")
  updatedById  BigInt?   @map("updated_by_id")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  branch              ErpBranch               @relation(fields: [branchId], references: [id])
  warehouses          ErpWarehouse[]
  userLocationAccess  ErpUserLocationAccess[]
  items               ErpItem[]               @relation("ItemDefaultLocation")
  itemDimLocations    ErpItemDimLocation[]    @relation("ItemDimLocationLocation")
  partnerDimLocations ErpPartnerDimLocation[] @relation("PartnerDimLocationLocation")
  accountDimLocations ErpAccountDimLocation[] @relation("AccountDimLocationLocation")

  @@index([branchId])
  @@index([legacyCode])
  @@map("md_locations")
}

model ErpWarehouse {
  id                 BigInt    @id @default(autoincrement())
  code               String    @unique @map("code")
  name               String    @map("name")
  locationId         BigInt    @map("location_id")
  allowNegativeStock Boolean   @default(false) @map("allow_negative_stock")
  notes              String?   @map("notes")
  isActive           Boolean   @default(true) @map("is_active")
  legacyCode         String?   @map("legacy_code")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        BigInt?   @map("created_by_id")
  updatedById        BigInt?   @map("updated_by_id")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  location             ErpLocation              @relation(fields: [locationId], references: [id])
  userWarehouseAccess  ErpUserWarehouseAccess[]
  items                ErpItem[]                @relation("ItemDefaultWarehouse")
  storageBins          ErpStorageBin[]          @relation("WarehouseStorageBins")
  itemStockLevels      ErpItemWarehouseStock[]  @relation("ItemWarehouseStockWarehouse")
  itemDimWarehouses    ErpItemDimWarehouse[]    @relation("ItemDimWarehouseWarehouse")
  partnerDimWarehouses ErpPartnerDimWarehouse[] @relation("PartnerDimWarehouseWarehouse")

  @@index([locationId])
  @@index([legacyCode])
  @@map("md_warehouses")
}

model ErpUnit {
  id               BigInt    @id @default(autoincrement())
  code             String    @unique @map("code")
  name             String    @map("name")
  conversionFactor Decimal   @default(1) @map("conversion_factor") @db.Decimal(19, 4)
  notes            String?   @map("notes")
  isActive         Boolean   @default(true) @map("is_active")
  legacyCode       String?   @map("legacy_code")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      BigInt?   @map("created_by_id")
  updatedById      BigInt?   @map("updated_by_id")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  items          ErpItem[] @relation("ItemBaseUnit")
  fieldUnitItems ErpItem[] @relation("ItemFieldUnit")

  @@index([legacyCode])
  @@map("md_units")
}

model ErpItemCategory {
  id                        BigInt    @id @default(autoincrement())
  code                      String    @unique @map("code")
  name                      String    @map("name")
  parentId                  BigInt?   @map("parent_id")
  inventoryAccountId        BigInt?   @map("inventory_account_id")
  cogsAccountId             BigInt?   @map("cogs_account_id")
  salesAccountId            BigInt?   @map("sales_account_id")
  salesReturnAccountId      BigInt?   @map("sales_return_account_id")
  salesDiscountAccountId    BigInt?   @map("sales_discount_account_id")
  purchaseReturnAccountId   BigInt?   @map("purchase_return_account_id")
  purchaseDiscountAccountId BigInt?   @map("purchase_discount_account_id")
  consignmentAccountId      BigInt?   @map("consignment_account_id")
  isActive                  Boolean   @default(true) @map("is_active")
  legacyCode                String?   @map("legacy_code")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById               BigInt?   @map("created_by_id")
  updatedById               BigInt?   @map("updated_by_id")
  deletedAt                 DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent                  ErpItemCategory?  @relation("ItemCategoryParent", fields: [parentId], references: [id])
  children                ErpItemCategory[] @relation("ItemCategoryParent")
  inventoryAccount        ErpAccount?       @relation("ItemCatInventoryAcct", fields: [inventoryAccountId], references: [id])
  cogsAccount             ErpAccount?       @relation("ItemCatCogsAcct", fields: [cogsAccountId], references: [id])
  salesAccount            ErpAccount?       @relation("ItemCatSalesAcct", fields: [salesAccountId], references: [id])
  salesReturnAccount      ErpAccount?       @relation("ItemCatSalesReturnAcct", fields: [salesReturnAccountId], references: [id])
  salesDiscountAccount    ErpAccount?       @relation("ItemCatSalesDiscountAcct", fields: [salesDiscountAccountId], references: [id])
  purchaseReturnAccount   ErpAccount?       @relation("ItemCatPurchaseReturnAcct", fields: [purchaseReturnAccountId], references: [id])
  purchaseDiscountAccount ErpAccount?       @relation("ItemCatPurchaseDiscountAcct", fields: [purchaseDiscountAccountId], references: [id])
  consignmentAccount      ErpAccount?       @relation("ItemCatConsignmentAcct", fields: [consignmentAccountId], references: [id])
  items                   ErpItem[]

  @@index([parentId])
  @@index([legacyCode])
  @@map("md_item_categories")
}

model ErpItem {
  id                        BigInt           @id @default(autoincrement())
  code                      String           @unique @map("code")
  name                      String           @map("name")
  barcode                   String?          @map("barcode")
  type                      ErpItemType      @map("type")
  costMethod                ErpCostingMethod @default(AVG) @map("cost_method")
  categoryId                BigInt           @map("category_id")
  baseUnitId                BigInt           @map("base_unit_id")
  kindId                    BigInt?          @map("kind_id")
  productClassId            BigInt?          @map("product_class_id")
  brandId                   BigInt?          @map("brand_id")
  materialId                BigInt?          @map("material_id")
  itemModelId               BigInt?          @map("item_model_id")
  sizeId                    BigInt?          @map("size_id")
  colorId                   BigInt?          @map("color_id")
  sectionId                 BigInt?          @map("section_id")
  designerId                BigInt?          @map("designer_id")
  nozzleId                  BigInt?          @map("nozzle_id")
  oemId                     BigInt?          @map("oem_id")
  vendorId                  BigInt?          @map("vendor_id")
  fieldUnitId               BigInt?          @map("field_unit_id")
  divisionId                BigInt?          @map("division_id")
  subdivisionId             BigInt?          @map("subdivision_id")
  departmentId              BigInt?          @map("department_id")
  subDepartmentId           BigInt?          @map("sub_department_id")
  branchId                  BigInt?          @map("branch_id")
  defaultLocationId         BigInt?          @map("default_location_id")
  defaultWarehouseId        BigInt?          @map("default_warehouse_id")
  projectId                 BigInt?          @map("project_id")
  costCenterId              BigInt?          @map("cost_center_id")
  standardCost              Decimal          @default(0) @map("standard_cost") @db.Decimal(19, 4)
  averageCost               Decimal          @default(0) @map("average_cost") @db.Decimal(19, 4)
  lastHpp                   Decimal          @default(0) @map("last_hpp") @db.Decimal(19, 4)
  purchasePrice             Decimal          @default(0) @map("purchase_price") @db.Decimal(19, 4)
  purchaseDiscount          Decimal          @default(0) @map("purchase_discount") @db.Decimal(9, 4)
  salePrice                 Decimal          @default(0) @map("sale_price") @db.Decimal(19, 4)
  minStock                  Decimal          @default(0) @map("min_stock") @db.Decimal(19, 4)
  maxStock                  Decimal          @default(0) @map("max_stock") @db.Decimal(19, 4)
  reorderQty                Decimal          @default(0) @map("reorder_qty") @db.Decimal(19, 4)
  minOrderQty               Decimal          @default(0) @map("min_order_qty") @db.Decimal(19, 4)
  tracksSerial              Boolean          @default(false) @map("tracks_serial")
  tracksBatch               Boolean          @default(false) @map("tracks_batch")
  tracksBin                 Boolean          @default(false) @map("tracks_bin")
  inventoryAccountId        BigInt?          @map("inventory_account_id")
  salesAccountId            BigInt?          @map("sales_account_id")
  cogsAccountId             BigInt?          @map("cogs_account_id")
  salesReturnAccountId      BigInt?          @map("sales_return_account_id")
  salesDiscountAccountId    BigInt?          @map("sales_discount_account_id")
  purchaseReturnAccountId   BigInt?          @map("purchase_return_account_id")
  purchaseDiscountAccountId BigInt?          @map("purchase_discount_account_id")
  consignmentAccountId      BigInt?          @map("consignment_account_id")
  purchaseTaxId             BigInt?          @map("purchase_tax_id")
  purchaseTax2Id            BigInt?          @map("purchase_tax2_id")
  saleTaxId                 BigInt?          @map("sale_tax_id")
  saleTax2Id                BigInt?          @map("sale_tax2_id")
  primarySupplierId         BigInt?          @map("primary_supplier_id")
  weight                    Decimal?         @map("weight") @db.Decimal(19, 4)
  length                    Decimal?         @map("length") @db.Decimal(19, 4)
  width                     Decimal?         @map("width") @db.Decimal(19, 4)
  height                    Decimal?         @map("height") @db.Decimal(19, 4)
  volume                    Decimal?         @map("volume") @db.Decimal(19, 4)
  conversionKgPcs           Decimal          @default(1) @map("conversion_kg_pcs") @db.Decimal(19, 4)
  registrationNo            String?          @map("registration_no")
  isReturnable              Boolean          @default(true) @map("is_returnable")
  isMobile                  Boolean          @default(false) @map("is_mobile")
  ageCategory               String?          @map("age_category")
  validUntil                DateTime?        @map("valid_until") @db.Date
  isVatable                 Boolean          @default(true) @map("is_vatable")
  isSpecial                 Boolean          @default(false) @map("is_special")
  isActive                  Boolean          @default(true) @map("is_active")
  legacyCode                String?          @map("legacy_code")
  metadata                  Json?            @map("metadata")
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById               BigInt?          @map("created_by_id")
  updatedById               BigInt?          @map("updated_by_id")
  deletedAt                 DateTime?        @map("deleted_at") @db.Timestamptz(6)

  category                ErpItemCategory         @relation(fields: [categoryId], references: [id])
  baseUnit                ErpUnit                 @relation("ItemBaseUnit", fields: [baseUnitId], references: [id])
  fieldUnit               ErpUnit?                @relation("ItemFieldUnit", fields: [fieldUnitId], references: [id])
  kind                    ErpItemKind?            @relation("ItemKind", fields: [kindId], references: [id])
  productClass            ErpProductClass?        @relation("ItemProductClass", fields: [productClassId], references: [id])
  brand                   ErpBrand?               @relation(fields: [brandId], references: [id])
  material                ErpMaterial?            @relation(fields: [materialId], references: [id])
  size                    ErpSize?                @relation(fields: [sizeId], references: [id])
  color                   ErpColor?               @relation(fields: [colorId], references: [id])
  section                 ErpSection?             @relation(fields: [sectionId], references: [id])
  designer                ErpDesigner?            @relation(fields: [designerId], references: [id])
  nozzle                  ErpNozzle?              @relation(fields: [nozzleId], references: [id])
  oem                     ErpOem?                 @relation(fields: [oemId], references: [id])
  division                ErpDivision?            @relation("ItemDivision", fields: [divisionId], references: [id])
  subdivision             ErpSubdivision?         @relation("ItemSubdivision", fields: [subdivisionId], references: [id])
  department              ErpDepartment?          @relation("ItemDepartment", fields: [departmentId], references: [id])
  subDepartment           ErpSubDepartment?       @relation("ItemSubDepartment", fields: [subDepartmentId], references: [id])
  branch                  ErpBranch?              @relation("ItemBranch", fields: [branchId], references: [id])
  defaultLocation         ErpLocation?            @relation("ItemDefaultLocation", fields: [defaultLocationId], references: [id])
  defaultWarehouse        ErpWarehouse?           @relation("ItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  project                 ErpProject?             @relation("ItemProject", fields: [projectId], references: [id])
  costCenter              ErpCostCenter?          @relation("ItemCostCenter", fields: [costCenterId], references: [id])
  inventoryAccount        ErpAccount?             @relation("ItemInventoryAcct", fields: [inventoryAccountId], references: [id])
  salesAccount            ErpAccount?             @relation("ItemSalesAcct", fields: [salesAccountId], references: [id])
  cogsAccount             ErpAccount?             @relation("ItemCogsAcct", fields: [cogsAccountId], references: [id])
  salesReturnAccount      ErpAccount?             @relation("ItemSalesReturnAcct", fields: [salesReturnAccountId], references: [id])
  salesDiscountAccount    ErpAccount?             @relation("ItemSalesDiscountAcct", fields: [salesDiscountAccountId], references: [id])
  purchaseReturnAccount   ErpAccount?             @relation("ItemPurchaseReturnAcct", fields: [purchaseReturnAccountId], references: [id])
  purchaseDiscountAccount ErpAccount?             @relation("ItemPurchaseDiscountAcct", fields: [purchaseDiscountAccountId], references: [id])
  consignmentAccount      ErpAccount?             @relation("ItemConsignmentAcct", fields: [consignmentAccountId], references: [id])
  purchaseTax             ErpTax?                 @relation("ItemPurchaseTax", fields: [purchaseTaxId], references: [id])
  purchaseTax2            ErpTax?                 @relation("ItemPurchaseTax2", fields: [purchaseTax2Id], references: [id])
  saleTax                 ErpTax?                 @relation("ItemSaleTax", fields: [saleTaxId], references: [id])
  saleTax2                ErpTax?                 @relation("ItemSaleTax2", fields: [saleTax2Id], references: [id])
  primarySupplier         ErpPartner?             @relation("ItemPrimarySupplier", fields: [primarySupplierId], references: [id])
  vendor                  ErpPartner?             @relation("ItemVendor", fields: [vendorId], references: [id])
  information             ErpItemInformation?
  prices                  ErpItemPrice[]          @relation("ItemPrices")
  distributors            ErpItemDistributor[]    @relation("ItemDistributors")
  warehouseStocks         ErpItemWarehouseStock[] @relation("ItemWarehouseStocks")
  dimBranches             ErpItemDimBranch[]      @relation("ItemDimBranches")
  dimWarehouses           ErpItemDimWarehouse[]   @relation("ItemDimWarehouses")
  dimLocations            ErpItemDimLocation[]    @relation("ItemDimLocations")
  media                   ErpItemMedia[]          @relation("ItemMedia")
  attachments             ErpItemAttachment[]     @relation("ItemAttachments")

  @@index([categoryId])
  @@index([baseUnitId])
  @@index([kindId])
  @@index([productClassId])
  @@index([brandId])
  @@index([materialId])
  @@index([itemModelId])
  @@index([sizeId])
  @@index([colorId])
  @@index([sectionId])
  @@index([designerId])
  @@index([nozzleId])
  @@index([oemId])
  @@index([vendorId])
  @@index([fieldUnitId])
  @@index([divisionId])
  @@index([departmentId])
  @@index([branchId])
  @@index([defaultLocationId])
  @@index([defaultWarehouseId])
  @@index([projectId])
  @@index([costCenterId])
  @@index([purchaseTax2Id])
  @@index([saleTax2Id])
  @@index([barcode])
  @@index([legacyCode])
  @@map("md_items")
}

/// Sale price tiers per item (legacy MyERP+ "Harga Jual 1..10" + "Diskon Jual 1..10").
/// One row per (item, level 1..10). Level 1 mirrors ErpItem.salePrice (denormalized cache).
model ErpItemPrice {
  id              BigInt   @id @default(autoincrement())
  itemId          BigInt   @map("item_id")
  level           Int      @map("level")
  price           Decimal  @default(0) @map("price") @db.Decimal(19, 4)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(9, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     BigInt?  @map("created_by_id")
  updatedById     BigInt?  @map("updated_by_id")

  item ErpItem @relation("ItemPrices", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, level])
  @@index([itemId])
  @@map("md_item_prices")
}

/// Item media gallery — product images (max 8, one primary) + one short video.
/// Files live on disk under uploads/erp-items (bind-mounted); stored_name is the
/// random on-disk filename, file_name keeps the original upload name for display.
model ErpItemMedia {
  id          BigInt           @id @default(autoincrement())
  itemId      BigInt           @map("item_id")
  kind        ErpItemMediaKind @map("kind")
  fileName    String           @map("file_name")
  storedName  String           @unique @map("stored_name")
  mimeType    String           @map("mime_type")
  sizeBytes   Int              @map("size_bytes")
  sortOrder   Int              @default(0) @map("sort_order")
  isPrimary   Boolean          @default(false) @map("is_primary")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?          @map("created_by_id")

  item ErpItem @relation("ItemMedia", fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("md_item_media")
}

/// Item supporting documents (lampiran) — any file attached to an item:
/// datasheet, spec, certificate, contract, etc. Generic (no IMAGE/VIDEO kind,
/// no primary). Files live on disk under uploads/erp-items (bind-mounted);
/// stored_name is the random on-disk filename, file_name keeps the original
/// upload name for display/download. note = optional caption.
model ErpItemAttachment {
  id          BigInt   @id @default(autoincrement())
  itemId      BigInt   @map("item_id")
  fileName    String   @map("file_name")
  storedName  String   @unique @map("stored_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  note        String?  @map("note")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")

  item ErpItem @relation("ItemAttachments", fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("md_item_attachments")
}

/// Per-warehouse stock level overrides (Stok Min/Maks + Min Order per Gudang).
/// md_items.min_stock/max_stock/min_order_qty stay the GLOBAL defaults; a row
/// here overrides them for one warehouse. Warehouses without a row use global.
model ErpItemWarehouseStock {
  id          BigInt   @id @default(autoincrement())
  itemId      BigInt   @map("item_id")
  warehouseId BigInt   @map("warehouse_id")
  minStock    Decimal  @default(0) @map("min_stock") @db.Decimal(19, 4)
  maxStock    Decimal  @default(0) @map("max_stock") @db.Decimal(19, 4)
  minOrderQty Decimal  @default(0) @map("min_order_qty") @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")
  updatedById BigInt?  @map("updated_by_id")

  item      ErpItem      @relation("ItemWarehouseStocks", fields: [itemId], references: [id], onDelete: Cascade)
  warehouse ErpWarehouse @relation("ItemWarehouseStockWarehouse", fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@map("md_item_warehouse_stocks")
}

/// Multi-select GL dimension "Cabang" on the item form (Dimensi GL section).
/// md_items.branch_id stays the primary/default (= first selection, denormalized);
/// these rows list ALL selected branches.
model ErpItemDimBranch {
  id        BigInt   @id @default(autoincrement())
  itemId    BigInt   @map("item_id")
  branchId  BigInt   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item   ErpItem   @relation("ItemDimBranches", fields: [itemId], references: [id], onDelete: Cascade)
  branch ErpBranch @relation("ItemDimBranchBranch", fields: [branchId], references: [id])

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("md_item_dim_branches")
}

/// Multi-select GL dimension "Gudang Default" (md_items.default_warehouse_id = first selection).
model ErpItemDimWarehouse {
  id          BigInt   @id @default(autoincrement())
  itemId      BigInt   @map("item_id")
  warehouseId BigInt   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item      ErpItem      @relation("ItemDimWarehouses", fields: [itemId], references: [id], onDelete: Cascade)
  warehouse ErpWarehouse @relation("ItemDimWarehouseWarehouse", fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
  @@map("md_item_dim_warehouses")
}

/// Multi-select GL dimension "Lokasi Default" (md_items.default_location_id = first selection).
model ErpItemDimLocation {
  id         BigInt   @id @default(autoincrement())
  itemId     BigInt   @map("item_id")
  locationId BigInt   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item     ErpItem     @relation("ItemDimLocations", fields: [itemId], references: [id], onDelete: Cascade)
  location ErpLocation @relation("ItemDimLocationLocation", fields: [locationId], references: [id])

  @@unique([itemId, locationId])
  @@index([locationId])
  @@map("md_item_dim_locations")
}

// Multi-select GL dimensions on a partner (Cabang / Gudang / Lokasi).
// Mirror md_item_dim_*: junction rows; the single md_partners.branch_id stays
// as the denormalized primary/default (= first selected branch).
model ErpPartnerDimBranch {
  id        BigInt   @id @default(autoincrement())
  partnerId BigInt   @map("partner_id")
  branchId  BigInt   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partner ErpPartner @relation("PartnerDimBranches", fields: [partnerId], references: [id], onDelete: Cascade)
  branch  ErpBranch  @relation("PartnerDimBranchBranch", fields: [branchId], references: [id])

  @@unique([partnerId, branchId])
  @@index([branchId])
  @@map("md_partner_dim_branches")
}

model ErpPartnerDimWarehouse {
  id          BigInt   @id @default(autoincrement())
  partnerId   BigInt   @map("partner_id")
