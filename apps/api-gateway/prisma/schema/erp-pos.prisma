model ErpPosAreaCategory {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @map("code")
  name        String    @map("name")
  legacyCode  String?   @map("legacy_code")
  isActive    Boolean   @default(true) @map("is_active")
  notes       String?   @map("notes")
  metadata    Json?     @map("metadata")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  areas ErpPosArea[]

  @@index([legacyCode])
  @@map("pos_area_categories")
}

model ErpPosArea {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @map("code")
  name        String    @map("name")
  legacyCode  String?   @map("legacy_code")
  categoryId  BigInt?   @map("category_id")
  branchId    BigInt?   @map("branch_id") // FK -> md_branches (ErpBranch)
  notes       String?   @map("notes")
  isActive    Boolean   @default(true) @map("is_active")
  metadata    Json?     @map("metadata")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  category   ErpPosAreaCategory? @relation(fields: [categoryId], references: [id])
  itemPrices ErpPosItemPrice[]
  promotions ErpPosPromotion[]

  @@index([legacyCode])
  @@index([categoryId])
  @@index([branchId])
  @@map("pos_areas")
}

