model ErpPosItemPrice {
  id              BigInt    @id @default(autoincrement())
  itemId          BigInt    @map("item_id") // FK -> md_items (ErpItem)
  areaId          BigInt?   @map("area_id")
  categoryId      BigInt?   @map("category_id") // FK -> md_item_categories (ErpItemCategory)
  priceIsEditable Boolean   @default(false) @map("price_is_editable")
  minStock        Decimal?  @map("min_stock") @db.Decimal(19, 4)
  maxStock        Decimal?  @map("max_stock") @db.Decimal(19, 4)
  reorderStock    Decimal?  @map("reorder_stock") @db.Decimal(19, 4)
  minOrderStock   Decimal?  @map("min_order_stock") @db.Decimal(19, 4)
  isActive        Boolean   @default(true) @map("is_active")
  legacyCode      String?   @map("legacy_code")
  metadata        Json?     @map("metadata")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     BigInt?   @map("created_by_id")
  updatedById     BigInt?   @map("updated_by_id")

  area  ErpPosArea?           @relation(fields: [areaId], references: [id])
  tiers ErpPosItemPriceTier[]

  @@index([legacyCode])
  @@index([itemId])
  @@index([areaId])
  @@index([categoryId])
  @@map("pos_item_prices")
}

model ErpPosItemPriceTier {
  id              BigInt   @id @default(autoincrement())
  itemPriceId     BigInt   @map("item_price_id")
  tierLevel       Int      @map("tier_level")
  price           Decimal  @map("price") @db.Decimal(19, 4)
  discountPercent Decimal? @map("discount_percent") @db.Decimal(9, 4)
  minQty          Decimal? @map("min_qty") @db.Decimal(19, 4)

  itemPrice ErpPosItemPrice @relation(fields: [itemPriceId], references: [id], onDelete: Cascade)

  @@index([itemPriceId])
  @@map("pos_item_price_tiers")
}

model ErpPosPriceAgreement {
  id               BigInt             @id @default(autoincrement())
  docNumber        String             @unique @map("doc_number")
  autoNumber       String?            @map("auto_number")
  legacyCode       String?            @map("legacy_code")
  branchId         BigInt             @map("branch_id") // FK -> md_branches (ErpBranch)
  locationId       BigInt?            @map("location_id") // FK -> md_locations (ErpLocation)
  partnerId        BigInt             @map("partner_id") // FK -> md_partners (ErpPartner)
  partnerContactId BigInt?            @map("partner_contact_id") // FK -> md_partner_contacts (ErpPartnerContact)
  fiscalPeriodId   BigInt             @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  agreementDate    DateTime           @map("agreement_date") @db.Date
  pointsBefore     Decimal?           @map("points_before") @db.Decimal(19, 4)
  pointsIn         Decimal?           @map("points_in") @db.Decimal(19, 4)
  pointsOut        Decimal?           @map("points_out") @db.Decimal(19, 4)
  pointsAfter      Decimal?           @map("points_after") @db.Decimal(19, 4)
  description      String?            @map("description")
  notes            String?            @map("notes")
  status           ErpDocumentStatus  @map("status")
  previousStatus   ErpDocumentStatus? @map("previous_status")
  postingStatus    ErpPostingStatus   @map("posting_status")
  postedAt         DateTime?          @map("posted_at") @db.Timestamptz(6)
  metadata         Json?              @map("metadata")
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      BigInt?            @map("created_by_id")
  updatedById      BigInt?            @map("updated_by_id")

  lines ErpPosPriceAgreementLine[]

  @@index([legacyCode])
  @@index([branchId])
  @@index([locationId])
  @@index([partnerId])
  @@index([partnerContactId])
  @@index([fiscalPeriodId])
  @@map("pos_price_agreements")
}

model ErpPosPriceAgreementLine {
  id              BigInt    @id @default(autoincrement())
  agreementId     BigInt    @map("agreement_id")
  itemId          BigInt    @map("item_id") // FK -> md_items (ErpItem)
  agreedPrice     Decimal   @map("agreed_price") @db.Decimal(19, 4)
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(9, 4)
  validFrom       DateTime? @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  lineNo          Int       @map("line_no")

  agreement ErpPosPriceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([itemId])
  @@map("pos_price_agreement_lines")
}

model ErpPosPromotion {
  id            BigInt           @id @default(autoincrement())
  code          String           @unique @map("code")
  name          String           @map("name")
  legacyCode    String?          @map("legacy_code")
  promotionType ErpPromotionType @map("promotion_type")
  validFrom     DateTime         @map("valid_from") @db.Date
  validTo       DateTime         @map("valid_to") @db.Date
  areaId        BigInt?          @map("area_id")
  isActive      Boolean          @default(true) @map("is_active")
  metadata      Json?            @map("metadata")
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   BigInt?          @map("created_by_id")
  updatedById   BigInt?          @map("updated_by_id")

  area                ErpPosArea?                @relation(fields: [areaId], references: [id])
  bonusRules          ErpPosBonusRule[]
  substitutionRules   ErpPosSubstitutionRule[]
  additionalItemRules ErpPosAdditionalItemRule[]
  discountRules       ErpPosDiscountRule[]

  @@index([legacyCode])
  @@index([areaId])
  @@map("pos_promotions")
}

