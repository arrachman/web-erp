}

model ErpPosPointRule {
  id             BigInt           @id @default(autoincrement())
  scope          ErpDiscountScope @map("scope")
  itemId         BigInt?          @map("item_id") // FK -> md_items (ErpItem)
  itemCategoryId BigInt?          @map("item_category_id") // FK -> md_item_categories (ErpItemCategory)
  qtyFrom        Decimal?         @map("qty_from") @db.Decimal(19, 4)
  qtyTo          Decimal?         @map("qty_to") @db.Decimal(19, 4)
