model ErpPosPointTransaction {
  id              BigInt                  @id @default(autoincrement())
  partnerId       BigInt                  @map("partner_id") // FK -> md_partners (ErpPartner)
  type            ErpPointTransactionType @map("type")
  points          Decimal                 @map("points") @db.Decimal(19, 4)
  saleInvoiceId   BigInt?                 @map("sale_invoice_id") // FK -> sls_invoices (ErpSlsInvoice)
  ruleId          BigInt?                 @map("rule_id")
  transactionDate DateTime                @map("transaction_date") @db.Date
  categoryId      BigInt?                 @map("category_id") // FK -> md_item_categories (ErpItemCategory)
  balanceAfter    Decimal?                @map("balance_after") @db.Decimal(19, 4)
  metadata        Json?                   @map("metadata")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  rule ErpPosPointRule? @relation(fields: [ruleId], references: [id])

  @@index([partnerId])
  @@index([saleInvoiceId])
  @@index([ruleId])
  @@index([categoryId])
  @@map("pos_point_transactions")
}

