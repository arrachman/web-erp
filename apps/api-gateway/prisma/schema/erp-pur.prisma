  settlementStatus        ErpSettlementStatus   @map("settlement_status")
  settledDate             DateTime?             @map("settled_date") @db.Date
  returnPurchaseAccountId BigInt?               @map("return_purchase_account_id") // FK -> md_accounts (ErpAccount)
  cogsAccountId           BigInt?               @map("cogs_account_id") // FK -> md_accounts (ErpAccount)
  isOpeningBalance        Boolean               @default(false) @map("is_opening_balance")

  orderId        BigInt? @map("order_id")
  goodsReceiptId BigInt? @map("goods_receipt_id")
  invoiceId      BigInt? @map("invoice_id")

  order        ErpPurOrder?        @relation(fields: [orderId], references: [id])
  goodsReceipt ErpPurGoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  invoice      ErpPurInvoice?      @relation(fields: [invoiceId], references: [id])
  lines        ErpPurReturnLine[]

  metadata    Json?     @map("metadata")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  @@index([legacyCode])
  @@index([branchId])
  @@index([fiscalPeriodId])
  @@index([supplierId])
  @@index([orderId])
  @@index([goodsReceiptId])
  @@index([invoiceId])
  @@map("pur_returns")
}

model ErpPurReturnLine {
  id       BigInt @id @default(autoincrement())
  returnId BigInt @map("return_id")
  itemId   BigInt @map("item_id") // FK -> md_items (ErpItem)

  quantity     Decimal  @map("quantity") @db.Decimal(19, 4)
  unitId       BigInt   @map("unit_id") // FK -> md_units (ErpUnit)
  unitValue    Decimal  @map("unit_value") @db.Decimal(19, 4)
  baseQuantity Decimal  @map("base_quantity") @db.Decimal(19, 4)
  baseUnitId   BigInt   @map("base_unit_id") // FK -> md_units (ErpUnit)
  currencyId   BigInt   @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate Decimal  @map("exchange_rate") @db.Decimal(19, 6)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(19, 4)
  fixedPrice   Decimal? @map("fixed_price") @db.Decimal(19, 4)

  discountPercent Decimal? @map("discount_percent") @db.Decimal(9, 4)
  discountAmount  Decimal? @map("discount_amount") @db.Decimal(19, 4)
  tax1Id          BigInt?  @map("tax1_id") // FK -> md_taxes (ErpTax)
  tax1Amount      Decimal? @map("tax1_amount") @db.Decimal(19, 4)
  tax2Id          BigInt?  @map("tax2_id") // FK -> md_taxes (ErpTax)
  tax2Amount      Decimal? @map("tax2_amount") @db.Decimal(19, 4)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(19, 4)

  warehouseId               BigInt? @map("warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  inventoryAccountId        BigInt? @map("inventory_account_id") // FK -> md_accounts (ErpAccount)
  purchaseDiscountAccountId BigInt? @map("purchase_discount_account_id") // FK -> md_accounts (ErpAccount)
  accruedPayableAccountId   BigInt? @map("accrued_payable_account_id") // FK -> md_accounts (ErpAccount)

  costCenterId  BigInt? @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId    BigInt? @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId BigInt? @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
  projectId     BigInt? @map("project_id") // FK -> md_projects (ErpProject)

  orderLineId        BigInt? @map("order_line_id")
  goodsReceiptLineId BigInt? @map("goods_receipt_line_id")
  invoiceLineId      BigInt? @map("invoice_line_id")
  sourceLineId       BigInt? @map("source_line_id") // FK -> prior chain line (traceability)
  notes              String? @map("notes")
  lineNo             Int     @map("line_no")

  return           ErpPurReturn            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine        ErpPurOrderLine?        @relation(fields: [orderLineId], references: [id])
  goodsReceiptLine ErpPurGoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  invoiceLine      ErpPurInvoiceLine?      @relation(fields: [invoiceLineId], references: [id])

  @@index([returnId])
  @@index([itemId])
  @@index([orderLineId])
  @@index([goodsReceiptLineId])
  @@index([invoiceLineId])
  @@map("pur_return_lines")
}

/// Lampiran dokumen pendukung transaksi Purchasing — generik, berkunci
/// (doc_type, doc_id). doc_id polymorphic lintas tabel transaksi pur
/// (tanpa FK; index saja). File di uploads/erp-transactions (bind-mount host).
model ErpPurTransactionAttachment {
  id          BigInt   @id @default(autoincrement())
  docType     String   @map("doc_type")
  docId       BigInt   @map("doc_id")
  fileName    String   @map("file_name")
  storedName  String   @unique @map("stored_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  note        String?  @map("note")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")

  @@index([docType, docId])
  @@map("pur_transaction_attachments")
}
