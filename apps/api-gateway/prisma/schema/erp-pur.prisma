  baseQuantity Decimal  @map("base_quantity") @db.Decimal(19, 4)
  baseUnitId   BigInt   @map("base_unit_id") // FK -> md_units (ErpUnit)
  currencyId   BigInt   @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate Decimal  @map("exchange_rate") @db.Decimal(19, 6)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(19, 4)
  fixedPrice   Decimal? @map("fixed_price") @db.Decimal(19, 4)

  discountPercent Decimal? @map("discount_percent") @db.Decimal(9, 4)
  discountAmount  Decimal? @map("discount_amount") @db.Decimal(19, 4)
  tax1Id          BigInt?  @map("tax1_id") // FK -> md_taxes (ErpTax)
  tax1Amount      Decimal? @map("tax1_amount") @db.Decimal(19, 4)
  tax2Id          BigInt?  @map("tax2_id") // FK -> md_taxes (ErpTax)
  tax2Amount      Decimal? @map("tax2_amount") @db.Decimal(19, 4)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(19, 4)

  warehouseId               BigInt? @map("warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  inventoryAccountId        BigInt? @map("inventory_account_id") // FK -> md_accounts (ErpAccount)
  purchaseDiscountAccountId BigInt? @map("purchase_discount_account_id") // FK -> md_accounts (ErpAccount)
  accruedPayableAccountId   BigInt? @map("accrued_payable_account_id") // FK -> md_accounts (ErpAccount)

  costCenterId  BigInt? @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId    BigInt? @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId BigInt? @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
