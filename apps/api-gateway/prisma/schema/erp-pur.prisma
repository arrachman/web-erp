// --- Requisition (legacy m4_pr) ---
model ErpPurRequisition {
  id         BigInt  @id @default(autoincrement())
  docNumber  String  @unique @map("doc_number")
  autoNumber String? @map("auto_number")
  legacyCode String? @map("legacy_code")

  branchId          BigInt       @map("branch_id") // FK -> md_branches (ErpBranch)
  locationId        BigInt?      @map("location_id") // FK -> md_locations (ErpLocation)
  warehouseId       BigInt?      @map("warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  docDate           DateTime     @map("doc_date") @db.Date
  fiscalPeriodId    BigInt       @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  supplierId        BigInt?      @map("supplier_id") // FK -> md_partners (ErpPartner)
  supplierContactId BigInt?      @map("supplier_contact_id") // FK -> md_partner_contacts (ErpPartnerContact)
  paymentTermId     BigInt?      @map("payment_term_id") // FK -> md_payment_terms (ErpPaymentTerm)
  dueDate           DateTime?    @map("due_date") @db.Date
  currencyId        BigInt       @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate      Decimal      @map("exchange_rate") @db.Decimal(19, 6)
  priceMode         ErpPriceMode @map("price_mode")

  subtotal         Decimal  @map("subtotal") @db.Decimal(19, 4)
  discountPercent  Decimal? @map("discount_percent") @db.Decimal(9, 4)
  discountAmount   Decimal? @map("discount_amount") @db.Decimal(19, 4)
  tax1Amount       Decimal? @map("tax1_amount") @db.Decimal(19, 4)
  tax2Amount       Decimal? @map("tax2_amount") @db.Decimal(19, 4)
  otherCostPercent Decimal? @map("other_cost_percent") @db.Decimal(9, 4)
  otherCostAmount  Decimal? @map("other_cost_amount") @db.Decimal(19, 4)
  grandTotal       Decimal  @map("grand_total") @db.Decimal(19, 4)

  description   String?   @map("description")
  notes         String?   @map("notes")
  referenceNo   String?   @map("reference_no")
  referenceDate DateTime? @map("reference_date") @db.Date
  closedDate    DateTime? @map("closed_date") @db.Date

  discountAccountId  BigInt? @map("discount_account_id") // FK -> md_accounts (ErpAccount)
  tax1AccountId      BigInt? @map("tax1_account_id") // FK -> md_accounts (ErpAccount)
  tax2AccountId      BigInt? @map("tax2_account_id") // FK -> md_accounts (ErpAccount)
  otherCostAccountId BigInt? @map("other_cost_account_id") // FK -> md_accounts (ErpAccount)
  payableAccountId   BigInt? @map("payable_account_id") // FK -> md_accounts (ErpAccount)

  sourceDocType  String?            @map("source_doc_type")
  status         ErpDocumentStatus  @map("status")
  previousStatus ErpDocumentStatus? @map("previous_status")
  revisionCount  Int                @default(0) @map("revision_count")
  printCount     Int                @default(0) @map("print_count")
  postingStatus  ErpPostingStatus   @map("posting_status")
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz(6)

  // requisition-specific
  requestedById      BigInt    @map("requested_by_id") // FK -> adm_users (ErpUser)
  requestedPartnerId BigInt?   @map("requested_partner_id") // FK -> md_partners (ErpPartner)
  neededDate         DateTime? @map("needed_date") @db.Date
  requestedTo        String?   @map("requested_to")
  validFrom          DateTime? @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  salesQuotationId   BigInt?   @map("sales_quotation_id") // FK -> sls_quotations (ErpSlsQuotation)
  workOrderId        BigInt?   @map("work_order_id") // FK -> mfg_work_orders (ErpMfgWorkOrder) — auto-PR (decision #39)

  lines ErpPurRequisitionLine[]
  rfqs  ErpPurRfq[]

  metadata    Json?     @map("metadata")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")

  @@index([legacyCode])
  @@index([branchId])
  @@index([locationId])
  @@index([warehouseId])
  @@index([fiscalPeriodId])
  @@index([supplierId])
  @@index([requestedById])
  @@index([salesQuotationId])
  @@index([workOrderId])
  @@map("pur_requisitions")
}

model ErpPurRequisitionLine {
  id            BigInt @id @default(autoincrement())
  requisitionId BigInt @map("requisition_id")
