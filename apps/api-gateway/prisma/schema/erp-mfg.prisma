  sourceDocType          String?            @map("source_doc_type")
  status                 ErpDocumentStatus  @map("status")
  previousStatus         ErpDocumentStatus? @map("previous_status")
  revisionCount          Int                @default(0) @map("revision_count")
  printCount             Int                @default(0) @map("print_count")
  postingStatus          ErpPostingStatus   @map("posting_status")
  postedAt               DateTime?          @map("posted_at") @db.Timestamptz(6)
  metadata               Json?              @map("metadata")
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById            BigInt?            @map("created_by_id")
  updatedById            BigInt?            @map("updated_by_id")

  bomId             BigInt? @map("bom_id")
  productionEntryId BigInt? @map("production_entry_id")

  bom               ErpMfgBom?                     @relation(fields: [bomId], references: [id])
  productionEntry   ErpMfgProductionEntry?         @relation("ErpMfgProductionRework_productionEntry", fields: [productionEntryId], references: [id])
  inputs            ErpMfgProductionReworkInput[]
  outputs           ErpMfgProductionReworkOutput[]
  workOrders        ErpMfgWorkOrder[]              @relation("ErpMfgWorkOrder_productionRework")
  materialIssues    ErpMfgMaterialIssue[]          @relation("ErpMfgMaterialIssue_productionRework")
  materialReturns   ErpMfgMaterialReturn[]         @relation("ErpMfgMaterialReturn_productionRework")
  productionEntries ErpMfgProductionEntry[]        @relation("ErpMfgProductionEntry_productionRework")

  @@index([branchId])
  @@index([fiscalPeriodId])
  @@index([currencyId])
  @@index([bomId])
  @@index([productionEntryId])
  @@index([legacyCode])
  @@map("mfg_production_reworks")
}

model ErpMfgProductionReworkInput {
  id                     BigInt   @id @default(autoincrement())
  productionReworkId     BigInt   @map("production_rework_id")
  itemId                 BigInt   @map("item_id") // FK -> md_items (ErpItem)
  quantity               Decimal  @map("quantity") @db.Decimal(19, 4)
  unitId                 BigInt   @map("unit_id") // FK -> md_units (ErpUnit)
  unitValue              Decimal  @map("unit_value") @db.Decimal(19, 4)
  baseQuantity           Decimal  @map("base_quantity") @db.Decimal(19, 4)
  baseUnitId             BigInt   @map("base_unit_id") // FK -> md_units (ErpUnit)
  currencyId             BigInt   @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate           Decimal  @map("exchange_rate") @db.Decimal(19, 6)
  unitPrice              Decimal  @map("unit_price") @db.Decimal(19, 4)
  unitCost               Decimal  @map("unit_cost") @db.Decimal(19, 4)
  costPercent            Decimal? @map("cost_percent") @db.Decimal(9, 4)
  inventoryAccountId     BigInt?  @map("inventory_account_id") // FK -> md_accounts (ErpAccount)
  sourceWarehouseId      BigInt?  @map("source_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  productionWarehouseId  BigInt?  @map("production_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  destinationWarehouseId BigInt?  @map("destination_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  costCenterId           BigInt?  @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId             BigInt?  @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId          BigInt?  @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
  projectId              BigInt?  @map("project_id") // FK -> md_projects (ErpProject)
  notes                  String?  @map("notes")
  lineNo                 Int      @map("line_no")
  metadata               Json?    @map("metadata")

  productionRework ErpMfgProductionRework @relation(fields: [productionReworkId], references: [id], onDelete: Cascade)

  @@index([productionReworkId])
  @@index([itemId])
  @@index([unitId])
  @@index([currencyId])
  @@map("mfg_production_rework_inputs")
}

model ErpMfgProductionReworkOutput {
  id                     BigInt  @id @default(autoincrement())
  productionReworkId     BigInt  @map("production_rework_id")
  itemId                 BigInt  @map("item_id") // FK -> md_items (ErpItem)
  quantity               Decimal @map("quantity") @db.Decimal(19, 4)
  unitId                 BigInt  @map("unit_id") // FK -> md_units (ErpUnit)
  unitValue              Decimal @map("unit_value") @db.Decimal(19, 4)
  baseQuantity           Decimal @map("base_quantity") @db.Decimal(19, 4)
  baseUnitId             BigInt  @map("base_unit_id") // FK -> md_units (ErpUnit)
  currencyId             BigInt  @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate           Decimal @map("exchange_rate") @db.Decimal(19, 6)
  unitPrice              Decimal @map("unit_price") @db.Decimal(19, 4)
  unitCost               Decimal @map("unit_cost") @db.Decimal(19, 4)
  costLayerInId          BigInt? @map("cost_layer_in_id") // FK -> inv valuation layer
  costLayerFifoId        BigInt? @map("cost_layer_fifo_id") // FK -> inv FIFO valuation layer
  inventoryAccountId     BigInt? @map("inventory_account_id") // FK -> md_accounts (ErpAccount)
  sourceWarehouseId      BigInt? @map("source_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  productionWarehouseId  BigInt? @map("production_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  destinationWarehouseId BigInt? @map("destination_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  costCenterId           BigInt? @map("cost_center_id") // FK -> md_cost_centers (ErpCostCenter)
  divisionId             BigInt? @map("division_id") // FK -> md_divisions (ErpDivision)
  subdivisionId          BigInt? @map("subdivision_id") // FK -> md_subdivisions (ErpSubdivision)
  projectId              BigInt? @map("project_id") // FK -> md_projects (ErpProject)
  notes                  String? @map("notes")
  lineNo                 Int     @map("line_no")
  metadata               Json?   @map("metadata")

  productionRework ErpMfgProductionRework @relation(fields: [productionReworkId], references: [id], onDelete: Cascade)

  @@index([productionReworkId])
  @@index([itemId])
  @@index([unitId])
  @@index([currencyId])
  @@map("mfg_production_rework_outputs")
}
// ── Fase 2 P1: Estimasi cetak ────────────────────────────────────────────────
model ErpMfgPrintEstimate {
  id             BigInt                 @id @default(autoincrement())
  docNumber      String                 @unique @map("doc_number")
  branchId       BigInt                 @map("branch_id") // FK -> md_branches (ErpBranch)
  docDate        DateTime               @map("doc_date") @db.Date
  fiscalPeriodId BigInt                 @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  customerId     BigInt?                @map("customer_id") // FK -> md_partners (ErpPartner)
  itemId         BigInt?                @map("item_id") // FK -> md_items (ErpItem): hasil cetak
  title          String
  paperSize      String?                @map("paper_size")
  pageCount      Int?                   @map("page_count")
  printQuantity  Decimal                @map("print_quantity") @db.Decimal(19, 4)
  colorSpec      String?                @map("color_spec")
  finishing      String?
  marginPercent  Decimal                @default(0) @map("margin_percent") @db.Decimal(5, 2)
  totalCost      Decimal                @default(0) @map("total_cost") @db.Decimal(19, 4)
  totalPrice     Decimal                @default(0) @map("total_price") @db.Decimal(19, 4)
  unitPrice      Decimal                @default(0) @map("unit_price") @db.Decimal(19, 4)
  status         ErpPrintEstimateStatus @default(DRAFT)
  quotationId    BigInt?                @map("quotation_id") // FK -> sls_quotations (ErpSlsQuotation)
  notes          String?
  legacyCode     String?                @map("legacy_code")
  metadata       Json?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")
  createdById    BigInt?                @map("created_by_id")
  updatedById    BigInt?                @map("updated_by_id")

  lines ErpMfgPrintEstimateLine[]

  @@index([status])
  @@index([customerId])
  @@map("mfg_print_estimates")
}

model ErpMfgPrintEstimateLine {
  id         BigInt               @id @default(autoincrement())
  estimateId BigInt               @map("estimate_id")
  lineNo     Int                  @map("line_no")
  component  ErpPrintCostComponent
  description String?
  itemId     BigInt?              @map("item_id") // FK -> md_items (ErpItem): material
  quantity   Decimal              @db.Decimal(19, 4)
  unitId     BigInt?              @map("unit_id") // FK -> md_units (ErpUnit)
  unitCost   Decimal              @map("unit_cost") @db.Decimal(19, 4)
  amount     Decimal              @db.Decimal(19, 4)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  estimate ErpMfgPrintEstimate @relation(fields: [estimateId], references: [id])

  @@index([estimateId])
  @@map("mfg_print_estimate_lines")
}
// ── Fase 2 P2: Job cetak & pre-press (profil di atas Work Order) ─────────────
model ErpMfgPrintJob {
  id             BigInt          @id @default(autoincrement())
  workOrderId    BigInt          @unique @map("work_order_id") // FK -> mfg_work_orders (ErpMfgWorkOrder)
  estimateId     BigInt?         @map("estimate_id") // FK -> mfg_print_estimates (ErpMfgPrintEstimate)
  salesOrderId   BigInt?         @map("sales_order_id") // FK -> sls_orders (ErpSlsOrder)
  stage          ErpPrintJobStage @default(PRE_PRESS)
  paperSize      String?         @map("paper_size")
  pageCount      Int?            @map("page_count")
  printQuantity  Decimal         @map("print_quantity") @db.Decimal(19, 4)
  colorSpec      String?         @map("color_spec")
  finishing      String?
  masterFileName String?         @map("master_file_name")
  checklist      Json            @default("[]")
  stageLog       Json            @default("[]") @map("stage_log")
  costPostedAt   DateTime?       @map("cost_posted_at")
  costJournalDoc String?         @map("cost_journal_doc")

  costEntries ErpMfgJobCostEntry[]
  schedules   ErpMfgJobSchedule[]
  vdpDatasets ErpMfgVdpDataset[]
  notes          String?
  legacyCode     String?         @map("legacy_code")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  createdById    BigInt?         @map("created_by_id")
  updatedById    BigInt?         @map("updated_by_id")

  @@index([stage])
  @@index([estimateId])
  @@map("mfg_print_jobs")
}
// ── Fase 2 P5: Biaya aktual / HPP per job cetak ──────────────────────────────
model ErpMfgJobCostEntry {
  id          BigInt       @id @default(autoincrement())
  jobId       BigInt       @map("job_id")
  entryDate   DateTime     @map("entry_date") @db.Date
  costType    ErpJobCostType @map("cost_type")
  stage       String?
  description String?
  itemId      BigInt?      @map("item_id") // FK -> md_items (ErpItem)
  quantity    Decimal      @default(1) @db.Decimal(19, 4)
  unitId      BigInt?      @map("unit_id") // FK -> md_units (ErpUnit)
  unitCost    Decimal      @map("unit_cost") @db.Decimal(19, 4)
  amount      Decimal      @db.Decimal(19, 4)
  sourceType  String       @default("MANUAL") @map("source_type")
  sourceId    BigInt?      @map("source_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  createdById BigInt?      @map("created_by_id")
  updatedById BigInt?      @map("updated_by_id")

  job ErpMfgPrintJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([costType])
  @@map("mfg_job_cost_entries")
}
// ── Fase 2 P3: Master mesin cetak & jadwal produksi ─────────────────────────
model ErpMfgMachine {
  id              BigInt           @id @default(autoincrement())
  code            String           @unique
  name            String
  machineType     ErpMachineType   @map("machine_type")
  capacityPerHour Decimal          @default(0) @map("capacity_per_hour") @db.Decimal(19, 4)
  capacityUnit    String?          @map("capacity_unit")
  workStart       String           @default("08:00") @map("work_start")
  workEnd         String           @default("17:00") @map("work_end")
  branchId        BigInt?          @map("branch_id") // FK -> md_branches (ErpBranch)
  status          ErpMachineStatus @default(ACTIVE)
  legacyCode      String?          @map("legacy_code")
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  createdById     BigInt?          @map("created_by_id")
  updatedById     BigInt?          @map("updated_by_id")

  schedules ErpMfgJobSchedule[]

  @@map("mfg_machines")
}

model ErpMfgJobSchedule {
  id           BigInt               @id @default(autoincrement())
  jobId        BigInt               @map("job_id")
  machineId    BigInt               @map("machine_id")
  stage        String?
  plannedStart DateTime             @map("planned_start")
  plannedEnd   DateTime             @map("planned_end")
  actualStart  DateTime?            @map("actual_start")
  actualEnd    DateTime?            @map("actual_end")
  status       ErpJobScheduleStatus @default(TERJADWAL)
  sequenceNo   Int                  @default(0) @map("sequence_no")
  notes        String?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  createdById  BigInt?              @map("created_by_id")
  updatedById  BigInt?              @map("updated_by_id")

  job     ErpMfgPrintJob @relation(fields: [jobId], references: [id])
  machine ErpMfgMachine  @relation(fields: [machineId], references: [id])

  @@index([machineId, plannedStart])
  @@index([jobId])
  @@map("mfg_job_schedules")
}
// ── Fase 2 P4: Dataset variable data printing per job ───────────────────────
model ErpMfgVdpDataset {
  id              BigInt              @id @default(autoincrement())
  jobId           BigInt              @map("job_id")
  name            String
  sourceFilename  String?             @map("source_filename")
  version         Int                 @default(1)
  columns         Json                @default("[]")
  requiredColumns Json                @default("[]") @map("required_columns")
  rowCount        Int                 @default(0) @map("row_count")
  validCount      Int                 @default(0) @map("valid_count")
  status          ErpVdpDatasetStatus @default(DRAFT)
  lockedAt        DateTime?           @map("locked_at")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  createdById     BigInt?             @map("created_by_id")
  updatedById     BigInt?             @map("updated_by_id")

  job  ErpMfgPrintJob  @relation(fields: [jobId], references: [id])
  rows ErpMfgVdpRow[]

  @@index([jobId])
  @@map("mfg_vdp_datasets")
}

model ErpMfgVdpRow {
  id        BigInt   @id @default(autoincrement())
  datasetId BigInt   @map("dataset_id")
  rowNo     Int      @map("row_no")
  data      Json     @default("{}")
  isValid   Boolean  @default(true) @map("is_valid")
  errorNote String?  @map("error_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dataset ErpMfgVdpDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, rowNo])
  @@map("mfg_vdp_rows")
}
