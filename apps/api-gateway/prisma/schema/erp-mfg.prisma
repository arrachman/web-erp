model ErpMfgBom {
  id                     BigInt             @id @default(autoincrement())
  docNumber              String             @unique @map("doc_number")
  autoNumber             String?            @map("auto_number")
  docType                ErpMfgDocType      @default(BOM) @map("doc_type")
  kind                   String?            @map("kind")
  legacyCode             String?            @map("legacy_code")
  branchId               BigInt             @map("branch_id") // FK -> md_branches (ErpBranch)
  locationId             BigInt?            @map("location_id") // FK -> md_locations (ErpLocation)
  sourceWarehouseId      BigInt?            @map("source_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  productionWarehouseId  BigInt?            @map("production_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  destinationWarehouseId BigInt?            @map("destination_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  docDate                DateTime           @map("doc_date") @db.Date
  fiscalPeriodId         BigInt             @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  requestedById          BigInt?            @map("requested_by_id") // FK -> adm_users (ErpUser)
  requestedPartnerId     BigInt?            @map("requested_partner_id") // FK -> md_partners (ErpPartner)
  neededDate             DateTime?          @map("needed_date") @db.Date
  workEstimate           Decimal?           @map("work_estimate") @db.Decimal(19, 4)
  currencyId             BigInt             @map("currency_id") // FK -> md_currencies (ErpCurrency)
  exchangeRate           Decimal            @map("exchange_rate") @db.Decimal(19, 6)
  inputTotalPrice        Decimal?           @map("input_total_price") @db.Decimal(19, 4)
  outputTotalPrice       Decimal?           @map("output_total_price") @db.Decimal(19, 4)
  inputTotalCost         Decimal?           @map("input_total_cost") @db.Decimal(19, 4)
  outputTotalCost        Decimal?           @map("output_total_cost") @db.Decimal(19, 4)
  description            String?            @map("description")
  notes                  String?            @map("notes")
  referenceNo            String?            @map("reference_no")
  referenceDate          DateTime?          @map("reference_date") @db.Date
  sourceDocType          String?            @map("source_doc_type")
  status                 ErpDocumentStatus  @map("status")
  previousStatus         ErpDocumentStatus? @map("previous_status")
  revisionCount          Int                @default(0) @map("revision_count")
  printCount             Int                @default(0) @map("print_count")
  postingStatus          ErpPostingStatus   @map("posting_status")
  postedAt               DateTime?          @map("posted_at") @db.Timestamptz(6)
  metadata               Json?              @map("metadata")
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById            BigInt?            @map("created_by_id")
  updatedById            BigInt?            @map("updated_by_id")

  inputs            ErpMfgBomInput[]
  outputs           ErpMfgBomOutput[]
  workOrders        ErpMfgWorkOrder[]
  materialIssues    ErpMfgMaterialIssue[]
  materialReturns   ErpMfgMaterialReturn[]
  productionEntries ErpMfgProductionEntry[]
  productionReworks ErpMfgProductionRework[]
  productionBoms    ErpMfgProductionBom[]

  @@index([branchId])
  @@index([locationId])
  @@index([sourceWarehouseId])
  @@index([productionWarehouseId])
  @@index([destinationWarehouseId])
  @@index([fiscalPeriodId])
  @@index([requestedById])
  @@index([requestedPartnerId])
  @@index([currencyId])
  @@index([legacyCode])
  @@map("mfg_boms")
}

