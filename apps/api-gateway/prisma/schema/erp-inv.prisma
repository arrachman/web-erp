  reservations         ErpInvStockReservation[]

  @@unique([itemId, lotNumber])
  @@index([itemId, status])
  @@index([expiryDate])
  @@index([legacyCode])
  @@map("inv_lots")
}

model ErpInvSerial {
  id                   BigInt          @id @default(autoincrement())
  serialNumber         String          @map("serial_number")
  legacyCode           String?         @map("legacy_code")
  itemId               BigInt          @map("item_id") // FK -> md_items (ErpItem)
  lotId                BigInt?         @map("lot_id")
  currentWarehouseId   BigInt?         @map("current_warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  currentBinId         BigInt?         @map("current_bin_id")
  status               ErpSerialStatus @map("status")
  originGoodsReceiptId BigInt?         @map("origin_goods_receipt_id") // FK -> pur_goods_receipts (ErpPurGoodsReceipt)
  lastMovementId       BigInt?         @map("last_movement_id")
  warrantyUntil        DateTime?       @map("warranty_until") @db.Date
  notes                String?         @map("notes")
  metadata             Json?           @map("metadata")
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById          BigInt?         @map("created_by_id")
  updatedById          BigInt?         @map("updated_by_id")

  lot                  ErpInvLot?                  @relation(fields: [lotId], references: [id])
  currentBin           ErpInvBin?                  @relation(fields: [currentBinId], references: [id])
  lastMovement         ErpInvStockMovement?        @relation("ErpInvSerial_lastMovement", fields: [lastMovementId], references: [id])
  movementLines        ErpInvStockMovementLine[]
  openingStockLines    ErpInvOpeningStockLine[]
  stockCountLines      ErpInvStockCountLine[]
  stockAdjustmentLines ErpInvStockAdjustmentLine[]

  @@unique([itemId, serialNumber])
  @@index([itemId, status])
  @@index([currentWarehouseId])
  @@index([lotId])
  @@index([currentBinId])
  @@index([lastMovementId])
  @@index([legacyCode])
  @@map("inv_serials")
}

model ErpInvStockReservation {
  id                    BigInt               @id @default(autoincrement())
  legacyCode            String?              @map("legacy_code")
  itemId                BigInt               @map("item_id") // FK -> md_items (ErpItem)
  warehouseId           BigInt               @map("warehouse_id") // FK -> md_warehouses (ErpWarehouse)
  binId                 BigInt?              @map("bin_id")
  lotId                 BigInt?              @map("lot_id")
  quantity              Decimal              @map("quantity") @db.Decimal(19, 4)
  sourceDocType         String               @map("source_doc_type")
  sourceDocId           BigInt               @map("source_doc_id")
  sourceLineId          BigInt?              @map("source_line_id")
  status                ErpReservationStatus @map("status")
  expiresAt             DateTime?            @map("expires_at") @db.Timestamptz(6)
  fulfilledByMovementId BigInt?              @map("fulfilled_by_movement_id")
  metadata              Json?                @map("metadata")
  deletedAt             DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById           BigInt?              @map("created_by_id")
  updatedById           BigInt?              @map("updated_by_id")

  bin                 ErpInvBin?           @relation(fields: [binId], references: [id])
  lot                 ErpInvLot?           @relation(fields: [lotId], references: [id])
  fulfilledByMovement ErpInvStockMovement? @relation("ErpInvStockReservation_fulfilledByMovement", fields: [fulfilledByMovementId], references: [id])

  @@index([itemId, warehouseId, status])
  @@index([sourceDocType, sourceDocId])
  @@index([binId])
  @@index([lotId])
  @@index([fulfilledByMovementId])
  @@index([legacyCode])
  @@map("inv_stock_reservations")
}

model ErpInvDailyCheck {
  id             BigInt            @id @default(autoincrement())
  docNumber      String            @unique @map("doc_number")
  autoNumber     String?           @map("auto_number")
  legacyCode     String?           @map("legacy_code")
  branchId       BigInt            @map("branch_id") // FK -> md_branches
  locationId     BigInt?           @map("location_id") // FK -> md_locations
  checkDate      DateTime          @map("check_date") @db.Date
  fiscalPeriodId BigInt            @map("fiscal_period_id") // FK -> sys_fiscal_periods
  machineRef     String?           @map("machine_ref")
  operatorRef    String?           @map("operator_ref")
  description    String?           @map("description")
  notes          String?           @map("notes")
  status         ErpDocumentStatus @map("status")
  postingStatus  ErpPostingStatus  @map("posting_status")
  postedAt       DateTime?         @map("posted_at") @db.Timestamptz(6)
  metadata       Json?             @map("metadata")
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    BigInt?           @map("created_by_id")
  updatedById    BigInt?           @map("updated_by_id")

  lines ErpInvDailyCheckLine[]

  @@index([fiscalPeriodId])
  @@index([legacyCode])
  @@map("inv_daily_checks")
}

model ErpInvDailyCheckLine {
  id           BigInt   @id @default(autoincrement())
  dailyCheckId BigInt   @map("daily_check_id")
  itemId       BigInt   @map("item_id") // FK -> md_items
  quantity     Decimal  @map("quantity") @db.Decimal(19, 4)
  unitId       BigInt   @map("unit_id") // FK -> md_units
  warehouseId  BigInt?  @map("warehouse_id") // FK -> md_warehouses
  costCenterId BigInt?  @map("cost_center_id") // FK -> md_cost_centers
  notes        String?  @map("notes")
  machineRef   String?  @map("machine_ref")
  workHours    Decimal? @map("work_hours") @db.Decimal(19, 4)
  lineNo       Int      @map("line_no")

  dailyCheck ErpInvDailyCheck @relation(fields: [dailyCheckId], references: [id], onDelete: Cascade)

  @@index([dailyCheckId])
  @@index([itemId])
  @@map("inv_daily_check_lines")
}

/// Lampiran dokumen pendukung transaksi Inventory/Warehouse — generik, berkunci
/// (doc_type, doc_id). doc_id polymorphic lintas tabel transaksi inv
/// (tanpa FK; index saja). File di uploads/erp-transactions (bind-mount host).
model ErpInvTransactionAttachment {
  id          BigInt   @id @default(autoincrement())
  docType     String   @map("doc_type")
  docId       BigInt   @map("doc_id")
  fileName    String   @map("file_name")
  storedName  String   @unique @map("stored_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  note        String?  @map("note")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")

  @@index([docType, docId])
  @@map("inv_transaction_attachments")
}
