  requestedPartnerId     BigInt?              @map("requested_partner_id") // FK -> md_partners (ErpPartner)
  requestedTo            String?              @map("requested_to")
  neededDate             DateTime?            @map("needed_date") @db.Date
  relatedMovementId      BigInt?              @map("related_movement_id")
  description            String?              @map("description")
  notes                  String?              @map("notes")
  referenceNo            String?              @map("reference_no")
  referenceDate          DateTime?            @map("reference_date") @db.Date
  status                 ErpDocumentStatus    @map("status")
  previousStatus         ErpDocumentStatus?   @map("previous_status")
  revisionCount          Int                  @default(0) @map("revision_count")
  printCount             Int                  @default(0) @map("print_count")
  postingStatus          ErpPostingStatus     @map("posting_status")
  postedAt               DateTime?            @map("posted_at") @db.Timestamptz(6)
  metadata               Json?                @map("metadata")
  deletedAt              DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById            BigInt?              @map("created_by_id")
  updatedById            BigInt?              @map("updated_by_id")

  lines                 ErpInvStockMovementLine[]
  relatedMovement       ErpInvStockMovement?      @relation("ErpInvStockMovement_relatedMovement", fields: [relatedMovementId], references: [id])
  childMovements        ErpInvStockMovement[]     @relation("ErpInvStockMovement_relatedMovement")
  reservationsFulfilled ErpInvStockReservation[]  @relation("ErpInvStockReservation_fulfilledByMovement")
  serialsLastTouched    ErpInvSerial[]            @relation("ErpInvSerial_lastMovement")

  @@index([movementType, status])
  @@index([fiscalPeriodId])
  @@index([relatedMovementId])
  @@index([legacyCode])
  @@map("inv_stock_movements")
}

model ErpInvStockMovementLine {
