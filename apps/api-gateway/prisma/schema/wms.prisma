model MasterDataContact {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  tax              String?
  website          String?
  address          String?
  street           String?
  city             String?
  province         String?
  zipCode          String?         @map("zip_code")
  type             String
  contactFirstName String?         @map("contact_first_name")
  contactEmail     String?         @map("contact_email")
  contactPhone     String?         @map("contact_phone")
  createdAt        DateTime        @default(now()) @map("created_at")
  createdBy        Int?            @map("created_by")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  updatedBy        Int?            @map("updated_by")
  deletedAt        DateTime?       @map("deleted_at")
  deletedBy        Int?            @map("deleted_by")
  deliveryOrders   DeliveryOrder[]
  inbounds         Inbound[]       @relation("InboundSupplier")

  @@map("m1_contact")
}

model MasterDataUom {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String
  type             String
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        Int?              @map("created_by")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  updatedBy        Int?              @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        Int?              @map("deleted_by")
  items            MasterDataItem[]
  inventoryLedgers InventoryLedger[]

  @@map("m1_uom")
}

model MasterDataDivision {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   Int?      @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   Int?      @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   Int?      @map("deleted_by")

  @@map("m1_division")
}

model MasterDataProvince {
  id        Int              @id @default(autoincrement())
  name      String
  isoCode   String           @unique @map("iso_code")
  createdAt DateTime         @default(now()) @map("created_at")
  createdBy Int?             @map("created_by")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")
  updatedBy Int?             @map("updated_by")
  deletedAt DateTime?        @map("deleted_at")
  deletedBy Int?             @map("deleted_by")
  cities    MasterDataCity[]

  @@map("m1_province")
}

model MasterDataCity {
  id         Int       @id @default(autoincrement())
  provinceId Int       @map("province_id")
  name       String
  postalCode String    @map("postal_code")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  Int?      @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  Int?      @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  Int?      @map("deleted_by")

  province       MasterDataProvince    @relation(fields: [provinceId], references: [id])
  warehouses     MasterDataWarehouse[]
  deliveryOrders DeliveryOrder[]       @relation("DoDestinationCity")
  citySlas       MasterDataCitySla[]

  @@map("m1_city")
}

model MasterDataCitySla {
  id              Int       @id @default(autoincrement())
  cityId          Int       @map("city_id")
  stdLeadTimeDays Int       @default(0) @map("std_lead_time_days")
  stdReturnDoDays Int       @default(0) @map("std_return_do_days")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       Int?      @map("created_by")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy       Int?      @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       Int?      @map("deleted_by")

  city MasterDataCity @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@map("m1_city_sla")
}

model MasterDataWarehouse {
  id               Int               @id @default(autoincrement())
  name             String
  cityId           Int               @map("city_id")
  locationName     String?           @map("location_name")
  addressDetail    String?           @map("address_detail")
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        Int?              @map("created_by")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  updatedBy        Int?              @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        Int?              @map("deleted_by")
  city             MasterDataCity    @relation(fields: [cityId], references: [id])
  deliveryOrders   DeliveryOrder[]
  inbounds         Inbound[]
  users            User[]
  inventoryLedgers InventoryLedger[]

  @@map("m1_warehouse")
}

model MasterDataItem {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  category  String
  uomId     Int       @map("uom_id")
  itemType  String    @map("item_type")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy Int?      @map("created_by")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy Int?      @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  uom              MasterDataUom         @relation(fields: [uomId], references: [id])
  doDetails        DeliveryOrderDetail[]
  inboundDetails   InboundDetail[]
  inventoryBatches InventoryBatch[]
  inventoryLedgers InventoryLedger[]

  @@map("m1_item")
}
