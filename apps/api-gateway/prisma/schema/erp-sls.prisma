  discountAmount     Decimal? @map("discount_amount") @db.Decimal(19, 4)
  tax1Id             BigInt?  @map("tax1_id") // FK -> md_taxes (ErpTax)
  tax1Amount         Decimal? @map("tax1_amount") @db.Decimal(19, 4)
  tax2Id             BigInt?  @map("tax2_id") // FK -> md_taxes (ErpTax)
  tax2Amount         Decimal? @map("tax2_amount") @db.Decimal(19, 4)
