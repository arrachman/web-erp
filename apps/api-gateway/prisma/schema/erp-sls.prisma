  @@index([legacyCode])
  @@index([branchId])
  @@index([customerId])
  @@index([fiscalPeriodId])
  @@map("sls_invoice_swaps")
}

model ErpSlsInvoiceSwapLine {
  id            BigInt  @id @default(autoincrement())
  swapId        BigInt  @map("swap_id")
  fromInvoiceId BigInt  @map("from_invoice_id")
  toInvoiceId   BigInt? @map("to_invoice_id")
  amount        Decimal @db.Decimal(19, 4)
  lineNo        Int     @map("line_no")

  swap        ErpSlsInvoiceSwap @relation(fields: [swapId], references: [id], onDelete: Cascade)
  fromInvoice ErpSlsInvoice     @relation("ErpSlsInvoiceSwapLine_fromInvoice", fields: [fromInvoiceId], references: [id])
  toInvoice   ErpSlsInvoice?    @relation("ErpSlsInvoiceSwapLine_toInvoice", fields: [toInvoiceId], references: [id])

  @@index([swapId])
  @@index([fromInvoiceId])
  @@index([toInvoiceId])
  @@map("sls_invoice_swap_lines")
}

model ErpSlsForecast {
  id           BigInt            @id @default(autoincrement())
  code         String            @unique @map("code")
  legacyCode   String?           @map("legacy_code")
  docNumber    String            @unique @map("doc_number")
  forecastDate DateTime          @map("forecast_date") @db.Date
  branchId     BigInt            @map("branch_id") // FK -> md_branches (ErpBranch)
  customerId   BigInt            @map("customer_id") // FK -> md_partners (ErpPartner)
  salesDeptId  BigInt?           @map("sales_dept_id") // FK -> md_divisions (ErpDivision)
  currencyId   BigInt            @map("currency_id") // FK -> md_currencies (ErpCurrency)
  description  String?           @map("description")
  status       ErpDocumentStatus @map("status")
  metadata     Json?             @map("metadata")
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  BigInt?           @map("created_by_id")
  updatedById  BigInt?           @map("updated_by_id")

  lines ErpSlsForecastLine[]

  @@index([legacyCode])
  @@index([branchId])
  @@index([customerId])
  @@map("sls_forecasts")
}

model ErpSlsForecastLine {
  id             BigInt  @id @default(autoincrement())
  forecastId     BigInt  @map("forecast_id")
  itemId         BigInt  @map("item_id") // FK -> md_items (ErpItem)
  quantity       Decimal @db.Decimal(19, 4)
  unitId         BigInt  @map("unit_id") // FK -> md_units (ErpUnit)
  fiscalPeriodId BigInt? @map("fiscal_period_id") // FK -> sys_fiscal_periods (ErpFiscalPeriod)
  notes          String? @map("notes")
  lineNo         Int     @map("line_no")

  forecast ErpSlsForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@index([forecastId])
  @@index([itemId])
  @@map("sls_forecast_lines")
}

/// Lampiran dokumen pendukung transaksi Sales — generik, berkunci
/// (doc_type, doc_id). doc_id polymorphic lintas tabel transaksi sls
/// (tanpa FK; index saja). File di uploads/erp-transactions (bind-mount host).
model ErpSlsTransactionAttachment {
  id          BigInt   @id @default(autoincrement())
  docType     String   @map("doc_type")
  docId       BigInt   @map("doc_id")
  fileName    String   @map("file_name")
  storedName  String   @unique @map("stored_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  note        String?  @map("note")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")

  @@index([docType, docId])
  @@map("sls_transaction_attachments")
}
