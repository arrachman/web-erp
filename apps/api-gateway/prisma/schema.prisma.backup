// Task B0001: Database Schema Design
// This schema defines the core data models for the Sentient Factory API Gateway.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  uuid         String   @id @default(cuid()) @map("id")
  id           Int      @default(autoincrement()) @unique
  email        String   @unique
  username     String   @unique
  passwordHash String
  fullName     String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles       UserRole[]
  departments UserDepartment[]
  sessions    Session[]
  auditLogs   AuditLog[]
}

model Role {
  id          String   @id @default(cuid())
  serialId    Int      @default(autoincrement()) @unique
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  serialId    Int      @default(autoincrement()) @unique
  name        String   @unique
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id          String   @id @default(cuid())
  serialId    Int      @default(autoincrement()) @unique
  roleId      String
  permissionId String
  assignedAt  DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Department {
  id          String   @id @default(cuid())
  serialId    Int      @default(autoincrement()) @unique
  name        String
  code        String   @unique
  description String?
  parentId    String?
  managerId   String?
  createdAt   DateTime @default(now())

  parent   Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[]     @relation("DepartmentHierarchy")
  users    UserDepartment[]
}

model UserRole {
  id        String   @id @default(cuid())
  serialId  Int      @default(autoincrement()) @unique
  userId    String
  roleId    String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model UserDepartment {
  id           String   @id @default(cuid())
  serialId     Int      @default(autoincrement()) @unique
  userId       String
  departmentId String
  joinedAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
}

model Session {
  id           String   @id @default(cuid())
  serialId     Int      @default(autoincrement()) @unique
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  serialId    Int      @default(autoincrement()) @unique
  userId      String?
  action      String
  entityType  String
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}