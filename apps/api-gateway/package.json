{
  "name": "web-erp-api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway khusus Senti ERP (web-erp) — dipindah dari sentient-factory/apps/api-gateway, dibersihkan dari modul MDP/clinic/HR",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src/**/*.ts --max-warnings 0",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm run test -- --passWithNoTests",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:erp": "ts-node prisma/seed-erp.ts",
    "db:seed:manufacturing": "ts-node prisma/seed-erp-manufacturing.ts",
    "db:seed:erp:taxes-id": "ts-node prisma/seed-erp-md-taxes-indonesia.ts",
    "db:seed:geo": "ts-node prisma/seed-md-geo.ts",
    "db:seed:departments": "ts-node prisma/seed-md-departments.ts",
    "db:seed:sub-departments": "ts-node prisma/seed-md-sub-departments.ts",
    "db:seed:warehouses": "ts-node prisma/seed-md-warehouses.ts",
    "db:seed:supplier-categories": "ts-node prisma/seed-erp-md-supplier-categories.ts",
    "db:seed:payment-terms": "ts-node prisma/seed-erp-payment-terms.ts",
    "db:seed:accounts": "ts-node prisma/seed-erp-accounts.ts",
    "db:seed:transaction-notes": "ts-node prisma/seed-erp-transaction-notes.ts",
    "db:seed:item-txn-types": "ts-node prisma/seed-erp-stock-adjustment-types.ts",
    "db:seed:stock-adjustment-types": "ts-node prisma/seed-erp-stock-adjustment-types.ts",
    "db:seed:txn-note-details": "ts-node prisma/seed-erp-txn-note-details.ts",
    "db:seed:fiscal-periods": "ts-node prisma/seed-erp-fiscal-periods.ts",
    "db:ensure-system-user": "ts-node prisma/ensure-system-user.ts",
    "db:backfill:inventory-ledger": "ts-node prisma/backfill-inventory-ledger.ts",
    "db:studio": "prisma studio",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^3.4.5",
    "@sentry/nestjs": "^10.52.0",
    "@sentry/node": "^10.52.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "bullmq": "^5.76.6",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "docx": "^9.7.1",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "kode-wilayah-id": "^1.2.0",
    "mysql2": "^3.17.4",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "pdfmake": "^0.3.9",
    "react": "^18.3.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.0.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
