    Public Function M4_GrnOld(ByVal tglawal As String, tglakhir As String) As String 'progress?errMessage?sqljurnal?sqlupdateposting
        'PERSEDIAAN (D)
        '         HUTANG SEMENTARA (K)


        'AMBIL DATA ==========================================================
        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT * FROM m4_" & sumber & " WHERE " & sumber & "status IN (2, 3, 4, 7) AND " & sumber & "tgl BETWEEN '" & FixQuotes(tglawal) & "' AND '" & FixQuotes(tglakhir) & "' ORDER BY grnid", strCon)
        If dtutama.Rows.Count = 0 Then GoTo selesai
        log("Data Utama Done " & dtutama.Rows.Count.ToString & " *" & sumber)

        'DETAIL
        dtdetail = AsDataTableAmbilDariDB("SELECT grnd.*, i.bhpp FROM m4_" & sumber & "_detail grnd JOIN m4_grn grn ON grnd.idgrn = grn.grnid JOIN m1_item i ON grnd.idbarang = i.bid WHERE id" & sumber & " BETWEEN " + dtutama.Rows(0)(sumber & "id").ToString + " AND " + dtutama.Rows(dtutama.Rows.Count - 1)(sumber & "id").ToString, strCon)
        log("Data Detail Done " & dtdetail.Rows.Count.ToString)

        'COST
        dtcost = AsDataTableAmbilDariDB("SELECT grnc.* FROM m4_grn_cost grnc JOIN m4_grn grn ON grnc.idgrn = grn.grnid WHERE grn.grnid BETWEEN " + dtutama.Rows(0)(sumber & "id").ToString + " AND " + dtutama.Rows(dtutama.Rows.Count - 1)(sumber & "id").ToString + " ORDER BY grnc.idgrn, grnc.urutan", strCon)
        log("Data Cost Done " & dtcost.Rows.Count.ToString)
        rsSql = "DELETE FROM M2_Transaction_Journal WHERE tsumber = '" & sumber & "' AND ttgl BETWEEN '" & FixQuotes(tglawal) & "' AND '" & FixQuotes(tglakhir) & "';"

        'SET DATA UTAMA ====================================================
        For Each drutama As DataRow In dtutama.Rows
            dtjurnal.Rows.Clear()
            'SET DATA UTAMA --------------------------------------

            'SET SUMBER DAN NOTRANSAKSI
            idutama = drutama("grnid")
            noTransaksi = drutama("grnnotransaksi")
            termasukPajak = Integer.Parse(drutama("grnhargatermasukpajak"))
            'END OF SET DATA UTAMA -------------------------------

            'TAMBAHKAN FIELD TOTALFUNGSIONAL PADA DT DETAIL
            drfilter = dtdetail.Select("id" & sumber & " = " + drutama(sumber & "id").ToString, "")
            If drfilter.Count <= 0 Then
                log("Tidak ada detail id" & sumber & " = " + drutama(sumber & "id").ToString) : GoTo selanjutnya
            Else
                dtfilter = drfilter.CopyToDataTable
            End If

            AsDataTableTambahField(dtfilter, "totalfungsional", AsEnumTypeData.AsDouble)

            'PERHITUNGAN TOTALFUNGSIONAL BERDASARKAN HARGA TERMASUK PAJAK ATAU TIDAK
            If termasukPajak Then
