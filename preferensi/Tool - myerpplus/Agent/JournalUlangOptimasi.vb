                    strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("rpcabang")) & "', '" & FixQuotes(drutama("rplokasi")) & "', '" & FixQuotes(drutama("rpsumber")) & "', " & 0 & ", " & drutama("rpid") & ", '" & FixQuotes(drutama("rpnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("rptgl"))) & "', " & drutama("rpkodepa") & ", " & drutama("rpkontak") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("rpuraian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("rpmatauang")) & "', '" & FixDouble(drutama("rpkurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal("nominal")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalas")) & "', " & 0 & ", " & 0 & ", '" & FixQuotes(AsFormatTanggal(drutama("rptgljatuhtempo"))) & "', '" & FixQuotes(AsFormatTanggal(drutama("rptgllunas"))) & "', " & drutama("rpstatusbayar") & ", '1900-01-01', " & 0 & ", " & drjurnal("urutan") & ", '', 0, 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '" & FixDouble(drutama("rpjumlahbayar")) & "', " & drutama("rpstatusbayar") & ", " & drutama("rpstatus") & ", 1, NOW(), " & drutama("rpjmlrevisi") & ", " & drutama("rpcetakanke") & ", " & drutama("rpinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("rpinputtgl"), formatTglWaktuDB)) & "', " & drutama("rpmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("rpmodifikasitgl"), formatTglWaktuDB)) & "')")
                End If
            Next

            If num Mod LimitPerulangan = 0 And num > 0 Then
                rsSql += sptRow + "Insert into M2_Transaction_Journal(tid, tcabang, tlokasi, tsumber, tkodetabelangka, tidtransaksi, tnotransaksi, ttgl, tkodepa, tkontak, tnorek, turaian, tcatatan, tmatauang, tkurs, tnobon, tdebit, tkredit, tdebitvalas, tkreditvalas, tcarabayar, thutangpiutang, ttgljatuhtempo, ttgllunas, tstatuslunas, ttglrekonsiliasi, tsudahrekonsiliasi, turutan, tnohutangpiutang, tsaldoawal, tadjustment, tcostcenter, tdivisi, tsubdivisi, tproyek, tgrup, tretail, tjenisaruskas, tjmlrealisasium, tstatusrealisasi, tstatus, tposting, tpostingtgl, tjmlrevisi, tcetakanke, tinputuser, tinputtgl, tmodifikasiuser, tmodifikasitgl) VALUES " & strValue.ToString & ";"
                log("Hitung Ulang data ke " + num.ToString + " - " + dtutama.Rows.Count.ToString)
                numDetail = numDetail + 1 : strValue = New StringBuilder
            End If
            num += 1
        Next

        If Not strValue.ToString.Contains("Insert into M2_Transaction_Journal") And strValue.ToString.Length > 0 Then
            rsSql += sptRow + "Insert into M2_Transaction_Journal(tid, tcabang, tlokasi, tsumber, tkodetabelangka, tidtransaksi, tnotransaksi, ttgl, tkodepa, tkontak, tnorek, turaian, tcatatan, tmatauang, tkurs, tnobon, tdebit, tkredit, tdebitvalas, tkreditvalas, tcarabayar, thutangpiutang, ttgljatuhtempo, ttgllunas, tstatuslunas, ttglrekonsiliasi, tsudahrekonsiliasi, turutan, tnohutangpiutang, tsaldoawal, tadjustment, tcostcenter, tdivisi, tsubdivisi, tproyek, tgrup, tretail, tjenisaruskas, tjmlrealisasium, tstatusrealisasi, tstatus, tposting, tpostingtgl, tjmlrevisi, tcetakanke, tinputuser, tinputtgl, tmodifikasiuser, tmodifikasitgl) VALUES " & strValue.ToString & ";"
            log("Hitung Ulang data ke " + num.ToString + " - " + dtutama.Rows.Count.ToString)
        End If
        log("Proses Hitung Ulang Done ...")
        rsProgress = 1
selesai:
        wsResult = String.Concat(rsProgress, sptSubParam, rsErrMessage, sptSubParam, rsSql)
        Return wsResult
    End Function
