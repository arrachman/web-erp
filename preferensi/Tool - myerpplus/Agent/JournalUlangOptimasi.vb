                        strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("ricabang")) & "', '" & FixQuotes(drutama("rilokasi")) & "', '" & FixQuotes(drutama("risumber")) & "', " & 0 & ", " & drutama("riid") & ", '" & FixQuotes(drutama("rinotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("ritgl"))) & "', " & drutama("rikodepa") & ", " & drutama("risupplier") & ", '" & FixQuotes(drjurnal2("norek")) & "', '" & FixQuotes(drutama("riuraian")) & "', '" & FixQuotes(drjurnal2("catatan")) & "', '" & FixQuotes(drutama("rimatauang")) & "', '" & FixDouble(drutama("rikurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal2("nominalfix")) & "', '" & 0 & "', '" & FixDouble(drjurnal2("nominalvalasfix")) & "', " & 0 & ", " & 0 & ", '" & FixQuotes(AsFormatTanggal(drutama("ritgljatuhtempo"))) & "', '" & FixQuotes(AsFormatTanggal(drutama("ritgllunas"))) & "', " & FixDouble(drutama("ristatuslunas")) & ", '1900-01-01', " & 0 & ", " & urutan & ", '', " & FixDouble(drutama("risaldoawal")) & ", 0, '" & FixQuotes(drjurnal2("costcenter")) & "', '" & FixQuotes(drjurnal2("divisi")) & "', '" & FixQuotes(drjurnal2("subdivisi")) & "', '" & FixQuotes(drjurnal2("proyek")) & "', 2, 0, 'O', '0', 0, " & drutama("ristatus") & ", 1, NOW(), " & drutama("rijmlrevisi") & ", " & drutama("ricetakanke") & ", " & drutama("riinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("riinputtgl"), formatTglWaktuDB)) & "', " & drutama("rimodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("rimodifikasitgl"), formatTglWaktuDB)) & "')")
                    End If
