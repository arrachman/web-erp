            'PEND. PENJUALAN DIAMBILKAN DARI DATA TRANSAKSI DETAIL
            For Each drdetail As DataRow In dtutama.Rows
                debitkredit = 1
                'JIKA MENGGUNAKAN MATAUANG VALAS MAKA PERHITUNGAN VALAS, ELSE MAKA PERHITUNGAN BIASA
