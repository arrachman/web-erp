#Region "M2_Cr"
    Public Function M2_Cr(ByVal tglawal As String, tglakhir As String) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'KAS (+D)
        '         AKUN LAWAN (K)
        numDetail = numDetail + 1 : strValue = New StringBuilder
        'AMBIL DATA ==========================================================
        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT * FROM m2_cr WHERE crstatus IN (2, 3, 4, 7) AND crtgl BETWEEN '" & FixQuotes(tglawal) & "' AND '" & FixQuotes(tglakhir) & "' ORDER BY crid", strCon)
        If dtutama.Rows.Count = 0 Then GoTo selesai
        log("Data Utama Done " & dtutama.Rows.Count.ToString & " *" & sumber)
        'DETAIL
        querySelectDetail = "SELECT * FROM m2_cr_detail "
        dtdetail = AsDataTableAmbilDariDB(querySelectDetail & "WHERE id" & sumber & " BETWEEN " + dtutama.Rows(0)(sumber & "id").ToString + " AND " + dtutama.Rows(dtutama.Rows.Count - 1)(sumber & "id").ToString, strCon)
        log("Data Detail Done " & dtdetail.Rows.Count.ToString)

