#Region "M11_RO"
    Public Function M11_Ro(ByVal tglawal As String, tglakhir As String) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'GROUP 1 : =====================
        'RETUR PENJUALAN (D)
        '           PIUTANG SEMENTARA   (K)

        'DISINI HANYA MEMBUAT GROUP 1, GROUP 2 DIPROSES PADA TOOLS HPP
        'GROUP 2 : =====================
        'PERSEDIAAN           (D)
        '           HPP        (K)

        'AMBIL DATA ==========================================================
        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT ro.*, (CASE rocustomer WHEN 2 THEN k.knama ELSE p.pnama END) AS ropasiennama, c.kid as idkontak FROM m_11_ro ro LEFT JOIN m1_patient p ON (ro.rocustomer = p.pid) LEFT JOIN m1_contact c ON (CASE rocustomer WHEN 2 THEN ro.rocustomer = c.kid ELSE p.pkode = c.kkode AND c.kkategori = 'P' END) LEFT JOIN m1_contact k ON (p.pid = k.kid) WHERE " & sumber & "status IN (2, 3, 4, 7) AND " & sumber & "tgl BETWEEN '" & FixQuotes(tglawal) & "' AND '" & FixQuotes(tglakhir) & "'", strCon)
        If dtutama.Rows.Count = 0 Then GoTo selesai
        log("Data Utama Done " & dtutama.Rows.Count.ToString & " *" & sumber)
        'DETAIL
        dtdetail = AsDataTableAmbilDariDB("SELECT * FROM m_11_" & sumber & "_detail WHERE id" & sumber & " BETWEEN " + dtutama.Rows(0)(sumber & "id").ToString + " AND " + dtutama.Rows(dtutama.Rows.Count - 1)(sumber & "id").ToString, strCon)
        log("Data Detail Done " & dtdetail.Rows.Count.ToString)

        rsSql = "DELETE FROM M2_Transaction_Journal WHERE tsumber = '" & sumber & "' AND tgrup = '1' AND tidtransaksi BETWEEN " + dtutama.Rows(0)(sumber & "id").ToString + " AND " + dtutama.Rows(dtutama.Rows.Count - 1)(sumber & "id").ToString + ";"

        For Each drutama As DataRow In dtutama.Rows
            dtjurnal.Rows.Clear()

            'JIKA TERDAPAT DATA MAKA BUAT JURNAL
            ' If dtutama.Rows.Count > 0 And dtdetail.Rows.Count > 0 Then

            drfilter = dtdetail.Select("id" & sumber & " = " + drutama(sumber & "id").ToString, "")
            If drfilter.Length <= 0 Then log("id" & sumber & " = " + drutama(sumber & "id").ToString)
            For x = 0 To drfilter.Length - 1
                drdetail = drfilter(x)
                debitkredit = 0
                'JIKA MENGGUNAKAN MATAUANG VALAS MAKA PERHITUNGAN VALAS, ELSE MAKA PERHITUNGAN BIASA
                If drutama("romatauang").ToString <> matauang Then
                    'NOMINAL = (((jml * harga) - jmldiskon) * kurs
                    nominal = ((Double.Parse(drdetail("jml")) * Double.Parse(drdetail("harga"))) - Double.Parse(drdetail("jmldiskon"))) * Double.Parse(drdetail("kurs"))
                    'NOMINAL VALAS = (jml * harga) - jmldiskon
                    nominalvalas = (Double.Parse(drdetail("jml")) * Double.Parse(drdetail("harga"))) - Double.Parse(drdetail("jmldiskon"))

                    'JIKA MENGGUNAKAN MATAUANG FUNGSIONAL MAKA PERHITUNGAN BIASA
                Else
                    'NOMINAL = (jml * harga) - jmldiskon
