            noTransaksi = drutama("aknotransaksi")
            'END OF SET DATA UTAMA -------------------------------

            'AKUN DEBIT ------------------------------------------
            'PIUTANG USAHA ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            debitkredit = 0
            'NOMINAL = sitotaltransaksi * kurs
            nominal = Double.Parse(drutama("aktotaltransaksi")) * Double.Parse(drutama("akkurs"))
            If nominal <> 0 Then
                'NOMINAL VALAS JIKA MENGGUNAKAN MATAUANG VALAS
                If drutama("akmatauang").ToString <> matauang Then
                    'NOMINAL VALAS = sitotaltransaksi
                    nominalvalas = Double.Parse(drutama("aktotaltransaksi"))
                Else
                    nominalvalas = 0
