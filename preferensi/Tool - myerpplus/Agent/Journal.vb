            'END OF PPN KELUARAN2 ~~~~~~~~~~~~~~~~~~~~~~~~~

            'PEND. LAIN-LAIN ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            debitkredit = 0
            'NOMINAL = srbiayalain * kurs
            nominal = Double.Parse(drutama("srbiayalain")) * Double.Parse(drutama("srkurs"))
