            'TAMBAHKAN SQL UNTUK UPDATE TGLPOSTING SI
            rsSql = String.Concat(rsSql, sptRow, "UPDATE m5_si SET siposting = 1, sipostingtgl = NOW() WHERE siid = '" & idtransaksi & "'")
        End If
        'END OF BUAT SQL =====================================================

        rsProgress = 1

selesai:
