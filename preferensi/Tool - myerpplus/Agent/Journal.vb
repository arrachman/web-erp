            'TAMBAHKAN SQL UNTUK UPDATE TGLPOSTING SR
            rsSql = String.Concat(rsSql, sptRow, "UPDATE m5_sr SET srposting = 1, srpostingtgl = NOW() WHERE srid = '" & idtransaksi & "'")
