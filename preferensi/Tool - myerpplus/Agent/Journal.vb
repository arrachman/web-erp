        'END OF JURNAL GRUP 1 ------------------------------------


        'TAMBAHKAN SQL HAPUS JURNAL LAMA
        rsSql = "DELETE FROM M2_Transaction_Journal WHERE tsumber = 'SR' AND tgrup = '" & FixDouble(jGrup) & "' AND tidtransaksi = '" & FixDouble(idtransaksi) & "'"

