                For Each drdetail As DataRow In dtdetail.Rows
                    If dtbilling.Rows.Count > 0 Then
                        For Each drbilling As DataRow In dtbilling.Rows
                            If drbilling("idsiswa") = drdetail("idsiswa") Then
                                debitkredit = 0
                                nominal = Double.Parse(drbilling("harga"))
