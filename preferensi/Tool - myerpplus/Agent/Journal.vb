                filter = "debitkredit = " & debitkredit & " AND norek = '" & drutama("sirekpajak2").ToString & "' AND costcenter = '' AND divisi = '' AND subdivisi = '' AND proyek = ''"
                If AsDataTableDCount(dtjurnal, filter) > 0 Then
