                'GROUPING PPN KELUARAN1 (sirekpajak1)
                'filter = "debitkredit = " & debitkredit & " AND norek = '" & drutama("sirekpajak1").ToString & "'"
                filter = "debitkredit = " & debitkredit & " AND norek = '" & drutama("sirekpajak1").ToString & "' AND costcenter = '' AND divisi = '' AND subdivisi = '' AND proyek = ''"
                If AsDataTableDCount(dtjurnal, filter) > 0 Then
