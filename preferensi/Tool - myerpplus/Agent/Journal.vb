#Region "M2_Jm"
    Public Function M2_Jm(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'AKUN DEBIT (D)
        '         AKUN KREDIT (K)

        Dim wsResult As String = ""
        Dim rsProgress As Integer = 0, rsErrMessage As String = "", rsSql As String = "", sql As String = "", sumber As String = "", noTransaksi As String = ""

