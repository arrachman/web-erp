        dtdetail = AsDataTableAmbilDariDB("SELECT lud.* FROM m_11_lu_detail lud JOIN m_11_lu lu ON lud.idlu = lu.luid WHERE (lu.lustatus = 2 OR lu.lustatus = 3 OR lu.lustatus = 4 OR lu.lustatus = 7) AND lu.luid = '" & idtransaksi & "'", strCon)

