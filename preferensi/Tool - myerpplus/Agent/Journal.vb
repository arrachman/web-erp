        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT smp.* FROM m14_smp smp WHERE (smp.smpstatus = 2 OR smp.smpstatus = 3 OR smp.smpstatus = 4 OR smp.smpstatus = 7) AND smp.smpid = '" & idtransaksi & "'", strCon)
