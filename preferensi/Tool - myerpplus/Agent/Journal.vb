            End If
            'END OF UM PENJUALAN ~~~~~~~~~~~~~~~~~~~~~~~~~~
            'END OF AKUN DEBIT -----------------------------------


            'AKUN KREDIT -----------------------------------------
            'PPN KELUARAN1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            debitkredit = 1
            'NOMINAL = sitotalpajak1detail * kurs
            nominal = Double.Parse(drutama("sitotalpajak1detail")) * Double.Parse(drutama("sikurs"))
            If nominal <> 0 Then
                'NOMINAL VALAS JIKA MENGGUNAKAN MATAUANG VALAS
                If drutama("simatauang").ToString <> matauang Then
                    'NOMINAL VALAS = sitotalpajak1detail
                    nominalvalas = Double.Parse(drutama("sitotalpajak1detail"))
                Else
