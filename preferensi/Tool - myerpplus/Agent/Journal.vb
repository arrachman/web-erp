        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT ang.*, d.pcustomtext1 AS akunpinjaman, d.pakunjasapinjaman AS akunjasapinjaman FROM m14_ang ang JOIN m14_loan d ON ang.angpinjaman = d.pkode WHERE (ang.angstatus = 2 OR ang.angstatus = 3 OR ang.angstatus = 4 OR ang.angstatus = 7) AND ang.angid = '" & idtransaksi & "'", strCon)
