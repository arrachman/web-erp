        dtdetail = AsDataTableAmbilDariDB("SELECT smpd.*, d.sakun AS akunsimpanan FROM m14_smp_detail smpd JOIN m14_smp smp ON smp.smpid = smpd.idsmp JOIN m14_deposit d ON smpd.kodesimpanan = d.skode WHERE (smp.smpstatus = 2 OR smp.smpstatus = 3 OR smp.smpstatus = 4 OR smp.smpstatus = 7) AND smp.smpid = '" & idtransaksi & "'", strCon)
