        AsDataTableTambahField(dtjurnal, "urutan", AsEnumTypeData.AsInt64)

        'AMBIL DATA ==========================================================
        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT lu.*, (CASE lucustomer WHEN 2 THEN k.knama ELSE p.pnama END) AS lupasiennama, c.kid as idkontak FROM m_11_lu lu LEFT JOIN m1_patient p ON (lu.lucustomer = p.pid) LEFT JOIN m1_contact c ON (CASE lucustomer WHEN 2 THEN lu.lucustomer = c.kid ELSE p.pkode = c.kkode AND c.kkategori = 'P' END) LEFT JOIN m1_contact k ON (p.pid = k.kid) WHERE (lu.lustatus = 2 OR lu.lustatus = 3 OR lu.lustatus = 4 OR lu.lustatus = 7) AND lu.luid = '" & idtransaksi & "'", strCon)
