        'dtdetail = AsDataTableAmbilDariDB("SELECT kmd.* FROM m_11_km_detail kmd JOIN m_11_km km ON kmd.idkm = km.kmid WHERE (km.kmstatus = 2 OR km.kmstatus = 3 OR km.kmstatus = 4 OR km.kmstatus = 7) AND km.kmid = '" & idtransaksi & "'", strCon)

