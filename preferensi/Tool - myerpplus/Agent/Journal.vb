        dtjurnal.Columns("nominalfix").Expression = "iif(nominal < 0, nominal * -1, nominal)"
        dtjurnal.Columns("nominalvalasfix").Expression = "iif(nominalvalas < 0, nominalvalas * -1, nominalvalas)"

        'DELETE JURNAL JIKA NOMIAL = 0
        AsDataTableDeleteData(dtjurnal, "nominal = 0")

