                'strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("lucabang")) & "', '" & FixQuotes(drutama("lulokasi")) & "', '" & FixQuotes(drutama("lusumber")) & "', " & 0 & ", " & drutama("luid") & ", '" & FixQuotes(drutama("lunotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("lutgl"))) & "', " & drutama("lukodepa") & ", " & drutama("lucustomer") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("luuraian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("lumatauang")) & "', '" & FixDouble(drutama("lukurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal("nominal")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalas")) & "', " & 0 & ", " & 0 & ", '" & FixQuotes(AsFormatTanggal(drutama("lutgljatuhtempo"))) & "', '" & FixQuotes(AsFormatTanggal(drutama("lutgllunas"))) & "', " & FixDouble(drutama("lustatuslunas")) & ", '1900-01-01', " & 0 & ", " & urutan & ", '', " & FixDouble(drutama("lusaldoawal")) & ", 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '0', 0, " & drutama("lustatus") & ", 1, NOW(), " & drutama("lujmlrevisi") & ", " & drutama("lucetakanke") & ", " & drutama("luinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("luinputtgl"), formatTglWaktuDB)) & "', " & drutama("lumodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("lumodifikasitgl"), formatTglWaktuDB)) & "')")
                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("kwcabang")) & "', '" & FixQuotes(drutama("kwlokasi")) & "', '" & FixQuotes(drutama("kwsumber")) & "', " & 0 & ", " & drutama("kwid") & ", '" & FixQuotes(drutama("kwnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("kwtgl"))) & "', " & drutama("kwkodepa") & ", " & drutama("idkontak") & ", '" & FixQuotes(drjurnal("norek")) & "', CONCAT('" & FixQuotes(drutama("kwuraian")) & "', ' ', '" & FixQuotes(drutama("kwpasiennama")) & "'), '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("kwmatauang")) & "', '" & FixDouble(drutama("kwkurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal("nominalfix")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalasfix")) & "', " & 0 & ", " & 0 & ", '1900-01-01', '1900-01-01', " & 0 & ", '1900-01-01', " & 0 & ", " & urutan & ", '', " & 0 & ", 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '0', 0, " & drutama("kwstatus") & ", 1, NOW(), " & drutama("kwjmlrevisi") & ", " & drutama("kwcetakanke") & ", " & drutama("kwinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("kwinputtgl"), formatTglWaktuDB)) & "', " & drutama("kwmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("kwmodifikasitgl"), formatTglWaktuDB)) & "')")
            End If
