        Return wsResult
    End Function
    Public Function M5_Siold20180116(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'GROUP 1 : =====================
        'AKUN BAYAR    (D)
        'PIUTANG USAHA (D)
        'DISKON        (D)
        '           PPN KELUARAN1     (K)
        '           PPN KELUARAN2     (K)
        '           PEND. PENJUALAN   (K)
        '           PEND. LAIN        (K)
