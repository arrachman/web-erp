        dtbilling = AsDataTableAmbilDariDB("SELECT a.* FROM m14_smp_detail_bayar a JOIN m14_smp smp ON (a.idsmp = smp.smpid) WHERE (smp.smpstatus = 2 OR smp.smpstatus = 3 OR smp.smpstatus = 4 OR smp.smpstatus = 7) AND smp.smpid = '" & idtransaksi & "'", strCon)

        'JIKA TERDAPAT DATA MAKA BUAT JURNAL
        ' If dtutama.Rows.Count > 0 And dtdetail.Rows.Count > 0 Then
