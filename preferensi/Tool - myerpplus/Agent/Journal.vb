        dtdetail = AsDataTableAmbilDariDB("SELECT sid.* FROM m5_si_detail sid JOIN m5_si si ON sid.idsi = si.siid WHERE (si.sistatus = 2 OR si.sistatus = 3 OR si.sistatus = 4 OR si.sistatus = 7) AND si.sicarabayar <> 2 AND si.siid = '" & idtransaksi & "'", strCon)
