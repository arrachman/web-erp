        dtutama = AsDataTableAmbilDariDB("SELECT jm.* FROM m2_jm jm WHERE (jm.jmstatus = 2 OR jm.jmstatus = 3 OR jm.jmstatus = 4 OR jm.jmstatus = 7) AND jm.jmid = '" & idtransaksi & "'", strCon)
