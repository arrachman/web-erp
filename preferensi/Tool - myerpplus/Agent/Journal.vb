#Region "M4_Ri"
    Public Function M4_Ri20230206(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'HUTANG SEMENTARA (-D) ATAU PERSEDIAAN (D)
        'PPN MASUKAN1     (+D)
        'PPN MASUKAN2     (+D)
        'BIAYA LAIN       (+D)
        '           DISKON       (+K)
        '           HUTANG USAHA (+K) ATAU HUTANG KONSINYASI (+K)
