                        rsErrMessage = "Failed insert datatable journal kredit " & sumber & " (" & noTransaksi & ") : " & urutan & "." : GoTo selesai
                    End If

                    'JIKA KREDIT <> 0 MAKA JURNAL SISI KREDIT
                Else
                    debitkredit = 1
                    If AsDataTableTambahData(dtjurnal, "norek~namaakun~nominal~nominalvalas~debitkredit~catatan~costcenter~divisi~subdivisi~proyek~urutan~kontak", _
