                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("grncabang")) & "', '" & FixQuotes(drutama("grnlokasi")) & "', '" & FixQuotes(drutama("grnsumber")) & "', " & 0 & ", " & drutama("grnid") & ", '" & FixQuotes(drutama("grnnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("grntgl"))) & "', " & drutama("grnkodepa") & ", " & drutama("grnsupplier") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("grnuraian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("grnmatauang")) & "', '" & FixDouble(drutama("grnkurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal("nominalfix")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalasfix")) & "', " & 0 & ", " & 0 & ", '" & FixQuotes(AsFormatTanggal(drutama("grntgljatuhtempo"))) & "', '1900-01-01', 0, '1900-01-01', " & 0 & ", " & urutan & ", '', 0, 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '0', 0, " & drutama("grnstatus") & ", 1, NOW(), " & drutama("grnjmlrevisi") & ", " & drutama("grncetakanke") & ", " & drutama("grninputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("grninputtgl"), formatTglWaktuDB)) & "', " & drutama("grnmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("grnmodifikasitgl"), formatTglWaktuDB)) & "')")
