            rsSql = String.Concat(rsSql, sptRow, "UPDATE m2_sgc SET sgcposting = 1, sgcpostingtgl = NOW() WHERE sgcid = '" & idtransaksi & "'")
        End If
        'END OF BUAT SQL =====================================================

        rsProgress = 1

selesai:
        wsResult = String.Concat(rsProgress, sptSubParam, rsErrMessage, sptSubParam, rsSql)
        Return wsResult
