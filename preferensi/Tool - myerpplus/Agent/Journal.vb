#Region "M11_Lu"
    Public Function M11_Lu(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'GROUP 1 : =====================
        'PIUTANG SEMENTARA (D)
        '           PEND. PENJUALAN   (K)

        Dim wsResult As String = ""
        Dim rsProgress As Integer = 0, rsErrMessage As String = "", rsSql As String = "", sql As String = "", sumber As String = "", noTransaksi As String = "", filter As String = ""
