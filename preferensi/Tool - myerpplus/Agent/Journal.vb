                rsErrMessage = "Setting Account Receivable CoA not found. ID :" & drutama("srcustomer") : GoTo selesai
            End If
            'END OF AMBIL DATA DARI SETTING ----------------------

            'AKUN DEBIT ------------------------------------------
            'PPN KELUARAN1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            debitkredit = 0
            'NOMINAL = srtotalpajak1detail * kurs
            nominal = Double.Parse(drutama("srtotalpajak1detail")) * Double.Parse(drutama("srkurs"))
            If nominal <> 0 Then
                'NOMINAL VALAS JIKA MENGGUNAKAN MATAUANG VALAS
                If drutama("srmatauang").ToString <> matauang Then
                    'NOMINAL VALAS = srtotalpajak1detail
                    nominalvalas = Double.Parse(drutama("srtotalpajak1detail"))
                Else
                    nominalvalas = 0
                End If

                'GROUPING PPN KELUARAN1 (srrekpajak1)
                'filter = "debitkredit = " & debitkredit & " AND norek = '" & drutama("srrekpajak1").ToString & "'"
