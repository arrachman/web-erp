    Public Function M5_SrBalance(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'GROUP 1 : =====================
        'PPN KELUARAN1    (D)
        'PPN KELUARAN2    (D)
        'PEND. LAIN       (D)
        '       DISKON         (K)
