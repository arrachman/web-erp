                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("cdcabang")) & "', '" & FixQuotes(drutama("cdlokasi")) & "', '" & FixQuotes(drutama("cdsumber")) & "', " & 0 & ", " & drutama("cdid") & ", '" & FixQuotes(drutama("cdnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("cdtgl"))) & "', " & drutama("cdkodepa") & ", " & drutama("cdkontak") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("cdmatauang")) & "', '" & FixDouble(drutama("cdkurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal("nominalfix")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalasfix")) & "', " & 0 & ", " & 0 & ", '1900-01-01', '" & FixQuotes(AsFormatTanggal(drutama("cdtgllunas"))) & "', " & drutama("cdstatusbayar") & ", '1900-01-01', " & 0 & ", " & drjurnal("urutan") & ", '', 0, 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '" & FixDouble(drutama("cdjumlahbayar")) & "', " & drutama("cdstatusbayar") & ", " & drutama("cdstatus") & ", 1, NOW(), " & drutama("cdjmlrevisi") & ", " & drutama("cdcetakanke") & ", " & drutama("cdinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("cdinputtgl"), formatTglWaktuDB)) & "', " & drutama("cdmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("cdmodifikasitgl"), formatTglWaktuDB)) & "')")
