        AsDataTableTambahField(dtjurnal, "divisi", AsEnumTypeData.AsString)
        AsDataTableTambahField(dtjurnal, "subdivisi", AsEnumTypeData.AsString)
        AsDataTableTambahField(dtjurnal, "proyek", AsEnumTypeData.AsString)
        AsDataTableTambahField(dtjurnal, "urutan", AsEnumTypeData.AsInt64)

        'AMBIL DATA ==========================================================
        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT km.*, (CASE kmcustomer WHEN 2 THEN k.knama ELSE p.pnama END) AS kmpasiennama FROM m_11_km km LEFT JOIN m1_patient p ON (km.kmcustomer = p.pid) LEFT JOIN m1_contact k ON (km.kmcustomer = k.kid) WHERE (km.kmstatus = 2 OR km.kmstatus = 3 OR km.kmstatus = 4 OR km.kmstatus = 7) AND km.kmid = '" & idtransaksi & "'", strCon)
