                    rsErrMessage = "Failed insert datatable journal kredit " & sumber & " (" & noTransaksi & ") : " & urutan & "." : GoTo selesai
                End If
            Next
            'END OF AKUN KREDIT ----------------------------------

        Else
            'JIKA TIDAK ADA DATA MAKA UPDATE STATUS MSMQ MENJADI 4(TRANSAKSI TDK APPROVED)
