            drutama = dtutama.Rows(0)

            'SET SUMBER DAN NOTRANSAKSI
            sumber = drutama("lusumber")
            noTransaksi = drutama("lunotransaksi")
            'END OF SET DATA UTAMA -------------------------------

            'AMBIL DATA DARI SETTING -----------------------------
            Dim dtMatauang As DataTable = AsDataTableAmbilDariDB("SELECT smodule, sgrup, skode, snilai FROM m0_setting WHERE (smodule = 0 AND sgrup = 'accounting' AND skode = 'MataUangFungsional') OR (smodule = 0 AND sgrup = 'accounting' AND skode = 'Kurs') OR (smodule = 11 AND sgrup = 'akun' AND skode = 'PiutangSementara') OR (smodule = 11 AND sgrup = 'akun' AND skode = 'PiutangBilling') OR (smodule = 11 AND sgrup = 'akun' AND skode = 'PiutangApotek') OR (smodule = 11 AND sgrup = 'akun' AND skode = 'PiutangLaboratorium')", strCon)
            'MATAUANG
            Dim matauang As String = AsDataTableDLookup(dtMatauang, "snilai", "smodule = 0 AND sgrup = 'accounting' AND skode = 'MataUangFungsional'", "Not found")
            If matauang = "Not found" Then
                rsErrMessage = "Setting Functional Currency not found." : GoTo selesai
