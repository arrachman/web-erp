        'UTAMA
        'dtutama = AsDataTableAmbilDariDB("SELECT sr.* FROM m5_sr sr WHERE (sr.srstatus = 2 OR sr.srstatus = 3 OR sr.srstatus = 4 OR sr.srstatus = 7) AND sr.srid = '" & idtransaksi & "'", strCon)
