        AsDataTableUpdateData(dtjurnal, "debitkredit = 1 AND nominal < 0", "debitkreditfix", "0")

        AsDataTableUpdateData(dtjurnal, "debitkreditfix = 0", "debitkredit", "0")
        AsDataTableUpdateData(dtjurnal, "debitkreditfix = 1", "debitkredit", "1")

        dtjurnal.Columns("nominalfix").Expression = "iif(nominal < 0, nominal * -1, nominal)"
        dtjurnal.Columns("nominalvalasfix").Expression = "iif(nominalvalas < 0, nominalvalas * -1, nominalvalas)"

        'URUTKAN JURNAL
        dtjurnal = AsDataTableFilterSortDt(dtjurnal, "", "debitkredit ASC, norek ASC")

        'DELETE JURNAL JIKA NOMIAL = 0
        AsDataTableDeleteData(dtjurnal, "nominal = 0")

        For Each drjurnal As DataRow In dtjurnal.Rows
            urutan = urutan + 1
            'BUAT VALUE SQL INSERT KE M2_TRANSACTION_JOURNAL
            strValue.Append(IIf(Len(strValue.ToString) = 0, "", ", "))
            'JIKA debitkredit = 0 maka DEBIT, ELSE KREDIT
            If drjurnal("debitkredit") = 0 Then
                'mapping            tid,                             tcabang,                                  tlokasi,                                  tsumber,    tkodetabelangka,       tidtransaksi,                              tnotransaksi,                                                  ttgl,                        tkodepa,                     tkontak,                                tnorek,                                 turaian,                                  tcatatan,                                  tmatauang,                                   tkurs,      tnobon,                          tdebit,              tkredit,                          tdebitvalas,         tkreditvalas, tcarabayar, thutangpiutang,                                    ttgljatuhtempo,                                                  ttgllunas,                                  tstatuslunas, ttglrekonsiliasi, tsudahrekonsiliasi, turutan, tnohutangpiutang,          tsaldoawal, tadjustment,                         tcostcenter,                                 tdivisi,                                 tsubdivisi,                                tproyek,     tgrup, tretail, tjenisaruskas, tjmlrealisasium, tstatusrealisasi, tstatus, tposting, tpostingtgl, tjmlrevisi, tcetakanke,                     tinputuser,                                           tinputtgl,                                              tmodifikasiuser,                                                tmodifikasitgl
                'strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("lucabang")) & "', '" & FixQuotes(drutama("lulokasi")) & "', '" & FixQuotes(drutama("lusumber")) & "', " & 0 & ", " & drutama("luid") & ", '" & FixQuotes(drutama("lunotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("lutgl"))) & "', " & drutama("lukodepa") & ", " & drutama("lucustomer") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("luuraian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("lumatauang")) & "', '" & FixDouble(drutama("lukurs")) & "', '', '" & FixDouble(drjurnal("nominal")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalas")) & "', '" & 0 & "', " & 0 & ", " & 0 & ", '" & FixQuotes(AsFormatTanggal(drutama("lutgljatuhtempo"))) & "', '" & FixQuotes(AsFormatTanggal(drutama("lutgllunas"))) & "', " & FixDouble(drutama("lustatuslunas")) & ", '1900-01-01', " & 0 & ", " & urutan & ", '', " & FixDouble(drutama("lusaldoawal")) & ", 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '0', 0, " & drutama("lustatus") & ", 1, NOW(), " & drutama("lujmlrevisi") & ", " & drutama("lucetakanke") & ", " & drutama("luinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("luinputtgl"), formatTglWaktuDB)) & "', " & drutama("lumodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("lumodifikasitgl"), formatTglWaktuDB)) & "')")
                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("kwcabang")) & "', '" & FixQuotes(drutama("kwlokasi")) & "', '" & FixQuotes(drutama("kwsumber")) & "', " & 0 & ", " & drutama("kwid") & ", '" & FixQuotes(drutama("kwnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("kwtgl"))) & "', " & drutama("kwkodepa") & ", " & drutama("idkontak") & ", '" & FixQuotes(drjurnal("norek")) & "', CONCAT('" & FixQuotes(drutama("kwuraian")) & "', ' ', '" & FixQuotes(drutama("kwpasiennama")) & "'), '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("kwmatauang")) & "', '" & FixDouble(drutama("kwkurs")) & "', '', '" & FixDouble(drjurnal("nominalfix")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalasfix")) & "', '" & 0 & "', " & 0 & ", " & 0 & ", '1900-01-01', '1900-01-01', " & 0 & ", '1900-01-01', " & 0 & ", " & urutan & ", '', " & 0 & ", 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '0', 0, " & drutama("kwstatus") & ", 1, NOW(), " & drutama("kwjmlrevisi") & ", " & drutama("kwcetakanke") & ", " & drutama("kwinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("kwinputtgl"), formatTglWaktuDB)) & "', " & drutama("kwmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("kwmodifikasitgl"), formatTglWaktuDB)) & "')")
            Else
