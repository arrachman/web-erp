    Public Function M5_Rp(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'AKUN ONGKOS KIRIM (D)
        '           AKUN BAYAR (K)

        Dim wsResult As String = ""
        Dim rsProgress As Integer = 0, rsErrMessage As String = "", rsSql As String = "", sql As String = "", sumber As String = "", noTransaksi As String = ""

        Dim dtutama As DataTable, dtdetail As DataTable
        Dim drutama As DataRow
        Dim debitkredit As Integer = 0, urutan As Integer = 0

        'BUAT DT JURNAL
        Dim dtjurnal As New DataTable
        AsDataTableTambahField(dtjurnal, "norek", AsEnumTypeData.AsString)
        AsDataTableTambahField(dtjurnal, "namaakun", AsEnumTypeData.AsString)
