          <value>jml4,System.Double</value>
          <value>jmlkomisi4,System.Double</value>
          <value>komisi5,System.Double</value>
          <value>jml5,System.Double</value>
          <value>jmlkomisi5,System.Double</value>
          <value>komisi6,System.Double</value>
          <value>jml6,System.Double</value>
          <value>jmlkomisi6,System.Double</value>
          <value>komisi7,System.Double</value>
          <value>retur,System.Double</value>
          <value>jmlkomisi7,System.Double</value>
          <value>saldo,System.Double</value>
          <value>saldo1,System.Double</value>
          <value>saldo2,System.Double</value>
          <value>idmsmq,System.String</value>
          <value>userid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	kl.idlogin,
	kl.idsalesman,
	kl.kodesalesman,
	kl.namasalesman,
	kl.idtransaksi,
	kl.tgltransaksi,
	kl.notransaksi,
	kl.idcustomer,
	kl.kodecustomer,
	kl.namacustomer,
	kl.tgljatuhtempo,
	kl.totaltransaksi,
	kl.sisa,
	kl.komisi1,
	kl.jml1,
	(kl.komisi1 / 100) * kl.jml1 as jmlkomisi1,
	kl.komisi2,
	kl.jml2,
	(kl.komisi2 / 100) * kl.jml2 as jmlkomisi2,
	kl.komisi3,
	kl.jml3,
	(kl.komisi3 / 100) * kl.jml3 as jmlkomisi3,
	kl.komisi4,
	kl.jml4,
	(kl.komisi4 / 100) * kl.jml4 as jmlkomisi4,
	kl.komisi5,
	kl.jml5,
	(kl.komisi5 / 100) * kl.jml5 as jmlkomisi5,
	kl.komisi6,
	kl.jml6,
	kl.jmlkomisi6,
	kl.komisi7,
	kl.retur,
	(kl.komisi7 / 100) * kl.retur as jmlkomisi7,
	kl.saldo,
	kl.saldo1,
	kl.saldo2,
	kl.idmsmq,
	kl.userid
	FROM m2r_komisi_limo kl
ORDER BY
kl.kodesalesman,
kl.tgltransaksi,
kl.notransaksi,
kl.idtransaksi,
kl.tglpelunasan,
kl.nopelunasan,
kl.idpelunasan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"	</SqlCommand>
      </formatMinus>
      <formatQty Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
