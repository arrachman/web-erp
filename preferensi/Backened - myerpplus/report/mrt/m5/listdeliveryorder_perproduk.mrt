              <Page isRef="8" />
              <Parent isRef="41" />
              <Text>{IIF((DS1.jml) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.jml) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.jml))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal)
,"-","")), Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.jml))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal))
}{IIF((DS1.jml) &lt; 0 ,formatMinus.kanan,"")} {DS1.satuan}</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text48>
