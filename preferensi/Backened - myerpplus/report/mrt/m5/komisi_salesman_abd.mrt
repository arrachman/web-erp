              <Text>{IIF(SumIf(DataBand1,DS1.jumlah,DS1.grup == "LAIN-LAIN") &lt; 0,formatMinus.kiri,"")}{IIF(SumIf(DataBand1,DS1.jumlah,DS1.grup == "LAIN-LAIN") &lt; 0,(Replace(
