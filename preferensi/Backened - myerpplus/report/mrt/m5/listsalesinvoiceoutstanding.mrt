    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="27">
          <value>siid,System.Int64</value>
          <value>sitgl,System.DateTime</value>
          <value>sinotransaksi,System.String</value>
          <value>sicustomer,System.String</value>
          <value>sibagianpenjualan,System.String</value>
          <value>sistatus,System.String</value>
          <value>siuraian,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>catatan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>jmlrealisasi,System.Double</value>
          <value>jmlsisa,System.Double</value>
          <value>sonotransaksi,System.String</value>
          <value>instruksi,System.String</value>
          <value>sicustomerkontak,System.String</value>
          <value>idbarang,System.Int64</value>
          <value>sikurs,System.Double</value>
          <value>simatauang,System.String</value>
          <value>drnotransaksi,System.String</value>
          <value>donotransaksi,System.String</value>
          <value>harga,System.Double</value>
          <value>hargajml,System.Double</value>
          <value>hargajmlrealisasi,System.Double</value>
          <value>hargajmlsisa,System.Double</value>
          <value>bdivisi,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	
	si.siid , 
	si.sitgl , 
	si.sitgl , 
	si.sinotransaksi , 
	kc.knama AS sicustomer , 
	ks.knama AS sibagianpenjualan  , 
	st.nama AS sistatus ,
	si.siuraian ,
kc.kcustomtext4 as instruksi,
si.sicustomerkontak,
	b.bkode , 
	sid.namabarang , 
	sid.catatan , 
	sid.jml , 
	sid.satuan  , 
(sid.jmlrealisasi / sid.nilaisatuan) AS jmlrealisasi , 
(sid.jml - (sid.jmlrealisasi / sid.nilaisatuan)) AS jmlsisa , 
sid.idbarang,
si.sikurs , 
si.simatauang , 

dr.drnotransaksi , 
doo.donotransaksi , 
soo.sonotransaksi,
sid.harga , 

sid.harga * sid.jml AS hargajml, 
(sid.jmlrealisasi / sid.nilaisatuan) * sid.harga AS hargajmlrealisasi , 
(sid.jml - (sid.jmlrealisasi / sid.nilaisatuan)) * sid.harga AS hargajmlsisa ,
b.bdivisi

	FROM m5_si si
JOIN m1_contact kc ON si.sicustomer = kc.kid
JOIN m1_contact ks ON si.sibagianpenjualan = ks.kid
JOIN m0_status st on si.sistatus = st.kode

JOIN m5_si_detail sid ON si.siid = sid.idsi
JOIN m1_item b on sid.idbarang = b.bid

LEFT JOIN m5_dr_detail drd ON sid.iddrdetail = drd.iddrdetail 
LEFT JOIN m5_dr dr ON drd.iddr = dr.drid

LEFT JOIN m5_do_detail dod ON drd.iddodetail = dod.iddodetail
LEFT JOIN m5_do doo ON dod.iddo = doo.doid 

LEFT JOIN m5_so_detail sod ON sid.idsodetail = sod.idsodetail
LEFT JOIN m5_so soo ON sod.idso = soo.soid 

ORDER BY si.sicustomerkontak, si.sitgl , si.siid, si.sinotransaksi , sid.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="18">
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>siid,System.Int64</value>
          <value>sigudang,System.String</value>
          <value>gudang,System.String</value>
          <value>sinotransaksi,System.String</value>
          <value>sitgl,System.DateTime</value>
          <value>siuraian,System.String</value>
          <value>sastatus,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>satuan,System.String</value>
          <value>jml,System.Double</value>
          <value>hpp,System.Double</value>
          <value>idbarang,System.Int64</value>
          <value>nbtidbarang,System.Int64</value>
          <value>nbtjml,System.Double</value>
          <value>nbtkode,System.String</value>
          <value>nbtsatuan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	COUNT(*), 
	si.siid , 
	si.sigudang , w.wnama AS gudang, 
	si.sinotransaksi , si.sitgl , si.siuraian , 
	st.nama AS sastatus, 
	b.bkode , sid.namabarang , 
	sid.satuan , 
	sid.jml, 
	sid.hpp, 
	sid.idbarang , 
	nbt.nbtidbarang ,
	nbt.nbtjml, 
	nbt.nbtkode , 
	nbt.nbtsatuan 
	FROM m5_si si 
JOIN m1_warehouse w ON si.sigudang = w.wkode
JOIN m5_si_detail sid ON si.siid = sid.idsi 
JOIN m1_item b ON sid.idbarang = b.bid
JOIN m0_status st ON si.sistatus = st.kode

JOIN m1_no_batch_transaction nbt
ON si.sisumber = nbt.nbtsumber AND si.siid = nbt.nbtidtransaksi AND sid.idbarang = nbt.nbtidbarang
WHERE si.sinotransaksi = 'SI22040355'
GROUP BY si.sisumber , nbt.nbtsumber , si.siid, nbt.nbtidtransaksi , sid.idbarang , nbt.nbtidbarang,  nbt.nbtid

ORDER BY si.sigudang , si.sitgl , si.siid, si.sinotransaksi , sid.idbarang,  sid.urutan , nbt.nbtid</SqlCommand>
      </DS2>
