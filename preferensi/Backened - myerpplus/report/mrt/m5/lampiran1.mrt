              <CanShrink>True</CanShrink>
              <ClientRectangle>0.01,2.53,0.77,0.21</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,10,Italic</Font>
              <GrowToHeight>True</GrowToHeight>
