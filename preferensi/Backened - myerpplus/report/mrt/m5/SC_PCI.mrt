    <DataSources isList="true" count="5">
      <formatTgl Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS1 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="42">
          <value>soid,System.Int64</value>
          <value>sonotransaksi,System.String</value>
          <value>sotgl,System.DateTime</value>
          <value>vessel,System.String</value>
          <value>originport,System.String</value>
          <value>destinationport,System.String</value>
          <value>bundleno,System.String</value>
          <value>marking,System.String</value>
          <value>freight,System.Double</value>
          <value>insurance,System.Double</value>
          <value>souraian,System.String</value>
          <value>socustomer,System.String</value>
          <value>so1alamat1,System.String</value>
          <value>so2alamat1,System.String</value>
          <value>uraian,System.String</value>
          <value>etd,System.DateTime</value>
          <value>telp,System.String</value>
          <value>fax,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>jml,System.Double</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>jmlbundle,System.Double</value>
          <value>satuanbundle,System.String</value>
          <value>grossweight,System.Double</value>
          <value>measurement,System.String</value>
          <value>matauang,System.String</value>
          <value>somatauang,System.String</value>
          <value>sototalpajak1detail,System.Double</value>
          <value>sobiayalain,System.Double</value>
          <value>sojmldiskon,System.Decimal</value>
          <value>sototaltransaksi,System.Double</value>
          <value>catatan,System.String</value>
          <value>sfnotransaksi,System.String</value>
          <value>csimbol,System.String</value>
          <value>terbilang,System.String</value>
          <value>shipmentby,System.String</value>
          <value>sonoref,System.String</value>
          <value>socustomerkontak,System.String</value>
          <value>catatandetail,System.String</value>
          <value>catatanmaster,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	so.soid,
	so.sonotransaksi , 
	so.sotgl , 
	so.socustomtext1 as vessel,
	so.socustomtext2 as originport,
	so.socustomtext3 as destinationport,
	so.socustomtext4 as bundleno,
	so.socustomtext5 as marking,
	so.socustomdbl2 as freight,
	so.socustomdbl3 as insurance,
	so.souraian, 
	k.knama AS socustomer , 
	so.so1alamat1 , 
	so.so2alamat1 , 
	so.souraian as uraian,	
	so.socustomdate1 as etd,
	k.k1notelp1 as telp,
	k.k1nofax as fax, 
	b.bkode ,
	sod.namabarang , 
	sod.jml , 
	sod.harga , 
	sod.jml * sod.harga AS total, 
	sod.customdbl4 as jmlbundle,
	sod.customtext4 as satuanbundle,
	sod.customdbl5 as grossweight,
	sod.customtext5 as measurement,
	
	sod.matauang , 

	so.somatauang , 
	so.sototalpajak1detail , 
	so.sobiayalain ,
	so.sojmldiskon , 
	so.sototaltransaksi , 
	so.socatatan as catatan , 
	sf.sfnotransaksi, cr.csimbol,
	f_nominal_english(sototaltransaksi, somatauang) AS terbilang,
	case so.socustomint1
		when 0 then "SEA"
		when 1 then "AIR"
	END as shipmentby,
	so.sonoref,
	so.socustomerkontak,
	sod.catatan as catatandetail,
	k.kcatatan as catatanmaster
	
	FROM m5_so so 
JOIN m5_so_detail sod ON so.soid = sod.idso 
JOIN m1_contact k ON so.socustomer = k.kid 
JOIN m1_item b ON sod.idbarang = b.bid 
LEFT JOIN m5_sf sf on so.socustomdbl1 = sf.sfid
left join m1_currency cr on so.somatauang = cr.ckode
WHERE sonotransaksi = "SO20060500"


ORDER BY so.sotgl ASC , so.soid ASC , sod.urutan ASC </SqlCommand>
      </DS1>
