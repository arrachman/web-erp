      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <formatTgl Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS1 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="39">
          <value>siid,System.Int64</value>
          <value>sinotransaksi,System.String</value>
          <value>sitgl,System.DateTime</value>
          <value>vessel,System.String</value>
          <value>originport,System.String</value>
          <value>destinationport,System.String</value>
          <value>bundleno,System.String</value>
          <value>marking,System.String</value>
          <value>freight,System.Double</value>
          <value>insurance,System.Double</value>
          <value>siuraian,System.String</value>
          <value>sicustomer,System.String</value>
          <value>si1alamat1,System.String</value>
          <value>si2alamat1,System.String</value>
          <value>sicatatan,System.String</value>
          <value>etd,System.DateTime</value>
          <value>telp,System.String</value>
          <value>fax,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>jmlbundle,System.Double</value>
          <value>satuanbundle,System.String</value>
          <value>grossweight,System.Double</value>
          <value>measurement,System.String</value>
          <value>matauang,System.String</value>
          <value>simatauang,System.String</value>
          <value>sitotalpajak1detail,System.Double</value>
          <value>sibiayalain,System.Double</value>
          <value>sitotaltransaksi,System.Double</value>
          <value>catatan,System.String</value>
          <value>sfnotransaksi,System.String</value>
          <value>unit,System.String</value>
          <value>si1alamat3,System.String</value>
          <value>sicustomtext7,System.String</value>
          <value>customtext2,System.String</value>
          <value>catatandetail,System.String</value>
          <value>sicustomtext6,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	si.siid,
	si.sinotransaksi , 
	si.sitgl , 
	si.sicustomtext1 as vessel,
	si.sicustomtext2 as originport,
	si.sicustomtext3 as destinationport,
	si.sicustomtext4 as bundleno,
	si.sicustomtext5 as marking,
	si.sicustomdbl2 as freight,
	si.sicustomdbl3 as insurance,
	si.siuraian, 
	k.knama AS sicustomer , 
	si.si1alamat1 , 
	si.si2alamat1 , 
	si.sicatatan , 
	si.sicustomdate1 as etd,
	k.k1notelp1 as telp,
	k.k1nofax as fax,

	b.bnama , 
	sid.jml , 
	sid.harga , 
	sid.jml * sid.harga AS total, 
	sid.customdbl4 as jmlbundle,
	sid.customtext4 as satuanbundle,
	sid.customdbl5 as grossweight,
	sid.customtext5 as measurement,
	
	sid.matauang , 

	si.simatauang , 
	si.sitotalpajak1detail , 
	si.sibiayalain , 
	si.sitotaltransaksi , 
	si.sicatatan as catatan , 
	sf.sfnotransaksi,
	si.siekspedisi as unit,
	si.si1alamat3,
	si.siekspedisi

	FROM m5_si si 
JOIN m5_si_detail sid ON si.siid = sid.idsi 
JOIN m1_contact k ON si.sicustomer = k.kid 
JOIN m1_item b ON sid.idbarang = b.bid 
LEFT JOIN m5_sf sf on si.sicustomdbl1 = sf.sfid
where siid = 11691 and bjenis = "P"


ORDER BY si.sitgl ASC , si.siid ASC , sid.urutan ASC </SqlCommand>
      </DS1>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="4">
          <value>siid,System.Int64</value>
          <value>sinotransaksi,System.String</value>
          <value>totalbundle,System.Double</value>
          <value>terbilang,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	si.siid,
	si.sinotransaksi,
	sum(customdbl4) as totalbundle,
	f_nominal_english(sum(customdbl4), "") AS terbilang 

	FROM m5_si si 
JOIN m5_si_detail sid ON si.siid = sid.idsi 
WHERE sinotransaksi = "SO20060500"</SqlCommand>
      </DS2>
    </DataSources>
