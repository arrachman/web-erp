              <Page isRef="8" />
              <Parent isRef="34" />
              <Text>{IIF((DS1.persen) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.persen) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.jml))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal)
,"-","")), Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.persen))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal))
