      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="35">
          <value>idlogin,System.String</value>
          <value>idmsmq,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>notransaksi,System.String</value>
          <value>salesmankode,System.String</value>
          <value>salesmannama,System.String</value>
          <value>sumber,System.String</value>
          <value>divisi,System.String</value>
          <value>customtext1,System.String</value>
          <value>customtext2,System.String</value>
          <value>customtext3,System.String</value>
          <value>customtext4,System.String</value>
          <value>customtext5,System.String</value>
          <value>lrcustomint1,System.Int32</value>
          <value>lrcustomint2,System.Int32</value>
          <value>lrcustomint3,System.Int32</value>
          <value>lrcustomint4,System.Int32</value>
          <value>lrcustomint5,System.Int32</value>
          <value>pkcustomdbl1,System.Double</value>
          <value>pkcustomdbl2,System.Double</value>
          <value>pkcustomdbl3,System.Double</value>
          <value>pkcustomdbl4,System.Double</value>
          <value>pkcustomdbl5,System.Double</value>
          <value>pkcustomdbl6,System.Double</value>
          <value>lrcustomdate1,System.DateTime</value>
          <value>pkcustomdbl7,System.Double</value>
          <value>SOBR,System.Double</value>
          <value>SOBW,System.Double</value>
          <value>SIBR,System.Double</value>
          <value>SIBW,System.Double</value>
          <value>bryear,System.Double</value>
          <value>bwyear,System.Double</value>
          <value>ytdbr,System.Double</value>
          <value>ytdbw,System.Double</value>
          <value>ytdnilai,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	idlogin,
	idmsmq,
	tgl,
	notransaksi,
	salesmankode,
	salesmannama,
	sumber,
	divisi,
	customtext1,
	customtext2,
	customtext3,
	customtext4,
	customtext5,
	lrcustomint1,
	lrcustomint2,
	lrcustomint3,
	lrcustomint4,
	lrcustomint5,
	pkcustomdbl1,
	pkcustomdbl2,
	(pkcustomdbl3 * pkcustomdbl7) AS pkcustomdbl3 ,
	(pkcustomdbl4 * pkcustomdbl7) AS pkcustomdbl4 ,
	pkcustomdbl5,
	pkcustomdbl6,
	lrcustomdate1, 
	pkcustomdbl7, 

	CASE sumber
	WHEN "SO" THEN CASE divisi 
										WHEN "BR" THEN (pkcustomdbl1 - pkcustomdbl2) * 1
									END
END AS SOBR , 

CASE sumber
	WHEN "SO" THEN CASE divisi 
										WHEN "BW" THEN (pkcustomdbl1 - pkcustomdbl2) * 1
									END
END AS SOBW , 

CASE sumber
	WHEN "SI" THEN CASE divisi 
										WHEN "BR" THEN (pkcustomdbl1 - pkcustomdbl2) * 1
									END
END AS SIBR , 

CASE sumber
	WHEN "SI" THEN CASE divisi 
										WHEN "BW" THEN (pkcustomdbl1 - pkcustomdbl2) * 1
									END
END AS SIBW ,
pkcustomdbl5 * 11 as bryear,
pkcustomdbl6 * 11 as bwyear,
ytdbr,
ytdbw,
ytdnilai

FROM m2r_daily_sales_new</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'DD','dd'),'mm','MM'),'YYYY','yyyy') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
