              <HorAlignment>Right</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text37</Name>
              <Page isRef="8" />
              <Parent isRef="36" />
              <Text>{IIF(DS1.sikurs &lt; 0,formatMinus.kiri,"")}{IIF(DS1.sikurs &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat,DS1.sikurs))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.sikurs))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(DS1.sikurs &lt; 0 ,formatMinus.kanan,"")}</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text37>
            <Text38 Ref="38" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>1.9,0,1.1,0.2</ClientRectangle>
