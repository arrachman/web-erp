    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="20">
          <value>kid,System.Int64</value>
          <value>kkode,System.String</value>
          <value>knama,System.String</value>
          <value>jarak,System.Int32</value>
          <value>invoice,System.Double</value>
          <value>sckomisi1,System.Double</value>
          <value>_x0030__30,System.Double</value>
          <value>sckomisi2,System.Double</value>
          <value>_x0033_1_60,System.Double</value>
          <value>sckomisi3,System.Double</value>
          <value>_x0036_1_90,System.Double</value>
          <value>sckomisi4,System.Double</value>
          <value>_x0039_1_120,System.Double</value>
          <value>sckomisi5,System.Double</value>
          <value>_x0031_21_180,System.Double</value>
          <value>sckomisi6,System.Double</value>
          <value>_x0031_81_x,System.Double</value>
          <value>komisi181_x,System.Double</value>
          <value>sckomisi7,System.Double</value>
          <value>retur,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	c.kid,
	c.kkode,
	c.knama,
	DATEDIFF(pv.pvtgl,IFNULL(si.sitgl, sr.srtgl)) as jarak,
	SUM(
	(
	CASE
			WHEN pvd.sumber = 'SI' THEN
				pvd.jmlbayar
			ELSE
				0
			END
		)
	) AS invoice,
	sc.sckomisi1,
	SUM(
		(
			CASE
			WHEN pvd.sumber = 'SI'
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &lt;= 30 THEN
				pvd.jmlbayar
			ELSE
				0
			END
		)
	) AS 0_30,
	sc.sckomisi2,
	SUM(
		(
			CASE
			WHEN pvd.sumber = 'SI'
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &gt; 30
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &lt;= 60 THEN
				pvd.jmlbayar
			ELSE
				0
			END
		)
	) AS 31_60,
	sc.sckomisi3,
	SUM(
		(
			CASE
			WHEN pvd.sumber = 'SI'
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &gt; 60
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &lt;= 90 THEN
				pvd.jmlbayar
			ELSE
				0
			END
		)
	) AS 61_90,
	sc.sckomisi4,
	SUM(
		(
			CASE
			WHEN pvd.sumber = 'SI'
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &gt; 90
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &lt;= 120 THEN
				pvd.jmlbayar
			ELSE
				0
			END
		)
	) AS 91_120,
	sc.sckomisi5,
	SUM(
		(
			CASE
			WHEN pvd.sumber = 'SI'
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &gt; 120
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &lt;= 180 THEN
				pvd.jmlbayar
			ELSE
				0
			END
		)
	) AS 121_180,
	sc.sckomisi6,
	SUM(
		(
			CASE
			WHEN pvd.sumber = 'SI'
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &gt; 180 THEN
				pvd.jmlbayar
			ELSE
				0
			END
		)
	) AS 181_x,
	SUM(
		(sc.sckomisi6 / 100) *
		(
			CASE
			WHEN pvd.sumber = 'SI'
			AND DATEDIFF(
				pv.pvtgl,
				IFNULL(si.sitgl, sr.srtgl)
			) &gt; 180 THEN
				pvd.jmlbayar
			ELSE
				0
			END
		) *
		(DATEDIFF(pv.pvtgl,IFNULL(si.sitgl, sr.srtgl)) - 180)
	)as komisi181_x,
	sc.sckomisi7,
	SUM(
		(
			CASE
			WHEN pvd.sumber = 'SR' THEN
				pvd.jmlbayar * -1
			ELSE
				0
			END
		)
	) AS retur
FROM
	m5_pv pv
JOIN m5_pv_detail pvd ON pv.pvid = pvd.idpv
AND pv.pvstatus IN (2, 3, 4, 7)
AND pvd.sumber IN ('SI', 'SR')
LEFT JOIN m5_si si ON pvd.sumber = si.sisumber
AND pvd.idtransaksi = si.siid
LEFT JOIN m5_sr sr ON pvd.sumber = sr.srsumber
AND pvd.idtransaksi = sr.srid
LEFT JOIN m1_contact c ON IFNULL(
	si.sibagianpenjualan,
	sr.srbagianpenjualan
) = c.kid
LEFT JOIN m1_salesman_commission sc ON c.kid = sc.scidkontak
GROUP BY
	c.kid
ORDER BY
	c.kkode,
	pv.pvtgl,
	pv.pvnotransaksi,
	pv.pvid,
	IFNULL(si.sitgl, sr.srtgl),
	IFNULL(
		si.sinotransaksi,
		sr.srnotransaksi
	),
	IFNULL(si.siid, sr.srid),
	pvd.idpvdetail</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"	</SqlCommand>
      </formatMinus>
      <formatQty Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
