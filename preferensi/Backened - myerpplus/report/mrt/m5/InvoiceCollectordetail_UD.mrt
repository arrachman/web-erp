<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="20">
          <value>icid,System.Int64</value>
          <value>icnotransaksi,System.String</value>
          <value>ictgl,System.DateTime</value>
          <value>iccustomer,System.String</value>
          <value>icuraian,System.String</value>
          <value>icmatauang,System.String</value>
          <value>ickurs,System.Double</value>
          <value>icstatus,System.String</value>
          <value>notransaksi,System.String</value>
          <value>tanggal,System.DateTime</value>
          <value>sumber,System.String</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Double</value>
          <value>totaltransaksi,System.Double</value>
          <value>terbayar,System.Double</value>
          <value>rencana,System.Double</value>
          <value>jmlbayar,System.Double</value>
          <value>jmlbayarvalas,System.Double</value>
          <value>termin,System.String</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	ic.icid, 
	ic.icnotransaksi , 
	ic.ictgl , 
	kc.knama AS iccustomer, 
	ic.icuraian , 
	ic.icmatauang , 
	ic.ickurs , 
	st.nama AS icstatus, 

	CASE sumber
	WHEN "SI" then si.sinotransaksi 
	WHEN "RP" then rp.rpnotransaksi 
	WHEN "IP" then ip.ipnotransaksi 
	WHEN "AS" then ass.asnotransaksi 
	WHEN "SR" then sr.srnotransaksi 
	WHEN "CA" then CONCAT(icd.sumber,"(",coa.cnomor, ")")
END as notransaksi ,
CASE sumber
	WHEN "SI" then si.sitgl 
	WHEN "RP" then rp.rptgl
	WHEN "IP" then ip.iptgl
	WHEN "AS" then ass.astgl
	WHEN "SR" then sr.srtgl
	END as tanggal, 
icd.sumber , 
icd.matauang , 
icd.kurs , 
icd.totaltransaksi , 
icd.terbayar , 
icd.rencana , 
icd.jmlbayar, 
icd.jmlbayarvalas, 
CASE sumber
	WHEN "SI" then si.sitermin 
	WHEN "RP" then rp.rptermin
	WHEN "IP" then ip.iptermin
	WHEN "AS" then ass.astermin
	WHEN "SR" then sr.srtermin
	END as termin , 
icd.catatan 

FROM m5_ic ic
JOIN m1_contact kc ON ic.iccustomer = kc.kid
JOIN m0_status st ON ic.icstatus = st.kode

JOIN m5_ic_detail icd ON ic.icid = icd.idic
LEFT JOIN m5_si si ON icd.sumber = si.sisumber AND icd.idtransaksi = si.siid
LEFT JOIN m5_rp rp ON icd.sumber = rp.rpsumber AND icd.idtransaksi = rp.rpid
LEFT JOIN m5_ip ip ON icd.sumber = ip.ipsumber AND icd.idtransaksi = ip.ipid
LEFT JOIN m5_as ass ON icd.sumber = ass.assumber AND icd.idtransaksi = ass.asid
LEFT JOIN m5_sr sr ON icd.sumber = sr.srsumber AND icd.idtransaksi = sr.srid
LEFT JOIN m1_coa coa ON icd.rekhutangpiutang = coa.cnomor

ORDER BY ic.ictgl , ic.icid , ic.icnotransaksi , icd.sumber = "SI" DESC , icd.sumber = "RP", icd.sumber = "IP" DESC , icd.sumber = "AS" DESC, icd.sumber = "SR" DESC , icd.sumber = "CA" DESC , icd.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
