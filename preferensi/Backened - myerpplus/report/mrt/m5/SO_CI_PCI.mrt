              <Margins>0,0,0,0</Margins>
              <Name>Text11</Name>
              <Page isRef="10" />
              <Parent isRef="19" />
              <Text>SAILING ON OR ABOUT {
Replace(
Replace(
Replace(
Replace(
Replace(
Replace(
Replace(
Replace(
Replace(
Replace(
Replace(
Replace(
Format("{0:dd MMMM yyyy}", DS1.etd),"JANUARY","JANUARY")
,"FEBRUARY","FEBRUARY")
,"MARCH","MARCH")
,"APRIL","APRIL")
,"MAY","MAY")
,"JUNE","JUNE")
,"JULY","JULY")
,"AUGUST","AUGUST")
,"SEPTEMBER","SEPTEMBER")
,"OCTOBER","OCTOBER")
,"NOVEMBER","NOVEMBER")
,"DECEMBER","DECEMBER")
} FROM {DS1.originport}</Text>
