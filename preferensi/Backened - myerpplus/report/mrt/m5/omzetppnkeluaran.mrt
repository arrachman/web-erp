,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(Sum(DS1.sitotalpajak1detail) &lt; 0 ,formatMinus.kanan,"")}</Text>
