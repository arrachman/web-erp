Replace(
Replace(
Replace(
(Format(formatNominal.fromat, SumIf(DataBand1,DS1.pajak,DS1.sitotalpajak1detail != 0) + SumIf(DataBand1,DS1.pajak,DS1.sitotalpajak1detail == 0) + Sum(DS1.sitotalpajak1detail)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
