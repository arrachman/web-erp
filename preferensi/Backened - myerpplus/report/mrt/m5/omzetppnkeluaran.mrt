              <Page isRef="8" />
              <Parent isRef="38" />
              <Text>{IIF(SumIf(DataBand1,DS1.pajak,DS1.sitotalpajak1detail != 0) + SumIf(DataBand1,DS1.pajak,DS1.sitotalpajak1detail == 0) + Sum(DS1.sitotalpajak1detail) &lt; 0,formatMinus.kiri,"")}{IIF(SumIf(DataBand1,DS1.pajak,DS1.sitotalpajak1detail != 0) + SumIf(DataBand1,DS1.pajak,DS1.sitotalpajak1detail == 0) + Sum(DS1.sitotalpajak1detail) &lt; 0,(Replace(
