              <Text>kami tidak mengganti rugi terjadi force mayors, seperti kebakaran gudang, kebakaran mobil, kecelakaan lalulintas, kecelakaan kapal laut, perampokan, perang dan bencana alam.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text1>
            <Text3 Ref="63" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>0.2,0.69,5.04,0.33</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,8</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>178694fc4c304fec98aad03295f46d68</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text3</Name>
              <Page isRef="11" />
              <Parent isRef="56" />
              <Text>Claim baru dapat diajukan apabila diselesaikan oleh pegawai kami pada waktu barang diserahkan kepada penerima</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text3>
            <Text4 Ref="64" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>0.2,0.69,5.04,0.33</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,8</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>8012c2c6805c427f839f3f55cd138062</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text4</Name>
              <Page isRef="11" />
              <Parent isRef="56" />
              <Text>Claim baru dapat diajukan apabila diselesaikan oleh pegawai kami pada waktu barang diserahkan kepada penerima</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text4>
            <Text7 Ref="65" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>0.2,1.02,5.04,0.19</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,8</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>387642b9fced4adc902dfb8d50df5224</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text7</Name>
              <Page isRef="11" />
              <Parent isRef="56" />
              <Text>Barang yang dikirim, isinya harus cocok dan sesuai seperti tertera dalam faktur</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text7>
            <Text8 Ref="66" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>0.2,1.22,5.04,0.34</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,8</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>02f695a5c37e4eec96c73ac596c7f0d1</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text8</Name>
              <Page isRef="11" />
              <Parent isRef="56" />
              <Text>Dalam waktu 30 hari barang yang dikirim tidak diambil, hilang, rusak, tidak menjadi tanggung jawab perusahaan.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text8>
            <Text9 Ref="67" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>0.2,1.56,5.04,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,8</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>7a5f4ea9534647afac979b6a1b1c20d8</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text9</Name>
              <Page isRef="11" />
              <Parent isRef="56" />
              <Text>Barang yang dikirim hilang, rusak perusahaan hanya mengganti 3x lipat ongkos kirim yang tertera.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
