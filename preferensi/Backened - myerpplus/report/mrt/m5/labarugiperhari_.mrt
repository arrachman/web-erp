Replace(
(Format(formatNominal.fromat, Sum(DS1.totaltransaksi)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(Sum(DS1.totaltransaksi) &lt; 0 ,formatMinus.kanan,"")}</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
