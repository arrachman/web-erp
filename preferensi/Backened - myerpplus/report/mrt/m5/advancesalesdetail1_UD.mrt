<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="22">
          <value>asid,System.Int64</value>
          <value>asnotransaksi,System.String</value>
          <value>astgl,System.DateTime</value>
          <value>asjenis,System.String</value>
          <value>askontak,System.String</value>
          <value>asnorek,System.String</value>
          <value>cnama,System.String</value>
          <value>sonotransaksi,System.String</value>
          <value>ipnotransaksi,System.String</value>
          <value>asuraian,System.String</value>
          <value>asmatauang,System.String</value>
          <value>askurs,System.Double</value>
          <value>asstatus,System.String</value>
          <value>carabayar,System.String</value>
          <value>noakun,System.String</value>
          <value>namaakun,System.String</value>
          <value>jumlah,System.Double</value>
          <value>jumlahvalas,System.Double</value>
          <value>bank,System.String</value>
          <value>nogiro,System.String</value>
          <value>tgljt,System.DateTime</value>
          <value>noacbank,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	ass.asid, 
	ass.asnotransaksi , 
	ass.astgl , 
	CASE ass.asjenis 
	WHEN 0 then "UM Pembelian"
	WHEN 1 then "Titipan(Deposit)"
END AS asjenis , 
kc.knama AS askontak , 
ass.asnorek , 
c.cnama , 
so.sonotransaksi , 
ip.ipnotransaksi, 
ass.asuraian ,
ass.asmatauang , 
ass.askurs , 
st.nama AS asstatus , 
pm.nama AS carabayar ,
CASE carabayar 
	WHEN 2 then asp.rekgiro
ELSE asp.rekbank
END AS noakun, 
CASE carabayar 
	WHEN 2 THEN c3.cnama
ELSE c2.cnama 
END AS namaakun, 
asp.jumlah , 
asp.jumlahvalas , 
asp.bank , 
asp.nogiro, 
asp.tgljt , 
asp.noacbank

FROM m5_as ass
JOIN m1_contact kc ON ass.askontak = kc.kid
JOIN m1_coa c ON ass.asnorek = c.cnomor
LEFT JOIN m5_so so ON ass.asidso = so.soid
LEFT JOIN m5_ip ip ON ass.asidip = ip.ipid
JOIN m0_status st ON ass.asstatus = st.kode

JOIN m5_as_pay asp ON ass.asid = asp.idas 
JOIN m0_payment_method pm ON asp.carabayar = pm.kode
LEFT JOIN m1_coa c2 ON asp.rekbank = c2.cnomor 
LEFT JOIN m1_coa c3 ON asp.rekgiro = c3.cnomor

ORDER BY ass.astgl ,  ass.asid , ass.asnotransaksi , asp.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="7">
          <value>asid,System.Int64</value>
          <value>asnotransaksi,System.String</value>
          <value>idas,System.Int64</value>
          <value>bank,System.String</value>
          <value>nogiro,System.String</value>
          <value>tgljt,System.DateTime</value>
          <value>noacbank,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	ass.asid, 
	ass.asnotransaksi ,
	asp.idas, 
	asp.bank , 
	asp.nogiro, 
	asp.tgljt , 
	asp.noacbank

	FROM m5_as ass

JOIN m5_as_pay asp ON ass.asid = asp.idas 

ORDER BY ass.astgl ,  ass.asid , ass.asnotransaksi , asp.urutan</SqlCommand>
      </DS2>
