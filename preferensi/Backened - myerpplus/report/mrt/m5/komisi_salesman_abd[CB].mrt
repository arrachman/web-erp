<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="25">
          <value>nourut,System.Int64</value>
          <value>SUM,System.Int32</value>
          <value>idlogin,System.String</value>
          <value>idmsmq,System.String</value>
          <value>userid,System.Int64</value>
          <value>salesmankode,System.String</value>
          <value>salesmannama,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>notransaksi,System.String</value>
          <value>sumber,System.String</value>
          <value>caption,System.String</value>
          <value>customerkode,System.String</value>
          <value>customernama,System.String</value>
          <value>barangkode,System.String</value>
          <value>barangnama,System.String</value>
          <value>kategorikode,System.String</value>
          <value>kategoribarang,System.String</value>
          <value>grupkode,System.String</value>
          <value>grup,System.String</value>
          <value>jumlah,System.Double</value>
          <value>a,System.String</value>
          <value>total,System.Double</value>
          <value>komisipaku,System.Double</value>
          <value>komisikawat,System.Double</value>
          <value>komisilain,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	komisi.nourut, 

	CASE komisi.nourut
	WHEN 1 THEN 1
	ELSE 2
END AS "SUM" , 

komisi.idlogin , komisi.idmsmq , komisi.userid , komisi.salesmankode , komisi.salesmannama , komisi.tgl , komisi.notransaksi , komisi.sumber , 
	CASE komisi.sumber
	WHEN "SI" THEN "Total Penjualan"
	WHEN "SR" THEN "Total Retur Penjualan"
END AS caption , 
komisi.customerkode , komisi.customernama , 
komisi.barangkode , komisi.barangnama , komisi.kategorikode , komisi.kategoribarang , komisi.grupkode , komisi.grup,  SUM(komisi.jumlah) as jumlah , 

CONCAT(komisi.sumber,"-",komisi.grup) as a , 

SUM(CASE komisi.sumber
	WHEN "SI" THEN (komisi.jumlah * 1)
	WHEN "SR" THEN (komisi.jumlah * -1)
END) AS total , 


(IFNULL(paku.snilai,0) * 1) AS komisipaku, 
(IFNULL(kawat.snilai,0)* 1) AS komisikawat, 
(IFNULL(lain.snilai,0)* 1) AS komisilain

FROM m2r_komisi_abd komisi 
LEFT JOIN m0_setting paku ON paku.sgrup = 'komisi' AND paku.skode = CONCAT('paku-',komisi.salesmankode)
LEFT JOIN m0_setting kawat ON kawat.sgrup = 'komisi' AND kawat.skode = CONCAT('kawat-',komisi.salesmankode)
LEFT JOIN m0_setting lain ON lain.sgrup = 'komisi' AND lain.skode = CONCAT('lain-',komisi.salesmankode)

GROUP BY komisi.salesmankode , komisi.sumber , komisi.grup 
ORDER BY komisi.salesmankode ASC, komisi.nourut  ASC, komisi.sumber  ASC, komisi.grup  ASC</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
