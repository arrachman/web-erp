Replace(
(Format(formatNominal.fromat, Sum(DS1.sitotaltransaksi)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(Sum(DS1.sitotaltransaksi) &lt; 0 ,formatMinus.kanan,"")}</Text>
