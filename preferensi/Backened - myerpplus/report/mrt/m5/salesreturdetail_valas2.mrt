<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="8">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="25">
          <value>srid,System.Int64</value>
          <value>srnotransaksi,System.String</value>
          <value>srtgl,System.DateTime</value>
          <value>srcustomer,System.String</value>
          <value>srbagianpenjualan,System.String</value>
          <value>srgudang,System.String</value>
          <value>srstatus,System.String</value>
          <value>sruraian,System.String</value>
          <value>srmatauang,System.String</value>
          <value>srkurs,System.Double</value>
          <value>srdiskonpersen,System.String</value>
          <value>srjmldiskon,System.Double</value>
          <value>srbiayalain,System.Double</value>
          <value>srtotalpajak1detail,System.Double</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>sinotransaksi,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>hargavalas,System.Double</value>
          <value>hpp,System.Double</value>
          <value>diskon,System.String</value>
          <value>total,System.Double</value>
          <value>totalvalas,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	sr.srid , 
	sr.srnotransaksi, 
	sr.srtgl , 
	kc.knama AS srcustomer, 
	ks.knama AS srbagianpenjualan , 
	w.wnama AS srgudang, 
	st.nama AS srstatus , 
	sr.sruraian, 
	sr.srmatauang , 
	sr.srkurs , 
	sr.srdiskonpersen , sr.srjmldiskon , 
	sr.srbiayalain , 
	sr.srtotalpajak1detail, 

	b.bkode , 
	srd.namabarang, 
	si.sinotransaksi, 
	srd.jml , 
	srd.satuan , 
	srd.harga, 
	(srd.harga * srd.kurs) AS hargavalas , 
	srd.hpp , 
	srd.diskon , 
	((srd.jml * srd.harga) - srd.jmldiskon) AS total ,
	((srd.jml * (srd.harga * srd.kurs)) - (srd.jmldiskon * srd.kurs)) AS totalvalas 

	FROM m5_sr sr 
JOIN m1_contact kc ON sr.srcustomer = kc.kid
JOIN m1_contact ks ON sr.srbagianpenjualan = ks.kid
JOIN m1_warehouse w ON sr.srgudang = w.wkode
JOIN m0_status st ON sr.srstatus = st.kode

JOIN m5_sr_detail srd ON sr.srid = srd.idsr
JOIN m1_item b ON srd.idbarang = b.bid
LEFT JOIN m5_si_detail sid ON srd.idsidetail = sid.idsidetail 
LEFT JOIN m5_si si ON sid.idsi = si.siid 

ORDER BY sr.srtgl , sr.srid , sr.srnotransaksi , srd.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
