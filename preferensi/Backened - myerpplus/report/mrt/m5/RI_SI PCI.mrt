    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_pci_utama</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="17">
          <value>tgl,System.DateTime</value>
          <value>notransaksi,System.String</value>
          <value>jml,System.Double</value>
          <value>sumber,System.String</value>
          <value>jmlri,System.Double</value>
          <value>jmlsi,System.Double</value>
          <value>satuan,System.String</value>
          <value>idsupplier,System.Int64</value>
          <value>kodesupplier,System.String</value>
          <value>namasupplier,System.String</value>
          <value>idcustomer,System.Int64</value>
          <value>kodecustomer,System.String</value>
          <value>namacustomer,System.String</value>
          <value>idsalesman,System.Int64</value>
          <value>kodesalesman,System.String</value>
          <value>namasalesman,System.String</value>
          <value>statuss,System.Int16</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	a.tgl as tgl,
	GROUP_CONCAT(DISTINCT a.notransaksi) as notransaksi,
SUM(a.jmlri) - SUM(a.jmlsi) as jml,
a.sumber as sumber,
SUM(a.jmlri) as jmlri,
SUM(a.jmlsi) as jmlsi,
a.satuan as satuan,
a.idsupplier as idsupplier,
a.kodesupplier as kodesupplier,
CONCAT(a.kodesupplier,' - ',a.namasupplier) as namasupplier,
a.idcustomer as idcustomer,
a.kodecustomer as kodecustomer,
CONCAT(a.kodecustomer,' - ',a.namacustomer) as namacustomer,
a.idsalesman as idsalesman,
sl.kkode as kodesalesman,
CONCAT(sl.kkode,' - ',sl.knama) as namasalesman,
a.statuss as statuss  
FROM
(SELECT
	ri.ritgl as tgl,
	GROUP_CONCAT(DISTINCT ri.rinotransaksi) as notransaksi,
0 as jml,
ri.risumber as sumber,
SUM(rid.jml) as jmlri,
0 as jmlsi,
rid.satuan,
s.kid as idsupplier,
s.kkode as kodesupplier,
s.knama as namasupplier,
c.kid as idcustomer,
c.kkode as kodecustomer,
c.knama as namacustomer,
c.ksalesman as idsalesman,
ri.ristatus as statuss  
FROM
m1_contact s
JOIN m1_contact c ON s.kcustomtext6 = c.kkode
JOIN m4_ri ri ON s.kid = ri.risupplier
JOIN m4_ri_detail rid ON ri.riid = rid.idri AND ri.ristatus IN(2,3,4,7) AND rid.harga = 0
GROUP BY s.kkode ASC, s.kid ASC, ri.ritgl ASC

UNION ALL

SELECT
	si.sitgl as tgl,
	GROUP_CONCAT(DISTINCT si.sinotransaksi) as notransaksi,
0 as jml,
si.sisumber as sumber,
0 as jmlri,
SUM(sid.jml) as jmlsi,
sid.satuan,
s.kid as idsupplier,
s.kkode as kodesupplier,
s.knama as namasupplier,
c.kid as idcustomer,
c.kkode as kodecustomer,
c.knama as namacustomer,
c.ksalesman as idsalesman,
si.sistatus as statuss  
FROM
m1_contact s
JOIN m1_contact c ON s.kcustomtext6 = c.kkode
JOIN m5_si si ON c.kid = si.sicustomer
JOIN m5_si_detail sid ON si.siid = sid.idsi AND si.sistatus IN(2,3,4,7) AND sid.harga = 0
GROUP BY s.kkode ASC, s.kid ASC, si.sitgl ASC) as a
LEFT JOIN m1_contact sl ON a.idsalesman = sl.kid
GROUP BY a.kodesupplier ASC, a.idsupplier ASC, a.tgl ASC</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'DD','dd'),'mm','MM'),'YYYY','yyyy') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
