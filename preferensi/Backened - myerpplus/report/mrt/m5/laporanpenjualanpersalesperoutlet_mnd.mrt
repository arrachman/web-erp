              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>{IIF(Sum(DS1.sitotaltransaksi) &lt; 0,formatMinus.kiri,"")}{IIF(Sum(DS1.sitotaltransaksi) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, Sum(DS1.sitotaltransaksi)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, Sum(DS1.sitotaltransaksi)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(Sum(DS1.sitotaltransaksi) &lt; 0 ,formatMinus.kanan,"")}</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
