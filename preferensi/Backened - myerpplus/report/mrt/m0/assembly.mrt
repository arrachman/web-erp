        <Columns isList="true" count="16">
          <value>urutan,System.Int32</value>
          <value>asnotransaksi,System.String</value>
          <value>astgl,System.DateTime</value>
          <value>asuraian,System.String</value>
          <value>jmldetail,System.Double</value>
          <value>satuandetail,System.String</value>
          <value>hpp,System.Double</value>
          <value>namabarangdetail,System.String</value>
          <value>tipebarangdetail,System.String</value>
          <value>kodedetail,System.String</value>
          <value>satuan,System.String</value>
          <value>asjmljadi,System.Double</value>
          <value>bk2,System.String</value>
          <value>bn2,System.String</value>
          <value>bt2,System.String</value>
          <value>gnama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	asd.urutan , 
	sa.asnotransaksi , 
	sa.astgl , 
	sa.asuraian ,
	asd.jml as jmldetail , 
	asd.satuan as satuandetail,  
	asd.hpp , 
	asd.namabarang as namabarangdetail, 
	asd.tipebarang as tipebarangdetail , 
	b.bkode as kodedetail, 
	bj.bsatuan as satuan, 
	sa.asjmljadi , 
	bj.bkode AS bk2 , 
	bj.bnama AS bn2 , 
	bj.btipe as bt2 , 
	g.gnama
	FROM m3_as sa
JOIN m3_as_detail asd on sa.asid = asd.idas 
JOIN m1_barang b on asd.idbarang = b.bid
JOIN m1_barang bj on sa.asidbarangjadi = bj.bid
LEFT JOIN m1_gudang g on sa.asgudang = g.gkode 
ORDER BY sa.asnotransaksi , asd.urutan</SqlCommand>
      </DS1>
    </DataSources>
