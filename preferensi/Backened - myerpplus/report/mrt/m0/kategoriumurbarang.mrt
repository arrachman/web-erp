      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiUndefinedDataSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="4">
          <value>bkunama,System.String</value>
          <value>Status_Moving,System.String</value>
          <value>bkusjmltransaksi,System.String</value>
          <value>bkusbulan,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

bku.bkunama , 

CASE bks.bkusstatusmoving 
	WHEN "F" THEN "Fast Moving" 
	WHEN "M" THEN "Medium Moving" 
	WHEN "S" THEN "Slow Moving"
	WHEN "D" THEN "Death Moving"
END AS "Status_Moving" , 

bks.bkusjmltransaksi , 
bkusbulan

FROM m1_barang_kategori_umur bku
JOIN m1_barang_kategori_umur_set bks ON bku.bkukode =  bks.bkuskode

ORDER BY bku.bkunama</SqlCommand>
      </DS1>
    </DataSources>
