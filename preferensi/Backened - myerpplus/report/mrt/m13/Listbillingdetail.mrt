<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="4">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="21">
          <value>crid,System.Int64</value>
          <value>crnotransaksi,System.String</value>
          <value>crtgl,System.DateTime</value>
          <value>cruraian,System.String</value>
          <value>knama,System.String</value>
          <value>crkodepa,System.Int64</value>
          <value>crkontakperson,System.String</value>
          <value>catatan,System.String</value>
          <value>kurs,System.Double</value>
          <value>matauang,System.String</value>
          <value>crnorek,System.String</value>
          <value>norek,System.String</value>
          <value>statuscr,System.String</value>
          <value>divisi,System.String</value>
          <value>costcenter,System.String</value>
          <value>proyek,System.String</value>
          <value>namarekening,System.String</value>
          <value>kkode,System.String</value>
          <value>crkontak,System.Int64</value>
          <value>jmlvalas,System.Double</value>
          <value>kredit,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT   cr.crid, 	cr.crnotransaksi, 	cr.crtgl, 	cr.cruraian, 	k.knama, 	
	cr.crkodepa, 	cr.crkontakperson, 	crd.catatan, 	
	crd.kurs, 	
	crd.matauang, 	
	cr.crnorek, 	
	crd.norek AS norek, 	
	stat.nama AS statuscr, crd.divisi, crd.costcenter, crd.proyek, 
	c.cnama AS namarekening, k.kkode, cr.crkontak, 
	sum(crd.jumlahvalas) AS jmlvalas, sum(crd.jumlah) AS kredit 

	FROM m2_cr cr 
JOIN m2_cr_detail crd ON cr.crid = crd.idcr 
JOIN m1_contact k ON cr.crkontak = k.kid 
JOIN m1_coa c ON crd.norek = c.cnomor 
LEFT JOIN m1_division d ON crd.divisi = d.dkode 
LEFT JOIN m1_cost_center cc ON crd.costcenter = cc.cckode 
LEFT JOIN m1_project p ON crd.proyek = p.pkode 
JOIN m0_status stat ON cr.crstatus = stat.kode  
WHERE cr.crnotransaksi = 'ABCR14010003'
GROUP BY cr.crnotransaksi , cr.crjumlah , crd.jumlah ,crd.matauang , crd.norek 
ORDER BY cr.crtgl ASC,  cr.crnotransaksi, crd.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
    </DataSources>
