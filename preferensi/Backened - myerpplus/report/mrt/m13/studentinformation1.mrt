        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>Select a.*, b.scnama AS sikategorisiswanama, c.spnama AS siprogramstudinama

From m13_si a
Left Join m13_student_category b ON (a.sikategorisiswa = b.scid)
Left Join m13_study_program c ON (a.siprogramstudi = c.spkode)</SqlCommand>
      </DS1>
