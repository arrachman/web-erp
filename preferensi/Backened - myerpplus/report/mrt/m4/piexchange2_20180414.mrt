    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="32">
          <value>pieid,System.Int64</value>
          <value>pienotransaksi,System.String</value>
          <value>pietgl,System.DateTime</value>
          <value>pieuraian,System.String</value>
          <value>piecatatan,System.String</value>
          <value>piestatusnama,System.String</value>
          <value>supplierkode,System.String</value>
          <value>supppliernama,System.String</value>
          <value>alamat,System.String</value>
          <value>alamat2,System.String</value>
          <value>sumber,System.String</value>
          <value>idtransaksi,System.Int64</value>
          <value>notransaksi,System.String</value>
          <value>tgl,System.String</value>
          <value>matauang,System.String</value>
          <value>kurs,System.String</value>
          <value>totaltransaksi,System.String</value>
          <value>termin,System.String</value>
          <value>harijatuhtempo,System.Int64</value>
          <value>tgljatuhtempo,System.String</value>
          <value>catatan,System.String</value>
          <value>urutan,System.Int32</value>
          <value>isclose,System.Int16</value>
          <value>customtext1,System.String</value>
          <value>customtext2,System.String</value>
          <value>customtext3,System.String</value>
          <value>customdbl1,System.Double</value>
          <value>customdbl2,System.Double</value>
          <value>customdbl3,System.Double</value>
          <value>customdate1,System.DateTime</value>
          <value>customdate2,System.DateTime</value>
          <value>customdate3,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	pie.pieid,
	pie.pienotransaksi,
	pie.pietgl,
	pie.pieuraian,
	pie.piecatatan,
	st.nama as piestatusnama,
	c.kkode as supplierkode,
	c.knama as supppliernama,
	c.k1alamat1 as alamat,
	c.k1alamat2 as alamat2,
	pied.sumber,
	pied.idtransaksi,
	(CASE pied.sumber WHEN 'RI' THEN ri.rinotransaksi WHEN 'PRT' THEN prt.prtnotransaksi ELSE '' END) as notransaksi,
(CASE pied.sumber WHEN 'RI' THEN ri.ritgl WHEN 'PRT' THEN prt.prttgl ELSE '1900-01-01' END) as tgl,
(CASE pied.sumber WHEN 'RI' THEN ri.rimatauang WHEN 'PRT' THEN prt.prtmatauang ELSE '' END) as matauang,
(CASE pied.sumber WHEN 'RI' THEN ri.rikurs WHEN 'PRT' THEN prt.prtkurs ELSE '' END) as kurs,
(CASE pied.sumber WHEN 'RI' THEN ri.ritotaltransaksi WHEN 'PRT' THEN prt.prttotaltransaksi * -1 ELSE '0' END) as totaltransaksi,
(CASE pied.sumber WHEN 'RI' THEN ri.ritermin WHEN 'PRT' THEN prt.prttermin ELSE '' END) as termin,
IFNULL(tr.trharijatuhtempo,0) as harijatuhtempo,
(CASE pied.sumber WHEN 'RI' THEN ri.ritgljatuhtempo WHEN 'PRT' THEN prt.prttgljatuhtempo ELSE '1900-01-01' END) as tgljatuhtempo,
catatan,
urutan,
isclose,
customtext1,
customtext2,
customtext3,
customdbl1,
customdbl2,
customdbl3,
customdate1,
customdate2,
customdate3
FROM m4_pie pie
JOIN m4_pie_detail pied ON pie.pieid = pied.idpie
JOIN m0_status st ON pie.piestatus = st.kode
LEFT JOIN m4_ri ri ON pied.sumber = ri.risumber AND pied.idtransaksi = ri.riid
LEFT JOIN m4_prt prt ON pied.sumber = prt.prtsumber AND pied.idtransaksi = prt.prtid
LEFT JOIN m1_contact c ON IFNULL(ri.risupplier,prt.prtsupplier) = c.kid
LEFT JOIN m1_terms tr ON IFNULL(ri.ritermin,prt.prttermin) = tr.trkode</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
