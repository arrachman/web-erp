Replace(
Replace(
Replace(
(Format(formatNominal.fromat,DS1.ritotaltransaksi))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.ritotaltransaksi))
,",","RB")
,".","DS")
