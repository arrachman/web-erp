<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="24">
          <value>vpid,System.Int64</value>
          <value>vptgl,System.DateTime</value>
          <value>vpnotransaksi,System.String</value>
          <value>kkode,System.String</value>
          <value>knama,System.String</value>
          <value>nama,System.String</value>
          <value>vpuraian,System.String</value>
          <value>vpmatauang,System.String</value>
          <value>vpkurs,System.Double</value>
          <value>idvppdetail,System.Int64</value>
          <value>vpptgl,System.DateTime</value>
          <value>vppnotransaksi,System.String</value>
          <value>idtransaksi,System.Int64</value>
          <value>sumber,System.String</value>
          <value>notransaksi,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Double</value>
          <value>totaltransaksi,System.Double</value>
          <value>terbayar,System.Double</value>
          <value>jmlbayar,System.Double</value>
          <value>jmlbayarvalas,System.Double</value>
          <value>catatan,System.String</value>
          <value>catatan2,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	vp.vpid , 
	vp.vptgl , 
	vp.vpnotransaksi, 

	k.kkode , 
	k.knama , 

	st.nama , 
	vp.vpuraian , 

	vp.vpmatauang , 
	vp.vpkurs , 

	vpd.idvppdetail, 

	vpp.vpptgl , 
	vpp.vppnotransaksi , 

	vpd.idtransaksi , vpd.sumber , 

	CASE vpd.sumber  	
		WHEN "RI" then ri.rinotransaksi  	
		WHEN "AP" THEN ap.apnotransaksi  	
		WHEN "PRT" then prt.prtnotransaksi 
		WHEN "CA" THEN CONCAT(vpd.sumber,"(",coa.cnomor,")")
END AS notransaksi, 
	CASE vpd.sumber  	
		WHEN "RI" then ri.ritgl  	
		WHEN "AP" THEN ap.aptgl  	
		WHEN "PRT" then prt.prttgl  
END AS tgl,  
	CASE vpd.sumber  	
		WHEN "RI" then ri.rimatauang 	
		WHEN "AP" THEN ap.apmatauang 	
		WHEN "PRT" then prt.prtmatauang 
		WHEN "CA" THEN vpd.matauang 
	END AS matauang, 
	CASE vpd.sumber  	
		WHEN "RI" then ri.rikurs 	
		WHEN "AP" THEN ap.apkurs  	
		WHEN "PRT" then prt.prtkurs 
		WHEN "CA" THEN vpd.kurs
END AS kurs, 
	CASE vpd.sumber  	
		WHEN "RI" then vpd.totaltransaksi  	
		WHEN "AP" THEN vpd.totaltransaksi 	
		WHEN "PRT" then vpd.totaltransaksi 
END AS totaltransaksi, 
	CASE vpd.sumber  	
		WHEN "RI" then vpd.terbayar 	
		WHEN "AP" THEN vpd.terbayar 	
		WHEN "PRT" then vpd.terbayar 
END AS terbayar,  
	CASE vpd.sumber  	
		WHEN "RI" then vpd.jmlbayar 	
		WHEN "AP" THEN (vpd.jmlbayar * -1) 	
		WHEN "PRT" then (vpd.jmlbayar * -1)
		WHEN "CA" THEN vpd.jmlbayar
END AS jmlbayar,  
	CASE vpd.sumber  	
		WHEN "RI" then vpd.jmlbayarvalas 	
		WHEN "AP" THEN (vpd.jmlbayarvalas * -1)	
		WHEN "PRT" then (vpd.jmlbayarvalas  * -1)
		WHEN "CA" then vpd.jmlbayarvalas
END AS jmlbayarvalas, 
	CASE vpd.sumber  	
		WHEN "RI" then vpd.catatan
		WHEN "AP" THEN vpd.catatan
		WHEN "PRT" then vpd.catatan 
		WHEN "CA" then coa.cnama
END AS catatan  , 
	CASE vpd.sumber  	
		WHEN "RI" then ""
		WHEN "AP" THEN ""
		WHEN "PRT" then ""
		WHEN "CA" then CONCAT(coa.cnomor,"(",coa.cnama,")")
END AS catatan2  
 
FROM m4_vp vp
JOIN m1_contact k ON vp.vpsupplier = k.kid 
JOIN m4_vp_detail vpd ON vp.vpid = vpd.idvp
LEFT JOIN m4_vpp_detail vppd ON vpd.idvppdetail = vppd.idvppdetail
LEFT JOIN m4_vpp vpp ON vppd.idvpp = vpp.vppid

JOIN m0_status st ON vp.vpstatus = st.kode  
LEFT JOIN m4_ri ri ON vpd.sumber = ri.risumber AND vpd.idtransaksi = ri.riid 
LEFT JOIN m4_ap ap ON vpd.sumber = ap.apsumber AND vpd.idtransaksi = ap.apid 
LEFT JOIN m4_prt prt ON vpd.sumber = prt.prtsumber AND vpd.idtransaksi = prt.prtid 
LEFT JOIN m1_coa coa ON vpd.rekhutangpiutang = coa.cnomor    

ORDER BY vp.vptgl , vp.vpnotransaksi , vpd.sumber = "RI" DESC , vpd.sumber = "AP" DESC , vpd.sumber = "PRT" DESC, vpd.sumber = "CA" DESC, vpd.urutan  </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS2 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="18">
          <value>vpsupplier,System.String</value>
          <value>vpmatauang,System.String</value>
          <value>vpkurs,System.Double</value>
          <value>vpuraian,System.String</value>
          <value>vptgl,System.DateTime</value>
          <value>vpnotransaksi,System.String</value>
          <value>vpstatus,System.String</value>
          <value>sumber,System.String</value>
          <value>notransaksi,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Double</value>
          <value>totaltransaksi,System.Double</value>
          <value>terbayar,System.Double</value>
          <value>rencana,System.Double</value>
          <value>jmlbayar,System.Double</value>
          <value>jmlbayarvalas,System.Double</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT  	
	ks.knama AS vpsupplier ,  	
	vp.vpmatauang , 	
	vp.vpkurs ,  	
	vp.vpuraian ,  	
	vp.vptgl,  	
	vp.vpnotransaksi ,  	
	st.nama AS vpstatus,   	
	vpd.sumber,  	
	CASE vpd.sumber  	
		WHEN "RI" then ri.rinotransaksi  	
		WHEN "AP" THEN ap.apnotransaksi  	
		WHEN "PRT" then prt.prtnotransaksi 
		WHEN "CA" THEN CONCAT(vpd.sumber,"(",coa.cnomor,")")
END AS notransaksi, 
	CASE vpd.sumber  	
		WHEN "RI" then ri.ritgl  	
		WHEN "AP" THEN ap.aptgl  	
		WHEN "PRT" then prt.prttgl  
END AS tgl,  
	CASE vpd.sumber  	
		WHEN "RI" then ri.rimatauang 	
		WHEN "AP" THEN ap.apmatauang 	
		WHEN "PRT" then prt.prtmatauang 
		WHEN "CA" THEN vpd.matauang 
	END AS matauang, 
	CASE vpd.sumber  	
		WHEN "RI" then ri.rikurs 	
		WHEN "AP" THEN ap.apkurs  	
		WHEN "PRT" then prt.prtkurs 
		WHEN "CA" THEN vpd.kurs
END AS kurs, 
	CASE vpd.sumber  	
		WHEN "RI" then vpd.totaltransaksi  	
		WHEN "AP" THEN vpd.totaltransaksi 	
		WHEN "PRT" then vpd.totaltransaksi 
END AS totaltransaksi, 
	CASE vpd.sumber  	
		WHEN "RI" then vpd.terbayar 	
		WHEN "AP" THEN vpd.terbayar 	
		WHEN "PRT" then vpd.terbayar 
END AS terbayar,  
	CASE vpd.sumber  	
		WHEN "RI" then SUM(vpd.rencana) 	
		WHEN "AP" THEN SUM(vpd.rencana) 	
		WHEN "PRT" then SUM(vpd.rencana) 
END AS rencana,  
	CASE vpd.sumber  	
		WHEN "RI" then vpd.jmlbayar 	
		WHEN "AP" THEN vpd.jmlbayar 	
		WHEN "PRT" then vpd.jmlbayar 
		WHEN "CA" THEN vpd.jmlbayar
END AS jmlbayar,  
	CASE vpd.sumber  	
		WHEN "RI" then vpd.jmlbayarvalas 	
		WHEN "AP" THEN vpd.jmlbayarvalas 	
		WHEN "PRT" then vpd.jmlbayarvalas 
		WHEN "CA" then vpd.jmlbayarvalas
END AS jmlbayarvalas, 
	CASE vpd.sumber  	
		WHEN "RI" then vpd.catatan
		WHEN "AP" THEN vpd.catatan
		WHEN "PRT" then vpd.catatan 
		WHEN "CA" then coa.cnama
END AS catatan  	 

FROM m4_vp vp
JOIN m4_vp_detail vpd ON vp.vpid = vpd.idvp  
JOIN m1_contact ks ON vp.vpsupplier = ks.kid  
JOIN m0_status st ON vp.vpstatus = st.kode  
LEFT JOIN m4_ri ri ON vpd.sumber = ri.risumber AND vpd.idtransaksi = ri.riid 
LEFT JOIN m4_ap ap ON vpd.sumber = ap.apsumber AND vpd.idtransaksi = ap.apid 
LEFT JOIN m4_prt prt ON vpd.sumber = prt.prtsumber AND vpd.idtransaksi = prt.prtid 
LEFT JOIN m1_coa coa ON vpd.rekhutangpiutang = coa.cnomor    

GROUP BY vp.vptgl, vp.vpnotransaksi, vpd.idvpdetail 
ORDER BY vp.vptgl , vp.vpnotransaksi , vpd.sumber = "RI" DESC , vpd.sumber = "AP" DESC , vpd.sumber = "PRT" DESC, vpd.sumber = "CA" DESC, vpd.urutan </SqlCommand>
      </DS2>
      <DS3 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="11">
          <value>vpnotransaksi,System.String</value>
          <value>cara,System.Int16</value>
          <value>carabayar,System.String</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>jumlah,System.Double</value>
          <value>jumlahvalas,System.Double</value>
          <value>bank,System.String</value>
          <value>nogiro,System.String</value>
          <value>tgljt,System.DateTime</value>
          <value>noacbank,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	vp.vpnotransaksi,  vpay.carabayar AS cara, 
	CASE vpay.carabayar 
	WHEN 0 then "Cash"
	WHEN 1 then "Transfer"
	WHEN 3 then "Other"
	WHEN 2 then "Check/Giro"
end as carabayar, 
CASE vpay.carabayar
	WHEN 2 then coa.cnomor
ELSE coa2.cnomor
END AS cnomor, 
CASE vpay.carabayar
	WHEN 2 THEN coa.cnama
ELSE coa2.cnama 
end AS cnama , 
vpay.jumlah, vpay.jumlahvalas, 

vpay.bank , 
vpay.nogiro , 
vpay.tgljt , 
vpay.noacbank 

	
FROM m4_vp vp 
JOIN m4_vp_pay vpay ON vp.vpid = vpay.idvp
LEFT JOIN m1_coa coa ON vpay.rekgiro = coa.cnomor
LEFT JOIN m1_coa coa2 ON vpay.rekbank = coa2.cnomor

ORDER BY vp.vptgl , vp.vpnotransaksi </SqlCommand>
      </DS3>
