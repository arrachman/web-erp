<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="19">
          <value>vppid,System.Int64</value>
          <value>vppsupplier,System.String</value>
          <value>vppmatauang,System.String</value>
          <value>vppkurs,System.Double</value>
          <value>vppuraian,System.String</value>
          <value>vpptgl,System.DateTime</value>
          <value>vppnotransaksi,System.String</value>
          <value>vppstatus,System.String</value>
          <value>sumber,System.String</value>
          <value>notransaksi,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Double</value>
          <value>totaltransaksi,System.Double</value>
          <value>terbayar,System.Double</value>
          <value>rencana,System.Double</value>
          <value>jmlbayar,System.Double</value>
          <value>jmlbayarvalas,System.Double</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT  	
	vpp.vppid , 
	ks.knama AS vppsupplier ,  	
	vpp.vppmatauang , 	
	vpp.vppkurs ,  	
	vpp.vppuraian ,  	
	vpp.vpptgl,  	
	vpp.vppnotransaksi ,  	
	st.nama AS vppstatus,   	
	vppd.sumber,  	
	CASE vppd.sumber  	
		WHEN "RI" then ri.rinotransaksi  	
		WHEN "AP" THEN ap.apnotransaksi  	
		WHEN "PRT" then prt.prtnotransaksi 
		WHEN "CA" THEN CONCAT(vppd.sumber,"(",coa.cnomor,")")
END AS notransaksi, 
	CASE vppd.sumber  	
		WHEN "RI" then ri.ritgl  	
		WHEN "AP" THEN ap.aptgl  	
		WHEN "PRT" then prt.prttgl  
END AS tgl,  
	CASE vppd.sumber  	
		WHEN "RI" then ri.rimatauang 	
		WHEN "AP" THEN ap.apmatauang 	
		WHEN "PRT" then prt.prtmatauang 
		WHEN "CA" THEN vppd.matauang
	END AS matauang, 
	CASE vppd.sumber  	
		WHEN "RI" then ri.rikurs 	
		WHEN "AP" THEN ap.apkurs  	
		WHEN "PRT" then prt.prtkurs 
		WHEN "CA" THEN vppd.kurs
END AS kurs, 
	CASE vppd.sumber  	
		WHEN "RI" then vppd.totaltransaksi  	
		WHEN "AP" THEN vppd.totaltransaksi 	
		WHEN "PRT" then vppd.totaltransaksi 
END AS totaltransaksi, 
	CASE vppd.sumber  	
		WHEN "RI" then vppd.terbayar 	
		WHEN "AP" THEN vppd.terbayar 	
		WHEN "PRT" then vppd.terbayar 
END AS terbayar,  
	CASE vppd.sumber  	
		WHEN "RI" then SUM(vppd.rencana) 	
		WHEN "AP" THEN SUM(vppd.rencana) 	
		WHEN "PRT" then SUM(vppd.rencana) 
END AS rencana,  
	CASE vppd.sumber  	
		WHEN "RI" then vppd.jmlbayar 	
		WHEN "AP" THEN vppd.jmlbayar 	
		WHEN "PRT" then vppd.jmlbayar 
		WHEN "CA" THEN vppd.jmlbayar
END AS jmlbayar,  
	CASE vppd.sumber  	
		WHEN "RI" then vppd.jmlbayarvalas 	
		WHEN "AP" THEN vppd.jmlbayarvalas 	
		WHEN "PRT" then vppd.jmlbayarvalas 
		WHEN "CA" then vppd.jmlbayarvalas
END AS jmlbayarvalas, 
	CASE vppd.sumber  	
		WHEN "RI" then vppd.catatan
		WHEN "AP" THEN vppd.catatan
		WHEN "PRT" then vppd.catatan 
		WHEN "CA" then coa.cnama
END AS catatan  

FROM m4_vpp vpp  
JOIN m4_vpp_detail vppd ON vpp.vppid = vppd.idvpp  
JOIN m1_contact ks ON vpp.vppsupplier = ks.kid  
JOIN m0_status st ON vpp.vppstatus = st.kode  
LEFT JOIN m4_ri ri ON vppd.sumber = ri.risumber AND vppd.idtransaksi = ri.riid 
LEFT JOIN m4_ap ap ON vppd.sumber = ap.apsumber AND vppd.idtransaksi = ap.apid 
LEFT JOIN m4_prt prt ON vppd.sumber = prt.prtsumber AND vppd.idtransaksi = prt.prtid 
LEFT JOIN m1_coa coa ON vppd.rekhutangpiutang = coa.cnomor    

GROUP BY vpp.vpptgl, vpp.vppnotransaksi, vppd.idvppdetail 
ORDER BY vpp.vpptgl , vpp.vppid , vpp.vppnotransaksi ,  vppd.sumber = "RI" DESC , vppd.sumber = "AP" DESC , vppd.sumber = "PRT" DESC , vppd.sumber = "CA" DESC ,  vppd.urutan </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS2 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
