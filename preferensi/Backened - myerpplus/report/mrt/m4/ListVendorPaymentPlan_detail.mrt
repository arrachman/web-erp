		WHEN "AP" THEN vppd.jmlbayar 	
		WHEN "PRT" then vppd.jmlbayar 
		WHEN "CA" THEN vppd.jmlbayar
END AS jmlbayar,  
	CASE vppd.sumber  	
		WHEN "RI" then vppd.jmlbayarvalas 	
		WHEN "AP" THEN vppd.jmlbayarvalas 	
		WHEN "PRT" then vppd.jmlbayarvalas 
		WHEN "CA" then vppd.jmlbayarvalas
END AS jmlbayarvalas, 
	CASE vppd.sumber  	
		WHEN "RI" then vppd.catatan
		WHEN "AP" THEN vppd.catatan
		WHEN "PRT" then vppd.catatan 
		WHEN "CA" then coa.cnama
END AS catatan  

FROM m4_vpp vpp  
JOIN m4_vpp_detail vppd ON vpp.vppid = vppd.idvpp  
JOIN m1_contact ks ON vpp.vppsupplier = ks.kid  
JOIN m0_status st ON vpp.vppstatus = st.kode  
LEFT JOIN m4_ri ri ON vppd.sumber = ri.risumber AND vppd.idtransaksi = ri.riid 
LEFT JOIN m4_ap ap ON vppd.sumber = ap.apsumber AND vppd.idtransaksi = ap.apid 
LEFT JOIN m4_prt prt ON vppd.sumber = prt.prtsumber AND vppd.idtransaksi = prt.prtid 
LEFT JOIN m1_coa coa ON vppd.rekhutangpiutang = coa.cnomor    

GROUP BY vpp.vpptgl, vpp.vppnotransaksi, vppd.idvppdetail 
ORDER BY vpp.vpptgl , vpp.vppid , vpp.vppnotransaksi ,  vppd.sumber = "RI" DESC , vppd.sumber = "AP" DESC , vppd.sumber = "PRT" DESC , vppd.sumber = "CA" DESC ,  vppd.urutan </SqlCommand>
      </DS2>
      <DS3 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="11">
          <value>vppnotransaksi,System.String</value>
          <value>cara,System.Int16</value>
          <value>carabayar,System.String</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>jumlah,System.Double</value>
          <value>jumlahvalas,System.Double</value>
          <value>bank,System.String</value>
          <value>nogiro,System.String</value>
          <value>tgljt,System.DateTime</value>
          <value>noacbank,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	vpp.vppnotransaksi,  vpay.carabayar AS cara, 
	CASE vpay.carabayar 
	WHEN 0 then "Cash"
	WHEN 1 then "Transfer"
	WHEN 3 then "Other"
	WHEN 2 then "Check/Giro"
end as carabayar, 
CASE vpay.carabayar
	WHEN 2 then coa.cnomor
ELSE coa2.cnomor
END AS cnomor, 
CASE vpay.carabayar
	WHEN 2 THEN coa.cnama
ELSE coa2.cnama 
end AS cnama , 
vpay.jumlah, vpay.jumlahvalas, 

vpay.bank , 
vpay.nogiro , 
vpay.tgljt , 
vpay.noacbank 

	
FROM m4_vpp vpp 
JOIN m4_vpp_pay vpay ON vpp.vppid = vpay.idvpp
LEFT JOIN m1_coa coa ON vpay.rekgiro = coa.cnomor
LEFT JOIN m1_coa coa2 ON vpay.rekbank = coa2.cnomor

ORDER BY vpp.vpptgl , vpp.vppnotransaksi </SqlCommand>
      </DS3>
