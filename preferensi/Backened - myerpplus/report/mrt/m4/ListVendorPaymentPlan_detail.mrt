        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT  	
	vpp.vppid , 
	ks.knama AS vppsupplier ,  	
	vpp.vppmatauang , 	
	vpp.vppkurs ,  	
	vpp.vppuraian ,  	
	vpp.vpptgl,  	
	vpp.vppnotransaksi ,  	
	st.nama AS vppstatus,   	
	vppd.sumber,  	
	CASE vppd.sumber  	
		WHEN "RI" then ri.rinotransaksi  	
		WHEN "AP" THEN ap.apnotransaksi  	
		WHEN "PRT" then prt.prtnotransaksi 
		WHEN "CA" THEN CONCAT(vppd.sumber,"(",coa.cnomor,")")
END AS notransaksi, 
	CASE vppd.sumber  	
		WHEN "RI" then ri.ritgl  	
		WHEN "AP" THEN ap.aptgl  	
		WHEN "PRT" then prt.prttgl  
END AS tgl,  
	CASE vppd.sumber  	
		WHEN "RI" then ri.rimatauang 	
		WHEN "AP" THEN ap.apmatauang 	
		WHEN "PRT" then prt.prtmatauang 
		WHEN "CA" THEN vppd.matauang
	END AS matauang, 
	CASE vppd.sumber  	
		WHEN "RI" then ri.rikurs 	
		WHEN "AP" THEN ap.apkurs  	
		WHEN "PRT" then prt.prtkurs 
		WHEN "CA" THEN vppd.kurs
END AS kurs, 
	CASE vppd.sumber  	
		WHEN "RI" then vppd.totaltransaksi  	
		WHEN "AP" THEN vppd.totaltransaksi 	
		WHEN "PRT" then vppd.totaltransaksi 
END AS totaltransaksi, 
