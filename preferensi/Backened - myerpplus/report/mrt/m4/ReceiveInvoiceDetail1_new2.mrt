              <Name>Text9</Name>
              <Page isRef="8" />
              <Parent isRef="16" />
              <Text>{DS1.rimatauang}/{IIF((DS1.rikurs) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.rikurs))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.rikurs))
