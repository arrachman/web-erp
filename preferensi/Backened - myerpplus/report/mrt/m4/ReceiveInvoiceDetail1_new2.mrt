    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="38">
          <value>terbilang,System.String</value>
          <value>rihargatermasukpajak,System.Int16</value>
          <value>caption,System.String</value>
          <value>kkode,System.String</value>
          <value>risupplier,System.String</value>
          <value>k1alamat1,System.String</value>
          <value>rimatauang,System.String</value>
          <value>rikurs,System.Double</value>
          <value>riuraian,System.String</value>
          <value>ritgl,System.DateTime</value>
          <value>rinotransaksi,System.String</value>
          <value>ristatus,System.String</value>
          <value>ponotransaksi,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>grnnotransaksi,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>diskon,System.String</value>
          <value>jmldiskon,System.Double</value>
          <value>harga,System.Double</value>
          <value>jmlpajak1,System.Double</value>
          <value>total,System.Double</value>
          <value>ridiskonpersen,System.String</value>
          <value>rijmldiskon,System.Double</value>
          <value>ritotalpajak1detail,System.Double</value>
          <value>ritotalpajak2detail,System.Double</value>
          <value>ribiayalain,System.Double</value>
          <value>poinputuser,System.String</value>
          <value>riinputtgl,System.DateTime</value>
          <value>pomodifikasiuser,System.String</value>
          <value>rimodifikasitgl,System.DateTime</value>
          <value>ritgljatuhtempo,System.DateTime</value>
          <value>statusc,System.Int16</value>
          <value>ritotaltransaksi,System.Double</value>
          <value>kbank,System.String</value>
          <value>knorekening,System.String</value>
          <value>wnama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	
	rigudang as wnama,
	kbank,knorekening,
ritotaltransaksi,
	f_nominal(ritotaltransaksi, rimatauang) AS terbilang , 

	rihargatermasukpajak , 
	CASE rihargatermasukpajak
	WHEN 0 THEN "Belum Termasuk Pajak"
	WHEN 1 THEN "Sudah Termasuk Pajak"
END AS "caption" , 

ks.kkode , 
ks.knama AS risupplier , 
ks.k1alamat1 , 
ri.rimatauang , 
ri.rikurs , 
ri.riuraian , 
ri.ritgl, 
ri.rinotransaksi , 
st.nama AS ristatus , 
(SELECT 
	GROUP_CONCAT(DISTINCT po2.ponotransaksi)
from m4_po_detail pod2
join m4_po po2 ON pod2.idpo = po2.poid
join m4_ri_detail rid on pod2.idpodetail = rid.idpodetail
join m4_ri ri2 on rid.idri = ri2.riid WHERE ri2.riid = ri.riid
GROUP BY ri2.riid ) as ponotransaksi , 
b.bkode , 
rii.namabarang , 
grn.grnnotransaksi, 
rii.jml , 
rii.satuan , 
rii.diskon , rii.jmldiskon , 
rii.harga ,
rii.jmlpajak1, 
((rii.jml * rii.harga) - rii.jmldiskon) as total , 

ri.ridiskonpersen , ri.rijmldiskon, 
ri.ritotalpajak1detail, 
ri.ritotalpajak2detail,
ri.ribiayalain , 

user1.unama as poinputuser , 
ri.riinputtgl , 
user2.unama AS pomodifikasiuser , 
ri.rimodifikasitgl ,
ri.ritgljatuhtempo , 
ri.ristatus as statusc

FROM m4_ri ri 
JOIN m4_ri_detail rii ON ri.riid = rii.idri
JOIN m1_contact ks ON ri.risupplier = ks.kid
JOIN m1_item b ON rii.idbarang = b.bid
JOIN m0_status st ON ri.ristatus = st.kode

LEFT JOIN m4_po_detail pod ON rii.idpodetail = pod.idpodetail
LEFT JOIN m4_po po ON pod.idpo = po.poid

LEFT JOIN m4_grn_detail grnd ON rii.idgrndetail = grnd.idgrndetail
LEFT JOIN m4_grn grn ON grnd.idgrn = grn.grnid


JOIN m0_user user1 on ri.riinputuser = user1.userid
JOIN m0_user user2 on ri.rimodifikasiuser = user2.userid

ORDER BY ri.rinotransaksi, rii.urutan

limit 1</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
