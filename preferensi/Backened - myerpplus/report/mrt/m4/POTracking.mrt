<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="4">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="26">
          <value>ponotransaksi,System.String</value>
          <value>potgl,System.DateTime</value>
          <value>pocatatan,System.String</value>
          <value>postatus,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>catatan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>subtotal,System.Double</value>
          <value>urutan,System.Int32</value>
          <value>ritotaltransaksi,System.Double</value>
          <value>urutanri,System.Int32</value>
          <value>idpodetail,System.Int64</value>
          <value>potgljatuhtempo,System.DateTime</value>
          <value>rinotransaksi,System.String</value>
          <value>ritgl,System.DateTime</value>
          <value>supplier,System.String</value>
          <value>totalinvoice,System.Double</value>
          <value>paid,System.Double</value>
          <value>outstanding,System.Double</value>
          <value>prnotransaksi,System.String</value>
          <value>prtgl,System.DateTime</value>
          <value>csimbol,System.String</value>
          <value>riid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT  	

	po.ponotransaksi , 
	po.potgl, 
	po.pocatatan ,  	
	st.nama AS postatus ,   

	b.bkode , 
	pod.namabarang , 
	pod.catatan , 
	pod.jml ,
	pod.satuan ,
	pod.harga,
	(pod.jml * pod.harga) - pod.jmldiskon as subtotal,
	pod.urutan , ri1.ritotaltransaksi , ri1.urutan as urutanri , 
	
	pod.idpodetail, po.potgljatuhtempo,
	ri1.rinotransaksi, ri1.ritgl, kpo.knama as supplier,
	ri1.ritotaltransaksi as totalinvoice, ri1.rijmlbayar as paid,
	ri1.ritotaltransaksi - ri1.rijmlbayar as outstanding,
	pr.prnotransaksi, pr.prtgl,
	cr.csimbol,
	ri1.riid

	FROM m4_po po 
JOIN m4_po_detail pod ON po.poid = pod.idpo 
JOIN m1_item b ON pod.idbarang = b.bid 
JOIN m0_status st ON po.postatus = st.kode 
join m1_contact kpo on po.posupplier = kpo.kid
join m1_currency cr on po.pomatauang = cr.ckode
left join m4_pr_detail prd on prd.idprdetail = pod.idprdetail
left join m4_pr pr on pr.prid = prd.idpr


LEFT JOIN (
SELECT ri.riid, IFNULL( grnd.idpodetail,rid.idpodetail) AS idpodetail, 
	rid.idpodetail AS idpori, grnd.idpodetail AS idpogrn, ri.rinotransaksi, ri.ritgl,
	kkode as risupplier, knama AS namasupplier, ri.ritotaltransaksi, ri.rijmlbayar, rid.urutan
	from m4_ri_detail rid 
JOIN m4_ri ri ON ri.riid = rid.idri join m1_contact k on ri.risupplier = k.kid
left join m4_grn_detail grnd ON grnd.idgrndetail = rid.idgrndetail) 
as ri1 ON ri1.idpodetail = pod.idpodetail

WHERE potgl BETWEEN "2020-07-01" AND "2020-07-30" #AND ri1.risupplier = "CNS.A013"

ORDER BY po.potgl, po.ponotransaksi, pod.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
    </DataSources>
