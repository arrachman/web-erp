              <Name>Text24</Name>
              <Page isRef="8" />
              <Parent isRef="17" />
              <Text>{Format(formatTgl.format,DS1.potgl)}</Text>
              <TextBrush>Black</TextBrush>
              <TextFormat Ref="29" type="DateFormat" isKey="true">
