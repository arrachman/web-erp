<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="23">
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>prtid,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>knama,System.String</value>
          <value>prtgudang,System.String</value>
          <value>prturaian,System.String</value>
          <value>rinotransaksi,System.String</value>
          <value>prttgl,System.DateTime</value>
          <value>prtnotransaksi,System.String</value>
          <value>prtmatauang,System.String</value>
          <value>prtkurs,System.Double</value>
          <value>prtstatus,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>dnrnotransaksi,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>diskon,System.Double</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>prtjmldiskon,System.Double</value>
          <value>prttotalpajak1detail,System.Double</value>
          <value>prtbiayalain,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	COUNT(*), 
	prt.prtid, 
	prdt.idbarang , 

	ksup.knama , 
	w.wnama AS prtgudang, 
	prt.prturaian , 

	(SELECT
GROUP_CONCAT(DISTINCT ri2.rinotransaksi)
FROM m4_ri_detail rid2 
JOIN m4_ri ri2 ON rid2.idri = ri2.riid
JOIN m4_prt_detail prdt2 ON rid2.idridetail = prdt2.idridetail
JOIN m4_prt prt2 ON prdt2.idprt = prt2.prtid WHERE prt2.prtid = prt.prtid
GROUP BY prt2.prtid
) AS rinotransaksi , 

prt.prttgl, 
prt.prtnotransaksi, 
prt.prtmatauang, 
prt.prtkurs, 
st.nama AS prtstatus, 

b.bkode, 
prdt.namabarang , 
dnr.dnrnotransaksi, 
SUM(prdt.jml) AS jml, 
prdt.satuan, 
SUM(prdt.diskon)AS diskon, 
prdt.harga, 
((SUM(prdt.jml) * prdt.harga) - SUM(prdt.jmldiskon)) AS total, 

prt.prtjmldiskon, 
prt.prttotalpajak1detail, 
prt.prtbiayalain 

FROM m4_prt prt 
JOIN m4_prt_detail prdt ON prt.prtid = prdt.idprt
JOIN m1_item b ON prdt.idbarang = b.bid
JOIN m1_contact ksup ON prt.prtsupplier = ksup.kid
JOIN m0_status st ON prt.prtstatus = st.kode
JOIN m1_warehouse w ON prt.prtgudang = w.wkode

LEFT JOIN m4_ri_detail rid ON prdt.idridetail = rid.idridetail
LEFT JOIN m4_ri ri ON rid.idri = ri.riid

LEFT JOIN m4_dnr_detail dnrd ON prdt.iddnrdetail = dnrd.iddnrdetail
LEFT JOIN m4_dnr dnr ON dnrd.iddnr = dnr.dnrid

GROUP BY prt.prtid , prdt.idridetail,  prdt.idbarang , prdt.namabarang, prdt.satuan , prdt.harga
ORDER BY prt.prttgl, prt.prtid,  prt.prtnotransaksi, prdt.idbarang,  prdt.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="23">
          <value>prtid,System.Int64</value>
