<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="13">
          <value>apjenis,System.String</value>
          <value>knama,System.String</value>
          <value>apnorek,System.String</value>
          <value>ponotransaksi,System.String</value>
          <value>apnotransaksi,System.String</value>
          <value>aptgl,System.DateTime</value>
          <value>apstatus,System.String</value>
          <value>carabayar,System.String</value>
          <value>noakun,System.String</value>
          <value>namaakun,System.String</value>
          <value>matauang,System.String</value>
          <value>jumlah,System.Double</value>
          <value>jumlahvalas,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	CASE ap.apjenis 
	WHEN 0 then "UM Pembelian"
	WHEN 1 then "Titipan"
END AS apjenis , 
ks.knama , 
ap.apnorek, 
po.ponotransaksi, 
ap.apnotransaksi , 
ap.aptgl,  
st.nama AS apstatus , 

CASE app.carabayar 
	WHEN 0 then "Cash"
	WHEN 1 then "Transfer"
	WHEN 2 then "Check/Giro"
	WHEN 3 then "Other"
end as carabayar, 
CASE app.carabayar 
	WHEN 2 THEN app.rekgiro
	ELSE app.rekbank
END AS noakun ,
CASE app.carabayar 
	WHEN 2 then coa2.cnama 
ELSE coa.cnama 
END AS namaakun, 
app.matauang, 
app.jumlah, 
app.jumlahvalas

FROM m4_ap ap 
JOIN m4_ap_pay app ON ap.apid = app.idap 
JOIN m1_contact ks ON ap.apkontak = ks.kid 
LEFT JOIN m4_po po ON ap.apidpo = po.poid 
JOIN m0_status st ON ap.apstatus = st.kode

LEFT JOIN m1_coa coa ON app.rekbank = coa.cnomor
LEFT JOIN m1_coa coa2 ON app.rekgiro = coa2.cnomor

WHERE ap.apnotransaksi = "BRAP13100001"
ORDER BY ap.aptgl, ap.apnotransaksi , app.urutan</SqlCommand>
      </DS1>
      <DS2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="9">
          <value>apnotransaksi,System.String</value>
          <value>urutan,System.Int32</value>
          <value>bank,System.String</value>
          <value>nogiro,System.String</value>
          <value>jumlah,System.Double</value>
          <value>tgljt,System.DateTime</value>
          <value>noacbank,System.String</value>
          <value>cnama,System.String</value>
          <value>apjumlahbayar,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	ap.apnotransaksi, 
	app.urutan , 
	app.bank , 
	app.nogiro , 
	app.jumlah , 
	app.tgljt , 
	app.noacbank , 
	coa.cnama , 
	ap.apjumlahbayar

	FROM m4_ap ap 
JOIN m4_ap_pay app ON ap.apid = app.idap 
LEFT JOIN  m2_giro_list gl ON ap.apnotransaksi = gl.glnotransaksi
JOIN m1_coa coa ON ap.apnorek = coa.cnomor

ORDER BY ap.apnotransaksi, app.urutan </SqlCommand>
      </DS2>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
    </DataSources>
