<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="18">
          <value>summ,System.String</value>
          <value>vppsupplier,System.Int64</value>
          <value>vppsupplierkode,System.String</value>
          <value>vppsuppliernama,System.String</value>
          <value>vppid,System.Int64</value>
          <value>vppnotransaksi,System.String</value>
          <value>vpptgl,System.DateTime</value>
          <value>vppstatus,System.Int16</value>
          <value>vppstatusnama,System.String</value>
          <value>idvppdetail,System.Int64</value>
          <value>sumber,System.String</value>
          <value>idtransaksi,System.Int64</value>
          <value>notransaksi,System.String</value>
          <value>subt,System.Double</value>
          <value>jmlbayar,System.Double</value>
          <value>tgltransaksi,System.String</value>
          <value>tglpie,System.String</value>
          <value>tgljt,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	(CASE vppd.sumber
WHEN 'RI' THEN "RI"
WHEN 'PRT' THEN "PRT"
ELSE "CA"
END) as summ,

	vpp.vppsupplier,
	c.kkode as vppsupplierkode,
	c.knama as vppsuppliernama,
	vpp.vppid,
	vpp.vppnotransaksi,
	vpp.vpptgl,
	vpp.vppstatus,
	st.nama as vppstatusnama,
	vppd.idvppdetail,
	vppd.sumber,
	vppd.idtransaksi,
	(CASE vppd.sumber
WHEN 'RI' THEN IFNULL(ri.rinotransaksi,'')
WHEN 'PRT' THEN IFNULL(prt.prtnotransaksi,'')
ELSE CONCAT('CA','(',IFNULL(coa.cnama,''),')')
END) as notransaksi,
vppd.jmlbayar * 1 AS subt , 
(CASE vppd.sumber
WHEN 'PRT' THEN vppd.jmlbayar * -1
ELSE vppd.jmlbayar
END) * 1 as jmlbayar,
(CASE vppd.sumber
WHEN 'RI' THEN IFNULL(ri.ritgl,'1900-01-01')
WHEN 'PRT' THEN IFNULL(prt.prttgl,'1900-01-01')
ELSE IFNULL(vpp.vpptgl,'')
END) as tgltransaksi,
(CASE 
WHEN IFNULL(pie.piestatus,0) IN (2,3,4) THEN IFNULL(pie.pietgl,'1900-01-01')
ELSE '1900-01-01'
END) as tglpie,
(CASE vppd.sumber
WHEN 'RI' THEN IFNULL(ri.ritgljatuhtempo,'1900-01-01')
WHEN 'PRT' THEN IFNULL(prt.prttgljatuhtempo,'1900-01-01')
ELSE IFNULL(vpp.vpptgl,'')
END) as tgljt

FROM
m4_vpp vpp
JOIN m4_vpp_detail vppd ON vpp.vppid = vppd.idvpp
JOIN m1_contact c ON vpp.vppsupplier = c.kid
JOIN m0_status st ON vpp.vppstatus = st.kode
JOIN m1_coa coa ON vppd.rekhutangpiutang = coa.cnomor
LEFT JOIN m4_ri ri ON vppd.sumber = ri.risumber AND vppd.idtransaksi = ri.riid
LEFT JOIN m4_prt prt ON vppd.sumber = prt.prtsumber AND vppd.idtransaksi = prt.prtid
LEFT JOIN m4_pie_detail pied ON vppd.sumber = pied.sumber AND vppd.idtransaksi = pied.idtransaksi
LEFT JOIN m4_pie pie ON pied.idpie = pie.pieid

ORDER BY 
c.kkode, vpp.vpptgl, vpp.vppnotransaksi, vpp.vppid, vppd.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
