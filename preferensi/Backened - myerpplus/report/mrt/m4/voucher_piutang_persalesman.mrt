<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="4">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="19">
          <value>kkode,System.String</value>
          <value>knama,System.String</value>
          <value>dpnama,System.String</value>
          <value>sdpnama,System.String</value>
          <value>siid,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>ukode,System.String</value>
          <value>unilai,System.Double</value>
          <value>tjml,System.Double</value>
          <value>total,System.Double</value>
          <value>kodeKRT,System.String</value>
          <value>nilaiKRT,System.Double</value>
          <value>KRT,System.Double</value>
          <value>LSN,System.Double</value>
          <value>PCS,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	k.kkode , 
	k.knama , 
	dp.dpnama , 
	sdp.sdpnama , 

	si.siid , 
	sid.idbarang , 
	b.bkode , b.bnama , SUM(sid.jml) AS jml , sid.satuan  , u.ukode , u.unilai , 
	SUM(sid.jml * u.unilai) AS tjml , 
	SUM((sid.jml * u.unilai) * sid.harga) AS total, 
	un.ukode AS kodeKRT , un.unilai AS nilaiKRT , 

	(SUM(sid.jml * u.unilai) - (SUM(sid.jml * u.unilai) MOD un.unilai)) / un.unilai As KRT , 


((SUM(sid.jml * u.unilai) MOD un.unilai ) - (SUM(sid.jml * u.unilai) MOD un.unilai)  mod 12) / 12  AS LSN , 
(SUM(un.unilai) MOD un.unilai)  mod 12 AS PCS  

	FROM m5_si si 
JOIN m1_contact k ON si.sibagianpenjualan =  k.kid 
JOIN m5_si_detail sid ON si.siid = sid.idsi 
JOIN m1_item b ON sid.idbarang = b.bid 
join m1_unit u on sid.satuan = u.ukode
LEFT JOIN m1_unit un ON b.bcustom2 = un.ukode

LEFT JOIN m1_department dp ON b.bdepartemen = dp.dpkode
LEFT JOIN m1_subdepartment sdp ON b.bsubdepartemen = sdp.sdpkode

WHERE si.sinotransaksi = "AASI16013804"

GROUP BY bdepartemen ASC , bsubdepartemen ASC, sibagianpenjualan ASC , sid.idbarang
ORDER BY bdepartemen ASC , bsubdepartemen ASC, sibagianpenjualan ASC , sid.idbarang</SqlCommand>
      </DS1>
      <formatNominal Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
