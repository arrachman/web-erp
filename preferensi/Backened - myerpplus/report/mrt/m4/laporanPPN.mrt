            <Text28 Ref="33" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>4.09,0,1.26,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>aaa368dcf5234e51bcbcdcb8dcf53f90</Guid>
              <HorAlignment>Right</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text28</Name>
              <Page isRef="8" />
              <Parent isRef="30" />
              <Text>{IIF(DS1.pembelian &lt; 0,formatMinus.kiri,"")}{IIF(DS1.pembelian &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.pembelian))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.pembelian))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(DS1.pembelian &lt; 0 ,formatMinus.kanan,"")}</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text28>
            <Text29 Ref="34" type="Text" isKey="true">
              <Brush>Transparent</Brush>
