 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatVolume Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatVolume</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
