<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="22">
          <value>nsiidbarang,System.Int64</value>
          <value>bkode,System.String</value>
          <value>nsiidserialin,System.Int64</value>
          <value>notransaksi,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>knama,System.String</value>
          <value>namabarang,System.String</value>
          <value>nsijmlmasuk,System.Double</value>
          <value>nsijmlkeluar,System.Double</value>
          <value>nsisatuan,System.String</value>
          <value>jmlsisa,System.Double</value>
          <value>nsikode,System.String</value>
          <value>nsoidserialin,System.Int64</value>
          <value>sonotransaksi,System.String</value>
          <value>sotgl,System.DateTime</value>
          <value>sokanama,System.String</value>
          <value>sonamabarang,System.String</value>
          <value>nsojmlkeluar,System.Double</value>
          <value>nsosatuan,System.String</value>
          <value>nsokode,System.String</value>
          <value>nsoidtransaksi,System.Int64</value>
          <value>nsoid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	nsi.nsiidbarang , 
	b.bkode , 
	nsi.nsiidserialin , 

	it.notransaksi , 
	it.tgl , 
	k.knama , 
	it.namabarang , 
	nsi.nsijmlmasuk , 
	nsi.nsijmlkeluar , 
	nsi.nsisatuan , 
	(nsi.nsijmlmasuk - nsi.nsijmlkeluar) AS jmlsisa , nsi.nsikode , 

	nso.nsoidserialin , 
	it2.notransaksi AS sonotransaksi , 
	it2.tgl sotgl , 
kk.knama as sokanama , 
it2.namabarang AS sonamabarang , 
nso.nsojmlkeluar , 
nso.nsosatuan , nso.nsokode , 
nso.nsoidtransaksi , nso.nsoid 

FROM m1_no_serial_in nsi
JOIN m1_item_transaction it ON it.idbarang = nsi.nsiidbarang AND it.sumber = nsi.nsisumber AND it.idutama = nsi.nsiidtransaksi AND it.jenismutasi = 1

JOIN m1_no_serial_out nso ON nsi.nsiidserialin = nso.nsoidserialin 
JOIN m1_item_transaction it2 ON it2.idbarang = nso.nsoidbarang AND it2.sumber = nso.nsosumber AND it2.idutama = nso.nsoidtransaksi AND it2.jenismutasi = 0

LEFT JOIN m1_item b ON it.idbarang = b.bid
LEFT JOIN m1_contact k ON it.kontak = k.kid 

LEFT JOIN m1_item bb ON it2.idbarang = bb.bid
LEFT JOIN m1_contact kk ON it2.kontak = kk.kid 

GROUP BY nsi.nsiidserialin , nsi.nsiidbarang , nsi.nsisumber , nsiidtransaksi, nso.nsoidbarang , nso.nsosumber , nso.nsoidtransaksi 

ORDER BY it.id</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
