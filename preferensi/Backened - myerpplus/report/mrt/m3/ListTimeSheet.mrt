<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="23">
          <value>dcid,System.Int64</value>
          <value>dcmintake,System.String</value>
          <value>dcnotransaksi,System.String</value>
          <value>dctgl,System.DateTime</value>
          <value>dcshift,System.String</value>
          <value>dcstatus,System.String</value>
          <value>dcdimintaoleh,System.String</value>
          <value>bkode,System.String</value>
          <value>dcnamabarang,System.String</value>
          <value>dchmstart,System.Double</value>
          <value>dchmstop,System.Double</value>
          <value>total,System.Double</value>
          <value>opstart,System.TimeSpan</value>
          <value>opend,System.TimeSpan</value>
          <value>sbstart,System.TimeSpan</value>
          <value>sbend,System.TimeSpan</value>
          <value>spstart,System.TimeSpan</value>
          <value>spend,System.TimeSpan</value>
          <value>rfstart,System.TimeSpan</value>
          <value>rfend,System.TimeSpan</value>
          <value>bdstart,System.TimeSpan</value>
          <value>bdend,System.TimeSpan</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	dc.dcid , 
	kk.knama AS dcmintake , 
	dc.dcnotransaksi, 
	dc.dctgl, 
	CASE dc.dcshift 
	WHEN 1 THEN "Night"
	WHEN 0 THEN "DAY"
END AS dcshift ,
(CASE dc.dcstatus
	WHEN 0 THEN 'Draft'
	WHEN 1 THEN 'Minta Approve'
	WHEN 2 THEN 'Approved'
	WHEN 3 THEN 'Inprogress'
	WHEN 4 THEN 'Complete'
	WHEN 5 THEN 'Revisi'
	WHEN 6 THEN 'Reject'
	WHEN 7 THEN 'Close'
	WHEN 8 THEN 'Approve1' 
	WHEN 9 THEN 'Approve2' 
	WHEN 10 THEN 'Approve3' 
	WHEN 11 THEN 'Approve4' 
	WHEN 12 THEN 'Hapus'
END) AS dcstatus,
k.knama AS dcdimintaoleh , 
b.bkode , dc.dcnamabarang , 
dc.dchmstart , 
dc.dchmstop , 
(dc.dchmstart - dc.dchmstop) as total , 

dcd.opstart, 
dcd.opend , 

dcd.sbstart, 
dcd.sbend, 

dcd.spstart, 
dcd.spend, 

dcd.rfstart , 
dcd.rfend, 

dcd.bdstart, 
dcd.bdend, 

dcd.catatan

FROM m3_dc dc
JOIN m1_location l ON dc.dclokasi = l.lkode
LEFT JOIN m1_contact kk ON dc.dcmintake = kk.kid
LEFT JOIN m1_contact k ON dc.dcdimintaoleh = k.kid
LEFT JOIN m1_item b ON dc.dcidbarang = b.bid

JOIN m3_dc_detail dcd ON dc.dcid = dcd.iddc

ORDER BY dc.dcid, dc.dcnotransaksi, dcd.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS2 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="3">
          <value>dcid,System.Int64</value>
          <value>ccnama,System.String</value>
          <value>status,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	dc.dcid, 
	cc.ccnama , 
	dcc.status

	FROM m3_dc dc
JOIN m3_dc_check dcc ON dc.dcid = dcc.iddc
LEFT JOIN m1_checking_category cc ON dcc.idkategoricheck = cc.ccid

ORDER BY dc.dcid , dc.dcnotransaksi, cc.ccid</SqlCommand>
      </DS2>
