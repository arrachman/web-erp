IIF(((DS2.TotalStock) &gt; 800000) &amp;&amp; ((DS2.TotalStock) &lt; 1250000) &amp;&amp; ((DS2.TotalOrder) &gt; 600000) &amp;&amp; ((DS2.TotalOrder) &lt; 1100000) &amp;&amp; ((DS2.AvailableStok) &gt;= 0), "1. Cari Order Agresif", 
IIF(((DS2.TotalStock) &gt; 800000) &amp;&amp; ((DS2.TotalStock) &lt; 1250000) &amp;&amp; ((DS2.TotalOrder) &gt; 1100000) &amp;&amp; ((DS2.TotalOrder) &lt; 1300000) &amp;&amp; ((DS2.AvailableStok) &gt;= 0), "1. Cari Order", 
