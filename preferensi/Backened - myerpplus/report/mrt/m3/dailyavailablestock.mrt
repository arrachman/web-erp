IIF(((DS2.TotalStock) &gt; 1250000) &amp;&amp; ((DS2.TotalOrder) &gt; 600000) &amp;&amp; ((DS2.TotalOrder) &lt; 1100000) &amp;&amp; ((DS2.AvailableStok) &gt;= 0), "1. Cari Order Agresif, 2. Kurangi Beli Bahan Baku, 3. Jual Hedging", 
