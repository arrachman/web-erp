IIF(((DS2.TotalStock) &lt; 800000) &amp;&amp; ((DS2.TotalOrder) &gt; 1100000) &amp;&amp; ((DS2.TotalOrder) &lt; 1300000) &amp;&amp; ((DS2.AvailableStok) &lt; 0), "1. Beli Bahan Baku Agresif", 
IIF(((DS2.TotalStock) &lt; 800000) &amp;&amp; ((DS2.TotalOrder) &gt; 1300000) &amp;&amp; ((DS2.TotalOrder) &lt; 1800000) &amp;&amp; ((DS2.AvailableStok) &lt; 0), "1. Beli Bahan Baku Agresif, 2. Buy Hedging",
IIF(((DS2.TotalStock) &gt; 800000) &amp;&amp; ((DS2.TotalStock) &lt; 1250000) &amp;&amp; ((DS2.TotalOrder) &gt; 600000) &amp;&amp; ((DS2.TotalOrder) &lt; 1300000) &amp;&amp; ((DS2.AvailableStok) &lt; 0), "1. Beli Bahan Baku", 
