              <Text>Rekomendasi : 
{
IIF(((DS2.TotalStock) &lt; 800000) &amp;&amp; ((DS2.TotalOrder) &gt; 600000) &amp;&amp; ((DS2.TotalOrder) &lt; 1100000) &amp;&amp; ((DS2.AvailableStok) &lt; 0), "1. Beli Bahan Baku s/d Minimum Stock", 
