              <HorAlignment>Right</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text8</Name>
              <Page isRef="7" />
              <Parent isRef="33" />
              <Text>{IIF((DS1.jmlbarangfisik) &lt; 0,(Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.jmlbarangfisik))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal)
), Replace(
Replace(
