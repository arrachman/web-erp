            <Text8 Ref="36" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>12.55,0,1.37,0.51</ClientRectangle>
