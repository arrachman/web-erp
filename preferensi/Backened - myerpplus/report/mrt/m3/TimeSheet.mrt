                      <Name>Text83</Name>
                      <Page isRef="9" />
                      <Parent isRef="134" />
                      <Text>PERHATIAN / ETTENTION :</Text>
                      <TextBrush>Black</TextBrush>
                      <Type>Expression</Type>
                      <VertAlignment>Center</VertAlignment>
                    </Text83>
                    <Text84 Ref="139" type="Text" isKey="true">
                      <Brush>Transparent</Brush>
                      <ClientRectangle>0.11,0.64,7.6,0.34</ClientRectangle>
                      <Conditions isList="true" count="0" />
