                      <Margins>0,0,0,0</Margins>
                      <Name>Text84</Name>
                      <Page isRef="9" />
                      <Parent isRef="134" />
                      <Text>1.Seluruh Driver wajib mengisi dan menyerahkan laporan pemeriksaan peralatan harian (P2H)ini ke SUpervisior walaupun Unit dalam kondisi 
Stand By / Break Down</Text>
                      <TextBrush>Black</TextBrush>
                      <Type>Expression</Type>
                    </Text84>
                    <Text85 Ref="140" type="Text" isKey="true">
                      <Brush>Transparent</Brush>
                      <ClientRectangle>0.11,0.99,7.6,0.35</ClientRectangle>
