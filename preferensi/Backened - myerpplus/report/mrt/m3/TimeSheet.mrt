                      <Font>Lao UI,9</Font>
                      <Guid>def5a15e33a64f0284c56626ad6135b2</Guid>
                      <Margins>0,0,0,0</Margins>
                      <Name>Text85</Name>
                      <Page isRef="9" />
                      <Parent isRef="134" />
                      <Text>2.Laporan ini berfungsi sebagai bukti kehadiran driver ditempat kerja dan waktu 1 shift harus full 12 Jam
3. Pengecekan unit sebelum dan sesudah dioperasikan Wajib dilaksanakan untuk menghindari kerusakan alat atau accident</Text>
                      <TextBrush>Black</TextBrush>
                      <Type>Expression</Type>
                    </Text85>
