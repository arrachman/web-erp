    <Databases isList="true" count="1">
      <myerpplus isKey="true" Ref="2" type="Stimulsoft.Report.Dictionary.StiMySqlDatabase">
        <Alias>myerpplus</Alias>
        <ConnectionStringEncrypted>w2r5CcYDY7xFWPnczyX2XotS9YNGTfvN41uh/GFxpT/GQMnrQ03z8ENR7YBqXGJrwHB3q8ZNS6xD
E6X4SwSkI4ZU2QhPFruIQVo=</ConnectionStringEncrypted>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="1">
      <DS1 isKey="true" Ref="3" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>DS1</Alias>
        <Columns isList="true" count="5">
          <value>kcustomer,System.String</value>
          <value>ncustomer,System.String</value>
          <value>alamatcustomer,System.String</value>
          <value>kkode,System.String</value>
          <value>knama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT

k1.kkode AS kcustomer, 
k1.knama AS ncustomer,
 
CONCAT(IFNULL(k1.k1alamat1,"")," " , IFNULL(k1.k1alamat2," ")," " , IFNULL(k1.k1kotanama," ")," " , 
				IFNULL(k1.k1propinsinama," ")," " , IFNULL(k1.k1kodepos," ")," " , IFNULL( k1.k1negaranama," ")) as alamatcustomer,

k2.kkode, 
k2.knama

FROM m1_kontak  k1
JOIN m1_kontak  k2 ON k1.ksalesman = k2.kid
WHERE k1.kkategori = "c"
ORDER BY k2.kkode , k1.kkode</SqlCommand>
      </DS1>
    </DataSources>
    <Relations isList="true" count="0"/>
    <Report isRef="0"/>
    <Variables isList="true" count="0"/>
