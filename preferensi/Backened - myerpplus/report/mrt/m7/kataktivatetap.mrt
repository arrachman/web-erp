      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="3">
          <value>acnama,System.String</value>
          <value>ackode,System.String</value>
          <value>kategoripajak,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	ac.acnama,
	ac.ackode,
	act.actnama AS kategoripajak

	FROM m7_asset_category ac
JOIN m7_asset_category_tax act ON ac.ackategoripajak = act.actkode
ORDER BY ac.ackode</SqlCommand>
      </DS1>
