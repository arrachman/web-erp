        <Alias>myerpplus</Alias>
        <ConnectionStringEncrypted>w2r5CcYDY7xFWPnczyX2XotS9YNGTfvN41uh/GFxpT/GQMnrQ03z8ENR7YBqXGJrwHB3q8ZNS6xD
E6X4SwSkI4ZU2QhPFruIQVo=</ConnectionStringEncrypted>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="1">
      <DS1 isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="3">
        <Alias>DS1</Alias>
        <Columns isList="true" count="12">
          <value>ivstatusbayar,System.String</value>
          <value>ivnotransaksi,System.String</value>
          <value>ivtgl,System.DateTime</value>
          <value>knama,System.String</value>
          <value>k2,System.String</value>
          <value>Status,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>tipebarang,System.String</value>
          <value>jml,System.Decimal</value>
          <value>satuan,System.String</value>
          <value>harga,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT

iv.ivstatusbayar , 

iv.ivnotransaksi , 
iv.ivtgl, 
k.knama, 
k2.knama as k2, 
CASE iv.ivstatusbayar 
	WHEN "P" THEN "Proses"
	WHEN "B" THEN "Belum"
END AS "Status" , 

b.bkode, 
ivd.namabarang , 
ivd.tipebarang, ivd.jml, ivd.satuan, 
(ivd.jml * ivd.harga) as harga


FROM m5_iv iv
JOIN m5_iv_detail ivd ON iv.ivid = ivd.idiv 
JOIN m1_kontak k ON iv.ivcustomer = k.kid
JOIN m1_barang b ON ivd.idbarang = b.bid
JOIN m1_kontak k2 ON iv.ivbagianpenjualan = k2.kid

WHERE (iv.ivstatusbayar &lt;&gt; "S")
ORDER BY iv.ivnotransaksi, ivd.urutan

limit 20</SqlCommand>
      </DS1>
    </DataSources>
    <Relations isList="true" count="0"/>
    <Report isRef="0"/>
    <Variables isList="true" count="0"/>
