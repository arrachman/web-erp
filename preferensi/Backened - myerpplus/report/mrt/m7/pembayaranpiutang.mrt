    </Databases>
    <DataSources isList="true" count="1">
      <DS1 isKey="true" Ref="3" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>DS1</Alias>
        <Columns isList="true" count="23">
          <value>cpnotransaksi,System.String</value>
          <value>cptgl,System.DateTime</value>
          <value>knama,System.String</value>
          <value>cpcatatan,System.String</value>
          <value>carabayar,System.String</value>
          <value>cptglbayar,System.DateTime</value>
          <value>cpmatauang,System.String</value>
          <value>cpkurs,System.Decimal</value>
          <value>cptotalap,System.Decimal</value>
          <value>asjmldiskon,System.Decimal</value>
          <value>cptotalar,System.Decimal</value>
          <value>tnotransaksi,System.String</value>
          <value>ttgl,System.DateTime</value>
          <value>sumber,System.String</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Decimal</value>
          <value>terbayar,System.Decimal</value>
          <value>jmlbayar,System.Decimal</value>
          <value>jmlbayarvalas,System.Decimal</value>
          <value>diskontermin,System.Decimal</value>
          <value>rekhutangpiutang,System.String</value>
          <value>nogiro,System.String</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
cp.cpnotransaksi,
cp.cptgl,
kc.knama,
cp.cpcatatan,
(CASE cp.cpcarabayar
WHEN 0 THEN 'Cash'
WHEN 1 THEN 'Transfer'
WHEN 2 THEN 'Cek/Giro'
ELSE 'Lain-lain'
END) AS carabayar,
cp.cptglbayar,
cp.cpmatauang,
cp.cpkurs,
cp.cptotalap,
(SELECT SUM(cpds.diskontermin) FROM m5_cp_detail cpds
JOIN m5_cp cps ON cps.cpid = cpds.idcp
JOIN m1_kontak kcs ON cps.cpcustomer = kcs.kid
LEFT JOIN m1_kontak kss ON cps.cpidsales = kss.kid
LEFT JOIN m5_pp_detail ppds ON cpds.idppdetail = ppds.idppdetail
WHERE cpds.idcp = cpd.idcp
GROUP BY cps.cpnotransaksi
ORDER BY cps.cpnotransaksi, cpds.urutan) AS asjmldiskon,
cp.cptotalar,
(CASE cpd.sumber 
	WHEN "IV" THEN (SELECT iv.ivnotransaksi FROM m5_iv iv WHERE iv.ivsumber = cpd.sumber AND iv.ivid = cpd.idtransaksi )
	WHEN "OM" THEN (SELECT t.tnotransaksi FROM m2_transaksi t WHERE t.tid = cpd.idtransaksi AND t.tsumber = 'OM' )
	WHEN "TU" THEN (SELECT t.tnotransaksi FROM m2_transaksi t WHERE t.tid = cpd.idtransaksi AND t.tsumber = 'TU' )
	WHEN "HD" THEN (SELECT t.tnotransaksi FROM m2_transaksi t WHERE t.tid = cpd.idtransaksi AND t.tsumber = 'HD' )
	WHEN "SR" THEN (SELECT sr.srnotransaksi FROM m5_sr sr WHERE sr.srid = cpd.idtransaksi AND sr.srsumber = cpd.sumber )
	WHEN "AE" THEN (SELECT ae.aenotransaksi FROM m5_ae ae WHERE ae.aeid = cpd.idtransaksi AND ae.aesumber = cpd.sumber)
	WHEN "SU" THEN (SELECT sa.sanotransaksi FROM m2_sa_hutangpiutang sa WHERE sa.said = cpd.idtransaksi AND sa.sasumber = cpd.sumber )
END) AS tnotransaksi,
(CASE cpd.sumber 
	WHEN "IV" THEN (SELECT iv.ivtgl FROM m5_iv iv WHERE iv.ivsumber = cpd.sumber AND iv.ivid = cpd.idtransaksi )
	WHEN "OM" THEN (SELECT t.ttgl FROM m2_transaksi t WHERE t.tid = cpd.idtransaksi AND t.tsumber = 'OM' )
	WHEN "TU" THEN (SELECT t.ttgl FROM m2_transaksi t WHERE t.tid = cpd.idtransaksi AND t.tsumber = 'TU' )
	WHEN "HD" THEN (SELECT t.ttgl FROM m2_transaksi t WHERE t.tid = cpd.idtransaksi AND t.tsumber = 'HD' )
	WHEN "SR" THEN (SELECT sr.srtgl FROM m5_sr sr WHERE sr.srid = cpd.idtransaksi AND sr.srsumber = cpd.sumber )
	WHEN "AE" THEN (SELECT ae.aetgl FROM m5_ae ae WHERE ae.aeid = cpd.idtransaksi AND ae.aesumber = cpd.sumber)
	WHEN "SU" THEN (SELECT sa.satgl FROM m2_sa_hutangpiutang sa WHERE sa.said = cpd.idtransaksi AND sa.sasumber = cpd.sumber )
END) AS ttgl,
cpd.sumber,
cpd.matauang,
cpd.kurs,
cpd.terbayar,
cpd.jmlbayar,
cpd.jmlbayarvalas,
cpd.diskontermin,
cpd.rekhutangpiutang,
cpd.nogiro,
cpd.catatan
FROM
m5_cp cp
JOIN m5_cp_detail cpd ON cp.cpid = cpd.idcp
JOIN m1_kontak kc ON cp.cpcustomer = kc.kid
LEFT JOIN m1_kontak ks ON cp.cpidsales = ks.kid
LEFT JOIN m5_pp_detail ppd ON cpd.idppdetail = ppd.idppdetail
ORDER BY cp.cpnotransaksi, cpd.urutan</SqlCommand>
      </DS1>
    </DataSources>
    <Relations isList="true" count="0"/>
    <Report isRef="0"/>
    <Variables isList="true" count="0"/>
