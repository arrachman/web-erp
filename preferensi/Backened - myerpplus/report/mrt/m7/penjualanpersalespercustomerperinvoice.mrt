    <DataSources isList="true" count="1">
      <DS1 isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="3">
        <Alias>DS1</Alias>
        <Columns isList="true" count="10">
          <value>ivcustomer,System.Int32</value>
          <value>ivbagianpenjualan,System.Int32</value>
          <value>customer,System.String</value>
          <value>kkode,System.String</value>
          <value>sales,System.String</value>
          <value>ivtgl,System.DateTime</value>
          <value>ivnotransaksi,System.String</value>
          <value>ivmatauang,System.String</value>
          <value>ivtotaltransaksi,System.Decimal</value>
          <value>ivbayar,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT

iv.ivcustomer , iv.ivbagianpenjualan , 

k1.knama AS customer,
k2.kkode, 
k2.knama AS sales, 
iv.ivtgl , 
iv.ivnotransaksi , 
iv.ivmatauang, 
iv.ivtotaltransaksi , 
iv.ivbayar 

FROM
m5_iv iv
JOIN m1_kontak k1 ON iv.ivcustomer = k1.kid
JOIN m1_kontak k2 ON iv.ivbagianpenjualan = k2.kid 



ORDER BY iv.ivbagianpenjualan  , iv.ivcustomer , iv.ivnotransaksi

limit 20</SqlCommand>
      </DS1>
    </DataSources>
