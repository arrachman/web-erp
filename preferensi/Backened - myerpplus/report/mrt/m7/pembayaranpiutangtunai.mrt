E6X4SwSkI4ZU2QhPFruIQVo=</ConnectionStringEncrypted>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="1">
      <DS1 isKey="true" Ref="3" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>DS1</Alias>
        <Columns isList="true" count="9">
          <value>cpnotransaksi,System.String</value>
          <value>cptgl,System.DateTime</value>
          <value>knama,System.String</value>
          <value>rekhutangpiutang,System.String</value>
          <value>sumber,System.String</value>
          <value>catatan,System.String</value>
          <value>cpmatauang,System.String</value>
          <value>asjmlbayar,System.String</value>
          <value>urutan,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
cp.cpnotransaksi,
cp.cptgl,
kc.knama,
cpd.rekhutangpiutang,
cpd.sumber,
cpd.catatan,
cp.cpmatauang,
(CASE cpd.sumber
WHEN 'IV' THEN 
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) = '-' THEN REPLACE(cpd.jmlbayar,"-","")
	ELSE cpd.jmlbayar
	END
WHEN 'SU' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) = '-' THEN REPLACE(cpd.jmlbayar,"-","")
	ELSE cpd.jmlbayar
	END
WHEN 'OM' THEN 
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) = '-' THEN REPLACE(cpd.jmlbayar,"-","")
	ELSE cpd.jmlbayar
	END	
WHEN 'HD' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'SR' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'AE' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'TU' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'CA' THEN cpd.jmlbayar
END )AS asjmlbayar,
cpd.urutan
FROM m5_cp cp
JOIN m5_cp_detail cpd ON cp.cpid = cpd.idcp
JOIN m1_kontak kc ON cp.cpcustomer = kc.kid
WHERE ( cp.cpcarabayar &lt;&gt; 1 OR cp.cpcarabayar &lt;&gt; 2 )
ORDER BY cp.cpnotransaksi, cpd.urutan 
limit 20</SqlCommand>
      </DS1>
    </DataSources>
    <Relations isList="true" count="0"/>
    <Report isRef="0"/>
    <Variables isList="true" count="0"/>
  </Dictionary>
