      <DS1 isKey="true" Ref="3" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>DS1</Alias>
        <Columns isList="true" count="19">
          <value>cpnotransaksi,System.String</value>
          <value>cptgl,System.DateTime</value>
          <value>knama,System.String</value>
          <value>cpcatatan,System.String</value>
          <value>carabayar,System.String</value>
          <value>cptglbayar,System.DateTime</value>
          <value>cpmatauang,System.String</value>
          <value>cpkurs,System.Decimal</value>
          <value>cptotalap,System.Decimal</value>
          <value>cptotalar,System.Decimal</value>
          <value>srnotransaksi,System.String</value>
          <value>srtgl,System.DateTime</value>
          <value>srmatauang,System.String</value>
          <value>srkurs,System.Decimal</value>
          <value>srtotaltransaksi,System.Decimal</value>
          <value>terbayar,System.Decimal</value>
          <value>jmlbayar,System.Decimal</value>
          <value>jmlbayarvalas,System.Decimal</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT 
cp.cpnotransaksi,
cp.cptgl,
kc.knama,
cp.cpcatatan,
(CASE cp.cpcarabayar
WHEN 0 THEN 'Cash'
WHEN 1 THEN 'Transfer'
WHEN 2 THEN 'Cek/Giro'
ELSE 'Lain-lain'
END) AS carabayar,
cp.cptglbayar,
cp.cpmatauang,
cp.cpkurs,
cp.cptotalap,
cp.cptotalar,
sr.srnotransaksi,
sr.srtgl,
sr.srmatauang,
sr.srkurs,
sr.srtotaltransaksi,
cpd.terbayar,
cpd.jmlbayar,
cpd.jmlbayarvalas,
cpd.catatan
FROM
m5_cp cp
JOIN m5_cp_detail cpd ON cp.cpid = cpd.idcp
JOIN m1_kontak kc ON cp.cpcustomer = kc.kid
LEFT JOIN m1_kontak ks ON cp.cpidsales = ks.kid
LEFT JOIN m5_sr sr ON cpd.idtransaksi = sr.srid
WHERE cpd.sumber = 'SR'
GROUP BY cp.cpnotransaksi, sr.srnotransaksi
ORDER BY cp.cpnotransaksi, sr.srnotransaksi, cpd.urutan</SqlCommand>
      </DS1>
    </DataSources>
    <Relations isList="true" count="0"/>
    <Report isRef="0"/>
    <Variables isList="true" count="0"/>
