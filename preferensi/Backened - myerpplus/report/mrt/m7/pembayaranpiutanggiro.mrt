    <DataSources isList="true" count="3">
      <DS1 isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="3">
        <Alias>DS1</Alias>
        <Columns isList="true" count="8">
          <value>cpnotransaksi,System.String</value>
          <value>cptgl,System.DateTime</value>
          <value>knama,System.String</value>
          <value>rekhutangpiutang,System.String</value>
          <value>sumber,System.String</value>
          <value>catatan,System.String</value>
          <value>cpmatauang,System.String</value>
          <value>asjmlbayar,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS1</Name>
        <NameInSource>myerpplus1</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	cp.cpnotransaksi,
	cp.cptgl,
	kc.knama,
	cpd.rekhutangpiutang,
	cpd.sumber,
	cpd.catatan,
	cp.cpmatauang,
	(CASE cpd.sumber
WHEN 'IV' THEN 
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) = '-' THEN REPLACE(cpd.jmlbayar,"-","")
	ELSE cpd.jmlbayar
	END
WHEN 'SU' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) = '-' THEN REPLACE(cpd.jmlbayar,"-","")
	ELSE cpd.jmlbayar
	END
WHEN 'OM' THEN 
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) = '-' THEN REPLACE(cpd.jmlbayar,"-","")
	ELSE cpd.jmlbayar
	END	
WHEN 'HD' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'SR' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'AE' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'TU' THEN
	CASE 
	WHEN LEFT(cpd.jmlbayar,1) &lt;&gt; '-' THEN CONCAT('-', cpd.jmlbayar)
	ELSE cpd.jmlbayar
	END
WHEN 'CA' THEN cpd.jmlbayar
END )AS asjmlbayar
FROM m5_cp cp
JOIN m5_cp_detail cpd ON cp.cpid = cpd.idcp
JOIN m1_kontak kc ON cp.cpcustomer = kc.kid

ORDER BY cp.cpnotransaksi, cpd.urutan

limit 20</SqlCommand>
      </DS1>
      <DS3 isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="4">
        <Alias>DS3</Alias>
        <Columns isList="true" count="7">
          <value>dgbanknama,System.String</value>
          <value>dgnogiro,System.String</value>
          <value>dgjumlah,System.Decimal</value>
          <value>knama,System.String</value>
          <value>dgtgljthtempo,System.DateTime</value>
          <value>cpnotransaksi,System.String</value>
          <value>cptotalap,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>DS3</Name>
        <NameInSource>myerpplus1</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT 
	dg.dgbanknama, 
	dg.dgnogiro, 
	dg.dgjumlah, 
	kc.knama,
	dg.dgtgljthtempo,  
	cp.cpnotransaksi, 
	cp.cptotalap 
	FROM m5_cp cp 
JOIN m5_cp_detail cpd ON cp.cpid = cpd.idcp 
JOIN m1_kontak kc ON cp.cpcustomer = kc.kid
LEFT JOIN v_m2_daftar_giro dg ON cpd.nogiro = dg.dgrekgiro 
WHERE (cp.cpcarabayar = 2 OR cp.cpcarabayar = 1) and cp.cpnotransaksi = "SCP13030004"
ORDER BY cp.cpnotransaksi, cpd.urutan, dg.dgurutan</SqlCommand>
      </DS3>
