<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_pci2021</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="26">
          <value>kkode,System.String</value>
          <value>knama,System.String</value>
          <value>soid,System.Int64</value>
          <value>sonotransaksi,System.String</value>
          <value>sotgl,System.DateTime</value>
          <value>sotglkirim,System.DateTime</value>
          <value>idbarang,System.Int64</value>
          <value>jmlbarang,System.Double</value>
          <value>satuan,System.String</value>
          <value>mesin,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>prodstartdate,System.DateTime</value>
          <value>prodcompletedate,System.DateTime</value>
          <value>customtext10,System.String</value>
          <value>jmlpdwip,System.Double</value>
          <value>jmlpdfg,System.Double</value>
          <value>bowip,System.Double</value>
          <value>bofg,System.Double</value>
          <value>kcatatan,System.String</value>
          <value>bsatuan,System.String</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>bkelasproduk,System.String</value>
          <value>bkelasproduknama,System.String</value>
          <value>jmlplan,System.Double</value>
          <value>blmplan,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	c.kkode,
	c.knama,
	so.soid,
	so.sonotransaksi,
	so.sotgl,
	so.sotglkirim,
	sod.idbarang,
	sod.jmlbarang,
	sod.satuan,
	pdp.mesin,
	pdp.tgl,
	MIN(pdp.tgl) as prodstartdate,
	MAX(pdp.tgl) as prodcompletedate,
	pdp.customtext10,
	SUM(
	CASE WHEN pd.pdcustomtext2 &lt;&gt; 'FG'
THEN pdi.jmlbarang
ELSE 0
END) as jmlpdwip,
SUM(
CASE pd.pdcustomtext2
WHEN 'FG' THEN pdi.jmlbarang
ELSE 0
END) as jmlpdfg,
sod.jmlbarang - SUM(
CASE WHEN pd.pdcustomtext2 &lt;&gt; 'FG'
THEN pdi.jmlbarang
ELSE 0
END) as bowip,
sod.jmlbarang - SUM(
CASE pd.pdcustomtext2
WHEN 'FG' THEN pdi.jmlbarang
ELSE 0
END) as bofg,
c.kcatatan,
i.bsatuan,
i.bkode,
i.bnama,
i.bkelasproduk,
cp.cpnama as bkelasproduknama,
IFNULL(dttgl.jmlplan,0) as jmlplan,
sod.jmlbarang - IFNULL(dttgl.jmlplan,0) as blmplan
from
m5_so so
JOIN m1_contact c ON so.socustomer = c.kid
JOIN m1_contact c2 ON so.sobagianpenjualan = c2.kid
JOIN m5_so_production sod ON so.soid = sod.idso
AND so.sostatus IN(2,3)
JOIN m1_item i ON sod.idbarang = i.bid
LEFT JOIN m6_production_planning pdp ON so.soid = pdp.idsodetail AND sod.idbarang = pdp.idbarang
LEFT JOIN m6_pd pd ON pdp.customtext10 = pd.pdcustomtext1 AND pd.pdstatus IN(2,3,4,7)
LEFT JOIN m6_pd_in pdi ON pd.pdid = pdi.idpd
LEFT JOIN m5_sf sf on so.socustomdbl1 = sf.sfid
LEFT JOIN m1_class_product cp ON i.bkelasproduk = cp.cpkode
LEFT JOIN (
SELECT idsodetail, idbarang, max(tgl) as maxtgl, min(tgl) as mintgl, SUM(jmlbarang) as jmlplan FROM m6_production_planning
	GROUP BY idsodetail, idbarang
) as dttgl ON so.soid = dttgl.idsodetail AND sod.idbarang = dttgl.idbarang
WHERE so.soid = 7033
group by c.kkode, so.sotgl, so.soid, i.bkode
order by c.kkode, so.sotgl, so.soid, i.bkode</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
