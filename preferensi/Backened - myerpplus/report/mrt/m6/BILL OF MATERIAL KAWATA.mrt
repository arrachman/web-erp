              <Name>Text13</Name>
              <Page isRef="8" />
              <Parent isRef="10" />
              <Text>{IIF((DS1.jml) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.jml) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.jml))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal)
,"-","")), Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.jml))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal))
}{IIF((DS1.jml) &lt; 0 ,formatMinus.kanan,"")}</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
