        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>/*
produksi sing sumber e PD, jenismutasi = 1
penjualan sing sumb e SI, jenismutasi = 0

Produksi 	= ambil total produksi dari transaksi barang perbulan
Penjualan	= ambil total penjualan dari transaksi barang perbulan
*/

SELECT

	it.tgl , 
	it.idbarang , 
	b.bkode , 
	b.bnama, 
	CASE it.sumber 
		WHEN "PD" THEN "Produksi"
		WHEN "SI" THEN "Penjualan"
	END AS sumber , 
	it.jenismutasi , 
	IFNULL(SUM(it.jmlbarang * b.baberat) / 1000,0) as jmlbarang ,
	YEAR(it.tgl) as tahun  , 
	MONTH(it.tgl) as bulan 

	FROM m1_item_transaction it 
JOIN m1_item b ON it.idbarang = b.bid

WHERE ((it.sumber = "PD" AND it.jenismutasi = 1) OR (it.sumber = "SI" AND it.jenismutasi = 0 )) AND (it.idbarang BETWEEN 1 AND 2 ) AND (YEAR(it.tgl) = 2014 )
GROUP BY it.sumber ASC, MONTH(it.tgl) ASC
ORDER BY it.sumber ASC, MONTH(it.tgl) ASC</SqlCommand>
      </DS2>
