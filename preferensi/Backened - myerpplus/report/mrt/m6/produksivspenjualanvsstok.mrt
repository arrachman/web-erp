          <value>pvpcustomdbl2,System.Double</value>
          <value>pvpcustomdbl3,System.Double</value>
          <value>pvpcustomdbl4,System.Double</value>
          <value>pvpcustomdbl5,System.Double</value>
          <value>pvpcustomdate1,System.DateTime</value>
          <value>pvpcustomdate2,System.DateTime</value>
          <value>pvpcustomdate3,System.DateTime</value>
          <value>pvpcustomdate4,System.DateTime</value>
          <value>pvpcustomdate5,System.DateTime</value>
          <value>pvptahun,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT pvp.idlogin, pvp.pvptahun, pvp.pvpidbarang, CONCAT(i.bnamaalias1, '') as pvpkodebarang, pvp.pvpurutan, pvp.pvpketerangan, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpjan WHEN pvp.pvptahun = YEAR(NOW()) AND 1 &lt;= MONTH(NOW()) THEN pvp.pvpjan ELSE 0 END) as pvpjan, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpfeb WHEN pvp.pvptahun = YEAR(NOW()) AND 2 &lt;= MONTH(NOW()) THEN pvp.pvpfeb ELSE 0 END) as pvpfeb, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpmar WHEN pvp.pvptahun = YEAR(NOW()) AND 3 &lt;= MONTH(NOW()) THEN pvp.pvpmar ELSE 0 END) as pvpmar, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpapr WHEN pvp.pvptahun = YEAR(NOW()) AND 4 &lt;= MONTH(NOW()) THEN pvp.pvpapr ELSE 0 END) as pvpapr, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpmei WHEN pvp.pvptahun = YEAR(NOW()) AND 5 &lt;= MONTH(NOW()) THEN pvp.pvpmei ELSE 0 END) as pvpmei, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpjun WHEN pvp.pvptahun = YEAR(NOW()) AND 6 &lt;= MONTH(NOW()) THEN pvp.pvpjun ELSE 0 END) as pvpjun, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpjul WHEN pvp.pvptahun = YEAR(NOW()) AND 7 &lt;= MONTH(NOW()) THEN pvp.pvpjul ELSE 0 END) as pvpjul, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpagu WHEN pvp.pvptahun = YEAR(NOW()) AND 8 &lt;= MONTH(NOW()) THEN pvp.pvpagu ELSE 0 END) as pvpagu, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpsep WHEN pvp.pvptahun = YEAR(NOW()) AND 9 &lt;= MONTH(NOW()) THEN pvp.pvpsep ELSE 0 END) as pvpsep, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpokt WHEN pvp.pvptahun = YEAR(NOW()) AND 10 &lt;= MONTH(NOW()) THEN pvp.pvpokt ELSE 0 END) as pvpokt, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpnov WHEN pvp.pvptahun = YEAR(NOW()) AND 11 &lt;= MONTH(NOW()) THEN pvp.pvpnov ELSE 0 END) as pvpnov, (CASE  WHEN pvp.pvptahun &lt; YEAR(NOW()) THEN pvp.pvpdes WHEN pvp.pvptahun = YEAR(NOW()) AND 12 &lt;= MONTH(NOW()) THEN pvp.pvpdes ELSE 0 END) as pvpdes, pvp.idmsmq, pvp.pvpuserid  FROM M2r_Produksi_Vs_Penjualan pvp JOIN m1_item i ON pvp.pvpidbarang = i.bid WHERE idlogin = '9726b207cb371659df6cdd40e0a0eb0c' AND idmsmq = '374730982da1b90d955afcede2ddfd7f' ORDER BY pvp.pvpkodebarang, pvp.pvpurutan</SqlCommand>
      </DS1>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
