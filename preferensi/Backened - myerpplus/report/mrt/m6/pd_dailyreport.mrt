              <Conditions isList="true" count="1">
                <value>Multi&lt;?xml version="1.0" encoding="utf-16" standalone="yes"?&gt;&lt;StiSerializer version="1.02" type="Net" application="State"&gt;&lt;Filters isList="true" count="2"&gt;&lt;value&gt;DS1.persentasesusut,NotEqualTo,_x0034_.9,,Numeric&lt;/value&gt;&lt;value&gt;DS1.persentasesusut,NotEqualTo,_x0030_,,Numeric&lt;/value&gt;&lt;/Filters&gt;&lt;TextColor&gt;Red&lt;/TextColor&gt;&lt;BackColor&gt;Transparent&lt;/BackColor&gt;&lt;Font&gt;Arial, 8pt&lt;/Font&gt;&lt;Style&gt;Style1&lt;/Style&gt;&lt;BorderSides&gt;None&lt;/BorderSides&gt;&lt;/StiSerializer&gt;</value>
