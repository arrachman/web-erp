<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_pci_utama</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="30">
          <value>kkode,System.String</value>
          <value>knama,System.String</value>
          <value>kcatatan,System.String</value>
          <value>soid,System.Int64</value>
          <value>sonotransaksi,System.String</value>
          <value>sotgl,System.DateTime</value>
          <value>sotglkirim,System.DateTime</value>
          <value>idbarang,System.Int64</value>
          <value>kodebarangSO,System.String</value>
          <value>namabarangSO,System.String</value>
          <value>satuanbarangSO,System.String</value>
          <value>jmlso,System.Double</value>
          <value>satuanso,System.String</value>
          <value>pdpmesin,System.String</value>
          <value>pdptgl,System.DateTime</value>
          <value>pdpstartdate,System.DateTime</value>
          <value>pdpcompletedate,System.DateTime</value>
          <value>pdpjml,System.Double</value>
          <value>pdproutecard,System.String</value>
          <value>pdtgl,System.DateTime</value>
          <value>pdnotransaksi,System.String</value>
          <value>pdjenis,System.String</value>
          <value>pdroutecard,System.String</value>
          <value>tungku,System.String</value>
          <value>pdidbarang,System.Int64</value>
          <value>pdkodebarang,System.String</value>
          <value>pdnamabarang,System.String</value>
          <value>pdjml,System.Double</value>
          <value>jmlbahan,System.Double</value>
          <value>persentasesusut,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT c.kkode, 	IFNULL(c.knama, pd.pdcustomtext4) as knama, 	c.kcatatan, 	so.soid, 	IFNULL(so.sonotransaksi,pd.pdnoref) as sonotransaksi, 	so.sotgl, 	so.sotglkirim, 	
	sod.idbarang, 	i.bkode as kodebarangSO,  	i.bnama as namabarangSO, 	i.bsatuan as satuanbarangSO, 	sod.jmlbarang as jmlso, 	sod.satuan as satuanso, 	pdp.mesin as pdpmesin, 	
	pdp.tgl as pdptgl, 	dttgl.mintgl as pdpstartdate, 	dttgl.maxtgl as pdpcompletedate, 	pdp.jml as pdpjml, 	IFNULL(pdp.customtext10, pd.pdcustomtext1) as pdproutecard, 	
	pd.pdtgl AS pdtgl, 	pd.pdnotransaksi AS pdnotransaksi, 	pd.pdcustomtext2 AS pdjenis, 	pd.pdcustomtext1 as pdroutecard, pd.pdcustomtext3 as tungku, 	ip.bid AS pdidbarang, 	
	ip.bkode AS pdkodebarang, 	ip.bnama AS pdnamabarang, 	pdi.jmlbarang as pdjml, pdout.jmlbarang as jmlbahan, 
	ROUND(100-(pdi.jmlbarang/pdout.jmlbarang*100),5) AS persentasesusut
	FROM m6_pd pd 
JOIN m6_pd_in pdi ON pd.pdid = pdi.idpd AND pd.pdstatus IN(2,3,4,7) 
JOIN m1_item ip ON pdi.idbarang = ip.bid 
JOIN m6_pd_out pdout ON pd.pdid = pdout.idpd AND pdout.jmlbarang &gt; 0
JOIN m1_item ib ON pdout.idbarang = ib.bid AND ib.bjenis = 'P'
LEFT JOIN m6_production_planning pdp ON pd.pdcustomtext1 = pdp.customtext10 
LEFT JOIN m5_so_production sod ON pdp.idsodetail = sod.idso AND pdp.idbarang = sod.idbarang 
LEFT JOIN m5_so so ON sod.idso = so.soid 
LEFT JOIN m1_contact c ON so.socustomer = c.kid 
LEFT JOIN m1_item i ON sod.idbarang = i.bid 
LEFT JOIN 
( SELECT idsodetail, idbarang, max(tgl) as maxtgl, min(tgl) as mintgl FROM m6_production_planning 	GROUP BY idsodetail, idbarang ) as dttgl 
ON so.soid = dttgl.idsodetail AND sod.idbarang = dttgl.idbarang  
WHERE  (pd.pdtgl BETWEEN '2023-09-11' AND '2023-09-11') 
GROUP BY pd.pdcustomtext3, pd.pdtgl, pd.pdnotransaksi, c.kkode, so.sotgl, i.bkode, pdp.idpdpdetail, pd.pdid, pdi.idpdin 
ORDER BY pd.pdcustomtext3, pd.pdtgl, pd.pdnotransaksi, c.kkode, so.sotgl, i.bkode, pdp.idpdpdetail, pd.pdid, pdi.idpdin</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
