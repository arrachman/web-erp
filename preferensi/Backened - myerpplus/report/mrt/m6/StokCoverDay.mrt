      </myerpplus>
    </Databases>
    <DataSources isList="true" count="10">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="8">
          <value>idbarang,System.Int64</value>
          <value>bid,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>kgudang,System.String</value>
          <value>gudang,System.String</value>
          <value>stok,System.Double</value>
          <value>bsatuan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	iw.idbarang, 
	b.bid , 
	b.bkode , 
	b.bnama , 
	iw.kgudang, 
	w.wnama AS gudang , 
	iw.stok , 
	b.bsatuan 

	FROM m1_item_stock_warehouse iw
JOIN m1_item b ON iw.idbarang = b.bid 
JOIN m1_warehouse w ON iw.kgudang = w.wkode

ORDER BY iw.idbarang , iw.kgudang</SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>logo</Alias>
        <Columns isList="true" count="1">
          <value>snilai,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>logo</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai 
	
	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "LogoPerusahaan"</SqlCommand>
