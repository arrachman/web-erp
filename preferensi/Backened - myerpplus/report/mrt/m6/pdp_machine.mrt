<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_pci2021</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="29">
          <value>mesin,System.String</value>
          <value>mesinnama,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>kelas,System.String</value>
          <value>kelasnama,System.String</value>
          <value>subkelas,System.String</value>
          <value>subkelasnama,System.String</value>
          <value>norc,System.String</value>
          <value>sonotransaksi,System.String</value>
          <value>sotgl,System.DateTime</value>
          <value>sotglkirim,System.DateTime</value>
          <value>socustomer,System.Int64</value>
          <value>socustomerkode,System.String</value>
          <value>socustomernama,System.String</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>jmlpcs,System.Double</value>
          <value>satuan,System.String</value>
          <value>jmljam,System.Double</value>
          <value>kadar,System.String</value>
          <value>ukuran,System.String</value>
          <value>panjang,System.Double</value>
          <value>jmlbr1,System.Double</value>
          <value>jmlpcsbr1,System.Double</value>
          <value>jmlfg,System.Double</value>
          <value>jmlpcsfg,System.Double</value>
          <value>jmlfs,System.Double</value>
          <value>jmlpcsfs,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT pp.mesin, m.mnama AS mesinnama, pp.tgl, pp.kelas, cl.cnama AS kelasnama, pp.subkelas, sc.scnama AS subkelasnama, pp.customtext10 AS norc, so.sonotransaksi, so.sotgl, so.sotglkirim, so.socustomer, c.kkode AS socustomerkode, c.knama AS socustomernama, i.bkode, i.bnama, pp.jml, CEIL(pp.jml/i.bjmllapangan) as jmlpcs, pp.satuan, pp.jmljam, i.baoem AS kadar, i.baukuran AS ukuran, i.bapanjang AS panjang, pd.jmlbarang as jmlbr1, pd.customdbl1 as jmlpcsbr1, fg.jmlbarang as jmlfg, fg.customdbl1 as jmlpcsfg, fs.jmlbarang as jmlfs, fs.customdbl1 as jmlpcsfs  FROM m6_production_planning pp JOIN m1_machine m ON pp.mesin = m.mkode JOIN m1_class cl ON pp.kelas = cl.ckode JOIN m1_subclass sc ON pp.subkelas = sc.sckode JOIN m1_item i ON pp.idbarang = i.bid LEFT JOIN m5_so so ON pp.idsodetail = so.soid LEFT JOIN m1_contact c ON so.socustomer = c.kid LEFT JOIN ( SELECT pd.pdcustomtext1, pdi.jmlbarang, pdi.customdbl1 FROM m6_pd pd JOIN m6_pd_in pdi ON pd.pdid = pdi.idpd AND pd.pdstatus IN(2,3,4,7) AND pd.pdcustomtext2 = 'WIP1' ) as pd ON pp.customtext10 = pd.pdcustomtext1 LEFT JOIN ( SELECT pd.pdcustomtext1, pdi.jmlbarang, pdi.customdbl1 FROM m6_pd pd JOIN m6_pd_in pdi ON pd.pdid = pdi.idpd AND pd.pdstatus IN(2,3,4,7) AND pd.pdcustomtext2 = 'FG' ) as fg ON pp.customtext10 = fg.pdcustomtext1 LEFT JOIN ( SELECT pd.pdcustomtext1, pdi.jmlbarang, pdi.customdbl1 FROM m6_pd pd JOIN m6_pd_in pdi ON pd.pdid = pdi.idpd AND pd.pdstatus IN(2,3,4,7) AND pd.pdcustomtext2 = 'FS' ) as fs ON pp.customtext10 = fs.pdcustomtext1 WHERE  (pp.tgl BETWEEN '2021-03-06' AND '2021-03-06') ORDER BY pp.mesin, pp.tgl, pp.urutan, pp.kelas, pp.subkelas, so.sonotransaksi, i.bkode</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
