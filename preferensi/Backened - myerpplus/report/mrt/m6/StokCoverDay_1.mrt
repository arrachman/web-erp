      <DS2 Ref="12" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="14">
          <value>idbarang,System.Int64</value>
          <value>bid,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>periode,System.Int64</value>
          <value>avg,System.Double</value>
          <value>kgudang,System.String</value>
          <value>gudang,System.String</value>
          <value>stok,System.Double</value>
          <value>bsatuan,System.String</value>
          <value>idpd,System.Int64</value>
          <value>pdid,System.Int64</value>
          <value>pdtgl,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	iw.idbarang, 
	b.bid , 
	b.bkode , 
	b.bnama , 
	IFNULL(SUM(pdo.jml) * 1 ,0) AS jml, 
	COUNT(DISTINCT pd.pdtgl) periode , 


	IFNULL((SUM(pdo.jml) * 1) / COUNT(DISTINCT pd.pdtgl),0) AS avg, 

	iw.kgudang, 
	w.wnama AS gudang , 
	iw.stok , 	
	b.bsatuan , 


pdo.idpd , 
pd.pdid , 
pd.pdtgl 

FROM m1_item_stock_warehouse iw
JOIN m1_item b ON iw.idbarang = b.bid 
JOIN m1_warehouse w ON iw.kgudang = w.wkode


LEFT JOIN m6_pd_out pdo ON iw.idbarang = pdo.idbarang 
LEFT JOIN m6_pd pd ON pdo.idpd = pd.pdid AND (pd.pdstatus = 2 OR pd.pdstatus = 3 OR pd.pdstatus = 4 OR pd.pdstatus = 7 )

WHERE (iw.idbarang BETWEEN 1 and 5) AND (iw.stok &lt;&gt; 0 ) 

GROUP BY iw.idbarang 
ORDER BY iw.idbarang </SqlCommand>
      </DS2>
