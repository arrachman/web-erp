    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="7">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="8">
          <value>bid,System.Int64</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>bomstatus,System.Int16</value>
          <value>bomtgl,System.DateTime</value>
          <value>bomnotransaksi,System.String</value>
          <value>bominputuser,System.Decimal</value>
          <value>knama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT bid, bkode, namabarang  , bomstatus , bomtgl, bomnotransaksi, bominputuser, knama 

FROM (SELECT b.bid, b.bkode, bomin.namabarang , bom.bomstatus , bom.bomtgl, bom.bomnotransaksi, bom.bominputuser, k.knama 	
	FROM m6_bom_in bomin   
JOIN m6_bom bom ON bomin.idbom = bom.bomid 
JOIN m1_item b ON bomin.idbarang = b.bid   
JOIN m1_contact k ON bom.bompembuat = k.kid  

UNION    
SELECT bb.bid,  bb.bkode , bomout.namabarang , bom.bomstatus , bom.bomtgl, bom.bomnotransaksi, bom.bominputuser, k.knama 	
	FROM m6_bom_out bomout   
JOIN m6_bom bom ON bomout.idbom = bom.bomid 
JOIN m1_item bb ON bomout.idbarang = bb.bid 
JOIN m1_contact k ON bom.bompembuat = k.kid  ) as a   

WHERE (bkode BETWEEN "ACM-- D-195D3" AND "ACM-- D-195D3") 
AND (namabarang BETWEEN "CRANK METAL 0.75 (G)" AND "CRANK METAL 0.75 (G)") 
GROUP BY bid, bkode , namabarang 
ORDER BY bid, bkode , namabarang </SqlCommand>
      </DS1>
      <DS2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="10">
          <value>bid,System.Int64</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>bomnotransaksi,System.String</value>
          <value>bomtgl,System.DateTime</value>
          <value>bompembuat,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT  	b.bid , b.bkode, bomin.namabarang ,  	bom.bomnotransaksi , bom.bomtgl , 
	k.knama AS bompembuat , SUM(bomin.jml) AS jml , bomin.satuan ,  	bomin.harga, 
	(SUM(bomin.jml * bomin.harga)) AS total    	

	FROM m6_bom_in bomin  
JOIN m1_item b ON bomin.idbarang = b.bid 
JOIN m6_bom bom ON bomin.idbom = bom.bomid 
JOIN m1_contact k ON bom.bompembuat = k.kid   
WHERE (bkode BETWEEN "ACM-- D-195D3" AND "ACM-- D-195D3") 
AND (namabarang BETWEEN "CRANK METAL 0.75 (G)" AND "CRANK METAL 0.75 (G)") 

GROUP BY  b.bkode , bomin.namabarang , bomin.satuan , bomin.harga , bomin.idbom  
ORDER BY  b.bid, b.bkode , bomin.namabarang , bomin.idbom </SqlCommand>
      </DS2>
      <DS3 Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="10">
          <value>bid,System.Int64</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>bomnotransaksi,System.String</value>
          <value>bomtgl,System.DateTime</value>
          <value>bompembuat,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT  	b.bid , b.bkode, bomout.namabarang ,  	bom.bomnotransaksi , bom.bomtgl , 
	k.knama AS bompembuat , SUM(bomout.jml) AS jml  , bomout.satuan ,  	bomout.harga, (SUM(bomout.jml * bomout.harga)) AS total   	

	FROM m6_bom_out bomout  
JOIN m1_item b ON bomout.idbarang = b.bid 
JOIN m6_bom bom ON bomout.idbom = bom.bomid 
JOIN m1_contact k ON bom.bompembuat = k.kid   

WHERE (bkode BETWEEN "ACM-- D-195D3" AND "ACM-- D-195D3") 
AND (namabarang BETWEEN "CRANK METAL 0.75 (G)" AND "CRANK METAL 0.75 (G)") 
GROUP BY  b.bid, b.bkode , bomout.tipebarang, bomout.namabarang , bomout.satuan , bomout.harga, bomout.idbom  
ORDER BY  b.bid , b.bkode , bomout.tipebarang , bomout.namabarang , bomout.idbom</SqlCommand>
      </DS3>
      <formatTgl Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="9" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
