      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <formatTgl Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS1 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="12">
          <value>idbarang,System.Int64</value>
          <value>lptgl,System.DateTime</value>
          <value>bulan,System.Int64</value>
          <value>bulann,System.String</value>
          <value>RIGHT_x0028_YEAR_x0028_lp.lptgl_x0029__x002C_2_x0029_,System.String</value>
          <value>merk,System.String</value>
          <value>bkode,System.String</value>
          <value>warna,System.String</value>
          <value>namabarang,System.String</value>
          <value>hargabeli,System.Double</value>
          <value>hargajual1,System.Double</value>
          <value>customtext1,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	lpd.idbarang , 

	lp.lptgl , 
	MONTH(lp.lptgl) bulan , 
CASE MONTH(lp.lptgl)
	WHEN 1 THEN "A"
	WHEN 2 THEN "B" 
	WHEN 3 THEN "C" 
	WHEN 4 THEN "D" 
	WHEN 5 THEN "E" 
	WHEN 6 THEN "F" 
	WHEN 7 THEN "G" 
	WHEN 8 THEN "H" 
	WHEN 9 THEN "I" 
	WHEN 10 THEN "J" 
	WHEN 11 THEN "K" 
	WHEN 12 THEN "L" 
END AS bulann , 
RIGHT(YEAR(lp.lptgl),2) , 
merk.mnama as merk , 
b.bkode , 
c.cnama AS warna , 
b.bnama AS namabarang , 
lpd.hargajual1,
lpd.customtext1


FROM m_12_lp lp
JOIN m_12_lp_detail lpd ON lp.lpid = lpd.idlp
JOIN m1_item b ON lpd.idbarang = b.bid 
LEFT JOIN m1_merk merk ON b.bamerk = merk.mkode 
LEFT JOIN m1_color c ON b.bawarna = c.ckode 

ORDER BY lpd.idlpdetail  </SqlCommand>
      </DS1>
