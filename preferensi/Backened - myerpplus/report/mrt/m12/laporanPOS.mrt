              <Margins>0,0,0,0</Margins>
              <Name>Text1</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>SYARAT DAN KETENTUAN</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text1>
            <Text2 Ref="11" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,0.2,4.98,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>f03dc3a8e823482b85b929d13406816f</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text2</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>Voucher Kredit ini berlaku selambat-lambatnya 7 hari setelah tanggal dikeluarkan.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text2>
            <Text5 Ref="12" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,0.4,4.98,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>f061a22e44584d878669f0cb9bddaa95</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text5</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>Pihak Toko berhak untuk menolak Voucher ini apabila : </Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text5>
            <Text6 Ref="13" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,0.6,4.98,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>412f58d7d75a405da322a96279825a28</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text6</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>- Voucher dalam keadaan rusak, robek, basah ataupun kotor. </Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text6>
            <Text7 Ref="14" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,0.8,4.98,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>f4c52e30cac64bfc94300ec56e02ef5b</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text7</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>- Apabila terdapat tanda-tanda perubahan atau coretan pada isi Voucher Kredit ini. </Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text7>
            <Text9 Ref="15" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,1,4.98,0.39</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>f4324b98ceca4654a2cde215e3a5afb8</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text9</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>Apabila Voucher ini hilang atau tercecer harap segera lapor ke bagian Administrasi Kredit atau ke Bendahara yang mengeluarkan Voucher ini.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text9>
            <Text10 Ref="16" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,1.39,4.98,0.41</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>412f5f13be014f50af296ca433b1e165</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text10</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>Pihak Toko ataupun Bendahara tidak betanggung jawab atas penyalahgunaan Voucher yang hilang akibat kelalaian Pelanggan.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text10>
            <Text11 Ref="17" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,1.8,4.98,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>5699a25f15df46139de94d03e2d0436e</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text11</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>Pembayaran setiap bulannya tidak lebih dari tanggal 5 dan langsung pada Bendahara.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
            </Text11>
            <Text12 Ref="18" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>3.11,2,4.98,0.39</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Lao UI,9</Font>
              <GrowToHeight>True</GrowToHeight>
              <Guid>f7817d64b0c2461c9ad5621b409f3aec</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text12</Name>
              <Page isRef="8" />
              <Parent isRef="9" />
              <Text>Pihak Toko berhak melakukan pembatalan Voucher secara Sepihak, tanpa harus memberikan alasan. </Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
