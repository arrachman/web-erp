              <Page isRef="8" />
              <Parent isRef="36" />
              <Text>{IIF(SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1) &lt; 0,formatMinus.kiri,"")}{IIF(SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1) &lt; 0 ,formatMinus.kanan,"")}</Text>
