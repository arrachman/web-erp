JOIN m1_contact k ON si.sicustomer = k.kid 

	WHERE ((si.sistatus = 2) OR	(si.sistatus = 3) OR (si.sistatus = 4) OR (si.sistatus = 7) ) 
GROUP BY si.sicabang, si.silokasi, si.sitgl , si.siid , sp.carabayar , k.kcustomdbl1
ORDER BY si.sicabang, si.silokasi, si.sitgl , sp.carabayar , k.kcustomdbl1</SqlCommand>
