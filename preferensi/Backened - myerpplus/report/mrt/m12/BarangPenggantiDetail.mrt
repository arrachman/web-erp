              <Text>{IIF((DS1.sijml1) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.sijml1) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.sijml1))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal)
,"-","")), Replace(
Replace(
Replace(
Replace(
(Format(formatQty.fromat, DS1.sijml1))
,",","RB")
,".","DS")
,"RB",formatQty.digitGrup)
,"DS",formatQty.pemisahDesimal))
}{IIF((DS1.sijml1) &lt; 0 ,formatMinus.kanan,"")}</Text>
