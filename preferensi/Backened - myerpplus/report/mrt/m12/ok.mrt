            <Text26 Ref="36" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>1,0,1.8,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Microsoft Sans Serif,10</Font>
              <Guid>11030b0f74714cccb4288a2f404a31f9</Guid>
              <HorAlignment>Right</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text26</Name>
              <Page isRef="8" />
              <Parent isRef="34" />
              <Text>{IIF(SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1) &lt; 0,formatMinus.kiri,"")}{IIF(SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(SumIf(DataBand1,DS1.totaltransaksi,DS1.urutan == 1) &lt; 0 ,formatMinus.kanan,"")}</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text26>
            <Text24 Ref="37" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>4.9,0,1.8,0.2</ClientRectangle>
