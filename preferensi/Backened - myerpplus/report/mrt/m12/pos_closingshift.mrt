<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="9">
          <value>grup,System.String</value>
          <value>bnama,System.String</value>
          <value>lnama,System.String</value>
          <value>wnama,System.String</value>
          <value>sitgl,System.DateTime</value>
          <value>bkategori,System.String</value>
          <value>jml,System.Double</value>
          <value>total,System.Double</value>
          <value>jmldiskon,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	CONCAT(br.bkode, lc.lkode, si.sitgl) as grup,
	br.bnama, 
	lc.lnama,
	wh.wnama,
	si.sitgl,
	i.bkategori,
	SUM(sid.jml) as jml,
	(CASE si.sihargatermasukpajak
WHEN 0 THEN SUM((sid.jml * sid.harga) + sid.jmlpajak1 + sid.jmlpajak2)
ELSE SUM((sid.jml * sid.harga))
END) as total,
SUM(sid.jmldiskon) as jmldiskon
FROM m5_si si
JOIN m1_branch br ON si.sicabang = br.bkode
JOIN m1_location lc ON si.silokasi = lc.lkode
JOIN m1_warehouse wh ON si.sigudang = wh.wkode
JOIN m5_si_detail sid ON si.siid = sid.idsi
JOIN m1_item i ON sid.idbarang = i.bid
GROUP BY si.sicabang ASC, si.silokasi ASC, si.sigudang ASC, si.sitgl ASC, i.bkategori ASC
ORDER BY si.sicabang ASC, si.silokasi ASC, si.sigudang ASC, si.sitgl ASC, i.bkategori ASC

</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="14">
          <value>grup,System.String</value>
          <value>bnama,System.String</value>
          <value>lnama,System.String</value>
          <value>wnama,System.String</value>
          <value>sitgl,System.DateTime</value>
          <value>sijmlnota,System.Int64</value>
          <value>sijmldiskon,System.Double</value>
          <value>sibiayalain,System.Double</value>
          <value>sijmlbayar,System.Double</value>
          <value>sibayartunai,System.Double</value>
          <value>sibayarkkredit,System.Double</value>
          <value>sibayarkdebit,System.Double</value>
          <value>sibayarvoucher,System.Double</value>
          <value>sijmlkembali,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	CONCAT(br.bkode, lc.lkode, si.sitgl) as grup,
	br.bnama, 
	lc.lnama,
	wh.wnama,
	si.sitgl,
	COUNT(si.siid) as sijmlnota,
	SUM(si.sijmldiskon) as sijmldiskon,
	SUM(si.sibiayalain) as sibiayalain,
	SUM(si.sijmlbayar - si.sijmlkembali) as sijmlbayar,
	SUM(si.sibayartunai) as sibayartunai,
	SUM(si.sibayarkkredit) as sibayarkkredit,
	SUM(si.sibayarkdebit) as sibayarkdebit,
	SUM(si.sibayarvoucher) as sibayarvoucher,
	SUM(si.sijmlkembali) as sijmlkembali
	FROM m5_si si
JOIN m1_branch br ON si.sicabang = br.bkode
JOIN m1_location lc ON si.silokasi = lc.lkode
JOIN m1_warehouse wh ON si.sigudang = wh.wkode
GROUP BY si.sicabang ASC, si.silokasi ASC, si.sigudang ASC, si.sitgl ASC
ORDER BY si.sicabang ASC, si.silokasi ASC, si.sigudang ASC, si.sitgl ASC

</SqlCommand>
      </DS2>
