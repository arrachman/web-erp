    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="9">
          <value>bid,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>namalayanan,System.String</value>
          <value>lbtgl,System.DateTime</value>
          <value>tahun,System.Int32</value>
          <value>tanggal,System.Int32</value>
          <value>lbperawatan,System.String</value>
          <value>lbkategoripasien,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	b.bid , 
	b.bkode , 
	b.bnama , 
	lbd.namalayanan , 
	lb.lbtgl , 
	YEAR(lb.lbtgl) AS tahun , 
	day(lb.lbtgl) AS tanggal , 

	CASE lb.lbperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS lbperawatan , 

pc.pcnama AS lbkategoripasien 

FROM m1_item b 
LEFT JOIN m_11_lb_detail lbd ON lbd.idlayanan = b.bid
LEFT JOIN m_11_lb lb ON lbd.idlb = lb.lbid
LEFT JOIN m1_patient_category pc ON lb.lbkategoripasien = pc.pckode

WHERE b.bkategori = "Lab" AND YEAR(lb.lbtgl) = 2015 AND MONTH(lb.lbtgl) = 1

ORDER BY b.bid , day(lb.lbtgl) ASC</SqlCommand>
      </DS1>
