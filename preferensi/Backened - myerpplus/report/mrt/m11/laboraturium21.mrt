      </myerpplus>
    </Databases>
    <DataSources isList="true" count="10">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="24">
          <value>kjtgllahir,System.DateTime</value>
          <value>jml,System.Int64</value>
          <value>kjkamar,System.String</value>
          <value>kjalamat,System.String</value>
          <value>lbumur,System.String</value>
          <value>lbid,System.Int64</value>
          <value>usrenama,System.String</value>
          <value>lbnotransaksi,System.String</value>
          <value>lbtgl,System.DateTime</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjtgl,System.DateTime</value>
          <value>nama,System.String</value>
          <value>lburaian,System.String</value>
          <value>pkode,System.String</value>
          <value>pnama,System.String</value>
          <value>icnama,System.String</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>namalayanan,System.String</value>
          <value>hasil,System.String</value>
          <value>lrstandart,System.String</value>
          <value>catatan,System.String</value>
          <value>kelompok,System.Int32</value>
          <value>lbdokter,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT  
	kj.kjtgllahir , 
	CASE b.bkode
		WHEN "TROPONIN" THEN 0
	ELSE lbh.jml
END AS jml , 
lb.lbkamar AS kjkamar , 
kj.kjalamat , 
lb.lbumur AS lbumur , 
lb.lbid ,  
userrr.ukode AS usrenama ,  
lb.lbnotransaksi , lb.lbtgl ,  
lb.lbnoref AS kjnotransaksi , IFNULL(kj.kjtgl, lb.lbtgl) as kjtgl ,  
st.nama ,  lb.lburaian,
IFNULL(p.pkode, c.kkode) as pkode ,  
IFNULL(p.pnama, c.knama) as pnama ,  
ic.icnama ,  b.bkode , b.bnama , lbh.namalayanan ,  
lbh.hasil ,  lbh.standart  AS lrstandart ,   
lbh.catatan ,  lbh.kelompok   , kd.knama AS lbdokter 

FROM m_11_lb lb  
JOIN m0_status st ON lb.lbstatus = st.kode  
JOIN m0_user userrr ON lb.lbinputuser = userrr.userid 
LEFT JOIN m_11_kj kj ON lb.lbidkj = kj.kjid  
LEFT JOIN m1_patient p ON kj.kjnopasien = p.pkode 
LEFT JOIN m1_contact c ON lb.lbcustomer = c.kid 
LEFT JOIN m1_contact kd ON lb.lbdokter = kd.kkode
JOIN m_11_lb_hasil lbh ON lb.lbid = lbh.idlb  
JOIN m1_item_category ic ON lbh.jenis = ic.ickode  
LEFT JOIN m1_item b ON lbh.kelompok = b.bid 
LEFT JOIN m1_lab_result lr ON b.bkode = lr.lrkode 

WHERE (lb.lbstatus = 2 OR lb.lbstatus = 3 OR lb.lbstatus = 4 OR lb.lbstatus = 7)
ORDER BY lb.lbtgl, lb.lbid  , lb.lbnotransaksi, lbh.urutan

limit 10 </SqlCommand>
      </DS1>
