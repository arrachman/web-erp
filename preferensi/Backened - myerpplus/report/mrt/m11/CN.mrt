Replace(
(Format(formatNominal.fromat, DS1.lbtotaltransaksi))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF((DS1.lbtotaltransaksi) &lt; 0 ,formatMinus.kanan,"")}</Text>
