    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="5">
          <value>lbtgl,System.DateTime</value>
          <value>lbnotransaksi,System.String</value>
          <value>pnama,System.String</value>
          <value>lbtotaltransaksi,System.Double</value>
          <value>lbdokter,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	lb.lbtgl , 
	lb.lbnotransaksi , 
	CASE lb.lbpenjualanlangsung
	WHEN 0 THEN p.pnama 
	WHEN 1 THEN k.knama 
END AS pnama,
lb.lbtotaltransaksi , 
kd.knama AS lbdokter

FROM m_11_lb lb
LEFT JOIN m1_patient p ON p.pid = lb.lbcustomer AND lb.lbpenjualanlangsung = 0 
LEFT JOIN m1_contact k ON k.kid = lb.lbcustomer AND lb.lbpenjualanlangsung = 1 
LEFT JOIN m1_contact kd ON lb.lbdokter = kd.kkode 

ORDER BY lb.lbid 
</SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
