    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="17">
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>akkamar,System.String</value>
          <value>akcatatan,System.String</value>
          <value>aktgl,System.DateTime</value>
          <value>aknotransaksi,System.String</value>
          <value>noresep,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>akpetugas,System.String</value>
          <value>akresep,System.Double</value>
          <value>akracik,System.Double</value>
          <value>akembalase,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnopasien , 
	kj.kjnama , 
	ak.akkamar , 
	ak.akcatatan , 
	ak.aktgl , 
	ak.aknotransaksi , 
	ak.aknoref AS noresep , 

	b.bkode , 
	akd.namalayanan, 
	akd.jml , 
	akd.satuan , 
	akd.harga , 
	(akd.jml * akd.harga) AS total , 

	k.knama AS akpetugas , 

	ak.akresep , 
	ak.akracik, 
	ak.akembalase 

	FROM m_11_ak ak 
JOIN m_11_ak_detail akd ON ak.akid = akd.idak 
JOIN m_11_kj kj ON ak.akidkj = kj.kjid 

JOIN m1_item b ON akd.idlayanan = b.bid
LEFT JOIN m1_contact k ON ak.akpetugas = k.kid

ORDER BY ak.akid , ak.aktgl , akd.urutan </SqlCommand>
      </DS1>
