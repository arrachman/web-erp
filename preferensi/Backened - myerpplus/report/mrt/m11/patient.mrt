        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	p.pkode , p.pnama , p.pkategoripasiennama , p.palamat , p.pkota, p.pprovinsi , p.pnegara, p.pnotelepon , p.pnohp , p.pkeluargalain , p.pnoteleponlain

	FROM m1_patient p 
ORDER BY p.pkode </SqlCommand>
