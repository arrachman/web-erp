    <DataSources isList="true" count="8">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="16">
          <value>kjnotransaksi,System.String</value>
          <value>rmlayanan,System.String</value>
          <value>lnama,System.String</value>
          <value>pumur,System.Int32</value>
          <value>pjeniskelamin,System.String</value>
          <value>_x0031_sampai4,System.Int64</value>
          <value>_x0035_sampai14,System.Int64</value>
          <value>_x0031_5sampai24,System.Int64</value>
          <value>_x0032_5sampai44,System.Int64</value>
          <value>_x0034_5sampai64,System.Int64</value>
          <value>lebihdari65,System.Int64</value>
          <value>laki,System.Int64</value>
          <value>perempuan,System.Int64</value>
          <value>mati,System.Int64</value>
          <value>hidup,System.Int64</value>
          <value>lkode,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	l.lkode , 
	l.lnama , 
	p.pumur , p.pjeniskelamin , 


	SUM((SELECT COUNT(*)

FROM m_11_rm rms 
JOIN m1_patient ps ON rms.rmnorm = ps.pkode

WHERE (rms.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms.rmid) AND (ps.pumur BETWEEN 1 AND 4) 
)) AS "1sampai4" , 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms1 
JOIN m1_patient ps1 ON rms1.rmnorm = ps1.pkode

WHERE (rms1.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms1.rmid) AND (ps1.pumur BETWEEN 5 AND 14)
)) as "5sampai14", 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms2 
JOIN m1_patient ps2 ON rms2.rmnorm = ps2.pkode

WHERE (rms2.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms2.rmid) AND (ps2.pumur BETWEEN 15 AND 24)
)) as "15sampai24", 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms3 
JOIN m1_patient ps3 ON rms3.rmnorm = ps3.pkode

WHERE (rms3.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms3.rmid) AND (ps3.pumur BETWEEN 25 AND 44)
)) as "25sampai44", 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms4 
JOIN m1_patient ps4 ON rms4.rmnorm = ps4.pkode

WHERE (rms4.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms4.rmid) AND (ps4.pumur BETWEEN 45 AND 64)
)) as "45sampai64", 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms5 
JOIN m1_patient ps5 ON rms5.rmnorm = ps5.pkode

WHERE (rms5.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms5.rmid) AND (ps5.pumur &gt; 65)
)) as "lebihdari65" , 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms6 
JOIN m1_patient ps6 ON rms6.rmnorm = ps6.pkode

WHERE (rms6.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms6.rmid) AND (ps6.pjeniskelamin = "L") 
)) AS "laki", 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms7 
JOIN m1_patient ps7 ON rms7.rmnorm = ps7.pkode

WHERE (rms7.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms7.rmid) AND (ps7.pjeniskelamin = "P") 
)) AS "perempuan", 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms8 
JOIN m1_patient ps8 ON rms8.rmnorm = ps8.pkode

WHERE (rms8.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms8.rmid) AND (rms8.rmtindaklanjut = 2) 
)) AS "mati", 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms9 
JOIN m1_patient ps9 ON rms9.rmnorm = ps9.pkode

WHERE (rms9.rmlayanan &lt;&gt; "IMUNI") AND (rm.rmid = rms9.rmid) AND (rms9.rmkrs = 1) 
)) AS "hidup"

FROM m1_layanan l
LEFT JOIN m_11_rm rm ON rm.rmlayanan = l.lkode
LEFT JOIN m_11_kj kj ON kj.kjid = rm.rmidkj
LEFT JOIN m1_patient p ON  rm.rmnorm = p.pkode 

GROUP BY l.lkode 

ORDER BY l.lkode </SqlCommand>
      </DS1>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
