    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="16">
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>rmlayanan,System.String</value>
          <value>hidupL,System.Decimal</value>
          <value>hidupP,System.Decimal</value>
          <value>kurang48L,System.Decimal</value>
          <value>kurang48P,System.Decimal</value>
          <value>lebih48L,System.Decimal</value>
          <value>lebih48P,System.Decimal</value>
          <value>jmllamadirawat,System.Decimal</value>
          <value>jmlhariperawatan,System.Decimal</value>
          <value>kelasutama,System.Decimal</value>
          <value>kelas1,System.Decimal</value>
          <value>kelas2,System.Decimal</value>
          <value>kelas3,System.Decimal</value>
          <value>kelas4,System.Decimal</value>
          <value>tanpakelas,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	COUNT(*) , 
	rm.rmlayanan , 

	SUM((SELECT COUNT(*)

FROM m_11_rm rms 
JOIN m_11_kj kjk1 ON rms.rmidkj = kjk1.kjid

WHERE (rms.rmtindaklanjut = 1 OR rms.rmtindaklanjut = 3 OR rms.rmtindaklanjut = 7) AND (rms.rmid = rm.rmid) AND (kjk1.kjjeniskelamin = "L")
)) AS hidupL  , 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms 
JOIN m_11_kj kjk1 ON rms.rmidkj = kjk1.kjid

WHERE (rms.rmtindaklanjut = 1 OR rms.rmtindaklanjut = 3 OR rms.rmtindaklanjut = 7) AND (rms.rmid = rm.rmid) AND (kjk1.kjjeniskelamin = "P")
)) AS hidupP  ,

SUM((SELECT COUNT(*)

	FROM m_11_rm rms 
JOIN m_11_kj kjk1 ON rms.rmidkj = kjk1.kjid

WHERE rms.rmkrs = 3 AND (rms.rmid = rm.rmid) AND kjk1.kjjeniskelamin = "L"
)) AS kurang48L  ,

SUM((SELECT COUNT(*)

	FROM m_11_rm rms 
JOIN m_11_kj kjk1 ON rms.rmidkj = kjk1.kjid

WHERE rms.rmkrs = 3 AND (rms.rmid = rm.rmid) AND kjk1.kjjeniskelamin = "P"
)) AS kurang48P  ,

SUM((SELECT COUNT(*)

	FROM m_11_rm rms 
JOIN m_11_kj kjk1 ON rms.rmidkj = kjk1.kjid

WHERE rms.rmkrs = 4 AND (rms.rmid = rm.rmid) AND kjk1.kjjeniskelamin = "L"
)) AS lebih48L  ,

SUM((SELECT COUNT(*)

	FROM m_11_rm rms 
JOIN m_11_kj kjk1 ON rms.rmidkj = kjk1.kjid

WHERE rms.rmkrs = 4 AND (rms.rmid = rm.rmid) AND kjk1.kjjeniskelamin = "P"
)) AS lebih48P  , 

IFNULL(SUM((SELECT DATEDIFF(kjs2.kjtglkeluar,kjs2.kjtgl)

	FROM m_11_rm rms2
JOIN m_11_kj kjs2 ON rms2.rmidkj = kjs2.kjid 
#LEFT JOIN m_11_km kms2 on kjs2.kjkamar = kms2.kmkamar

WHERE rms2.rmid = rm.rmid 

)),0) AS jmllamadirawat , 

IFNULL(SUM((SELECT DATEDIFF(kjs2.kjtglkeluar,kjs2.kjtgl)+1

	FROM m_11_rm rms2
JOIN m_11_kj kjs2 ON rms2.rmidkj = kjs2.kjid 
#LEFT JOIN m_11_km kms2 on kjs2.kjkamar = kms2.kmkamar

WHERE rms2.rmid = rm.rmid 

)),0) AS jmlhariperawatan , 


SUM((SELECT COUNT(*)

	FROM m_11_rm rms3
JOIN m_11_kj kjs3 ON rms3.rmidkj = kjs3.kjid 
#LEFT JOIN m_11_km kms3 on kjs3.kjkamar = kms3.kmkamar

WHERE rms3.rmrehabmedik = "Kelas Utama" AND (rms3.rmid = rm.rmid)
)) as kelasutama , 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms4
JOIN m_11_kj kjs4 ON rms4.rmidkj = kjs4.kjid 
#LEFT JOIN m_11_km kms4 on kjs4.kjkamar = kms4.kmkamar

WHERE rms4.rmrehabmedik = "Kelas I" AND (rms4.rmid = rm.rmid)
)) as kelas1 , 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms5
JOIN m_11_kj kjs5 ON rms5.rmidkj = kjs5.kjid 
#LEFT JOIN m_11_km kms5 on kjs5.kjkamar = kms5.kmkamar

WHERE rms5.rmrehabmedik = "Kelas II" AND (rms5.rmid = rm.rmid)
)) as kelas2, 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms6
JOIN m_11_kj kjs6 ON rms6.rmidkj = kjs6.kjid 
#LEFT JOIN m_11_km kms6 on kjs6.kjkamar = kms6.kmkamar

WHERE rms6.rmrehabmedik = "Kelas III A" AND (rms6.rmid = rm.rmid)
)) as kelas3, 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms7
JOIN m_11_kj kjs7 ON rms7.rmidkj = kjs7.kjid 
#LEFT JOIN m_11_km kms7 on kjs7.kjkamar = kms7.kmkamar

WHERE rms7.rmrehabmedik = "Kelas III B" AND (rms7.rmid = rm.rmid)
)) as kelas4, 

SUM((SELECT COUNT(*)

	FROM m_11_rm rms8
JOIN m_11_kj kjs8 ON rms8.rmidkj = kjs8.kjid 
#LEFT JOIN m_11_km kms8 on kjs8.kjkamar = kms8.kmkamar

WHERE (rms8.rmrehabmedik &lt;&gt; "Kelas Utama" AND rms8.rmrehabmedik  &lt;&gt; "Kelas I" AND rms8.rmrehabmedik &lt;&gt; "Kelas II" AND rms8.rmrehabmedik &lt;&gt; "Kelas III A" AND rms8.rmrehabmedik &lt;&gt; "Kelas III B" ) AND (rms8.rmid = rm.rmid)
)) as tanpakelas

FROM m_11_rm rm 

WHERE rm.rmlayanan &lt;&gt; "IMUNI" AND rm.rmtgl BETWEEN "2016-02-01" AND "2016-02-29"

GROUP BY rm.rmlayanan 

ORDER BY rm.rmlayanan </SqlCommand>
      </DS1>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
