        <Dictionary isRef="1" />
        <Name>DS8</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 

	COUNT(*) , 
	l.lkode , l.lnama  

	FROM m_11_rm rm
LEFT JOIN m1_layanan l ON rm.rmlayanan = l.lkode 

WHERE rm.rmperawatan = "RI"
GROUP BY rm.rmlayanan 
ORDER BY l.lkode </SqlCommand>
      </DS8>
      <DS9 Ref="21" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS9</Alias>
        <Columns isList="true" count="9">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int32</value>
          <value>rmdiagnosa,System.String</value>
          <value>dkode,System.String</value>
          <value>dnama,System.String</value>
          <value>rmtindaklanjut,System.Int32</value>
          <value>jmlkasus,System.Decimal</value>
          <value>mati,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS9</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	CASE rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rmtgl) AS tahun , 
rmdiagnosa, 

d.dkode , d.dnama , 

rmtindaklanjut , 
SUM(jumlahdata)  as jmlkasus , 
SUM(mati) AS mati  

FROM (SELECT 

	COUNT(*) AS jumlahdata , 

	if(rmtindaklanjut  = 2,COUNT(*),0) as mati, 
	rmdiagnosa, 
	rmtindaklanjut , 
	rmperawatan , rmtgl

	FROM (SELECT 

	rm.rmdiagnosa , rm.rmtindaklanjut , rm.rmperawatan , rm.rmtgl

	FROM m_11_rm rm) as a 

GROUP BY rmdiagnosa , rmtindaklanjut 
ORDER BY rmdiagnosa) AS b 

LEFT JOIN m1_diagnosis d ON rmdiagnosa  = d.dkode 

GROUP BY rmdiagnosa
ORDER BY SUM(jumlahdata) DESC , rmdiagnosa ASC 
LIMIT 10 </SqlCommand>
      </DS9>
    </DataSources>
