      <DS4 Ref="15" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS4</Alias>
        <Columns isList="true" count="6">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int32</value>
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>rmalasan,System.String</value>
          <value>grup,System.Int16</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS4</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT


	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 

	COUNT(*) , 

	CASE rm.rmalasan 
	WHEN 1 THEN "Merasa Sembuh"
	WHEN 2 THEN "Rawat Jalan"
	WHEN 3 THEN "Sudah Rritis"
	WHEN 4 THEN "Permintaan Pasien"
	WHEN 5 THEN "Permintaan Keluarha"
	WHEN 6 THEN "Tidak Kerasaan"
	WHEN 7 THEN "Biaya"
	WHEN 8 THEN "Lain2"
END AS rmalasan , 
rm.rmalasan as grup

FROM m_11_rm rm 

GROUP BY rm.rmalasan
ORDER BY rm.rmalasan</SqlCommand>
      </DS4>
      <DS5 Ref="16" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS5</Alias>
        <Columns isList="true" count="6">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int32</value>
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>rmkrs,System.Int32</value>
          <value>rmkrsketerangan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS5</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT


	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 

	COUNT(*) , 

	rm.rmkrs , 

	CASE rm.rmkrs
	WHEN 1 THEN "Sembuh"
	WHEN 2 THEN "PAPS"
	WHEN 3 THEN "Meninggal &lt; 48 Jam"
	WHEN 4 THEN "Meninggal &gt;= 48 Jam"	
END AS rmkrsketerangan

FROM m_11_rm rm
WHERE rm.rmperawatan = "RI"
GROUP BY rm.rmkrs
ORDER BY rm.rmkrs</SqlCommand>
      </DS5>
      <DS6 Ref="17" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS6</Alias>
        <Columns isList="true" count="6">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int32</value>
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>ikode,System.String</value>
          <value>inama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS6</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT


	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 

	COUNT(*) , 
	d.ikode , d.inama

	FROM m_11_rm rm
LEFT JOIN m1_icd d ON rm.rmicd10 = d.ikode 

WHERE rm.rmperawatan = "RI" AND d.ikode &lt;&gt; ""
GROUP BY rm.rmicd10 
ORDER BY COUNT(*) DESC , rm.rmicd10 ASC
LIMIT 10 </SqlCommand>
      </DS6>
