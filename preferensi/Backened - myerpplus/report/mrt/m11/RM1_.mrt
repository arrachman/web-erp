        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 


	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 

	rm.rmtpip11, 
	rm.rmtpip12, 
	rm.rmtpip13, 
	rm.rmtpip4, 
	rm.rmtpip5 , 

	rm.rmigd21, 
	rm.rmigd22, 
