      <DS2 Ref="13" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="7">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int64</value>
          <value>grup,System.String</value>
          <value>rmrawat18,System.Int32</value>
          <value>rmok18,System.Int32</value>
          <value>rmigd18a,System.Int16</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 


	"AKLPC" as grup ,
	rm.rmrawat18 , 
	rm.rmok18 ,
	rm.rmigd18a

	FROM m_11_rm rm</SqlCommand>
      </DS2>
