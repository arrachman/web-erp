	k.kkode , k.knama , rm.rmdokter 

	FROM m1_contact k
LEFT JOIN m_11_rm rm ON k.kkode = rm.rmdokter 

WHERE k.kkategori = "D" 
GROUP BY k.kkode </SqlCommand>
