      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=wijaya</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="9">
          <value>roid,System.Int64</value>
          <value>ronotransaksi,System.String</value>
          <value>rotgl,System.DateTime</value>
          <value>ronoref,System.String</value>
          <value>kjnama,System.String</value>
          <value>total,System.Double</value>
          <value>kjperawatan,System.String</value>
          <value>kjkategoripasien,System.String</value>
          <value>rouraian,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	ro.roid , 
	ro.ronotransaksi , 
	ro.rotgl , 
	ro.ronoref , 
	kj.kjnama , 
	SUM(rod.jml * rod.harga) AS total , 

	CASE kj.kjperawatan
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan , 

pc.pcnama AS kjkategoripasien , 
ro.rouraian 


FROM m_11_ro ro 
JOIN m_11_ro_detail rod ON ro.roid = rod.idro 
JOIN m_11_kj kj ON ro.roidkj = kj.kjid 
LEFT JOIN m1_patient_category pc ON kj.kjkategoripasien = pc.pckode 

GROUP BY ro.roid
ORDER BY ro.rotgl , ro.ronotransaksi , rod.urutan </SqlCommand>
      </DS1>
