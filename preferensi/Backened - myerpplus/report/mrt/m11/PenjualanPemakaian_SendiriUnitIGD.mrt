      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_rs</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="10">
          <value>aktgl,System.DateTime</value>
          <value>aknoref,System.String</value>
          <value>aknotransaksi,System.String</value>
          <value>dimintaoleh,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	ak.aktgl , 
	ak.aknoref , 
	ak.aknotransaksi , 
	"KONTAK" AS dimintaoleh , 
	akd.namalayanan , 
	SUM(akd.jml) AS jml , akd.satuan , 
	akd.harga , 
	SUM(akd.jml * akd.harga) AS total , 
	akd.catatan 

	FROM m_11_ak ak
JOIN m_11_ak_detail akd ON ak.akid = akd.idak 

GROUP BY ak.aktgl , ak.aknoref , ak.aknotransaksi , akd.idlayanan
ORDER BY ak.aktgl , ak.aknoref , ak.aknotransaksi </SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>logo</Alias>
        <Columns isList="true" count="1">
