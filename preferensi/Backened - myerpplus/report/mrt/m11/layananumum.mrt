    <DataSources isList="true" count="12">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="17">
          <value>kjnotransaksi,System.String</value>
          <value>kjtgl,System.DateTime</value>
          <value>lunotransaksi,System.String</value>
          <value>lutgl,System.DateTime</value>
          <value>nama,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>jenis,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>diskon,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>usernama,System.String</value>
          <value>namadokter,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnotransaksi , 
	kj.kjtgl , 

	lu.lunotransaksi ,
	lu.lutgl , 
	st.nama , 
	kj.kjnopasien, 
	kj.kjnama , 

	ic.icnama AS jenis , 
	b.bkode , 
	lud.namalayanan, 

	lud.jml , 
	lud.satuan , 
	lud.diskon , 
	lud.harga , 
	((lud.jml * lud.harga) - lud.jmldiskon) AS total , 

	userr.ukode  AS usernama , 
	lud.namadokter

	FROM m_11_lu lu 

JOIN m_11_kj kj ON lu.luidkj = kj.kjid

JOIN m0_status st ON lu.lustatus = st.kode 

JOIN m_11_lu_detail lud ON lu.luid = lud.idlu
JOIN m1_item_category ic ON lud.jenis = ic.ickode 
JOIN m1_item b ON lud.idlayanan = b.bid 

JOIN m0_user userr ON lu.luinputuser = userr.userid

ORDER BY lu.luid , lud.urutan</SqlCommand>
      </DS1>
