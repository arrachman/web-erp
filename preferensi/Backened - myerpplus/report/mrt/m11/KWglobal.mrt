    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=klinik</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="7">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="11">
          <value>kwtgl,System.DateTime</value>
          <value>kwid,System.Int64</value>
          <value>kwnotransaksi,System.String</value>
          <value>jam,System.TimeSpan</value>
          <value>idtransaksi,System.Int64</value>
          <value>sumber,System.String</value>
          <value>notransaksi,System.String</value>
          <value>tgl,System.DateTime</value>
          <value>namapasien,System.String</value>
          <value>totaltransaksi,System.Double</value>
          <value>ugrup,System.Int16</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>#tgl | no. transaksi | jam | Nama pasien | total tagihan | Keterangan 

SELECT

	kw.kwtgl , 
	kw.kwid , 
	kw.kwnotransaksi , 
	TIME(kw.kwinputtgl) AS jam , 

	kwd.idtransaksi , 
	kwd.sumber , 

	CASE kwd.sumber
	WHEN "AK" THEN ak.aknotransaksi 
	WHEN "LU" THEN lu.lunotransaksi
	WHEN "KJ" THEN IFNULL(aak.aknotransaksi,llu.lunotransaksi)
END AS notransaksi , 

	CASE kwd.sumber
	WHEN "AK" THEN ak.akinputtgl 
	WHEN "LU" THEN lu.luinputtgl
	WHEN "KJ" THEN IFNULL(aak.akinputtgl,llu.luinputtgl)
END AS tgl , 

CASE (CASE kwd.sumber 
	WHEN "AK" THEN k.pnama 
	WHEN "LU" THEN kk.pnama
	WHEN "KJ" THEN IFNULL(akcont.pnama,lucont.pnama)
END) 
	WHEN "Robik" THEN (CASE kwd.sumber 
													WHEN "AK" THEN ak.akuraian
													WHEN "LU" THEN lu.luuraian
											END)
ELSE (CASE kwd.sumber 
	WHEN "AK" THEN k.pnama 
	WHEN "LU" THEN kk.pnama
	WHEN "KJ" THEN IFNULL(akcont.pnama,lucont.pnama)
END) END AS namapasien , 

kwd.totaltransaksi , 
userr.ugrup 

FROM m_11_kw kw 
JOIN m0_user userr ON kw.kwinputuser = userr.userid
JOIN m_11_kw_detail kwd ON kw.kwid = kwd.idkw 

LEFT JOIN m_11_ak ak ON kwd.idtransaksi = ak.akid AND kwd.sumber = ak.aksumber 
LEFT JOIN m_11_lu lu ON kwd.idtransaksi = lu.luid AND kwd.sumber = lu.lusumber

LEFT JOIN m1_patient k ON ak.akcustomer = k.pid
LEFT JOIN m1_patient kk ON lu.lucustomer = kk.pid

LEFT JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 
LEFT JOIN m_11_ak aak ON kj.kjid = aak.akidkj AND aak.aksumber = "AK"
LEFT JOIN m_11_lu llu ON kj.kjid = llu.luidkj AND llu.lusumber = "LU"

LEFT JOIN m1_patient akcont ON aak.akcustomer = akcont.pid
LEFT JOIN m1_patient lucont ON llu.lucustomer = lucont.pid

#WHERE kw.kwnotransaksi = "AMKW16030004" 

ORDER BY kw.kwtgl ASC , kw.kwid ASC , kwd.idkwdetail ASC </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="5">
          <value>kwid,System.Int64</value>
          <value>kwnotransaksi,System.String</value>
          <value>nama,System.String</value>
          <value>keterangan,System.String</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kw.kwid , 
	kw.kwnotransaksi , 
	pm.nama ,  
	GROUP_CONCAT(CASE kwp.carabayar 
	WHEN 0 THEN pm.nama 
	ELSE CONCAT(pm.nama,' - ',b.bnama) 
END) keterangan , 
SUM(kwp.jumlah) AS total 

FROM m_11_kw kw 
JOIN m0_user userr ON kw.kwinputuser = userr.userid
JOIN m_11_kw_pay kwp ON kw.kwid = kwp.idkw 
JOIN m0_payment_method pm ON kwp.carabayar = pm.kode 
LEFT JOIN m1_bank b ON kwp.bank = b.bkode

GROUP BY kw.kwid ASC 
ORDER BY kw.kwid ASC , kwp.carabayar ASC </SqlCommand>
      </DS2>
      <DS3 Ref="9" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="3">
          <value>nama,System.String</value>
          <value>bnama,System.String</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	pm.nama , b.bnama  , SUM(kwp.jumlah) AS total 

	FROM m_11_kw kw 
JOIN m0_user userr ON kw.kwinputuser = userr.userid
JOIN m_11_kw_pay kwp ON kw.kwid = kwp.idkw 
JOIN m0_payment_method pm ON kwp.carabayar = pm.kode 
LEFT JOIN m1_bank b ON kwp.bank = b.bkode

GROUP BY kwp.carabayar ASC , kwp.bank ASC 
ORDER BY kwp.carabayar ASC , kwp.bank ASC </SqlCommand>
      </DS3>
