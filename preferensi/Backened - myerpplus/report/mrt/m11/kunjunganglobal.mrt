    <DataSources isList="true" count="14">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="16">
          <value>kjtgl,System.DateTime</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>kjtglkeluar,System.DateTime</value>
          <value>kjtglmeninggal,System.DateTime</value>
          <value>kjcarakunjungan,System.String</value>
          <value>kjdirujukoleh,System.String</value>
          <value>kjditanggungoleh,System.String</value>
          <value>kjstatus,System.String</value>
          <value>namapasien,System.String</value>
          <value>alamatpasien,System.String</value>
          <value>keluargapasien,System.String</value>
          <value>ptgllahir,System.DateTime</value>
          <value>pjeniskelamin,System.String</value>
          <value>pnohp,System.String</value>
          <value>kjnama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjtgl, 
	kj.kjnotransaksi , 
	kj.kjnopasien, kj.kjnama, 
	kj.kjtglkeluar , 
	kj.kjtglmeninggal , 
	CASE kj.kjcarakunjungan 
	WHEN 1 THEN 'Datang Sendiri'
	WHEN 2 THEN 'Rujukan'
END AS kjcarakunjungan , 
r.rnama AS kjdirujukoleh , 
i.inama AS kjditanggungoleh , 
st.nama AS kjstatus , 

p.pnama AS namapasien , 
p.palamat AS alamatpasien , 
CONCAT(p.pkeluargalain," ",p.pnoteleponlain) AS keluargapasien,  
p.ptgllahir , 
p.pjeniskelamin , 

p.pnohp

FROM m_11_kj kj
LEFT JOIN m1_reference r ON kj.kjdirujukoleh = r.rid
LEFT JOIN m1_insurer i ON kj.kjditanggungoleh = i.iid
JOIN m0_status st ON kj.kjstatus = st.kode

LEFT JOIN m1_patient p ON kj.kjnopasien = p.pkode

ORDER BY kj.kjnotransaksi </SqlCommand>
      </DS1>
