      <DS2 Ref="12" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="11">
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>luidkj,System.Int64</value>
          <value>lunotransaksi,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>catatan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnotransaksi , 
	kj.kjnopasien, 

	lu.luidkj , 
	lu.lunotransaksi, 
	b.bkode , 
	lud.namalayanan  , 
	lud.catatan , 
	lud.jml , 
	lud.satuan , 
	lud.harga , 
	(lud.jml * lud.harga) AS total 

	FROM m_11_kj kj

LEFT JOIN m_11_lu_detail lud ON kj.kjid = lud.idkjdetail
JOIN m_11_lu lu ON lud.idlu = lu.luid 

JOIN m1_item b ON b.bid = lud.idlayanan

/*JOIN m_11_lu lu ON kj.kjid = lu.luidkj
LEFT JOIN m_11_lu_detail lud ON lu.luid = lud.idludetail */

ORDER BY kj.kjnotransaksi , lu.lunotransaksi , lud.urutan</SqlCommand>
      </DS2>
      <DS3 Ref="13" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="11">
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>kmnotransaksi,System.String</value>
          <value>kmkamar,System.String</value>
          <value>kmkasur,System.String</value>
          <value>kmcatatan,System.String</value>
          <value>kmtglmasuk,System.DateTime</value>
          <value>kmtglkeluar,System.DateTime</value>
          <value>kmjmlhari,System.Int32</value>
          <value>kmharga,System.Double</value>
          <value>kmtotaltransaksi,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnotransaksi , 
	kj.kjnopasien , 

	km.kmnotransaksi , 
	km.kmkamar , 
	km.kmkasur , 
	km.kmcatatan , 
	km.kmtglmasuk ,
	km.kmtglkeluar , 
	km.kmjmlhari, 
	km.kmharga , 
	km.kmtotaltransaksi


	FROM m_11_kj kj

JOIN m_11_km km ON kj.kjid = km.kmidkj

ORDER BY kj.kjnotransaksi , km.kmnotransaksi </SqlCommand>
      </DS3>
      <DS4 Ref="14" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS4</Alias>
        <Columns isList="true" count="10">
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>aknotransaksi,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS4</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnotransaksi , 
	kj.kjnopasien , 

	ak.aknotransaksi ,
	b.bkode , 
	akd.namalayanan , 
	akd.jml , 
	akd.satuan , 
	akd.harga , 
	(akd.jml * akd.harga) AS total , 
	akd.catatan 

	FROM m_11_kj kj

LEFT JOIN m_11_ak_detail akd ON kj.kjid = akd.idkjdetail
JOIN m_11_ak ak ON akd.idak = ak.akid

JOIN m1_item b ON akd.idlayanan = b.bid

ORDER BY kj.kjnotransaksi , ak.aknotransaksi , akd.urutan</SqlCommand>
      </DS4>
      <DS5 Ref="15" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS5</Alias>
        <Columns isList="true" count="10">
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>lbnotransaksi,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS5</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnotransaksi , 
	kj.kjnopasien , 

	lb.lbnotransaksi , 
	b.bkode , 
	lbd.namalayanan , 
	lbd.jml , 
	lbd.satuan , 
	lbd.harga , 
	(lbd.jml * lbd.harga) AS total , 
	lbd.catatan

	FROM m_11_kj kj

LEFT JOIN m_11_lb_detail lbd ON kj.kjid = lbd.idkjdetail 
JOIN m_11_lb lb ON lbd.idlb = lb.lbid

JOIN m1_item b ON lbd.idlayanan = b.bid

ORDER BY kj.kjnotransaksi , lb.lbnotransaksi , lbd.urutan</SqlCommand>
      </DS5>
      <formatTgl Ref="16" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
