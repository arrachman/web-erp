    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="18">
          <value>usrenama,System.String</value>
          <value>lbnotransaksi,System.String</value>
          <value>lbtgl,System.DateTime</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjtgl,System.DateTime</value>
          <value>nama,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>icnama,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>diskon,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>namadokter,System.String</value>
          <value>kjditanggungoleh,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	userrr.ukode AS usrenama , 
	lb.lbnotransaksi , lb.lbtgl , 
	kj.kjnotransaksi , kj.kjtgl , 
	st.nama , 
	IFNULL(p.pkode, c.kkode) as kjnopasien , 
	IFNULL(p.pnama, c.knama) as kjnama , 
	ic.icnama , 
	b.bkode , 
	lbd.namalayanan , 
	lbd.jml , 
	lbd.satuan , 
	lbd.diskon , 
	lbd.harga , 
	((lbd.jml * lbd.harga) - lbd.jmldiskon) AS total , 
	lbd.namadokter , 
	inn.inama AS kjditanggungoleh 

	FROM m_11_lb lb 
JOIN m_11_lb_detail lbd ON lb.lbid = lbd.idlb 
JOIN m0_status st ON lb.lbstatus = st.kode 
JOIN m1_item b ON lbd.idlayanan = b.bid 
JOIN m0_user userrr ON lb.lbinputuser = userrr.userid
LEFT JOIN m_11_kj kj ON lb.lbidkj = kj.kjid 
LEFT JOIN m1_patient p ON kj.kjnopasien = p.pkode
LEFT JOIN m1_item_category ic ON lbd.jenis = ic.ickode 
LEFT JOIN m1_contact c ON lb.lbcustomer = c.kid
LEFT JOIN m1_insurer inn ON kj.kjditanggungoleh = inn.iid


ORDER BY lb.lbtgl, lb.lbnotransaksi, lb.lbid , lbd.urutan </SqlCommand>
      </DS1>
