    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="15">
          <value>aknotransaksi,System.String</value>
          <value>aktgl,System.DateTime</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjtgl,System.DateTime</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>diskon,System.String</value>
          <value>total,System.Double</value>
          <value>jenis,System.String</value>
          <value>usernama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	ak.aknotransaksi , 
	ak.aktgl , 

	kj.kjnotransaksi, 
	kj.kjtgl , 
	kj.kjnopasien , 
	kj.kjnama, 
	
	b.bkode , 
	akd.namalayanan , 
	akd.jml , 
	akd.satuan , 
	akd.harga , 
	akd.diskon , 
	((akd.jml * akd.harga) - akd.jmldiskon) AS total , 
	ic.icnama AS jenis , 
	u.ukode as usernama 

	FROM m_11_ak ak
JOIN m_11_ak_detail akd ON ak.akid = akd.idak

JOIN m_11_kj kj ON akd.idkjdetail = kj.kjid

JOIN m1_item_category ic ON akd.jenis = ic.ickode
JOIN m1_item b ON akd.idlayanan = b.bid
JOIN m0_user u ON ak.akinputuser = u.userid

ORDER BY  ak.aknotransaksi , kj.kjnotransaksi </SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
