    <DataSources isList="true" count="12">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="30">
          <value>unama,System.String</value>
          <value>kjnotransaksi,System.String</value>
          <value>rmnorm,System.String</value>
          <value>kjnama,System.String</value>
          <value>rmperawatan,System.String</value>
          <value>rmkategoripasien,System.String</value>
          <value>rmtgl,System.DateTime</value>
          <value>rmnotransaksi,System.String</value>
          <value>rmstatus,System.String</value>
          <value>rmlayanan,System.String</value>
          <value>rmstatusimunisasi,System.Int32</value>
          <value>rmdokter,System.String</value>
          <value>rmkecelakaan,System.String</value>
          <value>rmkasus,System.String</value>
          <value>rmicd,System.String</value>
          <value>rmicd10,System.String</value>
          <value>rmtindaklanjut,System.String</value>
          <value>rmkrs,System.String</value>
          <value>rmcarakrs,System.String</value>
          <value>rmrujukan,System.String</value>
          <value>rmrujukandetail,System.String</value>
          <value>rmrehabmedik,System.String</value>
          <value>rmdokumen,System.String</value>
          <value>rmhamilke,System.Int32</value>
          <value>rmpersalinan,System.String</value>
          <value>rmkeadaanbayi,System.String</value>
          <value>rmjeniskelamin,System.String</value>
          <value>rmpanjang,System.Double</value>
          <value>rmberat,System.Double</value>
          <value>rmketerangan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	userr.unama , 

	kj.kjnotransaksi , 
	rm.rmnorm, kj.kjnama , 
	CASE rm.rmperawatan
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS rmperawatan , 
pc.pcnama AS rmkategoripasien , 
rm.rmtgl , 
rm.rmnotransaksi , 
st.nama AS rmstatus , 

rm.rmlayanan , 
rm.rmstatusimunisasi, 
k.knama AS rmdokter , 
acc.anama AS rmkecelakaan ,
CASE rm.rmkasus 
	WHEN 1 THEN "Baru"
	WHEN 2 THEN "Lama"
END AS rmkasus ,
icd.inama AS rmicd ,
icdd.inama AS rmicd10 , 

CASE rm.rmtindaklanjut 
	WHEN 0 THEN ""
	WHEN 1 THEN "Rujuk"
	WHEN 2 THEN "Mati"
	WHEN 3 THEN "Pulang APS"
	WHEN 4 THEN "MR"
	WHEN 5 THEN "SVK"
	WHEN 6 THEN "OK"
	WHEN 7 THEN "Sembuh"
END AS rmtindaklanjut , 

CASE rm.rmkrs 
	WHEN 0 THEN ""
	WHEN 1 THEN "Sembuh"
	WHEN 2 THEN "Belum Sembuh"
	WHEN 3 THEN "Meninggal &lt; 48 Jam"
	WHEN 4 THEN "Meninggal &gt;= 48 Jam"
END AS rmkrs, 

CASE rm.rmcarakrs 
	WHEN 0 THEN ""
	WHEN 1 THEN "Dipulangkan"
	WHEN 2 THEN "Dirujuk"
	WHEN 3 THEN "Pulang Paksa"
	WHEN 4 THEN "Lain - Lain"
END AS rmcarakrs, 

CASE rm.rmrujukan 
	WHEN 0 THEN ""
	WHEN 1 THEN "Rujukan Dari Bawah"
	WHEN 2 THEN "Dirujuk Ke Atas"
	WHEN 3 THEN "Dikembalikan Ke RS Awal"
END AS rmrujukan , 

CASE rm.rmrujukan 
	WHEN 0 THEN ""
	WHEN 1 THEN 
				(CASE rm.rmrujukandetail
							WHEN 0 THEN ""
							WHEN 1 THEN "Diterima Dari Puskesmas"			
							WHEN 2 THEN "Diterima Dari Fasilitas Kes. Lain"	
							WHEN 3 THEN "Diterima Dari RS Lain"
							WHEN 4 THEN "Dikembalikan Ke Puskesmas"
							WHEN 5 THEN "Dikembalikan Ke Fasilitas Kes. Lain"
							END) 
	WHEN 2 THEN 
					(CASE rm.rmrujukandetail
							WHEN 0 THEN ""
							WHEN 1 THEN "Pasien Rujukan"
							WHEN 2 THEN "Pasien Datang Sendiri"
							WHEN 3 THEN "Diterima Kembali"
							END)
	WHEN 3 THEN ""
END AS rmrujukandetail, 
trm.trmnama AS rmrehabmedik, 

CASE rm.rmdokumen
	WHEN 0 THEN ""
	WHEN 1 THEN "Lengkap"
	WHEN 2 THEN "Tidak Lengkap"
END AS rmdokumen , 

rm.rmhamilke , 
CASE rm.rmpersalinan	
	WHEN 0 THEN ""
	WHEN 1 THEN "CS"
	WHEN 2 THEN "Normal"
END AS rmpersalinan , 

CASE rm.rmkeadaanbayi 
	WHEN 0 THEN ""
	WHEN 1 THEN "Hidup"
	WHEN 2 THEN "Mati &lt; 7 Hari"
	WHEN 3 THEN "Mati &gt;= 1 Bln"
END AS rmkeadaanbayi , 

CASE rm.rmjeniskelamin 
	WHEN 0 THEN ""
	WHEN 1 THEN "Laki-Laki"
	WHEN 2 THEN "Perempuan"
END AS rmjeniskelamin , 
rm.rmpanjang , 
rm.rmberat, 
rm.rmketerangan 

FROM m_11_rm rm 
JOIN m_11_kj kj ON rm.rmidkj = kj.kjid
JOIN m1_patient_category pc ON rm.rmkategoripasien = pc.pckode 
JOIN m0_status st ON rm.rmstatus = st.kode
JOIN m0_user userr ON userr.userid = rm.rminputuser
LEFT JOIN m1_accident acc ON rm.rmkecelakaan = acc.akode

LEFT JOIN m1_contact k on rm.rmdokter = k.kkode 

LEFT JOIN m1_icd icd ON icd.ikode = rm.rmicd 
LEFT JOIN m1_icd icdd ON icdd.ikode = rm.rmicd10  

LEFT JOIN m1_trm trm ON rm.rmrehabmedik = trm.trmkode

ORDER BY rm.rmid </SqlCommand>
      </DS1>
