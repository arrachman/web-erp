    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_rs</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="6">
          <value>lukamar,System.String</value>
          <value>rnama,System.String</value>
          <value>luperawatan,System.String</value>
          <value>pid,System.Int64</value>
          <value>pnama,System.String</value>
          <value>palamat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	lu.lukamar , r.rnama , lu.luperawatan , 
	p.pid , 
	p.pnama , 
	p.palamat 

	FROM m_11_lu lu 
JOIN m1_patient p ON lu.lucustomer = p.pid
JOIN m1_room r ON lu.lukamar = r.rkode 

WHERE lu.luperawatan = "RI"
GROUP BY lu.lukamar ASC , lu.lucustomer ASC
ORDER BY lu.lukamar ASC , lu.lucustomer ASC</SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
