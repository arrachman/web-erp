    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=wijaya</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="7">
          <value>idlayanan,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>akperawatan,System.String</value>
          <value>akkategoripasien,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	akd.idlayanan  , 
	b.bkode , 
	b.bnama , 
	SUM(akd.jml) AS jml , 
	akd.satuan, 
	CASE ak.akperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS akperawatan , 
pc.pcnama AS akkategoripasien 

FROM m_11_ak ak 
JOIN m_11_ak_detail akd ON ak.akid = akd.idak 
JOIN m1_item b ON akd.idlayanan = b.bid 
LEFT JOIN m1_patient_category pc ON ak.akkategoripasien = pc.pckode 

GROUP BY akd.idlayanan 
ORDER BY SUM(akd.jml) DESC</SqlCommand>
      </DS1>
