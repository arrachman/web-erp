          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>kjkamar,System.String</value>
          <value>kjid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	ukode , 
	userid , 
	namauser, 
	bulan , 
	tahun , 
	SUM(tgl1) tgl1 , 
SUM(tgl2) tgl2 , 
SUM(tgl3) tgl3 , 
SUM(tgl4) tgl4 , 
SUM(tgl5) tgl5 , 
SUM(tgl6) tgl6 , 
SUM(tgl7) tgl7 , 
SUM(tgl8) tgl8 , 
SUM(tgl9) tgl9 , 
SUM(tgl10) tgl10 , 
SUM(tgl11) tgl11 , 
SUM(tgl12) tgl12 , 
SUM(tgl13) tgl13 , 
SUM(tgl14) tgl14 , 
SUM(tgl15) tgl15 , 
SUM(tgl16) tgl16 , 
SUM(tgl17) tgl17 , 
SUM(tgl18) tgl18 , 
SUM(tgl19) tgl19 , 
SUM(tgl20) tgl20 , 
SUM(tgl21) tgl21, 
SUM(tgl22) tgl22, 
SUM(tgl23) tgl23, 
SUM(tgl24) tgl24 , 
SUM(tgl25) tgl25 , 
SUM(tgl26) tgl26 , 
SUM(tgl27) tgl27 , 
SUM(tgl28) tgl28 , 
SUM(tgl29) tgl29 , 
SUM(tgl30) tgl30 , 
SUM(tgl31) tgl31 , 

	iskjenispemasangan , 
	isktgl , 
	tanggal , 
	kjnopasien , 
	kjnama , 
	kjkamar , 
	kjid 


FROM (SELECT
	k.ukode AS ukode , 
	k.userid as userid , 
	k.unama as namauser , 
	CASE DAY(isk.isktgl) 	WHEN 1 THEN 1 END AS tgl1 , 
CASE DAY(isk.isktgl) 	WHEN 2 THEN 1 END AS tgl2 , 
CASE DAY(isk.isktgl) 	WHEN 3 THEN 1 END AS tgl3 , 
CASE DAY(isk.isktgl) 	WHEN 4 THEN 1 END AS tgl4 , 
CASE DAY(isk.isktgl) 	WHEN 5 THEN 1 END AS tgl5 , 
CASE DAY(isk.isktgl) 	WHEN 6 THEN 1 END AS tgl6 , 
CASE DAY(isk.isktgl) 	WHEN 7 THEN 1 END AS tgl7 , 
CASE DAY(isk.isktgl) 	WHEN 8 THEN 1 END AS tgl8 , 
CASE DAY(isk.isktgl) 	WHEN 9 THEN 1 END AS tgl9 , 
CASE DAY(isk.isktgl) 	WHEN 10 THEN 1 END AS tgl10 , 
CASE DAY(isk.isktgl) 	WHEN 11 THEN 1 END AS tgl11 , 
CASE DAY(isk.isktgl) 	WHEN 12 THEN 1 END AS tgl12 , 
CASE DAY(isk.isktgl) 	WHEN 13 THEN 1 END AS tgl13 , 
CASE DAY(isk.isktgl) 	WHEN 14 THEN 1 END AS tgl14 , 
CASE DAY(isk.isktgl) 	WHEN 15 THEN 1 END AS tgl15 , 
CASE DAY(isk.isktgl) 	WHEN 16 THEN 1 END AS tgl16 , 
CASE DAY(isk.isktgl) 	WHEN 17 THEN 1 END AS tgl17 , 
CASE DAY(isk.isktgl) 	WHEN 18 THEN 1 END AS tgl18 , 
CASE DAY(isk.isktgl) 	WHEN 18 THEN 1 END AS tgl19 , 
CASE DAY(isk.isktgl) 	WHEN 20 THEN 1 END AS tgl20 , 
CASE DAY(isk.isktgl) 	WHEN 21 THEN 1 END AS tgl21 , 
CASE DAY(isk.isktgl) 	WHEN 22 THEN 1 END AS tgl22 , 
CASE DAY(isk.isktgl) 	WHEN 23 THEN 1 END AS tgl23 , 
CASE DAY(isk.isktgl) 	WHEN 24 THEN 1 END AS tgl24 , 
CASE DAY(isk.isktgl) 	WHEN 25 THEN 1 END AS tgl25 , 
CASE DAY(isk.isktgl) 	WHEN 26 THEN 1 END AS tgl26 , 
CASE DAY(isk.isktgl) 	WHEN 27 THEN 1 END AS tgl27 , 
CASE DAY(isk.isktgl) 	WHEN 28 THEN 1 END AS tgl28 , 
CASE DAY(isk.isktgl) 	WHEN 29 THEN 1 END AS tgl29 , 
CASE DAY(isk.isktgl) 	WHEN 30 THEN 1 END AS tgl30 , 
CASE DAY(isk.isktgl) 	WHEN 31 THEN 1 END AS tgl31 , 

isk.iskjenispemasangan , 
isk.isktgl , 
DAY(isk.isktgl) AS tanggal , 
kj.kjnopasien , 
kj.kjnama , 
r.rnama AS kjkamar , 
kj.kjid , 
MONTH(isk.isktgl) as bulan ,  
YEAR(isk.isktgl) as tahun 


FROM m_11_isk isk 
JOIN m_11_kj kj ON isk.iskidkj = kj.kjid
LEFT JOIN m1_room r ON kj.kjkamar = r.rkode 
JOIN m0_user k on isk.iskinputuser = k.userid 

GROUP BY isk.iskinputuser , MONTH(isk.isktgl) ASC , kj.kjnopasien , DAY(isk.isktgl)   
ORDER BY isk.iskinputuser ASC, MONTH(isk.isktgl) ASC , DAY(isk.isktgl) ASC) as test 

GROUP BY userid ,bulan , kjnopasien 
ORDER BY userid , bulan ASC , kjnopasien , tanggal ASC </SqlCommand>
      </DS1>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatTgl Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
