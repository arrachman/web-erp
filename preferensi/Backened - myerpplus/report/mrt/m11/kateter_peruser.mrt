    <DataSources isList="true" count="10">
      <DS2 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="13">
          <value>ukode,System.String</value>
          <value>userid,System.Int64</value>
          <value>namauser,System.String</value>
          <value>iskjenispemasangan,System.Int32</value>
          <value>isktgl,System.DateTime</value>
          <value>tanggal,System.Int32</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>kjkamar,System.String</value>
          <value>kjid,System.Int64</value>
          <value>bulan,System.Int32</value>
          <value>tahun,System.Int32</value>
          <value>iskstatus,System.Int16</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	* 

	FROM (SELECT 
	k.kkode AS ukode , 
	k.kid AS userid , 
	k.knama AS namauser , 
	isk.iskjenispemasangan , 
	isk.isktgl , 
	DAY(isk.isktgl) AS tanggal , 
	kj.kjnopasien , 
	kj.kjnama , 
	r.rnama AS kjkamar , 
	kj.kjid , 
	MONTH(isk.isktgl) as bulan , 
	YEAR(isk.isktgl) as tahun , 
	isk.iskstatus 

	FROM m_11_isk isk 
JOIN m_11_kj kj ON isk.iskidkj = kj.kjid
LEFT JOIN m1_room r ON kj.kjkamar = r.rkode 
LEFT JOIN m1_contact k ON isk.iskpetugas = k.kid AND k.kkategori = "K" 

WHERE (isk.iskjenispemasangan = 3)


ORDER BY isk.iskpetugas , isk.isktgl  , kj.kjnopasien ) AS test 

WHERE ((iskstatus = 2 ) or (iskstatus = 3 ) or (iskstatus = 4 ) or (iskstatus = 7 ))

ORDER BY userid , isktgl , kjnopasien </SqlCommand>
      </DS2>
      <DS1 Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
