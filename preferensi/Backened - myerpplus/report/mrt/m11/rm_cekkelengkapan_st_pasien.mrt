          <value>rmrawat16,System.Int16</value>
          <value>rmrawat20,System.Int16</value>
          <value>rmrawat21a,System.Int16</value>
          <value>rmrawat21b,System.Int16</value>
          <value>rmrawat22,System.Int16</value>
          <value>rmfp16oral,System.Int16</value>
          <value>rmgizi17,System.Int16</value>
          <value>rmoklapanastesi,System.Int16</value>
          <value>rmok19,System.Int16</value>
          <value>rmpetugas,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	userr.unama , 

	kj.kjnotransaksi , 
	rm.rmnorm, kj.kjnama , 
	CASE rm.rmperawatan
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS rmperawatan , 
pc.pcnama AS rmkategoripasien , 
rm.rmtgl , 
rm.rmnotransaksi , 
st.nama AS rmstatus , 

rm.rmtpip11 , 
rm.rmtpip12 , 
rm.rmtpip13 , 
rm.rmtpip4 , 
rm.rmtpip5 , 

rm.rmigd21 , 
rm.rmigd22, 
rm.rmigd18a , 
rm.rmigd31, 
rm.rmigd32, 
rm.rmigd33, 
rm.rmigd34 , 
rm.rmigd35 , 
rm.rmigd6 , 
rm.rmigd7 , 

rm.rmvk10 , 
rm.rmvk10b , 
rm.rmvk22bayi ,

rm.rmrawat36, 
rm.rmrawat37, 
rm.rmrawat38, 
rm.rmrawat9, 
rm.rmrawat10, 
rm.rmrawat14, 
rm.rmrawat15, 
rm.rmrawat16, 
rm.rmrawat20, 
rm.rmrawat21a, 
rm.rmrawat21b , 
rm.rmrawat22, 

rm.rmfp16oral , 

rm.rmgizi17, 

rm.rmoklapanastesi, 
rm.rmok19 , 

petugas.knama AS rmpetugas 

FROM m_11_rm rm 
JOIN m_11_kj kj ON rm.rmidkj = kj.kjid
JOIN m1_patient_category pc ON rm.rmkategoripasien = pc.pckode 
JOIN m0_status st ON rm.rmstatus = st.kode
JOIN m0_user userr ON userr.userid = rm.rminputuser
LEFT JOIN m1_contact petugas ON rm.rmpetugas = petugas.kid

ORDER BY rm.rmid </SqlCommand>
      </DS1>
