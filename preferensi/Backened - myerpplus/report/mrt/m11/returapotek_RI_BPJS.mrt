      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=rswk</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="9">
          <value>rotgl,System.DateTime</value>
          <value>ronoref,System.String</value>
          <value>ronotransaksi,System.String</value>
          <value>kjnama,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	ro.rotgl , 
	ro.ronoref , 
	ro.ronotransaksi , 
	kj.kjnama , 
	rod.namalayanan , 
	rod.jml , rod.satuan , 
	rod.harga , 
	(rod.jml * rod.harga) AS total 


	FROM m_11_ro ro 
JOIN m_11_ro_detail rod ON ro.roid = rod.idro 
JOIN m_11_kj kj ON ro.roidkj = kj.kjid 

JOIN m1_item b ON rod.idlayanan = b.bid

ORDER BY ro.rotgl , ro.ronotransaksi , rod.urutan 
</SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
