          <value>idlayanan,System.Int64</value>
          <value>bid,System.Int64</value>
          <value>namalayanan,System.String</value>
          <value>harga,System.Double</value>
          <value>jml,System.Double</value>
          <value>jmldiskon,System.Double</value>
          <value>total,System.Double</value>
          <value>presentase,System.Double</value>
          <value>nopasien,System.String</value>
          <value>namapasien,System.String</value>
          <value>idmsmq,System.String</value>
          <value>userid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT COUNT(*) , 
	idlogin,   
	kjid , 
	kwid , 
	luid , 
	kjnotransaksi , 
	kwnotransaksi , 
	lunotransaksi , 
	kjtgl , 
	kwtgl , 
	lutgl , 
	kjsumber , 
	sumber , 
	lukategoripasien , 
	pcnama , 
	iddokter , 
	namadokter , 
	idlayanan , 
	bid , 
	namalayanan  , 
	harga , 
	jml, 
	jmldiskon , 
	SUM(total) AS total 	, 
	SUM(presentase)as presentase 
	, nopasien , namapasien , 
	idmsmq , 
	userid 

	FROM m2r_gaji_dokter

	GROUP BY iddokter , idlayanan , kwtgl , kwid
ORDER BY iddokter , idlayanan , kwtgl , kwid</SqlCommand>
      </DS1>
