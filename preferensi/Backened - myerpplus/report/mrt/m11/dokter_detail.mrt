      <DS1 Ref="13" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="29">
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>idlogin,System.String</value>
          <value>kjid,System.Int64</value>
          <value>kwid,System.Int64</value>
