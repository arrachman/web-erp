      <DS1 Ref="13" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="13">
          <value>umur,System.String</value>
          <value>rmumur,System.Int32</value>
          <value>rmketumur,System.String</value>
          <value>kjprovinsi,System.String</value>
          <value>kjkota,System.String</value>
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int64</value>
          <value>dkode,System.String</value>
          <value>dnama,System.String</value>
          <value>rmjeniskelamin,System.String</value>
          <value>rmtindaklanjut,System.Int32</value>
          <value>statuss,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	IF(rm.rmketumur = "Hari",IF(rm.rmumur BETWEEN 0 AND 27,"0-28hr",
IF(rm.rmumur &gt; 28,"28-&lt;1th","More"))
,IF(rm.rmumur BETWEEN 1 AND 4,"1-4th"
,IF(rm.rmumur BETWEEN 5 AND 14,"5-14th"
,IF(rm.rmumur BETWEEN 15 AND 24,"15-24th"
,IF(rm.rmumur BETWEEN 25 AND 44,"25-44th"
,IF(rm.rmumur BETWEEN 45 AND 64,"45-64th"
,"65+th")))))) AS "umur", 

rm.rmumur , 
rm.rmketumur , 
kj.kjprovinsi , 
kj.kjkota , 

	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 
d.dkode , 
d.dnama , 
rm.rmjeniskelamin , 
rm.rmtindaklanjut , 

CASE rm.rmtindaklanjut  
	WHEN 2 THEN "Mati"
ELSE "Tdk Mati"
END AS statuss 

	FROM m_11_rm rm
LEFT JOIN m1_diagnosis d ON rm.rmdiagnosa  = d.dkode 
JOIN m_11_kj kj ON rm.rmidkj = kj.kjid 

ORDER BY rm.rmdiagnosa </SqlCommand>
      </DS1>
    </DataSources>
