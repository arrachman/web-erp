      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="10">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="12">
          <value>aknotransaksi,System.String</value>
          <value>aktgl,System.DateTime</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjtgl,System.DateTime</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>usernama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	ak.aknotransaksi , 
	ak.aktgl , 

	kj.kjnotransaksi, 
	kj.kjtgl , 
	kj.kjnopasien , 
	kj.kjnama, 

	akd.namalayanan , 
	akd.jml , 
	akd.satuan , 
	akd.harga , 
	(akd.jml * akd.harga) AS total , 
	u.ukode as usernama 

	FROM m_11_ak ak
JOIN m_11_ak_detail akd ON ak.akid = akd.idak

JOIN m_11_kj kj ON akd.idkjdetail = kj.kjid

JOIN m0_user u ON ak.akinputuser = u.userid

ORDER BY ak.aknotransaksi , kj.kjnotransaksi </SqlCommand>
      </DS1>
