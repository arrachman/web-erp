      <DS2 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="12">
          <value>kwnotransaksi,System.String</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>luidkj,System.Int64</value>
          <value>lunotransaksi,System.String</value>
          <value>lutgl,System.DateTime</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kw.kwnotransaksi , 

	kj.kjnotransaksi , 
	kj.kjnopasien, 

	lu.luidkj , 
	lu.lunotransaksi, 
	lu.lutgl , 
	b.bkode , 
	lud.namalayanan  , 
	lud.jml , 
	lud.satuan , 
	lud.harga , 
	(lud.jml * lud.harga) AS total 

	FROM m_11_kw kw 
JOIN m_11_kw_detail kwd ON kwd.idkw = kw.kwid 

JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 

LEFT JOIN m_11_lu_detail lud ON kj.kjid = lud.idkjdetail
JOIN m_11_lu lu ON lud.idlu = lu.luid 

JOIN m1_item b ON b.bid = lud.idlayanan

ORDER BY kw.kwnotransaksi , kj.kjnotransaksi , lu.lunotransaksi , lud.urutan</SqlCommand>
      </DS2>
      <DS3 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
