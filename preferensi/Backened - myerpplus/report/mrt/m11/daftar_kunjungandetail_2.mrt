          <value>kwnotransaksi,System.String</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>kmnotransaksi,System.String</value>
          <value>kmtgl,System.DateTime</value>
          <value>kmkamar,System.String</value>
          <value>kmkasur,System.String</value>
          <value>kmtglmasuk,System.DateTime</value>
          <value>kmtglkeluar,System.DateTime</value>
          <value>kmjmlhari,System.Int32</value>
          <value>kmharga,System.Double</value>
          <value>kmtotaltransaksi,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kw.kwnotransaksi , 

	kj.kjnotransaksi , 
	kj.kjnopasien , 

	km.kmnotransaksi , 
	km.kmtgl, 
	km.kmkamar , 
	km.kmkasur , 
	km.kmtglmasuk ,
	km.kmtglkeluar , 
	km.kmjmlhari, 
	km.kmharga , 
	km.kmtotaltransaksi


	FROM m_11_kw kw 
JOIN m_11_kw_detail kwd ON kwd.idkw = kw.kwid 

JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 

JOIN m_11_km km ON kj.kjid = km.kmidkj

 

ORDER BY kw.kwnotransaksi , kj.kjnotransaksi , km.kmnotransaksi </SqlCommand>
      </DS3>
      <DS4 Ref="9" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS4</Alias>
        <Columns isList="true" count="14">
          <value>kwnotransaksi,System.String</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>akresep,System.Double</value>
          <value>akracik,System.Double</value>
          <value>akembalase,System.Double</value>
          <value>aknotransaksi,System.String</value>
          <value>aktgl,System.DateTime</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS4</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kw.kwnotransaksi , 

	kj.kjnotransaksi , 
	kj.kjnopasien , 

	ak.akresep , 
	ak.akracik , 
	ak.akembalase , 

	ak.aknotransaksi ,
	ak.aktgl, 
	b.bkode , 
	akd.namalayanan , 
	akd.jml , 
	akd.satuan , 
	akd.harga , 
	(akd.jml * akd.harga) AS total 

	FROM m_11_kw kw 
JOIN m_11_kw_detail kwd ON kwd.idkw = kw.kwid 

JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 

LEFT JOIN m_11_ak_detail akd ON kj.kjid = akd.idkjdetail
JOIN m_11_ak ak ON akd.idak = ak.akid

JOIN m1_item b ON akd.idlayanan = b.bid


ORDER BY kw.kwnotransaksi , kj.kjnotransaksi , ak.aknotransaksi , akd.urutan</SqlCommand>
      </DS4>
      <DS5 Ref="10" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS5</Alias>
        <Columns isList="true" count="11">
          <value>kwnotransaksi,System.String</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>lbnotransaksi,System.String</value>
          <value>lbtgl,System.DateTime</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS5</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kw.kwnotransaksi , 

	kj.kjnotransaksi , 
	kj.kjnopasien , 

	lb.lbnotransaksi , 
	lb.lbtgl , 
	b.bkode , 
	lbd.namalayanan , 
	lbd.jml , 
	lbd.satuan , 
	lbd.harga , 
	(lbd.jml * lbd.harga) AS total 

	FROM m_11_kw kw 
JOIN m_11_kw_detail kwd ON kwd.idkw = kw.kwid 

JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 

LEFT JOIN m_11_lb_detail lbd ON kj.kjid = lbd.idkjdetail 
JOIN m_11_lb lb ON lbd.idlb = lb.lbid

JOIN m1_item b ON lbd.idlayanan = b.bid
 

ORDER BY kw.kwnotransaksi , kj.kjnotransaksi , lb.lbnotransaksi , lbd.urutan</SqlCommand>
      </DS5>
      <formatTgl Ref="11" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <DS6 Ref="12" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS6</Alias>
        <Columns isList="true" count="20">
          <value>kwnotransaksi,System.String</value>
          <value>rkid,System.Int64</value>
          <value>idrkcarabayar,System.Int64</value>
          <value>kjnotransaksi,System.String</value>
          <value>rekanan,System.String</value>
          <value>rknorek,System.String</value>
          <value>akunD,System.String</value>
          <value>rkuraian,System.String</value>
          <value>rknotransaksi,System.String</value>
          <value>rktgl,System.DateTime</value>
          <value>rkmatauang,System.String</value>
          <value>rkstatus,System.String</value>
          <value>carabayar,System.String</value>
          <value>rekbank,System.String</value>
          <value>namaakun,System.String</value>
          <value>bank,System.String</value>
          <value>noacbank,System.String</value>
          <value>jumlah,System.Double</value>
          <value>nogiro,System.String</value>
          <value>tgljt,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS6</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kw.kwnotransaksi , 

	rk.rkid , 
	rkp.idrkcarabayar , 
	kj.kjnotransaksi ,
	c.cnama AS rekanan, 
	rk.rknorek, coa.cnama AS akunD, 
	rk.rkuraian, 

	rk.rknotransaksi , 
	rk.rktgl , 
	rk.rkmatauang , 
	st.nama AS rkstatus , 

	pm.nama AS carabayar , 
	rkp.rekbank, 
	coaa.cnama AS namaakun, 
	rkp.bank , 
	rkp.noacbank , 
	rkp.jumlah , 
	rkp.nogiro , 
	rkp.tgljt 

	FROM m_11_kw kw 
JOIN m_11_kw_detail kwd ON kwd.idkw = kw.kwid 

JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 

JOIN m_11_rk rk ON kj.kjid = rk.rkidkj 

LEFT JOIN m1_colleague c ON rk.rkkontak = c.cid
LEFT JOIN m1_coa coa ON rk.rknorek = coa.cnomor

LEFT JOIN m0_status st ON rk.rkstatus = st.kode

LEFT JOIN m_11_rk_pay rkp ON rk.rkid = rkp.idrk
LEFT JOIN m0_payment_method pm ON rkp.carabayar = pm.kode

LEFT JOIN m1_coa coaa ON rkp.rekbank = coaa.cnomor

ORDER BY kw.kwid , rk.rkid , rkp.urutan </SqlCommand>
      </DS6>
      <DS7 Ref="13" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS7</Alias>
        <Columns isList="true" count="16">
          <value>kwnotransaksi,System.String</value>
          <value>unama,System.String</value>
          <value>ronotransaksi,System.String</value>
          <value>rotgl,System.DateTime</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjtgl,System.DateTime</value>
          <value>kjnopasien,System.String</value>
          <value>pnama,System.String</value>
          <value>jenis,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>diskon,System.String</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS7</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	kw.kwnotransaksi , 

	userr.ukode AS unama , 

	ro.ronotransaksi , 
	ro.rotgl , 
	kj.kjnotransaksi , 
	kj.kjtgl , 
	kj.kjnopasien , 
	p.pnama , 
	ic.icnama AS jenis , 
	b.bkode , 
	rod.namalayanan , 
	rod.jml , 
	rod.satuan , 
	rod.harga , 
	rod.diskon  , 
	((rod.jml * rod.harga) - rod.jmldiskon) AS total 

	FROM m_11_kw kw 
JOIN m_11_kw_detail kwd ON kwd.idkw = kw.kwid 

JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 

JOIN m_11_ro ro ON kj.kjid = ro.roidkj 
JOIN m_11_ro_detail rod ON ro.roid = rod.idro 

JOIN m1_patient p ON kj.kjnopasien = p.pkode 

JOIN m1_item_category ic ON rod.jenis = ic.ickode
JOIN m1_item b ON rod.idlayanan = b.bid

JOIN m0_user userr ON ro.roinputuser = userr.userid

ORDER BY kw.kwnotransaksi , ro.ronotransaksi , rod.urutan </SqlCommand>
      </DS7>
      <DS8 Ref="14" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS8</Alias>
        <Columns isList="true" count="3">
          <value>cnama,System.String</value>
          <value>jmlbayar,System.Double</value>
          <value>kjnotransaksi,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS8</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	c.cnama , 
	(pbd.jmlbayar) AS jmlbayar , kj.kjnotransaksi

	FROM m_11_pb pb 
JOIN m_11_pb_detail pbd ON pb.pvid = pbd.idpv 
JOIN m1_coa c ON pbd.rekhutangpiutang = c.cnomor
JOIN m_11_kw kw ON pb.pvidic = kw.kwid 
JOIN m_11_kw_detail kwd ON kw.kwid = kwd.idkw 
LEFT JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = "KJ"

WHERE pb.pvnotransaksi = "AAPB16020842"</SqlCommand>
      </DS8>
