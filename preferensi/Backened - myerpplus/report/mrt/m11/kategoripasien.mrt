        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	pc.pckode , pc.pcnama , pc.pctingkatjual , pc.pccatatan

	FROM m1_patient_category pc

ORDER BY pc.pckode</SqlCommand>
      </DS1>
