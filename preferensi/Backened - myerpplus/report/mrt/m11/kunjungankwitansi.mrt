    <DataSources isList="true" count="13">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="5">
          <value>kjnotransaksi,System.String</value>
          <value>pnama,System.String</value>
          <value>pprefix,System.String</value>
          <value>ukode,System.String</value>
          <value>unama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnotransaksi , 
	p.pnama , 
	p.pprefix ,

	u.ukode AS ukode, 
	u.unama AS unama


	FROM m_11_kj kj 
JOIN m1_patient p ON kj.kjnopasien = p.pkode
JOIN m0_user u ON kj.kjinputuser = u.userid

ORDER BY kj.kjnotransaksi </SqlCommand>
      </DS1>
