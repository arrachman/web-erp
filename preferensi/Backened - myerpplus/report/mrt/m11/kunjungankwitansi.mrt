      <formatQty Ref="9" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="10" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="11" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatTgl Ref="12" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <DS2 Ref="13" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="4">
          <value>kjnotransaksi,System.String</value>
          <value>total,System.Double</value>
          <value>terbilang,System.String</value>
          <value>matauang,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT * FROM(SELECT 

	kjnotransaksi , SUM(total) AS total , f_nominal(SUM(total), matauang) AS terbilang  , matauang

	FROM (

SELECT kj.kjnotransaksi , SUM(lud.jml * lud.harga) AS total , lu.lumatauang AS matauang

	FROM m_11_kj kj
JOIN m1_patient p ON kj.kjnopasien = p.pkode
JOIN m0_user u ON kj.kjinputuser = u.userid

LEFT JOIN m_11_lu_detail lud ON kj.kjid = lud.idkjdetail
JOIN m_11_lu lu ON lud.idlu = lu.luid 

GROUP BY kj.kjnotransaksi

UNION ALL

SELECT kj.kjnotransaksi  , SUM(km.kmtotaltransaksi) AS total , km.kmmatauang AS matauang

	FROM m_11_kj kj
JOIN m1_patient p ON kj.kjnopasien = p.pkode
JOIN m0_user u ON kj.kjinputuser = u.userid

JOIN m_11_km km ON kj.kjid = km.kmidkj

GROUP BY kj.kjnotransaksi

UNION ALL 

SELECT kj.kjnotransaksi , SUM(akd.jml * akd.harga) AS total , "RP" AS matauang

	FROM m_11_kj kj
JOIN m1_patient p ON kj.kjnopasien = p.pkode
JOIN m0_user u ON kj.kjinputuser = u.userid

LEFT JOIN m_11_ak_detail akd ON kj.kjid = akd.idkjdetail
JOIN m_11_ak ak ON akd.idak = ak.akid

GROUP BY kj.kjnotransaksi

UNION ALL

SELECT kj.kjnotransaksi  , SUM(lbd.jml * lbd.harga) AS total , lb.lbmatauang AS matauang

	FROM m_11_kj kj
JOIN m1_patient p ON kj.kjnopasien = p.pkode
JOIN m0_user u ON kj.kjinputuser = u.userid

LEFT JOIN m_11_lb_detail lbd ON kj.kjid = lbd.idkjdetail 
JOIN m_11_lb lb ON lbd.idlb = lb.lbid

GROUP BY kj.kjnotransaksi

) as  a 

GROUP BY kjnotransaksi 
ORDER BY kjnotransaksi

) as a </SqlCommand>
      </DS2>
