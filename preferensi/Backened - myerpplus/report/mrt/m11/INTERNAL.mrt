      <DS1 Ref="13" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="20">
          <value>kjperawatan,System.String</value>
          <value>a,System.Int64</value>
          <value>rmtgl,System.DateTime</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int64</value>
          <value>rmlayanan,System.String</value>
          <value>lkode,System.String</value>
          <value>lnama,System.String</value>
          <value>rmjeniskelamin,System.String</value>
          <value>rmkrs,System.Int32</value>
          <value>ketkrs,System.String</value>
          <value>kds,System.String</value>
          <value>lamadirawat,System.Int64</value>
          <value>haridirawat,System.Int64</value>
          <value>kjkamar,System.String</value>
          <value>rkode,System.String</value>
          <value>rnama,System.String</value>
          <value>rkelas,System.Int32</value>
          <value>kjtglkeluar,System.DateTime</value>
          <value>kjtgl,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	CASE rm.rmperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan , 

MONTH(rm.rmtgl) a, 
rm.rmtgl , 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 


rm.rmlayanan , l.lkode , l.lnama , 
rm.rmjeniskelamin , 
rm.rmkrs , 
CASE rm.rmkrs
	WHEN 1 THEN "Sembuh"
	WHEN 2 THEN "Belum Sembuh"
	WHEN 3 THEN "Meninggal &lt; 48 Jam"
	WHEN 4 THEN "Meninggal &gt;= 48 Jam"
END AS ketkrs , 

CASE rm.rmkrs
	WHEN 1 THEN "hidup"
	WHEN 2 THEN "hidup"
	WHEN 3 THEN "mati"
	WHEN 4 THEN "mati"
END AS kds , 

DATEDIFF(kj.kjtglkeluar , kj.kjtgl) AS lamadirawat ,
(DATEDIFF(kj.kjtglkeluar , kj.kjtgl) + 1) AS haridirawat , 

kj.kjkamar , r.rkode , r.rnama , r.rkelas , 

kj.kjtglkeluar ,  kj.kjtgl 

FROM m_11_rm rm 
LEFT  JOIN m1_layanan l ON rm.rmlayanan = l.lkode 
JOIN m_11_kj kj ON rm.rmidkj = kj.kjid 
LEFT JOIN m1_room r ON kj.kjkamar = r.rkode 

ORDER BY rm.rmlayanan ASC		</SqlCommand>
      </DS1>
