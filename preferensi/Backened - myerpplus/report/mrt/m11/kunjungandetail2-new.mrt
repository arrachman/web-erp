    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="22">
          <value>kwnotransaksi,System.String</value>
          <value>kwtgl,System.DateTime</value>
          <value>kjtgl,System.DateTime</value>
          <value>kjnotransaksi,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>kjtglkeluar,System.DateTime</value>
          <value>kjtglmeninggal,System.DateTime</value>
          <value>kjcarakunjungan,System.String</value>
          <value>kjdirujukoleh,System.String</value>
          <value>kjditanggungoleh,System.String</value>
          <value>kjstatus,System.String</value>
          <value>namapasien,System.String</value>
          <value>alamatpasien,System.String</value>
          <value>keluargapasien,System.String</value>
          <value>ptgllahir,System.DateTime</value>
          <value>pjeniskelamin,System.String</value>
          <value>pnohp,System.String</value>
          <value>namadokter,System.String</value>
          <value>namakamar,System.String</value>
          <value>unama,System.String</value>
          <value>kwtotalar,System.Double</value>
          <value>terbilang,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	kw.kwnotransaksi , 
	kw.kwtgl,
	kj.kjtgl, 
	kj.kjnotransaksi , 
	kj.kjnopasien, 
	kj.kjtglkeluar , 
	kj.kjtglmeninggal , 
	CASE kj.kjcarakunjungan 
	WHEN 1 THEN 'Datang Sendiri'
	WHEN 2 THEN 'Rujukan'
END AS kjcarakunjungan , 
r.rnama AS kjdirujukoleh , 
i.inama AS kjditanggungoleh , 
st.nama AS kjstatus , 
p.pnama AS namapasien , 
p.palamat AS alamatpasien , 
CONCAT(p.pkeluargalain," ",p.pnoteleponlain) AS keluargapasien,  
p.ptgllahir , 
CASE p.pjeniskelamin 
	WHEN "P" THEN "Perempuan"
	WHEN "L" THEN "Laki - Laki"
END AS pjeniskelamin, 
p.pnohp,
dok.knama as namadokter,
kamar.rnama as namakamar,
u1.unama,
kw.kwtotalar,
	f_nominal(ROUND(kw.kwtotalar), 'IDR') AS terbilang 
FROM m_11_kw kw 
JOIN m_11_kw_detail kwd ON kwd.idkw = kw.kwid 
JOIN m_11_kj kj ON kwd.idtransaksi = kj.kjid AND kwd.sumber = kj.kjsumber 
JOIN m0_status st ON kj.kjstatus = st.kode
LEFT JOIN m1_reference r ON kj.kjdirujukoleh = r.rid
LEFT JOIN m1_insurer i ON kj.kjditanggungoleh = i.iid
LEFT JOIN m1_patient p ON kj.kjnopasien = p.pkode
LEFT JOIN m1_contact dok ON kj.kjdokter = dok.kkode
LEFT JOIN m1_room kamar ON kj.kjkamar = kamar.rkode
LEFT JOIN m0_user u1 ON kw.kwinputuser = u1.userid
ORDER BY kw.kwnotransaksi , kj.kjnotransaksi 
</SqlCommand>
      </DS1>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
