<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-rs</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="25">
          <value>terbilang,System.String</value>
          <value>lbtotaltransaksi,System.Double</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>kjperawatan,System.String</value>
          <value>kjkategoripasien,System.String</value>
          <value>lbcatatan,System.String</value>
          <value>lbtgl,System.DateTime</value>
          <value>lbnotransaksi,System.String</value>
          <value>lbdokter,System.String</value>
          <value>bkode,System.String</value>
          <value>namalayanan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>lbpetugas,System.String</value>
          <value>inama,System.String</value>
          <value>palamat,System.String</value>
          <value>lbnoref,System.String</value>
          <value>pnohp,System.String</value>
          <value>kjstatuspasien,System.Int32</value>
          <value>statuspasien,System.String</value>
          <value>pumur,System.Int32</value>
          <value>pketumur,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	f_nominal(ROUND(lb.lbtotaltransaksi), lb.lbmatauang) AS terbilang , 
	ROUND(lb.lbtotaltransaksi) as lbtotaltransaksi  , 
	IFNULL(kj.kjnopasien, lb.lburaian) as kjnopasien , 
	IFNULL(pt.pnama, lb.lburaian) as kjnama, 
	CASE lb.lbperawatan
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
  END AS kjperawatan , 
  pc.pcnama AS kjkategoripasien , 
  lb.lbcatatan , 
  lb.lbtgl , 
  lb.lbnotransaksi , 
  kd.knama AS lbdokter , 
  b.bkode , 
  lbd.namalayanan, 
  lbd.jml , 
  lbd.satuan , 
  lbd.harga , 
  (lbd.jml * lbd.harga) AS total , 
  k.knama AS lbpetugas , 
  i.inama,
  pt.palamat,
 lb.lbnoref , pt.pnohp , 
kj.kjstatuspasien  , 

	CASE kj.kjstatuspasien
	WHEN 0 THEN "Pasien Baru"
	WHEN 1 THEN "Pasien Lama"
END AS statuspasien , 
pt.pumur , 

CASE pt.pketumur 
	WHEN 1 THEN "Hari"
	WHEN 2 THEN "Minggu"
	WHEN 3 THEN "Bulan"
	WHEN 4 THEN "Tahun"
END AS pketumur

FROM m_11_lb lb 
JOIN m_11_lb_detail lbd ON lb.lbid = lbd.idlb 
JOIN m1_item b ON lbd.idlayanan = b.bid
LEFT JOIN m_11_kj kj ON lb.lbidkj = kj.kjid 
LEFT JOIN m1_contact k ON lb.lbpetugas = k.kid
LEFT JOIN m1_contact kd ON lb.lbdokter = kd.kkode 
LEFT JOIN m1_patient_category pc ON lb.lbkategoripasien = pc.pckode
LEFT JOIN m1_contact c ON lb.lbcustomer = c.kid
LEFT JOIN m1_insurer i ON kj.kjditanggungoleh = i.iid
LEFT JOIN m1_patient pt ON kj.kjnopasien = pt.pkode

WHERE (lb.lbstatus = 2 OR lb.lbstatus = 3 OR lb.lbstatus = 4 OR lb.lbstatus = 7)

ORDER BY lb.lbtgl, lb.lbnotransaksi, lb.lbid , lbd.urutan </SqlCommand>
      </DS1>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatTgl Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
    </DataSources>
