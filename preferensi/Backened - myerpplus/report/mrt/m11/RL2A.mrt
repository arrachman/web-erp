    <DataSources isList="true" count="8">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="15">
          <value>rmid,System.Int64</value>
          <value>ikode,System.String</value>
          <value>inama,System.String</value>
          <value>pjeniskelamin,System.String</value>
          <value>pumur,System.Int32</value>
          <value>_x0031_sampai4,System.Decimal</value>
          <value>_x0035_sampai14,System.Decimal</value>
          <value>_x0031_5sampai24,System.Decimal</value>
          <value>_x0032_5sampai44,System.Decimal</value>
          <value>_x0034_5sampai64,System.Decimal</value>
          <value>lebihdari65,System.Decimal</value>
          <value>L,System.Decimal</value>
          <value>P,System.Decimal</value>
          <value>rmtindaklanjut,System.Int32</value>
          <value>Mati,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	rm.rmid , 
	icd.ikode , 
	icd.inama , 
	p.pjeniskelamin , 
	p.pumur ,

	SUM((SELECT COUNT(*)
FROM m_11_rm rms1
JOIN m1_patient p1 ON rms1.rmnorm = p1.pkode

WHERE (rm.rmid = rms1.rmid) AND (p1.pumur BETWEEN 1 AND 4)
))  AS "1sampai4" ,

SUM((SELECT COUNT(*)
	FROM m_11_rm rms2
JOIN m1_patient p2 ON rms2.rmnorm = p2.pkode

WHERE (rm.rmid = rms2.rmid) AND (p2.pumur BETWEEN 5 AND 14)
))  AS "5sampai14" ,

SUM((SELECT COUNT(*)
	FROM m_11_rm rms3
JOIN m1_patient p3 ON rms3.rmnorm = p3.pkode

WHERE (rm.rmid = rms3.rmid) AND (p3.pumur BETWEEN 15 AND 24)
))  AS "15sampai24" , 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms4
JOIN m1_patient p4 ON rms4.rmnorm = p4.pkode

WHERE (rm.rmid = rms4.rmid) AND (p4.pumur BETWEEN 25 AND 44)
))  AS "25sampai44" ,

SUM((SELECT COUNT(*)
	FROM m_11_rm rms5
JOIN m1_patient p5 ON rms5.rmnorm = p5.pkode

WHERE (rm.rmid = rms5.rmid) AND (p5.pumur BETWEEN 45 AND 64)
))  AS "45sampai64" , 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms6
JOIN m1_patient p6 ON rms6.rmnorm = p6.pkode

WHERE (rm.rmid = rms6.rmid) AND (p6.pumur &gt; 64)
))  AS "lebihdari65" ,

SUM((SELECT COUNT(*)
	FROM m_11_rm rms7
JOIN m1_patient p7 ON rms7.rmnorm = p7.pkode

WHERE (rm.rmid = rms7.rmid) AND (p7.pjeniskelamin = "L")
))  AS "L" ,

SUM((SELECT COUNT(*)
	FROM m_11_rm rms8
JOIN m1_patient p8 ON rms8.rmnorm = p8.pkode

WHERE (rm.rmid = rms8.rmid) AND (p8.pjeniskelamin = "P")
))  AS "P" , 

rm.rmtindaklanjut , 

SUM((SELECT COUNT(*)
	FROM m_11_rm rms9

WHERE (rm.rmid = rms9.rmid) AND (rms9.rmtindaklanjut = 2 )
))  AS "Mati" 

FROM m1_icd icd 
LEFT JOIN m_11_rm rm ON icd.ikode = rm.rmicd 
LEFT JOIN m_11_kj kj on rm.rmidkj = kj.kjid 
LEFT JOIN m1_patient p ON rm.rmnorm = p.pkode 

GROUP BY icd.ikode 
ORDER BY icd.ikode , rm.rmid </SqlCommand>
      </DS1>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
