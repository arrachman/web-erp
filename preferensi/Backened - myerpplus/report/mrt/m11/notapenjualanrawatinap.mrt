      <DS2 Ref="14" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="3">
          <value>akid,System.Int64</value>
          <value>aknotransaksi,System.String</value>
          <value>terbilang,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	ak.akid , 
	ak.aknotransaksi , 
	f_nominal(ak.aktotaltransaksi, ak.akmatauang) AS terbilang 

	FROM m_11_ak ak

GROUP BY ak.akid 
ORDER BY ak.akid </SqlCommand>
      </DS2>
