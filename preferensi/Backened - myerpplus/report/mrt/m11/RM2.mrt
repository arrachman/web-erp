      <DS3 Ref="14" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="6">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int32</value>
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>kjcarakunjungan,System.Int16</value>
          <value>carakunjungan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	CASE kj.kjperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 


	COUNT(*) , 
	kj.kjcarakunjungan , 

	CASE kj.kjcarakunjungan
	WHEN 1 THEN "Datang sendiri"
	WHEN 2 THEN "Rujukan Dokter"
	WHEN 3 THEN "Rujukan Puskesmas"
	WHEN 4 THEN "Rujukan Instansi Lain"
	WHEN 5 THEN "Rujukan RS Lain"
	WHEN 6 THEN "Poli"
	WHEN 7 THEN "Rujukan Klinik"
	WHEN 8 THEN "Rujukan Bidan"
END AS carakunjungan 

FROM m_11_kj kj JOIN m_11_rm rm on kj.kjid = rm.rmidkj

WHERE rm.rmtgl BETWEEN "2016-02-01" AND "2016-02-29"

GROUP BY kj.kjcarakunjungan

ORDER BY kj.kjcarakunjungan</SqlCommand>
      </DS3>
      <DS4 Ref="15" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS4</Alias>
        <Columns isList="true" count="6">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int32</value>
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>kjditanggungoleh,System.Int16</value>
          <value>inama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS4</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT


	CASE kj.kjperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 

	COUNT(*) , 

	kj.kjditanggungoleh ,
	i.inama 

from  m_11_kj kj 
LEFT JOIN m1_insurer i ON kj.kjditanggungoleh = i.iid 
JOIN m_11_rm rm on rm.rmidkj = kj.kjid

WHERE rm.rmtgl BETWEEN "2016-02-01" AND "2016-02-29"

GROUP BY kj.kjditanggungoleh 
ORDER BY kj.kjditanggungoleh </SqlCommand>
      </DS4>
      <DS5 Ref="16" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS5</Alias>
        <Columns isList="true" count="6">
          <value>kjperawatan,System.String</value>
          <value>bulan,System.String</value>
          <value>tahun,System.Int32</value>
          <value>COUNT_x0028__x002A__x0029_,System.Int64</value>
          <value>sdnama,System.String</value>
          <value>kjkecamatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS5</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT



	CASE kj.kjperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS kjperawatan, 

CASE MONTH(rm.rmtgl) 
	WHEN 1 THEN "Januari"
	WHEN 2 THEN "Februari"
	WHEN 3 THEN "Maret"
	WHEN 4 THEN "April"
	WHEN 5 THEN "Mei"
	WHEN 6 THEN "Juni"
	WHEN 7 THEN "Juli"
	WHEN 8 THEN "Agustus"
	WHEN 8 THEN "September"
	WHEN 10 THEN "Oktober"
	WHEN 11 THEN "November"
	WHEN 12 THEN "Desember"
END AS bulan , 

YEAR(rm.rmtgl) AS tahun , 

	COUNT(*) , 
	sd.sdnama , 
	kj.kjkecamatan 

	FROM m_11_kj kj 
LEFT JOIN m1_subdistrict sd ON kj.kjkecamatan = sd.sdkode 
JOIN m_11_rm rm ON rm.rmidkj = kj.kjid

WHERE rm.rmtgl BETWEEN "2016-02-01" AND "2016-02-29"

GROUP BY kj.kjkecamatan 
ORDER BY kj.kjkecamatan </SqlCommand>
      </DS5>
