    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="12">
          <value>NamaPasien,System.String</value>
          <value>Usia,System.Int32</value>
          <value>NoRM,System.String</value>
          <value>Kamar,System.String</value>
          <value>Diagnosa,System.String</value>
          <value>Dokter,System.String</value>
          <value>JenisInfeksi,System.String</value>
          <value>TglDitemukan,System.DateTime</value>
          <value>TglPemasangan,System.DateTime</value>
          <value>Keterangan,System.String</value>
          <value>bulan,System.Int64</value>
          <value>tahun,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT *

FROM (SELECT 

	kj.kjnama AS NamaPasien, 
	kj.kjumur As Usia, 
	kj.kjnopasien AS NoRM, 
	kj.kjkamar AS Kamar, 
	kj.kjdiagnosa AS Diagnosa, 
	k.knama AS Dokter, 
	"Plebitis" AS JenisInfeksi,
	pt.pttgl AS TglDitemukan,
	pt.pttgl AS TglPemasangan,
	pt.ptcatatan AS Keterangan,
	MONTH(pt.pttgl) AS bulan,
	YEAR(pt.pttgl) AS tahun

	FROM

	m_11_kj kj JOIN m_11_pt pt ON (kj.kjid = pt.ptidkj)
LEFT JOIN m1_contact k ON (kj.kjdokter = k.kkode)

WHERE pt.ptjenispemasangan = 3 GROUP BY pt.pttgl

UNION ALL

SELECT 

	kj.kjnama AS NamaPasien, 
	kj.kjumur As Usia, 
	kj.kjnopasien AS NoRM, 
	kj.kjkamar AS Kamar, 
	kj.kjdiagnosa AS Diagnosa, 
	k.knama AS Dokter, 
	"ISK" AS JenisInfeksi,
	isk.isktgl AS TglDitemukan,
	isk.isktgl AS TglPemasangan,
	isk.iskcatatan AS Keterangan,
	MONTH(isk.isktgl) AS bulan,
	YEAR(isk.isktgl) AS tahun

	FROM

	m_11_kj kj JOIN m_11_isk isk ON (kj.kjid = isk.iskidkj)
LEFT JOIN m1_contact k ON (kj.kjdokter = k.kkode)

WHERE isk.iskjenispemasangan = 3 
GROUP BY isk.isktgl
) AS DeteksiInfeksi

ORDER BY TglDitemukan</SqlCommand>
      </DS1>
      <formatQty Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
