      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=wijaya</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="8">
          <value>lbtgl,System.DateTime</value>
          <value>lbnotransaksi,System.String</value>
          <value>lbnoref,System.String</value>
          <value>nama,System.String</value>
          <value>total,System.Double</value>
          <value>JP,System.Double</value>
          <value>lbperawatan,System.String</value>
          <value>lbkategoripasien,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	lb.lbtgl , 
	lb.lbnotransaksi , 
	lb.lbnoref , 
	CASE lb.lbidkj
	WHEN 0 THEN lb.lburaian
	ELSE kj.kjnama
END AS nama, 
	SUM(lbd.jml * lbd.harga) AS total , 
	(SUM(lbd.jml * lbd.harga) * 0.1 ) AS JP, 
	CASE lb.lbperawatan 
	WHEN "RI" THEN "Rawat Inap"
	WHEN "RJ" THEN "Rawat Jalan"
END AS lbperawatan , 
pc.pcnama AS lbkategoripasien

FROM m_11_lb lb
JOIN m_11_lb_detail lbd on lb.lbid = lbd.idlb 
LEFT JOIN m_11_kj kj ON lb.lbidkj = kj.kjid 
LEFT JOIN m1_patient_category pc ON lb.lbkategoripasien = pc.pckode

GROUP BY lb.lbid 
ORDER BY lb.lbid</SqlCommand>
      </DS1>
