    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="13">
          <value>kjnotransaksi,System.String</value>
          <value>kjtgl,System.DateTime</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>kmstatus,System.String</value>
          <value>kmnotransaksi,System.String</value>
          <value>kmtgl,System.DateTime</value>
          <value>kmtglmasuk,System.DateTime</value>
          <value>kmkamar,System.String</value>
          <value>kmkasur,System.String</value>
          <value>kmtglkeluar,System.DateTime</value>
          <value>kmjmlhari,System.Int32</value>
          <value>kmcatatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	kj.kjnotransaksi , 
	kj.kjtgl, 
	kj.kjnopasien , 
	kj.kjnama  , 
	st.nama AS kmstatus , 

	km.kmnotransaksi , 
	km.kmtgl , 
	km.kmtglmasuk, 
	km.kmkamar , 
	km.kmkasur , 
	km.kmtglkeluar, 
	km.kmjmlhari , 
	km.kmcatatan 


	FROM m_11_km km
JOIN m_11_kj kj ON km.kmidkj = kj.kjid
JOIN m0_status st ON km.kmstatus = st.kode

ORDER BY kj.kjnotransaksi , kj.kjnopasien , km.kmnotransaksi</SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>logo</Alias>
        <Columns isList="true" count="1">
