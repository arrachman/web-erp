    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_rs</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="10">
          <value>akid,System.Int64</value>
          <value>aktgl,System.DateTime</value>
          <value>aknoref,System.String</value>
          <value>kjnopasien,System.String</value>
          <value>kjnama,System.String</value>
          <value>idlayanan,System.Int64</value>
          <value>total,System.Double</value>
          <value>akresep,System.Double</value>
          <value>akracik,System.Double</value>
          <value>akembalase,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	ak.akid , 
	ak.aktgl , ak.aknoref , kj.kjnopasien , kj.kjnama , 
	akd.idlayanan , (akd.jml * akd.harga) AS total , 
	ak.akresep , 
	ak.akracik, 
	ak.akembalase

	FROM m_11_ak ak
JOIN m_11_ak_detail akd ON ak.akid = akd.idak 
LEFT JOIN m_11_kj kj ON ak.akidkj = kj.kjid

ORDER BY ak.aktgl , ak.akid </SqlCommand>
      </DS1>
      <logo Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>logo</Alias>
        <Columns isList="true" count="1">
          <value>snilai,System.String</value>
