<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="15">
          <value>bgudang,System.String</value>
          <value>wnama,System.String</value>
          <value>bdepartemen,System.String</value>
          <value>bsubdepartemen,System.String</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>KRT,System.Double</value>
          <value>LSN,System.Double</value>
          <value>PCS,System.Double</value>
          <value>unilai,System.Double</value>
          <value>bcustom2,System.String</value>
          <value>total,System.Double</value>
          <value>harga,System.Double</value>
          <value>jmldiskon,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="1">
          <value>Parameter,,18,0</value>
        </Parameters>
        <SqlCommand>SELECT

	b.bgudang , 
	w.wnama , 
	dp.dpnama AS bdepartemen , 
	sdp.sdpnama AS bsubdepartemen , 
	b.bkode , 
	b.bnama , 
	SUM(sid.jml) AS jml , 
	(Sum(sid.jml * un.unilai) - (Sum(sid.jml * un.unilai) MOD unit.unilai)) / unit.unilai As KRT , 
((Sum(sid.jml * un.unilai) MOD unit.unilai ) - (Sum(sid.jml * un.unilai) MOD unit.unilai)  mod 12) / 12  AS LSN , 
(Sum(sid.jml * un.unilai) MOD unit.unilai)  mod 12 AS PCS  , 


unit.unilai 	, 
b.bcustom2 , 

#TOTAL RP = SUM(JML * (HARGA - (JMLDISKON/JML)))
SUM((sid.jml * un.unilai) * (harga - (jmldiskon / (sid.jml * un.unilai)))) AS total , 
SUM(sid.harga) AS harga , 
sum(sid.jmldiskon) AS jmldiskon 

FROM m5_si si 
JOIN m5_si_detail sid ON si.siid = sid.idsi 
JOIN m1_item b ON sid.idbarang = b.bid 
JOIN m1_department dp ON b.bdepartemen = dp.dpkode 
JOIN m1_subdepartment sdp ON b.bsubdepartemen = sdp.sdpkode 
LEFT JOIN m1_unit unit ON b.bcustom2 = unit.ukode 
JOIN m1_unit un ON sid.satuan = un.ukode 
LEFT JOIN m1_warehouse w ON b.bgudang = w.wkode

WHERE si.sistatus IN(2,3,4,7)

GROUP BY b.bgudang ASC , b.bdepartemen ASC , b.bsubdepartemen , sid.idbarang ASC 
ORDER BY b.bgudang ASC , b.bdepartemen ASC , b.bsubdepartemen , sid.idbarang ASC </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
