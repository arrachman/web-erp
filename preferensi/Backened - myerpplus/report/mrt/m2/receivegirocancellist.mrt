              <Text>{IIF((DS1.jumlah) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.jumlah) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.jumlah))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
