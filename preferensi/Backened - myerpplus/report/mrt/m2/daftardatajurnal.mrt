<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="4">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="27">
          <value>tinputuser,System.Int64</value>
          <value>tinputuserkode,System.String</value>
          <value>tnotransaksi,System.String</value>
          <value>ttgl,System.DateTime</value>
          <value>turaian,System.String</value>
          <value>turutan,System.Int32</value>
          <value>knama,System.String</value>
          <value>tkodetabelangka,System.Int32</value>
          <value>tkodepa,System.Int64</value>
          <value>tkontak,System.Int64</value>
          <value>tcatatan,System.String</value>
          <value>tkurs,System.Double</value>
          <value>tsumber,System.String</value>
          <value>tmatauang,System.String</value>
          <value>tnorek,System.String</value>
          <value>tkontakkode,System.String</value>
          <value>tstatusnama,System.String</value>
          <value>tstatus,System.Int16</value>
          <value>tdivisi,System.String</value>
          <value>tcostcenter,System.String</value>
          <value>tproyek,System.String</value>
          <value>thutangpiutang,System.Int16</value>
          <value>tdebit,System.Double</value>
          <value>tkredit,System.Double</value>
          <value>namarekening,System.String</value>
          <value>kkode,System.String</value>
          <value>tinputtgl,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT * FROM (SELECT tj.tinputuser , u.unama AS tinputuserkode,	tj.tnotransaksi,   
	tj.ttgl, tj.turaian,  tj.turutan, k.knama, tj.tkodetabelangka, 	tj.tkodepa, tj.tkontak,   
	tj.tcatatan, tj.tkurs, tj.tsumber, tj.tmatauang, 	 tj.tnorek, k.kkode AS tkontakkode, 	  
	(CASE tj.tstatus  WHEN 0 THEN 'Draft'  WHEN 1 THEN 'Approve'  WHEN 2 THEN 'Approved' END) AS tstatusnama, 
 tj.tstatus,  tj.tdivisi, tj.tcostcenter, tj.tproyek,  tj.thutangpiutang, SUM(tj.tdebit) AS tdebit,  
SUM(tj.tkredit) AS tkredit,  c.cnama AS namarekening, k.kkode, tj.tinputtgl     FROM m2_transaction_journal tj  
JOIN m1_contact k ON tj.tkontak = k.kid   JOIN m1_coa c ON tj.tnorek = c.cnomor  
LEFT JOIN m1_division d ON tj.tdivisi = d.dkode  
LEFT JOIN m1_project p ON tj.tproyek = p.pkode   LEFT JOIN m0_user u ON tj.tinputuser = u.userid  
GROUP BY tj.tnotransaksi, tj.tdebit DESC, tj.tkredit ASC,  tj.tmatauang, tj.tnorek ) AS datatran  
WHERE (tstatus = "2") ORDER BY ttgl, tinputtgl, tnotransaksi, turutan </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'DD','dd'),'mm','MM'),'YYYY','yyyy') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
    </DataSources>
