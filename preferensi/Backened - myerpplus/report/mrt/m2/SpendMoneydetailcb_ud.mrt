<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="18">
          <value>urutan,System.Int32</value>
          <value>ckodebank,System.String</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>smnorek,System.String</value>
          <value>norek,System.String</value>
          <value>debit,System.Double</value>
          <value>debitvalas,System.Double</value>
          <value>debit2,System.Double</value>
          <value>debitvalas2,System.Double</value>
          <value>smnotransaksi,System.String</value>
          <value>catatan,System.String</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Double</value>
          <value>smtgl,System.DateTime</value>
          <value>smid,System.Int64</value>
          <value>terbilang,System.String</value>
          <value>a,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	smd.urutan,
	c.ckodebank,
	c.cnomor,
	c.cnama,
	sm.smnorek,
	smd.norek,
	sm.smjumlah AS debit,
	sm.smjumlahvalas AS debitvalas,
	smd.jumlah AS debit2,
	smd.jumlahvalas AS debitvalas2,
	sm.smnotransaksi,
	smd.catatan,
	smd.matauang,
	smd.kurs,
	sm.smtgl,
	sm.smid,
	f_nominal(sm.smjumlah, sm.smmatauang) AS terbilang,

	(SELECT cs.cnama FROM m1_coa cs JOIN m2_sm smm ON cs.cnomor = smm.smnorek
WHERE smm.smsumber = 'SM' AND smm.smnotransaksi = sm.smnotransaksi
ORDER BY smm.smjumlah ASC Limit 1) AS a

FROM m2_sm sm
JOIN m2_sm_detail smd ON sm.smid = smd.idsm
JOIN m1_coa c ON smd.norek = c.cnomor
WHERE sm.smsumber = 'SM' #AND sm.smnotransaksi = 'ABSM13120005'
ORDER BY sm.smnotransaksi, smd.urutan</SqlCommand>
      </DS1>
      <DS2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="11">
          <value>debit,System.Double</value>
          <value>debit2,System.Double</value>
          <value>smnotransaksi,System.String</value>
          <value>smsumber,System.String</value>
          <value>nogiro,System.String</value>
          <value>rekbank,System.String</value>
          <value>jumlah,System.Double</value>
          <value>smid,System.Int64</value>
          <value>noacbank,System.String</value>
          <value>bank,System.String</value>
          <value>tgljt,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	sm.smjumlah AS debit,
	smd.jumlah AS debit2,
	sm.smnotransaksi,
	sm.smsumber,
	smd.nogiro,
	smd.rekbank, smd.jumlah, sm.smid, smd.noacbank,smd.bank, smd.tgljt		
	FROM m2_sm sm
		LEFT JOIN m2_sm_pay smd ON sm.smid = smd.idsm
		JOIN m1_coa c ON sm.smnorek = c.cnomor 
		ORDER BY sm.smnotransaksi, smd.urutan</SqlCommand>
      </DS2>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
    </DataSources>
