    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="20">
          <value>cbnotransaksi,System.String</value>
          <value>cbtgl,System.DateTime</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>catatan,System.String</value>
          <value>statuscb,System.String</value>
          <value>kontak,System.String</value>
          <value>cbmatauang,System.String</value>
          <value>cbkurs,System.Double</value>
          <value>cburaian,System.String</value>
          <value>cbkredit,System.Double</value>
          <value>cbdebit,System.Double</value>
          <value>cbdebitvalas,System.Double</value>
          <value>cbkreditvalas,System.Double</value>
          <value>kredit,System.Double</value>
          <value>kreditvalas,System.Double</value>
          <value>debit,System.Double</value>
          <value>debitvalas,System.Double</value>
          <value>cbid,System.Int64</value>
          <value>norek,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	cb.cbnotransaksi,
	cb.cbtgl,
	c.cnomor,
	c.cnama,
	cbd.catatan,
	st.nama AS statuscb,
	k.knama AS kontak,
	cb.cbmatauang,
	cb.cbkurs,
	cb.cburaian,
	cb.cbkredit,
	cb.cbdebit,
	cb.cbdebitvalas,
	cb.cbkreditvalas,
	cbd.kredit,
	cbd.kreditvalas,
	cbd.debit,
	cbd.debitvalas,
	cb.cbid,
	cbd.norek

	from

	m2_cb cb
JOIN m2_cb_detail cbd ON cb.cbid = cbd.idcb
JOIN m1_contact k ON cb.cbkontak = k.kid
JOIN m0_status st ON cb.cbstatus = st.kode
JOIN m1_coa c ON cbd.norek = c.cnomor
order by cb.cbnotransaksi


</SqlCommand>
      </DS1>
      <DS2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="20">
