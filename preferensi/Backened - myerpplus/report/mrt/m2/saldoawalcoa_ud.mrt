        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	cb.cbnotransaksi,
	cb.cbtgl,
	c.cnomor,
	c.cnama,
	cbd.catatan,
	st.nama AS statuscb,
	k.knama AS kontak,
	cb.cbmatauang,
	cb.cbkurs,
	cb.cburaian,
	cb.cbkredit,
	cb.cbdebit,
	cb.cbdebitvalas,
	cb.cbkreditvalas,
	cbd.kredit,
	cbd.kreditvalas,
	cbd.debit,
	cbd.debitvalas,
	cb.cbid,
	cbd.norek

	from

	m2_cb cb
JOIN m2_cb_detail cbd ON cb.cbid = cbd.idcb
JOIN m1_contact k ON cb.cbkontak = k.kid
JOIN m0_status st ON cb.cbstatus = st.kode
JOIN m1_coa c ON cbd.norek = c.cnomor
order by cb.cbnotransaksi

</SqlCommand>
      </DS2>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS3 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="14">
          <value>cbnotransaksi,System.String</value>
          <value>cbtgl,System.DateTime</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>jenisgiro,System.String</value>
          <value>jumlah,System.Double</value>
          <value>tgljt,System.DateTime</value>
          <value>noacbank,System.String</value>
          <value>bank,System.String</value>
          <value>nogiro,System.String</value>
          <value>knama,System.String</value>
          <value>cbmatauang,System.String</value>
          <value>cbkurs,System.Double</value>
          <value>cbid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	cb.cbnotransaksi,
	cb.cbtgl,
	c.cnomor,
	c.cnama,
	(CASE cbp.jenisgiro
WHEN 0 THEN 'Masuk'
WHEN 1 THEN 'Keluar'
END) AS jenisgiro,
cbp.jumlah,
cbp.tgljt,
cbp.noacbank,
cbp.bank,
cbp.nogiro,
k.knama,
cb.cbmatauang,
cb.cbkurs,
cb.cbid

FROM 
m2_cb cb
JOIN m2_cb_pay cbp ON cb.cbid = cbp.idcb
LEFT JOIN m1_coa c ON cbp.rekgiro = c.cnomor
JOIN m1_contact k ON cb.cbkontak = k.kid
ORDER BY cb.cbnotransaksi, cbp.nogiro </SqlCommand>
      </DS3>
