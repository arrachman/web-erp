          <value>sccustomdbl5,System.Double</value>
          <value>sccustomdate1,System.DateTime</value>
          <value>sccustomdate2,System.DateTime</value>
          <value>sccustomdate3,System.DateTime</value>
          <value>sccustomdate4,System.DateTime</value>
