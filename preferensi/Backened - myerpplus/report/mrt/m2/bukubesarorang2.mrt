              <Page isRef="13" />
              <Parent isRef="14" />
              <Text>Akun : {DS1.namarek} - {IIF(DS1.ccustomdbl1 &lt; 0,formatMinus.kiri,"")}{IIF(DS1.ccustomdbl1 &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.ccustomdbl1))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.ccustomdbl1))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF(DS1.ccustomdbl1 &lt; 0 ,formatMinus.kanan,"")}</Text>
