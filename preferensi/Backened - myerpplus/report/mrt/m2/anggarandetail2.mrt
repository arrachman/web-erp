<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="15">
          <value>bdnotransaksi,System.String</value>
          <value>bdtgl,System.DateTime</value>
          <value>bdtglanggaran,System.DateTime</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>jumlah,System.Double</value>
          <value>catatan,System.String</value>
          <value>bduraian,System.String</value>
          <value>status,System.String</value>
          <value>barchnama,System.String</value>
          <value>barchkode,System.String</value>
          <value>namakategori,System.String</value>
          <value>kodekategori,System.String</value>
          <value>bdanggarankategori,System.Int32</value>
          <value>kategori,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	bd.bdnotransaksi,
	bd.bdtgl,
	bd.bdtglanggaran,
	c.cnomor,
	c.cnama,
	bdd.jumlah,
	bdd.catatan,
	bd.bduraian,
	st.nama AS status,
	b.bnama AS barchnama,
	b.bkode AS barchkode,

	(CASE bd.bdanggarankategori 
WHEN '0' THEN ' '
WHEN '1' THEN b.bnama
WHEN '2' THEN lc.lnama
WHEN '3' THEN cc.ccnama
WHEN '4' THEN d.dnama
WHEN '5' THEN sd.sdnama
WHEN '6' THEN p.pnama
END) AS namakategori ,

(CASE bd.bdanggarankategori 
WHEN '0' THEN ' '
WHEN '1' THEN b.bkode
WHEN '2' THEN lc.lkode
WHEN '3' THEN cc.cckode
WHEN '4' THEN d.dkode
WHEN '5' THEN sd.sdkode
WHEN '6' THEN p.pkode
END) AS kodekategori,

bd.bdanggarankategori,


rc.nama AS kategori

FROM

m2_bd bd 
JOIN m2_bd_detail bdd ON bd.bdid = bdd.idbd
JOIN m1_coa c ON bdd.norek = c.cnomor
JOIN m0_status st ON bd.bdstatus = st.kode
JOIN m0_realization_category rc ON bd.bdanggarankategori = rc.kode
LEFT JOIN m1_branch b ON bd.bdanggarancabang = b.bkode
LEFT JOIN m1_location lc ON bd.bdanggaranlokasi = lc.lkode
LEFT JOIN m1_cost_center cc ON bd.bdanggarancostcenter = cc.cckode
LEFT JOIN m1_division d ON bd.bdanggarandivisi = d.dkode
LEFT JOIN m1_subdivision sd ON bd.bdanggaransubdivisi = sd.sdkode
LEFT JOIN m1_project p ON bd.bdanggaranproyek = p.pkode



ORDER BY bd.bdnotransaksi, c.cnomor</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
    </DataSources>
