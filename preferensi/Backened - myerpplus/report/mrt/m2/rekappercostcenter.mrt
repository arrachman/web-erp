        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT *  FROM m2r_bp_card WHERE idlogin = '4be445eea7479da22204cd37c24d54b8' AND idmsmq = 'N1SjKTJ0bdiJ' ORDER BY bpnourut ASC</SqlCommand>
