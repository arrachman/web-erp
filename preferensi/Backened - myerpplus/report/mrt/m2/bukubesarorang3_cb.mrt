      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="11">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="12">
          <value>divisikode,System.String</value>
          <value>divisinama,System.String</value>
          <value>norek,System.String</value>
          <value>namarek,System.String</value>
          <value>hari,System.Int64</value>
          <value>cdc,System.String</value>
          <value>tdebit,System.Double</value>
          <value>tkredit,System.Double</value>
          <value>ccustomdbl1,System.Double</value>
          <value>qty,System.Double</value>
          <value>jumlah,System.Double</value>
          <value>ttgl,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	IFNULL(t.tdivisi,'') as divisikode, 
	IFNULL(d.dnama, '') as divisinama,
	IFNULL(t.tnorek, '') as norek,
	IFNULL(c.cnamaalias1, '') as namarek,
	COUNT(t.ttgl) as hari,
	c.cdc, 
	SUM(t.tdebit) AS tdebit , 
	SUM(t.tkredit) AS tkredit , 
	IFNULL(c.ccustomdbl1,0) AS ccustomdbl1, 

	IFNULL((CASE c.cdc  	
	WHEN 'D' THEN SUM(t.tdebit - t.tkredit)
	WHEN 'C' THEN SUM(t.tkredit - t.tdebit) 
ELSE 0 END) / c.ccustomdbl1,0) AS qty  ,

IFNULL(CASE c.cdc  	
	WHEN 'D' THEN SUM(t.tdebit - t.tkredit)
	WHEN 'C' THEN SUM(t.tkredit - t.tdebit) 
ELSE 0 END ,0)AS jumlah 

FROM m2_transaction_journal t 
JOIN m1_division d ON t.tdivisi = d.dkode
LEFT JOIN m1_coa c ON t.tnorek = c.cnomor


WHERE t.tstatus in (2,3,4,7)


GROUP BY t.tnorek ASC, t.tdivisi ASC
ORDER BY t.tnorek ASC, t.tdivisi ASC</SqlCommand>
      </DS1>
