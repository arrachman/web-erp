        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT *  FROM m2r_arpostage_card #WHERE idlogin = '08d1c4c23a6602f2ad89cb9c68e0bf97' AND idmsmq = '8JDJA3xtXTEf' ORDER BY arnourut ASC</SqlCommand>
