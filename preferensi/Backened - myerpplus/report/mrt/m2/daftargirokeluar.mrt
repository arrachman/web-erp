              <Text>{IIF((DS1.gljumlah) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.gljumlah) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.gljumlah))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.gljumlah))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF((DS1.gljumlah) &lt; 0 ,formatMinus.kanan,"")} </Text>
