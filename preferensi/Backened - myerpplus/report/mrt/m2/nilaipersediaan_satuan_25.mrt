          <value>kscustomdate2,System.DateTime</value>
          <value>kscustomdate3,System.DateTime</value>
          <value>kscustomdate4,System.DateTime</value>
          <value>kscustomdate5,System.DateTime</value>
          <value>MODD,System.Double</value>
          <value>BAGI,System.Int64</value>
          <value>hasi_x0020_bagi_x0020_KRT,System.Double</value>
          <value>KRT,System.Double</value>
          <value>LSN,System.Double</value>
          <value>PCS,System.Double</value>
          <value>unilai,System.Double</value>
          <value>bcustom2,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="1">
          <value>Parameter,,18,0</value>
        </Parameters>
        <SqlCommand>SELECT 

	ks.* , 
CASE bcustom2
	WHEN "KRT100" THEN kssaldojml MOD 100 
	WHEN "KRT141" THEN kssaldojml MOD 141 
END as MODD , 
CASE bcustom2
	WHEN "KRT100" THEN 100 
	WHEN "KRT141" THEN 141 
END as BAGI  , 

ks.kssaldojml MOD unit.unilai "hasi bagi KRT",
((ks.kssaldojml) - ((ks.kssaldojml) MOD unit.unilai)) / unit.unilai As KRT , 
(((ks.kssaldojml) MOD unit.unilai ) - ((ks.kssaldojml) MOD unit.unilai)  mod 12) / 12  AS LSN , 
((ks.kssaldojml) MOD unit.unilai)  mod 12 AS PCS  , 
unit.unilai 	, 
b.bcustom2

FROM m2r_kartu_stok ks
JOIN m1_item b ON ks.ksidbarang = b.bid 
LEFT JOIN m1_unit unit ON b.bcustom2 = unit.ukode

WHERE idlogin = '9f3dcd240a73c7c185ee313f8625ff96' AND idmsmq = '95640653c9e7d962626e647a5c018d66' 
AND (kssaldojml &lt;&gt; 0 OR kssaldohpp &lt;&gt; 0 OR kssaldonilai &lt;&gt; 0) 

ORDER BY ks.ksgudang ASC, ks.kscatatan ASC, ks.ksnourut ASC</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
