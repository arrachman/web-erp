        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT *  FROM m2r_giro_voucher_aging WHERE idlogin = '146988dd4f4d9956c0ef8349fd96ad14' AND idmsmq = 'ESAKs5WY7RWX' ORDER BY glnourut ASC</SqlCommand>
