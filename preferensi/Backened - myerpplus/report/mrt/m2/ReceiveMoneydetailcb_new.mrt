<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_pci</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="20">
          <value>rmuraian,System.String</value>
          <value>rmnorek,System.String</value>
          <value>rmnoreknama,System.String</value>
          <value>knama,System.String</value>
          <value>urutan,System.Int32</value>
          <value>ckodebank,System.String</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>cdc,System.String</value>
          <value>norek,System.String</value>
          <value>kredit,System.Double</value>
          <value>kreditvalas,System.Double</value>
          <value>rmnotransaksi,System.String</value>
          <value>rmtgl,System.DateTime</value>
          <value>catatan,System.String</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Double</value>
          <value>terbilang,System.String</value>
          <value>divisi,System.String</value>
          <value>costcenter,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	rm.rmuraian , 
	c1.cnomor AS rmnorek , 
	c1.cnama as rmnoreknama,
	k.knama,
	rmd.urutan,
	c.ckodebank,
	c.cnomor,
	c.cnama,
	c.cdc , 
	rmd.norek,
	rmd.jumlah AS kredit,
	rmd.jumlahvalas AS kreditvalas,
	rm.rmnotransaksi,
	rm.rmtgl,
	rmd.catatan,
	rmd.matauang,
	rmd.kurs,
	(SELECT
f_nominal(SUM(rmd2.jumlah), rm.rmmatauang)
FROM m2_rm_detail rmd2 WHERE rmd.idrm = rmd2.idrm
GROUP BY rmd2.idrm) as terbilang 

FROM m2_rm rm
JOIN m2_rm_detail rmd ON rm.rmid = rmd.idrm
JOIN m1_coa c1 ON rm.rmnorek = c1.cnomor
JOIN m1_coa c ON rmd.norek = c.cnomor
LEFT JOIN m1_contact k ON rm.rmkontak = k.kid

WHERE rm.rmsumber = 'RM'

ORDER BY rm.rmtgl ASC, rm.rmnotransaksi, rmd.urutan</SqlCommand>
      </DS1>
      <DS2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="13">
          <value>glurutan,System.Int32</value>
          <value>glbanknama,System.String</value>
          <value>glnogiro,System.String</value>
          <value>glnoacbank,System.String</value>
          <value>gljumlah,System.Double</value>
          <value>gltgljthtempo,System.DateTime</value>
          <value>glrekbank,System.String</value>
          <value>glrekbanknama,System.String</value>
          <value>cnama,System.String</value>
          <value>cnomor,System.String</value>
          <value>kredit,System.Double</value>
          <value>rmnotransaksi,System.String</value>
          <value>rmsumber,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	gl.glurutan,
	gl.glbanknama,
	gl.glnogiro,
	gl.glnoacbank,
	gl.gljumlah,
	gl.gltgljthtempo,
	gl.glrekbank,
	gl.glrekbanknama,
	c.cnama,
	c.cnomor,
	rmd.jumlah AS kredit,
	rm.rmnotransaksi,
	rm.rmsumber

	FROM m2_rm rm
JOIN m2_rm_detail rmd ON rm.rmid = rmd.idrm
LEFT JOIN m2_giro_list_v gl ON rm.rmnotransaksi = gl.glnotransaksi
JOIN m1_coa c ON rmd.norek = c.cnomor

ORDER BY gl.glnogiro, rm.rmnotransaksi, rmd.urutan</SqlCommand>
      </DS2>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
