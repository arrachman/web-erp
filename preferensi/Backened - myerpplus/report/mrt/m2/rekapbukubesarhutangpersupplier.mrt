Replace(
Replace(
Replace(
(Format(formatNominal.fromat, Sum(DS1.tdebit)))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
