    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_fatkur_product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="13">
          <value>ksgudang,System.String</value>
          <value>ksgudangnama,System.String</value>
          <value>kscustomtext1,System.String</value>
          <value>kscustomtext2,System.String</value>
          <value>kskodebarang,System.String</value>
          <value>ksnamabarang,System.String</value>
          <value>ksjmlkeluar,System.Double</value>
          <value>terjual,System.Double</value>
          <value>unama,System.String</value>
          <value>rata,System.Double</value>
          <value>kssaldojml,System.Double</value>
          <value>ksnilaikeluar,System.Double</value>
          <value>weekcover,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="1">
          <value>Parameter,,18,0</value>
        </Parameters>
        <SqlCommand>SELECT 

	ks.ksgudang, 
	ks.ksgudangnama , 
	ks.kscustomtext1  , 
	ks.kscustomtext2 , 
	ks.kskodebarang , 
	ks.ksnamabarang , 
	ks.ksjmlkeluar , 
	(ks.ksjmlkeluar / unit.unilai) AS terjual , 
	unit.unama , 
	((ks.ksjmlkeluar / unit.unilai) / 13) AS rata , 
	(ks.kssaldojml / unit.unilai) AS kssaldojml , 
	ks.ksnilaikeluar , 
	(ks.kssaldojml / ((ks.ksjmlkeluar / unit.unilai) / 13) ) AS weekcover 



	FROM m2r_kartu_stok ks
JOIN m1_item b ON ks.ksidbarang = b.bid 
LEFT JOIN m1_unit unit ON b.bcustom2 = unit.ukode
JOIN m1_department dp ON b.bdepartemen = dp.dpkode 
JOIN m1_subdepartment sdp ON b.bsubdepartemen = sdp.sdpkode 


WHERE (ksjmlkeluar &lt;&gt; 0 OR kssaldohpp &lt;&gt; 0 OR kssaldonilai &lt;&gt; 0)

ORDER BY ks.ksgudang ASC, ks.kscustomtext1 ASC, ks.kscustomtext2 ASC, ks.ksnourut ASC</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
