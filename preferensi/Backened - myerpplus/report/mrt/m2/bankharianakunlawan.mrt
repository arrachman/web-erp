        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT *
	FROM m2r_kasbank_harian
	#WHERE idlogin = '616688a3031e50c9c6ab608692f459b9' AND idmsmq = 'NIfncfVK8QW9'
	#ORDER BY kbhnorek,kbhnotransaksi, kbhtgl, kbhdebitlawan, kbhkreditlawan</SqlCommand>
      </DS1>
      <DS2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="11">
          <value>sumber,System.String</value>
          <value>idtransaksi,System.Int64</value>
          <value>notransaksi,System.String</value>
          <value>norek,System.String</value>
          <value>noreklawan,System.String</value>
          <value>kbhnoreklawannama,System.String</value>
          <value>nogiro,System.String</value>
          <value>bank,System.String</value>
          <value>matauang,System.String</value>
          <value>jumlah,System.Double</value>
          <value>tgljatuhtempo,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	kbh.kbhsumber as sumber,
	(CASE kbh.kbhsumber
	WHEN 'RG' THEN rgd.idrg
	ELSE sgd.idsg
END) as idtransaksi,
kbh.kbhnotransaksi as notransaksi,
kbh.kbhnorek AS norek,
kbh.kbhnoreklawan AS noreklawan,
kbh.kbhnoreklawannama,
(CASE kbh.kbhsumber
	WHEN 'RG' THEN rgd.nogiro
	ELSE sgd.nogiro
END) as nogiro,
(CASE kbh.kbhsumber
	WHEN 'RG' THEN rgd.bank
	ELSE sgd.bank
END) as bank,
(CASE kbh.kbhsumber
	WHEN 'RG' THEN rgd.matauang
	ELSE sgd.matauang
END) as matauang,
(CASE kbh.kbhsumber
	WHEN 'RG' THEN (CASE rgd.matauang WHEN s.snilai THEN rgd.jumlah ELSE rgd.jumlahvalas END)
	ELSE (CASE sgd.matauang WHEN s.snilai THEN sgd.jumlah ELSE sgd.jumlahvalas END)
END) as jumlah,
(CASE kbh.kbhsumber
	WHEN 'RG' THEN rgd.tgljatuhtempo
	ELSE sgd.tgljatuhtempo
END) as tgljatuhtempo
 
FROM m2r_kasbank_harian kbh
LEFT JOIN m2_rg_detail rgd ON kbh.kbhsumber = 'RG' AND kbh.kbhidtransaksi = rgd.idrg
LEFT JOIN m2_sg_detail sgd ON kbh.kbhsumber = 'SG' AND kbh.kbhidtransaksi = sgd.idsg
LEFT JOIN m0_setting s ON s.smodule = 0 AND s.sgrup =	'accounting' AND s.skode = 'MataUangFungsional'

#WHERE (kbh.kbhsumber = 'RG' OR kbh.kbhsumber = 'SG')

GROUP BY kbh.kbhsumber, kbh.kbhidtransaksi</SqlCommand>
      </DS2>
      <formatTgl Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
 SUBSTR(snilai FROM 2 FOR 1) AS kanan 
 

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
