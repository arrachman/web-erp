              <Name>Text25</Name>
              <Page isRef="7" />
              <Parent isRef="8" />
              <Text>{DS1.cdmatauang} {IIF(DS1.cdjumlah &lt; 0,formatMinus.kiri,"")}{IIF((DS1.cdjumlah) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.cdjumlah))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.cdjumlah))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF((DS1.cdjumlah) &lt; 0 ,formatMinus.kanan,"")} </Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
