              <Name>Text13</Name>
              <Page isRef="7" />
              <Parent isRef="26" />
              <Text>{IIF((DS1.kredit) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.kredit) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.kredit))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.kredit))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF((DS1.kredit) &lt; 0 ,formatMinus.kanan,"")} </Text>
