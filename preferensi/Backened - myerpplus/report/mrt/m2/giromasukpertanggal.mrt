        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT * FROM m2r_giro_voucher WHERE idlogin = '5db34d8e3acb9f1784dc4a8c88feb156' AND idmsmq = 'VPajUVjFaKjE' ORDER BY glnourut ASC</SqlCommand>
