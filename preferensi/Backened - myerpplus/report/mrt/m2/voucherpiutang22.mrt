        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT * FROM m2r_ar_voucher ar
#WHERE idlogin = 'b2e98121fe0b4c28ee152349a4dd2eae' 
#AND 

WHERE idmsmq = 'e9ea36d3396d836eb6b30ad31e10fd52' 
ORDER BY arnourut ASC</SqlCommand>
