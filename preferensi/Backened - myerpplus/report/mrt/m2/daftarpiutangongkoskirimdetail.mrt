      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="31">
          <value>rpid,System.Int64</value>
          <value>rpnotransaksi,System.String</value>
          <value>rptgl,System.DateTime</value>
          <value>rpkontak,System.Int64</value>
          <value>rpkontakkode,System.String</value>
          <value>rpkontaknama,System.String</value>
          <value>rptgljatuhtempo,System.DateTime</value>
          <value>rpuraian,System.String</value>
          <value>rpcatatan,System.String</value>
          <value>rpmatauang,System.String</value>
          <value>rpkurs,System.Double</value>
          <value>rpjumlah,System.Double</value>
          <value>rpjumlahvalas,System.Double</value>
          <value>rpjumlahbayar,System.Double</value>
          <value>rpjumlahbayarvalas,System.Double</value>
          <value>rpsisa,System.Double</value>
          <value>rpsisavalas,System.Double</value>
          <value>rpstatusbayar,System.Int16</value>
          <value>rptgllunas,System.DateTime</value>
          <value>pvid,System.Int64</value>
          <value>pvnotransaksi,System.String</value>
          <value>pvtgl,System.DateTime</value>
          <value>pvcustomer,System.Int64</value>
          <value>pvcustomerkode,System.String</value>
          <value>pvcustomernama,System.String</value>
          <value>pvuraian,System.String</value>
          <value>pvcatatan,System.String</value>
          <value>pvmatauang,System.String</value>
          <value>pvkurs,System.Double</value>
          <value>jmlbayar,System.Double</value>
          <value>jmlbayarvalas,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	rp.rpid,
	rp.rpnotransaksi,
	rp.rptgl,
	rp.rpkontak,
	c1.kkode as rpkontakkode,
	c1.knama as rpkontaknama,
	rp.rptgljatuhtempo,
	rp.rpuraian,
	rp.rpcatatan,
	rp.rpmatauang,
	rp.rpkurs,
	rp.rpjumlah,
	rp.rpjumlahvalas,
	rp.rpjumlahbayar,
	rp.rpjumlahbayarvalas,
	rp.rpjumlah - rp.rpjumlahbayar as rpsisa,
	rp.rpjumlahvalas - rp.rpjumlahbayarvalas as rpsisavalas,
	rp.rpstatusbayar,
	rp.rptgllunas,
	pv.pvid,
	pv.pvnotransaksi,
	pv.pvtgl,
	pv.pvcustomer,
	c3.kkode as pvcustomerkode,
	c3.knama as pvcustomernama,
	pv.pvuraian,
	pv.pvcatatan,
	pv.pvmatauang,
	pv.pvkurs,
	pvd.jmlbayar,
	pvd.jmlbayarvalas

	FROM
	m5_pv pv
JOIN m5_pv_detail pvd ON pv.pvid = pvd.idpv AND pv.pvstatus IN(2,3,4,7)
RIGHT JOIN m5_rp rp ON pvd.idtransaksi = rp.rpid AND pvd.sumber = rp.rpsumber 
LEFT JOIN m1_contact c1 ON rp.rpkontak = c1.kid
LEFT JOIN m1_contact c2 ON c1.ksalesman = c2.kid
LEFT JOIN m1_contact c3 ON pv.pvcustomer = c3.kid
WHERE rp.rpstatus IN(2,3,4,7)</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
