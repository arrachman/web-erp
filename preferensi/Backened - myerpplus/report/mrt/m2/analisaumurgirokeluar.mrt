        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT *  FROM m2r_giro_voucher_aging WHERE idlogin = '07f5cb7b5fd961723abf4d49879e93f1' AND idmsmq = 'JDkCYu0MAAoQ' ORDER BY glnourut ASC</SqlCommand>
