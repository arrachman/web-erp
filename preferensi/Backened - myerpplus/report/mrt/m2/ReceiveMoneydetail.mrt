              <Name>Text13</Name>
              <Page isRef="9" />
              <Parent isRef="27" />
              <Text>{IIF((DS1.kreditvalas) &lt; 0,formatMinus.kiri,"")}{IIF((DS1.kreditvalas) &lt; 0,(Replace(
Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.kreditvalas))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal)
,"-","")
), Replace(
Replace(
Replace(
Replace(
(Format(formatNominal.fromat, DS1.kreditvalas))
,",","RB")
,".","DS")
,"RB",formatNominal.digitGrup)
,"DS",formatNominal.pemisahDesimal))
}{IIF((DS1.kreditvalas) &lt; 0 ,formatMinus.kanan,"")}</Text>
