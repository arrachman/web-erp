          <value>orderpenjualan,System.Double</value>
          <value>persediaan,System.String</value>
          <value>penjualan,System.String</value>
          <value>returpenjualan,System.String</value>
          <value>returpembelian,System.String</value>
          <value>diskonpembelian,System.String</value>
          <value>stokgudang,System.Double</value>
          <value>jenis,System.String</value>
          <value>hpp,System.String</value>
          <value>status,System.String</value>
          <value>satuan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	b.burutan,
	b.bnama AS namabarang,
	b.bsatuan AS satuanbarang,
	b.bkode AS kodebarang,
	b.btipe,
	bk.icnama AS kategoribarang,
	g.wnama AS gudang,
	blg.blgnamalokasi,
	b.bstok,
	k.knama AS namasuplier,
	b.bgambar,
	(b.bhargajual1) AS hargajual1,
	(b.bhargabeli) AS hargabeli,
	(b.bhargajual2) AS hargajual2,
	(b.bhargajual3) AS hargajual3,
	(b.bhargajual4) AS hargajual4,
	(b.bhargajual5) AS hargajual5,
	(b.bdiskonjual1) AS diskonjual,
	(b.bstokminimal) AS stokminimal,
	(b.bstokmaksimal) AS stokmaksimal,
	(b.breorder) AS jumlahorder,
	(b.bhppaverage) AS hppaverage,
	(b.bjmlorderbeli) AS jmlorderbeli,
	(b.bjmlorderjual) AS orderpenjualan,
	(b.brekpersediaan) AS persediaan,
	(b.brekpenjualan) AS penjualan,
	(b.brekreturpenjualan) AS returpenjualan,
	(b.brekreturpembelian) AS returpembelian,
	(b.brekdiskonpembelian) AS diskonpembelian,
	(b.bstok) AS stokgudang,
	CASE bjenis 
	WHEN 'P' THEN 'Persediaan'
	WHEN 'A' THEN 'Assembly'
	WHEN 'J' THEN 'Jasa' 
	WHEN 'D' THEN 'Pretelan'
	WHEN 'K' THEN 'Konsinyasi'
ELSE 'Jenis Barang Tidak Ada'
END AS jenis	,
CASE bhpp 
	WHEN 'R' THEN 'Average'
	WHEN 'F' THEN 'Fifo'
	WHEN 'L' THEN 'Lilo'
	WHEN 'I' THEN 'Identifikasi Khusus'
END AS hpp  ,
CASE bstatusmoving
	WHEN 'F' THEN 'Fast'
	WHEN 'M' THEN 'Medium'
	WHEN 'S' THEN 'Slow'
	WHEN 'D' THEN 'Dead'
ELSE 'Status Barang Tidak Ada'
END AS status,
u.unama AS satuan 
FROM m1_item b 
LEFT JOIN m1_item_category bk ON (b.bkategori = bk.ickode) 
LEFT JOIN m1_item_location_warehouse blg ON (b.bid = blg.blgidbarang)
LEFT JOIN m1_warehouse g ON (blg.blggudang = g.wkode) 
LEFT JOIN m1_contact k ON (b.bsuplier = k.kid)
LEFT JOIN m1_unit u ON b.bsatuan = u.ukode
ORDER BY b.bkode, b.burutan</SqlCommand>
      </DS1>
