        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	cc.cckode,
	cc.ccnama,
	d.dnama AS divisi,
	cc.ccakun,
	cc.cccatatan
	FROM 
	m1_cost_center cc 
JOIN m1_division d ON (cc.ccdivisi = d.dkode)</SqlCommand>
      </DS1>
