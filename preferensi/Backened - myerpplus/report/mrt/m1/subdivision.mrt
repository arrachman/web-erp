        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	sdkode,
	d.dnama AS divisi,
	sdnama,
	sdcatatan
	FROM m1_subdivision sd
	JOIN m1_division d ON sd.sddivisi = d.dkode</SqlCommand>
