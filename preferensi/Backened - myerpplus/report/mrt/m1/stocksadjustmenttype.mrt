        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	tsakode,
	tsanama,
	c.cnama,
	tsacatatan

	FROM
	m1_type_sa ts
	JOIN m1_coa c ON ts.tsarek = c.cnomor
</SqlCommand>
