        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	lkode,
	lnama,
	lcabang,
	lcatatan,
	bnama AS cabang

	FROM
	m1_location 
JOIN m1_branch ON m1_location.lcabang = m1_branch.bkode</SqlCommand>
      </DS1>
