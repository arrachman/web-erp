          <value>ktgllahir,System.DateTime</value>
          <value>knorekening,System.String</value>
          <value>kbank,System.String</value>
          <value>k1alamat1,System.String</value>
          <value>FOTO,System.String</value>
          <value>kanama,System.String</value>
          <value>kajabatan,System.String</value>
          <value>kanotelp,System.String</value>
          <value>kanofax,System.String</value>
          <value>kanohp,System.String</value>
          <value>kaemail,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	k.kid , 
	kk.ccnama , 
	k.kkode , 
	k.knama  ,
	k.kaktiftgl , 
	k.k1kontaknohp, 
	k.k1kontakemail,  
	k.k1notelp1, 
	k.k1nofax, 
	k.k1email,  
	k.k1website,
	k.kbatashutang,  
	k.kterminbeli , 
	k.krekhutang , 
	k.kbagpembelian , 
	k.kviabeli , 
	k.kterminjual , 
	k.krekpiutang ,  
	k.kbagpenjualan ,  
	#k.kcatatan ,  
	k.kbataspiutang , 
	k.kcatatan , 
	k.ktgllahir ,
	k.knorekening ,
	k.kbank , 
	k.k1alamat1 , 
	kf.namafile AS FOTO , 
	ka.kanama ,
	ka.kajabatan ,  
	ka.kanotelp , 
	ka.kanofax ,
	ka.kanohp , 
	ka.kaemail 
	FROM m1_contact k
LEFT JOIN m1_contact_category kk ON k.kkategori = kk.cckode
LEFT JOIN m1_contact_files kf ON k.kid = kf.idkontak 
LEFT JOIN m1_contact_attention ka ON k.kid = ka.kaid
</SqlCommand>
      </DS1>
    </DataSources>
