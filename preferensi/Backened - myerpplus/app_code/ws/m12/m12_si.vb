                    End If
                    If Len(dataRowPay(12)) > 25 Then
                        result(2) = "Row Pay : " & i & " - rekgiro should not be more than 25 character." : GoTo selesai
                    End If
                End If
                'END OF VALIDASI DATA PAY --------------------------------

                If AsDataTableTambahData(dtpay, "idsicarabayar~idsi~carabayar~matauang~kurs~jumlah~jumlahvalas~nogiro~tgljt~bank~noacbank~rekbank~rekgiro~catatan~urutan~isclose", dataRowPay(0) & "~" & dataRowPay(1) & "~" & dataRowPay(2) & "~" & dataRowPay(3) & "~" & dataRowPay(4) & "~" & dataRowPay(5) & "~" & dataRowPay(6) & "~" & dataRowPay(7) & "~" & dataRowPay(8) & "~" & dataRowPay(9) & "~" & dataRowPay(10) & "~" & dataRowPay(11) & "~" & dataRowPay(12) & "~" & dataRowPay(13) & "~" & dataRowPay(14) & "~" & dataRowPay(15)) = False Then
                    result(2) = "Row Pay : " & i & " - insert into datatable failed." : GoTo selesai
                End If

            Next
        End If


        'SIMPAN KE DATABASE =================================================================
        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()

