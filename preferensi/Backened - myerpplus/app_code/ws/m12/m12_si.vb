        If Len(filename) < 1 Then
            result(2) = "Filename can't be empty." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA ======================================================

        'EXECUTE SQL FILE
        Dim arrExecute() As String = F_ExecuteSQL(paramSplit(0), userid, filename, Application("As_ConStr1"))
