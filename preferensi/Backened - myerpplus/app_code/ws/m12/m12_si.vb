                'JIKA HARGA TERMASUK PAJAK MAKA TANPA MENAMBAHKAN PAJAK PADA TOTAL TRANSAKSI
                If Integer.Parse(drutama("sihargatermasukpajak")) = 0 Then
                    'TOTAL TRANSAKSI = TOTAL - JMLDISKON + TOTALPAJAK1 + TOTALPAJAK2 + BIAYALAIN - JMLUANGMUKA 
                    drutama("sitotaltransaksi") = Double.Parse(drutama("sitotal")) - Double.Parse(drutama("sijmldiskon")) + Double.Parse(drutama("sitotalpajak1detail")) + Double.Parse(drutama("sitotalpajak2detail")) + Double.Parse(drutama("sibiayalain")) - Double.Parse(drutama("sijmluangmuka"))

