                        ftOutstandingAS = String.Concat(ftOutstandingAS, " (`as`.asid = '" & idAS & "' AND (CASE `as`.asmatauang WHEN s.snilai THEN " & Outstanding & " > `as`.asjumlah - `as`.asjumlahbayar ELSE " & OutstandingValas & " > `as`.asjumlahvalas - `as`.asjumlahbayarvalas END)) ")

                        '3. SET NILAI UPDATE OUTSTANDING
                        updNilaiAS = String.Concat("WHEN '" & idAS & "' THEN ROUND(asjumlahbayar + '" & Outstanding & "' ", updNilaiAS)
                        updNilaiValasAS = String.Concat("WHEN '" & idAS & "' THEN ROUND(`as`.asjumlahbayarvalas + '" & OutstandingValas & "', 5) ", updNilaiValasAS)

                        '4. SET FILTER UPDATE OUTSTANDING
                        updFilterAS = IIf(Len(updFilterAS.ToString) = 0, "", updFilterAS & " OR ")
