                    'AMBIL POIN YANG SUDAH DIMILIKI CUSTOMER
                    sql = "SELECT cppoin FROM m1_contact_point WHERE cpidkontak = '" & FixDouble(drutama("sicustomer")) & "'"
                    dtPoin = AsDataTableAmbilDariDB(sql)
                    If dtPoin.Rows.Count > 0 Then
                        If (Len(FxDB(dtPoin.Rows(0)("cppoin").ToString, 0))) > 0 Then
                            JmlPoin = Double.Parse(FxDB(dtPoin.Rows(0)("cppoin").ToString, 0))
                        End If
                    End If
                    'CEK JML BAYAR DENGAN POIN
                    'JIKA POIN YG DIMILIKI + POIN DIDAPAT < POIN YG DIGUNAKAN PEMBAYARAN MAKA TAMPILKAN ERR MESSAGE
                    If JmlPoin + Double.Parse(drutama("sipoindidapat")) < Double.Parse(drutama("sibayarpoin")) Then
                        result(2) = "Point Payment exceeds the amount of point collected. Point Payment available " & FormatNumber(JmlPoin + Double.Parse(drutama("sipoindidapat"))) & "" : Trans.Rollback() : GoTo selesai
                    End If
                    'END OF VALIDASI BAYAR DENGAN  POIN ------------------


                    'VALIDASI OUTSTANDING AS (UM PENJ) -------------------
                    'SET VARIABEL
                    'sijmluangmuka(87) As Double                   , siidas(89) As Integer
                    JmlUM = Double.Parse(drutama("sijmluangmuka")) : idAS = drutama("siidas")

                    If idAS <> 0 Then 'AS
                        '1. CEK DATA EXIST
                        ftExistOutstandingAS = IIf(Len(ftExistOutstandingAS.ToString) = 0, "", ftExistOutstandingAS & " UNION ")
                        ftExistOutstandingAS = String.Concat(ftExistOutstandingAS, "SELECT EXISTS(SELECT 1 FROM m5_as WHERE asid = '" & idAS & "' AND (asstatus = 2 OR asstatus = 3 OR asstatus = 4 OR asstatus = 7) LIMIT 1) as rowExists, asid, assumber, asnotransaksi FROM m5_as WHERE asid = '" & idAS & "'")

