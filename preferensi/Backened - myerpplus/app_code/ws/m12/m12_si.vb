        Trans = Con1.BeginTransaction(IsolationLevel.ReadCommitted)

        Dim dtupdate As New DataTable
        Dim rowUpdate As Integer = 0

        Try
            'Proses utama
            If (dtutama.Rows.Count > 0) Then
                Dim drutama As DataRow = dtutama.Rows(0)

                Dim ftExistOutstandingAS As String = "", ftOutstandingAS As String = ""
                Dim updNilaiAS As String = "", updNilaiValasAS As String = ""
                Dim updFilterAS As String = "", updTglLunasAS As String = "", idAS As Integer = 0, MUUtama As String = ""
                Dim JmlUM As Double = 0, Outstanding As Double = 0, OutstandingValas As Double = 0

                'CEK PERIODE AKUNTANSI ==================================
                Dim arrCekPeriode(2) As String 'success(0), errmessage(1)
                Dim rsCekPeriode As String = M2_Accounting_PeriodeCheck(AsFormatTanggal(drutama("sitgl")), AsFormatTanggal(drutama("sitgl")))
                arrCekPeriode = rsCekPeriode.Split(sptSubParam)
                If arrCekPeriode(0) = 0 Then result(2) = arrCekPeriode(1) : Trans.Rollback() : GoTo selesai
                'END OF CEK PERIODE AKUNTANSI ===========================


                'VALIDASI CUSTOMAREA ====================================
                Dim dtCustomArea As DataTable = AsDataTableAmbilDariDB("SELECT skode, snilai FROM `m0_setting` WHERE smodule = 12 AND sgrup = 'custom' AND (skode = 'CustomNama' OR skode = 'CustomWajib')")
                If dtCustomArea.Rows.Count > 0 Then
                    Dim CustomNama As String = "", CustomWajib As String = ""
                    CustomNama = AsDataTableDLookup(dtCustomArea, "snilai", "skode = 'CustomNama'", "")
                    CustomWajib = AsDataTableDLookup(dtCustomArea, "snilai", "skode = 'CustomWajib'", "")
                    If Len(CustomNama) > 0 And CustomWajib = "1" Then
