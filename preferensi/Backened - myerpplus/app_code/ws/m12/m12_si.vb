                        '5. SET NILAI TGLLUNAS TRANSAKSI
                        If MUUtama = MUFungsional Then
                            updTglLunasAS = String.Concat(" WHEN '" & idAS & "' THEN (CASE WHEN ROUND(`as`.asjumlahbayar + '" & Outstanding & "', 5) >= `as`.asjumlah THEN '" & FixQuotes(tglLunas) & "' ELSE `as`.astgllunas END) ", updTglLunasAS)
                        Else
