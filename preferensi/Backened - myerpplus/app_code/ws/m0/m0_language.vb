            'SET IDTRANSAKSI
            idtransaksi = paramSplit(5)
        End If
        'END OF VALIDASI DAN SET IDTRANSAKSI ===============================================

        'PANGGIL QUERY
        Dim query As New m0_query
        sql = "select l.lkode AS lkode, l.lnama AS lnama, s.skode AS sumber, CONCAT('Setting : ', s.smodule, ' - ', s.sgrup, ' - ', s.skode) AS idterkait from m0_setting s join m0_language l on s.smodule = 0 AND s.sgrup = 'company' AND s.skode = 'Bahasa' AND s.snilai = l.lkode WHERE l.lkode = 'valkode' UNION ALL select l.lkode AS lkode, l.lnama AS lnama, 'User' AS sumber, u.ukode AS idterkait from m0_user u join m0_language l on u.ubahasa = l.lkode WHERE l.lkode = 'valkode'"
        sql = sql.Replace("valkode", idtransaksi)

