                saldoAwal = Double.Parse(AsDataTableDLookup(dtSAwal, "arsaldoakhir", "armatauang = '" & uangFungsional & "'", 0))

                'QUERY SALDO MUTASI MATAUANG FUNGSIONAL
                sqlFungsional = " SELECT '" & idLogin & "' as idlogin, '" & FixQuotes(vLokasi) & "' as arlokasi, IFNULL(lc.lnama,'') as arlokasinama, t.tid as arid, DATE_FORMAT(t.ttgl, '%Y-%m-%d') as artgl, t.tsumber as arsumber, t.tnotransaksi as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, t.tnorek as arnorek, '" & uangFungsional & "' as armatauang, '" & kursFungsional & "' as arkurs, t.turaian as aruraian, t.tcatatan as arcatatan, 0 as arsaldoawal, t.tdebit as ardebit, t.tkredit as arkredit, @saldo := @saldo + t.tdebit - t.tkredit as arsaldoakhir, DATE_FORMAT(t.ttgljatuhtempo, '%Y-%m-%d') as artgljatuhtempo, t.tstatuslunas as arstatuslunas, DATE_FORMAT(t.ttgllunas, '%Y-%m-%d') as artgllunas, DATE_FORMAT(t.tinputtgl, '%Y-%m-%d %H:%i:%s') as arinputtgl, 1 as arisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as aruserid FROM m2_transaction_journal t JOIN  m1_contact c ON c.kid = t.tkontak JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' , (SELECT @saldo := " & FixDouble(saldoAwal) & ") AS variableInit1 WHERE  t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " ORDER BY t.ttgl, t.tinputtgl, t.tid"

                'AMBIL SALDO MUTASI MATAUANG FUNGSIONAL
                dtSMutasi = AsDataTableAmbilDariDB(sqlFungsional)
                If dtSMutasi.Rows.Count > 0 Then

                    'AMBIL TRANSAKSI MUTASI MATAUANG VALAS
                    sql = "SELECT t.tmatauang as armatauang FROM m2_transaction_journal t JOIN m1_contact c ON c.kid = t.tkontak JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' WHERE t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) AND t.tmatauang <> '" & uangFungsional & "' " & ftAkunAR & " GROUP BY t.tmatauang"
                    Dim dtUangValas As DataTable = AsDataTableAmbilDariDB(sql)
                    If dtUangValas.Rows.Count > 0 Then
