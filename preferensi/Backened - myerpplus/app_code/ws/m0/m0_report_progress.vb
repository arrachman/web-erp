                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur9) & " = 0 AND " & FixDouble(umur8) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) > " & FixDouble(umur8) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur9) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) > " & FixDouble(umur8) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) <= " & FixDouble(umur9) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur9, "
