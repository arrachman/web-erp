                        strValue.Append("('" & FixQuotes(dr1("idlogin")) & "', '" & FixQuotes(dr1("cpnourut")) & "', '" & FixQuotes(dr1("cpidtransaksi")) & "', '" & FixQuotes(dr1("cpcabang")) & "', '" & FixQuotes(dr1("cplokasi")) & "', '" & FixQuotes(dr1("cpsumber")) & "', '" & FixQuotes(dr1("cpnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(dr1("cptgl"))) & "', '" & FixQuotes(dr1("cpkontak")) & "', '" & FixQuotes(dr1("cpkontakkode")) & "', '" & FixQuotes(dr1("cpkontaknama")) & "', '" & FixQuotes(dr1("cppetugas")) & "', '" & FixQuotes(dr1("cppetugaskode")) & "', '" & FixQuotes(dr1("cppetugasnama")) & "', '" & FixQuotes(dr1("cpuraian")) & "', '" & FixQuotes(dr1("cpcatatan")) & "', '" & FixDouble(dr1("cpmasuk")) & "', '" & FixDouble(dr1("cpkeluar")) & "', '" & FixDouble(dr1("cpsaldo")) & "', '" & FixQuotes(dr1("idmsmq")) & "', '" & FixQuotes(dr1("cpuserid")) & "', '" & FixQuotes(dr1("cpcustomtext1")) & "', '" & FixQuotes(dr1("cpcustomtext2")) & "', '" & FixQuotes(dr1("cpcustomtext3")) & "', '" & FixQuotes(dr1("cpcustomtext4")) & "', '" & FixQuotes(dr1("cpcustomtext5")) & "', " & dr1("cpcustomint1") & ", " & dr1("cpcustomint2") & ", " & dr1("cpcustomint3") & ", " & dr1("cpcustomint4") & ", " & dr1("cpcustomint5") & ", '" & FixDouble(dr1("cpcustomdbl1")) & "', '" & FixDouble(dr1("cpcustomdbl2")) & "', '" & FixDouble(dr1("cpcustomdbl3")) & "', '" & FixDouble(dr1("cpcustomdbl4")) & "', '" & FixDouble(dr1("cpcustomdbl5")) & "', '" & FixQuotes(AsFormatTanggal(dr1("cpcustomdate1"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("cpcustomdate2"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("cpcustomdate3"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("cpcustomdate4"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("cpcustomdate5"))) & "')")
