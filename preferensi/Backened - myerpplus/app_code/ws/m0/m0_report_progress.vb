        'lokasiAwal(4) As String
        lokasiAwal = dataDetail(4)

        'lokasiAkhir(5) As String
        lokasiAkhir = dataDetail(5)

        'customerCatAwal(6) As String
        customerCatAwal = dataDetail(6)

        'customerCatAkhir(7) As String
        customerCatAkhir = dataDetail(7)

        'customerAwal(8) As String
        customerAwal = dataDetail(8)

        'customerAkhir(9) As String
        customerAkhir = dataDetail(9)

        'OrderBy(10) As String
        OrderBy = dataDetail(10)
        If OrderBy.ToLower <> "kkode" And OrderBy.ToLower <> "knama" Then
            result(2) = "Invalid OrderBy criteria." : GoTo selesai
        End If
        'END OF VALIDASI TIPE DATA DETAIL ==================================================


        'TRANSAKSI KE DATABASE =============================================================
        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()

        'HAPUS IDLOGIN PADA M2R_CUSTOMER_POINT ------------------------------------
        'HAPUS DATA BERDASRAKAN IDMSMQ DI M2R_CUSTOMER_POINT
        sql = "DELETE FROM m2r_customer_point WHERE idmsmq = '" & FixQuotes(idMsmq) & "'"
        If AsEksekusiSQL(sql) = False Then
            result(2) = "Failed replace customer point data." : GoTo selesai
        End If
        'END OF HAPUS IDLOGIN PADA M2R_CUSTOMER_POINT -----------------------------

        'BUAT FILTER KONTAK -------------------------------------------------------
        Filter = " WHERE (kkategori = 'C') "
