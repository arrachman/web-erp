                FilterSI = FilterSI & " AND (silokasi >= '" & FixQuotes(lokasiAwal) & "') "
            ElseIf Len(lokasiAkhir) > 0 Then
                FilterCPA = FilterCPA & " AND (cpalokasi <= '" & FixQuotes(lokasiAkhir) & "') "
                FilterSI = FilterSI & " AND (silokasi <= '" & FixQuotes(lokasiAkhir) & "') "
            End If


            'PERULANGAN INSERT M2R_CUSTOMER_POINT PER KONTAK ------------------------
            For Each dr As DataRow In dtKontak.Rows
                'SET CURRENT KONTAK, RESET SALDO AWAL, RESET QUERY, SET STEPKE
                currKontak = dr("kid") : currKode = dr("kkode") : currNama = dr("knama")
                saldoAwal = 0 : strValue.Clear() : stepKe = stepKe + 1

                'AMBIL SALDO AWAL KONTAK
                sql = "  SELECT '" & FixQuotes(idLogin) & "' as idlogin, '1' as cpnourut, '0' as cpidtransaksi, '" & FixQuotes(cabangAwal) & "' as cpcabang, '" & FixQuotes(cabangAkhir) & "' as cplokasi, 'Saldo Awal' as cpsumber, 'Saldo Awal' as cpnotransaksi, '" & AsFormatTanggal(tglAwal) & "' as cptgl, c.kid as cpkontak, c.kkode as cpkontakkode, c.knama as cpkontaknama, '0' as cppetugas, '' as cppetugaskode, '' as cppetugasnama, 'Saldo Awal' as cpuraian, 'Saldo Awal' as cpcatatan, IFNULL(SUM(SAwal.cpmasuk),0) as cpmasuk, IFNULL(SUM(SAwal.cpkeluar),0) as cpkeluar, IFNULL(SUM(SAwal.cpmasuk),0) - IFNULL(SUM(SAwal.cpkeluar),0) as cpsaldo, '" & FixQuotes(idMsmq) & "' as idmsmq, '" & FixDouble(userid) & "' as cpuserid, '' as cpcustomtext1, '' as cpcustomtext2, '' as cpcustomtext3, '' as cpcustomtext4, '' as cpcustomtext5, '0' as cpcustomint1, '0' as cpcustomint2, '0' as cpcustomint3, '0' as cpcustomint4, '0' as cpcustomint5, '0' as cpcustomdbl1, '0' as cpcustomdbl2, '0' as cpcustomdbl3, '0' as cpcustomdbl4, '0' as cpcustomdbl5, '1900-01-01' as cpcustomdate1, '1900-01-01' as cpcustomdate2, '1900-01-01' as cpcustomdate3, '1900-01-01' as cpcustomdate4, '1900-01-01' as cpcustomdate5 "
                sql &= " FROM m1_contact c LEFT JOIN "
                sql &= " ((SELECT cpad.kontak as cpkontak, SUM(cpad.poinmasuk) as cpmasuk, SUM(cpad.poinkeluar) as cpkeluar "
                sql &= " FROM m_12_cpa cpa JOIN m_12_cpa_detail cpad ON cpa.cpaid = cpad.idcpa AND cpa.cpastatus IN(2,3,4,7) "
                sql &= " WHERE cpad.kontak = '" & FixDouble(currKontak) & "' "
