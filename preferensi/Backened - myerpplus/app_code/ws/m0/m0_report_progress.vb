                sqlValasAS &= " AND rp.rptgl BETWEEN '" & FixQuotes(tglAwal) & "' AND '" & FixQuotes(tglAkhir) & "' "
                sqlValasAS &= " AND rp.rpmatauang <> '" & FixQuotes(uangFungsional) & "' "
                sqlValasAS &= " AND (rp.rpstatusbayar <> 2 OR (rp.rpstatusbayar = 2 AND rp.rptgllunas > '" & FixQuotes(tglAkhir) & "')) "
                sqlValasAS &= " AND (CASE LENGTH('" & FixQuotes(matauang) & "') WHEN 0 THEN rp.rpmatauang LIKE '%' ELSE rp.rpmatauang = '" & FixQuotes(matauang) & "' END) "
                'statusJT, 0 = belum, 1 = sudah, 2 = semua
                sqlValasAS &= " AND (CASE '" & FixDouble(statusJT) & "' WHEN 0 THEN rp.rptgljatuhtempo > '" & FixQuotes(tglAkhir) & "' WHEN 1 THEN rp.rptgljatuhtempo <= '" & FixQuotes(tglAkhir) & "' ELSE rp.rptgljatuhtempo LIKE '%' END) "
                sqlValasAS &= " GROUP BY rp.rpid "
                sqlValasAS &= " ORDER BY rp.rptgl, rp.rpinputtgl, rp.rpid "

                'GABUNGKAN SQL
                sqlJadi = " SELECT * FROM ( "
                sqlJadi &= " (" & sqlFungsionalAS & ") "
                sqlJadi &= " UNION ALL "
                sqlJadi &= " (" & sqlValasAS & ") "
                sqlJadi &= " ) as ar "
                sqlJadi &= " ORDER BY ar.artgl, ar.arinputtgl, ar.arsumber, ar.arid, ar.arisfungsional DESC, ar.armatauang "

                'AMBIL SALDO MUTASI
                dtSMutasi = AsDataTableAmbilDariDB(sqlJadi)
                If dtSMutasi.Rows.Count > 0 Then
                    'INSERT SALDO MUTASI KE TABEL PEMBANTU
                    'SORTING DATA TERLEBIH DAHULU
                    dtSMutasi = AsDataTableFilterSortDt(dtSMutasi, "", "artgl, arinputtgl, arsumber, arid, arisfungsional DESC, armatauang")
                    For Each dr1 As DataRow In dtSMutasi.Rows
