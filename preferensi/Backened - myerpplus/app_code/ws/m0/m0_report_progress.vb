                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur7) & " = 0 AND " & FixDouble(umur6) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur6) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur7) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur6) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) <= " & FixDouble(umur7) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur7, "
                'UMUR8          : JIKA UMUR8 = 0 DAN UMUR7 <> 0 DAN TGLJT > UMUR7 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                                 JIKA UMUR8 <> 0 DAN TGLJT > UMUR7 DAN TGLJT <= UMUR8 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur8) & " = 0 AND " & FixDouble(umur7) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur7) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur8) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur7) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) <= " & FixDouble(umur8) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur8, "
                'UMUR9          : JIKA UMUR9 = 0 DAN UMUR8 <> 0 DAN TGLJT > UMUR8 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                                 JIKA UMUR9 <> 0 DAN TGLJT > UMUR8 DAN TGLJT <= UMUR9 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur9) & " = 0 AND " & FixDouble(umur8) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur8) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur9) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur8) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) <= " & FixDouble(umur9) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur9, "
                'UMUR10          : JIKA UMUR10 = 0 DAN UMUR9 <> 0 DAN TGLJT > UMUR9 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                                JIKA UMUR10 <> 0 DAN TGLJT > UMUR9 DAN TGLJT <= UMUR10 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur10) & " = 0 AND " & FixDouble(umur9) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur9) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur10) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur9) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) <= " & FixDouble(umur10) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur10, "
                'UMUR_10          : JIKA UMUR10 <> 0 TGLJT > UMUR10 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur10) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) > " & FixDouble(umur10) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur_10 "

                sqlFungsionalSI &= " FROM m5_pv pv "
                sqlFungsionalSI &= " JOIN m5_pv_detail pvd ON pv.pvid = pvd.idpv AND pv.pvstatus IN(2,3,4,7) AND pv.pvtgl <= '" & FixQuotes(tglAkhir) & "' "
