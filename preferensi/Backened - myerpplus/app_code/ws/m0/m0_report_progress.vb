        stepKe = 3
        Dim sqlBulanIni As String = "SELECT '" & FixDouble(tahun) & "' as pktahun, '" & FixDouble(bulan) & "' as pkbulan, '" & FixQuotes(vDivisi) & "' as pkdivisi, IFNULL(d.dnama,'') as pkdivisinama, c.cnomor as pknorek, c.cnama as pknoreknama, c.ctipe as pktipe, c.cgd as pkgd, c.cjenis as pkjenis, c.clevel as pklevel, c.clevel1 as pklevel1, c.clevel2 as pklevel2, c.clevel3 as pklevel3, c.clevel4 as pklevel4, c.clevel5 as pklevel5, (CASE c.clevel WHEN '" & FixDouble(level) & "' THEN 'D' ELSE 'G' END) AS pkgddata, '" & FixDouble(level) & "' as pkleveldata, (IFNULL(SUM(r.rdjmldebit),0) / " & FixDouble(pembagiNominal) & ") AS pkdebit, (IFNULL(SUM(r.rdjmlkredit),0) / " & FixDouble(pembagiNominal) & ") AS pkkredit, (CASE c.cdc WHEN 'D' THEN (IFNULL(SUM(r.rdjmldebit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rdjmlkredit),0) / " & FixDouble(pembagiNominal) & ") ELSE (IFNULL(SUM(r.rdjmlkredit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rdjmldebit),0) / " & FixDouble(pembagiNominal) & ") END) AS pksaldo FROM m1_coa c LEFT JOIN m2_realization_division r ON c.cnomor = r.rdnorek AND r.rddivisi = '" & FixDouble(vDivisi) & "' AND (r.rdtahun < '" & FixDouble(tahun) & "' or (r.rdtahun = '" & FixDouble(tahun) & "' AND r.rdbulan <= '" & FixDouble(bulan) & "')) LEFT JOIN m1_division d ON d.dkode = '" & FixDouble(vDivisi) & "' WHERE (c.cjenis='A') AND c.clevel <= '" & FixDouble(level) & "' GROUP BY c.cnomor ORDER BY c.cnomor"
