        'validKey = ClsValidKey.ValidateKey(paramSplit(0))
        'If Not validKey.success Then result(2) = validKey.errmessage : GoTo selesai

        'SET IDLOGIN = WEBSITE ACCESS KEY
        idLogin = paramSplit(0)

        ''///Validasi Hak akses. Cek ModuleID dan MenuID
        'If ClsValidKey.ApaBisaAkses(1, 1, 1) = False Then
        '    result(2) = "Access denied for insert/update data"
        'End If
        'END OF VALIDASI WEBSITEACCESSKEY ==================================================


        'VALIDASI DAN SET USERID ===========================================================
        'CEK USERID
        If (IsNumeric(paramSplit(3)) = False) Then
            result(2) = "userid required numeric." : GoTo selesai
        End If

        'SET USERID
        userid = paramSplit(3)
        'END OF VALIDASI DAN SET USERID ====================================================


        'VALIDASI DAN SET DATA =============================================================
        dataSplit = paramSplit(5).Split(sptSubParam)    'SPLIT PARAMETER DATA

        'CEK ARRAY DATA
        If (dataSplit.Length <> 2) Then
            result(2) = "Invalid transaction data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA ======================================================


        'VALIDASI DAN SET DATA UTAMA =======================================================
        dataUtama = dataSplit(0).Split(sptField)    'SPLIT PARAMETER DATA UTAMA

        'CEK ARRAY DATA UTAMA
        If (dataUtama.Length <> 16) Then
            result(2) = "Invalid main transaction data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA UTAMA ================================================


        'VALIDASI TIPE DATA UTAMA ==========================================================
        'ModuleId(0) As Integer
        If (IsNumeric(dataUtama(0)) = False) Then
            result(2) = "ModuleId required numeric." : GoTo selesai
        Else
            ModuleId = dataUtama(0)
        End If

        'MenuName(1) As String
        MenuName = dataUtama(1)

        'Query(2) As String
        If Len(dataUtama(2)) = 0 Then
            result(2) = "Query can't be empty" : GoTo selesai
        Else
            Query = dataUtama(2)
        End If

        'FileFormat(3) As Integer
        If (IsNumeric(dataUtama(3)) = False) Then
            result(2) = "FileFormat required numeric." : GoTo selesai
        Else
            FileFormat = dataUtama(3)
        End If

        'Param1(4) As String
        Param1 = dataUtama(4)

        'Param2(5) As String
        Param2 = dataUtama(5)

        'Param3(6) As String
        Param3 = dataUtama(6)

        'Param4(7) As String
        Param4 = dataUtama(7)

        'Param5(8) As String
        Param5 = dataUtama(8)

        'namaPerusahaan(9) As String 
        namaPerusahaan = dataUtama(9)

        'namaReport(10) As String
        namaReport = dataUtama(10)

        'rp2(11) As String
        rp2 = dataUtama(11)

        'rp3(12) As String
        rp3 = dataUtama(12)

        'rp4(13) As String
        rp4 = dataUtama(13)

        'rp5(14) As String
        rp5 = dataUtama(14)

        'idMsmq(15) As String
        If Len(dataUtama(15)) = 0 Then
            result(2) = "idMsmq can't be empty" : GoTo selesai
        Else
            idMsmq = dataUtama(15)
        End If
        'END OF VALIDASI TIPE DATA UTAMA ===================================================


        'VALIDASI DAN SET DATA DETAIL ======================================================
        dataDetail = dataSplit(1).Split(sptField)    'SPLIT PARAMETER DATA DETAIL

        'CEK ARRAY DATA DETAIL 
        If (dataDetail.Length <> 10) Then
            result(2) = "Invalid detail transaction data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA DETAIL ===============================================


        'VALIDASI TIPE DATA DETAIL =========================================================
        'tglAwal(0) As String
        If Len(dataDetail(0)) > 0 Then
            If (IsDate(dataDetail(0)) = False) Then
                result(2) = "tglAwal required date." : GoTo selesai
            Else
                tglAwal = AsFormatTanggal(dataDetail(0))
            End If
        Else
            tglAwal = AsFormatTanggal("1900-01-01")
        End If

        'tglAkhir(1) As String
        If Len(dataDetail(1)) > 0 Then
            If (IsDate(dataDetail(1)) = False) Then
                result(2) = "tglAkhir required date." : GoTo selesai
            Else
                tglAkhir = AsFormatTanggal(dataDetail(1))
            End If
        Else
            tglAkhir = AsFormatTanggal(Now)
        End If

        'area(2) As String
        'area = dataDetail(2)
        area = ""

        'supplierCategory(3) As String
        supplierCat = dataDetail(3)

        'supplierAwal(4) As String
        supplierAwal = dataDetail(4)

        'supplierAkhir(5) As String
        supplierAkhir = dataDetail(5)

        'salesmanCategory(6) As String
        'salesmanCat = dataDetail(6)
        salesmanCat = ""

        'salesman(7) As String
        'salesman = dataDetail(7)
        salesman = ""

        'matauang(8) As String
        matauang = dataDetail(8)

        'orderBy(9) As String
        If Len(dataDetail(9)) = 0 Then
            result(2) = "orderBy can't be empty." : GoTo selesai
        ElseIf dataDetail(9).ToString <> "kkode" And dataDetail(9).ToString <> "knama" Then
            result(2) = "Invalid orderBy criteria." : GoTo selesai
        Else
            orderBy = dataDetail(9)
        End If
        'END OF VALIDASI TIPE DATA DETAIL ==================================================


        'TRANSAKSI KE DATABASE =============================================================
        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()

        'HAPUS IDLOGIN PADA M2r_Ap_Card ------------------------------------------
        'HAPUS DATA BERDASARKAN IDMSMQ DI M2r_Ap_Card
        sql = "DELETE FROM M2r_Ap_Card WHERE idmsmq = '" & FixQuotes(idMsmq) & "'"
        If AsEksekusiSQL(sql) = False Then
            result(2) = "Failed replace AP Card data." : GoTo selesai
        End If
        'END OF HAPUS IDLOGIN PADA M2r_Ap_Card -----------------------------------


        'AMBIL AKUN KARTU HUTANG, UNTUK FILTER TRANSAKSI ------------------------
        sql = "SELECT snilai FROM m0_setting WHERE (smodule = 0 AND sgrup = 'akun' AND skode = 'HutangUsaha')"
        Dim ftAkunAP As String = ""
        Dim dtAkunAP As DataTable = AsDataTableAmbilDariDB(sql)
        If dtAkunAP.Rows.Count > 0 Then
            'BUAT FILTER AKUN HUTANG PADA TRASAKSI
            For Each dr1 As DataRow In dtAkunAP.Rows
                ftAkunAP += IIf(Len(ftAkunAP) > 0, " OR ", "")
                ftAkunAP += " t.tnorek = '" & dr1("snilai") & "' "
            Next
            If Len(ftAkunAP) > 0 Then ftAkunAP = " AND (" & ftAkunAP & ") "
        Else
            result(2) = "Setting CoA for AP Card not found." : GoTo selesai
        End If
        'END OF AMBIL AKUN KARTU HUTANG, UNTUK FILTER TRANSAKSI -----------------


        'AMBIL DATA SUPPLIER SESUAI FILTER ---------------------------------------
        'KONTAK KATEGORI SUPPLIER, DAN AKUN SESUAI SETTING KARTU HUTANG
        sql = "SELECT c1.kid, c1.kkode, c1.knama FROM m1_contact c1 JOIN m2_transaction_journal t ON c1.kid = t.tkontak LEFT JOIN m1_contact c2 ON c1.ksalesman = c2.kid WHERE (c1.kkategori = 'S') AND t.tstatus IN(2,3,4,7) " & ftAkunAP & " "
        ''TAMBAHKAN FILTER AREA
        'If Len(area) > 0 Then sql += " AND (c1.karea = '" & area & "') "
        'TAMBAHKAN FILTER KATEGORI CUSTOMER
        If Len(supplierCat) > 0 Then sql += " AND (c1.kkategorisupplier = '" & supplierCat & "') "
        'TAMBAHKAN FILTER KODE/NAMA KONTAK
        If Len(supplierAwal) > 0 And Len(supplierAkhir) > 0 Then
            'JIKA SUPPLIER AWAL DAN AKHIR DIISI MAKA FILTER BETWEEN
            sql += " AND (c1." & orderBy & " BETWEEN '" & supplierAwal & "' AND '" & supplierAkhir & "') "
        ElseIf Len(supplierAwal) > 0 Then
            'JIKA SUPPLIER AWAL DIISI MAKA FILTER KONTAK >= SUPPLIER AWAL
            sql += " AND (c1." & orderBy & " >= '" & supplierAwal & "') "
        ElseIf Len(supplierAkhir) > 0 Then
            'JIKA SUPPLIER AKHIR DIISI MAKA FILTER KONTAK <= SUPPLIER AWAL
            sql += " AND (c1." & orderBy & " <= '" & supplierAkhir & "') "
        End If
        ''TAMBAHKAN FILTER KATEGORI SALESMAN
        'If Len(salesmanCat) > 0 Then sql += " AND (c2.kkategorisalesman = '" & salesmanCat & "') "
        ''TAMBAHKAN FILTER SALESMAN
        'If Len(salesman) > 0 Then sql += " AND (c2." & orderBy & " = '" & salesman & "') "
        'TAMBAHKAN GROUPING
        sql += " GROUP BY c1.kid "
        'TAMBAHKAN SORTING
        sql += " ORDER BY c1." & orderBy & ""

        Dim dtSupplier As DataTable = AsDataTableAmbilDariDB(sql)
        'END OF AMBIL DATA SUPPLIER SESUAI FILTER --------------------------------


        'PERHITUNGAN KARTU PER KONTAK --------------------------------------------
        If dtSupplier.Rows.Count > 0 Then

            'AMBIL MATAUANG FUNGSIONAL DARI SETTING
            Dim dtMatauang As DataTable = AsDataTableAmbilDariDB("SELECT skode, snilai FROM m0_setting WHERE smodule = 0 AND sgrup = 'accounting' AND (skode = 'MataUangFungsional' OR skode = 'Kurs')")
            Dim uangFungsional As String = AsDataTableDLookup(dtMatauang, "snilai", "skode = 'MataUangFungsional'", "Not found")
            If uangFungsional = "Not found" Then
                result(2) = "Setting Functional Currency not found." : GoTo selesai
            End If
            Dim kursFungsional As String = AsDataTableDLookup(dtMatauang, "snilai", "skode = 'Kurs'", "Not found")
            If kursFungsional = "Not found" Then
                result(2) = "Setting Exchange Rate Functional Currency not found." : GoTo selesai
            End If

            Dim dtSAwal As New DataTable, dtSMutasi As New DataTable, dtSMutasiTemp As New DataTable, dtSAkhir As New DataTable
            Dim sqlFungsional As String = "", sqlValas As String = "", sqlJadi As String = ""
            Dim urut As Double = 1, idkontak As String = ""

            'PERULANGAN HITUNG KARTU PER KONTAK ++++++++++++++++++++++++++
            For Each dr As DataRow In dtSupplier.Rows
                'SET IDKONTAK
                idkontak = dr("kid")

                'RESET QUERY INSERT, SET STEPKE
                strValue.Clear() : stepKe = stepKe + 1

                'SALDO AWAL =========================================
                'QUERY SALDO AWAL
                sqlFungsional = " SELECT 0 as apid, '" & tglAwal & "' as aptgl, '' as apsumber, '' as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, '' as apnorek, '" & uangFungsional & "' as apmatauang, '" & kursFungsional & "' as apkurs, 'Saldo Awal' as apuraian, 'Saldo Awal' as  apcatatan, 0 as apsaldoawal, IFNULL(SUM(t.tdebit),0) as apdebit, IFNULL(SUM(t.tkredit),0) as apkredit, IFNULL(SUM(t.tkredit),0) - IFNULL(SUM(t.tdebit),0) as apsaldoakhir, '1900-01-01' as aptgljatuhtempo, 0 as apstatuslunas, '1900-01-01' as aptgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as apinputtgl, 1 as apisfungsional FROM m1_contact c JOIN m2_transaction_journal t ON c.kid = t.tkontak AND t.tstatus IN(2,3,4,7) AND t.ttgl < '" & tglAwal & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAP & " WHERE c.kid = '" & idkontak & "'"
                sqlValas = " SELECT 0 as apid, '" & tglAwal & "' as aptgl, '' as apsumber, '' as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, '' as apnorek, t.tmatauang as apmatauang, t.tkurs as apkurs, 'Saldo Awal' as apuraian, 'Saldo Awal' as  apcatatan, 0 as apsaldoawal, IFNULL(SUM(t.tdebitvalas),0) as apdebit, IFNULL(SUM(t.tkreditvalas),0) as apkredit, IFNULL(SUM(t.tkreditvalas),0) - IFNULL(SUM(t.tdebitvalas),0) as apsaldoakhir, '1900-01-01' as aptgljatuhtempo, 0 as apstatuslunas, '1900-01-01' as aptgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as apinputtgl, 0 as apisfungsional FROM m2_transaction_journal t JOIN m1_contact c ON t.tkontak = c.kid WHERE c.kid = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl < '" & tglAwal & "' AND t.tmatauang <> '" & uangFungsional & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAP & " GROUP BY t.tmatauang"
                sqlJadi = " SELECT '" & idLogin & "' as idlogin, apid, aptgl, apsumber, apnotransaksi, apkontak, apkontakkode, apkontaknama, apalamat1, apalamat2, apalamat3, apalamat4, apalamat5, apnotelp1, apnotelp2, apnorek, apmatauang, apkurs, apuraian, apcatatan, apsaldoawal, apdebit, apkredit, apsaldoakhir, aptgljatuhtempo, apstatuslunas, aptgllunas, apinputtgl, apisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as apuserid FROM "
                sqlJadi += " ((" & sqlFungsional & ") UNION ALL (" & sqlValas & ")) as SAwal"
                sqlJadi += " ORDER BY apmatauang = '" & uangFungsional & "' DESC, apmatauang ASC"

                'AMBIL SALDO AWAL
                dtSAwal = AsDataTableAmbilDariDB(sqlJadi)
                If dtSAwal.Rows.Count > 0 Then
                    'INSERT SALDO AWAL KE TABEL PEMBANTU
                    For Each dr1 As DataRow In dtSAwal.Rows
                        'BUAT QUERY INSERT KE TABEL PEMBANTU
                        strValue.Append(IIf(Len(strValue.ToString) = 0, "", ", "))
                        'MAPPING :         apnourut,                          idlogin,                             apid,                                             aptgl,                              apsumber,                             apnotransaksi,                             apkontak,                             apkontakkode,                             apkontaknama,                             apalamat1,                             apalamat2,                             apalamat3,                             apalamat4,                             apalamat5,                             apnotelp1,                             apnotelp2,                             apnorek,                             apmatauang,                             apkurs,                             apuraian,                             apcatatan,                             apsaldoawal,                             apdebit,                             apkredit,                             apsaldoakhir,                                             aptgljatuhtempo,                   apstatuslunas,                                           aptgllunas,                                              apinputtgl,                                         apisfungsional,           apissaldoakhir,                       idmsmq,                             apuserid,                   apcustomtext1,           apcustomtext2,           apcustomtext3,           apcustomtext4,           apcustomtext5,apcustomint1,apcustomint2,apcustomint3,apcustomint4,apcustomint5, apcustomdbl1,           apcustomdbl2,           apcustomdbl3,           apcustomdbl4,           apcustomdbl5,                                      apcustomdate1,                                      apcustomdate2,                                      apcustomdate3,                                      apcustomdate4,                                      apcustomdate5
                        strValue.Append("('" & urut & "', '" & FixQuotes(dr1("idlogin")) & "', '" & FixQuotes(dr1("apid")) & "', '" & FixQuotes(AsFormatTanggal(dr1("aptgl"))) & "', '" & FixQuotes(dr1("apsumber")) & "', '" & FixQuotes(dr1("apnotransaksi")) & "', '" & FixQuotes(dr1("apkontak")) & "', '" & FixQuotes(dr1("apkontakkode")) & "', '" & FixQuotes(dr1("apkontaknama")) & "', '" & FixQuotes(dr1("apalamat1")) & "', '" & FixQuotes(dr1("apalamat2")) & "', '" & FixQuotes(dr1("apalamat3")) & "', '" & FixQuotes(dr1("apalamat4")) & "', '" & FixQuotes(dr1("apalamat5")) & "', '" & FixQuotes(dr1("apnotelp1")) & "', '" & FixQuotes(dr1("apnotelp2")) & "', '" & FixQuotes(dr1("apnorek")) & "', '" & FixQuotes(dr1("apmatauang")) & "', '" & FixQuotes(dr1("apkurs")) & "', '" & FixQuotes(dr1("apuraian")) & "', '" & FixQuotes(dr1("apcatatan")) & "', '" & FixDouble(dr1("apsaldoawal")) & "', '" & FixDouble(dr1("apdebit")) & "', '" & FixDouble(dr1("apkredit")) & "', '" & FixDouble(dr1("apsaldoakhir")) & "', '" & FixQuotes(AsFormatTanggal(dr1("aptgljatuhtempo"))) & "', " & dr1("apstatuslunas") & ", '" & FixQuotes(AsFormatTanggal(dr1("aptgllunas"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("apinputtgl"), "yyyy-MM-dd H:mm:ss")) & "', " & dr1("apisfungsional") & ", " & FixDouble(0) & ", '" & FixQuotes(dr1("idmsmq")) & "', '" & FixQuotes(dr1("apuserid")) & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "')")

                        'INCREMENT NOURUT
                        urut += 1
                    Next
                End If
                'END OF SALDO AWAL ==================================


                'SALDO MUTASI =======================================
                Dim saldoAwal As Double = 0, saldoDebit As Double = 0, saldoKredit As Double = 0

                'AMBIL SALDO AWAL DARI DTSAWAL
                saldoAwal = Double.Parse(AsDataTableDLookup(dtSAwal, "apsaldoakhir", "apmatauang = '" & uangFungsional & "'", 0))

                'QUERY SALDO MUTASI MATAUANG FUNGSIONAL
                sqlFungsional = " SELECT '" & idLogin & "' as idlogin, t.tid as apid, DATE_FORMAT(t.ttgl, '%Y-%m-%d') as aptgl, t.tsumber as apsumber, t.tnotransaksi as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, t.tnorek as apnorek, '" & uangFungsional & "' as apmatauang, '" & kursFungsional & "' as apkurs, t.turaian as apuraian, t.tcatatan as apcatatan, 0 as apsaldoawal, t.tdebit as apdebit, t.tkredit as apkredit, @saldo := @saldo + t.tkredit - t.tdebit as apsaldoakhir, DATE_FORMAT(t.ttgljatuhtempo, '%Y-%m-%d') as aptgljatuhtempo, t.tstatuslunas as apstatuslunas, DATE_FORMAT(t.ttgllunas, '%Y-%m-%d') as aptgllunas, DATE_FORMAT(t.tinputtgl, '%Y-%m-%d %H:%i:%s') as apinputtgl, 1 as apisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as apuserid FROM m2_transaction_journal t JOIN  m1_contact c ON c.kid = t.tkontak, (SELECT @saldo := " & FixDouble(saldoAwal) & ") AS variableInit1 WHERE  t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAP & " ORDER BY t.ttgl, t.tinputtgl, t.tid"

                'AMBIL SALDO MUTASI MATAUANG FUNGSIONAL
                dtSMutasi = AsDataTableAmbilDariDB(sqlFungsional)
                If dtSMutasi.Rows.Count > 0 Then

                    'AMBIL TRANSAKSI MUTASI MATAUANG VALAS
                    sql = "SELECT t.tmatauang as apmatauang FROM m2_transaction_journal t JOIN m1_contact c ON c.kid = t.tkontak WHERE t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) AND t.tmatauang <> '" & uangFungsional & "' " & ftAkunAP & " GROUP BY t.tmatauang"
                    Dim dtUangValas As DataTable = AsDataTableAmbilDariDB(sql)
                    If dtUangValas.Rows.Count > 0 Then
                        Dim uangValas As String = ""

                        'PERULANGAN AMBIL TRANSAKSI VALAS
                        For Each dr1 As DataRow In dtUangValas.Rows
                            'SET MATAUANG VALAS
                            uangValas = dr1("apmatauang")

                            'AMBIL SALDO AWAL DARI DTSAWAL
                            saldoAwal = Double.Parse(AsDataTableDLookup(dtSAwal, "apsaldoakhir", "apmatauang = '" & uangValas & "'", 0))

                            'AMBIL TRANSAKSI MUTASI PER MATAUANG
                            sqlValas = " SELECT '" & idLogin & "' as idlogin, t.tid as apid, DATE_FORMAT(t.ttgl, '%Y-%m-%d') as aptgl, t.tsumber as apsumber, t.tnotransaksi as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, t.tnorek as apnorek, t.tmatauang as apmatauang, t.tkurs as apkurs, t.turaian as apuraian, t.tcatatan as  apcatatan, 0 as apsaldoawal, t.tdebitvalas as apdebit, t.tkreditvalas as apkredit, @saldo := @saldo + t.tkreditvalas - t.tdebitvalas as apsaldoakhir, DATE_FORMAT(t.ttgljatuhtempo, '%Y-%m-%d') as aptgljatuhtempo, t.tstatuslunas as apstatuslunas, DATE_FORMAT(t.ttgllunas, '%Y-%m-%d') as aptgllunas, DATE_FORMAT(t.tinputtgl, '%Y-%m-%d %H:%i:%s')  as apinputtgl, 0 as apisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as apuserid FROM m2_transaction_journal t JOIN  m1_contact c ON c.kid = t.tkontak, (SELECT @saldo := " & FixDouble(saldoAwal) & ") AS variableInit1 WHERE t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND t.tmatauang = '" & uangValas & "' " & ftAkunAP & " ORDER BY t.ttgl, t.tinputtgl, t.tid"
                            dtSMutasiTemp = AsDataTableAmbilDariDB(sqlValas)

                            'COPY MUTASI VALAS KE MUTASI FUNGSIONAL
                            dtSMutasi.Merge(dtSMutasiTemp, True, MissingSchemaAction.Ignore)
                        Next
                    End If

                    'INSERT SALDO MUTASI KE TABEL PEMBANTU
                    'SORTING DATA TERLEBIH DAHULU
                    dtSMutasi = AsDataTableFilterSortDt(dtSMutasi, "", "aptgl, apinputtgl, apid, apisfungsional DESC, apmatauang")
                    For Each dr1 As DataRow In dtSMutasi.Rows
