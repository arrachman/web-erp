        Dim dtGiro As DataTable = AsDataTableAmbilDariDB("SELECT snilai FROM m0_setting WHERE smodule = 0 AND sgrup = 'akun' AND (skode = 'GiroMasuk' OR skode = 'GiroKeluar')")
