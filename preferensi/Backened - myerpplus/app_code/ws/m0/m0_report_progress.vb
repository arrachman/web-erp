                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur3) & " = 0 AND " & FixDouble(umur4) & " = 0 THEN 0 WHEN " & FixDouble(umur3) & " = 0 AND " & FixDouble(umur4) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur4) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur3) & " <> 0 AND " & FixDouble(umur4) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur4) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) >= " & FixDouble(umur3) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur3, "
