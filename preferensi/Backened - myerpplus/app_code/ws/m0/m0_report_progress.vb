                sqlValasSR &= " (CASE WHEN " & FixDouble(umur8) & " = 0 AND " & FixDouble(umur7) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',sr.srtgljatuhtempo) > " & FixDouble(umur7) & " THEN (sr.srtotaltransaksi * -1) - (CASE sr.srmatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar * -1),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas * -1),0) END) WHEN " & FixDouble(umur8) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',sr.srtgljatuhtempo) > " & FixDouble(umur7) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',sr.srtgljatuhtempo) <= " & FixDouble(umur8) & " THEN (sr.srtotaltransaksi * -1) - (CASE sr.srmatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar * -1),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas * -1),0) END) ELSE 0 END) as arumur8, "
