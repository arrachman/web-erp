                    strValue.Append("('" & urut & "', '" & FixQuotes(idLogin) & "', '" & FixQuotes(dr1("apid")) & "', '" & FixQuotes(AsFormatTanggal(dr1("aptgl"))) & "', '" & FixQuotes(dr1("apsumber")) & "', '" & FixQuotes(dr1("apnotransaksi")) & "', '" & FixQuotes(dr1("apkontak")) & "', '" & FixQuotes(dr1("apkontakkode")) & "', '" & FixQuotes(dr1("apkontaknama")) & "', '" & FixQuotes(dr1("apalamat1")) & "', '" & FixQuotes(dr1("apalamat2")) & "', '" & FixQuotes(dr1("apalamat3")) & "', '" & FixQuotes(dr1("apalamat4")) & "', '" & FixQuotes(dr1("apalamat5")) & "', '" & FixQuotes(dr1("apnotelp1")) & "', '" & FixQuotes(dr1("apnotelp2")) & "', '" & FixQuotes(dr1("apnorek")) & "', '" & FixQuotes(dr1("apmatauang")) & "', '" & FixQuotes(dr1("apkurs")) & "', '" & FixQuotes(dr1("apuraian")) & "', '" & FixQuotes(dr1("apcatatan")) & "', '" & FixDouble(dr1("aptotal")) & "', '" & FixDouble(dr1("apbayar")) & "', '" & FixDouble(dr1("apsisa")) & "', '" & FixQuotes(AsFormatTanggal(dr1("aptgljatuhtempo"))) & "', " & dr1("apstatuslunas") & ", '" & FixQuotes(AsFormatTanggal(dr1("aptgllunas"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("apinputtgl"), "yyyy-MM-dd H:mm:ss")) & "', " & dr1("apisfungsional") & ", " & FixDouble(urutSAkhir) & ", '" & FixQuotes(idMsmq) & "', '" & FixQuotes(userid) & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "')")

                    'INCREMENT NOURUT SALDO AKHIR
