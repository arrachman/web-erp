                sqlValasPRT &= " (CASE WHEN " & FixDouble(umur5) & " = 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',prt.prttgljatuhtempo) < 0 THEN (prt.prttotaltransaksi * -1) - (CASE prt.prtmatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar * -1),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas * -1),0) END) WHEN " & FixDouble(umur5) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',prt.prttgljatuhtempo) < 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',prt.prttgljatuhtempo) >= " & FixDouble(umur5) & " THEN (prt.prttotaltransaksi * -1) - (CASE prt.prtmatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar * -1),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas * -1),0) END) ELSE 0 END) as apumur5, "
