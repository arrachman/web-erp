                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur4) & " = 0 AND " & FixDouble(umur5) & " = 0 THEN 0 WHEN " & FixDouble(umur4) & " = 0 AND " & FixDouble(umur5) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur5) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur4) & " <> 0 AND " & FixDouble(umur5) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur5) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) >= " & FixDouble(umur4) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur4, "
                'UMUR5          : JIKA UMUR5 = 0 DAN TGLJT < 0 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                           JIKA UMUR5 <> 0 DAN TGLJT < 0 DAN TGLJT >= UMUR5 MAKA TAMPILKAN SISA 
                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur5) & " = 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < 0 THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur5) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) >= " & FixDouble(umur5) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur5, "
