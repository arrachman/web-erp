        Else
            orderBy = dataDetail(9)
        End If
        'END OF VALIDASI TIPE DATA DETAIL ==================================================


        'TRANSAKSI KE DATABASE =============================================================
        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()

        'HAPUS IDLOGIN PADA M2r_Umpenjualan_Card ------------------------------------------
        'HAPUS DATA BERDASARKAN IDMSMQ DI M2r_Umpenjualan_Card
        sql = "DELETE FROM M2r_Umpenjualan_Card WHERE idmsmq = '" & FixQuotes(idMsmq) & "'"
        If AsEksekusiSQL(sql) = False Then
            result(2) = "Failed replace Advance Sales Card data." : GoTo selesai
        End If
        'END OF HAPUS IDLOGIN PADA M2r_Umpenjualan_Card -----------------------------------


        'AMBIL AKUN KARTU UM PENJUALAN, UNTUK FILTER TRANSAKSI ------------------------
        sql = "SELECT snilai FROM m0_setting WHERE (smodule = 0 AND sgrup = 'akun' AND skode = 'UMPenjualan')"
        Dim ftAkunAR As String = ""
        Dim dtAkunAR As DataTable = AsDataTableAmbilDariDB(sql)
        If dtAkunAR.Rows.Count > 0 Then
            'BUAT FILTER AKUN UM PENJUALAN PADA TRASAKSI
            For Each dr1 As DataRow In dtAkunAR.Rows
                ftAkunAR += IIf(Len(ftAkunAR) > 0, " OR ", "")
