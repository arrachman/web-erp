                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur10) & " = 0 AND " & FixDouble(umur9) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) > " & FixDouble(umur9) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur10) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) > " & FixDouble(umur9) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) <= " & FixDouble(umur10) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur10, "
                'UMUR_10          : JIKA UMUR10 <> 0 TGLJT > UMUR10 MAKA TAMPILKAN SISA
                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur10) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) > " & FixDouble(umur10) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur_10 "

                sqlFungsionalRI &= " FROM m4_vp vp "
