                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur7) & " = 0 AND " & FixDouble(umur6) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) > " & FixDouble(umur6) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur7) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) > " & FixDouble(umur6) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) <= " & FixDouble(umur7) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur7, "
