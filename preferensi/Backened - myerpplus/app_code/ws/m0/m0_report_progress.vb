        'Dim ClsValidKey As New ClsSecurity
        'Dim validKey As RsValidKey
        'validKey = ClsValidKey.ValidateKey(paramSplit(0))
        'If Not validKey.success Then result(2) = validKey.errmessage : GoTo selesai

        'SET IDLOGIN = WEBSITE ACCESS KEY
        idLogin = paramSplit(0)

        ''///Validasi Hak akses. Cek ModuleID dan MenuID
        'If ClsValidKey.ApaBisaAkses(1, 1, 1) = False Then
        '    result(2) = "Access denied for insert/update data"
        'End If
        'END OF VALIDASI WEBSITEACCESSKEY ==================================================


        'VALIDASI DAN SET USERID ===========================================================
        'CEK USERID
        If (IsNumeric(paramSplit(3)) = False) Then
            result(2) = "userid required numeric." : GoTo selesai
        End If

        'SET USERID
        userid = paramSplit(3)
        'END OF VALIDASI DAN SET USERID ====================================================


        'VALIDASI DAN SET DATA =============================================================
        dataSplit = paramSplit(5).Split(sptSubParam)    'SPLIT PARAMETER DATA

        'CEK ARRAY DATA
        If (dataSplit.Length <> 2) Then
            result(2) = "Invalid transaction data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA ======================================================


        'VALIDASI DAN SET DATA UTAMA =======================================================
        dataUtama = dataSplit(0).Split(sptField)    'SPLIT PARAMETER DATA UTAMA

        'CEK ARRAY DATA UTAMA
        If (dataUtama.Length <> 16) Then
            result(2) = "Invalid main transaction data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA UTAMA ================================================


        'VALIDASI TIPE DATA UTAMA ==========================================================
        'ModuleId(0) As Integer
        If (IsNumeric(dataUtama(0)) = False) Then
            result(2) = "ModuleId required numeric." : GoTo selesai
        Else
            ModuleId = dataUtama(0)
        End If

        'MenuName(1) As String
        MenuName = dataUtama(1)

        'Query(2) As String
        If Len(dataUtama(2)) = 0 Then
            result(2) = "Query can't be empty" : GoTo selesai
        Else
            Query = dataUtama(2)
        End If

        'FileFormat(3) As Integer
        If (IsNumeric(dataUtama(3)) = False) Then
            result(2) = "FileFormat required numeric." : GoTo selesai
        Else
            FileFormat = dataUtama(3)
        End If

        'Param1(4) As String
        Param1 = dataUtama(4)

        'Param2(5) As String
        Param2 = dataUtama(5)

        'Param3(6) As String
        Param3 = dataUtama(6)

        'Param4(7) As String
        Param4 = dataUtama(7)

        'Param5(8) As String
        Param5 = dataUtama(8)

        'namaPerusahaan(9) As String 
        namaPerusahaan = dataUtama(9)

        'namaReport(10) As String
        namaReport = dataUtama(10)

        'rp2(11) As String
        rp2 = dataUtama(11)

        'rp3(12) As String
        rp3 = dataUtama(12)

        'rp4(13) As String
        rp4 = dataUtama(13)

        'rp5(14) As String
        rp5 = dataUtama(14)

        'idMsmq(15) As String
        If Len(dataUtama(15)) = 0 Then
            result(2) = "idMsmq can't be empty" : GoTo selesai
        Else
            idMsmq = dataUtama(15)
        End If
        'END OF VALIDASI TIPE DATA UTAMA ===================================================


        'VALIDASI DAN SET DATA DETAIL ======================================================
        dataDetail = dataSplit(1).Split(sptField)    'SPLIT PARAMETER DATA DETAIL

        'CEK ARRAY DATA DETAIL 
        If (dataDetail.Length <> 10) Then
            result(2) = "Invalid detail transaction data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA DETAIL ===============================================


        'VALIDASI TIPE DATA DETAIL =========================================================
        'tglAwal(0) As String
        If Len(dataDetail(0)) > 0 Then
            If (IsDate(dataDetail(0)) = False) Then
                result(2) = "tglAwal required date." : GoTo selesai
            Else
                tglAwal = AsFormatTanggal(dataDetail(0))
            End If
        Else
            tglAwal = AsFormatTanggal("1900-01-01")
        End If

        'tglAkhir(1) As String
        If Len(dataDetail(1)) > 0 Then
            If (IsDate(dataDetail(1)) = False) Then
                result(2) = "tglAkhir required date." : GoTo selesai
            Else
                tglAkhir = AsFormatTanggal(dataDetail(1))
            End If
        Else
            tglAkhir = AsFormatTanggal(Now)
        End If

        'area(2) As String
        area = dataDetail(2)

        'customerCategory(3) As String
        customerCat = dataDetail(3)

        'customerAwal(4) As String
        customerAwal = dataDetail(4)

        'customerAkhir(5) As String
        customerAkhir = dataDetail(5)

        'salesmanCategory(6) As String
        salesmanCat = dataDetail(6)

        'salesman(7) As String
        salesman = dataDetail(7)

        'matauang(8) As String
        matauang = dataDetail(8)

        'orderBy(9) As String
        If Len(dataDetail(9)) = 0 Then
            result(2) = "orderBy can't be empty." : GoTo selesai
        ElseIf dataDetail(9).ToString <> "kkode" And dataDetail(9).ToString <> "knama" Then
            result(2) = "Invalid orderBy criteria." : GoTo selesai
        Else
            orderBy = dataDetail(9)
        End If
        'END OF VALIDASI TIPE DATA DETAIL ==================================================


        'TRANSAKSI KE DATABASE =============================================================
        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()

        'HAPUS IDLOGIN PADA M2r_Ip_Card ------------------------------------------
        'HAPUS DATA BERDASARKAN IDMSMQ DI M2r_Ip_Card
        sql = "DELETE FROM M2r_Ip_Card WHERE idmsmq = '" & FixQuotes(idMsmq) & "'"
        If AsEksekusiSQL(sql) = False Then
            result(2) = "Failed replace Incoming Payment Card data." : GoTo selesai
        End If
        'END OF HAPUS IDLOGIN PADA M2r_Ip_Card -----------------------------------


        'AMBIL AKUN KARTU TERIMA PEMBAYARAN, UNTUK FILTER TRANSAKSI ------------------------
        sql = "SELECT snilai FROM m0_setting WHERE (smodule = 0 AND sgrup = 'akun' AND skode = 'TransitTerimaUang')"
        Dim ftAkunAR As String = ""
        Dim dtAkunAR As DataTable = AsDataTableAmbilDariDB(sql)
        If dtAkunAR.Rows.Count > 0 Then
            'BUAT FILTER AKUN TERIMA PEMBAYARAN PADA TRASAKSI
            For Each dr1 As DataRow In dtAkunAR.Rows
                ftAkunAR += IIf(Len(ftAkunAR) > 0, " OR ", "")
                ftAkunAR += " t.tnorek = '" & dr1("snilai") & "' "
            Next
            If Len(ftAkunAR) > 0 Then ftAkunAR = " AND (" & ftAkunAR & ") "
        Else
            result(2) = "Setting CoA for Incoming Payment Card not found." : GoTo selesai
        End If
        'END OF AMBIL AKUN KARTU TERIMA PEMBAYARAN, UNTUK FILTER TRANSAKSI -----------------


        'AMBIL DATA CUSTOMER SESUAI FILTER ---------------------------------------
        'KONTAK KATEGORI CUSTOMER, DAN AKUN SESUAI SETTING KARTU TERIMA PEMBAYARAN
        sql = "SELECT c1.kid, c1.kkode, c1.knama FROM m1_contact c1 JOIN m2_transaction_journal t ON c1.kid = t.tkontak LEFT JOIN m1_contact c2 ON c1.ksalesman = c2.kid WHERE (c1.kkategori = 'C') AND t.tstatus IN(2,3,4,7) " & ftAkunAR & " "
        'TAMBAHKAN FILTER AREA
        If Len(area) > 0 Then sql += " AND (c1.karea = '" & area & "') "
        'TAMBAHKAN FILTER KATEGORI CUSTOMER
        If Len(customerCat) > 0 Then sql += " AND (c1.kkategoricustomer = '" & customerCat & "') "
        'TAMBAHKAN FILTER KODE/NAMA KONTAK
        If Len(customerAwal) > 0 And Len(customerAkhir) > 0 Then
            'JIKA CUSTOMER AWAL DAN AKHIR DIISI MAKA FILTER BETWEEN
            sql += " AND (c1." & orderBy & " BETWEEN '" & customerAwal & "' AND '" & customerAkhir & "') "
        ElseIf Len(customerAwal) > 0 Then
            'JIKA CUSTOMER AWAL DIISI MAKA FILTER KONTAK >= CUSTOMER AWAL
            sql += " AND (c1." & orderBy & " >= '" & customerAwal & "') "
        ElseIf Len(customerAkhir) > 0 Then
            'JIKA CUSTOMER AKHIR DIISI MAKA FILTER KONTAK <= CUSTOMER AWAL
            sql += " AND (c1." & orderBy & " <= '" & customerAkhir & "') "
        End If
        'TAMBAHKAN FILTER KATEGORI SALESMAN
        If Len(salesmanCat) > 0 Then sql += " AND (c2.kkategorisalesman = '" & salesmanCat & "') "
        'TAMBAHKAN FILTER SALESMAN
        If Len(salesman) > 0 Then sql += " AND (c2." & orderBy & " = '" & salesman & "') "
        'TAMBAHKAN GROUPING
        sql += " GROUP BY c1.kid "
        'TAMBAHKAN SORTING
        sql += " ORDER BY c1." & orderBy & ""

        Dim dtCustomer As DataTable = AsDataTableAmbilDariDB(sql)
        'END OF AMBIL DATA CUSTOMER SESUAI FILTER --------------------------------


        'PERHITUNGAN KARTU PER KONTAK --------------------------------------------
        If dtCustomer.Rows.Count > 0 Then

            'AMBIL MATAUANG FUNGSIONAL DARI SETTING
            Dim dtMatauang As DataTable = AsDataTableAmbilDariDB("SELECT skode, snilai FROM m0_setting WHERE smodule = 0 AND sgrup = 'accounting' AND (skode = 'MataUangFungsional' OR skode = 'Kurs')")
            Dim uangFungsional As String = AsDataTableDLookup(dtMatauang, "snilai", "skode = 'MataUangFungsional'", "Not found")
            If uangFungsional = "Not found" Then
                result(2) = "Setting Functional Currency not found." : GoTo selesai
            End If
            Dim kursFungsional As String = AsDataTableDLookup(dtMatauang, "snilai", "skode = 'Kurs'", "Not found")
            If kursFungsional = "Not found" Then
                result(2) = "Setting Exchange Rate Functional Currency not found." : GoTo selesai
            End If

            Dim dtSAwal As New DataTable, dtSMutasi As New DataTable, dtSMutasiTemp As New DataTable, dtSAkhir As New DataTable
            Dim sqlFungsional As String = "", sqlValas As String = "", sqlJadi As String = ""
            Dim urut As Double = 1, idkontak As String = ""

            'PERULANGAN HITUNG KARTU PER KONTAK ++++++++++++++++++++++++++
            For Each dr As DataRow In dtCustomer.Rows
                'SET IDKONTAK
                idkontak = dr("kid")

                'RESET QUERY INSERT, SET STEPKE
                strValue.Clear() : stepKe = stepKe + 1

                'SALDO AWAL =========================================
                'QUERY SALDO AWAL
                sqlFungsional = " SELECT 0 as arid, '" & tglAwal & "' as artgl, '' as arsumber, '' as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, '' as arnorek, '" & uangFungsional & "' as armatauang, '" & kursFungsional & "' as arkurs, 'Saldo Awal' as aruraian, 'Saldo Awal' as  arcatatan, 0 as arsaldoawal, IFNULL(SUM(t.tdebit),0) as ardebit, IFNULL(SUM(t.tkredit),0) as arkredit, IFNULL(SUM(t.tkredit),0) - IFNULL(SUM(t.tdebit),0) as arsaldoakhir, '1900-01-01' as artgljatuhtempo, 0 as arstatuslunas, '1900-01-01' as artgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as arinputtgl, 1 as arisfungsional FROM m1_contact c JOIN m2_transaction_journal t ON c.kid = t.tkontak AND t.tstatus IN(2,3,4,7) AND t.ttgl < '" & tglAwal & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " WHERE c.kid = '" & idkontak & "'"
                sqlValas = " SELECT 0 as arid, '" & tglAwal & "' as artgl, '' as arsumber, '' as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, '' as arnorek, t.tmatauang as armatauang, t.tkurs as arkurs, 'Saldo Awal' as aruraian, 'Saldo Awal' as  arcatatan, 0 as arsaldoawal, IFNULL(SUM(t.tdebitvalas),0) as ardebit, IFNULL(SUM(t.tkreditvalas),0) as arkredit, IFNULL(SUM(t.tkreditvalas),0) - IFNULL(SUM(t.tdebitvalas),0) as arsaldoakhir, '1900-01-01' as artgljatuhtempo, 0 as arstatuslunas, '1900-01-01' as artgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as arinputtgl, 0 as arisfungsional FROM m2_transaction_journal t JOIN m1_contact c ON t.tkontak = c.kid WHERE c.kid = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl < '" & tglAwal & "' AND t.tmatauang <> '" & uangFungsional & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " GROUP BY t.tmatauang"
                sqlJadi = " SELECT '" & idLogin & "' as idlogin, arid, artgl, arsumber, arnotransaksi, arkontak, arkontakkode, arkontaknama, aralamat1, aralamat2, aralamat3, aralamat4, aralamat5, arnotelp1, arnotelp2, arnorek, armatauang, arkurs, aruraian, arcatatan, arsaldoawal, ardebit, arkredit, arsaldoakhir, artgljatuhtempo, arstatuslunas, artgllunas, arinputtgl, arisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as aruserid FROM "
                sqlJadi += " ((" & sqlFungsional & ") UNION ALL (" & sqlValas & ")) as SAwal"
                sqlJadi += " ORDER BY armatauang = '" & uangFungsional & "' DESC, armatauang ASC"

                'AMBIL SALDO AWAL
                dtSAwal = AsDataTableAmbilDariDB(sqlJadi)
                If dtSAwal.Rows.Count > 0 Then
                    'INSERT SALDO AWAL KE TABEL PEMBANTU
                    For Each dr1 As DataRow In dtSAwal.Rows
                        'BUAT QUERY INSERT KE TABEL PEMBANTU
                        strValue.Append(IIf(Len(strValue.ToString) = 0, "", ", "))
                        'MAPPING :         arnourut,                          idlogin,                             arid,                                             artgl,                              arsumber,                             arnotransaksi,                             arkontak,                             arkontakkode,                             arkontaknama,                             aralamat1,                             aralamat2,                             aralamat3,                             aralamat4,                             aralamat5,                             arnotelp1,                             arnotelp2,                             arnorek,                             armatauang,                             arkurs,                             aruraian,                             arcatatan,                             arsaldoawal,                             ardebit,                             arkredit,                             arsaldoakhir,                                             artgljatuhtempo,                   arstatuslunas,                                           artgllunas,                                              arinputtgl,                                         arisfungsional,        arissaldoakhir                           idmsmq,                             aruserid,                   arcustomtext1,           arcustomtext2,           arcustomtext3,           arcustomtext4,           arcustomtext5,arcustomint1,arcustomint2,arcustomint3,arcustomint4,arcustomint5, arcustomdbl1,           arcustomdbl2,           arcustomdbl3,           arcustomdbl4,           arcustomdbl5,                                      arcustomdate1,                                      arcustomdate2,                                      arcustomdate3,                                      arcustomdate4,                                      arcustomdate5
                        strValue.Append("('" & urut & "', '" & FixQuotes(dr1("idlogin")) & "', '" & FixQuotes(dr1("arid")) & "', '" & FixQuotes(AsFormatTanggal(dr1("artgl"))) & "', '" & FixQuotes(dr1("arsumber")) & "', '" & FixQuotes(dr1("arnotransaksi")) & "', '" & FixQuotes(dr1("arkontak")) & "', '" & FixQuotes(dr1("arkontakkode")) & "', '" & FixQuotes(dr1("arkontaknama")) & "', '" & FixQuotes(dr1("aralamat1")) & "', '" & FixQuotes(dr1("aralamat2")) & "', '" & FixQuotes(dr1("aralamat3")) & "', '" & FixQuotes(dr1("aralamat4")) & "', '" & FixQuotes(dr1("aralamat5")) & "', '" & FixQuotes(dr1("arnotelp1")) & "', '" & FixQuotes(dr1("arnotelp2")) & "', '" & FixQuotes(dr1("arnorek")) & "', '" & FixQuotes(dr1("armatauang")) & "', '" & FixQuotes(dr1("arkurs")) & "', '" & FixQuotes(dr1("aruraian")) & "', '" & FixQuotes(dr1("arcatatan")) & "', '" & FixDouble(dr1("arsaldoawal")) & "', '" & FixDouble(dr1("ardebit")) & "', '" & FixDouble(dr1("arkredit")) & "', '" & FixDouble(dr1("arsaldoakhir")) & "', '" & FixQuotes(AsFormatTanggal(dr1("artgljatuhtempo"))) & "', " & dr1("arstatuslunas") & ", '" & FixQuotes(AsFormatTanggal(dr1("artgllunas"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("arinputtgl"), "yyyy-MM-dd H:mm:ss")) & "', " & dr1("arisfungsional") & ", " & FixDouble(0) & ", '" & FixQuotes(dr1("idmsmq")) & "', '" & FixQuotes(dr1("aruserid")) & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "')")

                        'INCREMENT NOURUT
                        urut += 1
                    Next
                End If
                'END OF SALDO AWAL ==================================


                'SALDO MUTASI =======================================
                Dim saldoAwal As Double = 0, saldoDebit As Double = 0, saldoKredit As Double = 0

                'AMBIL SALDO AWAL DARI DTSAWAL
                saldoAwal = Double.Parse(AsDataTableDLookup(dtSAwal, "arsaldoakhir", "armatauang = '" & uangFungsional & "'", 0))

                'QUERY SALDO MUTASI MATAUANG FUNGSIONAL
                sqlFungsional = " SELECT '" & idLogin & "' as idlogin, t.tid as arid, DATE_FORMAT(t.ttgl, '%Y-%m-%d') as artgl, t.tsumber as arsumber, t.tnotransaksi as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, t.tnorek as arnorek, '" & uangFungsional & "' as armatauang, '" & kursFungsional & "' as arkurs, t.turaian as aruraian, t.tcatatan as arcatatan, 0 as arsaldoawal, t.tdebit as ardebit, t.tkredit as arkredit, @saldo := @saldo + t.tkredit - t.tdebit as arsaldoakhir, DATE_FORMAT(t.ttgljatuhtempo, '%Y-%m-%d') as artgljatuhtempo, t.tstatuslunas as arstatuslunas, DATE_FORMAT(t.ttgllunas, '%Y-%m-%d') as artgllunas, DATE_FORMAT(t.tinputtgl, '%Y-%m-%d %H:%i:%s') as arinputtgl, 1 as arisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as aruserid FROM m2_transaction_journal t JOIN  m1_contact c ON c.kid = t.tkontak, (SELECT @saldo := " & FixDouble(saldoAwal) & ") AS variableInit1 WHERE  t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " ORDER BY t.ttgl, t.tinputtgl, t.tid"

                'AMBIL SALDO MUTASI MATAUANG FUNGSIONAL
                dtSMutasi = AsDataTableAmbilDariDB(sqlFungsional)
                If dtSMutasi.Rows.Count > 0 Then

                    'AMBIL TRANSAKSI MUTASI MATAUANG VALAS
                    sql = "SELECT t.tmatauang as armatauang FROM m2_transaction_journal t JOIN m1_contact c ON c.kid = t.tkontak WHERE t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) AND t.tmatauang <> '" & uangFungsional & "' " & ftAkunAR & " GROUP BY t.tmatauang"
                    Dim dtUangValas As DataTable = AsDataTableAmbilDariDB(sql)
                    If dtUangValas.Rows.Count > 0 Then
                        Dim uangValas As String = ""

                        'PERULANGAN AMBIL TRANSAKSI VALAS
                        For Each dr1 As DataRow In dtUangValas.Rows
                            'SET MATAUANG VALAS
                            uangValas = dr1("armatauang")

                            'AMBIL SALDO AWAL DARI DTSAWAL
                            saldoAwal = Double.Parse(AsDataTableDLookup(dtSAwal, "arsaldoakhir", "armatauang = '" & uangValas & "'", 0))

                            'AMBIL TRANSAKSI MUTASI PER MATAUANG
                            sqlValas = " SELECT '" & idLogin & "' as idlogin, t.tid as arid, DATE_FORMAT(t.ttgl, '%Y-%m-%d') as artgl, t.tsumber as arsumber, t.tnotransaksi as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, t.tnorek as arnorek, t.tmatauang as armatauang, t.tkurs as arkurs, t.turaian as aruraian, t.tcatatan as  arcatatan, 0 as arsaldoawal, t.tdebitvalas as ardebit, t.tkreditvalas as arkredit, @saldo := @saldo + t.tkreditvalas - t.tdebitvalas as arsaldoakhir, DATE_FORMAT(t.ttgljatuhtempo, '%Y-%m-%d') as artgljatuhtempo, t.tstatuslunas as arstatuslunas, DATE_FORMAT(t.ttgllunas, '%Y-%m-%d') as artgllunas, DATE_FORMAT(t.tinputtgl, '%Y-%m-%d %H:%i:%s')  as arinputtgl, 0 as arisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as aruserid FROM m2_transaction_journal t JOIN  m1_contact c ON c.kid = t.tkontak, (SELECT @saldo := " & FixDouble(saldoAwal) & ") AS variableInit1 WHERE t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND t.tmatauang = '" & uangValas & "' " & ftAkunAR & " ORDER BY t.ttgl, t.tinputtgl, t.tid"
                            dtSMutasiTemp = AsDataTableAmbilDariDB(sqlValas)

                            'COPY MUTASI VALAS KE MUTASI FUNGSIONAL
                            dtSMutasi.Merge(dtSMutasiTemp, True, MissingSchemaAction.Ignore)
                        Next
                    End If

                    'INSERT SALDO MUTASI KE TABEL PEMBANTU
                    'SORTING DATA TERLEBIH DAHULU
                    dtSMutasi = AsDataTableFilterSortDt(dtSMutasi, "", "artgl, arinputtgl, arid, arisfungsional DESC, armatauang")
                    For Each dr1 As DataRow In dtSMutasi.Rows
