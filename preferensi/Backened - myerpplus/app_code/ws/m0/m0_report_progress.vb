                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur1) & " = 0 AND " & FixDouble(umur2) & " = 0 THEN 0 WHEN " & FixDouble(umur1) & " = 0 AND " & FixDouble(umur2) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur2) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur1) & " <> 0 AND " & FixDouble(umur2) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur2) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) >= " & FixDouble(umur1) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur1, "
                'UMUR2          : JIKA UMUR2 = 0 DAN UMUR3 = 0 MAKA 0,                                               JIKA UMUR2 = 0 DAN UMUR3 <> 0 DAN TGLJT < UMUR3 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                        JIKA UMUR2 <> 0 DAN UMUR3 <> 0 DAN TGLJT < UMUR3 DAN TGLJT >= UMUR2 MAKA TAMPILKAN SISA
                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur2) & " = 0 AND " & FixDouble(umur3) & " = 0 THEN 0 WHEN " & FixDouble(umur2) & " = 0 AND " & FixDouble(umur3) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur3) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur2) & " <> 0 AND " & FixDouble(umur3) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) < " & FixDouble(umur3) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) >= " & FixDouble(umur2) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur2, "
