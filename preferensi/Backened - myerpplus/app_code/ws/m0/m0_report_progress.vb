                'RI VALAS
                sqlValasRI = "SELECT ri.riid as apid, ri.ritgl as aptgl, ri.risumber as apsumber, ri.rinotransaksi as apnotransaksi, ri.risupplier as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, s.snilai as apnorek, ri.rimatauang as apmatauang, ri.rikurs as apkurs, ri.riuraian as apuraian, ri.ricatatan as apcatatan, ri.ritotaltransaksi as aptotal, (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) END) as apbayar, (ri.ritotaltransaksi) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) END) as apsisa, ri.ritgljatuhtempo as aptgljatuhtempo, ri.ristatuslunas as apstatuslunas, ri.ritgllunas as aptgllunas, ri.riinputtgl as apinputtgl, 0 as apisfungsional, 0 as apissaldoakhir "
