                sqlValas = " SELECT 0 as apid, '" & FixQuotes(vCabang) & "' as apcabang, IFNULL(br.bnama,'') as apcabangnama, '" & tglAkhir & "' as aptgl, '' as apsumber, '' as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, '' as apnorek, t.tmatauang as apmatauang, t.tkurs as apkurs, 'Saldo Akhir' as apuraian, 'Saldo Akhir' as  apcatatan, IFNULL(SUM(t.tkreditvalas),0) - IFNULL(SUM(t.tdebitvalas),0) as apsaldoakhir, '1900-01-01' as aptgljatuhtempo, 0 as apstatuslunas, '1900-01-01' as aptgllunas, CONCAT('" & tglAkhir & "',' ','00:00:00') as apinputtgl, 0 as apisfungsional FROM m2_transaction_journal t JOIN m1_contact c ON t.tkontak = c.kid JOIN m1_branch br ON br.bkode = '" & FixQuotes(vCabang) & "' WHERE c.kid = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tcabang = '" & FixQuotes(vCabang) & "' AND t.ttgl <= '" & tglAkhir & "' AND t.tmatauang <> '" & uangFungsional & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAP & " GROUP BY t.tmatauang"
                sqlJadi = " SELECT '" & idLogin & "' as idlogin, apid, apcabang, apcabangnama, aptgl, apsumber, apnotransaksi, apkontak, apkontakkode, apkontaknama, apalamat1, apalamat2, apalamat3, apalamat4, apalamat5, apnotelp1, apnotelp2, apnorek, apmatauang, apkurs, apuraian, apcatatan, apsaldoakhir, aptgljatuhtempo, apstatuslunas, aptgllunas, apinputtgl, apisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as apuserid FROM "
                sqlJadi += " ((" & sqlFungsional & ") UNION ALL (" & sqlValas & ")) as SAwal"
