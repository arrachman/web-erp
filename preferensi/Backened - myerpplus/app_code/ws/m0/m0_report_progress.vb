                sqlFungsionalSI &= " LEFT JOIN m0_setting s ON smodule = 0 AND sgrup = 'akun' AND skode = 'PiutangUsaha' "
                sqlFungsionalSI &= " WHERE si.sistatus IN(2,3,4,7) "
                sqlFungsionalSI &= " AND si.sicabang = '" & FixQuotes(vCabang) & "' "
