                sqlFungsionalSR &= " LEFT JOIN m1_contact c ON sr.srcustomer = c.kid "
                sqlFungsionalSR &= " LEFT JOIN m1_branch br ON br.bkode = '" & FixQuotes(vCabang) & "'"
                sqlFungsionalSR &= " LEFT JOIN m0_setting s ON smodule = 0 AND sgrup = 'akun' AND skode = 'PiutangUsaha' "
                sqlFungsionalSR &= " WHERE sr.srstatus IN(2,3,4,7) "
