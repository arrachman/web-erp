        ElseIf Len(customerAwal) > 0 Then
            Filter = Filter & " AND (kkode >= '" & FixQuotes(customerAwal) & "') "
        ElseIf Len(customerAkhir) > 0 Then
            Filter = Filter & " AND (kkode <= '" & FixQuotes(customerAkhir) & "') "
        End If
        'END OF BUAT FILTER KONTAK ------------------------------------------------

        'AMBIL KONTAK
        Dim dtKontak As DataTable = AsDataTableAmbilDariDB("SELECT kid, kkode, knama FROM m1_contact JOIN m1_contact_point ON kid = cpidkontak " & Filter & " ORDER BY " & OrderBy)

        If dtKontak.Rows.Count > 0 Then
            'JIKA TERDAPAT DATA KONTAK, MAKA PERULANGAN INSERT KE TABEL M2R_CUSTOMER_POINT SEBANYAK KONTAK YANG TERAMBIL
            Dim dtSAwal As New DataTable, dtSMutasi As New DataTable, currKontak As String = "", currKode As String = "", currNama As String = "", saldoAwal As Double = 0
            Dim sqlSMutasiCPA As String = "", sqlSMutasiSI As String = "", sqlSMutasi As String = "", sqlSMutasiFix As String = ""

            'BUAT FILTER CABANG
