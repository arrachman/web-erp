t1, '' as nmcustomtext2, '' as nmcustomtext3, '' as nmcustomtext4, '' as nmcustomtext5, 0 as nmcustomint1, 0 as nmcustomint2, 0 as nmcustomint3, 0 as nmcustomint4, 0 as nmcustomint5, 0 as nmcustomdbl1, 0 as nmcustomdbl2, 0 as nmcustomdbl3, 0 as nmcustomdbl4, 0 as nmcustomdbl5, '1900-01-01' as nmcustomdate1, '1900-01-01' as nmcustomdate2, '1900-01-01' as nmcustomdate3, '1900-01-01' as nmcustomdate4, '1900-01-01' as nmcustomdate5"
