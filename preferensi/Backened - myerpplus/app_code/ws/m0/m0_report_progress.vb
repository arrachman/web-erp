                    sql = "Insert into m2r_customer_point(idlogin, cpnourut, cpidtransaksi, cpcabang, cplokasi, cpsumber, cpnotransaksi, cptgl, cpkontak, cpkontakkode, cpkontaknama, cppetugas, cppetugaskode, cppetugasnama, cpuraian, cpcatatan, cpmasuk, cpkeluar, cpsaldo, idmsmq, cpuserid, cpcustomtext1, cpcustomtext2, cpcustomtext3, cpcustomtext4, cpcustomtext5, cpcustomint1, cpcustomint2, cpcustomint3, cpcustomint4, cpcustomint5, cpcustomdbl1, cpcustomdbl2, cpcustomdbl3, cpcustomdbl4, cpcustomdbl5, cpcustomdate1, cpcustomdate2, cpcustomdate3, cpcustomdate4, cpcustomdate5) values" & strValue.ToString & ""
