                'QUERY SALDO MUTASI MATAUANG FUNGSIONAL
                sqlFungsional = " SELECT '" & idLogin & "' as idlogin, t.tid as apid, '" & FixQuotes(vLokasi) & "' as aplokasi, IFNULL(lc.lnama,'') as aplokasinama, DATE_FORMAT(t.ttgl, '%Y-%m-%d') as aptgl, t.tsumber as apsumber, t.tnotransaksi as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, t.tnorek as apnorek, '" & uangFungsional & "' as apmatauang, '" & kursFungsional & "' as apkurs, t.turaian as apuraian, t.tcatatan as apcatatan, 0 as apsaldoawal, t.tdebit as apdebit, t.tkredit as apkredit, @saldo := @saldo + t.tkredit - t.tdebit as apsaldoakhir, DATE_FORMAT(t.ttgljatuhtempo, '%Y-%m-%d') as aptgljatuhtempo, t.tstatuslunas as apstatuslunas, DATE_FORMAT(t.ttgllunas, '%Y-%m-%d') as aptgllunas, DATE_FORMAT(t.tinputtgl, '%Y-%m-%d %H:%i:%s') as apinputtgl, 1 as apisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as apuserid FROM m2_transaction_journal t JOIN  m1_contact c ON c.kid = t.tkontak JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' , (SELECT @saldo := " & FixDouble(saldoAwal) & ") AS variableInit1 WHERE  t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAP & " ORDER BY t.ttgl, t.tinputtgl, t.tid"

                'AMBIL SALDO MUTASI MATAUANG FUNGSIONAL
                dtSMutasi = AsDataTableAmbilDariDB(sqlFungsional)
