                    sqlBulanIni = " SELECT '" & FixQuotes(vCabang) & "' as pkcabang, IFNULL(br.bnama,'') as pkcabangnama, c.cnomor as pknorek, (IFNULL(SUM(r.rwjmldebit),0) / " & FixDouble(pembagiNominal) & ") AS pkdebit, (IFNULL(SUM(r.rwjmlkredit),0) / " & FixDouble(pembagiNominal) & ") AS pkkredit, (CASE c.cdc WHEN 'D' THEN (IFNULL(SUM(r.rwjmldebit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rwjmlkredit),0) / " & FixDouble(pembagiNominal) & ") ELSE (IFNULL(SUM(r.rwjmlkredit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rwjmldebit),0) / " & FixDouble(pembagiNominal) & ") END) AS pksaldo FROM m1_coa c LEFT JOIN m2_realization_branch r ON c.cnomor = r.rwnorek AND r.rwcabang = '" & FixDouble(vCabang) & "' AND (r.rwtahun < '" & FixDouble(tahun) & "' or (r.rwtahun = '" & FixDouble(tahun) & "' AND r.rwbulan <= '" & FixDouble(bulan) & "')) AND c.cnomor <> '" & FixQuotes(norekLRDitahan) & "' LEFT JOIN m1_branch br ON br.bkode = '" & FixDouble(vCabang) & "' WHERE c.clevel = '5' AND c.clevel2 = '" & FixDouble(LD2) & "' GROUP BY c.cnomor ORDER BY c.cnomor"
                    sqlBulanLalu = "SELECT c.cnomor as pknorek, (IFNULL(SUM(r.rwjmldebit),0) / " & FixDouble(pembagiNominal) & ") AS pkdebitlalu, (IFNULL(SUM(r.rwjmlkredit),0) / " & FixDouble(pembagiNominal) & ") AS pkkreditlalu, (CASE c.cdc WHEN 'D' THEN (IFNULL(SUM(r.rwjmldebit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rwjmlkredit),0) / " & FixDouble(pembagiNominal) & ") ELSE (IFNULL(SUM(r.rwjmlkredit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rwjmldebit),0) / " & FixDouble(pembagiNominal) & ") END) AS pksaldolalu FROM m1_coa c LEFT JOIN m2_realization_branch r ON c.cnomor = r.rwnorek AND r.rwcabang = '" & FixDouble(vCabang) & "' AND (r.rwtahun < '" & FixDouble(tahunLalu) & "' or (r.rwtahun = '" & FixDouble(tahunLalu) & "' AND r.rwbulan <= '" & FixDouble(bulanLalu) & "')) AND c.cnomor <> '" & FixQuotes(norekLRDitahan) & "' LEFT JOIN m1_branch br ON br.bkode = '" & FixDouble(vCabang) & "' WHERE c.clevel = '5' AND c.clevel2 = '" & FixDouble(LD2) & "' GROUP BY c.cnomor ORDER BY c.cnomor"

                    'QUERY AMBIL DATA
