tes(AsFormatTanggal(tglAwal, "yyyy-01-01")) & "' AND t.ttgl < '" & FixQuotes(tglAwal) & "' WHEN 'B' THEN t.ttgl >= '" & FixQuotes(AsFormatTanggal(tglAwal, "yyyy-01-01")) & "' AND t.ttgl < '" & FixQuotes(tglAwal) & "' ELSE t.ttgl < '" & FixQuotes(tglAwal) & "' END) AND (CASE LENGTH('" & FixQuotes(matauang) & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & FixQuotes(matauang) & "' END)")
                If dtSAwal.Rows.Count > 0 Then
