                    sql = "SELECT t.tmatauang as apmatauang FROM m2_transaction_journal t JOIN m1_contact c ON c.kid = t.tkontak JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' WHERE t.tkontak = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl BETWEEN '" & tglAwal & "' AND '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) AND t.tmatauang <> '" & uangFungsional & "' " & ftAkunAP & " GROUP BY t.tmatauang"
                    Dim dtUangValas As DataTable = AsDataTableAmbilDariDB(sql)
