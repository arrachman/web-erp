                'RESET QUERY INSERT, SET STEPKE
                strValue.Clear() : stepKe = stepKe + 1

                'SALDO AWAL =========================================
                'QUERY SALDO AWAL
                sqlFungsional = " SELECT 0 as arid, '" & FixQuotes(vLokasi) & "' as arlokasi, IFNULL(lc.lnama,'') as arlokasinama, '" & tglAwal & "' as artgl, '' as arsumber, '' as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, '' as arnorek, '" & uangFungsional & "' as armatauang, '" & kursFungsional & "' as arkurs, 'Saldo Awal' as aruraian, 'Saldo Awal' as  arcatatan, 0 as arsaldoawal, IFNULL(SUM(t.tdebit),0) as ardebit, IFNULL(SUM(t.tkredit),0) as arkredit, IFNULL(SUM(t.tdebit),0) - IFNULL(SUM(t.tkredit),0) as arsaldoakhir, '1900-01-01' as artgljatuhtempo, 0 as arstatuslunas, '1900-01-01' as artgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as arinputtgl, 1 as arisfungsional FROM m1_contact c JOIN m2_transaction_journal t ON c.kid = t.tkontak AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl < '" & tglAwal & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' WHERE c.kid = '" & idkontak & "'"
                sqlValas = " SELECT 0 as arid, '" & FixQuotes(vLokasi) & "' as arlokasi, IFNULL(lc.lnama,'') as arlokasinama, '" & tglAwal & "' as artgl, '' as arsumber, '' as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, '' as arnorek, t.tmatauang as armatauang, t.tkurs as arkurs, 'Saldo Awal' as aruraian, 'Saldo Awal' as  arcatatan, 0 as arsaldoawal, IFNULL(SUM(t.tdebitvalas),0) as ardebit, IFNULL(SUM(t.tkreditvalas),0) as arkredit, IFNULL(SUM(t.tdebitvalas),0) - IFNULL(SUM(t.tkreditvalas),0) as arsaldoakhir, '1900-01-01' as artgljatuhtempo, 0 as arstatuslunas, '1900-01-01' as artgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as arinputtgl, 0 as arisfungsional FROM m2_transaction_journal t JOIN m1_contact c ON t.tkontak = c.kid JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' WHERE c.kid = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl < '" & tglAwal & "' AND t.tmatauang <> '" & uangFungsional & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " GROUP BY t.tmatauang"
                sqlJadi = " SELECT '" & idLogin & "' as idlogin, arlokasi, arlokasinama, arid, artgl, arsumber, arnotransaksi, arkontak, arkontakkode, arkontaknama, aralamat1, aralamat2, aralamat3, aralamat4, aralamat5, arnotelp1, arnotelp2, arnorek, armatauang, arkurs, aruraian, arcatatan, arsaldoawal, ardebit, arkredit, arsaldoakhir, artgljatuhtempo, arstatuslunas, artgllunas, arinputtgl, arisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as aruserid FROM "
                sqlJadi += " ((" & sqlFungsional & ") UNION ALL (" & sqlValas & ")) as SAwal"
                sqlJadi += " ORDER BY armatauang = '" & uangFungsional & "' DESC, armatauang ASC"

                'AMBIL SALDO AWAL
                dtSAwal = AsDataTableAmbilDariDB(sqlJadi)
                If dtSAwal.Rows.Count > 0 Then
                    'INSERT SALDO AWAL KE TABEL PEMBANTU
                    For Each dr1 As DataRow In dtSAwal.Rows
                        'BUAT QUERY INSERT KE TABEL PEMBANTU
                        strValue.Append(IIf(Len(strValue.ToString) = 0, "", ", "))
                        'MAPPING :         arnourut,                          idlogin,                             arlokasi,                             arlokasinama,                             arid,                                             artgl,                              arsumber,                             arnotransaksi,                             arkontak,                             arkontakkode,                             arkontaknama,                             aralamat1,                             aralamat2,                             aralamat3,                             aralamat4,                             aralamat5,                             arnotelp1,                             arnotelp2,                             arnorek,                             armatauang,                             arkurs,                             aruraian,                             arcatatan,                             arsaldoawal,                             ardebit,                             arkredit,                             arsaldoakhir,                                             artgljatuhtempo,                   arstatuslunas,                                           artgllunas,                                              arinputtgl,                                         arisfungsional,        arissaldoakhir                           idmsmq,                             aruserid,                   arcustomtext1,           arcustomtext2,           arcustomtext3,           arcustomtext4,           arcustomtext5,arcustomint1,arcustomint2,arcustomint3,arcustomint4,arcustomint5, arcustomdbl1,           arcustomdbl2,           arcustomdbl3,           arcustomdbl4,           arcustomdbl5,                                      arcustomdate1,                                      arcustomdate2,                                      arcustomdate3,                                      arcustomdate4,                                      arcustomdate5
                        strValue.Append("('" & urut & "', '" & FixQuotes(dr1("idlogin")) & "', '" & FixQuotes(dr1("arlokasi")) & "', '" & FixQuotes(dr1("arlokasinama")) & "', '" & FixQuotes(dr1("arid")) & "', '" & FixQuotes(AsFormatTanggal(dr1("artgl"))) & "', '" & FixQuotes(dr1("arsumber")) & "', '" & FixQuotes(dr1("arnotransaksi")) & "', '" & FixQuotes(dr1("arkontak")) & "', '" & FixQuotes(dr1("arkontakkode")) & "', '" & FixQuotes(dr1("arkontaknama")) & "', '" & FixQuotes(dr1("aralamat1")) & "', '" & FixQuotes(dr1("aralamat2")) & "', '" & FixQuotes(dr1("aralamat3")) & "', '" & FixQuotes(dr1("aralamat4")) & "', '" & FixQuotes(dr1("aralamat5")) & "', '" & FixQuotes(dr1("arnotelp1")) & "', '" & FixQuotes(dr1("arnotelp2")) & "', '" & FixQuotes(dr1("arnorek")) & "', '" & FixQuotes(dr1("armatauang")) & "', '" & FixQuotes(dr1("arkurs")) & "', '" & FixQuotes(dr1("aruraian")) & "', '" & FixQuotes(dr1("arcatatan")) & "', '" & FixDouble(dr1("arsaldoawal")) & "', '" & FixDouble(dr1("ardebit")) & "', '" & FixDouble(dr1("arkredit")) & "', '" & FixDouble(dr1("arsaldoakhir")) & "', '" & FixQuotes(AsFormatTanggal(dr1("artgljatuhtempo"))) & "', " & dr1("arstatuslunas") & ", '" & FixQuotes(AsFormatTanggal(dr1("artgllunas"))) & "', '" & FixQuotes(AsFormatTanggal(dr1("arinputtgl"), "yyyy-MM-dd H:mm:ss")) & "', " & dr1("arisfungsional") & ", " & FixDouble(0) & ", '" & FixQuotes(dr1("idmsmq")) & "', '" & FixQuotes(dr1("aruserid")) & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', '" & FixQuotes("") & "', " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", " & 0 & ", '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixDouble(0) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "', '" & FixQuotes(AsFormatTanggal("1900-01-01")) & "')")

                        'INCREMENT NOURUT
