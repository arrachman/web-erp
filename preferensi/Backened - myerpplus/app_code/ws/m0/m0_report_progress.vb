                sqlFungsionalRI &= " (CASE WHEN " & FixDouble(umur6) & " = 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) >= 0 THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) WHEN " & FixDouble(umur6) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) >= 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',ri.ritgljatuhtempo) <= " & FixDouble(umur6) & " THEN (ri.ritotaltransaksi * ri.rikurs) - (CASE ri.rimatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas),0) * ri.rikurs END) ELSE 0 END) as apumur6, "
