                    sqlBulanIni = " SELECT '" & FixQuotes(vDivisi) & "' as pkdivisi, IFNULL(d.dnama,'') as pkdivisinama, c.cnomor as pknorek, (IFNULL(SUM(r.rdjmldebit),0) / " & FixDouble(pembagiNominal) & ") AS pkdebit, (IFNULL(SUM(r.rdjmlkredit),0) / " & FixDouble(pembagiNominal) & ") AS pkkredit, (CASE c.cdc WHEN 'D' THEN (IFNULL(SUM(r.rdjmldebit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rdjmlkredit),0) / " & FixDouble(pembagiNominal) & ") ELSE (IFNULL(SUM(r.rdjmlkredit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rdjmldebit),0) / " & FixDouble(pembagiNominal) & ") END) AS pksaldo FROM m1_coa c LEFT JOIN m2_realization_division r ON c.cnomor = r.rdnorek AND r.rddivisi = '" & FixDouble(vDivisi) & "' AND (r.rdtahun < '" & FixDouble(tahun) & "' or (r.rdtahun = '" & FixDouble(tahun) & "' AND r.rdbulan <= '" & FixDouble(bulan) & "')) AND c.cnomor <> '" & FixQuotes(norekLRDitahan) & "' LEFT JOIN m1_division d ON d.dkode = '" & FixDouble(vDivisi) & "' WHERE c.clevel = '5' AND c.clevel2 = '" & FixDouble(LD2) & "' GROUP BY c.cnomor ORDER BY c.cnomor"
