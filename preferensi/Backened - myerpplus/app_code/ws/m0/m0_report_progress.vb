                'SALDO AKHIR ========================================
                Dim saldoAwal As Double = 0, saldoDebit As Double = 0, saldoKredit As Double = 0

                'QUERY SALDO AKHIR
                sqlFungsional = " SELECT 0 as arid, '" & FixQuotes(vCabang) & "' as arcabang, IFNULL(br.bnama,'') as arcabangnama, '" & tglAkhir & "' as artgl, '' as arsumber, '' as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, '' as arnorek, '" & uangFungsional & "' as armatauang, '" & kursFungsional & "' as arkurs, 'Saldo Akhir' as aruraian, 'Saldo Akhir' as  arcatatan, IFNULL(SUM(t.tdebit),0) - IFNULL(SUM(t.tkredit),0) as arsaldoakhir, '1900-01-01' as artgljatuhtempo, 0 as arstatuslunas, '1900-01-01' as artgllunas, CONCAT('" & tglAkhir & "',' ','00:00:00') as arinputtgl, 1 as arisfungsional FROM m1_contact c JOIN m2_transaction_journal t ON c.kid = t.tkontak AND t.tstatus IN(2,3,4,7) AND t.tcabang = '" & FixQuotes(vCabang) & "' AND t.ttgl <= '" & tglAkhir & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " JOIN m1_branch br ON br.bkode = '" & FixQuotes(vCabang) & "' WHERE c.kid = '" & idkontak & "'"
                sqlValas = " SELECT 0 as arid, '" & FixQuotes(vCabang) & "' as arcabang, IFNULL(br.bnama,'') as arcabangnama, '" & tglAkhir & "' as artgl, '' as arsumber, '' as arnotransaksi, c.kid as arkontak, c.kkode as arkontakkode, c.knama as arkontaknama, c.k1alamat1 as aralamat1, c.k1alamat2 as aralamat2, c.k1alamat3 as aralamat3, c.k1alamat4 as aralamat4, c.k1alamat5 as aralamat5, c.k1notelp1 as arnotelp1, c.k1notelp2 as arnotelp2, '' as arnorek, t.tmatauang as armatauang, t.tkurs as arkurs, 'Saldo Akhir' as aruraian, 'Saldo Akhir' as  arcatatan, IFNULL(SUM(t.tdebitvalas),0) - IFNULL(SUM(t.tkreditvalas),0) as arsaldoakhir, '1900-01-01' as artgljatuhtempo, 0 as arstatuslunas, '1900-01-01' as artgllunas, CONCAT('" & tglAkhir & "',' ','00:00:00') as arinputtgl, 0 as arisfungsional FROM m2_transaction_journal t JOIN m1_contact c ON t.tkontak = c.kid JOIN m1_branch br ON br.bkode = '" & FixQuotes(vCabang) & "' WHERE c.kid = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tcabang = '" & FixQuotes(vCabang) & "' AND t.ttgl <= '" & tglAkhir & "' AND t.tmatauang <> '" & uangFungsional & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAR & " GROUP BY t.tmatauang"
                sqlJadi = " SELECT '" & idLogin & "' as idlogin, arid, arcabang, arcabangnama, artgl, arsumber, arnotransaksi, arkontak, arkontakkode, arkontaknama, aralamat1, aralamat2, aralamat3, aralamat4, aralamat5, arnotelp1, arnotelp2, arnorek, armatauang, arkurs, aruraian, arcatatan, arsaldoakhir, artgljatuhtempo, arstatuslunas, artgllunas, arinputtgl, arisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as aruserid FROM "
                sqlJadi += " ((" & sqlFungsional & ") UNION ALL (" & sqlValas & ")) as SAwal"
                sqlJadi += " ORDER BY armatauang = '" & uangFungsional & "' DESC, armatauang ASC"

