                sqlValasAS &= " FROM m5_pv pv "
                sqlValasAS &= " JOIN m5_pv_detail pvd ON pv.pvid = pvd.idpv AND pv.pvstatus IN(2,3,4,7) AND pv.pvtgl <= '" & FixQuotes(tglAkhir) & "' "
                sqlValasAS &= " RIGHT JOIN m5_rp rp ON pvd.idtransaksi = rp.rpid AND pvd.sumber = rp.rpsumber "
                sqlValasAS &= " LEFT JOIN m1_contact c ON rp.rpkontak = c.kid "
