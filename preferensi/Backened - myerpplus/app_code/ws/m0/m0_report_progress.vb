                sqlValasAP &= " AND (CASE '" & FixDouble(statusJT) & "' WHEN 0 THEN ap.aptgljatuhtempo > '" & FixQuotes(tglAkhir) & "' WHEN 1 THEN ap.aptgljatuhtempo <= '" & FixQuotes(tglAkhir) & "' ELSE ap.aptgljatuhtempo LIKE '%' END) "
                sqlValasAP &= " GROUP BY ap.apid "
                sqlValasAP &= " ORDER BY ap.aptgl, ap.apinputtgl, ap.apid "


                'GABUNGKAN SQL
                sqlJadi = " SELECT * FROM ( "
