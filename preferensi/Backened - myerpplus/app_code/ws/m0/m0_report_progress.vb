        End If
        'END OF LABA BERSIH --------------------------------------------------------

        result(1) = 1
        result(2) = notransaksi
        result(3) = 0
        result(4) = result(4)

        'END OF TRANSAKSI KE DATABASE ======================================================

selesai:
