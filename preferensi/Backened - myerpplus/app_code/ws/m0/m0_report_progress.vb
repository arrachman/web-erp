                sqlValasPRT &= " (CASE WHEN " & FixDouble(umur2) & " = 0 AND " & FixDouble(umur3) & " = 0 THEN 0 WHEN " & FixDouble(umur2) & " = 0 AND " & FixDouble(umur3) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',prt.prttgljatuhtempo) < " & FixDouble(umur3) & " THEN (prt.prttotaltransaksi * -1) - (CASE prt.prtmatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar * -1),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas * -1),0) END) WHEN " & FixDouble(umur2) & " <> 0 AND " & FixDouble(umur3) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',prt.prttgljatuhtempo) < " & FixDouble(umur3) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',prt.prttgljatuhtempo) >= " & FixDouble(umur2) & " THEN (prt.prttotaltransaksi * -1) - (CASE prt.prtmatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(vpd.jmlbayar * -1),0) ELSE IFNULL(SUM(vpd.jmlbayarvalas * -1),0) END) ELSE 0 END) as apumur2, "
