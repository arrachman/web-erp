                'UMUR1          : JIKA UMUR1 = 0 DAN UMUR2 = 0 MAKA 0,                                               JIKA UMUR1 = 0 DAN UMUR2 <> 0 DAN TGLJT < UMUR2 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                        JIKA UMUR1 <> 0 DAN UMUR2 <> 0 DAN TGLJT < UMUR2 DAN TGLJT >= UMUR1 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur1) & " = 0 AND " & FixDouble(umur2) & " = 0 THEN 0 WHEN " & FixDouble(umur1) & " = 0 AND " & FixDouble(umur2) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur2) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur1) & " <> 0 AND " & FixDouble(umur2) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur2) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) >= " & FixDouble(umur1) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur1, "
                'UMUR2          : JIKA UMUR2 = 0 DAN UMUR3 = 0 MAKA 0,                                               JIKA UMUR2 = 0 DAN UMUR3 <> 0 DAN TGLJT < UMUR3 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                        JIKA UMUR2 <> 0 DAN UMUR3 <> 0 DAN TGLJT < UMUR3 DAN TGLJT >= UMUR2 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur2) & " = 0 AND " & FixDouble(umur3) & " = 0 THEN 0 WHEN " & FixDouble(umur2) & " = 0 AND " & FixDouble(umur3) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur3) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur2) & " <> 0 AND " & FixDouble(umur3) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur3) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) >= " & FixDouble(umur2) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur2, "
                'UMUR3          : JIKA UMUR3 = 0 DAN UMUR4 = 0 MAKA 0,                                               JIKA UMUR3 = 0 DAN UMUR4 <> 0 DAN TGLJT < UMUR4 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                        JIKA UMUR3 <> 0 DAN UMUR4 <> 0 DAN TGLJT < UMUR4 DAN TGLJT >= UMUR3 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur3) & " = 0 AND " & FixDouble(umur4) & " = 0 THEN 0 WHEN " & FixDouble(umur3) & " = 0 AND " & FixDouble(umur4) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur4) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur3) & " <> 0 AND " & FixDouble(umur4) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur4) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) >= " & FixDouble(umur3) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur3, "
                'UMUR4          : JIKA UMUR4 = 0 DAN UMUR5 = 0 MAKA 0,                                               JIKA UMUR4 = 0 DAN UMUR5 <> 0 DAN TGLJT < UMUR5 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                                                        JIKA UMUR4 <> 0 DAN UMUR5 <> 0 DAN TGLJT < UMUR5 DAN TGLJT >= UMUR4 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur4) & " = 0 AND " & FixDouble(umur5) & " = 0 THEN 0 WHEN " & FixDouble(umur4) & " = 0 AND " & FixDouble(umur5) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur5) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur4) & " <> 0 AND " & FixDouble(umur5) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < " & FixDouble(umur5) & " AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) >= " & FixDouble(umur4) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur4, "
                'UMUR5          : JIKA UMUR5 = 0 DAN TGLJT < 0 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                           JIKA UMUR5 <> 0 DAN TGLJT < 0 DAN TGLJT >= UMUR5 MAKA TAMPILKAN SISA 
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur5) & " = 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < 0 THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur5) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) < 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) >= " & FixDouble(umur5) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur5, "
                'UMUR POSITIF +++++++++++++++++++++++
                'UMUR6          : JIKA UMUR6 = 0 DAN TGLJT >= 0 MAKA TAMPILKAN SISA,                                                                                                                                                                                                                                                               JIKA UMUR6 <> 0 DAN TGLJT >= 0 DAN TGLJT <= UMUR6 MAKA TAMPILKAN SISA
                sqlFungsionalSI &= " (CASE WHEN " & FixDouble(umur6) & " = 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) >= 0 THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) WHEN " & FixDouble(umur6) & " <> 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) >= 0 AND DATEDIFF('" & FixQuotes(tglAkhir) & "',si.sitgljatuhtempo) <= " & FixDouble(umur6) & " THEN (si.sitotaltransaksi * si.sikurs) - (CASE si.simatauang WHEN '" & FixQuotes(uangFungsional) & "' THEN IFNULL(SUM(pvd.jmlbayar),0) ELSE IFNULL(SUM(pvd.jmlbayarvalas),0) * si.sikurs END) ELSE 0 END) as arumur6, "
