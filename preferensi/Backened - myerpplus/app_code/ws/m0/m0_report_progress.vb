                sqlFungsionalSR &= " AND (CASE LENGTH('" & FixQuotes(matauang) & "') WHEN 0 THEN sr.srmatauang LIKE '%' ELSE sr.srmatauang = '" & FixQuotes(matauang) & "' END) "
