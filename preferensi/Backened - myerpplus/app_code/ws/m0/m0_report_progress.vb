                'SALDO AWAL =========================================
                'QUERY SALDO AWAL
                sqlFungsional = " SELECT 0 as apid, '" & FixQuotes(vLokasi) & "' as aplokasi, IFNULL(lc.lnama,'') as aplokasinama, '" & tglAwal & "' as aptgl, '' as apsumber, '' as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, '' as apnorek, '" & uangFungsional & "' as apmatauang, '" & kursFungsional & "' as apkurs, 'Saldo Awal' as apuraian, 'Saldo Awal' as  apcatatan, 0 as apsaldoawal, IFNULL(SUM(t.tdebit),0) as apdebit, IFNULL(SUM(t.tkredit),0) as apkredit, IFNULL(SUM(t.tkredit),0) - IFNULL(SUM(t.tdebit),0) as apsaldoakhir, '1900-01-01' as aptgljatuhtempo, 0 as apstatuslunas, '1900-01-01' as aptgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as apinputtgl, 1 as apisfungsional FROM m1_contact c JOIN m2_transaction_journal t ON c.kid = t.tkontak AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl < '" & tglAwal & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAP & " JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' WHERE c.kid = '" & idkontak & "'"
                sqlValas = " SELECT 0 as apid, '" & FixQuotes(vLokasi) & "' as aplokasi, IFNULL(lc.lnama,'') as aplokasinama, '" & tglAwal & "' as aptgl, '' as apsumber, '' as apnotransaksi, c.kid as apkontak, c.kkode as apkontakkode, c.knama as apkontaknama, c.k1alamat1 as apalamat1, c.k1alamat2 as apalamat2, c.k1alamat3 as apalamat3, c.k1alamat4 as apalamat4, c.k1alamat5 as apalamat5, c.k1notelp1 as apnotelp1, c.k1notelp2 as apnotelp2, '' as apnorek, t.tmatauang as apmatauang, t.tkurs as apkurs, 'Saldo Awal' as apuraian, 'Saldo Awal' as  apcatatan, 0 as apsaldoawal, IFNULL(SUM(t.tdebitvalas),0) as apdebit, IFNULL(SUM(t.tkreditvalas),0) as apkredit, IFNULL(SUM(t.tkreditvalas),0) - IFNULL(SUM(t.tdebitvalas),0) as apsaldoakhir, '1900-01-01' as aptgljatuhtempo, 0 as apstatuslunas, '1900-01-01' as aptgllunas, CONCAT('" & tglAwal & "',' ','00:00:00') as apinputtgl, 0 as apisfungsional FROM m2_transaction_journal t JOIN m1_contact c ON t.tkontak = c.kid JOIN m1_location lc ON lc.lkode = '" & FixQuotes(vLokasi) & "' WHERE c.kid = '" & idkontak & "' AND t.tstatus IN(2,3,4,7) AND t.tlokasi = '" & FixQuotes(vLokasi) & "' AND t.ttgl < '" & tglAwal & "' AND t.tmatauang <> '" & uangFungsional & "' AND (CASE LENGTH('" & matauang & "') WHEN 0 THEN t.tmatauang LIKE '%' ELSE t.tmatauang = '" & matauang & "' END) " & ftAkunAP & " GROUP BY t.tmatauang"
                sqlJadi = " SELECT '" & idLogin & "' as idlogin, apid, aplokasi, aplokasinama, aptgl, apsumber, apnotransaksi, apkontak, apkontakkode, apkontaknama, apalamat1, apalamat2, apalamat3, apalamat4, apalamat5, apnotelp1, apnotelp2, apnorek, apmatauang, apkurs, apuraian, apcatatan, apsaldoawal, apdebit, apkredit, apsaldoakhir, aptgljatuhtempo, apstatuslunas, aptgllunas, apinputtgl, apisfungsional, '" & idMsmq & "' as idmsmq, '" & userid & "' as apuserid FROM "
                sqlJadi += " ((" & sqlFungsional & ") UNION ALL (" & sqlValas & ")) as SAwal"
