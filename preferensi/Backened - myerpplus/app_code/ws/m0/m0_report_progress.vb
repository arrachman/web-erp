                    sqlJadi &= " pk.pkkreditvariasi = saldo.pkkreditvariasi + (" & FixDouble(LTKreditvariasi) & "),"
                    sqlJadi &= " pk.pksaldovariasi = saldo.pksaldovariasi + (" & FixDouble(LTSaldovariasi) & ")"
                    sqlJadi &= " WHERE pk.pknorek = '" & FixQuotes(LT2) & "'"
                    sqlJadi &= " AND pk.idmsmq = '" & FixQuotes(idMsmq) & "'"

                    'UPDATE INDUK LEVEL 2
                    If AsEksekusiSQL(sqlJadi) = False Then
                        result(2) = "Failed processing Level 2 Parent Profit/Loss Account. #6" : GoTo selesai
                    End If


                    'AKUN INDUK LEVEL 2 L/R DITAHAN
                    sqlBulanIni = " SELECT c.cnomor as pknorek, (IFNULL(SUM(r.rjmldebit),0) / " & FixDouble(pembagiNominal) & ") AS pkdebit,     (IFNULL(SUM(r.rjmlkredit),0) / " & FixDouble(pembagiNominal) & ") AS pkkredit,     (CASE c.cdc WHEN 'D' THEN (IFNULL(SUM(r.rjmldebit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rjmlkredit),0) / " & FixDouble(pembagiNominal) & ") ELSE (IFNULL(SUM(r.rjmlkredit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rjmldebit),0) / " & FixDouble(pembagiNominal) & ") END) AS pksaldo     FROM m1_coa c LEFT JOIN m2_realization r ON c.cnomor = r.rnorek AND (r.rtahun < '" & FixDouble(tahun) & "'     or (r.rtahun = '" & FixDouble(tahun) & "'     AND r.rbulan <= '" & FixDouble(bulan) & "'))     AND c.cnomor <> '" & FixQuotes(norekLRDitahan) & "' WHERE c.clevel = '5' AND c.clevel2 = '" & FixDouble(LD2) & "' GROUP BY c.cnomor ORDER BY c.cnomor"
                    sqlBulanLalu = "SELECT c.cnomor as pknorek, (IFNULL(SUM(r.rjmldebit),0) / " & FixDouble(pembagiNominal) & ") AS pkdebitlalu, (IFNULL(SUM(r.rjmlkredit),0) / " & FixDouble(pembagiNominal) & ") AS pkkreditlalu, (CASE c.cdc WHEN 'D' THEN (IFNULL(SUM(r.rjmldebit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rjmlkredit),0) / " & FixDouble(pembagiNominal) & ") ELSE (IFNULL(SUM(r.rjmlkredit),0) / " & FixDouble(pembagiNominal) & ") - (IFNULL(SUM(r.rjmldebit),0) / " & FixDouble(pembagiNominal) & ") END) AS pksaldolalu FROM m1_coa c LEFT JOIN m2_realization r ON c.cnomor = r.rnorek AND (r.rtahun < '" & FixDouble(tahunLalu) & "' or (r.rtahun = '" & FixDouble(tahunLalu) & "' AND r.rbulan <= '" & FixDouble(bulanLalu) & "')) AND c.cnomor <> '" & FixQuotes(norekLRDitahan) & "' WHERE c.clevel = '5' AND c.clevel2 = '" & FixDouble(LD2) & "' GROUP BY c.cnomor ORDER BY c.cnomor"

                    'QUERY AMBIL DATA
                    sql = "  SELECT s.pknorek, s.pkdebit, s.pkkredit, s.pksaldo, k.pkdebitlalu, k.pkkreditlalu, k.pksaldolalu, s.pkdebit - k.pkdebitlalu as pkdebitvariasi, s.pkkredit - k.pkkreditlalu as pkkreditvariasi, s.pksaldo - k.pksaldolalu as pksaldovariasi FROM "
