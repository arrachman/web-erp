                            dtSMutasiTemp = AsDataTableAmbilDariDB(sqlValas)

                            'COPY MUTASI VALAS KE MUTASI FUNGSIONAL
                            dtSMutasi.Merge(dtSMutasiTemp, True, MissingSchemaAction.Ignore)
