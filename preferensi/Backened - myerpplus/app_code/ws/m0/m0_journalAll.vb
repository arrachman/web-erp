        AsDataTableDeleteData(dtjurnal, "nominal = 0")
        nomer = 0
        For Each drjurnal As DataRow In dtjurnal.Rows
            drdetail2 = dtdetail.Rows(nomer)
            'BUAT VALUE SQL INSERT KE M2_TRANSACTION_JOURNAL
            strValue.Append(IIf(Len(strValue.ToString) = 0, "", ", "))
            'JIKA debitkredit = 0 maka DEBIT, ELSE KREDIT
            If drjurnal("debitkredit") = 0 Then
                'mapping            tid,                             tcabang,                                  tlokasi,                                  tsumber,    tkodetabelangka,       tidtransaksi,                              tnotransaksi,                                                  ttgl,                        tkodepa,                     tkontak,                                tnorek,                                 turaian,                                  tcatatan,                                  tmatauang,                                 tkurs,      tnobon,                          tdebit,              tkredit,                          tdebitvalas,         tkreditvalas, tcarabayar, thutangpiutang, ttgljatuhtempo,                                 ttgllunas,                         tstatuslunas,    ttglrekonsiliasi, tsudahrekonsiliasi,          turutan, tnohutangpiutang, tsaldoawal, tadjustment, tcostcenter,                         tdivisi,                                 tsubdivisi,                                tproyek,     tgrup, tretail, tjenisaruskas,       tjmlrealisasium,                    tstatusrealisasi,                   tstatus, tposting, tpostingtgl,        tjmlrevisi,                     tcetakanke,                     tinputuser,                                                tinputtgl,                                              tmodifikasiuser,                                                tmodifikasitgl
                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("jmcabang")) & "', '" & FixQuotes(drutama("jmlokasi")) & "', '" & FixQuotes(drutama("jmsumber")) & "', " & 0 & ", " & drutama("jmid") & ", '" & FixQuotes(drutama("jmnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("jmtgl"))) & "', " & drutama("jmkodepa") & ", " & drjurnal("kontak") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("jmuraian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("jmmatauang")) & "', '" & FixDouble(drutama("jmkurs")) & "', '', '" & FixDouble(drjurnal("nominal")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalas")) & "', '" & 0 & "', " & 0 & ", " & 0 & ", '1900-01-01', '" & FixQuotes(AsFormatTanggal(drutama("jmtgllunas"))) & "', " & drutama("jmstatusbayar") & ", '1900-01-01', " & 0 & ", " & drjurnal("urutan") & ", '', 0, 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '" & FixDouble(drutama("jmjumlahbayar")) & "', " & drutama("jmstatusbayar") & ", " & drutama("jmstatus") & ", 1, NOW(), " & drutama("jmjmlrevisi") & ", " & drutama("jmcetakanke") & ", " & drutama("jminputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("jminputtgl"), formatTglWaktuDB)) & "', " & drutama("jmmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("jmmodifikasitgl"), formatTglWaktuDB)) & "')")
            Else
                'mapping            tid,                             tcabang,                                  tlokasi,                                  tsumber,    tkodetabelangka,       tidtransaksi,                              tnotransaksi,                                                  ttgl,                        tkodepa,                     tkontak,                                tnorek,                                 turaian,                                  tcatatan,                                  tmatauang,                                 tkurs,      tnobon,   tdebit,                             tkredit,         tdebitvalas,                          tkreditvalas,         tcarabayar, thutangpiutang, ttgljatuhtempo,                                 ttgllunas,                         tstatuslunas,    ttglrekonsiliasi, tsudahrekonsiliasi,          turutan, tnohutangpiutang, tsaldoawal, tadjustment, tcostcenter,                         tdivisi,                                 tsubdivisi,                                tproyek,     tgrup, tretail, tjenisaruskas,       tjmlrealisasium,                    tstatusrealisasi,                   tstatus, tposting, tpostingtgl,        tjmlrevisi,                     tcetakanke,                     tinputuser,                                                tinputtgl,                                              tmodifikasiuser,                                                tmodifikasitgl
                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("jmcabang")) & "', '" & FixQuotes(drutama("jmlokasi")) & "', '" & FixQuotes(drutama("jmsumber")) & "', " & 0 & ", " & drutama("jmid") & ", '" & FixQuotes(drutama("jmnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("jmtgl"))) & "', " & drutama("jmkodepa") & ", " & drjurnal("kontak") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("jmuraian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("jmmatauang")) & "', '" & FixDouble(drutama("jmkurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal("nominal")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalas")) & "', " & 0 & ", " & 0 & ", '1900-01-01', '" & FixQuotes(AsFormatTanggal(drutama("jmtgllunas"))) & "', " & drutama("jmstatusbayar") & ", '1900-01-01', " & 0 & ", " & drjurnal("urutan") & ", '', 0, 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '" & FixDouble(drutama("jmjumlahbayar")) & "', " & drutama("jmstatusbayar") & ", " & drutama("jmstatus") & ", 1, NOW(), " & drutama("jmjmlrevisi") & ", " & drutama("jmcetakanke") & ", " & drutama("jminputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("jminputtgl"), formatTglWaktuDB)) & "', " & drutama("jmmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("jmmodifikasitgl"), formatTglWaktuDB)) & "')")
            End If
            nomer = nomer + 1
        Next

        'TAMBAHKAN SQL HAPUS JURNAL LAMA
        rsSql = "DELETE FROM M2_Transaction_Journal WHERE tsumber = 'JM' AND tidtransaksi = '" & FixDouble(idtransaksi) & "'"

        'GABUNGKAN VALUE SQL
        If Len(strValue.ToString) > 0 Then
            'QUERY INSERT JURNAL BARU
            rsSql = String.Concat(rsSql, sptRow, "Insert into M2_Transaction_Journal(tid, tcabang, tlokasi, tsumber, tkodetabelangka, tidtransaksi, tnotransaksi, ttgl, tkodepa, tkontak, tnorek, turaian, tcatatan, tmatauang, tkurs, tnobon, tdebit, tkredit, tdebitvalas, tkreditvalas, tcarabayar, thutangpiutang, ttgljatuhtempo, ttgllunas, tstatuslunas, ttglrekonsiliasi, tsudahrekonsiliasi, turutan, tnohutangpiutang, tsaldoawal, tadjustment, tcostcenter, tdivisi, tsubdivisi, tproyek, tgrup, tretail, tjenisaruskas, tjmlrealisasium, tstatusrealisasi, tstatus, tposting, tpostingtgl, tjmlrevisi, tcetakanke, tinputuser, tinputtgl, tmodifikasiuser, tmodifikasitgl) values" & strValue.ToString & "")

            'TAMBAHKAN SQL UNTUK UPDATE TGLPOSTING JM
            rsSql = String.Concat(rsSql, sptRow, "UPDATE m2_jm SET jmposting = 1, jmpostingtgl = NOW() WHERE jmid = '" & idtransaksi & "'")
