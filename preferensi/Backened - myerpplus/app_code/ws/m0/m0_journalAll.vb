                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("ascabang")) & "', '" & FixQuotes(drutama("aslokasi")) & "', '" & FixQuotes(drutama("assumber")) & "', " & 0 & ", " & drutama("asid") & ", '" & FixQuotes(drutama("asnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("astgl"))) & "', " & drutama("askodepa") & ", " & drutama("askontak") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("asuraian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("asmatauang")) & "', '" & FixDouble(drutama("askurs")) & "', '', '" & 0 & "', '" & FixDouble(drjurnal("nominal")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalas")) & "', " & 0 & ", " & 0 & ", '" & FixQuotes(AsFormatTanggal(drutama("astgljatuhtempo"))) & "', '" & FixQuotes(AsFormatTanggal(drutama("astgllunas"))) & "', " & drutama("asstatusbayar") & ", '1900-01-01', " & 0 & ", " & drjurnal("urutan") & ", '', 0, 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '" & FixDouble(drutama("asjumlahbayar")) & "', " & drutama("asstatusbayar") & ", " & drutama("asstatus") & ", 1, NOW(), " & drutama("asjmlrevisi") & ", " & drutama("ascetakanke") & ", " & drutama("asinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("asinputtgl"), formatTglWaktuDB)) & "', " & drutama("asmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("asmodifikasitgl"), formatTglWaktuDB)) & "')")
