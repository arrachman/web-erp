#Region "M2_Cb"
    Public Function M2_Cb(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'AKUN DEBIT (D)
        '         AKUN KREDIT (K)

        Dim wsResult As String = ""
