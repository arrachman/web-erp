            End If
        Next

        'TAMBAHKAN SQL HAPUS JURNAL LAMA
        rsSql = "DELETE FROM M2_Transaction_Journal WHERE tsumber = 'CB' AND tidtransaksi = '" & FixDouble(idtransaksi) & "'"

        'GABUNGKAN VALUE SQL
