Imports System.Data
Imports AsModuleMySQL.CommonFunction

Public Class m0_journalAll
    Inherits System.Web.Services.WebService

    Dim userid As String = ""   'User Id diisi dengan user yang melakukan proses transaksi
    Dim formatTglDB As String = "yyyy-MM-dd"
    Dim formatTglWaktuDB As String = "yyyy-MM-dd H:mm:ss", vSQL As String = ""

    Public Function M0_JournalUlang(ByVal param As String) As String

        Dim paramSplit(6) As String     'WebsiteAccessKey(0), paket(1), paging(2), userid(3), isUpdate(4), data(5)
        Dim pagingSplit(6) As String    'pageNumber(0), itemLimit(1), strFilter(2), strSort(3), formatTgl(4), formatTglWaktu(5)
        Dim dataUtama() As String

        Dim result(5) As String         'target(0), success(1), errmessage(2), errstep(3), idtransaksi(4)
        Dim resultPaging(5) As String   'ispaging(0), isNext(1), isPrev(2), countPage(3), countRow(4)

        Dim wsResult As String = ""
        Dim strResult, strResultPaging, strResultData As String

        Dim isUpdate As Boolean, sql As String = "", stepKe As Double = 0
        Dim tglAwal As String = "", tglAkhir As String = "", sumber As String = ""
        Dim notransaksiAwal As String = "", notransaksiAkhir As String = ""
        Dim tidakAdaJurnal As Boolean = False, jurnalHpp As Boolean = False, hitungUlang As Boolean = False

        'SET DEFAULT RESULT
        result(0) = System.Reflection.MethodBase.GetCurrentMethod.Name 'Mengambil nama method
        result(1) = 0 : result(2) = "" : result(3) = 0 : result(4) = 0

        'SET DEFAULT PAGING
        resultPaging(0) = 0 : resultPaging(1) = 0 : resultPaging(2) = 0 : resultPaging(3) = 0 : resultPaging(4) = 0


        'VALIDASI PARAMETER GLOBAL =========================================================
        'SPILIT PARAM
        paramSplit = param.Split(sptParam)

        'CEK ARRAY PARAM
        If (paramSplit.Length <> 6) Then
            result(2) = "Invalid parameter." : GoTo selesai
        End If
        'END OF VALIDASI PARAMETER GLOBAL ==================================================


        'VALIDASI WEBSITEACCESSKEY =========================================================
        If Len(paramSplit(0)) = 0 Then
            result(2) = "WebsiteAccessKey can't be empty." : GoTo selesai
        End If

        'Cek apakah WebsiteAccessKey valid
        Dim ClsValidKey As New ClsSecurity
        Dim validKey As RsValidKey
        validKey = ValidateKey(paramSplit(0))
        If Not validKey.success Then result(2) = validKey.errmessage : GoTo selesai

        '///Validasi Hak akses. Cek ModuleID dan MenuID
        If ClsValidKey.ApaBisaAkses(1, 1, 1) = False Then
            result(2) = "Access denied for insert/update data"
        End If
        'END OF VALIDASI WEBSITEACCESSKEY ==================================================


        'VALIDASI DAN SET USERID ===========================================================
        'CEK USERID
        If (IsNumeric(paramSplit(3)) = False) Then
            result(2) = "userid required numeric." : GoTo selesai
        End If

        'SET USERID
        userid = paramSplit(3)
        'END OF VALIDASI DAN SET USERID ====================================================


        'VALIDASI DAN SET ISUPDATE =========================================================
        'CEK ISUPDATE
        If (IsNumeric(paramSplit(4)) = False) Then
            result(2) = "isupdate required numeric." : GoTo selesai
        Else
            'SET ISUPDATE
            If (Val(paramSplit(4)) = 1) Then
                isUpdate = True
            Else
                isUpdate = False
            End If
        End If
        'END OF VALIDASI DAN SET USERID ====================================================


        'MAPPING BUAT WS ----------------------------------------------------------
        'tglAwal(0) As Date, tglAkhir(1) As Date, sumber(2) As String, notransaksiAwal(3) As String, notransaksiAkhir(4) As String, 
        'tidakAdaJurnal(5) As Integer, jurnalHpp(6) As Integer, hitungUlang(7) As Integer

        'MAPPING BUAT FLEX --------------------------------------------------------
        'tglAwal, tglAkhir, sumber, notransaksiAwal, notransaksiAkhir, tidakAdaJurnal, jurnalHpp, hitungUlang


        'VALIDASI DAN SET DATA =======================================================
        'SPILIT PARAMETER DATA
        dataUtama = paramSplit(5).Split(sptField)

        'CEK ARRAY DATA
        If (dataUtama.Length <> 8) Then
            result(2) = "Invalid data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA ================================================


        'VALIDASI TIPE DATA ==========================================================
        'tglAwal(0) As Date
        If (IsDate(dataUtama(0)) = False) Then
            result(2) = "tglAwal required date." : GoTo selesai
        Else
            tglAwal = AsFormatTanggal(dataUtama(0))
        End If

        'tglAkhir(1) As Date
        If (IsDate(dataUtama(1)) = False) Then
            result(2) = "tglAkhir required date." : GoTo selesai
        Else
            tglAkhir = AsFormatTanggal(dataUtama(1))
        End If

        'sumber(2) As String
        If Len(dataUtama(2)) > 0 Then
            sumber = dataUtama(2)
        End If

        'notransaksiAwal(3) As String
        If Len(dataUtama(3)) > 0 Then
            notransaksiAwal = dataUtama(3)
        End If

        'notransaksiAkhir(4) As String
        If Len(dataUtama(4)) > 0 Then
            notransaksiAkhir = dataUtama(4)
        End If

        'tidakAdaJurnal(5) As Integer
        If (IsNumeric(dataUtama(5)) = False) Then
            result(2) = "tidakAdaJurnal required numeric." : GoTo selesai
        Else
            If dataUtama(5) = 1 Then
                'jika 1, maka = true (filter untuk transaksi yang tidak ada jurnal saja)
                tidakAdaJurnal = True
            Else
                'jika 0, maka = false (filter untuk semua transaksi)
                tidakAdaJurnal = False
            End If
        End If

        'jurnalHpp(6) As Integer
        If (IsNumeric(dataUtama(6)) = False) Then
            result(2) = "jurnalHpp required numeric." : GoTo selesai
        Else
            If dataUtama(6) = 1 Then
                'jika 1, maka = true (filter untuk transaksi hpp saja)
                jurnalHpp = True
            Else
                'jika 0, maka = false (filter untuk semua transaksi)
                jurnalHpp = False
            End If
        End If

        'hitungUlang(7) As Integer
        If (IsNumeric(dataUtama(7)) = False) Then
            result(2) = "hitungUlang required numeric." : GoTo selesai
        Else
            If dataUtama(7) = 1 Then
                'jika 1, maka = true (filter untuk transaksi yang telah hitung ulang hpp saja)
                hitungUlang = True
            Else
                'jika 0, maka = false (filter untuk semua transaksi)
                hitungUlang = False
            End If
        End If
        'END OF VALIDASI TIPE DATA ===================================================


        'PROSES JURNAL ULANG =========================================================
        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()


        'CEK PERIODE AKUNTANSI ==================================
        Dim arrCekPeriode(2) As String 'success(0), errmessage(1)
        Dim rsCekPeriode As String = M2_Accounting_PeriodeCheck(AsFormatTanggal(tglAwal), AsFormatTanggal(tglAkhir))
        arrCekPeriode = rsCekPeriode.Split(sptSubParam)
        If arrCekPeriode(0) = 0 Then result(2) = arrCekPeriode(1) : GoTo selesai
        'END OF CEK PERIODE AKUNTANSI ===========================


        'AMBIL SUMBER TRANSAKSI
        Dim jmlSumber As Double = 0, arrSumber(33) As String


        If Len(sumber) > 0 Then
            'JIKA SUMBER DIISI MAKA SET SUMBER SESUAI INPUTAN
            'ISI DATA SUMBER
            arrSumber(0) = sumber
            'SET JML SUMBER
            jmlSumber = 1

        Else
            'JIKA SUMBER TIDAK DIISI MAKA SET SUMBER BERDASARKAN JURNAL HPP ATAU SEMUA TRANSAKSI
            If jurnalHpp Then
                'JIKA JURNAL HPP, MAKA JURNAL ULANG TRANSAKSI HPP SAJA
                'ISI DATA SUMBER
                'M3
                arrSumber(0) = "SA" : arrSumber(1) = "IB"
                'M4
                arrSumber(2) = "GRN" : arrSumber(3) = "RI" : arrSumber(4) = "PRT"
                'M5
                arrSumber(5) = "SI" : arrSumber(6) = "SR"
                'M6
                arrSumber(7) = "PD"

                'SET JML SUMBER
                jmlSumber = arrSumber.Length

            Else
                'JIKA BUKAN JURNAL HPP, MAKA JURNAL ULANG SEMUA TRANSAKSI
                'ISI DATA SUMBER
                'M2
                arrSumber(0) = "CR" : arrSumber(1) = "CD" : arrSumber(2) = "RM" : arrSumber(3) = "SM" : arrSumber(4) = "AJ"
                arrSumber(5) = "GJ" : arrSumber(6) = "RG" : arrSumber(7) = "SG" : arrSumber(8) = "RGC" : arrSumber(9) = "SGC"
                arrSumber(10) = "CB" : arrSumber(10) = "JM"
                'M3
                arrSumber(11) = "SA" : arrSumber(12) = "IB"
                'M4
                arrSumber(13) = "AP" : arrSumber(14) = "GRN" : arrSumber(15) = "RI" : arrSumber(16) = "PRT" : arrSumber(17) = "VP"
                'M5
                arrSumber(18) = "AS" : arrSumber(19) = "IP" : arrSumber(20) = "SI" : arrSumber(21) = "RP" : arrSumber(22) = "SR"
                arrSumber(23) = "PV"
                'M6
                arrSumber(24) = "PD"
                'M7
                arrSumber(25) = "DA"
                'M11
                arrSumber(26) = "LU" : arrSumber(27) = "KM" : arrSumber(28) = "LB" : arrSumber(29) = "AK" : arrSumber(30) = "RK"
                arrSumber(31) = "PB" : arrSumber(32) = "RO" : arrSumber(33) = "KW"

                'SET JML SUMBER
                jmlSumber = arrSumber.Length
            End If

        End If


        'PROSES JURNAL PER SUMBER
        Dim dtTransaksi As New DataTable
        Dim ModuleID As Integer = 0, jGrup As Integer = 0, idTransaksi As String = ""
        Dim strJournal As String = "", rsJournal() As String, rsResult() As String

        For i = 1 To jmlSumber
            'TAMBAHKAN STEPKE, RESET GRUP
            stepKe += 1 : jGrup = 0
            'SET SUMBER
            sumber = arrSumber(i - 1)

            'SET MODULEID BERDASARKAN SUMBER
            '**************** M2 ****************
            If sumber.ToUpper = "CR" _
                Or sumber.ToUpper = "CD" _
                Or sumber.ToUpper = "RM" _
                Or sumber.ToUpper = "SM" _
                Or sumber.ToUpper = "AJ" _
                Or sumber.ToUpper = "GJ" _
                Or sumber.ToUpper = "RG" _
                Or sumber.ToUpper = "SG" _
                Or sumber.ToUpper = "RGC" _
                Or sumber.ToUpper = "SGC" _
                Or sumber.ToUpper = "CB" _
                Or sumber.ToUpper = "JM" _
                Then
                ModuleID = 2

                '************ M3 ****************
            ElseIf sumber.ToUpper = "SA" _
                Or sumber.ToUpper = "IB" _
                Then
                ModuleID = 3

                '************ M4 ****************
            ElseIf sumber.ToUpper = "AP" _
                Or sumber.ToUpper = "GRN" _
                Or sumber.ToUpper = "RI" _
                Or sumber.ToUpper = "PRT" _
                Or sumber.ToUpper = "VP" _
                Then
                ModuleID = 4

                'SET GRUP UNTUK PRT
                If sumber.ToUpper = "PRT" Then jGrup = 1

                '************ M5 ****************
            ElseIf sumber.ToUpper = "AS" _
                Or sumber.ToUpper = "IP" _
                Or sumber.ToUpper = "SI" _
                Or sumber.ToUpper = "RP" _
                Or sumber.ToUpper = "SR" _
                Or sumber.ToUpper = "PV" _
                Then
                ModuleID = 5

                'SET GRUP UNTUK SI ATAU SR
                If sumber.ToUpper = "SI" Or sumber.ToUpper = "SR" Then jGrup = 1

                '************ M6 ****************
            ElseIf sumber.ToUpper = "PD" _
                Then
                ModuleID = 6

                '************ M7 ****************
            ElseIf sumber.ToUpper = "DA" _
                Then
                ModuleID = 7

                '************ M11 ****************
            ElseIf sumber.ToUpper = "LU" _
                Or sumber.ToUpper = "KM" _
                Or sumber.ToUpper = "LB" _
                Or sumber.ToUpper = "AK" _
                Or sumber.ToUpper = "RK" _
                Or sumber.ToUpper = "PB" _
                Or sumber.ToUpper = "RO" _
                Or sumber.ToUpper = "KW" _
                Then
                ModuleID = 11

            Else
                result(2) = "Invalid Packet. (" & sumber & ")" : GoTo selesai
            End If

            'SUSUN SQL PENGAMBILAN DATA
            If jurnalHpp Then

                'SQL UNTUK JURNAL TRANSAKSI HPP SAJA
                If hitungUlang Then
                    'JIKA HITUNG ULANG, MAKA JURNAL ULANG UNTUK TRANSAKSI HPP YANG SUDAH HITUNG ULANG HPP SAJA
                    sql = "  SELECT idutama"
                    sql &= " FROM M1_Item_Transaction"
                    sql &= " WHERE sumber = '" & FixQuotes(sumber) & "'"
                    sql &= " AND hppfix = 1"
                    sql &= " AND jurnalfix = 0"

                    'TAMBAHKAN FILTER TANGGAL
                    If Len(tglAwal) > 0 And Len(tglAkhir) > 0 Then
                        sql &= " AND tgl BETWEEN '" & FixQuotes(tglAwal) & "' AND '" & FixQuotes(tglAkhir) & "'"
                    ElseIf Len(tglAwal) > 0 Then
                        sql &= " AND tgl >= '" & FixQuotes(tglAwal) & "'"
                    ElseIf Len(tglAkhir) > 0 Then
                        sql &= " AND tgl <= '" & FixQuotes(tglAkhir) & "'"
                    End If

                    'TAMBAHKAN FILTER NOTRANSAKSI
                    If Len(notransaksiAwal) > 0 And Len(notransaksiAkhir) > 0 Then
                        sql &= " AND notransaksi BETWEEN '" & FixQuotes(notransaksiAwal) & "' AND '" & FixQuotes(notransaksiAkhir) & "'"
                    ElseIf Len(notransaksiAwal) > 0 Then
                        sql &= " AND notransaksi >= '" & FixQuotes(notransaksiAwal) & "'"
                    ElseIf Len(notransaksiAkhir) > 0 Then
                        sql &= " AND notransaksi <= '" & FixQuotes(notransaksiAkhir) & "'"
                    End If

                    'TAMBAHKAN GROUP BY
                    sql &= " GROUP BY sumber, idutama"

                    'TAMBAHKAN ORDER BY
                    sql &= " ORDER BY tgl, notransaksi, idutama"

                Else
                    'JIKA TIDAK HITUNG ULANG, MAKA JURNAL ULANG UNTUK SEMUA TRANSAKSI HPP
                    sql = "  SELECT " & sumber & "id"
                    'sql &= " FROM M" & ModuleID & "_" & sumber & ""
                    sql &= " FROM M" & IIf(ModuleID < 10, ModuleID, "_" & ModuleID) & "_" & sumber & ""
                    sql &= " WHERE " & sumber & "status IN(2,3,4,7)"

                    'TAMBAHKAN FILTER TANGGAL
                    If Len(tglAwal) > 0 And Len(tglAkhir) > 0 Then
                        sql &= " AND " & sumber & "tgl BETWEEN '" & FixQuotes(tglAwal) & "' AND '" & FixQuotes(tglAkhir) & "'"
                    ElseIf Len(tglAwal) > 0 Then
                        sql &= " AND " & sumber & "tgl >= '" & FixQuotes(tglAwal) & "'"
                    ElseIf Len(tglAkhir) > 0 Then
                        sql &= " AND " & sumber & "tgl <= '" & FixQuotes(tglAkhir) & "'"
                    End If

                    'TAMBAHKAN FILTER NOTRANSAKSI
                    If Len(notransaksiAwal) > 0 And Len(notransaksiAkhir) > 0 Then
                        sql &= " AND " & sumber & "notransaksi BETWEEN '" & FixQuotes(notransaksiAwal) & "' AND '" & FixQuotes(notransaksiAkhir) & "'"
                    ElseIf Len(notransaksiAwal) > 0 Then
                        sql &= " AND " & sumber & "notransaksi >= '" & FixQuotes(notransaksiAwal) & "'"
                    ElseIf Len(notransaksiAkhir) > 0 Then
                        sql &= " AND " & sumber & "notransaksi <= '" & FixQuotes(notransaksiAkhir) & "'"
                    End If

                    'TAMBAHKAN GROUP BY
                    sql &= " GROUP BY " & sumber & "id"

                    'TAMBAHKAN ORDER BY
                    sql &= " ORDER BY " & sumber & "tgl, " & sumber & "notransaksi, " & sumber & "id"

                End If

            Else
                'SQL UNTUK SEMUA TRANSAKSI
                If tidakAdaJurnal Then
                    'JIKA TRANSAKSI YANG TIDAK PUNYA JURNAL SAJA
                    sql = "  SELECT " & sumber & "id"
                    'sql &= " FROM M" & ModuleID & "_" & sumber & ""
                    sql &= " FROM M" & IIf(ModuleID < 10, ModuleID, "_" & ModuleID) & "_" & sumber & ""
                    sql &= " LEFT JOIN M2_Transaction_Journal ON " & sumber & "sumber = tsumber AND " & sumber & "id = tidtransaksi AND " & sumber & "notransaksi = tnotransaksi"
                    sql &= " WHERE " & sumber & "status IN(2,3,4,7)"
                    sql &= " AND tid IS NULL"

                Else
                    'SEMUA TRANSAKSI
                    sql = "  SELECT " & sumber & "id"
                    'sql &= " FROM M" & ModuleID & "_" & sumber & ""
                    sql &= " FROM M" & IIf(ModuleID < 10, ModuleID, "_" & ModuleID) & "_" & sumber & ""
                    sql &= " WHERE " & sumber & "status IN(2,3,4,7)"
                End If

                'TAMBAHKAN FILTER TANGGAL
                If Len(tglAwal) > 0 And Len(tglAkhir) > 0 Then
                    sql &= " AND " & sumber & "tgl BETWEEN '" & FixQuotes(tglAwal) & "' AND '" & FixQuotes(tglAkhir) & "'"
                ElseIf Len(tglAwal) > 0 Then
                    sql &= " AND " & sumber & "tgl >= '" & FixQuotes(tglAwal) & "'"
                ElseIf Len(tglAkhir) > 0 Then
                    sql &= " AND " & sumber & "tgl <= '" & FixQuotes(tglAkhir) & "'"
                End If

                'TAMBAHKAN FILTER NOTRANSAKSI
                If Len(notransaksiAwal) > 0 And Len(notransaksiAkhir) > 0 Then
                    sql &= " AND " & sumber & "notransaksi BETWEEN '" & FixQuotes(notransaksiAwal) & "' AND '" & FixQuotes(notransaksiAkhir) & "'"
                ElseIf Len(notransaksiAwal) > 0 Then
                    sql &= " AND " & sumber & "notransaksi >= '" & FixQuotes(notransaksiAwal) & "'"
                ElseIf Len(notransaksiAkhir) > 0 Then
                    sql &= " AND " & sumber & "notransaksi <= '" & FixQuotes(notransaksiAkhir) & "'"
                End If

                'TAMBAHKAN GROUP BY
                sql &= " GROUP BY " & sumber & "id"

                'TAMBAHKAN ORDER BY
                sql &= " ORDER BY " & sumber & "tgl, " & sumber & "notransaksi, " & sumber & "id"

            End If


            'result(2) = sql : GoTo selesai
            'AMBIL DATA TRANSAKSI
            dtTransaksi = AsDataTableAmbilDariDB(sql)
            If dtTransaksi.Rows.Count > 0 Then
                For Each dr1 As DataRow In dtTransaksi.Rows
                    'SET IDTRANSAKSI
                    If jurnalHpp And hitungUlang Then
                        idTransaksi = dr1("idutama")
                    Else
                        idTransaksi = dr1(sumber & "id")
                    End If
ulanglagi:

                    'PANGGIL FUNGSI JURNAL - mapping fungsi yg dikirim = idmsmq, sumber, idtransaksi
                    strJournal = M0_Journal(paramSplit(0) & "★M0_Journal★0△0△△△dd/MM/yyyy△dd/MM/yyyy H:mm:ss★0★1★M0_Journal△" & sumber & "△" & idTransaksi & "")

                    '// FORMAT kembalian fungsi jurnal = result★paging★data, yg diambil bagian result saja. 
                    rsJournal = strJournal.Split(sptParam)

                    '// JIKA KEMBALIAN FUNGSI JURNAL <> 3 MAKA SALAH
                    If rsJournal.Length = 3 Then
                        '// AMBIL BAGIAN RESULT DARI FUNGSI JURNAL - result = target(0)△success(2)△errmessage(2)△errstep(3)△idtransaksi(4)
                        rsResult = rsJournal(0).Split(sptSubParam)
                        '// JIKA BAGIAN RESULT DARI FUNGSI JURNAL <> 5 MAKA SALAH
                        If rsResult.Length = 5 Then
                            If rsResult(1) <> 1 And rsResult(1) <> 4 Then '// JIKA GAGAL - KIRIM INFORMASI PROSES GAGAL, TAMPILKAN ERRMESSAGE

                                If rsResult(2).Contains("There is already an open DataReader") Or rsResult(2).Contains("Deadlock found") Then
                                    GoTo ulanglagi
                                End If
                                result(2) = "Journal proccess failed. " & sumber & " : " & idTransaksi & ". " & rsResult(2) & "" : GoTo selesai
                            End If
                        Else
                            result(2) = "Journal proccess failed. " & sumber & " : " & idTransaksi & ". Invalid result data #2'" : GoTo selesai
                        End If

                    Else
                        result(2) = "Journal proccess failed. " & sumber & " : " & idTransaksi & ". Invalid result data #1'" : GoTo selesai
                    End If

                Next
            End If

        Next

        result(1) = 1
        result(2) = ""
        result(3) = stepKe
        result(4) = result(4)
        'END OF PROSES JURNAL ULANG ==================================================


selesai:

        'SET ERR STEPKE
        result(3) = stepKe

        If result(1) = 0 Then
            If Len(result(2)) = 0 Then result(2) = "Nomor : " & Err.Number & ". Sumber : " & Err.Source & ".  Fungsi : " & System.Reflection.MethodBase.GetCurrentMethod.Name & ". Uraian : " & Err.Description & ". "
        End If

        strResult = String.Join(sptSubParam, result)
        strResultPaging = String.Join(sptSubParam, resultPaging)
        strResultData = ""
        wsResult = String.Concat(strResult.Substring(0, strResult.Length - 1), sptParam, strResultPaging.Substring(0, strResultPaging.Length - 1), sptParam, strResultData)

        Return wsResult
    End Function

    Public Function M0_JournalData(ByVal param As String) As String

        Dim paramSplit(6) As String     'WebsiteAccessKey(0), paket(1), paging(2), userid(3), isUpdate(4), data(5)
        Dim pagingSplit(6) As String    'pageNumber(0), itemLimit(1), strFilter(2), strSort(3), formatTgl(4), formatTglWaktu(5)
        Dim dataUtama() As String

        Dim result(5) As String         'target(0), success(1), errmessage(2), errstep(3), idtransaksi(4)
        Dim resultPaging(5) As String   'ispaging(0), isNext(1), isPrev(2), countPage(3), countRow(4)

        Dim wsResult As String = ""
        Dim strResult, strResultPaging, strResultData As String

        Dim isUpdate As Boolean, sql As String = "", stepKe As Double = 0
        Dim tglAwal As String = "", tglAkhir As String = "", sumber As String = ""
        Dim notransaksiAwal As String = "", notransaksiAkhir As String = ""
        Dim tidakAdaJurnal As Boolean = False, jurnalHpp As Boolean = False, hitungUlang As Boolean = False

        Dim dataHasil As String = ""

        'SET DEFAULT RESULT
        result(0) = System.Reflection.MethodBase.GetCurrentMethod.Name 'Mengambil nama method
        result(1) = 0 : result(2) = "" : result(3) = 0 : result(4) = 0

        'SET DEFAULT PAGING
        resultPaging(0) = 0 : resultPaging(1) = 0 : resultPaging(2) = 0 : resultPaging(3) = 0 : resultPaging(4) = 0


        'VALIDASI PARAMETER GLOBAL =========================================================
        'SPILIT PARAM
        paramSplit = param.Split(sptParam)

        'CEK ARRAY PARAM
        If (paramSplit.Length <> 6) Then
            result(2) = "Invalid parameter." : GoTo selesai
        End If
        'END OF VALIDASI PARAMETER GLOBAL ==================================================


        'VALIDASI WEBSITEACCESSKEY =========================================================
        If Len(paramSplit(0)) = 0 Then
            result(2) = "WebsiteAccessKey can't be empty." : GoTo selesai
        End If

        'Cek apakah WebsiteAccessKey valid
        Dim ClsValidKey As New ClsSecurity
        Dim validKey As RsValidKey
        validKey = ValidateKey(paramSplit(0))
        If Not validKey.success Then result(2) = validKey.errmessage : GoTo selesai

        '///Validasi Hak akses. Cek ModuleID dan MenuID
        If ClsValidKey.ApaBisaAkses(1, 1, 1) = False Then
            result(2) = "Access denied for insert/update data"
        End If
        'END OF VALIDASI WEBSITEACCESSKEY ==================================================


        'VALIDASI DAN SET USERID ===========================================================
        'CEK USERID
        If (IsNumeric(paramSplit(3)) = False) Then
            result(2) = "userid required numeric." : GoTo selesai
        End If

        'SET USERID
        userid = paramSplit(3)
        'END OF VALIDASI DAN SET USERID ====================================================


        'VALIDASI DAN SET ISUPDATE =========================================================
        'CEK ISUPDATE
        If (IsNumeric(paramSplit(4)) = False) Then
            result(2) = "isupdate required numeric." : GoTo selesai
        Else
            'SET ISUPDATE
            If (Val(paramSplit(4)) = 1) Then
                isUpdate = True
            Else
                isUpdate = False
            End If
        End If
        'END OF VALIDASI DAN SET USERID ====================================================


        'MAPPING BUAT WS ----------------------------------------------------------
        'tglAwal(0) As Date, tglAkhir(1) As Date, sumber(2) As String, notransaksiAwal(3) As String, notransaksiAkhir(4) As String, 
        'tidakAdaJurnal(5) As Integer, jurnalHpp(6) As Integer, hitungUlang(7) As Integer

        'MAPPING BUAT FLEX --------------------------------------------------------
        'tglAwal, tglAkhir, sumber, notransaksiAwal, notransaksiAkhir, tidakAdaJurnal, jurnalHpp, hitungUlang


        'VALIDASI DAN SET DATA =======================================================
        'SPILIT PARAMETER DATA
        dataUtama = paramSplit(5).Split(sptField)

        'CEK ARRAY DATA
        If (dataUtama.Length <> 8) Then
            result(2) = "Invalid data parameter." : GoTo selesai
        End If
        'END OF VALIDASI DAN SET DATA ================================================


        'VALIDASI TIPE DATA ==========================================================
        'tglAwal(0) As Date
        If (IsDate(dataUtama(0)) = False) Then
            result(2) = "tglAwal required date." : GoTo selesai
        Else
            tglAwal = AsFormatTanggal(dataUtama(0))
        End If

        'tglAkhir(1) As Date
        If (IsDate(dataUtama(1)) = False) Then
            result(2) = "tglAkhir required date." : GoTo selesai
        Else
            tglAkhir = AsFormatTanggal(dataUtama(1))
        End If

        'sumber(2) As String
        If Len(dataUtama(2)) > 0 Then
            sumber = dataUtama(2)
        End If

        'notransaksiAwal(3) As String
        If Len(dataUtama(3)) > 0 Then
            notransaksiAwal = dataUtama(3)
        End If

        'notransaksiAkhir(4) As String
        If Len(dataUtama(4)) > 0 Then
            notransaksiAkhir = dataUtama(4)
        End If

        'tidakAdaJurnal(5) As Integer
        If (IsNumeric(dataUtama(5)) = False) Then
            result(2) = "tidakAdaJurnal required numeric." : GoTo selesai
        Else
            If dataUtama(5) = 1 Then
                'jika 1, maka = true (filter untuk transaksi yang tidak ada jurnal saja)
                tidakAdaJurnal = True
            Else
                'jika 0, maka = false (filter untuk semua transaksi)
                tidakAdaJurnal = False
            End If
        End If

        'jurnalHpp(6) As Integer
        If (IsNumeric(dataUtama(6)) = False) Then
            result(2) = "jurnalHpp required numeric." : GoTo selesai
        Else
            If dataUtama(6) = 1 Then
                'jika 1, maka = true (filter untuk transaksi hpp saja)
                jurnalHpp = True
            Else
                'jika 0, maka = false (filter untuk semua transaksi)
                jurnalHpp = False
            End If
        End If

        'hitungUlang(7) As Integer
        If (IsNumeric(dataUtama(7)) = False) Then
            result(2) = "hitungUlang required numeric." : GoTo selesai
        Else
            If dataUtama(7) = 1 Then
                'jika 1, maka = true (filter untuk transaksi yang telah hitung ulang hpp saja)
                hitungUlang = True
            Else
                'jika 0, maka = false (filter untuk semua transaksi)
                hitungUlang = False
            End If
        End If
        'END OF VALIDASI TIPE DATA ===================================================


        'PROSES JURNAL ULANG =========================================================
        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()


        'CEK PERIODE AKUNTANSI ==================================
        Dim arrCekPeriode(2) As String 'success(0), errmessage(1)
        Dim rsCekPeriode As String = M2_Accounting_PeriodeCheck(AsFormatTanggal(tglAwal), AsFormatTanggal(tglAkhir))
        arrCekPeriode = rsCekPeriode.Split(sptSubParam)
        If arrCekPeriode(0) = 0 Then result(2) = arrCekPeriode(1) : GoTo selesai
        'END OF CEK PERIODE AKUNTANSI ===========================


        'AMBIL SUMBER TRANSAKSI
        Dim jmlSumber As Double = 0, arrSumber(33) As String


        If Len(sumber) > 0 Then
            'JIKA SUMBER DIISI MAKA SET SUMBER SESUAI INPUTAN
            'ISI DATA SUMBER
            arrSumber(0) = sumber
            'SET JML SUMBER
            jmlSumber = 1

        Else
            'JIKA SUMBER TIDAK DIISI MAKA SET SUMBER BERDASARKAN JURNAL HPP ATAU SEMUA TRANSAKSI
            If jurnalHpp Then
                'JIKA JURNAL HPP, MAKA JURNAL ULANG TRANSAKSI HPP SAJA
                'ISI DATA SUMBER
                'M3
                arrSumber(0) = "SA" : arrSumber(1) = "IB"
                'M4
                arrSumber(2) = "GRN" : arrSumber(3) = "RI" : arrSumber(4) = "PRT"
                'M5
                arrSumber(5) = "SI" : arrSumber(6) = "SR"
                'M6
                arrSumber(7) = "PD"

                'SET JML SUMBER
                jmlSumber = arrSumber.Length

            Else
                'JIKA BUKAN JURNAL HPP, MAKA JURNAL ULANG SEMUA TRANSAKSI
                'ISI DATA SUMBER
                'M2
                arrSumber(0) = "CR" : arrSumber(1) = "CD" : arrSumber(2) = "RM" : arrSumber(3) = "SM" : arrSumber(4) = "AJ"
                arrSumber(5) = "GJ" : arrSumber(6) = "RG" : arrSumber(7) = "SG" : arrSumber(8) = "RGC" : arrSumber(9) = "SGC"
                arrSumber(10) = "CB" : arrSumber(10) = "JM"
                'M3
                arrSumber(11) = "SA" : arrSumber(12) = "IB"
                'M4
                arrSumber(13) = "AP" : arrSumber(14) = "GRN" : arrSumber(15) = "RI" : arrSumber(16) = "PRT" : arrSumber(17) = "VP"
                'M5
                arrSumber(18) = "AS" : arrSumber(19) = "IP" : arrSumber(20) = "SI" : arrSumber(21) = "RP" : arrSumber(22) = "SR"
                arrSumber(23) = "PV"
                'M6
                arrSumber(24) = "PD"
                'M7
                arrSumber(25) = "DA"
                'M11
                arrSumber(26) = "LU" : arrSumber(27) = "KM" : arrSumber(28) = "LB" : arrSumber(29) = "AK" : arrSumber(30) = "RK"
                arrSumber(31) = "PB" : arrSumber(32) = "RO" : arrSumber(33) = "KW"

                'SET JML SUMBER
                jmlSumber = arrSumber.Length
            End If

        End If


        'PROSES JURNAL PER SUMBER
        Dim dtTransaksi As New DataTable
        Dim ModuleID As Integer = 0, jGrup As Integer = 0, idTransaksi As String = ""
        Dim strJournal As String = "" ', rsJournal() As String, rsResult() As String

        For i = 1 To jmlSumber
            'TAMBAHKAN STEPKE, RESET GRUP
            stepKe += 1 : jGrup = 0
            'SET SUMBER
            sumber = arrSumber(i - 1)

            'SET MODULEID BERDASARKAN SUMBER
            '**************** M2 ****************
            If sumber.ToUpper = "CR" _
                Or sumber.ToUpper = "CD" _
                Or sumber.ToUpper = "RM" _
                Or sumber.ToUpper = "SM" _
                Or sumber.ToUpper = "AJ" _
                Or sumber.ToUpper = "GJ" _
                Or sumber.ToUpper = "RG" _
                Or sumber.ToUpper = "SG" _
                Or sumber.ToUpper = "RGC" _
                Or sumber.ToUpper = "SGC" _
                Or sumber.ToUpper = "CB" _
                Or sumber.ToUpper = "JM" _
                Then
                ModuleID = 2

                '************ M3 ****************
            ElseIf sumber.ToUpper = "SA" _
                Or sumber.ToUpper = "IB" _
                Then
                ModuleID = 3

                '************ M4 ****************
            ElseIf sumber.ToUpper = "AP" _
                Or sumber.ToUpper = "GRN" _
                Or sumber.ToUpper = "RI" _
                Or sumber.ToUpper = "PRT" _
                Or sumber.ToUpper = "VP" _
                Then
                ModuleID = 4

                'SET GRUP UNTUK PRT
                If sumber.ToUpper = "PRT" Then jGrup = 1

                '************ M5 ****************
            ElseIf sumber.ToUpper = "AS" _
                Or sumber.ToUpper = "IP" _
                Or sumber.ToUpper = "SI" _
                Or sumber.ToUpper = "RP" _
                Or sumber.ToUpper = "SR" _
                Or sumber.ToUpper = "PV" _
                Then
                ModuleID = 5

                'SET GRUP UNTUK SI ATAU SR
                If sumber.ToUpper = "SI" Or sumber.ToUpper = "SR" Then jGrup = 1

                '************ M6 ****************
            ElseIf sumber.ToUpper = "PD" _
                Then
                ModuleID = 6

                '************ M7 ****************
            ElseIf sumber.ToUpper = "DA" _
                Then
                ModuleID = 7

                '************ M11 ****************
            ElseIf sumber.ToUpper = "LU" _
                Or sumber.ToUpper = "KM" _
                Or sumber.ToUpper = "LB" _
                Or sumber.ToUpper = "AK" _
                Or sumber.ToUpper = "RK" _
                Or sumber.ToUpper = "PB" _
                Or sumber.ToUpper = "RO" _
                Or sumber.ToUpper = "KW" _
                Then
                ModuleID = 11

                'SET GRUP UNTUK AK
                If sumber.ToUpper = "AK" Then jGrup = 1
            Else
                result(2) = "Invalid Packet. (" & sumber & ")" : GoTo selesai
            End If

            'SUSUN SQL PENGAMBILAN DATA
            If jurnalHpp Then

                'SQL UNTUK JURNAL TRANSAKSI HPP SAJA
                If hitungUlang Then
                    'JIKA HITUNG ULANG, MAKA JURNAL ULANG UNTUK TRANSAKSI HPP YANG SUDAH HITUNG ULANG HPP SAJA
                    sql = "  SELECT idutama"
                    sql &= " FROM M1_Item_Transaction"
                    sql &= " WHERE sumber = '" & FixQuotes(sumber) & "'"
                    sql &= " AND hppfix = 1"
                    sql &= " AND jurnalfix = 0"

                    'TAMBAHKAN FILTER TANGGAL
                    If Len(tglAwal) > 0 And Len(tglAkhir) > 0 Then
                        sql &= " AND tgl BETWEEN '" & FixQuotes(tglAwal) & "' AND '" & FixQuotes(tglAkhir) & "'"
                    ElseIf Len(tglAwal) > 0 Then
                        sql &= " AND tgl >= '" & FixQuotes(tglAwal) & "'"
                    ElseIf Len(tglAkhir) > 0 Then
                        sql &= " AND tgl <= '" & FixQuotes(tglAkhir) & "'"
                    End If

                    'TAMBAHKAN FILTER NOTRANSAKSI
                    If Len(notransaksiAwal) > 0 And Len(notransaksiAkhir) > 0 Then
                        sql &= " AND notransaksi BETWEEN '" & FixQuotes(notransaksiAwal) & "' AND '" & FixQuotes(notransaksiAkhir) & "'"
                    ElseIf Len(notransaksiAwal) > 0 Then
                        sql &= " AND notransaksi >= '" & FixQuotes(notransaksiAwal) & "'"
                    ElseIf Len(notransaksiAkhir) > 0 Then
                        sql &= " AND notransaksi <= '" & FixQuotes(notransaksiAkhir) & "'"
                    End If

                    'TAMBAHKAN GROUP BY
                    sql &= " GROUP BY sumber, idutama"

                    'TAMBAHKAN ORDER BY
                    sql &= " ORDER BY tgl, notransaksi, idutama"

                Else
                    'JIKA TIDAK HITUNG ULANG, MAKA JURNAL ULANG UNTUK SEMUA TRANSAKSI HPP
                    sql = "  SELECT " & sumber & "id"
                    'sql &= " FROM M" & ModuleID & "_" & sumber & ""
                    sql &= " FROM M" & IIf(ModuleID < 10, ModuleID, "_" & ModuleID) & "_" & sumber & ""
                    sql &= " WHERE " & sumber & "status IN(2,3,4,7)"

                    'TAMBAHKAN FILTER TANGGAL
                    If Len(tglAwal) > 0 And Len(tglAkhir) > 0 Then
                        sql &= " AND " & sumber & "tgl BETWEEN '" & FixQuotes(tglAwal) & "' AND '" & FixQuotes(tglAkhir) & "'"
                    ElseIf Len(tglAwal) > 0 Then
                        sql &= " AND " & sumber & "tgl >= '" & FixQuotes(tglAwal) & "'"
                    ElseIf Len(tglAkhir) > 0 Then
                        sql &= " AND " & sumber & "tgl <= '" & FixQuotes(tglAkhir) & "'"
                    End If

                    'TAMBAHKAN FILTER NOTRANSAKSI
                    If Len(notransaksiAwal) > 0 And Len(notransaksiAkhir) > 0 Then
                        sql &= " AND " & sumber & "notransaksi BETWEEN '" & FixQuotes(notransaksiAwal) & "' AND '" & FixQuotes(notransaksiAkhir) & "'"
                    ElseIf Len(notransaksiAwal) > 0 Then
                        sql &= " AND " & sumber & "notransaksi >= '" & FixQuotes(notransaksiAwal) & "'"
                    ElseIf Len(notransaksiAkhir) > 0 Then
                        sql &= " AND " & sumber & "notransaksi <= '" & FixQuotes(notransaksiAkhir) & "'"
                    End If

                    'TAMBAHKAN GROUP BY
                    sql &= " GROUP BY " & sumber & "id"

                    'TAMBAHKAN ORDER BY
                    sql &= " ORDER BY " & sumber & "tgl, " & sumber & "notransaksi, " & sumber & "id"

                End If

            Else
                'SQL UNTUK SEMUA TRANSAKSI
                If tidakAdaJurnal Then
                    'JIKA TRANSAKSI YANG TIDAK PUNYA JURNAL SAJA
                    sql = "  SELECT " & sumber & "id"
                    'sql &= " FROM M" & ModuleID & "_" & sumber & ""
                    sql &= " FROM M" & IIf(ModuleID < 10, ModuleID, "_" & ModuleID) & "_" & sumber & ""
                    sql &= " LEFT JOIN M2_Transaction_Journal ON " & sumber & "sumber = tsumber AND " & sumber & "id = tidtransaksi AND " & sumber & "notransaksi = tnotransaksi"
                    sql &= " WHERE " & sumber & "status IN(2,3,4,7)"
                    sql &= " AND tid IS NULL"

                Else
                    'SEMUA TRANSAKSI
                    sql = "  SELECT " & sumber & "id"
                    'sql &= " FROM M" & ModuleID & "_" & sumber & ""
                    sql &= " FROM M" & IIf(ModuleID < 10, ModuleID, "_" & ModuleID) & "_" & sumber & ""
                    sql &= " WHERE " & sumber & "status IN(2,3,4,7)"
                End If

                'TAMBAHKAN FILTER TANGGAL
                If Len(tglAwal) > 0 And Len(tglAkhir) > 0 Then
                    sql &= " AND " & sumber & "tgl BETWEEN '" & FixQuotes(tglAwal) & "' AND '" & FixQuotes(tglAkhir) & "'"
                ElseIf Len(tglAwal) > 0 Then
                    sql &= " AND " & sumber & "tgl >= '" & FixQuotes(tglAwal) & "'"
                ElseIf Len(tglAkhir) > 0 Then
                    sql &= " AND " & sumber & "tgl <= '" & FixQuotes(tglAkhir) & "'"
                End If

                'TAMBAHKAN FILTER NOTRANSAKSI
                If Len(notransaksiAwal) > 0 And Len(notransaksiAkhir) > 0 Then
                    sql &= " AND " & sumber & "notransaksi BETWEEN '" & FixQuotes(notransaksiAwal) & "' AND '" & FixQuotes(notransaksiAkhir) & "'"
                ElseIf Len(notransaksiAwal) > 0 Then
                    sql &= " AND " & sumber & "notransaksi >= '" & FixQuotes(notransaksiAwal) & "'"
                ElseIf Len(notransaksiAkhir) > 0 Then
                    sql &= " AND " & sumber & "notransaksi <= '" & FixQuotes(notransaksiAkhir) & "'"
                End If

                'TAMBAHKAN GROUP BY
                sql &= " GROUP BY " & sumber & "id"

                'TAMBAHKAN ORDER BY
                sql &= " ORDER BY " & sumber & "tgl, " & sumber & "notransaksi, " & sumber & "id"

            End If

            'AMBIL DATA TRANSAKSI
            Dim datatransaksi As String = ""
            dtTransaksi = AsDataTableAmbilDariDB(sql)
            If dtTransaksi.Rows.Count > 0 Then
                For Each dr1 As DataRow In dtTransaksi.Rows
                    'SET IDTRANSAKSI
                    If jurnalHpp And hitungUlang Then
                        idTransaksi = dr1("idutama")
                    Else
                        idTransaksi = dr1(sumber & "id")
                    End If
                    datatransaksi += idTransaksi.ToString + sptLogin
                Next
                datatransaksi = datatransaksi.Substring(0, datatransaksi.Length - 1)
                dataHasil += sumber + sptField + dtTransaksi.Rows.Count.ToString + sptField + datatransaksi + sptRow
            End If
        Next


        If dataHasil <> "" Then
            dataHasil = dataHasil.Substring(0, dataHasil.Length - 1)
        End If
        result(1) = 1
selesai:

        'SET ERR STEPKE
        result(3) = stepKe

        If result(1) = 0 Then
            If Len(result(2)) = 0 Then result(2) = "Nomor : " & Err.Number & ". Sumber : " & Err.Source & ".  Fungsi : " & System.Reflection.MethodBase.GetCurrentMethod.Name & ". Uraian : " & Err.Description & ". "
        End If

        strResult = String.Join(sptSubParam, result)
        strResultPaging = String.Join(sptSubParam, resultPaging)
        strResultData = dataHasil
        wsResult = String.Concat(strResult.Substring(0, strResult.Length - 1), sptParam, strResultPaging.Substring(0, strResultPaging.Length - 1), sptParam, strResultData, sptParam, ReplaceMapping("sumber, transaksi, data"))

        Return wsResult
    End Function

    Public Function M0_Journal(ByVal param As String) As String

        Dim objCmd As MySql.Data.MySqlClient.MySqlCommand
        Dim Trans As MySql.Data.MySqlClient.MySqlTransaction

        Dim paramSplit(6) As String     'WebsiteAccessKey(0), paket(1), paging(2), userid(3), isUpdate(4), data(5)
        Dim pagingSplit(6) As String    'pageNumber(0), itemLimit(1), strFilter(2), strSort(3), formatTgl(4), formatTglWaktu(5)
        Dim idSplit(1) As String

        Dim result(5) As String         'target(0), success(1), errmessage(2), errstep(3), idtransaksi(4)
        Dim resultPaging(5) As String   'ispaging(0), isNext(1), isPrev(2), countPage(3), countRow(4)

        Dim wsResult As String = ""
        Dim strResult, strResultPaging As String

        Dim sql As String = ""

        Dim pg1 As New RsPaging

        'SET DEFAULT RESULT
        result(0) = System.Reflection.MethodBase.GetCurrentMethod.Name 'Mengambil nama method
        result(1) = 0 : result(2) = "" : result(3) = 0 : result(4) = 0

        'SET DEFAULT PAGING
        resultPaging(0) = 0 : resultPaging(1) = 0 : resultPaging(2) = 0 : resultPaging(3) = 0 : resultPaging(4) = 0

        'VALIDASI PARAMETER GLOBAL =========================================================
        'SPILIT PARAM
        paramSplit = param.Split(sptParam)

        'CEK ARRAY PARAM
        If (paramSplit.Length <> 6) Then
            result(2) = "Invalid parameter." : GoTo selesai
        End If
        'END OF VALIDASI PARAMETER GLOBAL ==================================================

        'VALIDASI WEBSITEACCESSKEY =========================================================
        If Len(paramSplit(0)) = 0 Then
            result(2) = "WebsiteAccessKey can't be empty." : GoTo selesai
        End If

        'Cek apakah WebsiteAccessKey valid
        Dim ClsValidKey As New ClsSecurity
        Dim validKey As RsValidKey
        validKey = ValidateKey(paramSplit(0))
        If Not validKey.success Then result(2) = validKey.errmessage : GoTo selesai

        '///Validasi Hak akses. Cek ModuleID dan MenuID
        If ClsValidKey.ApaBisaAkses(1, 1, 1) = False Then
            result(2) = "Access denied for insert/update data"
        End If
        'END OF VALIDASI WEBSITEACCESSKEY ==================================================

        'VALIDASI DAN SET USERID ===========================================================
        'CEK USERID
        If (IsNumeric(paramSplit(3)) = False) Then
            result(2) = "userid required numeric." : GoTo selesai
        End If

        'SET USERID
        userid = paramSplit(3)
        'END OF VALIDASI DAN SET USERID ====================================================

        'VALIDASI DAN SET IDTRANSAKSI ======================================================
        'CEK IDMSMQ, SUMBER DAN IDTRANSAKSI
        Dim msmqId As String = "", sumber As String = "", idtransaksi As String = ""
        Dim idtrans(3) As String
        idtrans = paramSplit(5).Split(sptSubParam)
        If (idtrans.Length <> 3) Then
            result(2) = "Invalid key parameter." : GoTo selesai
        Else
            'CEK IDMSMQ
            If (Len(idtrans(0)) = 0) Then
                result(2) = "MSMQ ID can't be empty." : GoTo selesai
            Else
                msmqId = idtrans(0)
            End If
            'CEK SUMBER
            If (Len(idtrans(1)) = 0) Then
                result(2) = "Sumber can't be empty." : GoTo selesai
            Else
                sumber = idtrans(1)
            End If
            'CEK IDTRANSAKSI
            If (IsNumeric(idtrans(2)) = False) Then
                result(2) = "ID Transaksi required numeric." : GoTo selesai
            Else
                idtransaksi = idtrans(2)
            End If
        End If
        'END OF VALIDASI DAN SET IDTRANSAKSI ===============================================


        'SIMPAN KE DATABASE ================================================================

        Con1 = New MySql.Data.MySqlClient.MySqlConnection(Application("As_ConStr1"))
        Con1.Open()

        Dim rsJurnal As String = "" 'progress△errMessage△sqljurnal▲sqlupdateposting
        Dim rsProgress As Integer = 0, rsErrMessage As String = "", rsSql As String = ""

        'PANGGIL JURNAL BERDASARKAN SUMBER
        Select Case sumber.ToUpper
            '**************** M2 ****************
            Case "CR" : rsJurnal = M2_Cr(idtransaksi)
            Case "CD" : rsJurnal = M2_Cd(idtransaksi)
            Case "RM" : rsJurnal = M2_Rm(idtransaksi)
            Case "SM" : rsJurnal = M2_Sm(idtransaksi)
            Case "AJ" : rsJurnal = M2_Aj(idtransaksi)
            Case "GJ" : rsJurnal = M2_Gj(idtransaksi)
            Case "RG" : rsJurnal = M2_Rg(idtransaksi)
            Case "SG" : rsJurnal = M2_Sg(idtransaksi)
            Case "RGC" : rsJurnal = M2_Rgc(idtransaksi)
            Case "SGC" : rsJurnal = M2_Sgc(idtransaksi)
            Case "CB" : rsJurnal = M2_Cb(idtransaksi)
            Case "JM" : rsJurnal = M2_Jm(idtransaksi)

                '************ M3 ****************
            Case "SA" : rsJurnal = M3_Sa(idtransaksi)
            Case "IB" : rsJurnal = M3_Ib(idtransaksi)

                '************ M4 ****************
            Case "AP" : rsJurnal = M4_Ap(idtransaksi)
            Case "GRN" : rsJurnal = M4_Grn(idtransaksi)
            Case "RI" : rsJurnal = M4_Ri(idtransaksi)
            Case "PRT" : rsJurnal = M4_Prt(idtransaksi)
            Case "VP" : rsJurnal = M4_Vp(idtransaksi)

                '************ M5 ****************
            Case "IP" : rsJurnal = M5_Ip(idtransaksi)
            Case "AS" : rsJurnal = M5_As(idtransaksi)
            Case "SI" : rsJurnal = M5_Si(idtransaksi)
            Case "RP" : rsJurnal = M5_Rp(idtransaksi)
            Case "SR" : rsJurnal = M5_Sr(idtransaksi)
            Case "PV" : rsJurnal = M5_Pv(idtransaksi)

                '************ M6 ****************
            Case "PD" : rsJurnal = M6_Pd(idtransaksi)

                '************ M7 ****************
            Case "DA" : rsJurnal = M7_Da(idtransaksi)

                '************ M11 ****************
            Case "LU" : rsJurnal = M11_Lu(idtransaksi)
            Case "KM" : rsJurnal = M11_Km(idtransaksi)
            Case "LB" : rsJurnal = M11_Lb(idtransaksi)
            Case "AK"
                rsJurnal = M11_Ak(idtransaksi)
                M11_AkCOGS(idtransaksi)
            Case "RK" : rsJurnal = M11_Rk(idtransaksi)
            Case "PB" : rsJurnal = M11_Pb(idtransaksi)
            Case "RO"
                rsJurnal = M11_Ro(idtransaksi)
                M11_RoCOGS(idtransaksi)
            Case "KW" : rsJurnal = M11_Kw(idtransaksi)

            Case Else
                result(2) = "Invalid Packet." : GoTo selesai
        End Select

        'SPLIT HASIL JURNAL (progress, errmessage, sql)
        Dim sptRsJurnal() As String = rsJurnal.Split(sptSubParam)
        If sptRsJurnal.Length <> 3 Then
            result(2) = "Invalid journal result." : GoTo selesai
        Else
            rsProgress = sptRsJurnal(0)
            rsErrMessage = sptRsJurnal(1)
            rsSql = sptRsJurnal(2)
        End If

        'JIKA HASIL JURNAL TIDAK ERROR MAKA EKSEKUSI SQL
        'If rsProgress = 1 Then

        result(1) = 0
        '*** Start Transaction ***'  
        Trans = Con1.BeginTransaction(IsolationLevel.ReadCommitted)

        Try
            'EKSEKUSI SQL SESUAI BANYAKNYA QUERY HASIL JURNAL
            Dim sptRsSql() As String = rsSql.Split(sptRow)
            'result(2) = ""
            For i As Integer = 1 To sptRsSql.Length
                sql = sptRsSql(i - 1)
                vSQL = sql
                'result(2) += sql + "@"
                'JIKA SQL TERISI MAKA DI EKSEKUSI
                If Len(sql) > 0 Then
                    objCmd = New MySql.Data.MySqlClient.MySqlCommand()
                    With objCmd
                        .Connection = Con1
                        .Transaction = Trans
                        .CommandType = CommandType.Text
                        .CommandText = sql
                    End With
                    objCmd.ExecuteNonQuery()
                    'Else
                    '    result(2) = "Invalid journal : " & i - 1 & "." : Trans.Rollback() : GoTo selesai
                End If
            Next

            'JIKA HASIL JURNAL TIDAK ERROR MAKA UPDATE STATUS TABEL MSQMQ JURNAL = SUKSES(2), ELSE = GAGAL(3)
            Dim mjprogress As Integer = 0
            If rsProgress = 1 Then
                'JIKA 1 MAKA SUKSES(2)
                mjprogress = 2
            ElseIf rsProgress = 4 Then
                'JIKA 4 MAKA TRANSAKSI TDK APPROVED(4)
                mjprogress = 4
            Else
                'SELAIN 1 DAN 4 MAKA GAGAL(3)
                mjprogress = 3
            End If


            'UPDATE STATUS TABEL MSQMQ JURNAL
            sql = "UPDATE m0_msmq_journal SET mjprogress = '" & mjprogress & "', mjpesan = '" & FixQuotes(rsErrMessage) & "', mjtglselesai = NOW() WHERE mjid = '" & msmqId & "'"
            objCmd = New MySql.Data.MySqlClient.MySqlCommand()
            With objCmd
                .Connection = Con1
                .Transaction = Trans
                .CommandType = CommandType.Text
                .CommandText = sql
            End With
            objCmd.ExecuteNonQuery()

            Trans.Commit()  '*** Commit Transaction ***'
            result(1) = rsProgress
            result(2) = rsErrMessage
            result(3) = 0
            result(4) = result(4)

        Catch ex As Exception

            Trans.Rollback() '*** RollBack Transaction ***'  
            result(1) = 0
            result(2) = "Transaction Rollback : " & ex.Message & vSQL
            result(3) = 0
            result(4) = result(4)

        End Try

        objCmd = Nothing
        'Con1.Close()
        'END OF SIMPAN KE DATABASE =========================================================

        'Else
        'result(2) = rsErrMessage : GoTo selesai
        'End If

selesai:
        If result(1) = 0 Then
            If Len(result(2)) = 0 Then result(2) = "Nomor : " & Err.Number & ". Sumber : " & Err.Source & ".  Fungsi : " & System.Reflection.MethodBase.GetCurrentMethod.Name & ". Uraian : " & Err.Description & ". "
        End If

        strResult = String.Join(sptSubParam, result)
        strResultPaging = String.Join(sptSubParam, resultPaging)
        wsResult = String.Concat(strResult.Substring(0, strResult.Length - 1), sptParam, strResultPaging.Substring(0, strResultPaging.Length - 1), sptParam)

        Return wsResult
    End Function

