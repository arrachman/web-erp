                strValue.Append("(" & 0 & ", '" & FixQuotes(drutama("cbcabang")) & "', '" & FixQuotes(drutama("cblokasi")) & "', '" & FixQuotes(drutama("cbsumber")) & "', " & 0 & ", " & drutama("cbid") & ", '" & FixQuotes(drutama("cbnotransaksi")) & "', '" & FixQuotes(AsFormatTanggal(drutama("cbtgl"))) & "', " & drutama("cbkodepa") & ", " & drutama("cbkontak") & ", '" & FixQuotes(drjurnal("norek")) & "', '" & FixQuotes(drutama("cburaian")) & "', '" & FixQuotes(drjurnal("catatan")) & "', '" & FixQuotes(drutama("cbmatauang")) & "', '" & FixDouble(drutama("cbkurs")) & "', '', '" & FixDouble(drjurnal("nominal")) & "', '" & 0 & "', '" & FixDouble(drjurnal("nominalvalas")) & "', '" & 0 & "', " & 0 & ", " & 0 & ", '1900-01-01', '" & FixQuotes(AsFormatTanggal(drutama("cbtgllunas"))) & "', " & drutama("cbstatusbayar") & ", '1900-01-01', " & 0 & ", " & drjurnal("urutan") & ", '', 0, 0, '" & FixQuotes(drjurnal("costcenter")) & "', '" & FixQuotes(drjurnal("divisi")) & "', '" & FixQuotes(drjurnal("subdivisi")) & "', '" & FixQuotes(drjurnal("proyek")) & "', 1, 0, 'O', '" & FixDouble(drutama("cbjumlahbayar")) & "', " & drutama("cbstatusbayar") & ", " & drutama("cbstatus") & ", 1, NOW(), " & drutama("cbjmlrevisi") & ", " & drutama("cbcetakanke") & ", " & drutama("cbinputuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("cbinputtgl"), formatTglWaktuDB)) & "', " & drutama("cbmodifikasiuser") & ", '" & FixQuotes(AsFormatTanggal(drutama("cbmodifikasitgl"), formatTglWaktuDB)) & "')")
