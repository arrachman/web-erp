            Dim dtUntukKredit As DataTable = AsDataTableAmbilDariDB("SELECT smodule, sgrup, skode, snilai FROM m0_setting WHERE (smodule = 0 AND sgrup = 'accounting' AND skode = 'MataUangFungsional') OR (smodule = 0 AND sgrup = 'accounting' AND skode = 'Kurs') OR (smodule = 11 AND sgrup = 'akun' AND skode = 'PiutangSementara')")

            Dim rekHutangRekanan As String = ""
            If dtdetail.Rows.Count > 0 Then
                For Each drdetail As DataRow In dtdetail.Rows
