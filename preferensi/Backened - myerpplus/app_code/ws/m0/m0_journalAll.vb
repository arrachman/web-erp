        'AMBIL DATA ==========================================================
        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT rp.* FROM m5_rp rp WHERE (rp.rpstatus = 2 OR rp.rpstatus = 3 OR rp.rpstatus = 4 OR rp.rpstatus = 7) AND rp.rpid = '" & idtransaksi & "'")
        'DETAIL
        dtdetail = AsDataTableAmbilDariDB("SELECT rpd.* FROM m5_rp_pay rpd JOIN m5_rp rp ON rpd.idrp = rp.rpid WHERE (rp.rpstatus = 2 OR rp.rpstatus = 3 OR rp.rpstatus = 4 OR rp.rpstatus = 7) AND rp.rpid = '" & idtransaksi & "'")

        'JIKA TERDAPAT DATA MAKA BUAT JURNAL
        If dtutama.Rows.Count > 0 And dtdetail.Rows.Count > 0 Then
            'SET DATA UTAMA --------------------------------------
