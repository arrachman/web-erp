        dtutama = AsDataTableAmbilDariDB("SELECT pd.* FROM M6_pd pd WHERE (pd.pdstatus = 2 OR pd.pdstatus = 3 OR pd.pdstatus = 4 OR pd.pdstatus = 7) AND pd.pdid = '" & idtransaksi & "'")


        'SET DATA UTAMA ====================================================
        If dtutama.Rows.Count > 0 Then
