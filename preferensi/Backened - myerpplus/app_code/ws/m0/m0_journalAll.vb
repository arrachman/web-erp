#Region "M11_Pb"
    Public Function M11_Pb(ByVal idtransaksi As Integer) As String 'progress△errMessage△sqljurnal▲sqlupdateposting
        'GROUP 1 : =====================
        'PIUTANG SEMENTARA (D)
        '           HUTANG REKANAN   (K)

        'DISINI HANYA MEMBUAT GROUP 1, GROUP 2 DIPROSES PADA TOOLS HPP
        'GROUP 2 : =====================
        'HPP           (D)
