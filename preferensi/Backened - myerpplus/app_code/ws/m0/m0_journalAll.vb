        dtutama = AsDataTableAmbilDariDB("SELECT rgc.* FROM m2_rgc rgc WHERE (rgc.rgcstatus = 2 OR rgc.rgcstatus = 3 OR rgc.rgcstatus = 4 OR rgc.rgcstatus = 7) AND rgc.rgcid = '" & idtransaksi & "'")
