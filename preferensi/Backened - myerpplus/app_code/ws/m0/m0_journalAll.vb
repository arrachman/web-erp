        AsDataTableTambahField(dtjurnal, "kontak", AsEnumTypeData.AsInt64)

        'AMBIL DATA ==========================================================
        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT jm.* FROM m2_jm jm WHERE (jm.jmstatus = 2 OR jm.jmstatus = 3 OR jm.jmstatus = 4 OR jm.jmstatus = 7) AND jm.jmid = '" & idtransaksi & "'")
        'DETAIL
        dtdetail = AsDataTableAmbilDariDB("SELECT jmd.* FROM m2_jm_detail jmd JOIN m2_jm jm ON jmd.idjm = jm.jmid WHERE (jm.jmstatus = 2 OR jm.jmstatus = 3 OR jm.jmstatus = 4 OR jm.jmstatus = 7) AND jm.jmid = '" & idtransaksi & "'")

        'JIKA TERDAPAT DATA MAKA BUAT JURNAL
        If dtutama.Rows.Count > 0 And dtdetail.Rows.Count > 0 Then
