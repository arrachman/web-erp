                    rsErrMessage = "Failed insert datatable journal kredit " & sumber & " (" & noTransaksi & ") : " & urutan & "." : GoTo selesai
                End If
            Next
            'END OF AKUN DEBIT -----------------------------------

            'AKUN KREDIT -----------------------------------------
            'DATA DIAMBILKAN DARI TRANSAKSI UTAMA
            debitkredit = 1
            urutan = urutan + 1
