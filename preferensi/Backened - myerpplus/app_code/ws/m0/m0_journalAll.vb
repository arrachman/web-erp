        'UTAMA
        dtutama = AsDataTableAmbilDariDB("SELECT sg.* FROM m2_sg sg WHERE (sg.sgstatus = 2 OR sg.sgstatus = 3 OR sg.sgstatus = 4 OR sg.sgstatus = 7) AND sg.sgid = '" & idtransaksi & "'")
        'DETAIL
        dtdetail = AsDataTableAmbilDariDB("SELECT sgd.*, gl.glrekgiro FROM m2_sg_detail sgd JOIN m2_giro_list gl ON sgd.nogiro = gl.glnogiro JOIN m2_sg sg ON sgd.idsg = sg.sgid WHERE (sg.sgstatus = 2 OR sg.sgstatus = 3 OR sg.sgstatus = 4 OR sg.sgstatus = 7) AND sg.sgid = '" & idtransaksi & "'")

        'JIKA TERDAPAT DATA MAKA BUAT JURNAL
        If dtutama.Rows.Count > 0 And dtdetail.Rows.Count > 0 Then
            'SET DATA UTAMA --------------------------------------
            'SET DATA ROW
            drutama = dtutama.Rows(0)

            'SET SUMBER DAN NOTRANSAKSI
            sumber = drutama("sgsumber")
            noTransaksi = drutama("sgnotransaksi")
            'END OF SET DATA UTAMA -------------------------------

            'PROSES JURNAL ---------------------------------------
            For Each drdetail As DataRow In dtdetail.Rows
                'AKUN DEBIT ~~~~~~~~~~~~~~~~~~~~~~~~~
                'DATA DIAMBILKAN DARI TRANSAKSI DETAIL (glrekgiro)
                debitkredit = 0

