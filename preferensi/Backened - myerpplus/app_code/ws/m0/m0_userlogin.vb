        sql = "select `ul`.`ulid` AS `ulid`,`ul`.`uluser` AS `uluser`,`ul`.`ulcomputerip` AS `ulcomputerip`,`ul`.`ulaktif` AS `ulaktif`,`ul`.`ultgl` AS `ultgl`,`u`.`ukode` AS `ukode`,`u`.`unama` AS `unama` from (`m0_userlogin` `ul` join `m0_user` `u` on((`ul`.`uluser` = `u`.`userid`)))"

