    <WebMethod()>
    Public Function m3_rs_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = ""

        'Replace Filter & Sort
        If (strFilter.Length > 0) Then
            filter1 = strFilter
            filter2 = strFilter

        Else
            'Default filter
            filter1 = ""
            filter2 = ""
        End If

        If Len(filter1) > 0 Then filter1 = " WHERE " & filter1
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2

        sql = "  select `rs`.`rsid` AS `rsid`,`rs`.`rsnotransaksi` AS `rsnotransaksi`,`mr`.`mrsumber` AS `sumber`,`mr`.`mrid` AS `idterkait`,`mr`.`mrnotransaksi` AS `noterkait`,`mr`.`mrtgl` AS `tglterkait`,`mr`.`mrinputtgl` AS `inputtglterkait`,`mr`.`mrmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (((`m3_rs_detail` `rsd` join `m3_rs` `rs` on((`rsd`.`idrs` = `rs`.`rsid`))) join `m3_mr_detail` `mrd` on((`rsd`.`idmrdetail` = `mrd`.`idmrdetail`))) join `m3_mr` `mr` on((`mrd`.`idmr` = `mr`.`mrid`))) " & filter1 & " group by `mr`.`mrid`,`rs`.`rsid`"
        sql &= " union all "
        sql &= " select `rs`.`rsid` AS `rsid`,`rs`.`rsnotransaksi` AS `rsnotransaksi`,`ts`.`tssumber` AS `sumber`,`ts`.`tsid` AS `idterkait`,`ts`.`tsnotransaksi` AS `noterkait`,`ts`.`tstgl` AS `tglterkait`,`ts`.`tsinputtgl` AS `inputtglterkait`,`ts`.`tsmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (((`m3_rs_detail` `rsd` join `m3_rs` `rs` on((`rsd`.`idrs` = `rs`.`rsid`))) join `m3_ts_detail` `tsd` on((`rsd`.`idtsdetail` = `tsd`.`idtsdetail`))) join `m3_ts` `ts` on((`tsd`.`idts` = `ts`.`tsid`))) " & filter2 & " group by `ts`.`tsid`,`rs`.`rsid`"
        sql &= " union all "
        sql &= " select `rs`.`rsid` AS `rsid`, `rs`.`rsnotransaksi` AS `rsnotransaksi`, `mr`.`mrsumber` AS `sumber`, `mr`.`mrid` AS `idterkait`, `mr`.`mrnotransaksi` AS `noterkait`, `mr`.`mrtgl` AS `tglterkait`, `mr`.`mrinputtgl` AS `inputtglterkait`, `mr`.`mrmodifikasitgl` AS `modifikasitglterkait`, 0 AS `jenisterkait` from `m3_rs_detail` `rsd` join `m3_rs` `rs` on `rsd`.`idrs` = `rs`.`rsid` join `m3_ts_detail` `tsd` on `rsd`.`idtsdetail` = `tsd`.`idtsdetail` join `m3_mr_detail` `mrd` on `tsd`.`idmrdetail` = `mrd`.`idmrdetail` join `m3_mr` `mr` on `mrd`.`idmr` = `mr`.`mrid` " & filter1 & " group by `mr`.`mrid`, `rs`.`rsid`"

        'GRUPKAN BERDASARKAN ID DAN IDTERKAIT
        sql = " SELECT * FROM ( " & sql & " ) as terkait "
        sql &= " GROUP BY rsid, sumber, idterkait "
        sql &= " ORDER BY sumber = 'MR' desc, sumber = 'TS' desc, tglterkait "

        Return sql
    End Function

