    <WebMethod()>
    Public Function m5_as_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = "", filter3 As String = "", filter4 As String = ""
        Dim filter5 As String = "", filter6 As String = "", filter7 As String = ""

        'Replace Filter & Sort
        If (strFilter.Length > 0) Then
            filter1 = strFilter
            filter1 = filter1 & " AND ((`icd`.`sumber` = 'AS') and ((`ic`.`icstatus` = 2) or (`ic`.`icstatus` = 3) or (`ic`.`icstatus` = 4) or (`ic`.`icstatus` = 7)))"

            filter2 = strFilter
            filter2 = filter2 & " AND ((`pvd`.`sumber` = 'AS') and ((`pv`.`pvstatus` = 2) or (`pv`.`pvstatus` = 3) or (`pv`.`pvstatus` = 4) or (`pv`.`pvstatus` = 7)))"

            filter3 = strFilter
            filter4 = strFilter
            filter5 = strFilter
            filter6 = strFilter

            filter7 = strFilter
            filter7 = filter7 & " AND ((`si`.`sistatus` = 2) or (`si`.`sistatus` = 3) or (`si`.`sistatus` = 4) or (`si`.`sistatus` = 7))"
        Else
            'Default filter
            filter1 = "((`icd`.`sumber` = 'AS') and ((`ic`.`icstatus` = 2) or (`ic`.`icstatus` = 3) or (`ic`.`icstatus` = 4) or (`ic`.`icstatus` = 7)))"
            filter2 = "((`pvd`.`sumber` = 'AS') and ((`pv`.`pvstatus` = 2) or (`pv`.`pvstatus` = 3) or (`pv`.`pvstatus` = 4) or (`pv`.`pvstatus` = 7)))"
            filter7 = "((`si`.`sistatus` = 2) or (`si`.`sistatus` = 3) or (`si`.`sistatus` = 4) or (`si`.`sistatus` = 7))"
        End If

        If Len(filter1) > 0 Then filter1 = " WHERE " & filter1
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2
        If Len(filter3) > 0 Then filter3 = " AND " & filter3
        If Len(filter4) > 0 Then filter4 = " AND " & filter4
        If Len(filter5) > 0 Then filter5 = " WHERE " & filter5
        If Len(filter6) > 0 Then filter6 = " WHERE " & filter6
        If Len(filter7) > 0 Then filter7 = " WHERE " & filter7

        sql = " SELECT `as`.asid AS asid, `as`.asnotransaksi AS asnotransaksi, so.sosumber AS sumber, so.soid AS idterkait, so.sonotransaksi AS noterkait, so.sotgl AS tglterkait, so.soinputtgl AS inputtglterkait, so.somodifikasitgl AS modifikasitglterkait, 0 as jenisterkait FROM m5_as `as` JOIN m5_so so ON `as`.asidso = so.soid " & filter5 & " GROUP BY so.soid, `as`.asid"
        sql &= " UNION ALL "
        sql &= "SELECT `as`.asid AS asid, `as`.asnotransaksi AS asnotransaksi, ip.ipsumber AS sumber, ip.ipid AS idterkait, ip.ipnotransaksi AS noterkait, ip.iptgl AS tglterkait, ip.ipinputtgl AS inputtglterkait, ip.ipmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait FROM m5_as `as` JOIN m5_as_pay asp ON `as`.asid = asp.idas JOIN m5_ip ip ON asp.idip = ip.ipid " & filter6 & " GROUP BY ip.ipid, `as`.asid"
        sql &= " UNION ALL "
        sql &= "SELECT `as`.asid AS asid, `as`.asnotransaksi AS asnotransaksi, si.sisumber AS sumber, si.siid AS idterkait, si.sinotransaksi AS noterkait, si.sitgl AS tglterkait, si.siinputtgl AS inputtglterkait, si.simodifikasitgl AS modifikasitglterkait, 1 as jenisterkait FROM m5_as `as` JOIN m5_si si ON `as`.asid = si.siidas " & filter7 & " GROUP BY si.siid, `as`.asid"
        sql &= " UNION ALL "
        sql &= "select `as`.`asid` AS `asid`,`as`.`asnotransaksi` AS `asnotransaksi`,`ic`.`icsumber` AS `sumber`,`ic`.`icid` AS `idterkait`,`ic`.`icnotransaksi` AS `noterkait`,`ic`.`ictgl` AS `tglterkait`,`ic`.`icinputtgl` AS `inputtglterkait`,`ic`.`icmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from ((`m5_ic_detail` `icd` join `m5_ic` `ic` on((`icd`.`idic` = `ic`.`icid`))) join `m5_as` `as` on((`icd`.`idtransaksi` = `as`.`asid`))) " & filter1 & "  group by `ic`.`icid`, `as`.`asid` "
        sql &= " UNION ALL "
        sql &= "select `as`.`asid` AS `asid`,`as`.`asnotransaksi` AS `asnotransaksi`,`pv`.`pvsumber` AS `sumber`,`pv`.`pvid` AS `idterkait`,`pv`.`pvnotransaksi` AS `noterkait`,`pv`.`pvtgl` AS `tglterkait`,`pv`.`pvinputtgl` AS `inputtglterkait`,`pv`.`pvmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from ((`m5_pv_detail` `pvd` join `m5_pv` `pv` on((`pvd`.`idpv` = `pv`.`pvid`))) join `m5_as` `as` on((`pvd`.`idtransaksi` = `as`.`asid`))) " & filter2 & "  group by `pv`.`pvid`, `as`.`asid` "
        sql &= " UNION ALL "
        sql &= "select `as`.`asid` AS `asid`,`as`.`asnotransaksi` AS `asnotransaksi`,`rg`.`rgsumber` AS `sumber`,`rg`.`rgid` AS `idterkait`,`rg`.`rgnotransaksi` AS `noterkait`,`rg`.`rgtgl` AS `tglterkait`,`rg`.`rginputtgl` AS `inputtglterkait`,`rg`.`rgmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from (((`m5_as` `as` join `m2_giro_list` `gl` on((`as`.`asnotransaksi` = `gl`.`glnotransaksi`))) join `m2_rg_detail` `rgd` on((`gl`.`glnogiro` = `rgd`.`nogiro`))) join `m2_rg` `rg` on((`rgd`.`idrg` = `rg`.`rgid`))) where ((`rg`.`rgstatus` = 2) or (`rg`.`rgstatus` = 3) or (`rg`.`rgstatus` = 4) or (`rg`.`rgstatus` = 7))  " & filter3 & " group by `rg`.`rgid`,`as`.`asid` "
        sql &= " UNION ALL "
        sql &= "select `as`.`asid` AS `asid`,`as`.`asnotransaksi` AS `asnotransaksi`,`rgc`.`rgcsumber` AS `sumber`,`rgc`.`rgcid` AS `idterkait`,`rgc`.`rgcnotransaksi` AS `noterkait`,`rgc`.`rgctgl` AS `tglterkait`,`rgc`.`rgcinputtgl` AS `inputtglterkait`,`rgc`.`rgcmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from (((`m5_as` `as` join `m2_giro_list` `gl` on((`as`.`asnotransaksi` = `gl`.`glnotransaksi`))) join `m2_rgc_detail` `rgcd` on((`gl`.`glnogiro` = `rgcd`.`nogiro`))) join `m2_rgc` `rgc` on((`rgcd`.`idrgc` = `rgc`.`rgcid`))) where ((`rgc`.`rgcstatus` = 2) or (`rgc`.`rgcstatus` = 3) or (`rgc`.`rgcstatus` = 4) or (`rgc`.`rgcstatus` = 7))  " & filter4 & " group by `rgc`.`rgcid`,`as`.`asid` "

        Return sql
    End Function

