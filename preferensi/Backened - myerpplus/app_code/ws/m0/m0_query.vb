        fil4 = "((`lb`.`lbstatus` = 2) or (`lb`.`lbstatus` = 3) or (`lb`.`lbstatus` = 4) or (`lb`.`lbstatus` = 7))"
        fil5 = "((`kj`.`kjstatus` = 2) or (`kj`.`kjstatus` = 3) or (`kj`.`kjstatus` = 4) or (`kj`.`kjstatus` = 7))"

