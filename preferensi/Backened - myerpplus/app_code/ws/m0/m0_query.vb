        sql &= " UNION "
        sql &= "SELECT lb.lbid AS idtransaksi, lb.lbsumber AS sumber, lb.lbnotransaksi AS notransaksi, lb.lbtgl AS tgl, 'CASH' AS norm, 'CASH' AS nama, pc.pcnama AS kategoripasien, '' AS ditanggungoleh, kmr.rnama AS kamar, '' AS alamat, lb.lburaian AS uraian, lb.lbcustomer AS kontak, lb.lbcatatan AS catatan, IFNULL(SUM(lb.lbtotaltransaksi),0) AS totaltransaksi, s.snilai AS rekhutangpiutang, lb.lbinputtgl AS inputtgl FROM (((m_11_lb AS lb left join m0_setting s on(((s.smodule = 0) and (s.sgrup = 'akun') and (s.skode = 'PiutangUsaha')))) LEFT JOIN m1_patient_category AS pc ON ((lb.lbkategoripasien = pc.pckode))) LEFT JOIN m1_room AS kmr ON ((lb.lbkamar = kmr.rkode)))" & filter4 & " group by lb.lbid"

        Return sql
