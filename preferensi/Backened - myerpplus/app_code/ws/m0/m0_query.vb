tsd.idgrndetail))) join m4_grn grn on((grn.grnid = grnd.idgrn))) where (((ts.tsstatus = 2) or (ts.tsstatus = 3) or (ts.tsstatus = 4) or (ts.tsstatus = 7)) and (grn.grnid = 'validtransaksi')) group by ts.tsid, grn.grnid "
