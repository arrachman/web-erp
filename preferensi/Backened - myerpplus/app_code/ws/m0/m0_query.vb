        sql &= " UNION ALL "
        sql &= "SELECT kw.kwid AS kwid, kw.kwnotransaksi AS kwnotransaksi, 'LB' AS sumber, lb.lbid AS idterkait, lb.lbnotransaksi AS noterkait, lb.lbtgl AS tglterkait, lb.lbinputtgl AS inputtglterkait, lb.lbmodifikasitgl AS modifikasitglterkait, 0 AS jenisterkait FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_lb lb ON (kwd.idtransaksi = lb.lbid AND sumber = 'LB') " & fil4 & " GROUP BY kw.kwid, lb.lbid"

