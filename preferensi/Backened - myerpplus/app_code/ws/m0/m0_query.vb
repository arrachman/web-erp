        'AK
        sql &= " SELECT kj.kjid AS idtransaksi, kj.kjsumber AS sumber, kj.kjnotransaksi AS notransaksi, kj.kjtgl AS tgl, kj.kjnopasien AS norm, kj.kjnama AS nama, pc.pcnama AS kategoripasien, i.inama AS ditanggungoleh, kmr.rnama AS kamar, kj.kjalamat AS alamat, '' AS uraian, p.pid AS kontak, kj.kjcatatan AS catatan, IFNULL(SUM(ak.aktotaltransaksi), 0)  AS totaltransaksi, s.snilai AS rekhutangpiutang, kj.kjinputtgl AS inputtgl FROM m_11_kj AS kj JOIN m_11_ak AS ak ON kj.kjid = ak.akidkj LEFT JOIN m1_patient AS p ON kj.kjnopasien = p.pkode left join m0_setting s on s.smodule = 0 and s.sgrup = 'akun' and s.skode = 'PiutangUsaha' LEFT JOIN m1_patient_category AS pc ON kj.kjkategoripasien = pc.pckode LEFT JOIN m1_insurer AS i ON kj.kjditanggungoleh = i.iid LEFT JOIN m1_room AS kmr ON kj.kjkamar = kmr.rkode " & filter1 & " group by kj.kjid "
