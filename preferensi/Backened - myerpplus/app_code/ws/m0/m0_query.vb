#Region "m0_report"
    Private Function m0_report_new() As String
        Dim sql As String
        'query
        'sql = "(select `m`.`mid` AS `mid`,`mn`.`mnid` AS `mnid`,`mn`.`mnname` AS `rreportname`,`mnl`.`mnltranslate` AS `translaterreportname`,`mn`.`mnlevel` AS `mnlevel`,`mn`.`mnurutan` AS `mnurutan`,0 AS `rid`,0 AS `ritem` from ((`m0_module` `m` join `m0_menu` `mn` on((`m`.`mid` = `mn`.`mnmoduleid`))) left join `m0_menu_lang` `mnl` on(((`mn`.`mnmoduleid` = `mnl`.`mnlmoduleid`) and (`mn`.`mnid` = `mnl`.`mnlmnid`) and (`mnl`.`mnllanguage` = 'valbahasa')))) where (((`mn`.`mnlevel` = 0) or (`mn`.`mnlevel` = 2)) and (`mn`.`mntype` <> 3) and (`mn`.`mntype` <> 4) and m.mactive = 1 and mn.mnactive = 1 )) union all (select `m`.`mid` AS `mid`,`mn`.`mnid` AS `mnid`,`r`.`rreportname` AS `rreportname`,`rl`.`rltranslaterreportname` AS `translaterreportname`,3 AS `mnlevel`,`mn`.`mnurutan` AS `mnurutan`,`r`.`rid` AS `rid`,`r`.`ritem` AS `ritem` from (((`m0_module` `m` join `m0_menu` `mn` on((`m`.`mid` = `mn`.`mnmoduleid`))) join `m0_report` `r` on(((`r`.`rmoduleid` = `mn`.`mnmoduleid`) and (`r`.`rmenuid` = `mn`.`mnid`) and `mn`.`mntype`))) left join `m0_report_lang` `rl` on(((`r`.`rid` = `rl`.`rlrid`) and (`rl`.`rllanguage` = 'valbahasa')))) where m.mactive = 1 and mn.mnactive = 1 ) order by `mid`, /*`mnid`,*/ `mnurutan`,`ritem`"
        sql = "(select `m`.`mid` AS `mid`,`mn`.`mnid` AS `mnid`,`mn`.`mnname` AS `rreportname`,`mnl`.`mnltranslate` AS `translaterreportname`,`mn`.`mnlevel` AS `mnlevel`,`mn`.`mnurutan` AS `mnurutan`,0 AS `rid`,0 AS `ritem`,0 AS `rurutan` from ((`m0_module` `m` join `m0_menu` `mn` on((`m`.`mid` = `mn`.`mnmoduleid`))) left join `m0_menu_lang` `mnl` on(((`mn`.`mnmoduleid` = `mnl`.`mnlmoduleid`) and (`mn`.`mnid` = `mnl`.`mnlmnid`) and (`mnl`.`mnllanguage` = 'valbahasa')))) where (((`mn`.`mnlevel` = 0) or (`mn`.`mnlevel` = 2)) and (`mn`.`mntype` <> 3) and (`mn`.`mntype` <> 4) and (`m`.`mactive` = 1) and (`mn`.`mnactive` = 1))) union all (select `m`.`mid` AS `mid`,`mn`.`mnid` AS `mnid`,`r`.`rreportname` AS `rreportname`,`rl`.`rltranslaterreportname` AS `translaterreportname`,3 AS `mnlevel`,`mn`.`mnurutan` AS `mnurutan`,`r`.`rid` AS `rid`,`r`.`ritem` AS `ritem`,`r`.`rurutan` AS `rurutan` from (((`m0_module` `m` join `m0_menu` `mn` on((`m`.`mid` = `mn`.`mnmoduleid`))) join `m0_report` `r` on(((`r`.`rmoduleid` = `mn`.`mnmoduleid`) and (`r`.`rmenuid` = `mn`.`mnid`) and `mn`.`mntype`))) left join `m0_report_lang` `rl` on(((`r`.`rid` = `rl`.`rlrid`) and (`rl`.`rllanguage` = 'valbahasa')))) where ((`m`.`mactive` = 1) and (`mn`.`mnactive` = 1) and (`r`.`raktif` = 1))) order by `mid`,`mnurutan`,`rurutan`"
        Return sql
    End Function

