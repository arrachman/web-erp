#Region "m0_user"
    Private Function m0_user_v() As String
        Dim sql As String
        'query
        sql = "select `u`.`userid` AS `userid`,`u`.`ukode` AS `ukode`,`u`.`unama` AS `unama`,`u`.`upassword` AS `upassword`,`u`.`ukontak` AS `ukontak`,ifnull(`c`.`kkode`,'') AS `ukontakkode`,ifnull(`c`.`knama`,'') AS `ukontaknama`,`u`.`ucabang` AS `ucabang`,ifnull(`b`.`bnama`,'') AS `ucabangnama`,`u`.`ulokasi` AS `ulokasi`,ifnull(`l`.`lnama`,'') AS `ulokasinama`,`u`.`ugudang` AS `ugudang`,ifnull(`w`.`wnama`,'') AS `ugudangnama`,`u`.`ukota` AS `ukota`,`u`.`ugambar` AS `ugambar`,`u`.`uaktif` AS `uaktif`,`u`.`utglexpired` AS `utglexpired`,`u`.`ulevel` AS `ulevel`,`u`.`ugrup` AS `ugrup`,ifnull(`ug`.`ugnama`,'') AS `ugrupnama`,`u`.`ubahasa` AS `ubahasa`,`u`.`udefaultview` AS `udefaultview`,`lg`.`lnama` AS `ubahasanama`,`ct`.`cnama` AS `ukotanama`,`ca`.`kanama` AS `kontakperson`,`ca`.`kaalamat` AS `kontakpersonalamat` from ((((((((`m0_user` `u` left join `m1_contact` `c` on((`u`.`ukontak` = `c`.`kid`))) left join `m1_branch` `b` on((`u`.`ucabang` = `b`.`bkode`))) left join `m1_location` `l` on((`u`.`ulokasi` = `l`.`lkode`))) left join `m1_warehouse` `w` on((`u`.`ugudang` = `w`.`wkode`))) left join `m0_usergrup` `ug` on((`u`.`ugrup` = `ug`.`ugkode`))) left join `m0_language` `lg` on((`u`.`ubahasa` = `lg`.`lkode`))) left join `m1_city` `ct` on((`u`.`ukota` = `ct`.`ckode`))) left join `m1_contact_attention` `ca` on(((`c`.`kid` = `ca`.`kaidkontak`) and (`ca`.`kadefault` = 1))))"
        Return sql
    End Function

    Private Function m0_user_getdata() As String
        Dim sql As String
        'query
        sql = "select `u`.`userid` AS `userid`,`u`.`ukode` AS `ukode`,`u`.`unama` AS `unama`,`u`.`upassword` AS `upassword`,`u`.`ukontak` AS `ukontak`,`u`.`ucabang` AS `ucabang`,`u`.`ulokasi` AS `ulokasi`,`u`.`ugudang` AS `ugudang`,`u`.`ukota` AS `ukota`,`u`.`ugambar` AS `ugambar`,`u`.`uaktif` AS `uaktif`,`u`.`utglexpired` AS `utglexpired`,`u`.`ulevel` AS `ulevel`,`u`.`ugrup` AS `ugrup`,`u`.`ubahasa` AS `ubahasa`,`u`.`udefaultview` AS `udefaultview`,`c`.`kkode` AS `ukontakkode`,`c`.`knama` AS `ukontaknama`,`br`.`bnama` AS `ucabangnama`,`lc`.`lnama` AS `ulokasinama`,`wh`.`wnama` AS `ugudangnama`,`l`.`lnama` AS `ubahasanama`,`ur`.`userid` AS `uruserid`,`ur`.`role` AS `role`,`r`.`rnama` AS `rolenama` from (((((((`m0_user` `u` left join `m0_user_role` `ur` on((`u`.`userid` = `ur`.`userid`))) left join `m1_contact` `c` on((`u`.`ukontak` = `c`.`kid`))) left join `m1_branch` `br` on((`u`.`ucabang` = `br`.`bkode`))) left join `m1_location` `lc` on((`u`.`ulokasi` = `lc`.`lkode`))) left join `m1_warehouse` `wh` on((`u`.`ugudang` = `wh`.`wkode`))) left join `m0_language` `l` on((`u`.`ubahasa` = `l`.`lkode`))) left join `m0_role` `r` on((`ur`.`role` = `r`.`rkode`)))"
        Return sql
    End Function
#End Region

#Region "m0_usermodule"
    Private Function m0_usermodule_v() As String
        Dim sql As String
        'query
        sql = "select distinct `m0_usermenu`.`ummoduleid` AS `ummoduleid`,`m0_usermenu`.`umuserid` AS `umuserid`,`m0_module`.`mid` AS `mid`,`m0_module`.`mname` AS `mname`,`m0_module`.`mversion` AS `mversion`,`m0_module`.`mcompany` AS `mcompany`,`m0_module`.`mauthor` AS `mauthor`,`m0_module`.`mdescription` AS `mdescription`,`m0_module`.`mactive` AS `mactive`,`m0_module`.`murutan` AS `murutan` from (`m0_usermenu` join `m0_module` on((`m0_usermenu`.`ummoduleid` = `m0_module`.`mid`)))"
        Return sql
    End Function

    Private Function m0_usermodule_new() As String
        Dim sql As String
        'query
        sql = "select distinct `m`.`mid` AS `mid`,`u`.`userid` AS `userid`,`m`.`mname` AS `mname`,`m`.`mversion` AS `mversion`,`m`.`mcompany` AS `mcompany`,`m`.`mauthor` AS `mauthor`,`m`.`mdescription` AS `mdescription`,`m`.`mactive` AS `mactive`,`m`.`murutan` AS `murutan` from (((`m0_user` `u` join `m0_user_role` `ur` on((`u`.`userid` = `ur`.`userid`))) join `m0_role_menu` `rm` on((`ur`.`role` = `rm`.`rmrole`))) join `m0_module` `m` on((`rm`.`rmmoduleid` = `m`.`mid`)))"
        Return sql
    End Function
#End Region

#Region "m0_usermenu"
    Private Function m0_usermenu_v() As String
