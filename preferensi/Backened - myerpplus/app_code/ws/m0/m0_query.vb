    <WebMethod()>
    Public Function m6_mrs_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = "", filter3 As String = "", filter4 As String = ""
        Dim filter5 As String = "", filter6 As String = "", filter7 As String = "", filter8 As String = ""

        'Replace Filter
        If (strFilter.Length > 0) Then
            'BOM OUT
            filter2 = strFilter

            'PDR OUT
            filter4 = strFilter

            'WO OUT
            filter5 = strFilter

            'MRN OUT
            filter6 = strFilter
            filter6 = filter6 & " AND (mrn.mrnstatus IN(2,3,4,7)) "

            'PD OUT
            filter8 = strFilter
            filter8 = filter8 & " AND (pd.pdstatus IN(2,3,4,7)) "

        Else
            'MRN OUT
            filter6 = " (mrn.mrnstatus IN(2,3,4,7)) "

            'PD OUT
            filter8 = " (pd.pdstatus IN(2,3,4,7)) "

        End If

        'BOM OUT
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2
        'PDR OUT
        If Len(filter4) > 0 Then filter4 = " WHERE " & filter4
        'WO OUT
        If Len(filter5) > 0 Then filter5 = " WHERE " & filter5
        'MRN OUT
        If Len(filter6) > 0 Then filter6 = " WHERE " & filter6
        'PD OUT
        If Len(filter8) > 0 Then filter8 = " WHERE " & filter8


        'BOM OUT
        sql = " select mrs.mrsid AS mrsid, mrs.mrsnotransaksi AS mrsnotransaksi, bom.bomsumber AS sumber, bom.bomid AS idterkait, bom.bomnotransaksi AS noterkait, bom.bomtgl AS tglterkait, bom.bominputtgl AS inputtglterkait, bom.bommodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_bom_out bomo join m6_bom bom on bomo.idbom = bom.bomid join m6_mrs_out mrso on bomo.idbomout = mrso.idbomout join m6_mrs mrs ON mrso.idmrs = mrs.mrsid " & filter2 & " group by bom.bomid, mrs.mrsid "
        'PDR OUT
        sql &= " UNION ALL "
