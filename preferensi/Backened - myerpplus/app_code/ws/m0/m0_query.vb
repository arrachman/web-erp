    <WebMethod()>
    Public Function m11_lu_terkait() As String
        Dim sql As String
        'sql = "select `lu`.`luid` AS `luid`,`lu`.`lunotransaksi` AS `lunotransaksi`,`kj`.`kjsumber` AS `sumber`,`kj`.`kjid` AS `idterkait`,`kj`.`kjnotransaksi` AS `noterkait`,`kj`.`kjtgl` AS `tglterkait`,`kj`.`kjinputtgl` AS `inputtglterkait`,`kj`.`kjmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (`m_11_kj` `kj`join `m_11_lu` `lu` on((`lu`.`luidkj` = `kj`.`kjid`))) where (`lu`.`luid` = 'validtransaksi') group by `kj`.`kjid`,`lu`.`luid`"
        sql = "select `lu`.`luid` AS `luid`,`lu`.`lunotransaksi` AS `lunotransaksi`,`kj`.`kjsumber` AS `sumber`,`kj`.`kjid` AS `idterkait`,`kj`.`kjnotransaksi` AS `noterkait`,`kj`.`kjtgl` AS `tglterkait`,`kj`.`kjinputtgl` AS `inputtglterkait`,`kj`.`kjmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (`m_11_kj` `kj`join `m_11_lu` `lu` on((`lu`.`luidkj` = `kj`.`kjid`))) where (`lu`.`luid` = 'validtransaksi') AND ((`kj`.`kjstatus` = 2) or (`kj`.`kjstatus` = 3) or (`kj`.`kjstatus` = 4) or (`kj`.`kjstatus` = 7)) group by `kj`.`kjid`,`lu`.`luid`"
        sql &= " UNION ALL "
        sql &= "select `lu`.`luid` AS `luid`,`lu`.`lunotransaksi` AS `lunotransaksi`,'KW' AS `sumber`,`kw`.`kwid` AS `idterkait`,`kw`.`kwnotransaksi` AS `noterkait`,`kw`.`kwtgl` AS `tglterkait`,`kw`.`kwinputtgl` AS `inputtglterkait`,`kw`.`kwmodifikasitgl` AS `modifikasitglterkait`,1 AS `jenisterkait` FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_lu lu ON (kwd.idtransaksi = 'validtransaksi' AND sumber = 'LU') where (`lu`.`luid` = 'validtransaksi') AND ((`kw`.`kwstatus` = 2) or (`kw`.`kwstatus` = 3) or (`kw`.`kwstatus` = 4) or (`kw`.`kwstatus` = 7)) group by `kw`.`kwid`,`lu`.`luid`"
        sql &= " UNION ALL "
        sql &= "select lu.luid AS luid,lu.lunotransaksi AS lunotransaksi,kw.kwsumber AS sumber,kw.kwid AS idterkait,kw.kwnotransaksi AS noterkait,kw.kwtgl AS tglterkait,kw.kwinputtgl AS inputtglterkait,kw.kwmodifikasitgl AS modifikasitglterkait,1 AS jenisterkait FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_kj kj on (kwd.idtransaksi = kj.kjid) JOIN m_11_lu lu ON (lu.luidkj = kj.kjid) where (lu.luid = 'validtransaksi') AND ((kw.kwstatus = 2) or (kw.kwstatus = 3) or (kw.kwstatus = 4) or (kw.kwstatus = 7)) group by kw.kwid,lu.luid"
        Return sql
    End Function

