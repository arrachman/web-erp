    Public Function m11_lb_terkait() As String
        Dim sql As String
        ' = "select `lb`.`lbid` AS `lbid`,`lb`.`lbnotransaksi` AS `lbnotransaksi`,`kj`.`kjsumber` AS `sumber`,`kj`.`kjid` AS `idterkait`,`kj`.`kjnotransaksi` AS `noterkait`,`kj`.`kjtgl` AS `tglterkait`,`kj`.`kjinputtgl` AS `inputtglterkait`,`kj`.`kjmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (`m_11_kj` `kj`join `m_11_lb` `lb` on((`lb`.`lbidkj` = `kj`.`kjid`))) where (`lb`.`lbid` = 'validtransaksi') group by `kj`.`kjid`,`lb`.`lbid`"
        sql = "select `lb`.`lbid` AS `lbid`,`lb`.`lbnotransaksi` AS `lbnotransaksi`,`kj`.`kjsumber` AS `sumber`,`kj`.`kjid` AS `idterkait`,`kj`.`kjnotransaksi` AS `noterkait`,`kj`.`kjtgl` AS `tglterkait`,`kj`.`kjinputtgl` AS `inputtglterkait`,`kj`.`kjmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (`m_11_kj` `kj`join `m_11_lb` `lb` on((`lb`.`lbidkj` = `kj`.`kjid`))) where (`lb`.`lbid` = 'validtransaksi') AND ((`kj`.`kjstatus` = 2) or (`kj`.`kjstatus` = 3) or (`kj`.`kjstatus` = 4) or (`kj`.`kjstatus` = 7)) group by `kj`.`kjid`,`lb`.`lbid`"
        sql &= " UNION ALL "
        sql &= "select `lb`.`lbid` AS `lbid`,`lb`.`lbnotransaksi` AS `lbnotransaksi`,'KW' AS `sumber`,`kw`.`kwid` AS `idterkait`,`kw`.`kwnotransaksi` AS `noterkait`,`kw`.`kwtgl` AS `tglterkait`,`kw`.`kwinputtgl` AS `inputtglterkait`,`kw`.`kwmodifikasitgl` AS `modifikasitglterkait`,1 AS `jenisterkait` FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_lb lb ON (kwd.idtransaksi = 'validtransaksi' AND sumber = 'LB') where (`lb`.`lbid` = 'validtransaksi') AND ((`kw`.`kwstatus` = 2) or (`kw`.`kwstatus` = 3) or (`kw`.`kwstatus` = 4) or (`kw`.`kwstatus` = 7)) group by `kw`.`kwid`,`lb`.`lbid`"
        sql &= " UNION ALL "
        sql &= "select lb.lbid AS lbid,lb.lbnotransaksi AS lbnotransaksi,kw.kwsumber AS sumber,kw.kwid AS idterkait,kw.kwnotransaksi AS noterkait,kw.kwtgl AS tglterkait,kw.kwinputtgl AS inputtglterkait,kw.kwmodifikasitgl AS modifikasitglterkait,1 AS jenisterkait FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_kj kj on (kwd.idtransaksi = kj.kjid) JOIN m_11_lb lb ON (lb.lbidkj = kj.kjid) where (lb.lbid = 'validtransaksi') AND ((kw.kwstatus = 2) or (kw.kwstatus = 3) or (kw.kwstatus = 4) or (kw.kwstatus = 7)) group by kw.kwid,lb.lbid"
