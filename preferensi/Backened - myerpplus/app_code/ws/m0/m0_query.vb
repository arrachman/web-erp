        'sql = "select `r`.`rid` AS `rid`,`r`.`rmoduleid` AS `rmoduleid`,`r`.`rmenuid` AS `rmenuid`,`r`.`ritem` AS `ritem`,`r`.`rtitle` AS `rtitle`,`rl`.`rltranslatertitle` AS `rltranslatertitle`,`r`.`rreportname` AS `rreportname`,`rl`.`rltranslaterreportname` AS `rltranslaterreportname`,`r`.`rfilename` AS `rfilename`,`r`.`rdefault` AS `rdefault`,`r`.`rdata` AS `rdata`,`r`.`rcetak` AS `rcetak`,`r`.`rsql` AS `rsql`,`r`.`rfrom` AS `rfrom`,`r`.`rfilter` AS `rfilter`,`r`.`rorderby` AS `rorderby`,`r`.`rgroupby` AS `rgroupby`,`r`.`rquery` AS `rquery`,`r`.`rpembuat` AS `rpembuat`,`r`.`rselesai` AS `rselesai`,`r`.`rparam1` AS `rparam1`,`r`.`rparam2` AS `rparam2`,`r`.`rparam3` AS `rparam3`,`r`.`rparam4` AS `rparam4`,`r`.`rparam5` AS `rparam5`,`r`.`rinputtgl` AS `rinputtgl`,`r`.`rmodiftgl` AS `rmodiftgl` from (`m0_report` `r` left join `m0_report_lang` `rl` on(((`r`.`rid` = `rl`.`rlrid`) and (`rl`.`rllanguage` = 'valbahasa'))))"
        sql = "select `r`.`rid` AS `rid`,`r`.`rmoduleid` AS `rmoduleid`,`r`.`rmenuid` AS `rmenuid`,`r`.`ritem` AS `ritem`,`r`.`rtitle` AS `rtitle`,`rl`.`rltranslatertitle` AS `rltranslatertitle`,`r`.`rreportname` AS `rreportname`,`rl`.`rltranslaterreportname` AS `rltranslaterreportname`,`r`.`rfilename` AS `rfilename`,`r`.`rdefault` AS `rdefault`,`r`.`rdata` AS `rdata`,`r`.`rcetak` AS `rcetak`,`r`.`rsql` AS `rsql`,`r`.`rfrom` AS `rfrom`,`r`.`rfilter` AS `rfilter`,`r`.`rorderby` AS `rorderby`,`r`.`rgroupby` AS `rgroupby`,`r`.`rquery` AS `rquery`,`r`.`rpembuat` AS `rpembuat`,`r`.`rselesai` AS `rselesai`,`r`.`rparam1` AS `rparam1`,`r`.`rparam2` AS `rparam2`,`r`.`rparam3` AS `rparam3`,`r`.`rparam4` AS `rparam4`,`r`.`rparam5` AS `rparam5`,`r`.`rinputtgl` AS `rinputtgl`,`r`.`rmodiftgl` AS `rmodiftgl`,`r`.`raktif` AS `raktif`,`r`.`rurutan` AS `rurutan`, mnname from (((`m0_report` `r` join `m0_module` `m` on((`r`.`rmoduleid` = `m`.`mid`))) join `m0_menu` `mn` on(((`r`.`rmoduleid` = `mn`.`mnmoduleid`) and (`r`.`rmenuid` = `mn`.`mnid`)))) left join `m0_report_lang` `rl` on(((`r`.`rid` = `rl`.`rlrid`) and (`rl`.`rllanguage` = 'valbahasa'))))"
