        sql = "SELECT kj.kjid AS kjid, kj.kjnotransaksi AS kjnotransaksi, lu.lusumber AS sumber, lu.luid AS idterkait, lu.lunotransaksi AS noterkait, lu.lutgl AS tglterkait, lu.luinputtgl AS inputtglterkait,  lu.lumodifikasitgl AS modifikasitglterkait,  1 as jenisterkait FROM m_11_lu_detail lud JOIN m_11_lu lu ON lud.idlu = luid JOIN m_11_kj kj ON lu.luidkj = 'validtransaksi' " & filter1 & " GROUP BY lu.luid"
