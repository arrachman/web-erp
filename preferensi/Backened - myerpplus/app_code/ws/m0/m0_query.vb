        If Len(fil4) > 0 Then fil4 = " WHERE kw.kwid = 'validtransaksi' AND " & fil4
        If Len(fil5) > 0 Then fil5 = " WHERE kw.kwid = 'validtransaksi' AND " & fil5

        ' = "select `ic`.`kwid` AS `kwid`, `ic`.`kwnotransaksi` AS `kwnotransaksi`, `pv`.`pvsumber` AS `sumber`, `pv`.`pvid` AS `idterkait`, `pv`.`pvnotransaksi` AS `noterkait`, `pv`.`pvtgl` AS `tglterkait`, `pv`.`pvinputtgl` AS `inputtglterkait`, `pv`.`pvmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from `m_11_pb_detail` `pvd` join `m_11_pb` `pv` on `pvd`.`idpv` = `pv`.`pvid` join `m_11_kw` `ic` on pvd.idtransaksi = `ic`.`kwid` " & filter9 & " group by `pv`.`pvid`, `ic`.`kwid`"
        sql = "select `ic`.`kwid` AS `kwid`, `ic`.`kwnotransaksi` AS `kwnotransaksi`, `pv`.`pvsumber` AS `sumber`, `pv`.`pvid` AS `idterkait`, `pv`.`pvnotransaksi` AS `noterkait`, `pv`.`pvtgl` AS `tglterkait`, `pv`.`pvinputtgl` AS `inputtglterkait`, `pv`.`pvmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from `m_11_pb_detail` `pvd` join `m_11_pb` `pv` on `pvd`.`idpv` = `pv`.`pvid` join `m_11_kw` `ic` on (pvd.idtransaksi = `ic`.`kwid` AND pvd.sumber = 'KW') " & fil2 & " group by `ic`.`kwid`"
        sql &= " UNION ALL "
        sql &= "SELECT kw.kwid AS kwid, kw.kwnotransaksi AS kwnotransaksi, 'KJ' AS sumber, kj.kjid AS idterkait, kj.kjnotransaksi AS noterkait, kj.kjtgl AS tglterkait, kj.kjinputtgl AS inputtglterkait, kj.kjmodifikasitgl AS modifikasitglterkait, 0 AS jenisterkait FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_kj kj ON (kwd.idtransaksi = kj.kjid AND sumber = 'KJ') " & fil5 & " GROUP BY kw.kwid"
        sql &= " UNION ALL "
        sql &= "SELECT kw.kwid AS kwid, kw.kwnotransaksi AS kwnotransaksi, 'LU' AS sumber, lu.luid AS idterkait, lu.lunotransaksi AS noterkait, lu.lutgl AS tglterkait, lu.luinputtgl AS inputtglterkait, lu.lumodifikasitgl AS modifikasitglterkait, 0 AS jenisterkait FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_lu lu ON (kwd.idtransaksi = lu.luid AND sumber = 'LU') " & fil1 & " GROUP BY kw.kwid, lu.luid"
        sql &= " UNION ALL "
