    <WebMethod()>
    Private Function m2s_giro() As String
        Dim sql As String
        'query
        sql = "select `gl`.`glnogiro` AS `glnogiro`,`gl`.`glnotransaksi` AS `glnotransaksi`,`gl`.`glkontak` AS `glkontak`,`gl`.`gljenis` AS `gljenis`,`gl`.`glbank` AS `glbank`,`gl`.`glnoacbank` AS `glnoacbank`,`gl`.`glmatauang` AS `glmatauang`,`gl`.`glkurs` AS `glkurs`,sum(`gl`.`gljumlah`) AS `gljumlah`,sum(`gl`.`gljumlahvalas`) AS `gljumlahvalas`,`gl`.`gltgljthtempo` AS `gltgljthtempo`,`gl`.`glstatus` AS `glstatus`,`c`.`kkode` AS `glkontakkode`,`c`.`knama` AS `glkontaknama`,`b`.`bnama` AS `glbanknama`,(to_days(now()) - to_days(`gl`.`gltgljthtempo`)) AS `glumur`,(case when ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) < 0) then 0 when (((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 0) and ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) <= 30)) then 1 when (((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 31) and ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) <= 60)) then 2 when (((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 61) and ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) <= 90)) then 3 when ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 91) then 4 end) AS `glumurklasifikasi`,(case when ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) < 0) then 'Belum JT' when (((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 0) and ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) <= 30)) then '0 s.d 30 Hari' when (((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 31) and ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) <= 60)) then '31 s.d 60 Hari' when (((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 61) and ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) <= 90)) then '61 s.d 90 Hari' when ((to_days(now()) - to_days(`gl`.`gltgljthtempo`)) >= 91) then '> 90 Hari' end) AS `glumurklasifikasinama` from ((`m2_giro_list` `gl` left join `m1_contact` `c` on((`gl`.`glkontak` = `c`.`kid`))) left join `m1_bank` `b` on((`gl`.`glbank` = `b`.`bkode`)))"
        Return sql
    End Function

    <WebMethod()>
    Private Function m2s_hutang() As String
        Dim sql As String
        'query
        sql = "SELECT t.tkontak, c.kkode as tkontakkode, c.knama as tkontaknama, s2.snilai as tmatauang, IFNULL(SUM(t.tkredit), 0) - IFNULL(SUM(t.tdebit), 0) as tsaldo, t.tnorek as tnorek FROM m2_transaction_journal t JOIN m1_contact c ON t.tkontak = c.kid JOIN m0_setting s ON s.smodule = 0 AND s.sgrup = 'akun' AND s.skode = 'HutangUsaha' AND t.tnorek = s.snilai JOIN m0_setting s2 ON s2.smodule = 0 AND s2.sgrup = 'accounting' AND s2.skode = 'MataUangFungsional'"
        Return sql
    End Function

