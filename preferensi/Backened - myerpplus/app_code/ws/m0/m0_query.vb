        sql &= " UNION ALL "
        sql &= "SELECT `kj`.`kjid` AS `kjid`, `kj`.`kjnotransaksi` AS `kjnotransaksi`, 'RM' AS `sumber`, `rm`.`rmid` AS `idterkait`, `rm`.`rmnotransaksi` AS `noterkait`, `rm`.`rmtgl` AS `tglterkait`, `rm`.`rminputtgl` AS `inputtglterkait`, `rm`.`rmmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait FROM `m_11_rm` `rm` JOIN `m_11_kj` `kj` ON (`rm`.`rmidkj` = 'validtransaksi') " & filter8 & " GROUP BY `rm`.`rmid`"

