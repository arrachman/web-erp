    Private Function m13_bl_v() As String
        Dim sql As String
        sql = "SELECT a.*, u.unama AS blinputusernama, u2.unama AS blmodifikasiusernama, b.scnama AS blkategorisiswanama FROM m13_bl a LEFT JOIN m0_user u ON (a.blinputuser = u.userid) LEFT JOIN m0_user u2 ON (a.blmodifikasiuser = u2.userid) LEFT JOIN m13_student_category b ON (a.blkategorisiswa = b.scid)"
        Return sql
    End Function

    Private Function m13_bl_getdata() As String
        Dim sql As String
        sql = "SELECT a.*, sc.sckode AS blkategorisiswakode, sc.scnama AS blkategorisiswanama, b.*, u.unama AS blinputusernama, u2.unama AS blmodifikasiusernama, s.nama AS blstatusnama, s2.nama AS blstatussebelumnyanama FROM m13_bl a JOIN m13_bl_detail b ON (a.blid = b.idbl) LEFT JOIN m0_user u ON (a.blinputuser = u.userid) LEFT JOIN m0_user u2 ON (a.blmodifikasiuser = u2.userid) LEFT JOIN m0_status s ON (a.blstatus = s.kode) LEFT JOIN m0_status s2 ON (a.blstatussebelumnya = s2.kode) LEFT JOIN m13_student_category sc ON (a.blkategorisiswa = sc.scid)"
        Return sql
    End Function

