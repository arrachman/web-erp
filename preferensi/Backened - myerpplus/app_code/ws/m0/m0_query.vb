    <WebMethod()>
    Public Function m6_bom_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = "", filter3 As String = "", filter4 As String = ""
        Dim filter5 As String = "", filter6 As String = "", filter7 As String = "", filter8 As String = ""

        'Replace Filter
        If (strFilter.Length > 0) Then
            'PDR IN
            filter1 = strFilter
            filter1 = filter1 & " AND (pdr.pdrstatus IN(2,3,4,7)) "

            'PDR OUT
            filter2 = strFilter
            filter2 = filter2 & " AND (pdr.pdrstatus IN(2,3,4,7)) "

            'WO IN
            filter3 = strFilter
            filter3 = filter3 & " AND (wo.wostatus IN(2,3,4,7)) "

            'WO OUT
            filter4 = strFilter
            filter4 = filter4 & " AND (wo.wostatus IN(2,3,4,7)) "

            'MRS OUT
            filter5 = strFilter
            filter5 = filter5 & " AND (mrs.mrsstatus IN(2,3,4,7)) "

            'MRN OUT
            filter6 = strFilter
            filter6 = filter6 & " AND (mrn.mrnstatus IN(2,3,4,7)) "

            'PD IN
            filter7 = strFilter
            filter7 = filter7 & " AND (pd.pdstatus IN(2,3,4,7)) "

            'PD OUT
            filter8 = strFilter
            filter8 = filter8 & " AND (pd.pdstatus IN(2,3,4,7)) "

        Else
            'PDR IN
            filter1 = " (pdr.pdrstatus IN(2,3,4,7)) "

            'PDR OUT
            filter2 = " (pdr.pdrstatus IN(2,3,4,7)) "

            'WO IN
            filter3 = " (wo.wostatus IN(2,3,4,7)) "

            'WO OUT
            filter4 = " (wo.wostatus IN(2,3,4,7)) "

            'MRS OUT
            filter5 = " (mrs.mrsstatus IN(2,3,4,7)) "

            'MRN OUT
            filter6 = " (mrn.mrnstatus IN(2,3,4,7)) "

            'PD IN
            filter7 = " (pd.pdstatus IN(2,3,4,7)) "

            'PD OUT
            filter8 = " (pd.pdstatus IN(2,3,4,7)) "

        End If

        'PDR IN
        If Len(filter1) > 0 Then filter1 = " WHERE " & filter1
        'PDR OUT
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2
        'WO IN
        If Len(filter3) > 0 Then filter3 = " WHERE " & filter3
        'WO OUT
        If Len(filter4) > 0 Then filter4 = " WHERE " & filter4
        'MRS OUT
        If Len(filter5) > 0 Then filter5 = " WHERE " & filter5
        'MRN OUT
        If Len(filter6) > 0 Then filter6 = " WHERE " & filter6
        'PD IN
        If Len(filter7) > 0 Then filter7 = " WHERE " & filter7
        'PD OUT
        If Len(filter8) > 0 Then filter8 = " WHERE " & filter8


        'PDR IN
        sql = "  select bom.bomid AS bomid, bom.bomnotransaksi AS bomnotransaksi, pdr.pdrsumber AS sumber, pdr.pdrid AS idterkait, pdr.pdrnotransaksi AS noterkait, pdr.pdrtgl AS tglterkait, pdr.pdrinputtgl AS inputtglterkait, pdr.pdrmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_pdr_in pdri join m6_pdr pdr on pdri.idpdr = pdr.pdrid join m6_bom_in bomi on pdri.idbomin = bomi.idbomin join m6_bom bom ON bomi.idbom = bom.bomid " & filter1 & " group by pdr.pdrid, bom.bomid "
        'PDR OUT
        sql &= " UNION ALL "
        sql &= " select bom.bomid AS bomid, bom.bomnotransaksi AS bomnotransaksi, pdr.pdrsumber AS sumber, pdr.pdrid AS idterkait, pdr.pdrnotransaksi AS noterkait, pdr.pdrtgl AS tglterkait, pdr.pdrinputtgl AS inputtglterkait, pdr.pdrmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_pdr_out pdro join m6_pdr pdr on pdro.idpdr = pdr.pdrid join m6_bom_out bomo on pdro.idbomout = bomo.idbomout join m6_bom bom ON bomo.idbom = bom.bomid " & filter2 & " group by pdr.pdrid, bom.bomid "
        'WO IN
        sql &= " UNION ALL "
        sql &= " select bom.bomid AS bomid, bom.bomnotransaksi AS bomnotransaksi, wo.wosumber AS sumber, wo.woid AS idterkait, wo.wonotransaksi AS noterkait, wo.wotgl AS tglterkait, wo.woinputtgl AS inputtglterkait, wo.womodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_wo_in woi join m6_wo wo on woi.idwo = wo.woid join m6_bom_in bomi on woi.idbomin = bomi.idbomin join m6_bom bom ON bomi.idbom = bom.bomid " & filter3 & " group by wo.woid, bom.bomid "
        'WO OUT
        sql &= " UNION ALL "
        sql &= " select bom.bomid AS bomid, bom.bomnotransaksi AS bomnotransaksi, wo.wosumber AS sumber, wo.woid AS idterkait, wo.wonotransaksi AS noterkait, wo.wotgl AS tglterkait, wo.woinputtgl AS inputtglterkait, wo.womodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_wo_out woo join m6_wo wo on woo.idwo = wo.woid join m6_bom_out bomo on woo.idbomout = bomo.idbomout join m6_bom bom ON bomo.idbom = bom.bomid " & filter4 & " group by wo.woid, bom.bomid "
        'MRS OUT
        sql &= " UNION ALL "
        sql &= " select bom.bomid AS bomid, bom.bomnotransaksi AS bomnotransaksi, mrs.mrssumber AS sumber, mrs.mrsid AS idterkait, mrs.mrsnotransaksi AS noterkait, mrs.mrstgl AS tglterkait, mrs.mrsinputtgl AS inputtglterkait, mrs.mrsmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_mrs_out mrso join m6_mrs mrs on mrso.idmrs = mrs.mrsid join m6_bom_out bomo on mrso.idbomout = bomo.idbomout join m6_bom bom ON bomo.idbom = bom.bomid " & filter5 & " group by mrs.mrsid, bom.bomid"
