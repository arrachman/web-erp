    <WebMethod()>
    Private Function m1_patient_terkait() As String
        Dim sql As String
        'query
        sql = "SELECT p.pkode, p.pnama, 'KJ' sumber, kj.kjid idterkait FROM m_11_kj kj JOIN m1_patient p ON kj.kjnopasien = p.pkode WHERE p.pkode = 'valkode' UNION ALL SELECT p.pkode, p.pnama, 'RM' sumber, rm.rmid idterkait FROM m_11_rm rm JOIN m1_patient p ON rm.rmnorm = p.pkode WHERE p.pkode = 'valkode'"
        Return sql
    End Function

