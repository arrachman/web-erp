    <WebMethod()>
    Public Function m11_ak_terkait() As String
        Dim sql As String
        'sql = "select `ak`.`akid` AS `akid`,`ak`.`aknotransaksi` AS `aknotransaksi`,`kj`.`kjsumber` AS `sumber`,`kj`.`kjid` AS `idterkait`,`kj`.`kjnotransaksi` AS `noterkait`,`kj`.`kjtgl` AS `tglterkait`,`kj`.`kjinputtgl` AS `inputtglterkait`,`kj`.`kjmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (`m_11_kj` `kj`join `m_11_ak` `ak` on((`ak`.`akidkj` = `kj`.`kjid`))) where (`ak`.`akid` = 'validtransaksi') group by `kj`.`kjid`,`ak`.`akid`"
        sql = "select `ak`.`akid` AS `akid`,`ak`.`aknotransaksi` AS `aknotransaksi`,`kj`.`kjsumber` AS `sumber`,`kj`.`kjid` AS `idterkait`,`kj`.`kjnotransaksi` AS `noterkait`,`kj`.`kjtgl` AS `tglterkait`,`kj`.`kjinputtgl` AS `inputtglterkait`,`kj`.`kjmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (`m_11_kj` `kj`join `m_11_ak` `ak` on((`ak`.`akidkj` = `kj`.`kjid`))) where (`ak`.`akid` = 'validtransaksi') AND ((`kj`.`kjstatus` = 2) or (`kj`.`kjstatus` = 3) or (`kj`.`kjstatus` = 4) or (`kj`.`kjstatus` = 7)) group by `kj`.`kjid`,`ak`.`akid`"
        sql &= " UNION ALL "
        sql &= "select `ak`.`akid` AS `akid`,`ak`.`aknotransaksi` AS `aknotransaksi`,'KW' AS `sumber`,`kw`.`kwid` AS `idterkait`,`kw`.`kwnotransaksi` AS `noterkait`,`kw`.`kwtgl` AS `tglterkait`,`kw`.`kwinputtgl` AS `inputtglterkait`,`kw`.`kwmodifikasitgl` AS `modifikasitglterkait`,1 AS `jenisterkait` FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_ak ak ON (kwd.idtransaksi = 'validtransaksi' AND sumber = 'AK') where (`ak`.`akid` = 'validtransaksi') AND ((`kw`.`kwstatus` = 2) or (`kw`.`kwstatus` = 3) or (`kw`.`kwstatus` = 4) or (`kw`.`kwstatus` = 7)) group by `kw`.`kwid`,`ak`.`akid`"
        sql &= " UNION ALL "
        sql &= "select ak.akid AS akid,ak.aknotransaksi AS aknotransaksi,kw.kwsumber AS sumber,kw.kwid AS idterkait,kw.kwnotransaksi AS noterkait,kw.kwtgl AS tglterkait,kw.kwinputtgl AS inputtglterkait,kw.kwmodifikasitgl AS modifikasitglterkait,1 AS jenisterkait FROM m_11_kw_detail kwd JOIN m_11_kw kw ON (kwd.idkw = kw.kwid) JOIN m_11_kj kj on (kwd.idtransaksi = kj.kjid) JOIN m_11_ak ak ON (ak.akidkj = kj.kjid) where (ak.akid = 'validtransaksi') AND ((kw.kwstatus = 2) or (kw.kwstatus = 3) or (kw.kwstatus = 4) or (kw.kwstatus = 7)) group by kw.kwid,ak.akid"
        Return sql
    End Function

