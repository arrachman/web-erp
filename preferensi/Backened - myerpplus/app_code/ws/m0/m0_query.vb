 join `m3_sa` `sa` on((`sad`.`idsa` = `sa`.`said`))) join `m1_item_transaction` `it` on(((`cso`.`sumber` = `it`.`sumber`) and (`cso`.`idbarang` = `it`.`idbarang`) and (`cso`.`idtransaksi` = `it`.`iddetail`)))) where (`sa`.`said` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`sa`.`said`"
        sql = "select `sa`.`said` AS `said`,`sa`.`sanotransaksi` AS `sanotransaksi`,`sp`.`spsumber` AS `sumber`,`sp`.`spid` AS `idterkait`,`sp`.`spnotransaksi` AS `noterkait`,`sp`.`sptgl` AS `tglterkait`,`sp`.`spinputtgl` AS `inputtglterkait`,`sp`.`spmodifikasitgl` AS `modifikasitglterkait`,0 AS `jenisterkait` from (((`m3_sa_detail` `sad` join `m3_sa` `sa` on((`sad`.`idsa` = `sa`.`said`))) join `m3_sp_detail` `spd` on((`sad`.`idspdetail` = `spd`.`idspdetail`))) join `m3_sp` `sp` on((`spd`.`idsp` = `sp`.`spid`))) where (`sa`.`said` = 'validtransaksi') group by `sp`.`spid`,`sa`.`said` union select `sa`.`said` AS `said`,`sa`.`sanotransaksi` AS `sanotransaksi`,`cfo`.`cfosumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait`,1 AS `jenisterkait` from ((((`m1_cogs_fifo_in` `cfi` join `m1_cogs_fifo_out` `cfo` on((`cfi`.`cfiid` = `cfo`.`cfoidcfi`))) join `m3_sa_detail` `sad` on(((`cfi`.`cfisumber` = 'sa') and (`cfi`.`cfiidbarang` = `sad`.`idbarang`) and (`cfi`.`cfiidtransaksi` = `sad`.`idsadetail`)))) join `m3_sa` `sa` on((`sad`.`idsa` = `sa`.`said`))) join `m1_item_transaction` `it` on(((`cfo`.`cfosumber` = `it`.`sumber`) and (`cfo`.`cfoidbarang` = `it`.`idbarang`) and (`cfo`.`cfoidtransaksi` = `it`.`iddetail`)))) where (`sa`.`said` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`sa`.`said` union select `sa`.`said` AS `said`,`sa`.`sanotransaksi` AS `sanotransaksi`,`cso`.`sumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait`,1 AS `jenisterkait` from ((((`m1_cogs_special_in` `csi` join `m1_cogs_special_out` `cso` on((`csi`.`idhppikm` = `cso`.`idhppikm`))) join `m3_sa_detail` `sad` on(((`csi`.`sumber` = 'SA') and (`csi`.`idbarang` = `sad`.`idbarang`) and (`csi`.`idtransaksi` = `sad`.`idsadetail`)))) join `m3_sa` `sa` on((`sad`.`idsa` = `sa`.`said`))) join `m1_item_transaction` `it` on(((`cso`.`sumber` = `it`.`sumber`) and (`cso`.`idbarang` = `it`.`idbarang`) and (`cso`.`idtransaksi` = `it`.`iddetail`)))) where (`sa`.`said` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`sa`.`said` union SELECT sa.said as said, sa.sanotransaksi as sanotransaksi, da.dasumber as sumber, da.daid as idterkait, da.danotransaksi as noterkait, da.datgl as tglterkait, da.dainputtgl as inputtglterkait, da.damodifikasitgl as modifikasitglterkait, 1 as jenisterkait FROM m7_asset_transaction atr JOIN m3_sa sa ON atr.atsumber = sa.sasumber AND atr.atidutama = sa.said AND atr.atjenismutasi = 1 AND sa.said = 'validtransaksi' JOIN m7_asset a ON atr.atkode = a.akode JOIN m7_da_detail dad ON a.aid = dad.idaset JOIN m7_da da ON dad.idda = da.daid AND da.dastatus IN(2,3,4,7) GROUP BY da.daid, sa.said union SELECT atr.atidutama AS said, atr.atnotransaksi AS sanotransaksi, atr2.atsumber AS sumber, atr2.atidutama AS idterkait, atr2.atnotransaksi AS noterkait, atr2.attgl AS tglterkait, CONCAT(atr2.attgl,'00:00:00') AS inputtglterkait, CONCAT(atr2.attgl,'00:00:00') AS modifikasitglterkait, 1 AS jenisterkait FROM m7_asset_transaction atr JOIN m7_asset_transaction atr2 ON atr.atkode = atr2.atkode AND atr2.atstatus IN(2,3,4,7) AND atr.atsumber = 'SA' AND atr.atjenismutasi = 1 AND atr.atidutama = 'validtransaksi' AND NOT (atr.atsumber = atr2.atsumber AND atr.atidutama = atr2.atidutama) GROUP BY atr2.atsumber, atr2.atidutama"
