#Region "m0_userreport"
    Private Function m0_userreport_v() As String
        Dim sql As String
        'query
        sql = "(select valuser AS `lvl`,`r`.`rmoduleid` AS `moduleid`,`r`.`rmenuid` AS `menuid`,`mo`.`mname` AS `menu`,0 AS `ritem`,valuser AS `userid`,(select `u`.`unama` from `m0_user` `u` where (`u`.`userid` = valuser)) AS `username`,0 AS `akses` from ((`m0_report` `r` join `m0_module` `mo` on((`mo`.`mid` = `r`.`rmoduleid`))) join `m0_menu` `m` on(((`m`.`mnid` = `r`.`rmenuid`) and (`m`.`mnmoduleid` = `r`.`rmoduleid`)))) group by `r`.`rmoduleid`) union all (select 2 AS `lvl`,`r`.`rmoduleid` AS `moduleid`,`r`.`rmenuid` AS `menuid`,concat('----',`m`.`mnname`) AS `menu`,0 AS `ritem`,valuser AS `userid`,(select `u`.`unama` from `m0_user` `u` where (`u`.`userid` = valuser)) AS `username`,0 AS `akses` from ((`m0_report` `r` join `m0_module` `mo` on((`mo`.`mid` = `r`.`rmoduleid`))) join `m0_menu` `m` on(((`m`.`mnid` = `r`.`rmenuid`) and (`m`.`mnmoduleid` = `r`.`rmoduleid`)))) group by `r`.`rmoduleid`,`r`.`rmenuid`) union all (select 3 AS `lvl`,`r`.`rmoduleid` AS `moduleid`,`r`.`rmenuid` AS `menuid`,concat('--------',`r`.`rreportname`) AS `menu`,`r`.`ritem` AS `ritem`,valuser AS `userid`,(select `u`.`unama` from `m0_user` `u` where (`u`.`userid` = valuser)) AS `username`,ifnull((select `ur`.`urakses` from `m0_userreport` `ur` where ((`ur`.`urmoduleid` = `r`.`rmoduleid`) and (`ur`.`urmenuid` = `r`.`rmenuid`) and (`ur`.`uritem` = `r`.`ritem`) and (`ur`.`uruserid` = valuser))),0) AS `akses` from ((`m0_report` `r` join `m0_module` `mo` on((`mo`.`mid` = `r`.`rmoduleid`))) join `m0_menu` `m` on(((`m`.`mnid` = `r`.`rmenuid`) and (`m`.`mnmoduleid` = `r`.`rmoduleid`)))))"
        Return sql
    End Function

