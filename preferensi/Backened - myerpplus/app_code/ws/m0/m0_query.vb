        sql = "select ak.akid AS akid, ak.akcabang AS akcabang, ak.aklokasi AS aklokasi, ak.akgudang AS akgudang, ak.aksumber AS aksumber, ak.akautonotransaksi AS akautonotransaksi, ak.aknotransaksi AS aknotransaksi, ak.aktgl AS aktgl, ak.akkodepa AS akkodepa, ak.akcustomer AS akcustomer, ak.akcustomerkontak AS akcustomerkontak, ak.akuraian AS akuraian, ak.akcatatan AS akcatatan, ak.aknoref AS aknoref, ak.aktglnoref AS aktglnoref, ak.aktotaltransaksi AS aktotaltransaksi, ak.akidkj AS akidkj, ak.akstatusrealisasi AS akstatusrealisasi, ak.akstatus AS akstatus, ak.akstatussebelumnya AS akstatussebelumnya, ak.akjmlrevisi AS akjmlrevisi, ak.akcetakanke AS akcetakanke, ak.akinputuser AS akinputuser, ak.akinputtgl AS akinputtgl, ak.akmodifikasiuser AS akmodifikasiuser, ak.akmodifikasitgl AS akmodifikasitgl, ak.akisclose AS akisclose, br.bnama AS akcabangnama, lc.lnama AS aklokasinama, wh.wnama AS akgudangnama, (CASE ak.akpenjualanlangsung WHEN 1 THEN c1.kkode ELSE p1.pkode END) AS akcustomerkode, (CASE ak.akpenjualanlangsung WHEN 1 THEN c1.knama ELSE p1.pnama END) AS akcustomernama, kj.kjnotransaksi AS aknotransaksikj, st1.nama AS akstatusnama, st2.nama AS akstatussebelumnyanama, u1.unama AS akinputusernama, u2.unama AS akmodifikasiusernama, IF(YEAR(ak.aktglbayar) > 2000,ak.aktglbayar,'') AS aktglbayar from m_11_ak ak  left join m1_branch br on br.bkode = ak.akcabang left join m1_location lc on lc.lkode = ak.aklokasi left join m1_warehouse wh on wh.wkode = ak.akgudang left join m1_contact c1 on c1.kid = ak.akcustomer left join m1_patient p1 on ak.akcustomer = p1.pid left join m_11_kj kj on ak.akidkj = kj.kjid left join m0_status st1 on st1.kode = ak.akstatus left join m0_status st2 on st2.kode = ak.akstatussebelumnya left join m0_user u1 on u1.userid = ak.akinputuser left join m0_user u2 on u2.userid = ak.akmodifikasiuser"
