    <WebMethod()>
    Public Function m6_wo_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = "", filter3 As String = "", filter4 As String = ""
        Dim filter5 As String = "", filter6 As String = "", filter7 As String = "", filter8 As String = ""

        'Replace Filter
        If (strFilter.Length > 0) Then
            'BOM IN
            filter1 = strFilter

            'BOM OUT
            filter2 = strFilter

            'PDR IN
            filter3 = strFilter

            'PDR OUT
            filter4 = strFilter

            'MRS OUT
            filter5 = strFilter
            filter5 = filter5 & " AND (mrs.mrsstatus IN(2,3,4,7)) "

            'MRN OUT
            filter6 = strFilter
            filter6 = filter6 & " AND (mrn.mrnstatus IN(2,3,4,7)) "

            'PD IN
            filter7 = strFilter
            filter7 = filter7 & " AND (pd.pdstatus IN(2,3,4,7)) "

            'PD OUT
            filter8 = strFilter
            filter8 = filter8 & " AND (pd.pdstatus IN(2,3,4,7)) "

        Else
            'MRS OUT
            filter5 = " (mrs.mrsstatus IN(2,3,4,7)) "

            'MRN OUT
            filter6 = " (mrn.mrnstatus IN(2,3,4,7)) "

            'PD IN
            filter7 = " (pd.pdstatus IN(2,3,4,7)) "

            'PD OUT
            filter8 = " (pd.pdstatus IN(2,3,4,7)) "

        End If

        'BOM IN
        If Len(filter1) > 0 Then filter1 = " WHERE " & filter1
        'BOM OUT
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2
        'WO IN
        If Len(filter3) > 0 Then filter3 = " WHERE " & filter3
        'WO OUT
        If Len(filter4) > 0 Then filter4 = " WHERE " & filter4
        'MRS OUT
        If Len(filter5) > 0 Then filter5 = " WHERE " & filter5
        'MRN OUT
        If Len(filter6) > 0 Then filter6 = " WHERE " & filter6
        'PD IN
        If Len(filter7) > 0 Then filter7 = " WHERE " & filter7
        'PD OUT
        If Len(filter8) > 0 Then filter8 = " WHERE " & filter8


        'BOM IN
        sql = "  select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, bom.bomsumber AS sumber, bom.bomid AS idterkait, bom.bomnotransaksi AS noterkait, bom.bomtgl AS tglterkait, bom.bominputtgl AS inputtglterkait, bom.bommodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_bom_in bomi join m6_bom bom on bomi.idbom = bom.bomid join m6_wo_in woi on bomi.idbomin = woi.idbomin join m6_wo wo ON woi.idwo = wo.woid " & filter1 & " group by bom.bomid, wo.woid "
        'BOM OUT
        sql &= " UNION ALL "
        sql &= " select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, bom.bomsumber AS sumber, bom.bomid AS idterkait, bom.bomnotransaksi AS noterkait, bom.bomtgl AS tglterkait, bom.bominputtgl AS inputtglterkait, bom.bommodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_bom_out bomo join m6_bom bom on bomo.idbom = bom.bomid join m6_wo_out woo on bomo.idbomout = woo.idbomout join m6_wo wo ON woo.idwo = wo.woid " & filter2 & " group by bom.bomid, wo.woid "
        'PDR IN
        sql &= " UNION ALL "
        sql &= " select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, pdr.pdrsumber AS sumber, pdr.pdrid AS idterkait, pdr.pdrnotransaksi AS noterkait, pdr.pdrtgl AS tglterkait, pdr.pdrinputtgl AS inputtglterkait, pdr.pdrmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_pdr_in pdri join m6_pdr pdr on pdri.idpdr = pdr.pdrid join m6_wo_in woi on pdri.idpdrin = woi.idpdrin join m6_wo wo ON woi.idwo = wo.woid " & filter3 & " group by pdr.pdrid, wo.woid "
        'PDR OUT
        sql &= " UNION ALL "
        sql &= " select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, pdr.pdrsumber AS sumber, pdr.pdrid AS idterkait, pdr.pdrnotransaksi AS noterkait, pdr.pdrtgl AS tglterkait, pdr.pdrinputtgl AS inputtglterkait, pdr.pdrmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_pdr_out pdro join m6_pdr pdr on pdro.idpdr = pdr.pdrid join m6_wo_out woo on pdro.idpdrout = woo.idpdrout join m6_wo wo ON woo.idwo = wo.woid " & filter4 & " group by pdr.pdrid, wo.woid "
        'MRS OUT
        sql &= " UNION ALL "
        sql &= " select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, mrs.mrssumber AS sumber, mrs.mrsid AS idterkait, mrs.mrsnotransaksi AS noterkait, mrs.mrstgl AS tglterkait, mrs.mrsinputtgl AS inputtglterkait, mrs.mrsmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_mrs_out mrso join m6_mrs mrs on mrso.idmrs = mrs.mrsid join m6_wo_out woo on mrso.idwoout = woo.idwoout join m6_wo wo ON woo.idwo = wo.woid " & filter5 & " group by mrs.mrsid, wo.woid"
        'MRN OUT
        sql &= " UNION ALL "
        sql &= " select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, mrn.mrnsumber AS sumber, mrn.mrnid AS idterkait, mrn.mrnnotransaksi AS noterkait, mrn.mrntgl AS tglterkait, mrn.mrninputtgl AS inputtglterkait, mrn.mrnmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_mrn_out mrno join m6_mrn mrn on mrno.idmrn = mrn.mrnid join m6_wo_out woo on mrno.idwoout = woo.idwoout join m6_wo wo ON woo.idwo = wo.woid " & filter6 & " group by mrn.mrnid, wo.woid"
        'PD IN
        sql &= " UNION ALL "
        sql &= " select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, pd.pdsumber AS sumber, pd.pdid AS idterkait, pd.pdnotransaksi AS noterkait, pd.pdtgl AS tglterkait, pd.pdinputtgl AS inputtglterkait, pd.pdmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_pd_in pdi join m6_pd pd on pdi.idpd = pd.pdid join m6_wo_in woi on pdi.idwoin = woi.idwoin join m6_wo wo ON woi.idwo = wo.woid " & filter7 & " group by pd.pdid, wo.woid"
        'PD OUT
        sql &= " UNION ALL "
        sql &= " select wo.woid AS woid, wo.wonotransaksi AS wonotransaksi, pd.pdsumber AS sumber, pd.pdid AS idterkait, pd.pdnotransaksi AS noterkait, pd.pdtgl AS tglterkait, pd.pdinputtgl AS inputtglterkait, pd.pdmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_pd_out pdo join m6_pd pd on pdo.idpd = pd.pdid join m6_wo_out woo on pdo.idwoout = woo.idwoout join m6_wo wo ON woo.idwo = wo.woid " & filter8 & " group by pd.pdid, wo.woid"

        'GRUPKAN BERDASARKAN ID DAN IDTERKAIT
        sql = " SELECT * FROM ( " & sql & " ) as terkait GROUP BY woid, sumber, idterkait "

        Return sql
    End Function

