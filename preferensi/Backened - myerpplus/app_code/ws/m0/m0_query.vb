    <WebMethod()>
    Private Function m2_statistik_kasbank_v() As String
        Dim sql As String
        'query
        sql = "SELECT co.cid cid, co.cnomor cnomor, co.cnama cnama, co.cmatauang cmatauang, (CASE co.cdc WHEN 'D' THEN SUM(tj.tdebit) - SUM(tj.tkredit) ELSE SUM(tj.tkredit) - SUM(tj.tdebit) END) as csaldo, (CASE co.cmatauang WHEN s.snilai THEN 0 ELSE (CASE co.cdc WHEN 'D' THEN SUM(tj.tdebitvalas) - SUM(tj.tkreditvalas) ELSE SUM(tj.tkreditvalas) - SUM(tj.tdebitvalas) END) END)  as csaldovalas FROM m1_coa co JOIN m2_transaction_journal tj ON co.cnomor = tj.tnorek JOIN m0_setting s ON s.smodule = 0 AND s.sgrup = 'accounting' AND skode = 'MataUangFungsional'"
        Return sql
    End Function

