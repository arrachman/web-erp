        sql &= " UNION ALL "
        sql &= "SELECT `kj`.`kjid` AS `kjid`, `kj`.`kjnotransaksi` AS `kjnotransaksi`, `ak`.`aksumber` AS `sumber`, `ak`.`akid` AS `idterkait`, `ak`.`aknotransaksi` AS `noterkait`, `ak`.`aktgl` AS `tglterkait`, `ak`.`akinputtgl` AS `inputtglterkait`, `ak`.`akmodifikasitgl` AS `modifikasitglterkait`,  1 as jenisterkait FROM ((`m_11_ak_detail` `akd` JOIN `m_11_ak` `ak` ON ((`akd`.`idak` = `akid`))) JOIN `m_11_kj` `kj` ON ((`ak`.`akidkj` = 'validtransaksi'))) " & filter3 & " GROUP BY `ak`.`akid`"
