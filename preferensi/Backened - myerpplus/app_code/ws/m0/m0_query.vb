        'LB
        sql &= " UNION ALL "
        sql &= " SELECT kj.kjid AS idtransaksi, kj.kjsumber AS sumber, kj.kjnotransaksi AS notransaksi, kj.kjtgl AS tgl, kj.kjnopasien AS norm, kj.kjnama AS nama, pc.pcnama AS kategoripasien, i.inama AS ditanggungoleh, kmr.rnama AS kamar, kj.kjalamat AS alamat, '' AS uraian, p.pid AS kontak, kj.kjcatatan AS catatan, IFNULL(SUM(lb.lbtotaltransaksi), 0)  AS totaltransaksi, s.snilai AS rekhutangpiutang, kj.kjinputtgl AS inputtgl FROM m_11_kj AS kj JOIN m_11_lb AS lb ON kj.kjid = lb.lbidkj LEFT JOIN m1_patient AS p ON kj.kjnopasien = p.pkode left join m0_setting s on s.smodule = 0 and s.sgrup = 'akun' and s.skode = 'PiutangUsaha' LEFT JOIN m1_patient_category AS pc ON kj.kjkategoripasien = pc.pckode LEFT JOIN m1_insurer AS i ON kj.kjditanggungoleh = i.iid LEFT JOIN m1_room AS kmr ON kj.kjkamar = kmr.rkode " & filter1 & " group by kj.kjid "
        'LU
        sql &= " UNION ALL "
        sql &= " SELECT kj.kjid AS idtransaksi, kj.kjsumber AS sumber, kj.kjnotransaksi AS notransaksi, kj.kjtgl AS tgl, kj.kjnopasien AS norm, kj.kjnama AS nama, pc.pcnama AS kategoripasien, i.inama AS ditanggungoleh, kmr.rnama AS kamar, kj.kjalamat AS alamat, '' AS uraian, p.pid AS kontak, kj.kjcatatan AS catatan, IFNULL(SUM(lu.lutotaltransaksi), 0)  AS totaltransaksi, s.snilai AS rekhutangpiutang, kj.kjinputtgl AS inputtgl FROM m_11_kj AS kj JOIN m_11_lu AS lu ON kj.kjid = lu.luidkj LEFT JOIN m1_patient AS p ON kj.kjnopasien = p.pkode left join m0_setting s on s.smodule = 0 and s.sgrup = 'akun' and s.skode = 'PiutangUsaha' LEFT JOIN m1_patient_category AS pc ON kj.kjkategoripasien = pc.pckode LEFT JOIN m1_insurer AS i ON kj.kjditanggungoleh = i.iid LEFT JOIN m1_room AS kmr ON kj.kjkamar = kmr.rkode " & filter1 & " group by kj.kjid "
        'RK
        sql &= " UNION ALL "
        sql &= " SELECT kj.kjid AS idtransaksi, kj.kjsumber AS sumber, kj.kjnotransaksi AS notransaksi, kj.kjtgl AS tgl, kj.kjnopasien AS norm, kj.kjnama AS nama, pc.pcnama AS kategoripasien, i.inama AS ditanggungoleh, kmr.rnama AS kamar, kj.kjalamat AS alamat, '' AS uraian, p.pid AS kontak, kj.kjcatatan AS catatan, IFNULL(SUM(rk.rkjumlah), 0)  AS totaltransaksi, s.snilai AS rekhutangpiutang, kj.kjinputtgl AS inputtgl FROM m_11_kj AS kj JOIN m_11_rk AS rk ON kj.kjid = rk.rkidkj LEFT JOIN m1_patient AS p ON kj.kjnopasien = p.pkode left join m0_setting s on s.smodule = 0 and s.sgrup = 'akun' and s.skode = 'PiutangUsaha' LEFT JOIN m1_patient_category AS pc ON kj.kjkategoripasien = pc.pckode LEFT JOIN m1_insurer AS i ON kj.kjditanggungoleh = i.iid LEFT JOIN m1_room AS kmr ON kj.kjkamar = kmr.rkode " & filter1 & " group by kj.kjid "
        'RO
        sql &= " UNION ALL "
        sql &= " SELECT kj.kjid AS idtransaksi, kj.kjsumber AS sumber, kj.kjnotransaksi AS notransaksi, kj.kjtgl AS tgl, kj.kjnopasien AS norm, kj.kjnama AS nama, pc.pcnama AS kategoripasien, i.inama AS ditanggungoleh, kmr.rnama AS kamar, kj.kjalamat AS alamat, '' AS uraian, p.pid AS kontak, kj.kjcatatan AS catatan, IFNULL(SUM(ro.rototaltransaksi), 0) * (-1)  AS totaltransaksi, s.snilai AS rekhutangpiutang, kj.kjinputtgl AS inputtgl FROM m_11_kj AS kj JOIN m_11_ro AS ro ON kj.kjid = ro.roidkj LEFT JOIN m1_patient AS p ON kj.kjnopasien = p.pkode left join m0_setting s on s.smodule = 0 and s.sgrup = 'akun' and s.skode = 'PiutangUsaha' LEFT JOIN m1_patient_category AS pc ON kj.kjkategoripasien = pc.pckode LEFT JOIN m1_insurer AS i ON kj.kjditanggungoleh = i.iid LEFT JOIN m1_room AS kmr ON kj.kjkamar = kmr.rkode " & filter1 & " group by kj.kjid "

        sql &= " ) AS kw "
        sql &= " GROUP BY kw.idtransaksi, kw.sumber "

        Return sql
    End Function

    <WebMethod()>
    Public Function m11_kw_takedata1(ByVal strFilter As String) As String
