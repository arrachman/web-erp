    <WebMethod()>
    Private Function m3_ib_terkait() As String
        Dim sql As String
        'query
        'sql = "select `ib`.`ibid` AS `ibid`,`ib`.`ibnotransaksi` AS `ibnotransaksi`,`cfo`.`cfosumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait` from ((((`m1_cogs_fifo_in` `cfi` join `m1_cogs_fifo_out` `cfo` on((`cfi`.`cfiid` = `cfo`.`cfoidcfi`))) join `m3_ib_detail` `ibd` on(((`cfi`.`cfisumber` = 'IB') and (`cfi`.`cfiidbarang` = `ibd`.`idbarang`) and (`cfi`.`cfiidtransaksi` = `ibd`.`idibdetail`)))) join `m3_ib` `ib` on((`ibd`.`idib` = `ib`.`ibid`))) join `m1_item_transaction` `it` on(((`cfo`.`cfosumber` = `it`.`sumber`) and (`cfo`.`cfoidbarang` = `it`.`idbarang`) and (`cfo`.`cfoidtransaksi` = `it`.`iddetail`)))) where (`ib`.`ibid` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`ib`.`ibid` union select `ib`.`ibid` AS `ibid`,`ib`.`ibnotransaksi` AS `ibnotransaksi`,`cso`.`sumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait` from ((((`m1_cogs_special_in` `csi` join `m1_cogs_special_out` `cso` on((`csi`.`idhppikm` = `cso`.`idhppikm`))) join `m3_ib_detail` `ibd` on(((`csi`.`sumber` = 'IB') and (`csi`.`idbarang` = `ibd`.`idbarang`) and (`csi`.`idtransaksi` = `ibd`.`idibdetail`)))) join `m3_ib` `ib` on((`ibd`.`idib` = `ib`.`ibid`))) join `m1_item_transaction` `it` on(((`cso`.`sumber` = `it`.`sumber`) and (`cso`.`idbarang` = `it`.`idbarang`) and (`cso`.`idtransaksi` = `it`.`iddetail`)))) where (`ib`.`ibid` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`ib`.`ibid`"
        'sql = "select `ib`.`ibid` AS `ibid`,`ib`.`ibnotransaksi` AS `ibnotransaksi`,`cfo`.`cfosumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait`,1 AS `jenisterkait` from ((((`m1_cogs_fifo_in` `cfi` join `m1_cogs_fifo_out` `cfo` on((`cfi`.`cfiid` = `cfo`.`cfoidcfi`))) join `m3_ib_detail` `ibd` on(((`cfi`.`cfisumber` = 'IB') and (`cfi`.`cfiidbarang` = `ibd`.`idbarang`) and (`cfi`.`cfiidtransaksi` = `ibd`.`idibdetail`)))) join `m3_ib` `ib` on((`ibd`.`idib` = `ib`.`ibid`))) join `m1_item_transaction` `it` on(((`cfo`.`cfosumber` = `it`.`sumber`) and (`cfo`.`cfoidbarang` = `it`.`idbarang`) and (`cfo`.`cfoidtransaksi` = `it`.`iddetail`)))) where (`ib`.`ibid` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`ib`.`ibid` union select `ib`.`ibid` AS `ibid`,`ib`.`ibnotransaksi` AS `ibnotransaksi`,`cso`.`sumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait`,1 AS `jenisterkait` from ((((`m1_cogs_special_in` `csi` join `m1_cogs_special_out` `cso` on((`csi`.`idhppikm` = `cso`.`idhppikm`))) join `m3_ib_detail` `ibd` on(((`csi`.`sumber` = 'IB') and (`csi`.`idbarang` = `ibd`.`idbarang`) and (`csi`.`idtransaksi` = `ibd`.`idibdetail`)))) join `m3_ib` `ib` on((`ibd`.`idib` = `ib`.`ibid`))) join `m1_item_transaction` `it` on(((`cso`.`sumber` = `it`.`sumber`) and (`cso`.`idbarang` = `it`.`idbarang`) and (`cso`.`idtransaksi` = `it`.`iddetail`)))) where (`ib`.`ibid` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`ib`.`ibid`"
        sql = "select `ib`.`ibid` AS `ibid`,`ib`.`ibnotransaksi` AS `ibnotransaksi`,`cfo`.`cfosumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait`,1 AS `jenisterkait` from ((((`m1_cogs_fifo_in` `cfi` join `m1_cogs_fifo_out` `cfo` on((`cfi`.`cfiid` = `cfo`.`cfoidcfi`))) join `m3_ib_detail` `ibd` on(((`cfi`.`cfisumber` = 'IB') and (`cfi`.`cfiidbarang` = `ibd`.`idbarang`) and (`cfi`.`cfiidtransaksi` = `ibd`.`idibdetail`)))) join `m3_ib` `ib` on((`ibd`.`idib` = `ib`.`ibid`))) join `m1_item_transaction` `it` on(((`cfo`.`cfosumber` = `it`.`sumber`) and (`cfo`.`cfoidbarang` = `it`.`idbarang`) and (`cfo`.`cfoidtransaksi` = `it`.`iddetail`)))) where (`ib`.`ibid` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`ib`.`ibid` union select `ib`.`ibid` AS `ibid`,`ib`.`ibnotransaksi` AS `ibnotransaksi`,`cso`.`sumber` AS `sumber`,`it`.`idutama` AS `idterkait`,`it`.`notransaksi` AS `noterkait`,`it`.`tgl` AS `tglterkait`,`it`.`inputtgl` AS `inputtglterkait`,`it`.`inputtgl` AS `modifikasitglterkait`,1 AS `jenisterkait` from ((((`m1_cogs_special_in` `csi` join `m1_cogs_special_out` `cso` on((`csi`.`idhppikm` = `cso`.`idhppikm`))) join `m3_ib_detail` `ibd` on(((`csi`.`sumber` = 'IB') and (`csi`.`idbarang` = `ibd`.`idbarang`) and (`csi`.`idtransaksi` = `ibd`.`idibdetail`)))) join `m3_ib` `ib` on((`ibd`.`idib` = `ib`.`ibid`))) join `m1_item_transaction` `it` on(((`cso`.`sumber` = `it`.`sumber`) and (`cso`.`idbarang` = `it`.`idbarang`) and (`cso`.`idtransaksi` = `it`.`iddetail`)))) where (`ib`.`ibid` = 'validtransaksi') group by `it`.`sumber`,`it`.`idutama`,`ib`.`ibid` union SELECT ib.ibid as ibid, ib.ibnotransaksi as ibnotransaksi, da.dasumber as sumber, da.daid as idterkait, da.danotransaksi as noterkait, da.datgl as tglterkait, da.dainputtgl as inputtglterkait, da.damodifikasitgl as modifikasitglterkait, 1 as jenisterkait FROM m7_asset_transaction atr JOIN m3_ib ib ON atr.atsumber = ib.ibsumber AND atr.atidutama = ib.ibid AND ib.ibid = 'validtransaksi' JOIN m7_asset a ON atr.atkode = a.akode JOIN m7_da_detail dad ON a.aid = dad.idaset JOIN m7_da da ON dad.idda = da.daid AND da.dastatus IN(2,3,4,7) GROUP BY da.daid, ib.ibid union SELECT atr.atidutama AS ibid, atr.atnotransaksi AS ibnotransaksi, atr2.atsumber AS sumber, atr2.atidutama AS idterkait, atr2.atnotransaksi AS noterkait, atr2.attgl AS tglterkait, CONCAT(atr2.attgl,'00:00:00') AS inputtglterkait, CONCAT(atr2.attgl,'00:00:00') AS modifikasitglterkait, 1 AS jenisterkait FROM m7_asset_transaction atr JOIN m7_asset_transaction atr2 ON atr.atkode = atr2.atkode AND atr2.atstatus IN(2,3,4,7) AND atr.atsumber = 'IB' AND atr.atidutama = 'validtransaksi' AND NOT (atr.atsumber = atr2.atsumber AND atr.atidutama = atr2.atidutama) GROUP BY atr2.atsumber, atr2.atidutama"
        Return sql
    End Function

