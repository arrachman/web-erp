    <WebMethod()>
    Public Function m5_pl_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = "", filter3 As String = ""
        Dim filter4 As String = "", filter5 As String = "", filter7 As String = "", filter8 As String = "", filter9 As String = ""

        'Replace Filter & plrt
        If (strFilter.Length > 0) Then
            filter1 = strFilter

            filter2 = strFilter

            filter3 = strFilter

            filter4 = strFilter
            filter4 = filter4 & " AND ((`m5_do`.`dostatus` = 2) or (`m5_do`.`dostatus` = 3) or (`m5_do`.`dostatus` = 4) or (`m5_do`.`dostatus` = 7))"

            filter5 = strFilter
            filter5 = filter5 & " AND ((`m5_dr`.`drstatus` = 2) or (`m5_dr`.`drstatus` = 3) or (`m5_dr`.`drstatus` = 4) or (`m5_dr`.`drstatus` = 7))"

            filter7 = strFilter
            filter7 = filter7 & " AND ((`m5_si`.`sistatus` = 2) or (`m5_si`.`sistatus` = 3) or (`m5_si`.`sistatus` = 4) or (`m5_si`.`sistatus` = 7))"

            filter8 = strFilter
            filter8 = filter8 & " AND ((`m5_rnr`.`rnrstatus` = 2) or (`m5_rnr`.`rnrstatus` = 3) or (`m5_rnr`.`rnrstatus` = 4) or (`m5_rnr`.`rnrstatus` = 7))"

            filter9 = strFilter
            filter9 = filter9 & " AND ((`m5_sr`.`srstatus` = 2) or (`m5_sr`.`srstatus` = 3) or (`m5_sr`.`srstatus` = 4) or (`m5_sr`.`srstatus` = 7))"
        Else
            'Default filter
            filter4 = "((`m5_do`.`dostatus` = 2) or (`m5_do`.`dostatus` = 3) or (`m5_do`.`dostatus` = 4) or (`m5_do`.`dostatus` = 7))"
            filter5 = "((`m5_dr`.`drstatus` = 2) or (`m5_dr`.`drstatus` = 3) or (`m5_dr`.`drstatus` = 4) or (`m5_dr`.`drstatus` = 7))"
            filter7 = "((`m5_si`.`sistatus` = 2) or (`m5_si`.`sistatus` = 3) or (`m5_si`.`sistatus` = 4) or (`m5_si`.`sistatus` = 7))"
            filter8 = "((`m5_rnr`.`rnrstatus` = 2) or (`m5_rnr`.`rnrstatus` = 3) or (`m5_rnr`.`rnrstatus` = 4) or (`m5_rnr`.`rnrstatus` = 7))"
            filter9 = "((`m5_sr`.`srstatus` = 2) or (`m5_sr`.`srstatus` = 3) or (`m5_sr`.`srstatus` = 4) or (`m5_sr`.`srstatus` = 7))"
        End If

        If Len(filter1) > 0 Then filter1 = " WHERE " & filter1
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2
        If Len(filter3) > 0 Then filter3 = " WHERE " & filter3
        If Len(filter4) > 0 Then filter4 = " WHERE " & filter4
        If Len(filter5) > 0 Then filter5 = " WHERE " & filter5
        If Len(filter7) > 0 Then filter7 = " WHERE " & filter7
        If Len(filter8) > 0 Then filter8 = " WHERE " & filter8
        If Len(filter9) > 0 Then filter9 = " WHERE " & filter9

        sql = " SELECT pl.plid AS plid, pl.plnotransaksi AS plnotransaksi, sq.sqsumber AS sumber, sq.sqid AS idterkait, sq.sqnotransaksi AS noterkait, sq.sqtgl AS tglterkait, sq.sqinputtgl AS inputtglterkait, sq.sqmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait FROM m5_sq_detail sqd JOIN m5_sq sq ON sqd.idsq = sqid JOIN m5_pl_detail pld ON sqd.idsqdetail = pld.idsqdetail JOIN m5_pl pl ON pld.idpl = pl.plid " & filter1 & " GROUP BY sq.sqid, pl.plid"
        sql &= " UNION ALL "
        sql &= "SELECT pl.plid AS plid, pl.plnotransaksi AS plnotransaksi, so.sosumber AS sumber, so.soid AS idterkait, so.sonotransaksi AS noterkait, so.sotgl AS tglterkait, so.soinputtgl AS inputtglterkait, so.somodifikasitgl AS modifikasitglterkait,  0 as jenisterkait FROM m5_so_detail sod JOIN m5_so so ON sod.idso = soid JOIN m5_pl_detail pld ON sod.idsodetail = pld.idsodetail JOIN m5_pl pl ON pld.idpl = pl.plid " & filter2 & " GROUP BY so.soid, pl.plid"
        sql &= " UNION ALL "
        sql &= "SELECT pl.plid AS plid, pl.plnotransaksi AS plnotransaksi, pi.pisumber AS sumber, pi.piid AS idterkait, pi.pinotransaksi AS noterkait, pi.pitgl AS tglterkait, pi.piinputtgl AS inputtglterkait, pi.pimodifikasitgl AS modifikasitglterkait, 0 as jenisterkait FROM m5_pi_detail pid JOIN m5_pi pi ON pid.idpi = piid JOIN m5_pl_detail pld ON pid.idpidetail = pld.idpidetail JOIN m5_pl pl ON pld.idpl = pl.plid " & filter3 & " GROUP BY pi.piid, pl.plid"
        sql &= " UNION ALL "
        sql &= "select `pl`.`plid` AS `plid`,`pl`.`plnotransaksi` AS `plnotransaksi`,'DO' AS `sumber`,`m5_do`.`doid` AS `idterkait`,`m5_do`.`donotransaksi` AS `noterkait`,`m5_do`.`dotgl` AS `tglterkait`,`m5_do`.`doinputtgl` AS `inputtglterkait`,`m5_do`.`domodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from (((`m5_pl_detail` `pld` join `m5_pl` `pl` on((`pld`.`idpl` = `pl`.`plid`))) join `m5_do_detail` on((`m5_do_detail`.`idpldetail` = `pld`.`idpldetail`))) join `m5_do` on((`m5_do_detail`.`iddo` = `m5_do`.`doid`))) " & filter4 & "  group by `pl`.`plid`, `m5_do`.`doid` "
        sql &= " UNION ALL "
        sql &= "select `pl`.`plid` AS `plid`,`pl`.`plnotransaksi` AS `plnotransaksi`,'DR' AS `sumber`,`m5_dr`.`drid` AS `idterkait`,`m5_dr`.`drnotransaksi` AS `noterkait`,`m5_dr`.`drtgl` AS `tglterkait`,`m5_dr`.`drinputtgl` AS `inputtglterkait`,`m5_dr`.`drmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from (((`m5_pl_detail` `pld` join `m5_pl` `pl` on((`pld`.`idpl` = `pl`.`plid`))) join `m5_dr_detail` on((`m5_dr_detail`.`idpldetail` = `pld`.`idpldetail`))) join `m5_dr` on((`m5_dr_detail`.`iddr` = `m5_dr`.`drid`))) " & filter5 & "  group by `pl`.`plid`, `m5_dr`.`drid` "
        sql &= " UNION ALL "
        sql &= "select `pl`.`plid` AS `plid`,`pl`.`plnotransaksi` AS `plnotransaksi`,'SI' AS `sumber`,`m5_si`.`siid` AS `idterkait`,`m5_si`.`sinotransaksi` AS `noterkait`,`m5_si`.`sitgl` AS `tglterkait`,`m5_si`.`siinputtgl` AS `inputtglterkait`,`m5_si`.`simodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from (((`m5_pl_detail` `pld` join `m5_pl` `pl` on((`pld`.`idpl` = `pl`.`plid`))) join `m5_si_detail` on((`m5_si_detail`.`idpldetail` = `pld`.`idpldetail`))) join `m5_si` on((`m5_si_detail`.`idsi` = `m5_si`.`siid`))) " & filter7 & "  group by `pl`.`plid`, `m5_si`.`siid` "
        sql &= " UNION ALL "
        sql &= "select `pl`.`plid` AS `plid`,`pl`.`plnotransaksi` AS `plnotransaksi`,'RNR' AS `sumber`,`m5_rnr`.`rnrid` AS `idterkait`,`m5_rnr`.`rnrnotransaksi` AS `noterkait`,`m5_rnr`.`rnrtgl` AS `tglterkait`,`m5_rnr`.`rnrinputtgl` AS `inputtglterkait`,`m5_rnr`.`rnrmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from (((`m5_pl_detail` `pld` join `m5_pl` `pl` on((`pld`.`idpl` = `pl`.`plid`))) join `m5_rnr_detail` on((`m5_rnr_detail`.`idpldetail` = `pld`.`idpldetail`))) join `m5_rnr` on((`m5_rnr_detail`.`idrnr` = `m5_rnr`.`rnrid`))) " & filter8 & "  group by `pl`.`plid`, `m5_rnr`.`rnrid` "
        sql &= " UNION ALL "
        sql &= "select `pl`.`plid` AS `plid`,`pl`.`plnotransaksi` AS `plnotransaksi`,'SR' AS `sumber`,`m5_sr`.`srid` AS `idterkait`,`m5_sr`.`srnotransaksi` AS `noterkait`,`m5_sr`.`srtgl` AS `tglterkait`,`m5_sr`.`srinputtgl` AS `inputtglterkait`,`m5_sr`.`srmodifikasitgl` AS `modifikasitglterkait`, 1 as jenisterkait from (((`m5_pl_detail` `pld` join `m5_pl` `pl` on((`pld`.`idpl` = `pl`.`plid`))) join `m5_sr_detail` on((`m5_sr_detail`.`idpldetail` = `pld`.`idpldetail`))) join `m5_sr` on((`m5_sr_detail`.`idsr` = `m5_sr`.`srid`))) " & filter9 & "  group by `pl`.`plid`, `m5_sr`.`srid` "

