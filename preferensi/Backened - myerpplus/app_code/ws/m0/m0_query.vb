        'sql = "SELECT YEAR(si.sitgl) as otahun, MONTH(si.sitgl) as obulan, sid.idbarang as oidbarang, SUM(((sid.jml * sid.harga) - sid.jmldiskon) * sid.kurs) as onilai, i.bkode as okodebarang, i.btipe as otipebarang, i.bnama as onamabarang FROM m5_si si JOIN m5_si_detail sid ON si.siid = sid.idsi JOIN m1_item i ON sid.idbarang = i.bid"
        sql = "SELECT YEAR(si.sitgl) as otahun, MONTH(si.sitgl) as obulan, sid.idbarang as oidbarang, SUM(((sid.jml * sid.harga) - sid.jmldiskon) * sid.kurs) as onilai, i.bkode as okodebarang, i.btipe as otipebarang, i.bnama as onamabarang FROM m5_si si JOIN m5_si_detail sid ON si.siid = sid.idsi JOIN m1_item i ON sid.idbarang = i.bid JOIN m1_item_transaction it ON si.sisumber = it.sumber AND si.siid = it.idutama AND sid.idsidetail = it.iddetail AND sid.idbarang = it.idbarang"
