    <WebMethod()>
    Public Function m6_mrn_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = "", filter3 As String = "", filter4 As String = ""
        Dim filter5 As String = "", filter6 As String = "", filter7 As String = "", filter8 As String = ""

        'Replace Filter
        If (strFilter.Length > 0) Then
            'BOM OUT
            filter2 = strFilter

            'PDR OUT
            filter4 = strFilter

            'WO OUT
            filter5 = strFilter

            'MRS OUT
            filter6 = strFilter

            ''PD OUT
            'filter8 = strFilter
            'filter8 = filter8 & " AND (pd.pdstatus IN(2,3,4,7)) "

        Else
            ''PD OUT
            'filter8 = " (pd.pdstatus IN(2,3,4,7)) "

        End If

        'BOM OUT
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2
        'PDR OUT
        If Len(filter4) > 0 Then filter4 = " WHERE " & filter4
        'WO OUT
        If Len(filter5) > 0 Then filter5 = " WHERE " & filter5
        'MRS OUT
        If Len(filter6) > 0 Then filter6 = " WHERE " & filter6
        ''PD OUT
        'If Len(filter8) > 0 Then filter8 = " WHERE " & filter8


        'BOM OUT
        sql = " select mrn.mrnid AS mrnid, mrn.mrnnotransaksi AS mrnnotransaksi, bom.bomsumber AS sumber, bom.bomid AS idterkait, bom.bomnotransaksi AS noterkait, bom.bomtgl AS tglterkait, bom.bominputtgl AS inputtglterkait, bom.bommodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_bom_out bomo join m6_bom bom on bomo.idbom = bom.bomid join m6_mrn_out mrno on bomo.idbomout = mrno.idbomout join m6_mrn mrn ON mrno.idmrn = mrn.mrnid " & filter2 & " group by bom.bomid, mrn.mrnid "
        'PDR OUT
        sql &= " UNION ALL "
        sql &= " select mrn.mrnid AS mrnid, mrn.mrnnotransaksi AS mrnnotransaksi, pdr.pdrsumber AS sumber, pdr.pdrid AS idterkait, pdr.pdrnotransaksi AS noterkait, pdr.pdrtgl AS tglterkait, pdr.pdrinputtgl AS inputtglterkait, pdr.pdrmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_pdr_out pdro join m6_pdr pdr on pdro.idpdr = pdr.pdrid join m6_mrn_out mrno on pdro.idpdrout = mrno.idpdrout join m6_mrn mrn ON mrno.idmrn = mrn.mrnid " & filter4 & " group by pdr.pdrid, mrn.mrnid "
        'WO OUT
        sql &= " UNION ALL "
        sql &= " select mrn.mrnid AS mrnid, mrn.mrnnotransaksi AS mrnnotransaksi, wo.wosumber AS sumber, wo.woid AS idterkait, wo.wonotransaksi AS noterkait, wo.wotgl AS tglterkait, wo.woinputtgl AS inputtglterkait, wo.womodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_wo_out woo join m6_wo wo on woo.idwo = wo.woid join m6_mrn_out mrno on woo.idwoout = mrno.idwoout join m6_mrn mrn ON mrno.idmrn = mrn.mrnid " & filter5 & " group by wo.woid, mrn.mrnid "
        'MRS OUT
        sql &= " UNION ALL "
        sql &= " select mrn.mrnid AS mrnid, mrn.mrnnotransaksi AS mrnnotransaksi, mrs.mrssumber AS sumber, mrs.mrsid AS idterkait, mrs.mrsnotransaksi AS noterkait, mrs.mrstgl AS tglterkait, mrs.mrsinputtgl AS inputtglterkait, mrs.mrsmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_mrs_out mrso join m6_mrs mrs on mrso.idmrs = mrs.mrsid join m6_mrn_out mrno on mrso.idmrsout = mrno.idmrsout join m6_mrn mrn ON mrno.idmrn = mrn.mrnid " & filter6 & " group by mrs.mrsid, mrn.mrnid "
        ''PD OUT
        'sql &= " UNION ALL "
        'sql &= " select mrn.mrnid AS mrnid, mrn.mrnnotransaksi AS mrnnotransaksi, pd.pdsumber AS sumber, pd.pdid AS idterkait, pd.pdnotransaksi AS noterkait, pd.pdtgl AS tglterkait, pd.pdinputtgl AS inputtglterkait, pd.pdmodifikasitgl AS modifikasitglterkait, 1 as jenisterkait from m6_pd_out pdo join m6_pd pd on pdo.idpd = pd.pdid join m6_mrn_out mrno on pdo.idmrnout = mrno.idmrnout join m6_mrn mrn ON mrno.idmrn = mrn.mrnid " & filter8 & " group by pd.pdid, mrn.mrnid"

        'GRUPKAN BERDASARKAN ID DAN IDTERKAIT
        sql = " SELECT * FROM ( " & sql & " ) as terkait GROUP BY mrnid, sumber, idterkait "

        Return sql
    End Function

