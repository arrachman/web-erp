    <WebMethod()>
    Public Function m6_pd_terkait(ByVal strFilter As String) As String
        Dim sql As String
        Dim filter1 As String = "", filter2 As String = "", filter3 As String = "", filter4 As String = ""
        Dim filter5 As String = "", filter6 As String = "", filter7 As String = "", filter8 As String = "", filter9 As String = ""

        'Replace Filter
        If (strFilter.Length > 0) Then
            'BOM IN
            filter1 = strFilter

            'BOM OUT
            filter2 = strFilter

            'PDR IN
            filter3 = strFilter

            'PDR OUT
            filter4 = strFilter

            'WO IN
            filter5 = strFilter

            'WO OUT
            filter6 = strFilter

            'MRS OUT
            filter7 = strFilter

            'FIFO OUT
            filter8 = strFilter

            'SPECIAL OUT
            filter9 = strFilter

        End If


        'BOM IN
        If Len(filter1) > 0 Then filter1 = " WHERE " & filter1
        'BOM OUT
        If Len(filter2) > 0 Then filter2 = " WHERE " & filter2
        'PDR IN
        If Len(filter3) > 0 Then filter3 = " WHERE " & filter3
        'PDR OUT
        If Len(filter4) > 0 Then filter4 = " WHERE " & filter4
        'WO IN
        If Len(filter5) > 0 Then filter5 = " WHERE " & filter5
        'WO OUT
        If Len(filter6) > 0 Then filter6 = " WHERE " & filter6
        'MRS OUT
        If Len(filter7) > 0 Then filter7 = " WHERE " & filter7
        'FIFO OUT
        If Len(filter8) > 0 Then filter8 = " WHERE " & filter8
        'SPECIAL OUT
        If Len(filter9) > 0 Then filter9 = " WHERE " & filter9


        'BOM IN
        sql = "  select pd.pdid AS pdid, pd.pdnotransaksi AS pdnotransaksi, bom.bomsumber AS sumber, bom.bomid AS idterkait, bom.bomnotransaksi AS noterkait, bom.bomtgl AS tglterkait, bom.bominputtgl AS inputtglterkait, bom.bommodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_bom_in bomi join m6_bom bom on bomi.idbom = bom.bomid join m6_pd_in pdi on bomi.idbomin = pdi.idbomin join m6_pd pd ON pdi.idpd = pd.pdid " & filter1 & " group by bom.bomid, pd.pdid "
        'BOM OUT
        sql &= " UNION ALL "
        sql &= " select pd.pdid AS pdid, pd.pdnotransaksi AS pdnotransaksi, bom.bomsumber AS sumber, bom.bomid AS idterkait, bom.bomnotransaksi AS noterkait, bom.bomtgl AS tglterkait, bom.bominputtgl AS inputtglterkait, bom.bommodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_bom_out bomo join m6_bom bom on bomo.idbom = bom.bomid join m6_pd_out pdo on bomo.idbomout = pdo.idbomout join m6_pd pd ON pdo.idpd = pd.pdid " & filter2 & " group by bom.bomid, pd.pdid "
        'PDR IN
        sql &= " UNION ALL "
        sql &= " select pd.pdid AS pdid, pd.pdnotransaksi AS pdnotransaksi, pdr.pdrsumber AS sumber, pdr.pdrid AS idterkait, pdr.pdrnotransaksi AS noterkait, pdr.pdrtgl AS tglterkait, pdr.pdrinputtgl AS inputtglterkait, pdr.pdrmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_pdr_in pdri join m6_pdr pdr on pdri.idpdr = pdr.pdrid join m6_pd_in pdi on pdri.idpdrin = pdi.idpdrin join m6_pd pd ON pdi.idpd = pd.pdid " & filter3 & " group by pdr.pdrid, pd.pdid "
        'PDR OUT
        sql &= " UNION ALL "
        sql &= " select pd.pdid AS pdid, pd.pdnotransaksi AS pdnotransaksi, pdr.pdrsumber AS sumber, pdr.pdrid AS idterkait, pdr.pdrnotransaksi AS noterkait, pdr.pdrtgl AS tglterkait, pdr.pdrinputtgl AS inputtglterkait, pdr.pdrmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_pdr_out pdro join m6_pdr pdr on pdro.idpdr = pdr.pdrid join m6_pd_out pdo on pdro.idpdrout = pdo.idpdrout join m6_pd pd ON pdo.idpd = pd.pdid " & filter4 & " group by pdr.pdrid, pd.pdid "
        'WO IN
        sql &= " UNION ALL "
        sql &= " select pd.pdid AS pdid, pd.pdnotransaksi AS pdnotransaksi, wo.wosumber AS sumber, wo.woid AS idterkait, wo.wonotransaksi AS noterkait, wo.wotgl AS tglterkait, wo.woinputtgl AS inputtglterkait, wo.womodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_wo_in woi join m6_wo wo on woi.idwo = wo.woid join m6_pd_in pdi on woi.idwoin = pdi.idwoin join m6_pd pd ON pdi.idpd = pd.pdid " & filter5 & " group by wo.woid, pd.pdid "
        'WO OUT
        sql &= " UNION ALL "
        sql &= " select pd.pdid AS pdid, pd.pdnotransaksi AS pdnotransaksi, wo.wosumber AS sumber, wo.woid AS idterkait, wo.wonotransaksi AS noterkait, wo.wotgl AS tglterkait, wo.woinputtgl AS inputtglterkait, wo.womodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_wo_out woo join m6_wo wo on woo.idwo = wo.woid join m6_pd_out pdo on woo.idwoout = pdo.idwoout join m6_pd pd ON pdo.idpd = pd.pdid " & filter6 & " group by wo.woid, pd.pdid "
        'MRS OUT
        sql &= " UNION ALL "
        sql &= " select pd.pdid AS pdid, pd.pdnotransaksi AS pdnotransaksi, mrs.mrssumber AS sumber, mrs.mrsid AS idterkait, mrs.mrsnotransaksi AS noterkait, mrs.mrstgl AS tglterkait, mrs.mrsinputtgl AS inputtglterkait, mrs.mrsmodifikasitgl AS modifikasitglterkait, 0 as jenisterkait from m6_mrs_out mrso join m6_mrs mrs on mrso.idmrs = mrs.mrsid join m6_pd_out pdo on mrso.idmrsout = pdo.idmrsout join m6_pd pd ON pdo.idpd = pd.pdid " & filter7 & " group by mrs.mrsid, pd.pdid "
