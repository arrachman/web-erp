				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(12,13,jenissimpan)==true){
						f_simpan();
					}
				}
				
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbTampilkan():void
				{
					f_tampilkan();
				}
				function f_mbSetPerubahan():void
				{
