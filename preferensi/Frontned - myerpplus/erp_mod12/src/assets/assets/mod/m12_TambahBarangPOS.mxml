			// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
					case 'checkBoxHeader':
						for (i=0; i<dg1.dataProviderLength; i++){
							dg1.dataProvider.getItemAt(i).chk = data;
							if(data == 1){
								dg1.dataProvider.getItemAt(i).piaksi = 1;
							}else{
								dg1.dataProvider.getItemAt(i).piaksi = 0;
							}
							if(dg1.dataProvider.getItemAt(i).pistatusgetdata == 1){
								if(dg1.dataProvider.getItemAt(i).chk ==1){
									if((dg1.dataProvider.getItemAt(i).stokminimal != dg1.dataProvider.getItemAt(i).stokminimallama)  && (dg1.dataProvider.getItemAt(i).stokmaksimal != dg1.dataProvider.getItemAt(i).stokmaksimallama) && (dg1.dataProvider.getItemAt(i).stokreorder != dg1.dataProvider.getItemAt(i).stokreorderlama) && (dg1.dataProvider.getItemAt(i).hargajual1 != dg1.dataProvider.getItemAt(i).hargajual1lama) && (dg1.dataProvider.getItemAt(i).hargajual2 != dg1.dataProvider.getItemAt(i).hargajual2lama) && (dg1.dataProvider.getItemAt(i).hargajual3 != dg1.dataProvider.getItemAt(i).hargajual3lama) && (dg1.dataProvider.getItemAt(i).hargajual4 != dg1.dataProvider.getItemAt(i).hargajual4lama) && (dg1.dataProvider.getItemAt(i).hargajual5 != dg1.dataProvider.getItemAt(i).hargajual5lama) && (dg1.dataProvider.getItemAt(i).diskonjual1 != dg1.dataProvider.getItemAt(i).diskonjual1lama) && (dg1.dataProvider.getItemAt(i).diskonjual2 != dg1.dataProvider.getItemAt(i).diskonjual2lama) && (dg1.dataProvider.getItemAt(i).diskonjual3 != dg1.dataProvider.getItemAt(i).diskonjual3lama) && (dg1.dataProvider.getItemAt(i).diskonjual4 != dg1.dataProvider.getItemAt(i).diskonjual4lama) && (dg1.dataProvider.getItemAt(i).diskonjual5 != dg1.dataProvider.getItemAt(i).diskonjual5lama)){
										dg1.dataProvider.getItemAt(i).pistatusubah = 1;
									}else{
