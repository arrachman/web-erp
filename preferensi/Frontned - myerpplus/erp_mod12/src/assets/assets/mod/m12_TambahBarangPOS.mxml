									dg1.dataProvider.getItemAt(i).pistatusubah = 1;
								}else{
									dg1.dataProvider.getItemAt(i).pistatusubah = 0;
								}
								
							}
							
						}
						break;
					case 'checkBox':
						dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).chk = data;
						if(data == 1){
							dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).piaksi = 1;
						}else{
							dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).piaksi = 0;
						}
						if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).pistatusgetdata == 1){
							if(data == 1){
								if((dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).stokminimal != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).stokminimallama)  && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).stokmaksimal != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).stokmaksimallama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).stokreorder != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).stokreorderlama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual1 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual1lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual2 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual2lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual3 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual3lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual4 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual4lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual5 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargajual5lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual1 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual1lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual2 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual2lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual3 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual3lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual4 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual4lama) && (dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual5 != dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).diskonjual5lama)){
									dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).pistatusubah = 1;
								}else{
									dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).pistatusubah = 0;
								}
							}else{
								dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).pistatusubah = 1;
							}
							
							
						}
						if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).pistatusgetdata == 0){
							if(data == 1){
								dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).pistatusubah = 1;
							}else{
								dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).pistatusubah = 0;
							}
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
			}
			
