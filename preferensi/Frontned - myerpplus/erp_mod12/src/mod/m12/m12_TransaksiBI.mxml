			public function setBonus():void{
				
				acBonus.removeAll();
				acBonus2.removeAll();
				
				var nomor : Object = {}
				var r:Object = {}, t:int;
				
				if(cmbkriteria.selectedIndex == 0){
					for(t=0;t<acBonus.length;t++){
						// jumlah
						if(r[acBonus[t].idbarang] == undefined) r[acBonus[t].nbtidbarang] = acBonus[t].jml;
						else r[acBonus[t].idbarang] += acBonus[t].nbtjml;
						
						// nomer
						if(nomor[acBonus[t].idbarang] == undefined)
							nomor[acBonus[t].idbarang] = 2;
						else 
							nomor[acBonus[t].idbarang]++;
					}	
				}else{
					for(t=0;t<acBonus2.length;t++){
						// jumlah
						if(r[acBonus2[t].idbarang] == undefined) r[acBonus2[t].nbtidbarang] = acBonus2[t].jml;
						else r[acBonus2[t].idbarang] += acBonus2[t].nbtjml;
						
						// nomer
						if(nomor[acBonus2[t].idbarang] == undefined)
							nomor[acBonus2[t].idbarang] = 2;
						else 
							nomor[acBonus2[t].idbarang]++;
					}
				}
				
				if(cmbkriteria.selectedIndex == 0){
					for(i=0;i<dg.dataProvider.length;i++){
						
						if(nomor[dg.dataProvider.getItemAt(i).idbarang] == undefined)
							nomor[dg.dataProvider.getItemAt(i).idbarang] = 1;
						if(r[dg.dataProvider.getItemAt(i).idbarang] == undefined)
							r[dg.dataProvider.getItemAt(i).idbarang] = 0;
						if(dg.dataProvider[i].idbidetail == undefined)
							dg.dataProvider[i].idbidetail = 0;
						
						if(cmbkriteria.selectedIndex == 0){
							if(r[dg.dataProvider.getItemAt(i).idbarang] < dg.dataProvider[i].jml)
								acBonus.addItem({no:nomor[dg.dataProvider.getItemAt(i).idbarang]++, idbonus:0, idbidetail:0, idbarang:0, jml:1, satuan:"", 
									customtext1:"", customtext2:"", 
									customtext3:"", customtext4:"", customtext5:"", customint1:0, 
									customint2:0, customint3:0, customdbl1:0, 
									customdbl2:0, customdbl3:0, customdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
									customdate2:FlexGlobals.topLevelApplication.DefaultTanggal, customdate3:FlexGlobals.topLevelApplication.DefaultTanggal, 
									kodebarang2:"", namabarang:"", 
									urutan:0, nogrup : dg.dataProvider[dg.selectedCell.rowIndex].nogrup});	
						}else{
							if(r[dg.dataProvider.getItemAt(i).idbarang] < dg.dataProvider[i].jml)
								acBonus2.addItem({no:nomor[dg.dataProvider.getItemAt(i).idbarang]++, idbonus:0, idbidetail:0, idbarang:0, jml:1, satuan:"", 
									customtext1:"", customtext2:"", 
									customtext3:"", customtext4:"", customtext5:"", customint1:0, 
									customint2:0, customint3:0, customdbl1:0, 
									customdbl2:0, customdbl3:0, customdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
									customdate2:FlexGlobals.topLevelApplication.DefaultTanggal, customdate3:FlexGlobals.topLevelApplication.DefaultTanggal, 
									kodebarang2:"", namabarang:"", 
									urutan:0, nogrup : dg.dataProvider[dg.selectedCell.rowIndex].nogrup});
						}
					}
				}else{
					for(i=0;i<dg3.dataProvider.length;i++){
						if(nomor[dg3.dataProvider.getItemAt(i).idbarang] == undefined)
							nomor[dg3.dataProvider.getItemAt(i).idbarang] = 1;
						if(r[dg3.dataProvider.getItemAt(i).idbarang] == undefined)
							r[dg3.dataProvider.getItemAt(i).idbarang] = 0;
						if(dg3.dataProvider[i].idbidetail == undefined)
							dg3.dataProvider[i].idbidetail = 0;
						
						if(cmbkriteria.selectedIndex == 0){
							if(r[dg3.dataProvider.getItemAt(i).idbarang] < dg3.dataProvider[i].jml)
								acBonus.addItem({no:nomor[dg3.dataProvider.getItemAt(i).idbarang]++, idbonus:0, idbidetail:0, idbarang:0, jml:1, satuan:"", 
									customtext1:"", customtext2:"", 
									customtext3:"", customtext4:"", customtext5:"", customint1:0, 
									customint2:0, customint3:0, customdbl1:0, 
									customdbl2:0, customdbl3:0, customdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
									customdate2:FlexGlobals.topLevelApplication.DefaultTanggal, customdate3:FlexGlobals.topLevelApplication.DefaultTanggal, 
									kodebarang2:"", namabarang:"", 
									urutan:0, nogrup : dg3.dataProvider[dg3.selectedCell.rowIndex].nogrup});	
						}else{
							if(r[dg3.dataProvider.getItemAt(i).idbarang] < dg3.dataProvider[i].jml)
								acBonus2.addItem({no:nomor[dg3.dataProvider.getItemAt(i).idbarang]++, idbonus:0, idbidetail:0, idbarang:0, jml:1, satuan:"", 
									customtext1:"", customtext2:"", 
									customtext3:"", customtext4:"", customtext5:"", customint1:0, 
									customint2:0, customint3:0, customdbl1:0, 
									customdbl2:0, customdbl3:0, customdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
									customdate2:FlexGlobals.topLevelApplication.DefaultTanggal, customdate3:FlexGlobals.topLevelApplication.DefaultTanggal, 
									kodebarang2:"", namabarang:"", 
									urutan:0, nogrup : dg3.dataProvider[dg3.selectedCell.rowIndex].nogrup});
						}
					}
				}
				
				
				dg2.dataProvider = acBonus;
				dg2.validateNow();
				dg.setSelectedCell(0,1);
				dg.validateNow();
				dg4.dataProvider = acBonus2;
				dg4.validateNow();
				dg3.setSelectedCell(0,1);
				dg3.validateNow();
				filterBonus();
			}
			
			private function filterBonus():void{
				//				(dg2.dataProvider as ArrayCollection).filterFunction = filterMyArrayCollection;
				//				(dg2.dataProvider as ArrayCollection).refresh();
				//				if(dg2.dataProviderLength == 0){FlexGlobals.topLevelApplication.F_acAdd(dg2)};
