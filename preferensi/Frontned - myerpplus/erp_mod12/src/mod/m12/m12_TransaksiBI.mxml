						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg2);
						dg.setFocus();
					}
				}else{
					if(dg4.dataProviderLength == 0){
						FlexGlobals.topLevelApplication.F_acAdd(dg4);
						dg3.setFocus();
					}else{
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg4);
						dg3.setFocus();
					}
				}
			}
			
			private function filterMyArrayCollection(item:Object):Boolean {
				var searchString:String;
				var itemName:String;
				
				if(cmbkriteria.selectedIndex == 0){
					if(dg.selectedCell != null)
					{
						searchString = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).grup;	
					}
				}else{
					searchString = dg3.dataProvider.getItemAt(rowindexdg3).grup;
				}
				itemName = (item.grup as String);
				Alert.show(itemName);
				if(itemName == null){
					return true;
				}
				
				return itemName.indexOf(searchString) > -1;
			}
			
