			public var validasi:Boolean,tt:TitleWindow, pesanAlert:String, pesanAlertIng:String,UFungsional:String, img:Image, i:int, isUpdate:Boolean, hf:Object;
			public var o:Object = {},no:int;
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			[Bindable]protected var acBonus:ArrayCollection = new ArrayCollection();
			[Bindable]protected var acBonus2:ArrayCollection = new ArrayCollection();
			[Bindable]protected var acBonus3:ArrayCollection = new ArrayCollection();
			public var rowindexdg3:int = 0;
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'operator'){
							return new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
						}
				}
				return new ArrayCollection([]);
			}
			
			public function f_focusOnMe():void
			{
				cmbkriteria.setFocus();
			}
			
			protected function f_persiapan():void
			{
				
				
				//mb.dataProvider = new ArrayCollection([{label:'Simpan', icon:tbsave}]);
				
				
				
				mb.dataProvider = new Array([{label:"simpan"}])
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				parentApplication.F_DateFieldStandard([dttgl]);
				parentApplication.F_ComboBoxStandard([cmbprogress, cmbjeniskategori, cmbkriteria]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtkategoripos,txtcabang])
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,chkauto]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tjeniskategori, ttanggal, tnotransaksi, tprogress]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkategoripos, ttanggal, tnotransaksi, tprogress, turaian, tkontakperson, tcatatan]);
				tab.focusEnabled = false;
				cmbjeniskategori.dataProvider = new ArrayCollection([{l:'Semua Kategori', v:0}, {l:'Per Kategori', v:1}, {l:'Per Cabang', v:2}]);
				cmbkriteria.dataProvider = new ArrayCollection([{l:'Barang', v:0}, {l:'Nominal', v:1}, {l:'Special Price', v:2}]);
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbbuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLink);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(12,54,jenissimpan)==true){
							f_simpan();
						}
					}
				}
				function f_mbbuka():void{
					if(mb.menuBarItems[1].enabled ==true)FlexGlobals.topLevelApplication.f_bukaTransaksi('Bi');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg3);
					f_kondisiAwal(); 
					mb.menuBarItems[3].enabled=false;
					mb.menuBarItems[4].enabled=false;
				}
				
				function f_mbCatatan():void{
					if(mb.menuBarItems[3].enabled==true)FlexGlobals.topLevelApplication.F_OpenNotes(o.bisumber,o.biid,txtnotransaksi.text);
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('BI', o.biid,txtnotransaksi.text);
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(2,'Bi');
				}
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
					if(event.keyCode == Keyboard.ENTER){
						if(cmbkriteria.selectedIndex == 0){
							dg.setFocus();
							dg.setSelectedCell(0,1);	
						}else if(cmbkriteria.selectedIndex == 1){
							dg3.setFocus();
							dg3.setSelectedCell(0,1);
						}else{
							dg5.setFocus();
							dg5.setSelectedCell(0,1);
						}
					}
				}
				);
				
				
				FlexGlobals.topLevelApplication.F_RegGrid(12,54,[dg, dg2, dg3, dg4, dg5, dg6],'transaksi');
				f_validasi();
				dg2.dataProvider = acBonus;
				dg4.dataProvider = acBonus2;
				dg6.dataProvider = acBonus3;
				
				//				setBonus()
				
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M12_BiHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M12_BiGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				acBonus.removeAll();
				acBonus2.removeAll();
				acBonus3.removeAll();
				tabbarang.enabled = true;
				tabnominal.enabled = false;
				tabspecialprice.enabled = false;
				twajibkatpos.enabled = true;
				txtcabang.enabled = false;
				lblcabang.enabled =  false;
				twajibcabang.visible = false;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				cmbprogress.selectedIndex = 1;
				chkauto.selected = true;
				txtnotransaksi.text = 'Auto';
				txtnotransaksi.enabled = false;
				cmbkriteria.selectedIndex = 0;
				cmbjeniskategori.selectedIndex = 1;
				isUpdate = false;
				txtkategoripos.setFocus();
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("BI");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("BI",1);
				parentApplication.F_SetNilaiText([dttgl], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtkategoripos,lblkategoripos,txtcabang,lblcabang,txtkontakperson]);
				//set utama
				FlexGlobals.topLevelApplication.DefaultTanggal
				o.biid = 0; o.bicabang = FlexGlobals.topLevelApplication.ucabang; o.bilokasi = FlexGlobals.topLevelApplication.ulokasi; o.bisumber = "BI"; 
				o.bikodepa = 0; o.bikontak = FlexGlobals.topLevelApplication.ukontak; o.bistatussebelumnya = 0; o.bijmlrevisi = 0; 
				o.bicetakanke = 0; o.biisclose = 0; o.biinputuser = FlexGlobals.topLevelApplication.userid; o.biinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.bimodifikasiuser = 0; 
				o.bimodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.biposting = 0; o.bipostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.bicustomtext1 = ''; o.bicustomtext2 = ''; o.bicustomtext3 = ''; o.bicustomtext4 = ''; o.bicustomtext5 = ''; 
				o.bicustomint1 = 0; o.bicustomint2 = 0; o.bicustomint3 = 0; o.bicustomdbl1 = 0; o.bicustomdbl2 = 0; o.bicustomdbl3 = 0; 
				o.bicustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.bicustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.bicustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
				
				if(cmbkriteria.selectedIndex == 0){
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).kodebarang=''; 
						dg.dataProvider.getItemAt(i).jml1=0; 
					}	
				}else{
					for(i=0; i<dg3.dataProviderLength; i++){
						dg3.dataProvider.getItemAt(i).kodebarang=''; 
						dg3.dataProvider.getItemAt(i).jml1=0; 
					}
				}
				dg2.dataProvider.removeAll();
				FlexGlobals.topLevelApplication.F_acAdd(dg2); 
				dg4.dataProvider.removeAll();
				FlexGlobals.topLevelApplication.F_acAdd(dg4); 
				filterBonus();
				f_focusOnMe();
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(12,54,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				var nogrup:int
				//				o.a = column.split('|');
				//				if(column == 'add' || o.a[0] == 'add'){
				//					if(dg == dg3){
				//						
				//						
				//					}
				//				}
				
				switch(column){
					case 'add':
						if(dg3.selectedCell != null){
							var arr:Object;
							
						}
						break;
					case 'pre_del':
						if(cmbkriteria.selectedIndex == 0){
							if(dg != dg2){
								nogrup = dg.dataProvider[dg.selectedCell.rowIndex].nogrup
								if(dg.selectedCell != null){
									for(var a:int = dg2.dataProviderLength - 1; a>=0; a--){
										if(nogrup == dg2.dataProvider[a].nogrup){
											dg2.dataProvider.removeItemAt(a);
										}
									}
								}
							}	
						}else{
							if(dg3 != dg4){
								nogrup = dg3.dataProvider[dg3.selectedCell.rowIndex].nogrup
								if(dg3.selectedCell != null){
									for(var aa:int = dg4.dataProviderLength - 1; aa>=0; aa--){
										if(nogrup == dg4.dataProvider[aa].nogrup){
											dg4.dataProvider.removeItemAt(aa);
										}
									}
								}
							}
						}
						break;
					case 'jml2':
						if(cmbkriteria.selectedIndex == 0){
							with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
								if(operator != 0){
									jml2 = 0;
								}
							}	
						}else{
							with(dg3.dataProvider.getItemAt(dg3.selectedCell.rowIndex)){
								if(operator != 0){
									jml2 = 0;
								}
							}
						}
						break;
					case "jml1":
						if(cmbkriteria.selectedIndex == 1){
							arr = dg3.dataProvider.getItemAt(dg3.selectedCell.rowIndex);
							arr.idbidetail = 0; 
							arr.idbi = 0; 
							arr.bikategori = txtkategoripos.text; 
							arr.idbarang = 0;
							arr.kodebarang = ""; 
							arr.namabarang = ""; 
							//							arr.operator = 1; 
							arr.jml2 = 0; 
							arr.customtext1 = ""; 
							arr.customtext2 = ""; 
							arr.customtext3 = ""; 
							arr.customtext4 = ""; 
							arr.customtext5 = ""; 
							arr.customint1 = 0; 
							arr.customint2 = 0; 
							arr.customint3 = 0; 
							arr.customdbl1 = 0; 
							arr.customdbl2 = 0;
							arr.customdbl3 = 0; 
							arr.customdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
							arr.customdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
							arr.customdate3 = FlexGlobals.topLevelApplication.m.DateFirst; 
							arr.tgl1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
							arr.tgl2 = FlexGlobals.topLevelApplication.F_tglJatuhTempo(FlexGlobals.topLevelApplication.DefaultTanggal, 1); 
							arr.nopromo = txtnotransaksi.text;
							arr.nogrup = dg.dataProviderLength;
							arr.catatan = "";
							arr.grup = "a"+arr.nogrup;
							FlexGlobals.topLevelApplication.F_dgRefresh(dg3);
							filterBonus();
						}
						
						break;
					case 'jumlahvalas':
						if(cmbjeniskategori.selectedIndex == 0){
							with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
								if (txtmatauang.text != UFungsional){
									jumlah = Number(jumlahvalas) * o.txtkurs;
								}else{
									jumlahvalas = 0;
								}
							}	
						}else{
							with(dg3.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
								if (txtmatauang.text != UFungsional){
									jumlah = Number(jumlahvalas) * o.txtkurs;
								}else{
									jumlahvalas = 0;
								}
							}
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				FlexGlobals.topLevelApplication.F_dgRefresh(dg3);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos':
						if(txtkategoripos.enabled == true){
							paket = 'CdM12_Pos_Category';
							wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
							csfilter = 'pcaktif=1';
							sort = 'pckode asc';
						}
						break;
					case 'txtcabang':
						if(txtcabang.enabled == true){
							paket = 'CdM1_Branch';
							wsfilter = 'baktif=1 and bkode ="'+txtcabang.text+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+o.bikontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.bikontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif=1 AND tnsumber="BI"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case 'kodebarang':
						if(cmbkriteria.selectedIndex == 0){
							if(cmbjeniskategori.selectedIndex == 0){
								paket = 'CdM1_Item';
								wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else if (cmbjeniskategori.selectedIndex == 1){
								if(txtkategoripos.text.length > 0){
									FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
									paket = 'CdM12_ItemCategoryPOS';
									wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
									csfilter = 'baktif=1';
									sort = 'bkode asc';
								}else{
									txtkategoripos.setFocus();
									Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
								}
							}else if (cmbjeniskategori.selectedIndex == 2){
								if(txtcabang.text.length > 0){
									paket = 'CdM1_Item';
									wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
									csfilter = 'baktif=1';
									sort = 'bkode asc';
								}else{
									txtcabang.setFocus();
									Alert.show("Cabang harus diisi terlebih dahulu", "Informasi");
								}
							}
						}else{
							if(cmbjeniskategori.selectedIndex == 0){
								paket = 'CdM1_Item';
								wsfilter = 'baktif=1 and bkode ="'+dg3.dataProvider.getItemAt(dg3.selectedCell.rowIndex).kodebarang+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else if (cmbjeniskategori.selectedIndex == 1){
								if(txtkategoripos.text.length > 0){
									FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
									paket = 'CdM12_ItemCategoryPOS';
									wsfilter = 'baktif=1 and bkode ="'+dg3.dataProvider.getItemAt(dg3.selectedCell.rowIndex).kodebarang+'"';
									csfilter = 'baktif=1';
									sort = 'bkode asc';
								}else{
									txtkategoripos.setFocus();
									Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
								}
							}else if (cmbjeniskategori.selectedIndex == 2){
								if(txtcabang.text.length > 0){
									paket = 'CdM1_Item';
									wsfilter = 'baktif=1 and bkode ="'+dg3.dataProvider.getItemAt(dg3.selectedCell.rowIndex).kodebarang+'"';
									csfilter = 'baktif=1';
									sort = 'bkode asc';
								}else{
									txtcabang.setFocus();
									Alert.show("Cabang harus diisi terlebih dahulu", "Informasi");
								}
							}
						}
						
						break;
					
					case 'kodebarang2':
						if(cmbkriteria.selectedIndex == 0){
							if(cmbjeniskategori.selectedIndex == 0){
								paket = 'CdM1_Item';
								wsfilter = 'baktif=1 and bkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kodebarang2+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else if (cmbjeniskategori.selectedIndex == 1){
								if(txtkategoripos.text.length > 0){
									FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
									paket = 'CdM12_ItemCategoryPOS';
									wsfilter = 'baktif=1 and bkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kodebarang2+'"';
									csfilter = 'baktif=1';
									sort = 'bkode asc';
								}else{
									txtkategoripos.setFocus();
									Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
								}
							}else if (cmbjeniskategori.selectedIndex == 2){
								if(txtcabang.text.length > 0){
									paket = 'CdM1_Item';
									wsfilter = 'baktif=1 and bkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kodebarang2+'"';
									csfilter = 'baktif=1';
									sort = 'bkode asc';
								}else{
									txtcabang.setFocus();
									Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
								}
							}	
						}else{
