			protected function f_keyDownModule(e:KeyboardEvent):void
			{		
				var jenissimpan:int = 1;
				switch(e.keyCode){
					case Keyboard.F1:
						if(mb.menuBarItems[0].enabled ==true){
							if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(12,8,jenissimpan)==true){
								u[0].sistatus = 2;
//								f_PoleDisplayBayar("Kembali", txtkembali.text);
								f_simpan();
							}
						}
						break;
					case Keyboard.F2:
						f_mbPending();
						break;
					case Keyboard.F3:
						f_mbBuka();
						break;
					case Keyboard.F4:
						f_kondisiAwal();
						FlexGlobals.topLevelApplication.FormFilter = '';
						f_defaultGrid()
						break;
					case Keyboard.F5:
						closeform();
						break;
					case Keyboard.F6:
						dg_pos.setFocus();
						txttunai.setFocus();
						break;
					case Keyboard.F8:
						FlexGlobals.topLevelApplication.openFormX(FlexGlobals.topLevelApplication.l("Input Kartu Kredit"), 1, "mod/m12/m12_KartuKreditPOS.swf", 400, 800)
