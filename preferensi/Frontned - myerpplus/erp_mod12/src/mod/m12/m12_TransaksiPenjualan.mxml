			public function f_dischargaterendah():void{
				var jml:Number = 0, hargatermurah : Number = 0, kodebarangdiskon : String = "", namabarangdiskon:String = "";
				var dgrid : Object, idxtermurah:int;
				for (var i:int = 0; i<dg_pos.dataProviderLength; i++){
					dgrid = dg_pos.dataProvider[i]
					if(dgrid.customdbl1 == 1){
						jml=jml+1;
						if(i==0){
							hargatermurah = dgrid.harga;
							idxtermurah = i
						}else{
							if(dgrid.harga <= hargatermurah){
								hargatermurah = dgrid.harga;
								idxtermurah = i
							}
						}
					}
					
				}
				if(jml >= jmlterendahdiskon){
					for (i = 0; i<dg_pos.dataProviderLength; i++){
						dgrid = dg_pos.dataProvider[i]
						
						if(i == idxtermurah){
							dgrid.diskon = nilaiterendahdiskon;
							kodebarangdiskon = dgrid.kodebarang;
							namabarangdiskon = dgrid.namabarang;
						}else{
							dgrid.diskon = 0;
						}
						
						dgrid.jmldiskon = parentApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
						dgrid.jmldiskonawal = dgrid.jmldiskon;
						dgrid.jmldiskonitem = dgrid.jmldiskon;
						dgrid.subtotal = Number(dgrid.jml) * Number(dgrid.harga) - Number(dgrid.jmldiskon); //hitung
					}
				}
				
				FlexGlobals.topLevelApplication.F_dgRefresh(dg_pos);
//				if(kodebarangdiskon.length > 0){
//					Alert.show("Barang "+kodebarangdiskon+" | "+namabarangdiskon+" mendapatkan diskon sebesar "+nilaiterendahdiskon+"%", "Informasi", 1, null, function(e:Object):void{	
//						if(e.detail == Alert.OK){
//							txttunai.setFocus();
//						}
//					})
//				}
				f_hitungTotalDetail();
				f_hitungTotalUtama();
				
				
			}
			public function f_periodepromo(tgl1:String, tgl2:String, tgltransaksi:String, jam1:String, jam2:String):Boolean{
				var arrtgl1:Array;
				//tgl1 = FlexGlobals.topLevelApplication.F_tglFormatDB(tgl1);
				if(tgl1 != null){
					arrtgl1 = tgl1.split("-");
				}
				
				var arrtgl2:Array;
				if(tgl1 != null){
					//tgl2 = FlexGlobals.topLevelApplication.F_tglFormatDB(tgl2);
					arrtgl2 = tgl2.split("-");
				}
				
			
				var arrtgltransaksi:Array;
				tgltransaksi = FlexGlobals.topLevelApplication.F_tglFormatDB(tgltransaksi);
				arrtgltransaksi = tgltransaksi.split("-");
				//var tanggal
				var time1:Date = new Date(Number(arrtgl1[0]), Number(arrtgl1[1])-1, Number(arrtgl1[2]));
				var time2:Date = new Date(Number(arrtgl2[0]), Number(arrtgl2[1])-1, Number(arrtgl2[2]));
				var timetransaksi:Date = new Date(Number(arrtgltransaksi[0]), Number(arrtgltransaksi[1])-1, Number(arrtgltransaksi[2]));
				var CurrentTime:Date = new Date();
				// variabel untuk split jam
				var arrjam1:Array;
				arrjam1 = jam1.split(":");
				var arrjam2:Array;
				arrjam2 = jam2.split(":");
				
				if(timetransaksi.time >= time1.time && timetransaksi.time <= time2.time){
					if(jam1 == "00:00:00" && jam1 == "00:00:00"){
						return true;
					}else{
						if(CurrentTime.hours >= arrjam1[0] && CurrentTime.hours <= arrjam2[0]){
							if(CurrentTime.minutes >= arrjam1[1] && CurrentTime.minutes <= arrjam2[1]){
								return true;
							}else{
								return false;
							}
						}else{
							return false;
						}
					}
					
				}else{
					return false;
				}
				
			}
			
