						break;
//					case Keyboard.F9:
//						FlexGlobals.topLevelApplication.openFormX(FlexGlobals.topLevelApplication.l("Input Voucher"), 1, "mod/m12/m12_VoucherPOS.swf")
//						break;
					case Keyboard.F11:
						dg_pos.setFocus();
						txtpoint1.setFocus();
						break;
					case Keyboard.F7:
//						Alert.show("Keyboard.F10");
//						if(no_ang.length == 0)
//						{
//							txtpelanggan.setFocus();
//							Alert.show("Isi pelanggan dulu dengan nomor anggota", "Informasi");
//						}
//						else
//						FlexGlobals.topLevelApplication.openFormX(FlexGlobals.topLevelApplication.l("Input Kartu Member"), 1, "mod/m12/m12_MemberCard.swf", 500, 600, "", no_ang+"|"+txtpelanggan.text+"|"+lblpelanggan.text+"|"+n.vtotal);
						FlexGlobals.topLevelApplication.openFormX(FlexGlobals.topLevelApplication.l("Angsuran/Cicilan"), 1, "mod/m12/m12_Angsuran.swf",470, 450)
