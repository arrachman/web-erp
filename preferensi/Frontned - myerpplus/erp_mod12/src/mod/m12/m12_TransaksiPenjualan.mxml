			public function f_filter(target:String):Array
			{
				var nama:String, paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg_pos.selectedCell != null)obj = dg_pos.dataProvider.getItemAt(dg_pos.selectedCell.rowIndex);
				switch(target){
					case 'txtpelanggan':
						nama = txtpelanggan.text;
						if(nama.split("^").length  > 1 && nama.split("?;").length > 1)
						{
							nama = nama.split("^")[3];
							no_ang = nama.split("?;")[1].split("=")[1];
							nama = nama.split("?;")[1].split("=")[1];
							
						}
						if(nama == FlexGlobals.topLevelApplication.getSetting(12, "company", "CustomerKode")){
							no_ang = "";
						}else{
							no_ang = nama;
						}
						
						paket = 'CdM12_Contact';
						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+nama.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="C")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					
					case 'txtjenispromo':
						paket = 'CdM12_Promo';
						wsfilter = 'aktif = 1 AND nama ="'+txtjenispromo.text.split('"').join('\\"')+'"';
						csfilter = 'aktif=1';
						csfield = 2;
						sort = 'kode asc';
						break;
					case 'txtadmin':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="M") AND kkode ="'+txtadmin.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					
					case 'txtcustomarea':
						paket = 'CdM12_Area';
						wsfilter = 'akode="'+txtcustomarea.text.split('"').join('\\"')+'"';
						csfilter = '';
						csfield = 2;
						sort = 'akode asc';
						break;
					
