			public function f_hitungTotalDetail():void
			{
				n.vtotal=0;
				n.vtotalpajak1=0;
				n.vtotalpajak2=0;
				n.vtotalitem=0;
				o.txtpajak = 0;
				for(var i:int=0;i<dg_pos.dataProvider.length;i++){
					if(dg_pos.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg_pos.dataProvider.getItemAt(i).subtotal);
					if(dg_pos.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.txtpajak += Number(dg_pos.dataProvider.getItemAt(i).jmlpajak1);
					if(dg_pos.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg_pos.dataProvider.getItemAt(i).jmlpajak2);
					if(dg_pos.dataProvider.getItemAt(i).jml != undefined)n.vtotalitem += Number(dg_pos.dataProvider.getItemAt(i).jml);
				}
				//set total
				
				lbltotal.text = parentApplication.m.nfNominalPOS.format(n.vtotal);
				txtpajak.text = parentApplication.m.nfNominalPOS.format(o.txtpajak);
				lbltotalitem.text = parentApplication.m.nfNominalPOS.format(n.vtotalitem);
				f_hitungTotalUtama();
			}
			
			public function f_hitungTotalUtama():void
