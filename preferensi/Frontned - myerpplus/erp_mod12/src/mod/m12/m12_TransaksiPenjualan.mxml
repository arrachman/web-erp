				//				}
				
				
				
				f_hitungpoin();
				
			}
			public function f_PoleDisplay():void{
				var namabarang :String = "", jml:String = "", harga:String = "";
				if(dg_pos.selectedCell != null){
					if(dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].namabarang != ""){
						namabarang = dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].namabarang;
						jml = dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].jml;
						harga = dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].harga;
						if(namabarang.length > 20){
							namabarang = namabarang.slice(0,19);
						}
						else if(namabarang.length < 20){
							var nbspace:String
							for(var nb:int = namabarang.length; nb<20; nb++){
								namabarang += " ";
								if(nb == 19){
									break;
								}
								
								
							}
						}
						if(jml.length < 8){
							for(var njml:int = jml.length; njml<8; njml++){
								jml += " ";
								if(njml == 7){
									break;
								}
							}
						}
						if(harga.length < 8){
							for(var nharga:int = harga.length; nharga<8; nharga++){
								harga += " ";
								if(nharga == 7){
									break;
								}
							}
						}
						
						cetak.poleDisplay(namabarang+" "+parentApplication.m.nfNominalPOS.format(jml)+" x "+parentApplication.m.nfNominalPOS.format(harga));
					}
				}
				
			}
			
			public function f_PoleDisplayBayar(Caption : String ="", Total : String = ""):void{
				var nspacetotal:String = "";
					if(Caption.length > 20){
						Caption = Caption.slice(0,19);
					}
					else if(Caption.length < 20){
						var nbspace:String
						for(var nb:int = Caption.length; nb<20; nb++){
							Caption += " ";
							if(nb == 19){
								break;
							}
							
							
						}
					}
					if(Total.length < 20){
						for(var ntotal:int = Total.length; ntotal<20; ntotal++){
							nspacetotal += " ";
							if((Number(Total.length) + Number(nspacetotal.length))  == 19){
								break;
							}
						}
					}
					cetak.poleDisplay(Caption+" "+nspacetotal+Total);
				
			}
			
