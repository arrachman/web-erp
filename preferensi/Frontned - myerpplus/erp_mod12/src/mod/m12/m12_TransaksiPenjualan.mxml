			public function f_PointItem(idbarang:int = 0, jmlbarang:int = 0, rowindex:int = 0):void{
				if(u.getItemAt(0).sicustomer == FlexGlobals.topLevelApplication.getSetting(12, "company", "Customer")){
					o.txtjmlpointsebelumnya = 0;
					txtjmlpointsebelumnya.text = parentApplication.m.nfNominalPOS.format(o.txtjmlpointsebelumnya);
					o.txtpointygdidapat = 0;
					txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
				}else{
					
					var idpoint:int = 0, jmlpengali:Number = 0;
					var kelipatan:Number = 0;
					arrPointItem.removeAll();
					for(var a:int = 0; a<FlexGlobals.topLevelApplication.m.ArrPos_Point_ItemSearch.length; a++){
						with(FlexGlobals.topLevelApplication.m.ArrPos_Point_ItemSearch[a]){
							if(idbarang == piidbarang){
								arrPointItem.addItem({operator:pioperator, jml1:pijml1, jml2:pijml2, jmlpoin:pijmlpoint, tgl1: pitgl1, tgl2: pitgl2});
							}
							
						}
						
					}
					for(var b:int = 0; b<arrPointItem.length; b++){
						
						with(arrPointItem[b]){
							if(f_periodepromo(tgl1, tgl2, dttanggal.text, "00:00:00", "00:00:00") == true){
								if(operator == 0){
									
									//Alert.show(jmlbarang+">="+jml1+" && "+jmlbarang+"<="+jml2+"  "+jmlpoin)
									if(jmlbarang >= jml1 && jmlbarang <= jml2){
										dg_pos.dataProvider[rowindex].jmlpoin = jmlpoin;
										break;
									}
								}else if(operator == 1){
									if(jmlbarang >= jml1){
										dg_pos.dataProvider[rowindex].jmlpoin = jmlpoin;
										break;
									}
								}
								else if(operator == 2){//operator kelipatan
									kelipatan = Math.floor(Number(jmlbarang)/Number(jml1));//
									if(kelipatan > 0){
										dg_pos.dataProvider[rowindex].jmlpoin = Number(jmlpoin) * Number(kelipatan);
										break;
									}
								}
							}
						}
					}
				}
				if(FlexGlobals.topLevelApplication.getSettingPOS(0,"app","PointKategoriBarang") == 0){
					f_hitungpoin();
				}else{
					f_PointItemCategory(dg_pos.dataProvider[rowindex].kategoribarang, jmlbarang, rowindex);
				}
			}
			public function f_PointItemCategory(kategoribarang:String, jmlbarang:int = 0, rowindex:int = 0):void{
				if(u.getItemAt(0).sicustomer == FlexGlobals.topLevelApplication.getSetting(12, "company", "Customer")){
					o.txtjmlpointsebelumnya = 0;
					txtjmlpointsebelumnya.text = parentApplication.m.nfNominalPOS.format(o.txtjmlpointsebelumnya);
					o.txtpointygdidapat = 0;
					txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
				}else{
					var idpoint:int = 0, jmlpengali:Number = 0;
					var kelipatan:Number = 0;
					arrPointItemCategory.removeAll();
					for(var a:int = 0; a<FlexGlobals.topLevelApplication.m.ArrPos_Point_Category_ItemSearch.length; a++){
						with(FlexGlobals.topLevelApplication.m.ArrPos_Point_Category_ItemSearch[a]){
							if(kategoribarang == pcikategoribarang){
								arrPointItemCategory.addItem({operator:pcioperator, jml1:pcijml1, jml2:pcijml2, jmlpoin:pcijmlpoint});
							}
							
						}
						
					}
					for(var b:int = 0; b<arrPointItemCategory.length; b++){
						
						with(arrPointItemCategory[b]){
							if(operator == 0){
								//Alert.show(jmlbarang+">="+jml1+" && "+jmlbarang+"<="+jml2+"  "+jmlpoin)
								if(jmlbarang >= jml1 && jmlbarang <= jml2){
									dg_pos.dataProvider[rowindex].jmlpoin = Number(dg_pos.dataProvider[rowindex].jmlpoin) + Number(jmlpoin);
									break;
								}
							}else if(operator == 1){
								if(jmlbarang >= jml1){
									dg_pos.dataProvider[rowindex].jmlpoin = Number(dg_pos.dataProvider[rowindex].jmlpoin) + Number(jmlpoin);
									break;
								}
							}
							else if(operator == 2){//operator kelipatan
								kelipatan = Math.floor(Number(jmlbarang)/Number(jml1));//
								if(kelipatan > 0){
									dg_pos.dataProvider[rowindex].jmlpoin = Number(dg_pos.dataProvider[rowindex].jmlpoin) + (Number(jmlpoin) * Number(kelipatan));
									break;
								}
								
								
							}
						}
					}
					
					f_hitungpoin();
				}
			}
			
			public function f_PointTransaction():void{
				if(u.getItemAt(0).sicustomer == FlexGlobals.topLevelApplication.getSetting(12, "company", "Customer")){
					o.txtjmlpointsebelumnya = 0;
					txtjmlpointsebelumnya.text = parentApplication.m.nfNominalPOS.format(o.txtjmlpointsebelumnya);
					
					o.txtpointygdidapat = 0;
					txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
				}else{
					var idpoint:int = 0, jmlpengali:Number = 0;
					var kelipatan:Number = 0;
					o.txtpointygdidapat = 0;
					arrPointTransaction.removeAll();
					for(var a:int = 0; a<FlexGlobals.topLevelApplication.m.ArrPos_Point_TransactionSearch.length; a++){
						with(FlexGlobals.topLevelApplication.m.ArrPos_Point_TransactionSearch[a]){
							arrPointTransaction.addItem({operator:ptoperator, jml1:ptjml1, jml2:ptjml2, nilai:ptjmlpoint});
						}
						
					}
					
					for(var b:int = 0; b<arrPointTransaction.length; b++){
						with(arrPointTransaction[b]){
							if(operator == 0){
								if(o.txttotaltransaksi >= jml1 && o.txttotaltransaksi <= jml2){
									o.txtpointygdidapat = nilai;
									txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
									break;
								}else{
									o.txtpointygdidapat = 0;
									txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
								}
							}else if(operator == 1){
								if(o.txttotaltransaksi >= jml1){
									o.txtpointygdidapat = nilai;
									txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
									break;
								}
								else{
									o.txtpointygdidapat = 0;
									txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
								}
							}
							else if(operator == 2){//operator kelipatan
								kelipatan = Math.floor(Number(o.txttotaltransaksi)/Number(jml1));//
								
								if(kelipatan > 0){
									o.txtpointygdidapat = Number(nilai) * Number(kelipatan);
									txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
									break;
								}
								else{
									o.txtpointygdidapat = 0;
									txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
								}
							}
						}
					}
				}
				
			}
			public function f_hitungpoin():void{
				
				if(FlexGlobals.topLevelApplication.getSettingPOS(0, 'app', "Point") == 2){
					f_PointTransaction();
				}else if(FlexGlobals.topLevelApplication.getSettingPOS(0, 'app', "Point") == 1){
					
					totalpoint = 0;
					for(var m:int; m<dg_pos.dataProviderLength; m++){
						if(dg_pos.dataProvider[m].jmlpoin > 0){
							totalpoint += Number(dg_pos.dataProvider[m].jmlpoin)
						}
						
					}
					o.txtpointygdidapat = totalpoint;
					txtpointygdidapat.text = parentApplication.m.nfNominalPOS.format(o.txtpointygdidapat);
				}
				
				if(o.txtjmlpointsebelumnya == 0 && o.txtpointygdidapat == 0){
					txtpoint1.editable = false;
				}else{
					txtpoint1.editable = true;
				}
			}
