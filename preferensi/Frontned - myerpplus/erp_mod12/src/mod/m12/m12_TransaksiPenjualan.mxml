				//setting charge nominal
				if(Number(o.txtkartudebit) > 0 || Number(o.txtkartukredit) > 0){
					o.txtchargenominal = ((Number(o.txtchargepersen) / 100) * Number(o.txtkartudebit)) + ((Number(o.txtchargepersen) / 100) * Number(o.txtkartukredit));
				}
				else{o.txtchargenominal = 0}
