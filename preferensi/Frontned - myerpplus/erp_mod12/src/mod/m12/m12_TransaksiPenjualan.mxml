			public function F_insertDG(dg:DataGrid, row:int, skip:Array):void
			{
				FlexGlobals.topLevelApplication.F_acAdd(dg, row);
				for(var vins:int=row+1; vins<dg.dataProviderLength; vins++){
					dg.dataProvider.getItemAt(vins).no = (vins+1);
					FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, vins)
				}
				F_autoScrolling(dg, 0);
				focusFirst(row, skip);
			}			
			
			public function focusFirst(row:int, skip:Array):void
			{
				for(var viFF:int=0; viFF<dg_pos.columnsLength; viFF++){
					if(skip[viFF] == 0){
						dg_pos.setSelectedCell(row, viFF);
						break;
					}
				}
			}
			
			public function F_autoScrolling(dg:DataGrid, w:int):void
			{	
				var n:int=dg.scroller.horizontalScrollBar.maximum, i:int;
				if(w > 0){
					for(i=0;i<w;i++){
						if(dg.columns.getItemAt(i).visible == true){
							n -= dg.columns.getItemAt(i).width;
							if(n < 0){
								n=dg.scroller.horizontalScrollBar.maximum
								for(i=dg.columnsLength-1;i>w;i--)
									if(dg.columns.getItemAt(i).visible == true)
										n -= dg.columns.getItemAt(i).width;
								dg.scroller.horizontalScrollBar.value = n;
								return;
							}
						} 
					}
					n=dg.scroller.horizontalScrollBar.maximum
					for(i=dg.columnsLength-1;i>w;i--)
						if(dg.columns.getItemAt(i).visible == true)
							n -= dg.columns.getItemAt(i).width;
					dg.scroller.horizontalScrollBar.value = n;
				}else
					dg.scroller.horizontalScrollBar.value = 0;
			}
			
