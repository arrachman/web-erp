					var idbonus:int = 0, jmlpengali:Number = 0;
					var kelipatan:Number = 0;
					
					arrBonus.removeAll();
					for(var a:int = 0; a<FlexGlobals.topLevelApplication.m.ArrPos_Bonus_ItemSearch.length; a++){
						with(FlexGlobals.topLevelApplication.m.ArrPos_Bonus_ItemSearch[a]){
							if(idbarang == biidbarang){
								arrBonus.addItem({biid:biid, operator:bioperator, jml1:bijml1, jml2:bijml2, tgl1:bitgl1, tgl2:bitgl2});
							}
						}
						
					}
					for(var b:int = 0; b<arrBonus.length; b++){
						with(arrBonus[b]){
							if(f_periodepromo(tgl1, tgl2, dttanggal.text, "00:00:00", "00:00:00") == true){
								if(operator == 0){
									if(jmlbarang >= jml1 && jmlbarang <= jml2){
