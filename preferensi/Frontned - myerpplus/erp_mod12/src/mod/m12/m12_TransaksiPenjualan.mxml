			protected function dg_pos_keyDownHandler(event:KeyboardEvent):void
			{
				// TODO Auto-generated method stub
				if(event.keyCode == Keyboard.LEFT){
					if(dg_pos.selectedCell.columnIndex == 0 && dg_pos.selectedCell.rowIndex > 0){
						
						dg_pos.setSelectedCell(dg_pos.selectedCell.rowIndex - 1, 5);
					}
				}
			}
			
			protected function chkhargapajak_changeHandler(event:Event):void
			{
				// TODO Auto-generated method stub
				for(var Index:int = 0; Index<dg_pos.dataProviderLength; Index++){
					var dgrid:Object;
					dgrid = dg_pos.dataProvider[Index];
					if(dgrid.nilaipajak1 == undefined)dgrid.nilaipajak1 = 0;
					if(dgrid.subtotal == undefined)dgrid.subtotal = 0;
					if(dgrid.nilaipajak2 == undefined)dgrid.nilaipajak2 = 0;
					
					
					if(chkhargapajak.selected == true){
						dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					}else{
						dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					}
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg_pos);
				f_hitungTotalDetail();
				
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				//cetak.cetak(txtpelanggan.text+"-"+lblpelanggan.text, dg_pos, o.txtjmlbayar, o.txtdiskonnilai, u[0].sinotransaksi, o.txtkartukredit, o.txtkartudebit, o.txttotaltransaksi, "1", Kupon, SHU, Sukarela, noKdebit, noKkredit, SaldoSukarela, o.txttunai);
			}
			public function f_promo(kategoribarang:String = "", jmlbarang:Number = 0, rowindex:int = 0):void{
				if(singlepromo == true){
					switch(jenispromo){
						case 0:
							f_BBonus(dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].idbarang, jmlbarang, dg_pos.selectedCell.rowIndex);
							break;
						case 1:
							f_DiskonItemCategory(kategoribarang, jmlbarang, dg_pos.selectedCell.rowIndex);
							break;
					}
				}else{
					f_DiskonItemCategory(kategoribarang, jmlbarang, dg_pos.selectedCell.rowIndex);
					f_BPengganti(dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].idbarang, jmlbarang, dg_pos.selectedCell.rowIndex, dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].bstok);
					f_BBonus(dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].idbarang, jmlbarang, dg_pos.selectedCell.rowIndex);
					f_BTambahan(dg_pos.dataProvider[dg_pos.selectedCell.rowIndex].idbarang, jmlbarang, dg_pos.selectedCell.rowIndex);
				}
				
				
			}
		]]>
