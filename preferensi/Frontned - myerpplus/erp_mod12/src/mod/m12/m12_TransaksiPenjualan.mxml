					var idtambahan:int = 0, jmlpengali:Number = 0;
					var kelipatan:Number = 0;
					arrAddtitional.removeAll();
					for(var a:int = 0; a<FlexGlobals.topLevelApplication.m.ArrPos_Additional_ItemSearch.length; a++){
						with(FlexGlobals.topLevelApplication.m.ArrPos_Additional_ItemSearch[a]){
							if(idbarang == aiidbarang){
								arrAddtitional.addItem({aiid:aiid, operator:aioperator, jml1:aijml1, jml2:aijml2, tgl1:aitgl1, tgl2:aitgl2});
							}
						}
						
					}
					for(var b:int = 0; b<arrAddtitional.length; b++){
						with(arrAddtitional[b]){
							if(f_periodepromo(tgl1, tgl2, dttanggal.text, "00:00:00", "00:00:00") == true){
								if(operator == 0){
									if(jmlbarang >= jml1 && jmlbarang <= jml2){
										idtambahan = aiid;
										jmlpengali = 1;
										break;
									}
								}else if(operator == 1){
									if(jmlbarang >= jml1){
										idtambahan = aiid;
										jmlpengali = 1;
										break;
									}
								}
								else if(operator == 2){//operator kelipatan
									kelipatan = Math.floor(Number(jmlbarang)/Number(jml1));//engko ae
									
									if(kelipatan > 0){
										idtambahan = aiid;
										jmlpengali = kelipatan;
										break;
									}
									
									
								}
							}
							
						}
					}
					if(idtambahan > 0 && jmlpengali > 0){
						//F_insertDG(dg_pos, rowindex, []);
						FlexGlobals.topLevelApplication.openFormX("Barang Tambahan", 1,"mod/m12/m12_BarangTambahanTransaksi.swf", 400, 600, "t1", String(idtambahan), [jmlpengali, ktingkatjual]);
					}
				}
			}
			
