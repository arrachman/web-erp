			public function f_validasi():void{
				f_focusOnMe();
				if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.hasOwnProperty('dg'))
					dg = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.dg;
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					cmbjeniskategori.enabled = false;
					twajibcabang.visible = false;
					txtcabang.enabled = false;
					txtkategoripos.text = dg.dataProvider[dg.selectedCell.rowIndex].dcckategori;
					FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
					lblkategoripos.text = dg.dataProvider[dg.selectedCell.rowIndex].pcnama;
					txtkategoricustomer.text = dg.dataProvider[dg.selectedCell.rowIndex].dcckategoricustomer;
					o.kbarang = txtkategoricustomer.text;
					lblkategoricustomer.text = dg.dataProvider[dg.selectedCell.rowIndex].ccnama;
					isUpdate = true;
					FlexGlobals.topLevelApplication.F_wsSearch("tampil","M12_Pos_Discount_Category_CustomerSearch",0,0,"dcckategori = '"+txtkategoripos.text+"' AND dcckategoricustomer = '"+txtkategoricustomer.text+"'","dcckategori asc, dccoperator asc, dccjml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
				}
			}
			protected function f_kondisiAwal():void
			{
				cmbjeniskategori.selectedIndex = 1;
				twajibkatpos.enabled = true;
				txtcabang.enabled = false;
				lblcabang.enabled =  false;
				twajibcabang.visible = false;
				isUpdate = false;
				txtkategoripos.setFocus();
				txtkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.txtkategoripos.text;
				FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
				lblkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.lblkategoripos.text;
				o.kbarang = "";
				//set utama
				f_setdefaultdata();
				
				
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid:Object
				switch (components){
					case  'calculator':
						dginput.dataProvider[dginput.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dginput, dginput.selectedCell.rowIndex);
						if(Number(data) > 0){
							
						}
						break;
					case 'comboBox':
						if(dataField == "dccoperator"){
							if(data !=0){
								dginput.dataProvider[dginput.selectedCell.rowIndex].dccjml2 = 0;
							}
							
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'dcckriteria'){
							return new ArrayCollection([{l:'Discount Percent', v:1}, {l:'Discount Nominal', v:2}]);
						}
						if(dataField == 'dccoperator'){
							return new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
						}
				}
				return new ArrayCollection([]);
			}
			public function f_setdefaultdata():void{
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dccoperator = 1;
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dccjml1 = 1; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dccjml2 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcckriteria = 1; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dccnilai = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcctgl1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcctgl2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dccjam1 = "00:00:00"; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dccjam2 = "00:00:00"; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomtext1 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomtext2 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomtext3 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomtext4 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomtext5 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomint1 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomint2 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomint3 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomdbl1 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomdbl2 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomdbl3 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcccabang = FlexGlobals.topLevelApplication.ucabang;
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dccjeniskategori = 0;
