			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if(column == 'add' || o.a[0] == 'add'){
					f_setdefaultdata();
				}
				switch(column){
					
					case 'dccjml2':
						with(dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex)){
							if(dccoperator != 0){
								dccjml2 = 0;
							}
						}
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dginput);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos': //kategoripos
						if(txtkategoripos.enabled == true){
							paket = 'CdM12_Pos_Category';
							wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
							csfilter = 'pcaktif=1';
							sort = 'pckode asc';
						}
						break;
					case 'txtcabang': //kategoripos
						if(txtcabang.enabled == true){
							paket = 'CdM1_Branch';
							wsfilter = 'baktif=1 and bkode ="'+txtkategoripos.text+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}
						break;
					case 'txtkategoricustomer': //kode barang
						paket = 'CdM1_Customer_Category';
						wsfilter = 'ccaktif=1 and cckode ="'+txtkategoricustomer.text+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case 'kategoricustomer': //kode barang detail
						paket = 'CdM1_Item';
						wsfilter = 'baktif=1 and bkode ="'+dginput.dataProvider.getItemAt(parentApplication.rowIndex).kategoricustomer+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break;
					case "satuan": //satuan
						paket = "CdM1_Unit";
						wsfilter = 'uaktif=1 AND ukode ="'+dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex).satuan+'"';
						csfilter = 'uaktif=1';
						csfield = 2;
						sort = 'ukode asc';
						break
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'txtkategoripos':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							
							if(o.kategorikode != ws.pckode && txtkategoripos.text.length > 0 && (txtkategoricustomer.text.length > 0  || dginput.dataProvider[0].dccjml1 > 0)){
								Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
									if(e.detail == Alert.YES){
										txtkategoripos.text = ws.pckode;
										FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
										lblkategoripos.text = ws.pcnama;
										o.kategorikode = ws.pckode;
										FlexGlobals.topLevelApplication.F_KosongkanText([txtkategoricustomer, lblkategoricustomer]);
										FlexGlobals.topLevelApplication.F_defaultGridItem(dginput);
									}else{
										txtkategoripos.text = o.kategorikode;
										parentApplication.vpVarCurrent = txtkategoripos.text;
										lblkategoripos.text = o.kategorinama;
									}
								});
							}else{
								txtkategoripos.text = ws.pckode;
								lblkategoripos.text = ws.pcnama;
								o.kategorikode = ws.pckode;
								o.kategorinama = ws.pcnama;
							}
							break;
						case 'txtcabang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							
							if(txtcabang.text.length > 0 && (txtkategoricustomer.text.length > 0  || dginput.dataProvider[0].dccjml1 > 0)){
								Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
									if(e.detail == Alert.YES){
										txtcabang.text = ws.bkode;
										FlexGlobals.topLevelApplication.vpVarCurrent = txtcabang.text;
										lblcabang.text = ws.bnama;
										FlexGlobals.topLevelApplication.F_KosongkanText([txtkategoricustomer, lblkategoricustomer]);
										FlexGlobals.topLevelApplication.F_defaultGridItem(dginput);
									}else{
										txtcabang.text = o.kategorikode;
										parentApplication.vpVarCurrent = txtcabang.text;
										lblcabang.text = o.kategorinama;
									}
								});
							}else{
								txtcabang.text = ws.bkode;
								lblcabang.text = ws.bnama;
								o.cabangkode = ws.bkode;
								o.cabangnama= ws.bnama;
							}
							break;
						case 'txtkategoricustomer': //kode barang
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkategoricustomer.text = ws.cckode;
							lblkategoricustomer.text = ws.ccnama;
							//o.diidbarang = ws.bid;
							//							if(o.kbarang != ''){
							//								Alert.show('Data akan dihapus, lanjutkan?', 'Confirmation', 3, null, function(e:Object):void{	
							//									if(e.detail == Alert.YES){
							//										FlexGlobals.topLevelApplication.F_wsSearch("tampil","M12_Pos_Discount_Category_ItemSearch",0,0,"dcckategori = '"+txtkategoripos.text+"' AND dcckategoricustomer = '"+txtkategoricustomer.text+"'","",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							//									}
							//								});
							//							}
							if(cmbjeniskategori.selectedIndex == 1){
								//FlexGlobals.topLevelApplication.F_wsSearch("tampil","M12_Pos_Discount_Category_CustomerSearch",0,0,"dcckategori = '"+txtkategoripos.text+"' AND dcckategoricustomer = '"+txtkategoricustomer.text+"'","dcckategori asc, dccoperator asc, dccjml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));	
							}else if(cmbjeniskategori.selectedIndex == 2){
								//FlexGlobals.topLevelApplication.F_wsSearch("tampil","M12_Pos_Discount_Category_CustomerSearch",0,0,"dcckategoricustomer = '"+txtkategoricustomer.text+"'","dcckategori asc, dccoperator asc, dccjml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}
							o.kbarang = txtkategoricustomer.text;
							break;
						case 'tampil':
							
							dginput.dataProvider.removeAll();
							for(i = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(i)){
									dginput.dataProvider.addItem({no:i+1,
										dcckategori:dcckategori, dcckategoricustomer:dcckategoricustomer, dccoperator:dccoperator, 
										dccjml1:dccjml1, dccjml2:dccjml2, dcckriteria:dcckriteria, 
										dccnilai:dccnilai, dcctgl1:dcctgl1, dcctgl2:dcctgl2, dccjam1:dccjam1, dccjam2:dccjam2, dcccustomtext1:dcccustomtext1, 
										dcccustomtext2:dcccustomtext2, dcccustomtext3:dcccustomtext3, 
										dcccustomtext4:dcccustomtext4, dcccustomtext5:dcccustomtext5, dcccustomint1:dcccustomint1, 
										dcccustomint2:dcccustomint2, dcccustomint3:dcccustomint3, dcccustomdbl1:dcccustomdbl1, dcccustomdbl2:dcccustomdbl2, 
										dcccustomdbl3:dcccustomdbl3, dcccustomdate1:dcccustomdate1, dcccustomdate2:dcccustomdate2, 
										dcccustomdate3:dcccustomdate3});
								}
							}
							
							break;
						
						
						
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
							case 'tampil':
								FlexGlobals.topLevelApplication.F_defaultGridItem(dginput)
								break;
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkategoripos':parentApplication.F_KosongkanText([txtkategoripos, lblkategoripos]);break;
					case 'txtcabang':parentApplication.F_KosongkanText([txtcabang, lblcabang]);break;
					case 'txtkategoricustomer':
						parentApplication.F_KosongkanText([txtkategoricustomer, lblkategoricustomer]);
						o.kbarang = txtkategoricustomer.text;
						dg.dataProvider = new ArrayCollection;
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
						break;
					case 'tampil':
						FlexGlobals.topLevelApplication.F_defaultGridItem(dginput)
						break;
				}
			}
			
			protected function f_simpan():void
			{
				//				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, 
				var	a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
						// Set Utama
						// Set Detail
						for(i=0;i<dginput.dataProviderLength;i++)
							with(dginput.dataProvider.getItemAt(i)){
								a = [txtkategoripos.text, txtkategoricustomer.text, dccoperator, dccjml1, dccjml2, dcckriteria, dccnilai, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(dcctgl1), FlexGlobals.topLevelApplication.F_tglFormatDB(dcctgl2), dccjam1, dccjam2, dcccustomtext1, dcccustomtext2, dcccustomtext3, 
									dcccustomtext4, dcccustomtext5, dcccustomint1, dcccustomint2, dcccustomint3, dcccustomdbl1, dcccustomdbl2, 
									dcccustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(dcccustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(dcccustomdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(dcccustomdate3), o.cabangkode, cmbjeniskategori.selectedItem.v];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_Pos_Discount_Category_CustomerSimpan", parentApplication.userid, isUpdate, detail, "",1,20,p.f_filterdata(),p.arr[1]);
						
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = ""; 
					pesanAlertIng = '';
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dginput);
					if(cmbjeniskategori.selectedIndex == 1 && txtkategoripos.text.length <= 0){
						FlexGlobals.topLevelApplication.msgAlert(txtkategoripos,'Kategori POS');
					}else if(cmbjeniskategori.selectedIndex == 2 && txtcabang.text.length <= 0){
							FlexGlobals.topLevelApplication.msgAlert(txtcabang,'Cabang');
					}else if(txtkategoricustomer.text.length <= 0){
						FlexGlobals.topLevelApplication.msgAlert(txtkategoricustomer,'Kategori Customer');
					}
					for(i=0; i<dginput.dataProviderLength; i++){
						if(dginput.dataProvider.getItemAt(i).dijml1 == 0)FlexGlobals.topLevelApplication.msgAlert(dginput,'Jml 1');
					}
					
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
					f_hitungTotal();
					
					
				}
			}
			
