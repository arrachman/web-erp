			protected function cmbjeniskategori_closeHandler(event:DropDownEvent):void
			{
				if(cmbjeniskategori.selectedIndex == 0){
					txtkategoripos.text = ''; 
					twajibkatpos.visible = false; 
					txtkategoripos.enabled = false; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = false; 
					txtcabang.enabled = false; 
					lblcabang.text = '';
				}else if(cmbjeniskategori.selectedIndex == 1){
					txtkategoripos.text = ''; 
					twajibkatpos.visible = true; 
					txtkategoripos.enabled = true; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = false; 
					txtcabang.enabled = false; 
					lblcabang.text = '';
				}else{
					txtkategoripos.text = ''; 
					twajibkatpos.visible = false; 
					txtkategoripos.enabled = false; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = true; 
					txtcabang.enabled = true; 
					lblcabang.text = '';
				}
			}
			
			
		]]>
