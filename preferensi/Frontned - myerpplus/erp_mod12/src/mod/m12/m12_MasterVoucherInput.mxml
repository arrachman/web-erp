			public function f_kondisi_awal():void
			{
				
				txtkategoripos.text = FlexGlobals.topLevelApplication.m.ArrSettingPOS[0].pcskategori;
				lblkategoripos.text = FlexGlobals.topLevelApplication.m.ArrSettingPOS[0].pcnama;
