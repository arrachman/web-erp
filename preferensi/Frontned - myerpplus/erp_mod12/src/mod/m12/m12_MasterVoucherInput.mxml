			{
				var i:int, n:Number, a:Array, dgrid:Object;
				switch(column){ 
					case 'vikode':
						dgrid = dg2.dataProvider[dg2.selectedCell.rowIndex];
						dgrid.viid = 0; 
						dgrid.vikategori = txtkategoripos.text; 
						dgrid.vicabang = txtcabang.text; 
						dgrid.vilokasi = txtlokasi.text; 
						dgrid.vimatauang = UFungsional;
						dgrid.vijml = 0; 
						dgrid.vijmlvalas = 0; 
						dgrid.vijmlbayar = 0;
						dgrid.vijmlbayarvalas = 0;
						dgrid.vitgllunas = FlexGlobals.topLevelApplication.m.DateFirst; 
						dgrid.viisclose = 0; 
						dgrid.vicustomtext1 = ""; 
						dgrid.vicustomtext2 = ""; 
						dgrid.vicustomtext3 = ""; 
						dgrid.vicustomdbl1 = 0;
						dgrid.vicustomdbl2 = 0; 
						dgrid.vicustomdbl3 = 0; 
						dgrid.vicustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
						dgrid.vicustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst;
						dgrid.vicustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst; 
