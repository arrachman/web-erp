			public function f_simpan():void{
				var arr:Array, utama:String;
				o.validasi = true;
				for(var i:int=0;i<dg2.dataProviderLength;i++){
					with(dg2.dataProvider.getItemAt(i)){
						if(vijml == 0){
							o.validasi = false;
							break;
						}
						a = [viid, vikategori, vicabang, vilokasi, vikode, vimatauang, vijml, 
							vijmlvalas, vijmlbayar, vijmlbayarvalas, vitgllunas, viisclose, vicustomtext1, txturaian.text, 
							vicustomtext3, idcustomer, vicustomdbl2, vicustomdbl3, 
							FlexGlobals.topLevelApplication.F_tglFormatDB(vicustomdate1), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(vicustomdate2), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(vicustomdate3), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(vitglbuat), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(vitglexpired)];
						if(i == 0){
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							filtercetak = dg2.dataProvider.getItemAt(i).vikode
						}
						else {
							utama += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							filtercetak += ","+dg2.dataProvider.getItemAt(i).vikode
						}
						
						
					}
				}
					
				if(o.validasi == true){
					FlexGlobals.topLevelApplication.F_wsSimpan("simpan_baru", "M12_Pos_VoucherSimpan", parentApplication.userid, isUpdate, utama, "",1,20,p.m[p.idmodcurr].child.f_filterdata(),p.m[p.idmodcurr].child.arr[1]);
					
				}else{
					Alert.show("Jumlah tidak boleh 0", "Informasi");
				}
				
				
			}
			
			
