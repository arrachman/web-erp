						FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
						FlexGlobals.topLevelApplication.F_wsSearch("getkodeacak", "M12_Pos_VoucherCode",1,2,6,"", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos': //no rek
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
						csfilter = 'pcaktif=1';
						sort = 'pckode asc';
						break;
					case 'txtcustomer': //no rek
						paket = 'CdM12_Contact';
						wsfilter = 'kaktif=1 AND kkode ="'+txtcustomer.text+'"';
						csfilter = 'kaktif=1';
						sort = 'kkode asc';
						break;
					case 'txtcabang': //no rek
						paket = 'CdM1_Branch';
						wsfilter = 'baktif=1 AND bkode = "'+txtcabang.text+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break;
					case 'txtlokasi': //no rek
						if(txtcabang.text.length > 0){
							paket = 'CdM1_Location';
							wsfilter = 'laktif=1 AND lcabang = "'+txtcabang.text+'" AND lkode = "'+txtlokasi.text+'"';
							csfilter = 'laktif=1 AND lcabang = "'+txtcabang.text+'"';
							sort = 'lkode asc';
						}else{
							Alert.show("Cabang harus diisi terlebih dahulu", "informasi")
						}
						
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void{
				var ws:Object, s:String = parentApplication.subject;
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'getkodeacak':
							dg2.dataProvider[dg2.selectedCell.rowIndex].vicustomtext1 = parentApplication.wsArrUtama.getItemAt(0).kode
							FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
							break
						case 'GenerateKodeAcak':
							for (var i:int = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								dg2.dataProvider[i].vicustomtext1 = parentApplication.wsArrUtama.getItemAt(i).kode
							}
							
							FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
							break
						
						case 'txtkategoripos':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkategoripos.text = ws.pckode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
							lblkategoripos.text = ws.pcnama;
							break;
						
						case 'txtcustomer':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							idcustomer = ws.kid;
							txtcustomer.text = ws.kkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtcustomer.text;
							lblcustomer.text = ws.knama;
							break
						case 'txtcabang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcabang.text = ws.bkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtcabang.text;
							lblcabang.text = ws.bnama;
							txtlokasi.text = "";
							lbllokasi.text = "";
							break
						case 'txtlokasi':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtlokasi.text = ws.lkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = ws.lkode;
							lbllokasi.text = ws.lnama;
							break
						case 'txtmatauang':
							break;
						case 'txtcatatan':
							break;
						case 'noakun':
							break;
						case 'bank':
							break;
						case 'catatan':
							break;
						case 'status':
							break;
						case 'tampil':
							break;
						case 'tampilHistory':
							break;
						case 'tampilGiro':
							break;
						case 'simpan_baru':
							//FlexGlobals.topLevelApplication.closeFormPopUp(1);
							
							FlexGlobals.topLevelApplication.F_alertCetak(12,6,'VI', FlexGlobals.topLevelApplication.wsArrUtama[0].viid, FlexGlobals.topLevelApplication.wsErrmessage, o.tanggal+" s.d "+o.tanggal);
							f_kondisi_awal()
							break;
						
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'noakun':
								break;
							case 'bank':
								break;
							case 'catatan':
								break;
							case 'tampilGiro':
								break;
							case 'tampil':
							
								break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkategoripos':
						txtkategoripos.text = "";
						lblkategoripos.text = "";
						break
					case 'txtcabang':
						txtcabang.text = "";
						lblcabang.text = "";
						break
					case 'txtlokasi':
						txtlokasi.text = "";
						lbllokasi.text = "";
				}
			}
			protected function btngenerate_clickHandler(event:MouseEvent):void
			{
				if(txtkategoripos.text.length > 0 || txtcabang.text.length || txtlokasi.text.length){
					if(dg2.dataProvider[0].vikode != ""){
						Alert.show(FlexGlobals.topLevelApplication.l('Data akan ditimpa, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
							if(e.detail == Alert.YES){
								dg2.dataProvider.removeAll();
								//Generate no voucher dan jumlah
								var formatserial : String = '', noawalserial:int = 0, ambildigit:String = '', dgrid:Object;
								for(var ss:int= 0; ss<Number(txtformat.text); ss++){
									ambildigit+="0";
								}
								for(i=0; i<int(txtjmlvoucher.text); i++){
									noawalserial = int(txtnoawal.text)+i;
									if(Number(txtformat.text) - String(noawalserial).length < 0){
										formatserial = '';
									}else{
										if(txtnoawal.text.length>0){
											formatserial = ambildigit.substr(0, ambildigit.length - String(noawalserial).length);
										}else{
											formatserial = '';
										}
									}
									
									if(txtnoawal.text.length <= 0){
										dg2.dataProvider.addItem({no:i+1, viid:0, vikategori:txtkategoripos.text, 
											vicabang:txtcabang.text, vilokasi:txtlokasi.text, vikode:txtawalan.text+formatserial, 
											vimatauang:UFungsional, vijml:o.txtjml, 
											vijmlvalas:0, vijmlbayar:0, vijmlbayarvalas:0, vitgllunas:FlexGlobals.topLevelApplication.m.DateFirst,
											viisclose:0, vicustomtext1:"", vicustomtext2:"", 
											vicustomtext3:"", vicustomdbl1:0, vicustomdbl2:0, vicustomdbl3:0, 
											vicustomdate1:FlexGlobals.topLevelApplication.m.DateFirst, 
											vicustomdate2:FlexGlobals.topLevelApplication.m.DateFirst, 
											vicustomdate3:FlexGlobals.topLevelApplication.m.DateFirst, 
											vitglbuat:dttgldibuat.text, 
											vitglexpired:dttglexpired.text});
									}else{
										dg2.dataProvider.addItem({no:i+1,viid:0, vikategori:txtkategoripos.text, 
											vicabang:txtcabang.text, vilokasi:txtlokasi.text, vikode:txtawalan.text+formatserial+noawalserial, 
											vimatauang:UFungsional, vijml:o.txtjml, 
											vijmlvalas:0, vijmlbayar:0, vijmlbayarvalas:0, vitgllunas:FlexGlobals.topLevelApplication.m.DateFirst,
											viisclose:0, vicustomtext1:"", vicustomtext2:"", 
											vicustomtext3:"", vicustomdbl1:0, vicustomdbl2:0, vicustomdbl3:0, 
											vicustomdate1:FlexGlobals.topLevelApplication.m.DateFirst, 
											vicustomdate2:FlexGlobals.topLevelApplication.m.DateFirst, 
											vicustomdate3:FlexGlobals.topLevelApplication.m.DateFirst, 
											vitglbuat:dttgldibuat.text, 
											vitglexpired:dttglexpired.text});
										FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
									}
								}
								
								FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
							}
						});
					}else{
						dg2.dataProvider.removeAll();
						//Generate no voucher dan jumlah
						var formatserial : String = '', noawalserial:int = 0, ambildigit:String = '', dgrid:Object;
						for(var ss:int= 0; ss<Number(txtformat.text); ss++){
							ambildigit+="0";
						}
						for(i=0; i<int(txtjmlvoucher.text); i++){
							noawalserial = int(txtnoawal.text)+i;
							if(Number(txtformat.text) - String(noawalserial).length < 0){
								formatserial = '';
							}else{
								if(txtnoawal.text.length>0){
									formatserial = ambildigit.substr(0, ambildigit.length - String(noawalserial).length);
								}else{
									formatserial = '';
								}
							}
							
							if(txtnoawal.text.length <= 0){
								dg2.dataProvider.addItem({no:i+1, viid:0, vikategori:txtkategoripos.text, 
									vicabang:txtcabang.text, vilokasi:txtlokasi.text, vikode:txtawalan.text+formatserial, 
									vimatauang:UFungsional, vijml:o.txtjml, 
									vijmlvalas:0, vijmlbayar:0, vijmlbayarvalas:0, vitgllunas:FlexGlobals.topLevelApplication.m.DateFirst,
									viisclose:0, vicustomtext1:"", vicustomtext2:"", 
									vicustomtext3:"", vicustomdbl1:0, vicustomdbl2:0, vicustomdbl3:0, 
									vicustomdate1:FlexGlobals.topLevelApplication.m.DateFirst, 
									vicustomdate2:FlexGlobals.topLevelApplication.m.DateFirst, 
									vicustomdate3:FlexGlobals.topLevelApplication.m.DateFirst, 
									vitglbuat:dttgldibuat.text, 
									vitglexpired:dttglexpired.text});
							}else{
								dg2.dataProvider.addItem({no:i+1,viid:0, vikategori:txtkategoripos.text, 
									vicabang:txtcabang.text, vilokasi:txtlokasi.text, vikode:txtawalan.text+formatserial+noawalserial, 
									vimatauang:UFungsional, vijml:o.txtjml, 
									vijmlvalas:0, vijmlbayar:0, vijmlbayarvalas:0, vitgllunas:FlexGlobals.topLevelApplication.m.DateFirst,
									viisclose:0, vicustomtext1:"", vicustomtext2:"", 
									vicustomtext3:"", vicustomdbl1:0, vicustomdbl2:0, vicustomdbl3:0, 
									vicustomdate1:FlexGlobals.topLevelApplication.m.DateFirst, 
									vicustomdate2:FlexGlobals.topLevelApplication.m.DateFirst, 
