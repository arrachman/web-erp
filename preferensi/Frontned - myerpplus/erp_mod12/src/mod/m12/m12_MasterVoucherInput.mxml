				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtjml]);
				FlexGlobals.topLevelApplication.F_TextInputNumberOnlyMode([txtjmlvoucher]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgldibuat, dttglexpired]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtawalan, txtformat, txtjml, txtnoawal]);
				FlexGlobals.topLevelApplication.F_SetNilaiText([dttgldibuat],FlexGlobals.topLevelApplication.DefaultTanggal)
				dttglexpired.text = FlexGlobals.topLevelApplication.F_tglJatuhTempo(FlexGlobals.topLevelApplication.DefaultTanggal, 1);
				txtnoawal.text = '1';
				o.txtjmlvoucher = 1;
				txtjmlvoucher.text = o.txtjmlvoucher
				parentApplication.F_KosongkanText([txtcustomer, lblcustomer, txturaian]);
				FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
				//				parentApplication.f_formMasterTampil();
			}
			
