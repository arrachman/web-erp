					if(txtcabang.text.length == 0){FlexGlobals.topLevelApplication.msgAlert(txtcabang, "Cabang");}
					if(txtlokasi.text.length == 0){FlexGlobals.topLevelApplication.msgAlert(txtlokasi, "Lokasi");}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
