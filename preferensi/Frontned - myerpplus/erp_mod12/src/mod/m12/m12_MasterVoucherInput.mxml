				FlexGlobals.topLevelApplication.F_wsSearch("GenerateKodeAcak", "M12_Pos_VoucherCode",int(txtjmlvoucher.text),2,6,"", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
				
			}
			
			protected function btnok_clickHandler(event:MouseEvent):void
			{
				if(txtkategoripos.text.length > 0 && txtlokasi.text.length > 0 && txtcabang.text.length > 0){
					if(dg2.dataProvider[0].vikode != ""){
						f_simpan();
					}else{
						Alert.show("Data voucher harus diisi terlebih dahulu", "Informasi")
					}
					
				}else{
					pesanAlert = "";
					if(txtkategoripos.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkategoripos, 'Kategori POS');
					if(txtcabang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtcabang,'Cabang');
