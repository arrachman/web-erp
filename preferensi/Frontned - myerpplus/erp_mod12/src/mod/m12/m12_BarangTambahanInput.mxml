			public var validasi:Boolean,b:Button,tt:TitleWindow, pesanAlert:String, pesanAlertIng:String,UFungsional:String, img:Image, i:int, isUpdate:Boolean, hf:Object;
			public var o:Object = {},no:int;
			public var vIdbarang:int, arrColumn:Array = new Array, matauang:String, kurs:Number, dg:DataGrid, p:Object;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			
			public function f_focusOnMe():void
			{
				txtkategoripos.setFocus();
			}
			
			protected function f_persiapan():void
			{
				p = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child;
				
				//mb.dataProvider = new ArrayCollection([{label:'Simpan', icon:tbsave}]);
				cmboperator.dataProvider = new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
				parentApplication.F_txtpencarian([txtkategoripos, txtkodebarang]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtjml1, txtjml2])
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkodebarang, tkategoripos, toperator]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkategoripos, tkodebarang]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmboperator])
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				
				
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Batal", icon:"tbclose", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						f_simpan();
					}
				}
				function f_mbbuka():void{
					if(mb.menuBarItems[1].enabled ==true)FlexGlobals.topLevelApplication.f_bukaTransaksi('Cr');
				}
				function f_mbReset():void{
					//					FlexGlobals.topLevelApplication.F_defaultGridItem(dginput);
					//					f_kondisiAwal(); 
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
				}
				
				function f_mbCatatan():void{
					
				}
				function f_mbUpload():void {
					
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(2,'Cr');
				}
				
				
				FlexGlobals.topLevelApplication.F_RegGrid(12,16,[dginput],'transaksi');
				f_validasi();
				
			}
			public function f_validasi():void{
				
				if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.hasOwnProperty('dg'))
					dg = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.dg;
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M12_Pos_Additional_ItemGetdataById', dg.dataProvider[dg.selectedCell.rowIndex].aiid, 0, 0, '', '', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
				}
			}
			protected function f_kondisiAwal():void
			{
				
				isUpdate = false;
				txtkategoripos.setFocus();
				txtkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.txtkategoripos.text;
				FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
				lblkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.lblkategoripos.text;
				//set utama
				o.aiid = 0; o.aiidbarang = 0; o.aicustomtext1 = ""; 
				o.aicustomtext2 = ""; o.aicustomtext3 = ""; o.aicustomtext4 = ""; o.aicustomtext5 = ""; 
				o.aicustomint1 = 0; o.aicustomint2 = 0; o.aicustomint3 = 0; 
				o.aicustomdbl1 = 0; o.aicustomdbl2 = 0; o.aicustomdbl3 = 0; 
				o.aicustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst;
				o.aicustomdate2=FlexGlobals.topLevelApplication.m.DateFirst; 
				o.aicustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				FlexGlobals.topLevelApplication.F_KosongkanText([txtnopromo]);
				dttgl1.text = FlexGlobals.topLevelApplication.DefaultTanggal;
				dttgl2.text = FlexGlobals.topLevelApplication.F_tglJatuhTempo(FlexGlobals.topLevelApplication.DefaultTanggal, 1);
				
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						dginput.dataProvider[dginput.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dginput, dginput.selectedCell.rowIndex);
						if(Number(data) > 0){
							
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case 'jumlah':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) /o.txtkurs;
								
							}else{
								jumlahvalas = 0;
								
							}
						}
						
						break;
					case 'jumlahvalas':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
								
							}else{
								jumlahvalas = 0;
								
							}
						}
						break
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos': //kategoripos
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
						csfilter = 'pcaktif=1';
						sort = 'pckode asc';
						break;
					case 'txtkodebarang': //kode barang
						if(txtkategoripos.text.length > 0){
							FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
							paket = 'CdM12_ItemCategoryPOS';
							wsfilter = 'baktif=1 and bkode ="'+txtkodebarang.text+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}else{
							txtkategoripos.setFocus();
							Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
						}
						break;
					case 'kodebarang': //kode barang detail
						if(txtkategoripos.text.length > 0){
							FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
							paket = 'CdM12_ItemCategoryPOS';
							wsfilter = 'baktif=1 and bkode ="'+dginput.dataProvider.getItemAt(parentApplication.rowIndex).kodebarang+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}else{
							txtkategoripos.setFocus();
							Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
						}
						break;
					case "satuan": //satuan
						paket = "CdM1_Unit";
						wsfilter = 'uaktif=1 AND ukode ="'+dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex).satuan+'"';
						csfilter = 'uaktif=1';
						csfield = 2;
						sort = 'ukode asc';
						break
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'simpan':
							Alert.show(FlexGlobals.topLevelApplication.l('Data berhasil disimpan, silahkan login ulang !'), FlexGlobals.topLevelApplication.l('Informasi'), 0, null, function(e:Object):void{		
								if(e.detail == Alert.OK){
									FlexGlobals.topLevelApplication.f_getReloginForm();
								}
							});
							break;
						case 'txtkategoripos':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							
							if(o.kategorikode != ws.pckode && txtkategoripos.text.length > 0  && dginput.dataProvider[0].kodebarang.length > 0){
								Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
									if(e.detail == Alert.YES){
										txtkategoripos.text = ws.pckode;
										FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
										lblkategoripos.text = ws.pcnama;
										o.kategorikode = ws.pckode;
										FlexGlobals.topLevelApplication.F_KosongkanText([txtkodebarang, lblkodebarang]);
										FlexGlobals.topLevelApplication.F_defaultGridItem(dginput);
									}else{
										txtkategoripos.text = o.kategorikode;
										parentApplication.vpVarCurrent = txtkategoripos.text;
										lblkategoripos.text = o.kategorinama;
									}
								});
							}else{
								txtkategoripos.text = ws.pckode;
								lblkategoripos.text = ws.pcnama;
								o.kategorikode = ws.pckode;
								o.kategorinama = ws.pcnama;
							}
							break;
						
						case 'txtkodebarang': //kode barang
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkodebarang.text = ws.bkode;
							lblkodebarang.text = ws.bnama;
							o.aiidbarang = ws.bid;
							break;
						
						case 'kodebarang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							var arr:Object = dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex)
							arr.idaidetail = 0; 
							arr.idai = 0; 
							arr.idbarang = ws.bid; 
							arr.kodebarang = ws.bkode; 
							arr.namabarang = ws.bnama; 
							arr.jml = 1; 
							arr.satuan = ws.bsatuan;
							arr.customtext1 = ""; 
							arr.customtext2 = ""; 
							arr.customtext3 = "";
							arr.customtext4 = "";
							arr.customtext5 = "";
							arr.customint1 = 0;
							arr.customint2 = 0;
							arr.customint3 = 0;
							arr.customdbl1 = 0; 
							arr.customdbl2 = 0;
							arr.customdbl3 = 0;
							arr.customdate1 = FlexGlobals.topLevelApplication.m.DateFirst;
							arr.customdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
							arr.customdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
							
							FlexGlobals.topLevelApplication.F_dgRefresh(dginput);
							break;
						case 'satuan':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex).satuan = ws.ukode;
							break
						
						
						case 'tampil':
							f_focusOnMe();
							
							with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)){
								isUpdate = true;
								txtkategoripos.text = aikategori;
								lblkategoripos.text = pcnama
								FlexGlobals.topLevelApplication.vpVarCurrent = aikategori;
								txtkodebarang.text = bkode;
								lblkodebarang.text = bnama;
								o.txtjml1 = aijml1;
								o.txtjml2 = aijml2;
								txtjml1.text =  FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtjml1)
								txtjml2.text =  FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtjml2);
								txtnopromo.text = ainopromo;
								dttgl1.text = aitgl1;
								dttgl2.text = aitgl2;
								if(aioperator == 0){
									cmboperator.selectedIndex = 0;
								}else {
									if(aioperator == 1){
										cmboperator.selectedIndex = 1;
									}else{
										cmboperator.selectedIndex = 2;
									}
									
									txtjml2.enabled = false
								}
								o.aiid = aiid; o.aiidbarang = aiidbarang; o.aicustomtext1 = aicustomtext1; 
								o.aicustomtext2=aicustomtext2; o.aicustomtext3=aicustomtext3; 
								o.aicustomtext4=aicustomtext4; o.aicustomtext5=aicustomtext5;
								o.aicustomint1=aicustomint1; o.aicustomint2=aicustomint2; o.aicustomint3=aicustomint3; 
								o.aicustomdbl1=aicustomdbl1; o.aicustomdbl2=aicustomdbl2; o.aicustomdbl3=aicustomdbl3; 
								o.aicustomdate1 = aicustomdate1; 
								o.aicustomdate2 = aicustomdate2; 
								o.aicustomdate3 = aicustomdate3;
							}
							
							dginput.dataProvider.removeAll();
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								ws = parentApplication.wsArrDetail.getItemAt(i);
								dginput.dataProvider.addItem({no:i+1,
									idaidetail:ws.idaidetail, idai:ws.idai, idbarang:ws.idbarang, jml:ws.jml, satuan:ws.satuan, customtext1:ws.customtext1, 
									customtext2:ws.customtext2, customtext3:ws.customtext3, customtext4:ws.customtext4, 
									customtext5:ws.customtext5, customint1:ws.customint1, customint2:ws.customint2, customint3:ws.customint3, 
									customdbl1:ws.customdbl1, customdbl2:ws.customdbl2, customdbl3:ws.customdbl3, 
									customdate1:ws.customdate1, customdate2:ws.customdate2, customdate3:ws.customdate3, 
									kodebarang:ws.kodebarang, namabarang:ws.namabarang});
								dginput.setSelectedCell(0,1);
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dginput)
							f_hitungTotal();
							break;
						
						
						
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'kodebarang':
								var dgrid:Object = dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex)
								dgrid.idaidetail = 0; 
								dgrid.idai = 0; 
								dgrid.idbarang = 0; 
								dgrid.kodebarang = ""; 
								dgrid.namabarang = ""; 
								dgrid.jml = 1; 
								dgrid.satuan = "";
								dgrid.customtext1 = ""; 
								dgrid.customtext2 = ""; 
								dgrid.customtext3 = "";
								dgrid.customtext4 = "";
								dgrid.customtext5 = "";
								dgrid.customint1 = 0;
								dgrid.customint2 = 0;
								dgrid.customint3 = 0;
								dgrid.customdbl1 = 0; 
								dgrid.customdbl2 = 0;
								dgrid.customdbl3 = 0;
								dgrid.customdate1 = FlexGlobals.topLevelApplication.m.DateFirst;
								dgrid.customdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
								dgrid.customdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
								
								FlexGlobals.topLevelApplication.F_dgRefresh(dginput);
								break;
							case 'satuan':
								dginput.dataProvider.getItemAt(parentApplication.rowIndex).satuan = '';
								parentApplication.F_dgRefresh(dginput);
								break;
							
							case 'tampil':
								Alert.show(FlexGlobals.topLevelApplication.l(parentApplication.wsErrmessage), FlexGlobals.topLevelApplication.l('Informasi'));
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkategoripos':parentApplication.F_KosongkanText([txtkategoripos, lblkategoripos]);break;
					case 'txtkodebarang':parentApplication.F_KosongkanText([txtkodebarang, lblkodebarang]);break;
				}
			}
			
			protected function f_simpan():void
			{
				//				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, 
				var	a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
						// Set Utama
						with(o){
							a = [aiid, txtkategoripos.text, aiidbarang, cmboperator.selectedItem.v, o.txtjml1, o.txtjml2, aicustomtext1, 
								aicustomtext2, aicustomtext3, aicustomtext4, aicustomtext5, aicustomint1, aicustomint2, aicustomint3, 
								aicustomdbl1, aicustomdbl2, aicustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(aicustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(aicustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(aicustomdate3),
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text), FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text),
								txtnopromo.text];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
						// Set Detail
						for(i=0;i<dginput.dataProviderLength;i++)
							with(dginput.dataProvider.getItemAt(i)){
								a = [idaidetail, idai, idbarang, jml, satuan, customtext1, customtext2, 
									customtext3, customtext4, customtext5, customint1, customint2, customint3, customdbl1, 
									customdbl2, customdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_Pos_Additional_ItemSimpan", parentApplication.userid, isUpdate, utama, detail, 1,20,p.f_filterdata(), p.arr[1]);
						
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = ""; 
					pesanAlertIng = '';
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dginput);
					if(txtkategoripos.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkategoripos, 'Kategori POS');
					if(txtkodebarang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkodebarang,'Kode Barang');
					for(i=0; i<dginput.dataProviderLength; i++){
						if(dginput.dataProvider.getItemAt(i).kodebarang.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dginput,'Kode Barang');
					}
					if(cmboperator.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmboperator,'Operator');
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
					f_hitungTotal();
					
					
				}
			}
			
