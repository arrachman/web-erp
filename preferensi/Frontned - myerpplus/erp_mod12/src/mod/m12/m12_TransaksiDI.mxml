			public function f_hitungTotal():void
			{
				o.crjumlah = 0;
				o.crjumlahvalas = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).jumlah != 0)o.crjumlah += Number(dg.dataProvider.getItemAt(i).jumlah);
					if(dg.dataProvider.getItemAt(i).jumlahvalas != 0)o.crjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas);
				}
			}
			
			
			
