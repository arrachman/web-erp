			public var indexjenis :int
			protected function cmbjeniskategori_closeHandler(event:DropDownEvent):void
			{
				// TODO Auto-generated method stub
				if(dg.dataProviderLength >= 1 && dg.dataProvider[0].kodebarang != ""){
					Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{	
						if(e.detail == Alert.YES){
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
						}else{
							cmbjeniskategori.selectedIndex = indexjenis;
						}
					});
				}
				
				if(cmbjeniskategori.selectedIndex == 0){
					txtkategoripos.text = ''; 
					twajibkatpos.visible = false; 
					txtkategoripos.enabled = false; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = false; 
					txtcabang.enabled = false; 
					lblcabang.text = '';
				}else if(cmbjeniskategori.selectedIndex == 1){
					txtkategoripos.text = ''; 
					twajibkatpos.visible = true; 
					txtkategoripos.enabled = true; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = false; 
					txtcabang.enabled = false; 
					lblcabang.text = '';
				}else{
					txtkategoripos.text = ''; 
					twajibkatpos.visible = false; 
					txtkategoripos.enabled = false; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = true; 
					txtcabang.enabled = true; 
					lblcabang.text = '';
				}
			}
			
			public var strFilter:String = "";
			public function f_tampilkan():void
			{
				strFilter = "";
				parentApplication.vpFocusEvent = true;
//				if((txtkodebarang1.text == "" && txtkodebarang2.text == "") && txtkategoribarang.text == "")Alert.show(parentApplication.l('Isi Kode Barang atau Kategori Barang terlebih dahulu'), parentApplication.l('Informasi'));
//				else{
					if(txtkodebarang1.text != "" && txtkodebarang2.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bkode BETWEEN "'+txtkodebarang1.text+'" AND "'+txtkodebarang2.text+'"');
						//						strFilter = 'bkode BETWEEN "'+txtkodebarang1.text+'" AND "'+txtkodebarang2.text+'"';
					}
					if(dttglaktif1.text != "" && dttglaktif2.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'baktiftgl BETWEEN "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglaktif1.text)+'" AND "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglaktif1.text)+'"');
						//						strFilter = 'bkode BETWEEN "'+txtkodebarang1.text+'" AND "'+txtkodebarang2.text+'"';
					}
					if(txtkategoribarang.text.length > 0){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bkategori = "'+txtkategoribarang.text+'"');
						//						strFilter += 'bkategori = "'+txtkategoribarang.text+'"';
					}
					if(txtnamabarang.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtdepartemen.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bdepartemen = "'+txtdepartemen.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtclass.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bakelas = "'+txtclass.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtsubclass.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bsubkelas = "'+txtsubclass.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtstyle.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bamodel = "'+txtstyle.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtmaterial.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bdepartment = "'+txtmaterial.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtcolor.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bawarna = "'+txtcolor.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtsize.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bamodel = "'+txtsize.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtsection.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bsection = "'+txtsection.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtvendor.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bvendor = "'+txtvendor.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtbrand.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bamerk = "'+txtbrand.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtdesigner.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bdesigner = "'+txtdesigner.text.split('"').join('\\"')+'"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					
					if(cmbjeniskategori.selectedIndex == 0){
						parentApplication.F_wsSearch('tampilkan', 'CdM1_Item', 0, 0, strFilter, "bkode asc");
					}else if(cmbjeniskategori.selectedIndex == 1){
						if(txtkategoripos.text.length > 0){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilkan', 'CdM12_ItemCategoryPOS', 0, 0, strFilter, "bkode asc","", "", txtkategoripos.text);
						}else{
							Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
						}
						
					}else if(cmbjeniskategori.selectedIndex == 2){
						if(txtcabang.text.length > 0){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilkan', 'CdM1_Item', 0, 0, strFilter, "bkode asc");
						}else{
							Alert.show("Cabang harus diisi terlebih dahulu", "Informasi");
						}
						
					}
					
//				}
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				for(var i:int = 0; i<dg.dataProviderLength; i++){
					dg.dataProvider[i].operator = cmboperator.selectedItem.v; 
					dg.dataProvider[i].jml1 = o.txtjml1; 
					dg.dataProvider[i].jml2 = o.txtjml2; 
					dg.dataProvider[i].kriteria = cmbkriteria.selectedItem.v; 
					dg.dataProvider[i].nilai = o.txtnilai; 
					dg.dataProvider[i].tgl1 = dttglawal.text; 
					dg.dataProvider[i].tgl2 = dttglakhir.text; 
					dg.dataProvider[i].jam1 = txtjam1.text; 
					dg.dataProvider[i].jam2 = txtjam2.text; 
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
