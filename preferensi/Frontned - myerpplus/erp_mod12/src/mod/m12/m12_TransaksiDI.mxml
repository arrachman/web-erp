	<fx:Script> 
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Button;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import org.hamcrest.filter.FilterFunction;
			
			import spark.components.Image;
			import spark.components.TitleWindow;
			import spark.events.DropDownEvent;
			import spark.events.GridSelectionEvent;
			
			public var validasi:Boolean,tt:TitleWindow, pesanAlert:String, pesanAlertIng:String,UFungsional:String, img:Image, i:int, isUpdate:Boolean, hf:Object;
			public var o:Object = {},no:int;
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			[Bindable]protected var acBonus:ArrayCollection = new ArrayCollection();
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'kriteria'){
							return new ArrayCollection([{l:'Discount Percent', v:1}, {l:'Discount Nominal', v:2}]);
						}
						if(dataField == 'operator'){
							return new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
						}
				}
				return new ArrayCollection([]);
			}
			
			public function f_focusOnMe():void
			{
				cmbjeniskategori.setFocus();
			}
			
			protected function f_persiapan():void
			{
				
				
				//mb.dataProvider = new ArrayCollection([{label:'Simpan', icon:tbsave}]);
				
				mb.dataProvider = new Array([{label:"simpan"}])
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				parentApplication.F_DateFieldStandard([dttgl, dttglaktif1, dttglaktif2, dttglakhir, dttglawal]);
				parentApplication.F_ComboBoxStandard([cmbprogress, cmbjeniskategori, cmbkriteria, cmboperator]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtkategoripos,txtcabang, txtkodebarang1, txtkodebarang2, txtkategoribarang, txtkodebarang1, txtkodebarang2, txtdepartemen, txtclass, txtsubclass, txtstyle, txtmaterial, txtcolor, txtsize, txtsection, txtvendor, txtbrand, txtdesigner])
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalModePOS([txtjml1, txtjml2, txtnilai]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,chkauto]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tjeniskategori, ttanggal, tnotransaksi, tprogress]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkategoripos, ttanggal, tnotransaksi, tprogress, turaian, tkontakperson, tcatatan]);
				tab.focusEnabled = false;
				cmbjeniskategori.dataProvider = new ArrayCollection([{l:'Semua Kategori', v:0}, {l:'Per Kategori', v:1}, {l:'Per Cabang', v:2}]);
				cmbkriteria.dataProvider =  new ArrayCollection([{l:'Discount Percent', v:1}, {l:'Discount Nominal', v:2}]);
				cmboperator.dataProvider =  new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbbuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLink);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(12,57,jenissimpan)==true){
							f_simpan();
						}
					}
				}
				function f_mbbuka():void{
					if(mb.menuBarItems[1].enabled ==true)FlexGlobals.topLevelApplication.f_bukaTransaksi('Di');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
					mb.menuBarItems[3].enabled=false;
					mb.menuBarItems[4].enabled=false;
				}
				
				function f_mbCatatan():void{
					if(mb.menuBarItems[3].enabled==true)FlexGlobals.topLevelApplication.F_OpenNotes(o.disumber,o.diid,txtnotransaksi.text);
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('DI', o.diid,txtnotransaksi.text);
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(12,'Di');
				}
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
					if(event.keyCode == Keyboard.ENTER){
						dg.setFocus();
						dg.setSelectedCell(0,1);
					}
				}
				);
				
				
				FlexGlobals.topLevelApplication.F_RegGrid(12,57,[dg],'transaksi');
				f_validasi();
				//				setBonus()
				
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M12_DiHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M12_DiGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				twajibkatpos.enabled = true;
				txtcabang.enabled = false;
				lblcabang.enabled =  false;
				twajibcabang.visible = false;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				cmbprogress.selectedIndex = 1;
				chkauto.selected = true;
				txtnotransaksi.text = 'Auto';
				txtnotransaksi.enabled = false;
				cmbjeniskategori.selectedIndex = 1;
				isUpdate = false;
				f_focusOnMe()
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("DI");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("DI",1);
				parentApplication.F_SetNilaiText([dttgl, dttglawal, dttglakhir], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtkategoripos,lblkategoripos,txtcabang,lblcabang,txtkontakperson]);
				//set utama
				o.txtjml1 = 0;
				o.txtjml2 = 0;
				o.txtnilai = 0;
				parentApplication.F_SetNilaiText([txtjml1, txtjml2, txtnilai], parentApplication.m.nfNominalPOS.format(0));
				txtjam1.text = "00:00:00";
				txtjam2.text = "00:00:00";
				
				o.diid = 0; o.dicabang = FlexGlobals.topLevelApplication.ucabang; o.dilokasi = FlexGlobals.topLevelApplication.ulokasi; o.disumber = "DI"; 
				o.dikodepa = 0; o.dikontak = FlexGlobals.topLevelApplication.ukontak; o.distatussebelumnya = 0; o.dijmlrevisi = 0; 
				o.dicetakanke = 0; o.diisclose = 0; o.diinputuser = FlexGlobals.topLevelApplication.userid; o.diinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.dimodifikasiuser = 0; 
				o.dimodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.diposting = 0; o.dipostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.dicustomtext1 = ''; o.dicustomtext2 = ''; o.dicustomtext3 = ''; o.dicustomtext4 = ''; o.dicustomtext5 = ''; 
				o.dicustomint1 = 0; o.dicustomint2 = 0; o.dicustomint3 = 0; o.dicustomdbl1 = 0; o.dicustomdbl2 = 0; o.dicustomdbl3 = 0; 
				o.dicustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.dicustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.dicustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
				
				
				for(i=0; i<dg.dataProviderLength; i++){
					dg.dataProvider.getItemAt(i).kodebarang=''; 
					dg.dataProvider.getItemAt(i).jml1=0; 
				}
				
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(12,57,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				var nogrup:int
				switch(column){
					
					case 'jml2':
						with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
							if(operator != 0){
								jml2 = 0
							}
						}
						
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos':
						if(txtkategoripos.enabled == true){
							paket = 'CdM12_Pos_Category';
							wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
							csfilter = 'pcaktif=1';
							sort = 'pckode asc';
						}
						break;
					case 'txtcabang':
						if(txtcabang.enabled == true){
							paket = 'CdM1_Branch';
							wsfilter = 'baktif=1 and bkode ="'+txtcabang.text+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+o.crkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.crkontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif=1 AND tnsumber="CR"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case 'txtdepartemen':
						//						if(txtdivisi.text.length > 0){
						//							paket = 'CdM1_Department';
						//							csfilter = 'dpaktif = 1 AND dpdivisi = "'+txtdivisi.text+'"';
						//							wsfilter = 'dpaktif = 1 AND dpdivisi = "'+txtdivisi.text+'" and dpkode = "'+ txtdepartment.text.split('"').join('\\"') +'"';
						//						}else{
						paket = 'CdM1_Department';
						csfilter = 'dpaktif = 1';
						wsfilter = 'dpaktif = 1 and dpkode = "'+ txtdepartemen.text.split('"').join('\\"') +'"';
						//						}
						break;
					case 'txtbrand':
						paket = 'M1_MerkSearch';
						csfilter = 'maktif = 1';
						wsfilter = 'maktif = 1 and mkode= "'+ txtbrand.text.split('"').join('\\"') +'"';
						break;
					case 'txtcolor':
						paket = 'M1_ColorSearch';
						csfilter = 'caktif = 1';
						wsfilter = 'caktif = 1 and ckode= "'+ txtcolor.text.split('"').join('\\"') +'"';
						break;
					
					case 'txtsize':
						paket = 'M1_SizeSearch';
						csfilter = 'saktif = 1';
						wsfilter = 'saktif = 1 and skode= "'+ txtsize.text.split('"').join('\\"') +'"';
						break;
					case 'txtstyle':
						paket = 'M1_ModelSearch';
						csfilter = 'maktif = 1';
						wsfilter = 'maktif = 1 and mkode= "'+ txtstyle.text.split('"').join('\\"') +'"';
						break;
					case 'txtclass':
						paket = 'M1_ClassSearch';
						csfilter = 'caktif = 1';
						wsfilter = 'caktif = 1 and ckode= "'+ txtclass.text.split('"').join('\\"') +'"';
						break;
					case 'txtsubclass':
						paket = 'M1_SubclassSearch';
						csfilter = 'scaktif = 1';
						wsfilter = 'scaktif = 1 and sckode= "'+ txtsubclass.text.split('"').join('\\"') +'"';
						break;
					case 'txtdesigner':
						paket = 'M1_DesignerSearch';
						csfilter = 'daktif = 1';
						wsfilter = 'daktif = 1 and dkode= "'+ txtdesigner.text.split('"').join('\\"') +'"';
						break;
					case 'txtvendor':
						paket = 'M1_VendorSearch';
						csfilter = 'vaktif = 1';
						wsfilter = 'vaktif = 1 and vkode= "'+ txtvendor.text.split('"').join('\\"') +'"';
						break;
					case 'txtsection':
						paket = 'M1_SectionSearch';
						csfilter = 'saktif = 1';
						wsfilter = 'saktif = 1 and skode= "'+ txtsection.text.split('"').join('\\"') +'"';
						break;
					case 'txtmaterial':
						paket = 'M1_MaterialSearch';
						csfilter = 'maktif = 1';
						wsfilter = 'maktif = 1 and mkode= "'+ txtmaterial.text.split('"').join('\\"') +'"';
						break;
					case 'kodebarang':
						if(cmbjeniskategori.selectedIndex == 0){
							paket = 'CdM1_Item';
							wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).kodebarang+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}else if (cmbjeniskategori.selectedIndex == 1){
							if(txtkategoripos.text.length > 0){
								FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
								paket = 'CdM12_ItemCategoryPOS';
								wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else{
								txtkategoripos.setFocus();
								Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
							}
						}else if (cmbjeniskategori.selectedIndex == 2){
							if(txtcabang.text.length > 0){
								paket = 'CdM1_Item';
								wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else{
								txtcabang.setFocus();
								Alert.show("Cabang harus diisi terlebih dahulu", "Informasi");
							}
						}
						break;
				
					case "costcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi": // Divisi
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi": //sub divisi
						paket = "CdM1_Subdivision";
						wsfilter = 'sdkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'" AND sdaktif=1';
						csfilter = 'sdaktif=1 AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						sort = 'sddivisi asc';
						break;
					case "proyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'txtkategoripos':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkategoripos.text = ws.pckode;
							lblkategoripos.text = ws.pcnama;
							o.kategorikode = ws.pckode;
							o.kategorinama = ws.pcnama;
							break;
						case 'txtcabang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcabang.text = ws.bkode;
							lblcabang.text = ws.bnama;
							o.dicabang = ws.bkode;
							break;
						case 'txtkontakperson':
							txtkontakperson.text = parentApplication.wsArrUtama.getItemAt(0).kakodekontak;
							break;
						
						case 'txtcatatan':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcatatan.text = ws.tncatatan;
							break;
						case 'txtdepartemen':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtdepartemen.text = ws.dpkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtdepartemen.text;
							break;
						case 'txtcolor':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcolor.text = ws.ckode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtcolor.text;
							break;
						case 'txtbrand':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtbrand.text = ws.mkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtbrand.text;
							break;
						case 'txtstyle':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtstyle.text = ws.mkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtstyle.text;
							break;
						case 'txtclass':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtclass.text = ws.ckode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtclass.text;
							break;
						case 'txtsubclass':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtsubclass.text = ws.sckode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtsubclass.text;
							break;
						case 'txtdesigner':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtdesigner.text = ws.dkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtdesigner.text;
							break;
						case 'txtmaterial':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtmaterial.text = ws.mkode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtmaterial.text;
							txtmaterial.text = ws.mnama;
							break;
						case 'txtmaterial':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtsection.text = ws.skode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtmaterial.text;
							break;
						case 'txtvendor':
							ws = parentApplication.wsArrUtama.getItemAt(0);
