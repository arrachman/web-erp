			protected function f_simpan():void
			{
				//				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, 
				var	a:Array, utama:String, detail:String, bonus:String, tgl:String;
				o.tanggal = dttgl.text;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
						// Set Utama
						with(o){
							a = [diid, dicabang, dilokasi, disumber, txtkategoripos.text, int(chkauto.selected), txtnotransaksi.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), dikodepa, dikontak, txtkontakperson.text, txturaian.text, txtcatatan.text, 
								cmbprogress.selectedItem.v, distatussebelumnya, dijmlrevisi, dicetakanke, diisclose, diinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(diinputtgl), dimodifikasiuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dimodifikasitgl), diposting, FlexGlobals.topLevelApplication.F_tglFormatDB(dipostingtgl), dicustomtext1, dicustomtext2, dicustomtext3, dicustomtext4, 
								dicustomtext5, dicustomint1, dicustomint2, dicustomint3, dicustomdbl1, dicustomdbl2, dicustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dicustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dicustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dicustomdate3), cmbjeniskategori.selectedItem.v];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
						// Set Detail
						for(i=0;i<dg.dataProviderLength;i++){
							with(dg.dataProvider.getItemAt(i)){
								a = [iddidetail, iddi, txtkategoripos.text, idbarang, operator, jml1, jml2, 
									kriteria, nilai, FlexGlobals.topLevelApplication.F_tglFormatDB(tgl1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(tgl2), jam1, jam2, catatan, 
									i+1, customtext1, customtext2, customtext3, customtext4, customtext5, customint1, 
									customint2, customint3, customdbl1, customdbl2, customdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3), nopromo];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_DiSimpan", parentApplication.userid, isUpdate, utama, detail);
						
					}
				}
				
