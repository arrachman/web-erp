				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				//set total detail
				o.totalSI = 0; o.totalSIvalas = 0; o.totalCOA = 0; o.totalCOAvalas = 0; o.totalIP = 0; o.totalIPvalas = 0;
				//set diskon detail
				
				o.totaltransaksiSI = 0; o.totaltransaksiCOA = 0; o.diskonterminIP = 0;  o.diskonterminIPvalas = 0; o.totaltransaksiIP = 0;
				o.terbayarSI = 0; o.terbayarIP = 0;
				o.sisaSI = 0; o.sisaIP = 0;
				//set total bawah
				o.ppvtotalap = 0; o.ppvtotalapvalas = 0; o.ppvtotalar = 0; o.ppvtotalarvalas = 0; o.ppvselisihkurs = 0;
				o.ppvdiskon = 0; o.ppvdiskonvalas =  0; o.ppvbayar = 0; o.ppvbayarvalas = 0;
				o.ppvselisihar = 0; o.ppvselisiharvalas = 0;
				
				//dgSI
				for(i = 0; i< dgSI.dataProviderLength; i++){
					if(dgSI.dataProvider[i].chk == 1){
						if(dgSI.dataProvider[i].jmlbayar != undefined){
							o.totalSI += Number(dgSI.dataProvider[i].jmlbayar);
							o.totalSIvalas += Number(dgSI.dataProvider[i].jmlbayarvalas);
							o.diskonSI += Number(dgSI.dataProvider[i].jmldiskon);
							o.diskonSIvalas += Number(dgSI.dataProvider[i].jmldiskonvalas);
							// hitung total tiap tiap tab
							o.totaltransaksiSI += Number(dgSI.dataProvider[i].totaltransaksi);
							o.terbayarSI += Number(dgSI.dataProvider[i].jmlbayar);
							o.sisaSI = Number(o.totaltransaksiSI - o.terbayarSI);
						}
					}
				}
				
				// dgIP
				for(i = 0; i< dgIP.dataProviderLength; i++){
					if(dgIP.dataProvider[i].chk == 1){
						if(dgIP.dataProvider[i].jmlbayar != undefined){
							o.totalIP += Number(dgIP.dataProvider[i].jmlbayar);
							o.totalIPvalas += Number(dgIP.dataProvider[i].jmlbayarvalas);
							o.diskonterminIP += Number(dgIP.dataProvider[i].jmldiskon);
							o.diskonterminIPvalas += Number(dgIP.dataProvider[i].jmldiskonvalas);
							// hitung total tiap tiap tab
							o.totaltransaksiIP += Number(dgIP.dataProvider[i].totaltransaksi);
							o.terbayarIP += Number(dgIP.dataProvider[i].terbayar);
							o.sisaIP = Number(o.totaltransaksiIP - o.terbayarIP);
						}
						
					}
				}
				
				//hitungtotalar
				o.ppvtotalar = Number(o.totalSI) + Number(o.totalCOA);
				o.ppvtotalarvalas = Number(o.totalSIvalas) + Number(o.totalCOAvalas);
				//hitungtotalar
				/* o.ppvtotalap = 0;
				o.ppvtotalapvalas = 0; */
				
				o.ppvtotalap = Number(o.totalIP);
				o.ppvtotalapvalas = Number(o.totalIPvalas);
				
				//hitung diskon termin
				o.ppvdiskon = Number(o.diskonterminIP);
				o.ppvdiskonvalas = Number(o.diskonterminIPvalas);
				//hitung selisih kurs
				if(txtmatauang.text != UFungsional){
					o.ppvselisihkurs = Number(o.ppvtotalap) - Number(o.ppvtotalar) - Number(o.ppvdiskon) - ((Number(o.ppvtotalapvalas) - Number(o.ppvtotalarvalas) - Number(o.ppvdiskonvalas)) * Number(o.txtkurs));
				}
				o.ppvselisihar = Number(o.ppvtotalar) - Number(o.ppvtotalap) + Number(o.ppvselisihkurs); 
				o.ppvselisiharvalas = Number(o.ppvtotalarvalas) - Number(o.ppvtotalapvalas);
				
				//hitungbayar
				// set label tiap tiap tab
				lbltotaltransaksiIP1.text = parentApplication.F_formatNominal(o.totaltransaksiIP);
				lbltotaltransaksiSI1.text = parentApplication.F_formatNominal(o.totaltransaksiSI); 
				lblterbayarSI1.text = parentApplication.F_formatNominal(o.terbayarSI);
				lblterbayarIP1.text = parentApplication.F_formatNominal(o.terbayarIP);
				lblsisaIP1.text = parentApplication.F_formatNominal(o.sisaIP);
				lblsisaSI1.text = parentApplication.F_formatNominal(o.sisaSI); 
				f_hitungTotalUtama()
			}
			public function f_hitungTotalUtama():void{
				o.txttotaltrans = Number(o.terbayarSI) + Number(o.txtdenda) - Number(o.txtdiskon);
				txttotaltrans.text = parentApplication.F_formatNominal(o.txttotaltrans);
				txttunai.text = parentApplication.F_formatNominal(o.txttunai);
				f_hitungTotalBayar();
			}
			public function f_hitungTotalBayar():void{
				o.txttotalbayar = Number(o.txttunai) + Number(o.txtkartukredit) + Number(o.txtkartudebit) + Number(o.txtvoucher) + Number(o.totalIP);
				txttotalbayar.text = parentApplication.F_formatNominal(o.txttotalbayar)
			}
			
			
			protected function f_diskonTermin(tglutama:String, tglgiro:String, tgl:String, haridiskon1:int, haridiskon2:int, diskon1:int, diskon2:int):int
			{
				var tglselisih:int, i:int;
				if(tglutama == '')
					return 0;
				if(tglgiro == '')tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglutama, tgl)
				else tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglutama, tglgiro);
				if(tglselisih <= haridiskon1)
					return diskon1;
				else if(tglselisih <= haridiskon2)
					return diskon2;
				else return 0;
			}
			
			
			protected function dvd_dividerPressHandler(event:DividerEvent):void
			{
				if(tab.selectedIndex == 0){
					if(boxfilter1.height < 5){
						lbl1.text = 'Sembunyikan Filter';
						btnexpand.visible = false;
						btncollapse.visible = true;
					}else if(boxfilter1.height ==0){
						lbl1.text = 'Tampilkan Filter';
						btnexpand.visible = true;
						btncollapse.visible = false;
					}
					else {
						lbl1.text = 'Tampilkan Filter';
						btnexpand.visible = true;
						btncollapse.visible = false;
					}
				}
			}
			
			public var loop:int = -1;
			public function f_uangRefreshGrid():void
			{
				loop++;
				if(dgSI.dataProvider.length > 0 && dgSI.dataProvider[0].notransaksi != '' && loop == 0){
					FlexGlobals.topLevelApplication.F_wsSearch('PPV_TakeData', 'M12_PpvTakedataSearch', 0, 0, f_filterdatamatauang());
				}
				else if(dgIP.dataProvider.length > 0 && dgIP.dataProvider[0].notransaksi != '' && loop == 2){
					FlexGlobals.topLevelApplication.F_wsSearch('PPV_TakeData', 'PPV_TakeData', 0, 0, f_filterdatamatauang());
				}
				if(loop > 2){ cekfilter = false; }
			}
			
