			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(12,78,jenissimpan)==true){
								f_simpan();
							}
						}
						break;
				}
			}	
			
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array; 
				var dgrid:Object;
				switch(column){
					case 'jmlbayar':
						dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)
						if(dgrid.matauang != ''){
							if(dgrid.matauang == UFungsional){
								dgrid.jmlbayarvalas = 0 ;
							}
							else{
								dgrid.jmlbayarvalas = Number(dgrid.jmlbayar) / Number(dgrid.kurs);
							}
							
							f_hitungTotal();
						}
						break;
					case 'jmlbayarvalas':
						dgrid = dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)
						if(dgrid.matauang != ''){
							if(dgrid.matauang != UFungsional){
								dgrid.jmlbayar = dgrid.jmlbayarvalas *  Number(dgrid.kurs);
							}else{
								dgrid.jmlbayarvalas = 0
								dgrid.jmlbayar = Number(dgrid.totaltransaksi) - Number(dgrid.terbayar)
							}
							
//							dgrid.diskontermin = f_diskonTermin(dttgl.text, '', dgrid.tgl, dgrid.haridiskon1, dgrid.haridiskon2, dgrid.diskon1, dgrid.diskon2);
//							dgrid.jmldiskontermin = dgrid.jmlbayar*(dgrid.diskontermin/100);
//							dgrid.jmldiskonterminvalas = dgrid.jmlbayarvalas*(dgrid.diskontermin/100);
							f_hitungTotal();
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var dg:DataGrid
				if(tab.selectedIndex ==0 ){dg = dgSI}
				else if(tab.selectedIndex == 1){dg = dgIP}
				
				
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtcustomer':
						paket = 'CdM1_Contact';
						wsfilter = "kaktif='1' and kkategori='C' and kkode ='"+txtcustomer.text+"'";
						csfilter = "kaktif='1' and kkategori='C'";
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = "kaidkontak ="+o.ppvcustomer+" AND kakodekontak ='"+txtkontakperson.text+"'";
						csfilter = "kaidkontak ="+o.ppvcustomer+"";
						csfield = 2;
						break;
					case 'txtmatauang':
						paket = 'CdM1_Currency';
						wsfilter = "caktif=1 AND ckode = '"+txtmatauang.text+"'";
						csfilter = 'caktif=1';
						break;
					case 'txtmatauangSI':
						paket = 'CdM1_Currency';
						wsfilter = "caktif=1 AND ckode = '"+txtmatauangSI.text+"'";
						csfilter = "caktif=1";
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = "tnaktif=1 AND tnsumber='VP'";
						csfield = 2;
						break;
					case 'txtbagpenagihan':
						paket = 'CdM1_Contact';
						wsfilter = "kaktif='1' and kkategori='K' and kkode ='"+txtbagpenagihan.text+"'";
						csfilter = "kaktif='1' and kkategori='K'";
						csfield = 2;
						break;
					case 'txtbagterima':
						paket = 'CdM1_Contact';
						wsfilter = "kaktif='1' and kkategori='K' and kkode ='"+txtbagterima.text+"'";
						csfilter = "kaktif='1' and kkategori='K'";
						csfield = 2;
						break;
					case 'nogiro':
						paket = 'CdM2_Giro_List';
						wsfilter = "glstatus='0' and glnogiro = '"+dg.dataProvider[dg.selectedCell.rowIndex].nogiro+"'";
						csfilter = "glstatus='0'";
						csfield = 2;
						sort = 'glnogiro asc';
						break;
					
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = "tndaktif=1 AND tndsumber='VP'";
						break;
					
					case 'txtdenda':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'txtdiskon':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'txttunai':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'txtkartukredit':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'txtkartudebit':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'txtvoucher':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					
					case 'lblselisihkurs':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'AmbilIC':
						paket = 'CdM5_Ic';
						csfilter = "iccustomer="+o.ppvcustomer+" AND icmatauang='"+txtmatauang.text+"' AND icstatusppv <> 2 AND (icstatus = 2 OR icstatus = 3)";
						sort = 'ictgl desc, icnotransaksi desc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
