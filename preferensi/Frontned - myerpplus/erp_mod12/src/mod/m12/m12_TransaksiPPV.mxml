			protected function f_filterdata():String{
				var dg:Object={};
				var f:String='', matauangdetail:String='';
				if(tab.selectedIndex == 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sumber = "SI"');
					if(dttglSI1.text!="" && dttglSI2.text!=""){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'tgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglSI1.text)+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglSI2.text)+'"');
					}
					else if(dttglSI1.text != "") 
						f = parentApplication.TambahFilter(f, 'tgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglSI1.text)+'"'); 
					else if(dttglSI2.text != "")
						f = parentApplication.TambahFilter(f, 'tgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglSI2.text)+'"'); 
					
					if(txtfnotransaksiSI1.text!="" && txtfnotransaksiSI2.text!=""){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'notransaksi Between "'+txtfnotransaksiSI1.text+'" and "'+txtfnotransaksiSI2.text+'"');
					}
					
					if(txtmatauangSI.text !=""){
						matauangdetail = 'AND matauang ="'+txtmatauangSI.text+'"';
					}
					if(cmbstatusjtSI.selectedItem.v != "" && cmbstatusjtSI.textInput.text.length > 0){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'tanggaljatuhtempo '+cmbstatusjtSI.selectedItem.v+' "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text)+'"');
					}
					dg = dgSI;
				}
				else if(tab.selectedIndex == 1){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sumber = "IP"');
					if(dttglIP1.text!="" && dttglIP2.text!=""){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'tgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglIP1.text)+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglIP2.text)+'"');
					}
					else if(dttglIP1.text != "") 
						f = parentApplication.TambahFilter(f, 'tgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglIP1.text)+'"'); 
					else if(dttglIP2.text != "")
						f = parentApplication.TambahFilter(f, 'tgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglIP2.text)+'"'); 
					
					if(txtfnotransaksiIP1.text!="" && txtfnotransaksiIP2.text!=""){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'notransaksi Between "'+txtfnotransaksiIP1.text+'" and "'+txtfnotransaksiIP2.text+'"');
					}
					
					if(txtmatauangIP.text !=""){
						matauangdetail = 'AND matauang ="'+txtmatauangIP.text+'"';
					}
					if(cmbstatusjtIP.selectedItem.v != "" && cmbstatusjtIP.textInput.text.length > 0){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'tanggaljatuhtempo '+cmbstatusjtIP.selectedItem.v+' "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text)+'"');
					}
					dg = dgIP;
				}
				for(i=0; i<dg.dataProviderLength; i++){
					if(dg.dataProvider[i].chk == true){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'idtransaksi <>"'+dg.dataProvider[i].idtransaksi+'"'); 
					}
				}
				if(txtmatauang.text != UFungsional  && (tab.selectedIndex == 2 || tab.selectedIndex == 3)){
					if(matauangdetail ==  'AND matauang ="'+UFungsional+'"' || matauangdetail == ''){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'(matauang ="'+txtmatauang.text.split('"').join('\\"')+'" '+matauangdetail+') OR matauang ="'+UFungsional+'"');
					}else{
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'matauang ="'+txtmatauang.text.split('"').join('\\"')+'" '+matauangdetail);
					}
				}else{
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'matauang ="'+txtmatauang.text.split('"').join('\\"')+'" '+matauangdetail);
				}
				if(tab.selectedIndex ==1){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'statuslunas <> 2) AND (kontak = '+o.ppvcustomer+' OR kontak = '+FlexGlobals.topLevelApplication.getSetting(0, 'company', 'Kontak'));
				}else{
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'statuslunas <> 2 AND kontak = '+o.ppvcustomer);
				}
				return f;
			}
			
