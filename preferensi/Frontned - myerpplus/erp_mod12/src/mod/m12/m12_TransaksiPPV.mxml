			protected function f_wsTampil(page:int = 0, sort:String = ''):void
			{
				pesanAlert = '';
				if(txtcustomer.text.length > 0 && txtmatauang.text.length > 0){
					FlexGlobals.topLevelApplication.F_wsSearch('PPV_TakeData', 'M12_PpvTakedataSearch', 0, 0, f_filterdata());
				}else{
					if(txtmatauang.text.length <= 0)parentApplication.msgAlert(txtmatauang, 'Uang');
