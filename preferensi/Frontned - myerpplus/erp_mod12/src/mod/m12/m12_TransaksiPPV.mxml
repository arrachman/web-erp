//					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgCOA);
					if(txtcustomer.text.length <= 0)parentApplication.msgAlert(txtcustomer,'Customer');
					if(dttgl.text.length <= 0)parentApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)parentApplication.msgAlert(cmbprogress,'Progress');
					if(txtmatauang.text.length <= 0)parentApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)parentApplication.msgAlert(txtkurs,'Kurs');
