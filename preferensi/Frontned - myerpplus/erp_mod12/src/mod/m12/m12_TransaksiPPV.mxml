			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var mnid:int, dg:DataGrid;
				if(tab.selectedIndex == 0){mnid = 10; dg = dgSI}
				else if(tab.selectedIndex ==1){mnid = 44; dg = dgIP}
				
				switch (components){
					case 'checkBoxHeader':
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
						}
						break;
					
					case 'checkBox':
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						break;
					case 'link':
						FlexGlobals.topLevelApplication.openForm(5, mnid, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idtransaksi);
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
