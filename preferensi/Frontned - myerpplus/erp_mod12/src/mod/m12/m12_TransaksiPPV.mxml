											FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
											FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3), rencana];
										
										if(detail == '')detail =f_splitArrayToString(a);
										else detail += "▲"+f_splitArrayToString(a);
