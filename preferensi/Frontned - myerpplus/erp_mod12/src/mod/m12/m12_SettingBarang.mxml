			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
//				if(dg1.selectedCell != null || dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(parentApplication.rowIndex);
				switch(target){
					case 'txtkodebarang1':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bkode ="'+txtkodebarang1.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'txtkodebarang2':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bkode ="'+txtkodebarang2.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'txtkategoripos':
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
						csfilter = 'pcaktif=1';
						sort = 'pckode asc';
						break;
					case 'txtkategoribarang':
						paket = 'CdM1_Item_Category';
						wsfilter = 'icaktif = 1 AND ickode ="'+txtkategoribarang.text+'"';
						csfilter = 'icaktif=1';
						sort = 'ickode asc';
						break;
					
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = "tnaktif = 1 AND tnsumber = 'PA'";
						sort = 'tnkode asc';
						break;
					
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
