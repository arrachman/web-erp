			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(12,13,jenissimpan)==true){
								f_simpan();
							}
						}
						break;
					case Keyboard.F:
						if(e.ctrlKey)f_tampilkan();
						break;
					case Keyboard.PAGE_DOWN:
						f_tampilkan(int(txtpaging.text) + 1)
						txtpaging.text = String(int(txtpaging.text) + 1)
						break;
					case Keyboard.PAGE_UP:
						f_tampilkan(int(txtpaging.text) - 1);
						txtpaging.text = String(int(txtpaging.text) - 1)
						break;
					case Keyboard.HOME:
						f_tampilkan(1);
						break;
					case Keyboard.END:
						f_tampilkan(int(- 1))
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				var dgrid:Object;
				
				switch(column){
					
					case 'chk':
						break;
					case 'pistokminimal':
						dgrid = dg1.dataProvider[dg1.selectedCell.rowIndex];
						if(dgrid.pistokminimal != dgrid.pistokminimallama){
							dgrid.pistatusubah = 1;
							f_EditData();
							
						}else{
							dgrid.pistatusubah = 0;
							f_EditData();
						}
						break;
					case 'pistokmaksimal':
						dgrid = dg1.dataProvider[dg1.selectedCell.rowIndex];
						if(dgrid.pistokmaksimal != dgrid.pistokmaksimallama){
							dgrid.pistatusubah = 1;
							f_EditData();
						}else{
							dgrid.pistatusubah = 0;
							f_EditData();
						}
						break;
					case 'pistokreorder':
						dgrid = dg1.dataProvider[dg1.selectedCell.rowIndex];
						if(dgrid.pistokreorder != dgrid.pistokreorderlama){
							dgrid.pistatusubah = 1;
							f_EditData();
						}else{
							dgrid.pistatusubah = 0;
							f_EditData();
						}
						break;
					case 'pistokminorder':
						dgrid = dg1.dataProvider[dg1.selectedCell.rowIndex];
						if(dgrid.pistokminorder != dgrid.pistokminorderlama){
							dgrid.pistatusubah = 1;
							f_EditData();
						}else{
							dgrid.pistatusubah = 0;
							f_EditData();
						}
						break;
					case 'pihargajual1':
						dgrid = dg1.dataProvider[dg1.selectedCell.rowIndex];
						if(dgrid.pihargajual1 != dgrid.pihargajual1lama){
