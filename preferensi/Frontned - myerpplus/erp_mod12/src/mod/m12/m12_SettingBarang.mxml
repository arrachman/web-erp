			public function f_tampilkan(halaman:int = 1):void
			{
				
				parentApplication.vpFocusEvent = true;
				if(txtkategoripos.text.length > 0){
					FlexGlobals.topLevelApplication.F_wsSearch("getdatabarang", "M12_Pos_ItemSearch",halaman,13,f_filterdata(),"bkode asc", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
				}else{
					Alert.show(FlexGlobals.topLevelApplication.l("Kategori POS harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"))
				}
					
			}
			
			public function f_filterdata():String{
				if(txtkategoripos.text.length > 0){
					strFilter = "pikategori = '"+txtkategoripos.text+"'";
//					FlexGlobals.topLevelApplication.F_wsSearch("getdatabarang", "M12_Pos_ItemSearch",halaman,13,strFilter,"bkode asc", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
				}
				if(txtkategoribarang.text != "")strFilter += ' AND bkategori = "'+txtkategoribarang.text+'"';
				if(txtkodebarang1.text != "" && txtkodebarang2.text != "")strFilter += ' AND bkode BETWEEN "'+txtkodebarang1.text+'" AND "'+txtkodebarang2.text+'"';
				if(txtnamabarang.text != "")strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
				return strFilter;
			}
			public function f_tambahsemuakategori():void{
				f_sendProgress('Kode Barang : '+acKategoriPOS[index].kode+" - "+acKategoriPOS[index].nama, true);
				FlexGlobals.topLevelApplication.F_wsSimpan('SimpanSemuaKategori', "M12_Pos_ItemSimpanSemua", parentApplication.userid, isUpdate, acKategoriPOS[index].kode, "", 1, 13, f_filterdata(), "bkode asc");
			}
			public function f_setPerubahan():void
			{
				if(o.txtfilterperubahannilai > 100 && cmboperationperubahannilai.selectedIndex == 0){Alert.show(parentApplication.l('Nilai perubahan melebihi 100'), parentApplication.l('Informasi'));return;}
				if(txtfilterperubahannilai.text != ''){
					for(var i:int=0;i<dg1.dataProvider.length;i++){
						switch(cmboperationperubahannilai.selectedIndex){
							case 0:
								dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v]  = ((o.txtfilterperubahannilai /100) * Number(dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v+'lama'])) + Number(dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v+'lama']); 
								
								break;
							case 1:dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v]  = Number(dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v+'lama']) + parentApplication.F_unCurreny(o.txtfilterperubahannilai); break;
						}
						if(dg1.dataProvider.getItemAt(i).chk == true && (dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v] != dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v+"lama"])){
							dg1.dataProvider.getItemAt(i).pistatusubah = 1;
							dg1.dataProvider.getItemAt(i).piaksi = 1;
							f_EditData();
						}
					}
						
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_setNilai():void
			{
				//if(o.txtfiltersetnilai <= 0 ){return;}
				if(txtfiltersetnilai.text != '')
					for(var i:int=0;i<dg1.dataProvider.length;i++){
						dg1.dataProvider.getItemAt(i)[cmbfieldsetnilai.selectedItem.v] = parentApplication.F_unCurreny(o.txtfiltersetnilai);
						if(dg1.dataProvider.getItemAt(i).chk == true && (dg1.dataProvider.getItemAt(i)[cmbfieldsetnilai.selectedItem.v] != dg1.dataProvider.getItemAt(i)[cmbfieldsetnilai.selectedItem.v+"lama"])){
							dg1.dataProvider.getItemAt(i).pistatusubah = 1;
							f_EditData();
							dg1.dataProvider.getItemAt(i).piaksi = 1;
						}
					}
				parentApplication.F_dgRefresh(dg1);
			}
			public var jmlProgress:int, num:Number, j:int, close:Boolean;
			[bindable] public var acKategoriPOS : ArrayCollection = new ArrayCollection();
			public function f_sendProgress(data:String, status:Boolean):void
			{
				j++;
				if(status == true){
					if(j > jmlProgress){
						close = true;
						return;
					}
					lblProses.text = data;
				}else{
					lblProses.text = parentApplication.l("Upload failed")+" "+data;
					close = true;
					return;
				}
				num += 100/jmlProgress;
				pb.setProgress(num, 100);
				lblPersen.text = String(uint(num))+" %";
			}
			
