			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkategoripos':parentApplication.F_KosongkanText([txtkategoripos, lblkategoripos]);break;
					case 'txtkategoribarang':parentApplication.F_KosongkanText([txtkategoribarang, lblkategoribarang]);break;
					case 'txtkodebarang1':parentApplication.F_KosongkanText([txtkodebarang1]);break;
					case 'txtkodebarang2':parentApplication.F_KosongkanText([txtkodebarang2]);break;
					case 'tampilkan':
						for(var a:int = dg1.dataProviderLength - 1; a>=0; a--){
							if(dg1.dataProvider[a].chk == 0){
								dg1.dataProvider.removeItemAt(a);
							}
						}
						break;
					case 'getdatabarang':
						dg1.dataProvider.removeAll();
						parentApplication.F_acAdd(dg1);
						dg1.setSelectedCell(0, 1);
						dg1.dataProvider[0].pistatusgetdata = 0;
						dg1.dataProvider[0].pistatusubah = 0;
//						f_EditData();
						break;
					case 'simpan':
					case 'sinkron':
						Alert.show(parentApplication.wsErrmessage, parentApplication.l('Informasi'));
						break;
					case 'hapus':
						Alert.show(parentApplication.wsErrmessage, parentApplication.l('Informasi'));
						break;
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String="", valsimpan:Boolean = false;
				parentApplication.vpFocusEvent = true;
				
				if(mb.menuBarItems[0].enabled == true){
					for(i = 0; i<dg1.dataProviderLength; i++){
						if(dg1.dataProvider[i].kodebarang == ""){
							Alert.show("Data harus dipilih terlebih dahulu", "Informasi");
							validasi = false;
						}else{
							validasi = true;
						}
					}
					if(validasi == true){
						// Set Detail
						for(i=0;i<acEdit.length;i++)
							with(acEdit.getItemAt(i)){
								if(pistatusubah == 1){
									valsimpan = true;
									a = [pikategori, piidbarang, pistokminimal, pistokmaksimal, pistokreorder, pihargajual1, pihargajual2, 
										pihargajual3, pihargajual4, pihargajual5, pidiskonjual1, pidiskonjual2, pidiskonjual3, pidiskonjual4, 
										pidiskonjual5, picustomtext1, picustomtext2, picustomtext3, picustomtext4, picustomtext5, picustomint1, 
										picustomint2, picustomint3, picustomdbl1, picustomdbl2, picustomdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate3), piaksi, pistokminorder, pihargaedited];
									if(detail == "" )detail = parentApplication.F_splitArrayToString(a);
									else detail += "▲"+parentApplication.F_splitArrayToString(a);
								}
								
							}
						if(valsimpan == true){FlexGlobals.topLevelApplication.F_wsSimpan('simpan', "M12_Pos_ItemSimpan", parentApplication.userid, isUpdate, detail, "", 1, 13, f_filterdata(), "bkode asc");}
						else{Alert.show("Tidak ada data yang diubah", "Informasi")}
					}
				}
				
				function validasiForm():void
				{
					pesanAlert='';
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					
					
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
			
