			public function f_EditData():void{
				var iAC:int;
				for(var m:int = 0; m<dg1.dataProviderLength; m++){
					
					with(dg1.dataProvider[m]){
						if(pistatusubah == 1){
							if(acEdit.length > 0){
								f_SetDatatoArray(m);
							}else{
								acEdit.addItem({chk: chk, 
									pikategori: pikategori, 
									piidbarang: piidbarang, 
									pistokminimal: pistokminimal, 
									pistokmaksimal: pistokmaksimal, 
									pistokreorder: pistokreorder, 
									pistokminorder: pistokminorder, 
									pihargajual1: pihargajual1, 
									pihargajual2: pihargajual2, 
									pihargajual3: pihargajual3, 
									pihargajual4: pihargajual4, 
									pihargajual5: pihargajual5, 
									pidiskonjual1: pidiskonjual1, 
									pidiskonjual2: pidiskonjual2, 
									pidiskonjual3: pidiskonjual3, 
									pidiskonjual4: pidiskonjual4, 
									pidiskonjual5: pidiskonjual5, 
									picustomtext1: picustomtext1, 
									picustomtext2: picustomtext2, 
									picustomtext3: picustomtext3, 
									picustomtext4: picustomtext4, 
									picustomtext5: picustomtext5, 
									picustomint1: picustomint1, 
									picustomint2: picustomint2, 
									picustomint3: picustomint3, 
									picustomdbl1: picustomdbl1, 
									picustomdbl2: picustomdbl2, 
									picustomdbl3: picustomdbl3, 
									picustomdate1: picustomdate1, 
									picustomdate2: picustomdate2, 
									picustomdate3: picustomdate3, 
									piaksi: piaksi, 
									kodebarang: kodebarang, 
									namabarang: namabarang, 
									satuan: satuan,
									pistokminimallama: pistokminimallama, 
									pistokmaksimallama: pistokmaksimallama,
									pistokreorderlama: pistokreorderlama, 
									pihargajual1lama: pihargajual1lama,
									pihargajual2lama: pihargajual2lama,
									pihargajual3lama: pihargajual3lama, 
									pihargajual4lama: pihargajual4lama, 
									pihargajual5lama: pihargajual5lama,
									pidiskon1juallama : pidiskon1juallama, 
									pidiskonjual2lama: pidiskonjual2lama, 
									pidiskonjual3lama: pidiskonjual3lama, 
									pidiskonjual4lama: pidiskonjual4lama,
									pidiskonjual5lama: pidiskonjual5, 
									pistatusubah : pistatusubah, 
									pistatusgetdata: pistatusgetdata,
									pistokminorderlama: pistokminorderlama,
									pihargaedited : pihargaedited});
							}
						}	
						else if(pistatusubah == 0){
							for(iAC = acEdit.length - 1; iAC >= 0 ; iAC--){
								if(piidbarang != undefined){
									if(piidbarang == acEdit[iAC].piidbarang){
										acEdit.removeItemAt(iAC);
									}
								}
								
							}
							
						}
					}
				}
				
				
				
			}
