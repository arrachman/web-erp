								FlexGlobals.topLevelApplication.F_tglFormatDB(sbicustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(sbicustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(sbicustomdate3), cmbjeniskategori.selectedItem.v];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
						// Set Detail
						for(i=0;i<dg.dataProviderLength;i++){
							with(dg.dataProvider.getItemAt(i)){
								a = [idsbidetail, idsbi, txtkategoripos.text, idbarang, operator, jml1, jml2, 
									customtext1, customtext2, customtext3, customtext4, customtext5, customint1, customint2, 
									customint3, customdbl1, customdbl2, customdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(tgl1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(tgl2), 
									nopromo, nogrup, catatan, i+1];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						
						acSubstitution.filterFunction = null;
						acSubstitution.refresh();
						for(i=0;i<acSubstitution.length;i++){
							with(acSubstitution.getItemAt(i)){
								a = [idsubstitution, idsbi, idsbidetail, idbarang, jml, satuan, customtext1, 
									customtext2, customtext3, customtext4, customtext5, customint1, customint2, customint3, 
									customdbl1, customdbl2, customdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3), nogrup, i+1];
								if(i == 0)substitution = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else substitution += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						
						filterSubstitution();
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_SbiSimpan", parentApplication.userid, isUpdate, utama, detail+FlexGlobals.topLevelApplication.sptSubParam+substitution);
						
					}
				}
				
