			public function setSubstitution():void{
				
				acSubstitution.removeAll();
				
				var nomor : Object = {}
				var r:Object = {}, t:int;
				
				for(t=0;t<acSubstitution.length;t++){
					// jumlah
					if(r[acSubstitution[t].idbarang] == undefined) r[acSubstitution[t].nbtidbarang] = acSubstitution[t].jml;
					else r[acSubstitution[t].idbarang] += acSubstitution[t].nbtjml;
					
					// nomer
					if(nomor[acSubstitution[t].idbarang] == undefined)
						nomor[acSubstitution[t].idbarang] = 2;
					else 
						nomor[acSubstitution[t].idbarang]++;
				}
				
				for(i=0;i<dg.dataProvider.length;i++){
					
					if(nomor[dg.dataProvider.getItemAt(i).idbarang] == undefined)
						nomor[dg.dataProvider.getItemAt(i).idbarang] = 1;
					if(r[dg.dataProvider.getItemAt(i).idbarang] == undefined)
						r[dg.dataProvider.getItemAt(i).idbarang] = 0;
					if(dg.dataProvider[i].idsbidetail == undefined)
						dg.dataProvider[i].idsbidetail = 0;
					
					if(r[dg.dataProvider.getItemAt(i).idbarang] < dg.dataProvider[i].jml)
						acSubstitution.addItem({no:nomor[dg.dataProvider.getItemAt(i).idbarang]++, idsubstitution:0, idsbidetail:0, idbarang:0, jml:1, satuan:"", 
							customtext1:"", customtext2:"", 
							customtext3:"", customtext4:"", customtext5:"", customint1:0, 
							customint2:0, customint3:0, customdbl1:0, 
							customdbl2:0, customdbl3:0, customdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
							customdate2:FlexGlobals.topLevelApplication.DefaultTanggal, customdate3:FlexGlobals.topLevelApplication.DefaultTanggal, 
							kodebarang2:"", namabarang:"", 
							urutan:0, nogrup : dg.dataProvider[dg.selectedCell.rowIndex].nogrup});
				}
				
				dg2.dataProvider = acSubstitution;
				dg2.validateNow();
				dg.setSelectedCell(0,1);
				dg.validateNow();
				filterSubstitution();
			}
			
