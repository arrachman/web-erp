			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos':
						if(txtkategoripos.enabled == true){
							paket = 'CdM12_Pos_Category';
							wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
							csfilter = 'pcaktif=1';
							sort = 'pckode asc';
						}
						
						break;
					case 'txtcabang':
						if(txtcabang.enabled == true){
							paket = 'CdM1_Branch';
							wsfilter = 'baktif=1 and bkode ="'+txtcabang.text+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+o.sbikontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.sbikontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif=1 AND tnsumber="SBI"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case 'kodebarang':
						if(cmbjeniskategori.selectedIndex == 0){
							paket = 'CdM1_Item';
							wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}else if (cmbjeniskategori.selectedIndex == 1){
							if(txtkategoripos.text.length > 0){
								FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
								paket = 'CdM12_ItemCategoryPOS';
								wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else{
								txtkategoripos.setFocus();
								Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
							}
						}else if (cmbjeniskategori.selectedIndex == 2){
							if(txtcabang.text.length > 0){
								paket = 'CdM1_Item';
								wsfilter = 'baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else{
								txtcabang.setFocus();
								Alert.show("Cabang harus diisi terlebih dahulu", "Informasi");
							}
						}
						break;
					
					case 'kodebarang2':
						if(cmbjeniskategori.selectedIndex == 0){
							paket = 'CdM1_Item';
							wsfilter = 'baktif=1 and bkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kodebarang2+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}else if (cmbjeniskategori.selectedIndex == 1){
							if(txtkategoripos.text.length > 0){
								FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
								paket = 'CdM12_ItemCategoryPOS';
								wsfilter = 'baktif=1 and bkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kodebarang2+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else{
								txtkategoripos.setFocus();
								Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
							}
						}else if (cmbjeniskategori.selectedIndex == 2){
							if(txtcabang.text.length > 0){
								paket = 'CdM1_Item';
								wsfilter = 'baktif=1 and bkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kodebarang2+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}else{
								txtcabang.setFocus();
								Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
							}
						}
						break;
					
					case "costcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi": // Divisi
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi": //sub divisi
						paket = "CdM1_Subdivision";
						wsfilter = 'sdkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'" AND sdaktif=1';
						csfilter = 'sdaktif=1 AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						sort = 'sddivisi asc';
						break;
					case "proyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'txtkategoripos':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkategoripos.text = ws.pckode;
							lblkategoripos.text = ws.pcnama;
							o.kategorikode = ws.pckode;
							o.kategorinama = ws.pcnama;
							break;
						case 'txtcabang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcabang.text = ws.bkode;
							lblcabang.text = ws.bnama;
							o.sbicabang = ws.bkode;
							break;
						case 'txtkontakperson':
							txtkontakperson.text = parentApplication.wsArrUtama.getItemAt(0).kakodekontak;
							break;
						
						case 'txtcatatan':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcatatan.text = ws.tncatatan;
							break;
						case 'kodebarang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							var arr:Object = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)
							arr.idsbidetail = 0; 
							arr.idsbi = 0; 
							arr.sbikategori = txtkategoripos.text; 
							arr.idbarang = ws.bid;
							arr.kodebarang = ws.bkode; 
							arr.namabarang = ws.bnama; 
							arr.operator = 1; 
							arr.jml1 = 1; 
							arr.jml2 = 0; 
							arr.customtext1 = ""; 
							arr.customtext2 = ""; 
							arr.customtext3 = ""; 
							arr.customtext4 = ""; 
							arr.customtext5 = ""; 
							arr.customint1 = 0; 
							arr.customint2 = 0; 
							arr.customint3 = 0; 
							arr.customdbl1 = 0; 
							arr.customdbl2 = 0; 
							arr.customdbl3 = 0; 
							arr.customdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
							arr.customdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
							arr.customdate3 = FlexGlobals.topLevelApplication.m.DateFirst; 
							arr.tgl1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
							arr.tgl2 = FlexGlobals.topLevelApplication.F_tglJatuhTempo(FlexGlobals.topLevelApplication.DefaultTanggal, 1); 
							arr.nopromo = txtnotransaksi.text;
							arr.nogrup = dg.dataProviderLength;
							arr.catatan = "";
							
							for(var a:int = 0; a<dg.dataProviderLength - 1; a++){
								if(arr.nogrup == dg.dataProvider[a].nogrup){
									arr.nogrup = Number(arr.nogrup) + 1
								}
