			protected function cmbjeniskategori_closeHandler(event:DropDownEvent):void
			{
				// TODO Auto-generated method stub
				if(dg.dataProviderLength >= 1 && dg.dataProvider[0].kodebarang != ""){
					Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{	
						if(e.detail == Alert.YES){
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
							acSubstitution.removeAll();
						}else{
							cmbjeniskategori.selectedIndex = indexjenis;
						}
					});
				}
				
				if(cmbjeniskategori.selectedIndex == 0){
					txtkategoripos.text = ''; 
					twajibkatpos.visible = false; 
					txtkategoripos.enabled = false; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = false; 
					txtcabang.enabled = false; 
					lblcabang.text = '';
				}else if(cmbjeniskategori.selectedIndex == 1){
					txtkategoripos.text = ''; 
					twajibkatpos.visible = true; 
					txtkategoripos.enabled = true; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = false; 
					txtcabang.enabled = false; 
					lblcabang.text = '';
				}else{
					txtkategoripos.text = ''; 
					twajibkatpos.visible = false; 
					txtkategoripos.enabled = false; 
					lblkategoripos.text = '';
					txtcabang.text = ''; 
					twajibcabang.visible = true; 
					txtcabang.enabled = true; 
					lblcabang.text = '';
				}
			}
			
