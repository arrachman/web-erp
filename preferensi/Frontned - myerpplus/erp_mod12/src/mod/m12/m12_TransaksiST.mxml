			private function filterMyArrayCollectionbatch(item:Object):Boolean {
				var searchString:String;
				var itemName:String;
				searchString = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogrup;
				itemName = (item.nogrup as String);
				
				if(itemName == null){
					return true;
				}
				
				return itemName.indexOf(searchString) > -1;
			}
			
