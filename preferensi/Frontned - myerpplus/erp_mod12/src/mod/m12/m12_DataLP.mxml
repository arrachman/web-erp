<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()" initialize="p = parentApplication">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			
			import spark.components.TitleWindow;
			import spark.events.TextOperationEvent;
			
			public var a:Array = new Array;
			public var arr:Array, arrColumn:Array;
			public var p :Object, t:TitleWindow;
			public var o:Object = {};
			
			// fokus ke no txtnotransaksi saat form pertama dibuka ======================================
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			// persiapan persiapan ======================================================================	
			public function f_persiapan():void
			{
				p=parentApplication;
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnotransaksi, ttanggal, ttanggalberlaku, tbarang, turaian, tcatatan, tjenislaporan, tuser, tgudang, tlokasi, tcabang, tstatus]);
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(12, 73);			//(ambil report dari database)
				a = [12, 73, 74, 'Lp', false];																// module, menu transaksi, menu, sumber, approvell, Sort, Group
				p.F_persiapanFormData(this);
				p.F_DateFieldStandard([dttgl1, dttgl2, txttanggalberlaku1, txttanggalberlaku2]);			// daftarkan fungsi-fungsi datefield
				p.F_ComboBoxStandard([cmbjenislaporan,  cmbstatus]);										// daftarkan fungsi-fungsi combobox
				p.F_txtpencarian([txtlokasi, txtgudang, txtuser, txtcabang]);		// daftarkan fungsi-fungsi text input yang pencarian
				p.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2, txturaian, txtcatatan]);			// daftarkan fungsi-fungsi text input
				//				txtnotransaksi1.addEventListener(spark.events.TextOperationEvent.CHANGE, f_change);			// digunakan untuk pengisian text input lain ketika fokus out
				//				dttgl1.addEventListener(spark.events.TextOperationEvent.CHANGE, f_changedate);				// digunakan untuk pengisian datefield lain ketika fokus out
				function f_change():void{
					txtnotransaksi2.text = txtnotransaksi1.text;
				}
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				f_kondisiAwal();
			}
			
			// set kondisi awal ketika form dibuka ======================================
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				cmbstatus.selectedIndex = o.DefaultStatus;
				txturaian.text = p.getNomor("PPA");
				txtlokasi.text = p.ulokasi;
				txtcabang.text = p.ucabang;
				txtuser.text = p.userid;
				p.F_SetNilaiText([dttgl1, dttgl2, txttanggalberlaku1, txttanggalberlaku2], p.DefaultTanggal);
				p.F_KosongkanText([txtnotransaksi1, txtnotransaksi2, txtbarang1, txtbarang2, txturaian, txtcatatan, txtgudang, txtuser, txttanggalberlaku1, txttanggalberlaku2]);
				dg.dataProvider.removeAll();
			}
			
			// digunakan untuk duka form transaksi ======================================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				if(parentApplication.apaBisaAkses(a[0], a[2], 4) == true){
					FlexGlobals.topLevelApplication.openForm(a[0], a[1], dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[a[3].toLowerCase()+'id']);
				}
			}
			
			// set kondisi untuk filter =============================================
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtbarang1':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 AND bkode ="'+txtbarang1.text.split('"').join('\\"')+'"';		// dipakai ketika validasi dari textinput
						csfilter = 'baktif = 1 AND bassembly <> 1';		
						sort = 'bkode asc';														// dipakai ketika buka form komponen pencarian
						break;
					case 'txtbarang2':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 AND bkode ="'+txtbarang2.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1';
						sort = 'bkode asc';
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = 'uaktif=1';
						wsfilter = 'uaktif=1 AND ukode ="'+txtuser.text.split('"').join('\\"')+'"';
						sort = 'ukode asc';
						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = 'laktif=1';
						wsfilter = 'laktif=1 AND lkode ="'+txtlokasi.text.split('"').join('\\"')+'"';
						sort = 'lkode asc';
						break;
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						csfilter = 'waktif=1';
						wsfilter = 'waktif=1 AND wkode ="'+txtgudang.text.split('"').join('\\"')+'"';
						sort = 'wkode asc';
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = 'baktif=1';
						wsfilter = 'baktif=1 AND bkode = "'+txtcabang.text.split('"').join('\\"')+'"';
						sort = 'bkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			// set kondisi saat set ketika selesai pencarian ==================================
			// set ketika benar ====================================
			public var inputuser:String;
			public function f_wsHasil():void
			{
				var o:Object, s:String = p.subject, i:int;
				if(p.wsSuccess == true){
					if(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt.length >= 0)o = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtbarang1':
							txtbarang1.text = o.bkode;
						case 'txtbarang2':
							txtbarang2.text = o.bkode;
							break;
						case 'txtlokasi':
							txtlokasi.text = o.lkode;
							break;
						case 'txtgudang':
							txtgudang.text = o.wkode;
							break;
						case 'txtuser':
							txtuser.text = o.ukode;
							inputuser = o.userid;
							break;
						case 'txtcabang':
							txtcabang.text = o.bkode;
							break;
					}
				}else{					
					// set ketika salah ====================================	
					if(p.F_validasiFalse(s) == true)
						switch(s){
							case 'txtbarang1': txtbarang1.text = ""; break;
							case 'txtlokasi': txtlokasi.text = ""; break;
							case 'txtgudang': txtgudang.text = ""; break;
							case 'txtuser': txtuser.text = ""; inputuser = "0"; break;
							case 'txtcabang': txtcabang.text = ""; break;
						}
				}
			}
			
			// pengosongan textinput ketika pencarian tidak ditemukan ================================
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtbarang1':p.F_KosongkanText([txtbarang1]);
					case 'txtbarang2':p.F_KosongkanText([txtbarang2]);break;
					case 'txtuser':p.F_KosongkanText([txtuser]); inputuser = ''; break;
					case 'txtgudang':p.F_KosongkanText([txtgudang]);break;
					case 'txtlokasi':p.F_KosongkanText([txtlokasi]);break;
					case 'txtcabang':p.F_KosongkanText([txtcabang]); break;
				}
			}
			
			// pengisian filter untuk report =========================================================
			public function f_filterdata():String{
				var f:String="";
				f = p.F_standartFilter();
				if(txttanggalberlaku1.text!='' && txttanggalberlaku1.text!='')
					f = p.TambahFilter(f,'lptglberlakusampai BETWEEN "'+parentApplication.F_tglFormatDB(txttanggalberlaku1.text)+'" AND "'+parentApplication.F_tglFormatDB(txttanggalberlaku2.text)+'"');
				if(txttanggalberlaku1.text=='' && txttanggalberlaku1.text!='')
					f = p.TambahFilter(f,'lptglberlakusampai <= "'+parentApplication.F_tglFormatDB(txttanggalberlaku1.text)+'" AND "'+parentApplication.F_tglFormatDB(txttanggalberlaku2.text)+'"');
				if(txttanggalberlaku1.text!='' && txttanggalberlaku1.text=='')
					f = p.TambahFilter(f,'lptglberlakusampai >= "'+parentApplication.F_tglFormatDB(txttanggalberlaku1.text)+'" AND "'+parentApplication.F_tglFormatDB(txttanggalberlaku2.text)+'"');
				if(txtgudang.text!='')
					f = p.TambahFilter(f,'lpgudang LIKE "%'+txtgudang.text.split('"').join('\\"')+'"');
				if(txtuser.text!='')
					f = p.TambahFilter(f,'lpinputuser ='+inputuser);
				return f;
			}
			
