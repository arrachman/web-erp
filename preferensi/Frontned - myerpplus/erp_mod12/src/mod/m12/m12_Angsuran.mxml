			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, dgrid:Object;
				if(dg_angsuran.selectedCell != null)dgrid = dg_angsuran.dataProvider.getItemAt(dg_angsuran.selectedCell.rowIndex);
				switch(target){
					case "bank":
						paket = "CdM1_Bank";
						wsfilter = 'baktif = 1 AND bkode = "'+dgrid.bank+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break;
					case 'rekbank':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd = "D" AND cnomor = "'+dgrid.rekbank+'"';
						csfilter = 'caktif=1 AND cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = "tndaktif=1 AND tndsumber='AP'";
						break;
					/* case "AmbilVoucher":
						paket = "CdM12_Pos_Voucher";
						wsfilter = '(vicustomdbl1 = '+p.u.getItemAt(0).sicustomer+' OR vicustomdbl1 = 0) AND vikategori = "'+FlexGlobals.topLevelApplication.m.ArrSettingPOS[0].pcskategori+'" AND vicustomtext1 = "'+txtvoucher.text+'" and vitglexpired >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal)+'" AND viisclose = 0';
						csfilter = '(vicustomdbl1 = '+p.u.getItemAt(0).sicustomer+' OR vicustomdbl1 = 0) AND vikategori = "'+FlexGlobals.topLevelApplication.m.ArrSettingPOS[0].pcskategori+'" AND vitglexpired >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal)+'" AND viisclose = 0';
						sort = 'vikode asc';
						break; */
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public var idvoucher : int = 0
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				var ob : Object;
				if(FlexGlobals.topLevelApplication.wsSuccess == true){
					ws = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'AmbilVoucher': 
//							txtvoucher.text = ws.vicustomtext1;
							if(ws.vijml < o.txtjmlkredit){
								o.txtjmlkredit = ws.vijml;
								txtjmlkredit.text = parentApplication.m.nfNominalPOS.format(o.txtjmlkredit)
							}else if (ws.vijml > o.txtjmlkredit){
								o.txtlimitkredit = ws.vijml;
								txtlimitkredit.text = parentApplication.m.nfNominalPOS.format(o.txtlimitkredit);
							}
							idvoucher = ws.viid;
							txtjmlkredit.setFocus()
							f_hitungTotal()
							break;
						case 'bank': 
							ob = dg_angsuran.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex);
							ob.bank = ws.bkode;
							ob.rekbank = parentApplication.getSetting(0, 'akun', 'KartuDebit');
							ob.rekbanknama = parentApplication.getSetting(0, 'akunnama', 'KartuDebit');
							break;
						case 'rekbank':
							ob = dg_angsuran.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex);
							ob.rekbank = ws.cnomor;
							ob.rekbanknama = ws.cnama;
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
							case 'bank': 
								ob = dg_angsuran.dataProvider.getItemAt(dg_angsuran.selectedCell.rowIndex);
								ob.bank = '';
								ob.rekbank = parentApplication.getSetting(0, 'akun', 'KartuDebit');
								ob.rekbanknama = parentApplication.getSetting(0, 'akunnama', 'KartuDebit');
								break;
							case 'rekbank':
								ob = dg_angsuran.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex);
								ob.rekbank = "";
								ob.rekbanknama = "";
								break;
							case 'AmbilVoucher': 
								txtvoucher.text = "";
								idvoucher = 0;
								o.txtlimitkredit = 0;
								txtlimitkredit.text = parentApplication.m.nfNominalPOS.format(o.txtlimitkredit);
								Alert.show("Voucher tidak ditemukan", "Informasi")
								break;
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'AmbilVoucher': 
						txtvoucher.text = "";
						idvoucher = 0;
						o.txtlimitkredit = 0;
						txtlimitkredit.text = parentApplication.m.nfNominalPOS.format(o.txtlimitkredit);
						Alert.show("Voucher tidak ditemukan", "Informasi")
						break;
				}
			}
			
			protected function f_simpan():void
			{
				FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg_angsuran);
				if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.arrdetailangsuran.length > 0){
					FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.arrdetailangsuran.removeAll();
				}
				for(i = 0; i<dg_angsuran.dataProviderLength; i++){
					with(dg_angsuran.dataProvider[i]){
						FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.arrdetailangsuran.addItem({idsiinstallment:0, 
							idsi:0, matauang:matauang, kurs:kurs, 
							jumlah:jumlah, jumlahvalas:0, 
							tgljt:tgljt, rekpiutang:FlexGlobals.topLevelApplication.getSetting(0,"akun","PiutangUsaha"), 
							catatan:"", urutan:i+1, isclose:0, angsuranke:angsuranke, customtext1:txtvoucher.text, customtext2:"", customtext3:"", 
							customtext4:"", customtext5:"", customint1:idvoucher, customint2:0, customint3:0, customint4:0, customint5:0,
							customdbl1:o.txtlimitkredit, customdbl2:0, customdbl3:0, customdbl4:0, customdbl5:0,
							customdate1: parentApplication.m.DateFirst,customdate2: parentApplication.m.DateFirst,customdate3: parentApplication.m.DateFirst,
							customdate4: parentApplication.m.DateFirst,customdate5: parentApplication.m.DateFirst});
					}
					
				}
				
				FlexGlobals.topLevelApplication.closeFormPopUp(1)
				p.o.txtangsuran = o.txttotalkredit;
				p.txtangsuran.text = parentApplication.m.nfNominalPOS.format(p.o.txtangsuran);
				p.o.txtbiayaadminpersen = o.txtbyadminpersen;
				p.txtbiayaadminpersen.text = parentApplication.m.nfNominalPOS.format(p.o.txtbiayaadminpersen);
				p.o.txtbiayaadminnilai = o.txtbyadminnominal;
				p.txtbiayaadminnilai.text = parentApplication.m.nfNominalPOS.format(p.o.txtbiayaadminnilai);
				p.f_hitungTotalUtama();
				p.u.getItemAt(0).sicustomtext1 = rekbiayaadmin; //rek biaya admin
				p.u.getItemAt(0).sicustomint1 = cmbkategori.selectedIndex; //kategori angsuran : bulanan/harian
				p.u.getItemAt(0).sicustomdbl4 = o.txtjmlkredit; //jumlah kredit
				p.u.getItemAt(0).sicustomdbl5 = o.txtjmlcicilan; //jumlah cicilan
				p.u.getItemAt(0).sicustomdbl6 = o.txtbyadminpersen; //persentase biaya admin
				p.u.getItemAt(0).sicustomdbl7 = o.txtbyadminnominal; //jumlah biaya admin
				p.u.getItemAt(0).sicustomdbl8 = o.txttotalkredit; //total kredit
				p.u.getItemAt(0).sicustomdate1 = dttglawalkredit.text;//tanggal awal kredit
				
				if(p.o.txtjmlbayar < p.o.txttotaltransaksi){
					p.txtborderbayar.visible = true;
					p.bordervisible = true;
				}else{
					p.txtborderbayar.visible = false;
					p.bordervisible = false;
				}
				
				if(p.dg_pos.dataProviderLength == 1 && p.dg_pos.dataProvider[0].kodebarang == ""){
					FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
					parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
				}else{
					parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
					FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
				}
				
			}
			
			private var vtotal:Number=0,vvalas:Number=0;
			public function f_hitungTotal():void
			{
//				o.jumlah = 0
//				for(var i:int=0;i<dg_angsuran.dataProvider.length;i++){
//					if(dg_angsuran.dataProvider.getItemAt(i).jumlah != undefined)o.jumlah += Number(dg_angsuran.dataProvider.getItemAt(i).jumlah);
//				}
				o.txttotalkredit = Number(o.txtjmlkredit) + Number(o.txtbyadminnominal);
				
				txttotalkredit.text = parentApplication.m.nfNominalPOS.format(o.txttotalkredit);
			}
			
			
