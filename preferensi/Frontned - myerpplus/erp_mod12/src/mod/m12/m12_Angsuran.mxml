			public function HitungSimulasi():void{
				var tglawal:String="", bulantahun:Array, 
					tglangsuran : Array = FlexGlobals.topLevelApplication.getSetting(12,"options","TanggalAngsuran").split("|");
				if(tglangsuran[0] == "0"){
					tglawal = dttglawalkredit.text;
				}else if(tglangsuran[0] == "1"){
					var bulantransaksi :Array = dttglawalkredit.text.split("/");
					tglawal =  tglangsuran[1]+"/"+bulantransaksi[1]+"/"+bulantransaksi[2]
				}
				
				dg_angsuran.dataProvider.removeAll();
				//fungsi untuk mengambil jumlah hari dalam satu bulan==========
				function AmbilJmlHari(year:int, month:int):int{
					var d:Date=new Date(year, month, 0);
					return d.getDate();
				}
				//end fungsi untuk mengambil jumlah hari dalam satu bulan======
				//hitung simulasi====================================================
				for (var i:int = 0; i < o.txtjmlcicilan; i++){
					bulantahun = tglawal.split("/");
					//jika bulanan===================================================
					if(cmbkategori.selectedIndex == 0){
						dg_angsuran.dataProvider.addItem({
							no:i+1, 
							angsuranke:i+1,
							tgljt:FlexGlobals.topLevelApplication.F_tglJatuhTempo(tglawal, AmbilJmlHari(bulantahun[2], bulantahun[1])),
							jumlah : Number(o.txttotalkredit)/Number(o.txtjmlcicilan), jumlahvalas : 0
						});
					}
						//jika harian
					else if(cmbkategori.selectedIndex == 1){
						if(Number(o.txtjmlhari) > 0){
							dg_angsuran.dataProvider.addItem({
								no:i+1, 
								angsuranke:i+1,
								tgljt:FlexGlobals.topLevelApplication.F_tglJatuhTempo(tglawal, o.txtjmlhari),
								jumlah : Number(o.txttotalkredit)/Number(o.txtjmlcicilan), jumlahvalas : 0
							});
						}
					}
					tglawal = dg_angsuran.dataProvider[i].tgljt;	
				}
				//end hitung simulasi============================================
			}
			
			protected function txtvoucher_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER){
					//FlexGlobals.topLevelApplication.F_popUpCari("AmbilVoucher");
					FlexGlobals.topLevelApplication.F_wsSearch('AmbilVoucher', 'CdM12_Pos_Voucher', 0, 0, '(vicustomdbl1 = '+p.u.getItemAt(0).sicustomer+' OR vicustomdbl1 = 0) AND vikategori = "'+FlexGlobals.topLevelApplication.m.ArrSettingPOS[0].pcskategori+'" AND vicustomtext1 = "'+txtvoucher.text+'" and vitglexpired >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal)+'" AND viisclose = 0', '');
				}
				if(event.keyCode == Keyboard.TAB){
					//FlexGlobals.topLevelApplication.F_popUpCari("AmbilVoucher");
					FlexGlobals.topLevelApplication.F_wsSearch('AmbilVoucher', 'CdM12_Pos_Voucher', 0, 0, '(vicustomdbl1 = '+p.u.getItemAt(0).sicustomer+' OR vicustomdbl1 = 0) AND vikategori = "'+FlexGlobals.topLevelApplication.m.ArrSettingPOS[0].pcskategori+'" AND vicustomtext1 = "'+txtvoucher.text+'" and vitglexpired >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal)+'" AND viisclose = 0', '');
				}
			}
			
		]]>
	</fx:Script>
