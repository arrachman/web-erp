			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.F1:
						f_simpan();
						break;
					case Keyboard.F2:
						HitungSimulasi();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						
						p.o.txtangsuran = o.txttotalkredit;
						p.txtangsuran.text = parentApplication.m.nfNominalPOS.format(p.o.txtangsuran);
						p.o.txtbiayaadminpersen = o.txtbyadminpersen;
						p.txtbiayaadminpersen.text = parentApplication.m.nfNominalPOS.format(p.o.txtbiayaadminpersen);
						p.o.txtbiayaadminnilai = o.txtbyadminnominal;
						p.txtbiayaadminnilai.text = parentApplication.m.nfNominalPOS.format(p.o.txtbiayaadminnilai);
						p.f_hitungTotalUtama();
						parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
						if(p.dg_pos.dataProviderLength == 1 && p.dg_pos.dataProvider[0].kodebarang == ""){
							FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
							parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
						}else{
							FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
						}
						
						if(p.o.txtjmlbayar < p.o.txttotaltransaksi){
							p.txtborderbayar.visible = true;
							p.bordervisible = true;
						}else{
							p.txtborderbayar.visible = false;
							p.bordervisible = false;
						}
						
						break;
					case Keyboard.F2:
						HitungSimulasi();
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						dg_angsuran.dataProvider[dg_angsuran.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg_angsuran, dg_angsuran.selectedCell.rowIndex);
						
						break;
				}
				f_hitungTotal();
				
			}
			public function f_focusOnMe():void
			{
				txtvoucher.setFocus();	
			}
			
			protected function f_persiapan():void
			{
				matauang = parentApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				kurs = parentApplication.getSetting(0, 'accounting', 'Kurs');
				p = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child;
				//fungsi inputan============================================================================================
				
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalModePOS([txtjmlhari, txtjmlkredit, txtjmlcicilan, txtbyadminpersen, txtbyadminnominal, txttotalkredit]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtvoucher]);
				FlexGlobals.topLevelApplication
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttglawalkredit]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbkategori]);
				cmbkategori.dataProvider = new ArrayCollection([{l:'Bulanan', v:0}, {l:'Harian', v:1}]);
				// fungsi menubar==========================================================================================================
				arrMenuBar = new ArrayCollection([
					{label:"[F1]. OK", icon:"tbsave", enabled:"true"},
					{label:"Batal", icon:"tbclose", enabled:"true"}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				txtjmlkredit.setFocus();
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				
				function f_mbSimpan():void
				{
					f_simpan();
					
				}
				function f_mbBuka():void
				{
				}
				function f_mbReset():void{
					//					FlexGlobals.topLevelApplication.F_defaultGridItem(dg_angsuran);
					//					FlexGlobals.topLevelApplication.closeFormPopUp(1) 
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
					
					p.o.txtangsuran = o.txttotalkredit;
					p.txtangsuran.text = parentApplication.m.nfNominalPOS.format(p.o.txtangsuran);
					p.o.txtbiayaadminpersen = o.txtbyadminpersen;
					p.txtbiayaadminpersen.text = parentApplication.m.nfNominalPOS.format(p.o.txtbiayaadminpersen);
					p.o.txtbiayaadminnilai = o.txtbyadminnominal;
					p.txtbiayaadminnilai.text = parentApplication.m.nfNominalPOS.format(p.o.txtbiayaadminnilai);
					p.f_hitungTotalUtama();
					parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
					if(p.dg_pos.dataProviderLength == 1 && p.dg_pos.dataProvider[0].kodebarang == ""){
						FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
						parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
					}else{
						FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
					}
					
					if(p.o.txtjmlbayar < p.o.txttotaltransaksi){
						p.txtborderbayar.visible = true;
						p.bordervisible = true;
					}else{
						p.txtborderbayar.visible = false;
						p.bordervisible = false;
					}
				}
				
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.S:if(e.ctrlKey)
							f_simpan();
							break;
					}
				}
				//end fungsi menu bar==============================================================================================================
				
				//change biaya admin===============================================================================================================
				txtbyadminnominal.addEventListener(TextOperationEvent.CHANGE, function():void{
					o.txtbyadminpersen = (o.txtbyadminnominal / o.txtjmlkredit) * 100;
					txtbyadminpersen.text = parentApplication.m.nfNominalPOS.format(o.txtbyadminpersen.toString());
					f_hitungTotal();
				});
				
				txtbyadminpersen.addEventListener(TextOperationEvent.CHANGE, function():void{
					o.txtbyadminnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.txtjmlkredit, o.txtbyadminpersen);
					txtbyadminnominal.text = parentApplication.m.nfNominalPOS.format(o.txtbyadminnominal.toString());
					f_hitungTotal();
				});
				
				txtjmlkredit.addEventListener(TextOperationEvent.CHANGE, function():void{
					o.txtbyadminnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.txtjmlkredit, o.txtbyadminpersen);
					txtbyadminnominal.text = parentApplication.m.nfNominalPOS.format(o.txtbyadminnominal.toString());
					f_hitungTotal();
				});
				//end biaya admin==================================================================================================================
				
				arrayhakakses = FlexGlobals.topLevelApplication.m.ArrUserMenuCustom
				for(var i:int=0;i<FlexGlobals.topLevelApplication.m.ArrUserMenuCustom.length;i++)
				{
//							Alert.show(arrayhakakses[i].mid+" && "+arrayhakakses[i].pcid+" && "+arrayhakakses[i].urakses+" && "+arrayhakakses[i].pckode+" = "+FlexGlobals.topLevelApplication.m.ArrUserMenuCustom.length);
					if(arrayhakakses[i].mid == 12 && arrayhakakses[i].pcid == 1 && arrayhakakses[i].urakses == 1){
						isfound = true; 
						break;
					}
				}
				//Alert.show(dg.columnsLength+"")
				if(isfound == true){
					cmbkategori.enabled = true;
				}else{
					cmbkategori.enabled = false;
				}
				
				// untuk ambil setting dari Json
				//FlexGlobals.topLevelApplication.F_setGridJson(4, 8);
				FlexGlobals.topLevelApplication.F_RegGrid(12,8,[dg_angsuran],'transaksi');
//				dg_angsuran.setSelectedCell(0, 1);
				f_validasi();
			}
			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				//end of set getdata by id===============================================================================================
			}
			
			
			protected function f_kondisiAwal():void
			{
				lbltotal.text = parentApplication.m.nfNominalPOS.format(0);
				dttglawalkredit.text = p.dttanggal.text;
				
				if(p.isUpdate == true){ //kondisi ketika edit
					p.f_hitungTotalUtama();
					rekbiayaadmin = p.u.getItemAt(0).sicustomtext1; //rek biaya admin
					cmbkategori.selectedIndex = p.u.getItemAt(0).sicustomint1; //kategori angsuran : bulanan/harian
					o.txtjmlkredit = p.u.getItemAt(0).sicustomdbl4; //total kredit
					o.txtjmlcicilan = p.u.getItemAt(0).sicustomdbl5; //jumlah cicilan
					o.txtbyadminpersen = p.u.getItemAt(0).sicustomdbl6; //persentase biaya admin
					o.txtbyadminnominal = p.u.getItemAt(0).sicustomdbl7; //jumlah biaya admin
					o.txttotalkredit = p.u.getItemAt(0).sicustomdbl8; //total kredit
					dttglawalkredit.text = p.u.getItemAt(0).sicustomdate1;//tanggal awal kredit
					
					txtjmlkredit.text = parentApplication.m.nfNominalPOS.format(o.txtjmlkredit);
					txtjmlcicilan.text = parentApplication.m.nfNominalPOS.format(o.txtjmlcicilan);
					txtbyadminpersen.text = parentApplication.m.nfNominalPOS.format(o.txtbyadminpersen);
					txtbyadminnominal.text = parentApplication.m.nfNominalPOS.format(o.txtbyadminnominal);
					txttotalkredit.text = parentApplication.m.nfNominalPOS.format(o.txttotalkredit);
				}else{ //kondisi ketika input awal
					rekbiayaadmin = parentApplication.getSetting(0, 'akun', 'BiayaAdminPOS')
					if(p.o.txtangsuran > 0){
						o.txtjmlkredit = p.o.txtangsuran;
					}
					else{
						o.txtjmlkredit = p.o.txttotaltransaksi - p.o.txtjmlbayar;
					}
					
					txtjmlkredit.text = parentApplication.m.nfNominalPOS.format(o.txtjmlkredit);
					o.txtjmlcicilan = Number(FlexGlobals.topLevelApplication.getSetting(12, "options", "AngsuranKredit"));
					txtjmlcicilan.text = parentApplication.m.nfNominalPOS.format(o.txtjmlcicilan)
					var biayaAdmin : Array = FlexGlobals.topLevelApplication.getSetting(12, "options", "BiayaAdm").split("|");
					if(biayaAdmin.length > 1){
						if(Number(biayaAdmin[0]) > 0){
							o.txtbyadminpersen = Number(biayaAdmin[0]);
							o.txtbyadminnominal = (Number(o.txtbyadminpersen)/100)* Number(o.txtjmlkredit);
						}
						else if(Number(biayaAdmin[1]) > 0){
							o.txtbyadminnominal = Number(biayaAdmin[1]);
							o.txtbyadminpersen = (Number(o.txtbyadminnominal)/Number(o.txtjmlkredit))* 100;
						}
					}
					o.txtlimitkredit = 0;
					txtlimitkredit.text = parentApplication.m.nfNominalPOS.format(o.txtlimitkredit);
					txtbyadminpersen.text = parentApplication.m.nfNominalPOS.format(o.txtbyadminpersen);
					txtbyadminnominal.text = parentApplication.m.nfNominalPOS.format(o.txtbyadminnominal);
				}
				
				if(p.arrdetailangsuran.length > 0){
					dg_angsuran.dataProvider = p.arrdetailangsuran;
					for(i = 0; i < dg_angsuran.dataProviderLength; i++){
						dg_angsuran.dataProvider[i].no = i+1;
					}
					idvoucher = p.arrdetailangsuran[0].customint1;
					txtvoucher.text = p.arrdetailangsuran[0].customtext1;
					o.txtlimitkredit = p.arrdetailangsuran[0].customdbl1;
					txtlimitkredit.text = parentApplication.m.nfNominalPOS.format(o.txtlimitkredit)
					f_hitungTotal();
				}else{
					dg_angsuran.dataProvider.removeAll();
					FlexGlobals.topLevelApplication.F_acAdd(dg_angsuran);
				}
				txtvoucher.setFocus();
//				dg_angsuran.setFocus();
				dg_angsuran.setSelectedCell(0,1);
				f_hitungTotal()
			}
			
			public function f_grid(dg_angsuran:DataGrid, column:String):void
			{ 
				//dg_angsuran.setSelectedCell(0,0);
