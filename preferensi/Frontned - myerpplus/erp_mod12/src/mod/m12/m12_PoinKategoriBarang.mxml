			protected function f_persiapan():void
			{
				FlexGlobals.topLevelApplication.F_TranslateLabel([ttipe]);
				//FlexGlobals.topLevelApplication.F_filterEnter([txtkode,txtnama,txtSatuan]);
				cmboperator.dataProvider = new ArrayCollection([{l:'Semua', v:-1}, {l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmboperator])
				
				
				arr = new Array;
				arr[0] = 'M12_Pos_Point_Category_ItemSearch'; 					//ws Tampil
				arr[1] = 'pcioperator asc, pcijml1 asc'; 							//ws Sort Default
				arr[2] = 'Poin per Kategori Barang'; 								//nama Form Input
				arr[3] = 'mod/m12/m12_PoinKategoriBarangInput.swf'; 		//link Form Input
				arr[4] = '700'; 								//width Form Input
				arr[5] = '460'; 								//height Form Input
				arr[6] = 'M12_Pos_Point_Category_ItemDelete'; 						//ws Delete
				arr[7] = 'M1_ItemTerkait'; 						//ws Delete
				arr[8] = [12,20];								//modulid dan menuid
				arrColumn = ['bkode', 'bnama', 'bcatatan'];
				arrHistory = ['M1_Item_HistorySearch', 'pciid', 'bkode asc']; // ws, field filter, sort, id/kode 
				FlexGlobals.topLevelApplication.F_txtpencarian([txtkategoripos, txtkategoribarang]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkategoripos])
				FlexGlobals.topLevelApplication.F_setGridJson(12, 20);
				FlexGlobals.topLevelApplication.registerGrid([dg]);
				
				F_persiapanFormMaster();
				f_kondisiAwal();
			}
			
			public function f_formMasterTampil(page:int = 1, sort:String = ''):void
			{
				if(FlexGlobals.topLevelApplication.apaBisaAkses(arr[8][0], arr[8][1], 4) == true){
					
					if(sort == '')sort = arr[1];
					FlexGlobals.topLevelApplication.F_wsSearch("tampilForm", arr[0], page, 20, f_filterdata(), sort);
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos': //kategoripos
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
						csfilter = 'pcaktif=1';
						sort = 'pckode asc';
						break;
					case 'txtkategoribarang':
						paket = 'CdM1_Item_Category';
						wsfilter = 'icaktif = 1 AND ickode ="'+txtkategoribarang.text+'"';
						csfilter = 'icaktif=1';
						sort = 'ickode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'tampilForm':
							if(FlexGlobals.topLevelApplication.wsArrUtama[i].pcimodifikasiusernama == "")
								FlexGlobals.topLevelApplication.wsArrUtama[i].pcimodifikasitgl = ""
							dg.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama; 
							dg.setSelectedCell(0,0);
							FlexGlobals.topLevelApplication.rowIndex = 0;
							imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							imglast.enabled =FlexGlobals.topLevelApplication. wsIsNext;
							txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							for(i=0;i<dg.dataProviderLength;i++)
								dg.dataProvider[i].no = (((FlexGlobals.topLevelApplication.wsCurPage-1)*20)+(i+1));
							FlexGlobals.topLevelApplication.F_dgRefresh(dg);
							dg.setFocus();
							dg.setSelectedCell(0,0);
							break;
						
						case 'txtkategoripos':
							txtkategoripos.text = parentApplication.wsArrUtama.getItemAt(0).pckode;
							lblkategoripos.text = parentApplication.wsArrUtama.getItemAt(0).pcnama;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
							FlexGlobals.topLevelApplication.F_wsGetDataById('jenispoin', 'M12_Pos_Category_SettingGetdataById', txtkategoripos.text, 0, 0, 'smodule = 0 and sgrup = "app" AND skode="Point"', 'surutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							break;
						case 'jenispoin':
							var njenispoin:int;
							ws = parentApplication.wsArrUtama.getItemAt(0);
							njenispoin = ws.pcsnilai;
							if(dg.dataProvider != null){dg.dataProvider.removeAll()}
							switch(njenispoin){
								case 0: // tidak ada poin
									txtjenispoin.text = "No Point";
									dg.enabled = false;
									mb.menuBarItems[0].enabled = false;
									mb.menuBarItems[1].enabled = false;
									mb.menuBarItems[2].enabled = false;
									mb.menuBarItems[3].enabled = false;
									mb.menuBarItems[4].enabled = false;
									break;
								case 1: // berdasarkan barang
									txtjenispoin.text = "Item Based";
									dg.enabled = true;
									mb.menuBarItems[0].enabled = true;
									mb.menuBarItems[1].enabled = true;
									mb.menuBarItems[2].enabled = true;
									mb.menuBarItems[3].enabled = true;
									mb.menuBarItems[4].enabled = true;
									break;
								case 2:
									txtjenispoin.text = "Nominal Based";
									mb.menuBarItems[0].enabled = false;
									mb.menuBarItems[1].enabled = false;
									mb.menuBarItems[2].enabled = false;
									mb.menuBarItems[3].enabled = false;
									mb.menuBarItems[4].enabled = false;
									dg.enabled = false;
									break;
								
							}
							f_formMasterTampil();
							break;
						case 'txtkategoribarang':
							txtkategoribarang.text = parentApplication.wsArrUtama.getItemAt(0).ickode;
							break;
					}
				}else{					
					if(FlexGlobals.topLevelApplication.F_validasiFalse(s) == true)
						switch(s){
							case "tampilForm":
								if(dg.dataProvider!= null){
									dg.dataProvider.removeAll()
								}
								break;
							
							case "txtkategoripos":txtkategoripos.text='';break;
							case "txtkategoribarang":txtkategoribarang.text='';break;
							
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtkategoripos":txtkategoripos.text='';break;
					case "txtkategoribarang":txtkategoribarang.text=''; lblkategoripos.text=""; break;
					case "tampilForm":
						if(dg.dataProvider!= null){
							dg.dataProvider.removeAll()
						}
						break;
				}
			}
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				var isfound:Boolean = false;
				var arrayhakakses:Object;
				parentApplication.F_KosongkanText([txtkategoribarang, txtkategoripos, lblkategoripos]);
				cmboperator.selectedIndex = 0;
				if(dg.dataProvider != null){
					dg.dataProvider.removeAll();
				}
				
			}
			
			public var vfileextention:int=0;
			
			public function f_cekterpilih():Boolean{if(dg.selectedCell == null){return false}else{return true}}
			public function f_paramDelete():String{return dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pcikategori+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pcikategoribarang+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pcioperator+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pcijml1+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pcijml2}
			public function f_filterdata():String{
				var f:String = '';
				
				if(txtkategoribarang.text != '')
					f = parentApplication.TambahFilter(f, 'pcikategoribarang = "'+txtkategoribarang.text.split('"').join('\\"')+'"');
				if(cmboperator.selectedIndex > 0)
					f = parentApplication.TambahFilter(f, 'pcioperator = "'+cmboperator.selectedItem.v+'"');
				if(txtkategoripos.text != '')
					f = parentApplication.TambahFilter(f, 'pcikategori = "'+txtkategoripos.text.split('"').join('\\"')+'"');
				
				return f;
			}
			
			
