			public function f_grid_change():void{
				arr[9] = ["Item",dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bnama,dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).diid];
			}
			public function f_focusOnMe():void
			{
				txtkategoripos.setFocus();
