			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						dg_member.dataProvider[dg_member.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg_member, dg_member.selectedCell.rowIndex);
						
						break;
				}
				f_hitungTotal();
				
			}
			public function f_focusOnMe():void
