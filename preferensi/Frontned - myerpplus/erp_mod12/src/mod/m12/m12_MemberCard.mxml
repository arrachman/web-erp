			protected function f_persiapan():void
			{
				arrData = FlexGlobals.topLevelApplication.FormFilter.split("|");
				matauang = parentApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				kurs = parentApplication.getSetting(0, 'accounting', 'Kurs');
				p = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child;
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkupon, txtshu, txtsukarela, txttunaim]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnoslip]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtnoslip])
				parentApplication.F_TranslateLabel([tnomor, tnama, tkupon, tshu, ttotalbelanja, ttotalbayarmember, tkembali, tkupon2, tshu2]);
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Batal", icon:"tbclose", enabled:"true"}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				
				function f_mbSimpan():void
				{
					f_simpan()
				}
				
				function f_mbBuka():void
				{
				}
				
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
					p.o.txtkartumember = Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela);
					p.txtkartumember.text = parentApplication.m.nfNumber.format(p.o.txtkartumember);
					p.f_hitungTotalUtama();
					parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
					if(p.dg_pos.dataProviderLength == 1 && p.dg_pos.dataProvider[0].kodebarang == ""){
						FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
						parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
					}else{
						FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
					}
				}
				
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.S:if(e.ctrlKey)
							f_simpan();
							break;
					}
				}
				//inputan kupon
				txtkupon.addEventListener(spark.events.TextOperationEvent.CHANGE,function  ():void{
//					f_hitungTotalUtama();
					p.f_PoleDisplayBayar("Kupon", parentApplication.m.nfNominalPOS.format(o.txtkupon));

				});
				//inputan sukarela
				txtshu.addEventListener(spark.events.TextOperationEvent.CHANGE,function  ():void{
					//					f_hitungTotalUtama();
					p.f_PoleDisplayBayar("SHU", parentApplication.m.nfNominalPOS.format(o.txtshu));
					
				});
				//inputan sukarela
				txtsukarela.addEventListener(spark.events.TextOperationEvent.CHANGE,function  ():void{
					//					f_hitungTotalUtama();
					p.f_PoleDisplayBayar("Sukarela", parentApplication.m.nfNominalPOS.format(o.txtsukarela));
					
				});
				txttunaim.addEventListener(spark.events.TextOperationEvent.CHANGE,function  ():void{
					//					f_hitungTotalUtama();
					p.f_PoleDisplayBayar("Tunai", parentApplication.m.nfNominalPOS.format(o.txttunaim));
					
				});
				
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(12, 8, [dg_member], 'data2');
				no_ang = arrData[0];
				lblnomor.text = arrData[1];
				lblnama.text = arrData[2];
				lbltotalbelanja.text = parentApplication.m.nfNominalPOS.format(arrData[3]);
				totalBelanja = arrData[3];
				
				FlexGlobals.topLevelApplication.F_wsSearch("tampil", "M12_GetValueMember", 0, 0, "no_ang = '"+no_ang+"'");
				
				f_validasi();
			}
			
			public function f_validasi():void
			{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				//end ofset getdata by id===============================================================================================
			}
			
			protected function f_kondisiAwal():void
			{
				
				if(p.arrmembercard.length > 0){
					txtnoslip.text = p.arrmembercard[0].noacbank;
					for(i=0;i<p.arrmembercard.length;i++)
					{
						if(p.arrmembercard[i].carabayar == 8)
							o.txtkupon = p.arrmembercard[i].jumlah;
						if(p.arrmembercard[i].carabayar == 9)
							o.txtshu = p.arrmembercard[i].jumlah;
						if(p.arrmembercard[i].carabayar == 10)
							o.txtsukarela = p.arrmembercard[i].jumlah;
					}
					o.txttunaim = p.o.txttunai;
					
					txtkupon.text = parentApplication.m.nfNominalPOS.format(o.txtkupon);
					txtshu.text = parentApplication.m.nfNominalPOS.format(o.txtshu);
					txtsukarela.text = parentApplication.m.nfNominalPOS.format(o.txtsukarela);
					txttunaim.text = parentApplication.m.nfNominalPOS.format(o.txttunaim);				
					
					lbltotalbayarmember.text = parentApplication.m.nfNominalPOS.format(Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela)+Number(o.txttunaim));
					lblkembali.text = parentApplication.m.nfNominalPOS.format(-1*(totalBelanja - (Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela)+Number(o.txttunaim))));
					
					f_hitungTotal();
				}
				
				dg_member.setFocus();
				dg_member.setSelectedCell(0,1);
			}
			
			public function f_grid(dg_member:DataGrid, column:String):void
			{ 
				switch(column){
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg_member);
				f_hitungTotal()
			}
			
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, dgrid:Object;
				if(dg_member.selectedCell != null)dgrid = dg_member.dataProvider.getItemAt(dg_member.selectedCell.rowIndex);
				switch(target){
					case  "txtnoslip":
						if(o.txtkupon == 0 && o.txtshu == 0)
						{
							txtkupon.setFocus();
							Alert.show("Isi Kupon dan SHU terlebih dahulu", "Informasi");
						}
						else
						paket = "CdM12_MemberSlip";
//						no_ang = "0420130785";
						wsfilter = 'b.No_ang = "'+no_ang+'"';
						csfilter = 'b.No_ang = "'+no_ang+'"';
						sort = 'a.DateTime DESC';
					break;
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				var ob : Object;
				if(FlexGlobals.topLevelApplication.wsSuccess == true){
					ws = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'tampil':
							
							dg_member.dataProvider.removeAll();
							for(var a: int = 0; a<FlexGlobals.topLevelApplication.wsArrUtama.length; a++){
								
								dg_member.dataProvider.addItem({keterangan : FlexGlobals.topLevelApplication.wsArrUtama[a].keterangan, 
								saldo : FlexGlobals.topLevelApplication.wsArrUtama[a].saldo, 
								sisasaldo : FlexGlobals.topLevelApplication.wsArrUtama[a].sisasaldo})
							}
							txtkupon.setFocus();
							
							if(p.arrmembercard.length > 0)
							{
								txtnoslip.text = p.arrmembercard[0].noacbank;
								if(String(p.arrmembercard[0].carabayar) == "8")
								{
									o.txtkupon = p.arrmembercard[0].jumlah;
								}
								else if(String(p.arrmembercard[0].carabayar) == "9")
								{
									o.txtshu = p.arrmembercard[0].jumlah;
								}
								else if(String(p.arrmembercard[0].carabayar) == "10")
								{
									o.txtsukarela = p.arrmembercard[0].jumlah;
								}
								
								if(p.arrmembercard.length > 1)
								{
									if(String(p.arrmembercard[1].carabayar) == "8")
									{
										o.txtkupon = p.arrmembercard[1].jumlah;
									}
									else if(String(p.arrmembercard[1].carabayar) == "9")
									{
										o.txtshu = p.arrmembercard[1].jumlah;
									}
									else if(String(p.arrmembercard[1].carabayar) == "10")
									{
										o.txtsukarela = p.arrmembercard[1].jumlah;
									}
								}
							}
							ows.mskupon = o.txtkupon;
							ows.msshu = o.txtshu;
							ows.mssukarela = o.txtsukarela;
							o.txttunaim = p.o.txttunai;
							
							txtkupon.text = parentApplication.m.nfNominalPOS.format(ows.mskupon);
							txtshu.text = parentApplication.m.nfNominalPOS.format(ows.msshu);
							txtsukarela.text = parentApplication.m.nfNominalPOS.format(ows.mssukarela);
							txttunaim.text = parentApplication.m.nfNominalPOS.format(o.txttunaim);
							
							lblkupon.text = parentApplication.m.nfNominalPOS.format(o.txtkupon);
							lblshu.text = parentApplication.m.nfNominalPOS.format(o.txtshu);
							lblsukarela.text = parentApplication.m.nfNominalPOS.format(o.txtsukarela);
							
							var i:int;
							for(i=0;i<dg_member.dataProviderLength;i++)
							{
								if(dg_member.dataProvider[i].keterangan == "Kupon Belanja") 
								{
									dg_member.dataProvider[0].sisasaldo = dg_member.dataProvider[i].saldo - o.txtkupon;
									dg_member.dataProvider.setItemAt(dg_member.dataProvider.getItemAt(i), i);
								}
								
								if(dg_member.dataProvider[i].keterangan == "Sisa Hasil Usaha (SHU)")
								{
									dg_member.dataProvider[i].sisasaldo = dg_member.dataProvider[i].saldo - o.txtshu;
									dg_member.dataProvider.setItemAt(dg_member.dataProvider.getItemAt(i), i);
								}
								
								if(dg_member.dataProvider[i].keterangan == "Simpanan Sukarela")
								{
									dg_member.dataProvider[i].sisasaldo = dg_member.dataProvider[i].saldo - o.txtsukarela;
									dg_member.dataProvider.setItemAt(dg_member.dataProvider.getItemAt(i), i);
								}
							}
							
							lbltotalbayarmember.text = parentApplication.m.nfNominalPOS.format(Number(o.txtkupon)+Number(o.txtshu)+Number(o.txttunaim));
							lblkembali.text = parentApplication.m.nfNominalPOS.format(-1*(totalBelanja - (Number(o.txtkupon)+Number(o.txtshu)+Number(o.txttunaim))));
							
							break; 
						case 'bank': 
							ob = dg_member.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex);
							ob.bank = ws.bkode;
							ob.rekbank = parentApplication.getSetting(0, 'akun', 'KartuKredit');
							ob.rekbanknama = parentApplication.getSetting(0, 'akunnama', 'KartuKredit');
							break;
						case 'rekbank':
							ob = dg_member.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex);
							ob.rekbank = ws.cnomor;
							ob.rekbanknama = ws.cnama;
							break;
						case  'txtnoslip': 
							ob = parentApplication.wsArrUtama.getItemAt(0);
							ows = ob;
							txtnoslip.text = ob.msslip;
							lblkupon.text = parentApplication.m.nfNominalPOS.format(ob.mskupon);
							lblshu.text = parentApplication.m.nfNominalPOS.format(ob.msshu);
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'bank': 
								ob = dg_member.dataProvider.getItemAt(dg_member.selectedCell.rowIndex);
								ob.bank = '';
								ob.rekbank = parentApplication.getSetting(0, 'akun', 'KartuKredit');
								ob.rekbanknama = parentApplication.getSetting(0, 'akunnama', 'KartuKredit');
								break;
							case 'rekbank':
								ob = dg_member.dataProvider.getItemAt(dg_member.selectedCell.rowIndex);
								ob.rekbank = "";
								ob.rekbanknama = "";
								break;
							case  'txtnoslip': 
								txtnoslip.text = "";
								lblkupon.text = parentApplication.m.nfNominalPOS.format(0);
								lblshu.text = parentApplication.m.nfNominalPOS.format(0);
								break;
							case  'tampil': 
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch (target){
					case  'txtnoslip': 
						txtnoslip.text = "";
						lblkupon.text = parentApplication.m.nfNominalPOS.format(0);
						lblshu.text = parentApplication.m.nfNominalPOS.format(0);
						break;
				}
				
			}
			
			protected function f_simpan():void
			{
				if(o.txtkupon == 0 && o.txtshu == 0 && o.txtsukarela == 0)
				{
					txtkupon.setFocus();
					Alert.show("Isi Kupon, SHU atau Sukarela terlebih dahulu", "Informasi");
					return;
				}
				
				if(txtnoslip.text.length > 0)
				{
					if(o.txtkupon != ows.mskupon)
					{
						txtkupon.setFocus();
						Alert.show("Input Kupon dengan Slip Kupon harus sama", "Informasi");
						return;
					}
					
					if(o.txtshu != ows.msshu)
					{
						txtkupon.setFocus();
						Alert.show("Input SHU dengan Slip SHU harus sama", "Informasi");
						return;
					}
					
					if(o.txtsukarela != ows.mssukarela)
					{
						txtsukarela.setFocus();
						Alert.show("Input sukarela dengan Slip sukarela harus sama", "Informasi");
						return;
					}
					
					if(p.arrmembercard.length > 0)
					{
						p.arrmembercard.removeAll();
					}
					
					if(o.txtkupon > 0)
					{
						p.arrmembercard.addItem({idsicarabayar:0, idsi:0, carabayar: 8, matauang:matauang, kurs:kurs, jumlah:o.txtkupon, jumlahvalas:0, 
							nogiro:dg_member.dataProvider[0].sisasaldo, tgljt:FlexGlobals.topLevelApplication.DefaultTanggal, bank:"", noacbank:txtnoslip.text, 
							rekbank:parentApplication.getSetting(0, 'akun', 'Kupon'), rekgiro:"", catatan:"", 
							urutan:p.arrmembercard.length+1, isclose:0});
					}
					
					if(o.txtshu > 0)
					{
						p.arrmembercard.addItem({idsicarabayar:0, idsi:0, carabayar: 9, matauang:matauang, kurs:kurs, jumlah:o.txtshu, jumlahvalas:0, 
							nogiro:dg_member.dataProvider[1].sisasaldo, tgljt:FlexGlobals.topLevelApplication.DefaultTanggal, bank:"", noacbank:txtnoslip.text, 
							rekbank:parentApplication.getSetting(0, 'akun', 'SHU'), rekgiro:"", catatan:"", 
							urutan:p.arrmembercard.length+1, isclose:0});
					}
					
					if(o.txtsukarela > 0)
					{
						p.arrmembercard.addItem({idsicarabayar:0, idsi:0, carabayar: 10, matauang:matauang, kurs:kurs, jumlah:o.txtsukarela, jumlahvalas:0, 
							nogiro:dg_member.dataProvider[2].sisasaldo, tgljt:FlexGlobals.topLevelApplication.DefaultTanggal, bank:"", noacbank:txtnoslip.text, 
							rekbank:parentApplication.getSetting(0, 'akun', 'Sukarela'), rekgiro:"", catatan:"",  
							urutan:p.arrmembercard.length+1, isclose:0});
					}
					
					if(o.txtsukarela > 0)
					{
						p.arrmembercard.addItem({idsicarabayar:0, idsi:0, carabayar: 10, matauang:matauang, kurs:kurs, jumlah:o.txtsukarela, jumlahvalas:0, 
							nogiro:dg_member.dataProvider[2].sisasaldo, tgljt:FlexGlobals.topLevelApplication.DefaultTanggal, bank:"", noacbank:txtnoslip.text, 
							rekbank:parentApplication.getSetting(0, 'akun', 'Sukarela'), rekgiro:"", catatan:"",  
							urutan:p.arrmembercard.length+1, isclose:0});
					}
					
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
					
					p.o.txtkartumember = Number(o.txtkupon) + Number(o.txtshu) + Number(o.txtsukarela);
					p.o.txttunai = Number(o.txttunaim);
					p.txttunai.text = parentApplication.m.nfNumber.format(p.o.txttunai);
					p.txtkartumember.text = parentApplication.m.nfNumber.format(p.o.txtkartumember);
					p.f_hitungTotalUtama();
					p.NoSlip = txtnoslip.text;
					p.SaldoKupon = dg_member.dataProvider[0].sisasaldo;
					p.SaldoSHU = dg_member.dataProvider[1].sisasaldo;
					p.SaldoSukarela = dg_member.dataProvider[2].sisasaldo;
					p.Kupon = o.txtkupon;
					p.SHU = o.txtshu;
					p.Sukarela = o.txtsukarela;
					
					if(p.o.txtjmlbayar < p.o.txttotaltransaksi){
						p.txtborderbayar.visible = true;
						p.bordervisible = true;
					}else{
						p.txtborderbayar.visible = false;
						p.bordervisible = false;
					}
					
					if(p.dg_pos.dataProviderLength == 1 && p.dg_pos.dataProvider[0].kodebarang == ""){
						FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
						parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
					}
					else{
						parentApplication.F_hapusBarisKosongGrid(p.dg_pos);
						FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
					}
				}else{
					Alert.show("No Slip harus diisi terlebih dahulu", "Informasi");
				}
			}
			
			private var vtotal:Number=0, vvalas:Number=0;
			public function f_hitungTotal():void
			{
			}
			 
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
			
			protected function txtkupon_changeHandler(event:TextOperationEvent):void
			{
				o.txtkupon = event.currentTarget.text.split(parentApplication.m.nfNominal.decimalSeparator).join('.');
				dg_member.dataProvider[0].sisasaldo = dg_member.dataProvider[0].saldo - o.txtkupon;
				dg_member.dataProvider.setItemAt(dg_member.dataProvider.getItemAt(0), 0);
				
				lbltotalbayarmember.text = parentApplication.m.nfNominalPOS.format(Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela));
				lblkembali.text = parentApplication.m.nfNominalPOS.format(-1*(totalBelanja - (Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela))));
			}
			
			protected function txtshu_changeHandler(event:TextOperationEvent):void
			{
				o.txtshu = event.currentTarget.text.split(parentApplication.m.nfNominal.decimalSeparator).join('.');
				dg_member.dataProvider[1].sisasaldo = dg_member.dataProvider[1].saldo - o.txtshu;
				dg_member.dataProvider.setItemAt(dg_member.dataProvider.getItemAt(1), 1);

				lbltotalbayarmember.text = parentApplication.m.nfNominalPOS.format(Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela));
				lblkembali.text = parentApplication.m.nfNominalPOS.format(-1*(totalBelanja - (Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela))));
			}
			
			protected function txtsukarela_changeHandler(event:TextOperationEvent):void
			{
				o.txtsukarela = event.currentTarget.text.split(parentApplication.m.nfNominal.decimalSeparator).join('.');
				dg_member.dataProvider[2].sisasaldo = dg_member.dataProvider[2].saldo - o.txtsukarela;
				dg_member.dataProvider.setItemAt(dg_member.dataProvider.getItemAt(1), 1);
				
				lbltotalbayarmember.text = parentApplication.m.nfNominalPOS.format(Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela));
				lblkembali.text = parentApplication.m.nfNominalPOS.format(-1*(totalBelanja - (Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela))));
			}
			protected function txttunaim_changeHandler(event:TextOperationEvent):void
			{
				o.txttunaim = event.currentTarget.text.split(parentApplication.m.nfNominal.decimalSeparator).join('.');
				
				lbltotalbayarmember.text = parentApplication.m.nfNominalPOS.format(Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela)+Number(o.txttunaim));
				lblkembali.text = parentApplication.m.nfNominalPOS.format(-1*(totalBelanja - (Number(o.txtkupon)+Number(o.txtshu)+Number(o.txtsukarela)+Number(o.txttunaim))));
			}
			
			protected function txtkupon_focusOutHandler(event:FocusEvent):void
			{
				if(Number(dg_member.dataProvider[0].sisasaldo) < 0)
				{
					Alert.show('Saldo Kupon Belanja tidak boleh minus', 'Informasi', 4, null, function(e:Object):void{
						if(e.detail == Alert.OK){
							txtkupon.setFocus();
						}
					});
				} 
			}
			
			protected function txtsukarela_focusOutHandler(event:FocusEvent):void
			{
				if(Number(dg_member.dataProvider[0].sisasaldo) < 0)
				{
					Alert.show('Saldo Simpanan Sukarela tidak boleh minus', 'Informasi', 4, null, function(e:Object):void{
						if(e.detail == Alert.OK){
							txtsukarela.setFocus();
