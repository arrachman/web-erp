<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid, i:int;
			public var o:Object = {};
			
			public function F_SetNavigasiKeyboard(ar:Array):void
			{
				for(i=0;i<ar.length;i++)
					ar[i].addEventListener(KeyboardEvent.KEY_DOWN, Obj_keyDownHandler);	
				
				function Obj_keyDownHandler(event:KeyboardEvent):void
				{
					if((event.keyCode==Keyboard.DOWN)||(event.keyCode==Keyboard.ENTER))
						focusMgr();
					else if(event.keyCode==Keyboard.UP)
						focusMgr(true);
				}	
			}
			
			public function focusMgr(backward:Boolean = false):void
			{
				focusManager.getNextFocusManagerComponent(backward).setFocus();
			}
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkode,tnama,tcatatan]);
				FlexGlobals.topLevelApplication.F_txtInOut(txtkode,'','M1_Price_CategoryCekId');
				FlexGlobals.topLevelApplication.F_configMasterInput();
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode, tnama]);
				F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled=false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].pckode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].pcnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].pccatatan;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].pcaktif));
					userEdit = parentApplication.userid;
					o.occustomtext1 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomtext1;
					o.occustomtext2 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomtext2;
					o.occustomtext3 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomtext3;
					o.occustomtext4 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomtext4;
					o.occustomtext5 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomtext5;
					o.occustomint1 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomint1;
					o.occustomint2 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomint2;
					o.occustomint3 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomint3;
					o.occustomdbl1 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomdbl1;
					o.occustomdbl2 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomdbl2;
					o.occustomdbl3 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomdbl3;
					o.occustomdate1 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomdate1;
					o.occustomdate2 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomdate2;
					o.occustomdate3 = dg.dataProvider[dg.selectedCell.rowIndex].pccustomdate3;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan]);
				o.occustomtext1 = ''; o.occustomtext2 = ''; o.occustomtext3 = ''; o.occustomtext4 = ''; o.occustomtext5 = '';
				o.occustomint1 = 0; o.occustomint2 = 0; o.occustomint3 = 0; o.occustomdbl1 = 0; o.occustomdbl2 = 0; o.occustomdbl3 = 0;
				o.occustomdate1 = parentApplication.m.DateFirst; o.occustomdate2 = parentApplication.m.DateFirst; o.occustomdate3 = parentApplication.m.DateFirst; 
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt,
						o.occustomtext1, o.occustomtext2, o.occustomtext3, o.occustomtext4, 
						o.occustomtext5, int(o.occustomint1), int(o.occustomint2), int(o.occustomint3), Number(o.occustomdbl1), Number(o.occustomdbl2), Number(o.occustomdbl3), 
						parentApplication.F_tglFormatDB(o.occustomdate1), parentApplication.F_tglFormatDB(o.occustomdate2), parentApplication.F_tglFormatDB(o.occustomdate3)];
					utama = parentApplication.F_splitArrayToString(arr);
					FlexGlobals.topLevelApplication.F_MasterSimpan(baru, 'M1_Price_CategorySimpan', utama, 'pckode')
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="tcatatan" left="9" top="87" text="Catatan"/>
	<s:TextInput id="txtkode" y="40" left="70" width="270" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="61" maxChars="100" />
	<s:TextArea id="txtcatatan" left="70" right="10" top="82" bottom="10" maxChars="250"/>	
	<s:CheckBox id="chkaktif" x="348" y="40" label="Aktif" selected="true"/>
</s:Module>
