<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%"
		  creationComplete="f_persiapan();" keyDown="f_keyDownModule(event)" initialize="this.setFocus()">
	<fx:Script> 
		<![CDATA[			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Text;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.Image;
			import spark.components.NumericStepper;
			import spark.components.RadioButton;
			
			public var validasi:Boolean, pesanAlertIng:String, pesanAlert:String, img:Image, vfilter:String, 
			i:int, fu:Object, isUpdate:Boolean, hf:Object, ft:Object, p:Object;
			public var o:Object={};
			public var arrColumn:Array = new Array;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.F1:
						f_simpan();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
								
			}
			public function f_focusOnMe():void
			{
				dg_kapasitas.setFocus();	
			}
			
			protected function f_persiapan():void
			{
				
				p = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child;
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Batal", icon:"tbclose", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				
				FlexGlobals.topLevelApplication.F_TranslateLabel([lmesin]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([lmesin]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtmesin])
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				
				
				function f_mbSimpan():void
				{
					f_simpan();
					
				}
				function f_mbTampilkan():void
				{
					if(txtmesin.text.length > 0){
						vfilter = " kodemesin = '"+txtmesin.text+"' "
							
						if (dttgl1.text.length > 0 && dttgl2.text.length > 0){
							vfilter += " AND tgl BETWEEN '"+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+"' AND '"+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+"'";
						}else if (dttgl1.text.length > 0){
							vfilter += " AND tgl >= '"+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+"'";
						}else if (dttgl2.text.length > 0){
							vfilter += " AND tgl <= '"+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+"'";
						}
						FlexGlobals.topLevelApplication.F_wsSearch('CapacitySearch', 'M1_Machine_CapacitySearch', 0, 0, vfilter,"kodemesin asc, tgl asc");
					}else{
						Alert.show(FlexGlobals.topLevelApplication.l("Mesin harus diisi terlebih dahulu."),FlexGlobals.topLevelApplication.l("Informasi"))
					}
				}
				
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
									}
				
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.S:if(e.ctrlKey)
							f_simpan();
							break;
					}
				}
				
				// untuk ambil setting dari Json
				//FlexGlobals.topLevelApplication.F_setGridJson(4, 8);
				FlexGlobals.topLevelApplication.F_RegGrid(1,95,[dg_kapasitas],'transaksi');
				dg_kapasitas.setSelectedCell(0, 1);
				f_validasi();
			}
			
			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				//end ofset getdata by id===============================================================================================
			}
			
			
			
			protected function f_kondisiAwal():void
			{
				parentApplication.F_KosongkanText([txtmesin, lmesinnama, dttgl1, dttgl2]);	
				FlexGlobals.topLevelApplication.F_defaultGridItem(dg_kapasitas)
				dg_kapasitas.setFocus();
				dg_kapasitas.setSelectedCell(0,1);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case "tgl":
						with(dg_kapasitas.dataProvider.getItemAt(dg_kapasitas.selectedCell.rowIndex)){
							kodemesin=txtmesin.text,
							tgl=tgl,
							kapasitas=kapasitas,
							satuan='',
							catatan=catatan,
							inputuser=parentApplication.userid,
							inputtgl=FlexGlobals.topLevelApplication.DefaultTanggal,
							modifikasiuser=parentApplication.userid,
							modifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal,
							customtext1='',
							customtext2='',
							customtext3='',
							customtext4='',
							customtext5='',
							customint1=0,
							customint2=0,
							customint3=0,
							customdbl1=0,
							customdbl2=0,
							customdbl3=0,
							customdate1=FlexGlobals.topLevelApplication.DefaultTanggal,
							customdate2=FlexGlobals.topLevelApplication.DefaultTanggal,
							customdate3=FlexGlobals.topLevelApplication.DefaultTanggal,
							visupdate=1
						}
						break;	
					case "add":
						if (dg_kapasitas.selectedCell != null) {
						with(dg_kapasitas.dataProvider.getItemAt(dg_kapasitas.selectedCell.rowIndex)){
							kodemesin=txtmesin.text,
								satuan='',
								inputuser=parentApplication.userid,
								inputtgl=FlexGlobals.topLevelApplication.DefaultTanggal,
								modifikasiuser=parentApplication.userid,
								modifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal,
								customtext1='',
								customtext2='',
								customtext3='',
								customtext4='',
								customtext5='',
								customint1=0,
								customint2=0,
								customint3=0,
								customdbl1=0,
								customdbl2=0,
								customdbl3=0,
								customdate1=FlexGlobals.topLevelApplication.DefaultTanggal,
								customdate2=FlexGlobals.topLevelApplication.DefaultTanggal,
								customdate3=FlexGlobals.topLevelApplication.DefaultTanggal,
								visupdate=1
						}
						}
						break;
					case "kapasitas":
						with(dg_kapasitas.dataProvider.getItemAt(dg_kapasitas.selectedCell.rowIndex)){
							visupdate=1
						}
						break;
					case "catatan":
						with(dg_kapasitas.dataProvider.getItemAt(dg_kapasitas.selectedCell.rowIndex)){
							visupdate=1
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, dgrid:Object;
				switch(target){
					case "txtmesin":
						paket = "CdM1_Machine";
						wsfilter = 'mkode = "'+txtmesin.text+'"';
						csfilter = '';
						sort = 'mkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				var ob : Object;
				if(FlexGlobals.topLevelApplication.wsSuccess == true){
					ws = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						
						case 'txtmesin': 
							txtmesin.text = ws.mkode;
							lmesinnama.text = ws.mnama;
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg_kapasitas)
							if (dg_kapasitas.selectedCell != null) {
								with(dg_kapasitas.dataProvider.getItemAt(dg_kapasitas.selectedCell.rowIndex)){
										kodemesin=txtmesin.text,
										tgl=tgl,
										kapasitas=kapasitas,
										satuan='',
										catatan=catatan,
										inputuser=parentApplication.userid,
										inputtgl=FlexGlobals.topLevelApplication.DefaultTanggal,
										modifikasiuser=parentApplication.userid,
										modifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal,
										customtext1='',
										customtext2='',
										customtext3='',
										customtext4='',
										customtext5='',
										customint1=0,
										customint2=0,
										customint3=0,
										customdbl1=0,
										customdbl2=0,
										customdbl3=0,
										customdate1=FlexGlobals.topLevelApplication.DefaultTanggal,
										customdate2=FlexGlobals.topLevelApplication.DefaultTanggal,
										customdate3=FlexGlobals.topLevelApplication.DefaultTanggal,
										visupdate=1
								}
							}
							
							break;
						case 'CapacitySearch': 
							dg_kapasitas.dataProvider.removeAll()
							for(var i:int = 0; i < FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama[i]){
									//Alert.show(harga);
									dg_kapasitas.dataProvider.addItem({no:dg_kapasitas.dataProviderLength +1, 
										kodemesin:kodemesin,
										tgl:tgl,
										kapasitas:kapasitas,
										satuan:satuan,
										catatan:catatan,
										inputuser:inputuser,
										inputtgl:inputtgl,
										modifikasiuser:modifikasiuser,
										modifikasitgl:modifikasitgl,
										customtext1:customtext1,
										customtext2:customtext2,
										customtext3:customtext3,
										customtext4:customtext4,
										customtext5:customtext5,
										customint1:customint1,
										customint2:customint2,
										customint3:customint3,
										customdbl1:customdbl1,
										customdbl2:customdbl2,
										customdbl3:customdbl3,
										customdate1:customdate1,
										customdate2:customdate2,
										customdate3:customdate3,
										visupdate:0
									});
								}
							}
							break;
						case 'simpan':
							FlexGlobals.topLevelApplication.FormFilter = '';
							f_kondisiAwal();
							Alert.show(parentApplication.l("Data berhasil disimpan."), parentApplication.l('Informasi'))
							break;
						
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'txtmesin': 
								txtmesin.text = '';
								lmesinnama.text = '';
								break;
							case 'simpan':
								Alert.show(parentApplication.l(FlexGlobals.topLevelApplication.wsErrmessage), parentApplication.l('Informasi'));
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtmesin': 
						txtmesin.text = '';
						lmesinnama.text = '';
						break;
				}
			}
			
			protected function f_simpan():void
			{
				var detail:String = ''
				
				if(txtmesin.text.length == 0){
					Alert.show(FlexGlobals.topLevelApplication.l("Mesin harus diisi terlebih dahulu."),FlexGlobals.topLevelApplication.l("Informasi"))
				}else{
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg_kapasitas);
					
					for(i=0;i<dg_kapasitas.dataProviderLength;i++)
						with(dg_kapasitas.dataProvider.getItemAt(i)){
							if (visupdate == 1) {
								a = [txtmesin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(tgl), kapasitas, '', catatan, 
									inputuser, parentApplication.F_tglFormatDB(inputtgl), modifikasiuser, 
									parentApplication.F_tglFormatDB(modifikasitgl), customtext1, customtext2, customtext3, 
									customtext4, customtext5, customint1, customint2, customint3, customdbl1, customdbl2, 
									customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
								
								if(detail.length == 0){
									detail =  FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}else {
									detail += "▲"+ FlexGlobals.topLevelApplication.F_splitArrayToString(a);	
								}
							}
						}
					if (detail.length > 0 ){
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M1_Machine_Capacity", parentApplication.userid, true, detail);	
					}
						
				}
			}
			
						
			[Bindable] [Embed(source="assets/tb/preview.png")] public var tbpreview:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
	</fx:Declarations>	
	<s:DataGrid id="dg_kapasitas" left="0" right="2" top="86" bottom="9"/>
	<mx:MenuBar id="mb" left="0" right="2" top="0" height="30"/>
	<s:TextInput id="txtmesin" left="60" top="35"/>
	<s:Label id="lmesin" left="6" top="40" text="Mesin"/>
	<s:Label id="lmesinnama" left="210" top="40" width="255" text=""/>
	<mx:DateField id="dttgl2" left="248" top="56" width="153"/>
	<s:Label id="ltgl" left="6" top="61" text="Tanggal"/>
	<s:Label id="lsd" left="219" top="61" text="s/d"/>
	<mx:DateField id="dttgl1" left="60" top="56" width="153"/>
	
</s:Module>