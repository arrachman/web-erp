<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tcatatan, tnama0]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_SizeCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtbarcode, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].skode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].snama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].scatatan;
					o.scustomtext1=dg.dataProvider[dg.selectedCell.rowIndex].scustomtext1; 
					o.scustomtext2=dg.dataProvider[dg.selectedCell.rowIndex].scustomtext2; 
					o.scustomtext3=dg.dataProvider[dg.selectedCell.rowIndex].scustomtext3;
					o.scustomtext4=dg.dataProvider[dg.selectedCell.rowIndex].scustomtext4; 
					o.scustomtext5=dg.dataProvider[dg.selectedCell.rowIndex].scustomtext5; 
					o.scustomint1=dg.dataProvider[dg.selectedCell.rowIndex].scustomint1; 
					o.scustomint2=dg.dataProvider[dg.selectedCell.rowIndex].scustomint2; 
					o.scustomint3=dg.dataProvider[dg.selectedCell.rowIndex].scustomint3; 
					o.scustomdbl1=dg.dataProvider[dg.selectedCell.rowIndex].scustomdbl1; 
					o.scustomdbl2=dg.dataProvider[dg.selectedCell.rowIndex].scustomdbl2; 
					o.scustomdbl3=dg.dataProvider[dg.selectedCell.rowIndex].scustomdbl3; 
					o.scustomdate1=dg.dataProvider[dg.selectedCell.rowIndex].scustomdate1; 
					o.scustomdate2=dg.dataProvider[dg.selectedCell.rowIndex].scustomdate2; 
					o.scustomdate3=dg.dataProvider[dg.selectedCell.rowIndex].scustomdate3;
					txtbarcode.text = dg.dataProvider[dg.selectedCell.rowIndex].sindexbarcode;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].saktif));
					vUserIdEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtbarcode,txtcatatan]);
				chkaktif.selected = true;
				o.scustomtext1=""; o.scustomtext2=""; o.scustomtext3=""; o.scustomtext4=""; o.scustomtext5=""; o.scustomint1=0; 
				o.scustomint2=0; o.scustomint3=0; o.scustomdbl1=0; o.scustomdbl2=0; o.scustomdbl3=0; o.scustomdate1=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.scustomdate2=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.scustomdate3=FlexGlobals.topLevelApplication.DefaultTanggal;o.sindexbarcode="";
				
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					//					skode, snama, scatatan, saktif, sinputuser, sinputtgl, smodifikasiuser, 
					//					smodifikasitgl, 
					//					scustomtext1, scustomtext2, scustomtext3, scustomtext4, scustomtext5, scustomint1, 
					//					scustomint2, scustomint3, scustomdbl1, scustomdbl2, scustomdbl3, scustomdate1, scustomdate2, 
					//					scustomdate3
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt,
						o.scustomtext1, o.scustomtext2, o.scustomtext3, o.scustomtext4, o.scustomtext5, o.scustomint1, 
						o.scustomint2, o.scustomint3, o.scustomdbl1, o.scustomdbl2, o.scustomdbl3, 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.scustomdate1), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.scustomdate2), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.scustomdate3), txtbarcode.text];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_SizeSimpan', utama, 'skode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="65" text="Nama"/>
	<s:Label id="tcatatan" left="10" top="107" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="70" width="270"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58"/>
	<s:TextInput id="txtbarcode" left="70" right="10" top="79"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="100" bottom="10" maxChars="250"/>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:CheckBox id="chkaktif" x="344" y="38" label="Aktif" selected="true"/>
	<s:Label id="tnama0" left="10" top="86" text="Barcode"/>
</s:Module>
