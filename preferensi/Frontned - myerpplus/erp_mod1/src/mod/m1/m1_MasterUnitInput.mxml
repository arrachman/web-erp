<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid, o:Object={};
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tbarcode, tnilai, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama, tnilai]);
				parentApplication.F_txtInOut(txtkode,'','M1_UnitCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_TextInputNumberDesimalMode([txtkurs]);
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtbarcode, txtcatatan]);
				
				if(p.FormFilter != '')
				{
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ukode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].unama;
					o.txtkurs = dg.dataProvider[dg.selectedCell.rowIndex].unilai;
					txtkurs.text = parentApplication.m.nfNominal.format(o.txtkurs);
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].uketerangan;
					txtbarcode.text =dg.dataProvider[dg.selectedCell.rowIndex].uindexbarcode;
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].uaktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null)
					{
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				o.txtkurs = 1;
				parentApplication.F_KosongkanText([txtkode,txtnama,txtbarcode,txtkurs,txtcatatan]);
				chkaktif.selected = true;
				txtkurs.text = "1";
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}, {t:txtkurs, n:'Nilai', e:'Value'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [txtkode.text,txtnama.text,o.txtkurs,txtcatatan.text,int(chkaktif.selected),txtbarcode.text,vUserId,vDefDt,vUserIdEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_UnitSimpan', utama, 'ukode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="46" text="Kode"/>
	<s:Label id="tnama" left="10" top="68" text="Nama"/>
	<s:Label id="tnilai" left="10" top="89" text="Nilai"/>
	<s:Label id="tbarcode" left="10" top="108" text="Barcode"/>
	<s:Label id="tcatatan" left="10" top="129" text="Catatan"/>
	<s:TextInput id="txtkode" y="40" left="70" width="270"/>
	<s:TextInput id="txtnama" left="70" right="10" top="61"/>
	<s:TextInput id="txtkurs" left="70" right="230" top="82"/>
	<s:TextInput id="txtbarcode" left="70" right="10" top="103" maxChars="50" />
	<s:TextArea id="txtcatatan" left="70" right="10" top="124" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="344" y="41" label="Aktif" selected="true"/>
</s:Module>
