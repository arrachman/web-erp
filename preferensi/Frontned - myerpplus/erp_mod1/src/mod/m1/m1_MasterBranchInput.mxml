<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, talamat1, talamat2, tkota, tkodepos, tnotelp, tnofax, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_BranchCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtalamat, txtalamat2, txtkota, txtkodepos, txtnotelp, txtnofax, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].bkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].bnama;
					txtalamat.text= dg.dataProvider[dg.selectedCell.rowIndex].balamat1;
					txtalamat2.text= dg.dataProvider[dg.selectedCell.rowIndex].balamat2;
					txtkota.text= dg.dataProvider[dg.selectedCell.rowIndex].bkota;
					txtkodepos.text= dg.dataProvider[dg.selectedCell.rowIndex].bkodepos;
					txtnotelp.text= dg.dataProvider[dg.selectedCell.rowIndex].bnotelp;
					txtnofax.text= dg.dataProvider[dg.selectedCell.rowIndex].bnofax;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].bcatatan;
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].baktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama,txtalamat,txtalamat2,txtkota,txtkodepos,txtnotelp,txtnofax, txtcatatan]);
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [txtkode.text, txtnama.text,txtalamat.text,txtalamat2.text,txtkota.text,txtkodepos.text,txtnotelp.text,txtnofax.text, txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_BranchSimpan', utama, 'bkode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
						}
				}
				parentApplication.F_configMasterInputHasil();
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="65" text="Nama"/>
	<s:Label id="talamat1" left="10" top="86" text="Alamat"/>
	<s:Label id="talamat2" left="10" top="155" text="Alamat2"/>
	<s:Label id="tkota" left="10" top="225" text="Kota"/>
	<s:Label id="tkodepos" left="10" top="246" text="Kode Pos"/>
	<s:Label id="tnotelp" left="10" top="267" text="No Telp"/>
	<s:Label id="tnofax" left="10" top="289" text="No Fax"/>
	<s:Label id="tcatatan" left="10" top="309" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="100" width="240" maxChars="25"/>
	<s:TextInput id="txtnama" left="100" right="10" top="58" maxChars="100" />
	<s:TextArea id="txtalamat" left="100" right="10" top="79" height="71" maxChars="250"/>
	<s:TextArea id="txtalamat2" left="100" right="10" top="149" height="71" maxChars="250"/>
	<s:TextInput id="txtkota" top="219" left="100" width="140"/>
	<s:TextInput id="txtkodepos" top="240" left="100" width="140" maxChars="25"/>
	<s:TextInput id="txtnotelp" top="261" left="100" width="140" maxChars="25"/>
	<s:TextInput id="txtnofax" top="282" left="100" width="140" maxChars="25"/>
	<s:TextArea id="txtcatatan" left="100" right="10" top="303" bottom="10" maxChars="250"/>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>		
	<s:CheckBox id="chkaktif" x="344" y="38" label="Aktif" selected="true"/>
</s:Module>
