<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			public var stokbooking:Number = 0;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				parentApplication.F_txtpencarian([txtdivisi,txtlokasi]);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tdivisi, tlokasi, talamat1, talamat2, tkota, tkodepos, tnotelp, tnofax, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama, tlokasi]);
				parentApplication.F_txtInOut(txtkode,'','M1_WarehouseCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama,txtalamat,txtalamat2,txtkota,txtkodepos,txtnotelp,txtnofax,txtcatatan]);
				
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].wkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].wnama;
					txtdivisi.text= dg.dataProvider[dg.selectedCell.rowIndex].wdivisi;
					txtlokasi.text= dg.dataProvider[dg.selectedCell.rowIndex].wlokasi;
					txtalamat.text= dg.dataProvider[dg.selectedCell.rowIndex].walamat1;
					txtalamat2.text= dg.dataProvider[dg.selectedCell.rowIndex].walamat2;
					txtkota.text= dg.dataProvider[dg.selectedCell.rowIndex].wkota;
					txtkodepos.text= dg.dataProvider[dg.selectedCell.rowIndex].wkodepos;
					txtnotelp.text= dg.dataProvider[dg.selectedCell.rowIndex].wnotelp;
					txtnofax.text= dg.dataProvider[dg.selectedCell.rowIndex].wnofax;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].wketerangan;
					if(dg.dataProvider[dg.selectedCell.rowIndex].wbookingstok == 1){
						chkbookingstok.selected = true;
					}else{
						chkbookingstok.selected = false;
					}
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].waktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama,txtdivisi,txtlokasi,txtalamat,txtalamat2,txtkota,txtkodepos,txtnotelp,txtnofax,txtcatatan]);
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}, {t:txtlokasi, n:'Lokasi', e:'Location'}]) == true){
					//cckode, ccnama, cccatatan, ccinputuser, ccinputtgl, ccmodifikasiuser, ccmodifikasitgl
					arr = [txtkode.text,txtnama.text,txtdivisi.text,txtlokasi.text,txtalamat.text,txtalamat2.text,txtkota.text,txtkodepos.text,txtnotelp.text,txtnofax.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt, int(chkbookingstok.selected)];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_WarehouseSimpan', utama, 'wkode')
					vUserIdEdit = 0;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtdivisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1';
						wsfilter = 'daktif = 1 and dkode = "'+ txtdivisi.text.split('"').join('\\"') +'"';
						sort = 'dkode asc';
						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						wsfilter = 'laktif = 1';
						wsfilter = 'laktif = 1 and lkode = "'+ txtlokasi.text.split('"').join('\\"') +'"';
						sort = 'lkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtdivisi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtdivisi.text = o.dkode;
							break;
						case 'txtlokasi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtlokasi.text = o.lkode;
							break;
					}
				}else{				
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtdivisi': txtdivisi.text = ''; break;
							case 'txtlokasi': txtlokasi.text = ''; break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtdivisi':parentApplication.F_KosongkanText([txtdivisi, lbldivisi]);break;
					case 'txtlokasi':parentApplication.F_KosongkanText([txtlokasi, lbllokasi]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="65" text="Nama"/>
	<s:Label id="tdivisi" left="10" top="84" text="Divisi"/>
	<s:Label id="tlokasi" left="10" top="105" text="Lokasi"/>
	<s:Label id="talamat1" left="10" top="128" text="Alamat"/>
	<s:Label id="talamat2" left="10" top="183" text="Alamat2"/>
	<s:Label id="tkota" left="10" top="243" text="Kota"/>
	<s:Label id="tkodepos" left="10" top="264" text="Kode Pos"/>
	<s:Label id="tnotelp" left="10" top="284" text="No Telp"/>
	<s:Label id="tnofax" left="10" top="305" text="No Fax"/>
	<s:Label id="tcatatan" left="10" top="325" text="Catatan"/>
	<s:Label id="lbldivisi" left="239" top="84"/>
	<s:Label id="lbllokasi" left="239" top="105"/>
	<s:TextInput id="txtkode" y="37" left="70" width="270"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58"/>
	<s:TextInput id="txtdivisi" top="79" left="70" width="140" />
	<s:TextInput id="txtlokasi" top="100" left="70" width="140" />
	<s:TextArea id="txtalamat" left="70" right="10" top="121" height="58" maxChars="250"/>
	<s:TextArea id="txtalamat2" left="70" right="10" top="178" height="58" maxChars="250"/>
	<s:TextInput id="txtkota" left="70" top="235" width="140"/>
	<s:TextInput id="txtkodepos" left="70" top="256" width="140" maxChars="25"/>
	<s:TextInput id="txtnotelp" left="70" top="277" width="140" maxChars="25"/>
	<s:TextInput id="txtnofax" left="70" top="298" width="140" maxChars="25"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="319" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="344" y="38" label="Aktif" selected="true"/>
	<s:CheckBox x="219" y="236" label="Booking Stok" id="chkbookingstok"/>
</s:Module>
