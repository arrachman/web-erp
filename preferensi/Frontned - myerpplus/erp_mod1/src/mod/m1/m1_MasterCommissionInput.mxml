<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, i:int, dg:DataGrid;
			public var o:Object = {};
			
			public function f_focusOnMe():void
			{
				txtkode.setFocus();
			}
			
			public function F_SetNavigasiKeyboard(ar:Array):void
			{
				for(i=0;i<ar.length;i++)
					ar[i].addEventListener(KeyboardEvent.KEY_DOWN, Obj_keyDownHandler);	
				
				function Obj_keyDownHandler(event:KeyboardEvent):void
				{
					if((event.keyCode==Keyboard.DOWN)||(event.keyCode==Keyboard.ENTER))
						focusMgr();
					else if(event.keyCode==Keyboard.UP)
						focusMgr(true);
				}	
			}
			
			public function f_grid(dgrid:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.d = dgrid.dataProvider.getItemAt(dgrid.dataProviderLength-1);
					else o.d = dgrid.dataProvider.getItemAt(o.a[1]);
					o.d.kmdiddetail = 0;
					o.d.kmdkodekomisi = "";
					o.d.kmdkriteria = 0;
					o.d.kmdoperator = 0;
					o.d.kmdjml1 = 0;
					o.d.kmdjml2 = 0;
					o.d.kmdkriterianilai = 0;
					o.d.kmdnilai = 0;
					o.d.kmdcustomtext1 = "";
					o.d.kmdcustomtext2 = "";
					o.d.kmdcustomtext3 = "";
					o.d.kmdcustomtext4 = "";
					o.d.kmdcustomtext5 = "";
					o.d.kmdcustomint1 = 0;
					o.d.kmdcustomint2 = 0;
					o.d.kmdcustomdbl3 = 0;
					o.d.kmdcustomdbl1 = 0;
					o.d.kmdcustomdbl2 = 0;
					o.d.kmdcustomdbl3 = 0;
					o.d.kmdcustomdate1 = parentApplication.m.DateFirst;
					o.d.kmdcustomdate2 = parentApplication.m.DateFirst;
					o.d.kmdcustomdate3 = parentApplication.m.DateFirst;
					return
				}
				parentApplication.F_dgRefresh(dg);
			}
			public function focusMgr(backward:Boolean = false):void
			{
				focusManager.getNextFocusManagerComponent(backward).setFocus();
			}
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkode,tnama,talamat]);
				FlexGlobals.topLevelApplication.F_txtInOut(txtkode,'','M1_CommissionCekId');
				FlexGlobals.topLevelApplication.F_configMasterInput();
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode,tnama]);
				F_SetNavigasiKeyboard([txtkode, txtnama, txtketerangan]);
				FlexGlobals.topLevelApplication.F_RegGrid(1,88,[dg1],'transaksi');
				if(p.FormFilter != ''){
					f_getData();
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else{
					f_kondisi_awal();
				}
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama, txtketerangan]);
				chkaktif.selected = true;
				o.kmcustomtext1 = "";
				o.kmcustomtext2 = "";
				o.kmcustomtext3 = "";
				o.kmcustomtext4 = "";
				o.kmcustomtext5 = "";
				o.kmcustomint1 = 0;
				o.kmcustomint2 = 0;
				o.kmcustomint3 = 0;
				o.kmcustomdbl1 = 0;
				o.kmcustomdbl2 = 0;
				o.kmcustomdbl3 = 0;
				o.kmcustomdate1 = parentApplication.m.DateFirst;
				o.kmcustomdate2 = parentApplication.m.DateFirst;
				o.kmcustomdate3 = parentApplication.m.DateFirst;
				FlexGlobals.topLevelApplication.F_defaultGrid([dg1]);
				f_focusOnMe();
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid:Object
				switch (components){
					case  'calculator':
						break;
					case 'comboBox':
						break;
				}
			}
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'kmdkriteria'){
							return new ArrayCollection([{l:'Nominal', v:0}, {l:'Barang', v:1}]);
						}
						if(dataField == 'kmdoperator'){
							return new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
						}
						if(dataField == 'kmdkriterianilai'){
							return new ArrayCollection([{l:'Nominal', v:0}, {l:'Percent', v:1}]);
						}
				}
				return new ArrayCollection([]);
			}
			
			public function f_getData():void
			{
				var kodekomisi:String = '';
				kodekomisi = dg.dataProvider[dg.selectedCell.rowIndex].kmkode;
				FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M1_CommissionGetdataById', '"'+kodekomisi+'"', 0, 0, '', 'kmkode ASC, kmdoperator ASC, kmdjml1 ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String, detail:String, kmdoperatorString : String = '';
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					arr = [txtkode.text, txtnama.text, txtketerangan.text, int(chkaktif.selected), vUserId, 
						vDefDt, userEdit, vDefDt, o.kmcustomtext1, o.kmcustomtext2,
						o.kmcustomtext3, o.kmcustomtext4, o.kmcustomtext5, o.kmcustomint1, o.kmcustomint2,
						o.kmcustomint3, o.kmcustomdbl1, o.kmcustomdbl2, o.kmcustomdbl3, parentApplication.F_tglFormatDB(o.kmcustomdate1),
						parentApplication.F_tglFormatDB(o.kmcustomdate2), parentApplication.F_tglFormatDB(o.kmcustomdate3)];
					utama = parentApplication.F_splitArrayToString(arr);
					
					for(i=0;i<dg1.dataProviderLength;i++){
						
						if(dg1.dataProvider.getItemAt(i).kmdoperator == 0){
							kmdoperatorString = 'Antara';
						}else if(dg1.dataProvider.getItemAt(i).kmdoperator == 1){
							kmdoperatorString = '>=';
						}else if(dg1.dataProvider.getItemAt(i).kmdoperator == 2){
							kmdoperatorString = 'Kelipatan';
						}
					
						with(dg1.dataProvider.getItemAt(i)){
							a = [kmdiddetail, txtkode.text, kmdkriteria, kmdoperator, kmdjml1, 
								kmdjml2, kmdkriterianilai, kmdnilai, kmdcustomtext1, kmdcustomtext2,
								kmdcustomtext3, kmdcustomtext4, kmdcustomtext5, kmdcustomint1, kmdcustomint2,
								kmdcustomdbl3, kmdcustomdbl1, kmdcustomdbl2, kmdcustomdbl3, parentApplication.F_tglFormatDB(kmdcustomdate1), 
								parentApplication.F_tglFormatDB(kmdcustomdate2), parentApplication.F_tglFormatDB(kmdcustomdate3)];
							if(i == 0)detail = parentApplication.F_splitArrayToString(a);
							else detail += "▲"+parentApplication.F_splitArrayToString(a);
						}
					}
					FlexGlobals.topLevelApplication.F_MasterSimpan(baru, 'M1_CommissionSimpan', utama+'△'+detail, 'kmkode')
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
				if (dg1.dataProvider != null && parentApplication.rowIndex < dg1.dataProviderLength)
				var s:String = parentApplication.subject, obj:Object={};
				if(parentApplication.wsSuccess == true){
					switch(s){
						case 'tampil':
							f_focusOnMe();
							isUpdate = true;
							txtkode.enabled=false;
							if(parentApplication.wsArrUtama.length < 0)return;
							with(parentApplication.wsArrUtama.getItemAt(0)){
								txtkode.text = kmkode;
								txtnama.text = kmnama;
								txtketerangan.text = kmketerangan;
								chkaktif.selected = Boolean(int(kmaktif));
								o.kmcustomtext1 = kmcustomtext1;
								o.kmcustomtext2 = kmcustomtext2;
								o.kmcustomtext3 = kmcustomtext3;
								o.kmcustomtext4 = kmcustomtext4;
								o.kmcustomtext5 = kmcustomtext5;
								o.kmcustomint1 = kmcustomint1;
								o.kmcustomint2 = kmcustomint2;
								o.kmcustomint3 = kmcustomint3;
								o.kmcustomdbl1 = kmcustomdbl1;
								o.kmcustomdbl2 = kmcustomdbl2;
								o.kmcustomdbl3 = kmcustomdbl3;
								o.kmcustomdate1 = kmcustomdate1;
								o.kmcustomdate2 = kmcustomdate2;
								o.kmcustomdate3 = kmcustomdate3;
								userEdit = parentApplication.userid;
							}
							dg1.dataProvider.removeAll();
							
							var operatorIndek : int = 0;
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								obj = parentApplication.wsArrDetail.getItemAt(i);
								if(obj.kmdoperator == 'Antara'){
									operatorIndek = 0;
								}else if(obj.kmdoperator == '>='){
									operatorIndek = 1;
								}else if(obj.kmdoperator == 'Kelipatan'){
									operatorIndek = 2;
								}
								dg1.dataProvider.addItem({
									kmdiddetail : obj.kmdiddetail,
									kmdkodekomisi : obj.kmdkodekomisi,
									kmdkriteria : obj.kmdkriteria,
									kmdoperator : obj.kmdoperator,
									kmdjml1 : obj.kmdjml1,
									kmdjml2 : obj.kmdjml2,
									kmdkriterianilai : obj.kmdkriterianilai,
									kmdnilai : obj.kmdnilai,
									kmdcustomtext1 : obj.kmdcustomtext1,
									kmdcustomtext2 : obj.kmdcustomtext2,
									kmdcustomtext3 : obj.kmdcustomtext3,
									kmdcustomtext4 : obj.kmdcustomtext4,
									kmdcustomtext5 : obj.kmdcustomtext5,
									kmdcustomint1 : obj.kmdcustomint1,
									kmdcustomint2 : obj.kmdcustomint2,
									kmdcustomint3 : obj.kmdcustomint3,
									kmdcustomdbl1 : obj.kmdcustomdbl1,
									kmdcustomdbl2 : obj.kmdcustomdbl2,
									kmdcustomdbl3 : obj.kmdcustomdbl3,
									kmdcustomdate1 : obj.kmdcustomdate1,
									kmdcustomdate2 : obj.kmdcustomdate2,
									kmdcustomdate3 : obj.kmdcustomdate3
								});
							}
							dg1.setSelectedCell(0, 1);
							break;
						case 'tampilHistory':
							f_focusOnMe();
							mb.menuBarItems[0].visible = false; mb.menuBarItems[1].visible = false; mb.menuBarItems[2].visible = false; mb.menuBarItems[3].visible = false;
							mb.menuBarItems[4].visible = false; mb.menuBarItems[5].visible = false; mb.menuBarItems[6].visible = false; mb.menuBarItems[7].visible = false;
							if(parentApplication.wsArrUtama.length < 0)return;
							with(parentApplication.wsArrUtama.getItemAt(0)){
								isUpdate = true;
								txtdimintaoleh.text = mrdimintaolehkode;
								parentApplication.vpVarCurrent = txtdimintaoleh.text;
								lbldimintaoleh.text = mrdimintaolehnama;
								txtkontakperson.text = mrdimintaolehkontak;
								txtdimintake.text = mrmintakekode;
								lbldimintake.text = mrmintakenama;
								txtgudangasal.text = mrgudangasal;
								lblgudangasal.text = mrgudangasalnama;
								txtgudangtujuan.text = mrgudangtujuan;
								lblgudangtujuan.text = mrgudangtujuannama;
								dttanggal.text = mrtgl;
								txtnotransaksi.text = mrnotransaksi;
								dttanggaldibutuhkan.text = mrtgldipakai; 
								if(int(mrstatus) == 0){
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									cmbprogress.selectedIndex = 0;
								}else{
									cmbprogress.dataProvider = new  ArrayCollection([{l : 'Approved', v : 2},{l : 'Inprogress', v : 3}, {l : 'Complete', v : 4},{l : 'Close', v : 7}]);
									if(mrstatus == 2){cmbprogress.selectedIndex = 0}
									else  if(mrstatus == 3){cmbprogress.selectedIndex = 1}
									else  if(mrstatus == 4){cmbprogress.selectedIndex = 2}
									else  if(mrstatus == 7){cmbprogress.selectedIndex = 3}
									cmbprogress.enabled = false;
									mb.menuBarItems[0].enabled = false;
								}
								txturaian.text = mruraian;
								txtcatatan.text = mrcatatan;
								txtnoref.text = mrnoref;
								dttanggalnoref.text = mrtglnoref;
								chkauto.selected = Boolean(int(mrautonotransaksi));
								getNotransaksi = parentApplication.wsArrUtama[0].mrnotransaksi;
								f_chkAuto();
							}
							dg1.dataProvider.removeAll();
							
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								obj = parentApplication.wsArrDetail.getItemAt(i);
								dg1.dataProvider.addItem({
									no : dg1.dataProviderLength+1, idbarang : obj.idbarang, kode : obj.kodebarang, tipe : obj.tipebarang, nama : obj.namabarang,
									jumlah : obj.jml, satuan : obj.satuan, catatan : obj.catatan, cabang : obj.cabang, lokasi : obj.lokasi, hargabeli : obj.hargabeli,
									hargajual : obj.hargajual, stokterakhir : 0, costcenter : obj.costcenter, divisi : obj.divisi, subdivisi : obj.subdivisi,
									proyek : obj.proyek, customtxt1 : obj.customtext1, customtxt2 : obj.customtext2, customtxt3 : obj.customtext3, customblg1 : obj.customdbl1,
									customblg2 : obj.customdbl2, customblg3 : obj.customdbl3, customdt1 : obj.customdate1, customdt2 : obj.customdate2,
									customdt3 : obj.customdate3, idmrdetail : obj.idmrdetail, idmr : obj.idmr, nilaisatuan : obj.nilaisatuan, jmlbarang : obj.jmlbarang,
									satuanbarang : obj.satuanbarang, gudangasal : obj.gudangasal, gudangtujuan : obj.gudangtujuan, matauang : obj.matauang,
									kurs : obj.kurs, jmlts : obj.jmlts, statusts : obj.statusts, jmlrs : obj.jmlrs, statusrs : obj.statusrs, isclose : obj.isclose
								});
							}
							dg1.setSelectedCell(0, 1);
							break;
					}
				}else{					
					switch(s){
						case 'tampil':
						case 'tampilHistory':
							Alert.show(parentApplication.wsErrmessage, parentApplication.l('Informasi'));
							break;
					}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="talamat" left="10" top="87" text="Keterangan"/>
	<s:TextInput id="txtkode" y="40" left="80" width="270" maxChars="25"/>
	<s:TextInput id="txtnama" y="61" left="80" width="270" maxChars="25"/>
	<s:TextArea id="txtketerangan" left="80" right="10" top="82" height="51" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="354" y="40" label="Aktif" selected="true"/>
	<s:DataGrid id="dg1" left="10" right="10" top="150" bottom="10"/>
</s:Module>
