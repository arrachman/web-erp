<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid, i:int;
			public var o:Object = {};
			
			public function F_SetNavigasiKeyboard(ar:Array):void
			{
				for(i=0;i<ar.length;i++)
					ar[i].addEventListener(KeyboardEvent.KEY_DOWN, Obj_keyDownHandler);	
				
				function Obj_keyDownHandler(event:KeyboardEvent):void
				{
					if((event.keyCode==Keyboard.DOWN)||(event.keyCode==Keyboard.ENTER))
						focusMgr();
					else if(event.keyCode==Keyboard.UP)
						focusMgr(true);
				}	
			}
			
			public function focusMgr(backward:Boolean = false):void
			{
				focusManager.getNextFocusManagerComponent(backward).setFocus();
			}
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkode,tnama,talamat,tkota,tnotelp,tnofax,tcatatan]);
				FlexGlobals.topLevelApplication.F_txtInOut(txtkode,'','M1_BankCekId');
				FlexGlobals.topLevelApplication.F_configMasterInput();
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode, tnama]);
				F_SetNavigasiKeyboard([txtkode, txtnama, txtalamat, txtkota, txtnotelp, txtnofax, txtcatatan]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtdiskonkredit, txtdiskondebit, txtnilaipoin]);
				
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled=false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].bkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].bnama;
					txtalamat.text = dg.dataProvider[dg.selectedCell.rowIndex].balamat;
					txtkota.text =dg.dataProvider[dg.selectedCell.rowIndex].bkota;
					txtnotelp.text = dg.dataProvider[dg.selectedCell.rowIndex].bnotelp;
					txtnofax.text = dg.dataProvider[dg.selectedCell.rowIndex].bnofax;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].bcatatan;
					
					o.txtdiskonkredit = dg.dataProvider[dg.selectedCell.rowIndex].bcustomdbl1; 
					o.txtdiskondebit = dg.dataProvider[dg.selectedCell.rowIndex].bcustomdbl2;
					o.txtnilaipoin = dg.dataProvider[dg.selectedCell.rowIndex].bcustomdbl3;
					txtdiskonkredit.text = parentApplication.m.nfNominal.format(o.txtdiskonkredit);
					txtdiskondebit.text = parentApplication.m.nfNominal.format(o.txtdiskondebit);
					txtnilaipoin.text = parentApplication.m.nfNominal.format(o.txtnilaipoin);
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].baktif));
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama, txtalamat,txtkota,txtnotelp,txtnofax,txtcatatan]);
				o.txtdiskonkredit = 0; 
				o.txtdiskondebit = 0;
				o.txtnilaipoin = 0;
				FlexGlobals.topLevelApplication.F_SetNilaiText([txtdiskonkredit, txtdiskondebit, txtnilaipoin], parentApplication.m.nfNominal.format(0))
				
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [txtkode.text, txtnama.text, txtalamat.text,txtkota.text,txtnotelp.text,txtnofax.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt,
							"","","","","",0,0,0, o.txtdiskonkredit, o.txtdiskondebit, o.txtnilaipoin,
							FlexGlobals.topLevelApplication.F_tglFormatDB(parentApplication.m.DateFirst),
							FlexGlobals.topLevelApplication.F_tglFormatDB(parentApplication.m.DateFirst),
							FlexGlobals.topLevelApplication.F_tglFormatDB(parentApplication.m.DateFirst)];
					utama = parentApplication.F_splitArrayToString(arr);
					FlexGlobals.topLevelApplication.F_MasterSimpan(baru, 'M1_BankSimpan', utama, 'bkode')
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="talamat" left="10" top="87" text="Alamat"/>
	<s:Label id="tkota" left="10" top="150" text="Kota"/>
	<s:Label id="tnotelp" left="10" top="171" text="No Telp"/>
	<s:Label id="tnofax" left="10" top="192" text="No Fax"/>
	<s:Label id="tnofax0" left="10" top="212" text="Diskon K.Kredit"/>
	<s:Label id="tnofax1" left="10" top="234" text="Diskon K.Debit"/>
	<s:Label id="tnofax4" left="10" top="243" width="83" height="27" text="&#xd;Nilai Poin"/>
	<s:Label id="tnofax2" top="213" right="166" text="%"/>
	<s:Label id="tnofax3" right="166" top="235" height="17" text="%"/>
	<s:Label id="tcatatan" left="10" top="287" text="Catatan"/>
	<s:TextInput id="txtkode" y="40" left="125" right="184" width="308" maxChars="25"/>
	<s:TextInput id="txtnama" left="125" right="10" top="61" maxChars="100" />
	<s:TextArea id="txtalamat" left="125" right="10" top="82" height="64" maxChars="250"/>
	<s:TextInput id="txtkota" left="125" right="10" top="145" maxChars="25" />
	<s:TextInput id="txtnotelp" left="125" right="184" top="166" maxChars="50" />
	<s:TextInput id="txtnofax" left="125" right="184" top="187" maxChars="50" />
	<s:TextInput id="txtdiskonkredit" left="125" right="184" top="208" maxChars="50" />
	<s:TextInput id="txtdiskondebit" left="125" right="184" top="229" maxChars="50" />
	<s:TextInput id="txtnilaipoin" left="125" right="184" top="250" maxChars="50" />
	<s:TextArea id="txtcatatan" left="125" right="10" top="271" bottom="13" maxChars="250"/>	
	<s:CheckBox id="chkaktif" right="138" y="40" label="Aktif" selected="true"/>
</s:Module>
