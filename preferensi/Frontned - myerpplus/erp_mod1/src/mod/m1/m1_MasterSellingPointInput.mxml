<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid, spid:int = 0;
			private function f_persiapan():void{
				p = parentApplication;
				dg = p.m[p.idmodcurr].child.dg;
				FlexGlobals.topLevelApplication.F_txtInOut(txtkode,'','M1_Selling_PointCekId');
				parentApplication.F_configMasterInput();
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode, tnama, tjmlbarang]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtjmlbarang, txtpoin]);
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					spid = dg.dataProvider[dg.selectedCell.rowIndex].spid; 
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].spkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].spnama;
					o.txtjmlbarang = dg.dataProvider[dg.selectedCell.rowIndex].spjmlbarang;
					txtjmlbarang.text = parentApplication.m.nfNominal.format(o.txtjmlbarang);
					o.txtpoin = dg.dataProvider[dg.selectedCell.rowIndex].sppoint;
					txtpoin.text = parentApplication.m.nfNominal.format(o.txtpoin);
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].spcatatan;
					userEdit = parentApplication.userid;
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				spid = 0;
				o.txtkurs = 0;
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan]);
				o.txtjmlbarang = 0;
				o.txtpoin = 0;
				txtjmlbarang.text = parentApplication.m.nfNominal.format(o.txtjmlbarang);
				txtpoin.text = parentApplication.m.nfNominal.format(o.txtpoin);
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					arr = [spid, txtkode.text,txtnama.text,o.txtjmlbarang,o.txtpoin, txtcatatan.text ,vUserId,vDefDt,userEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_Selling_PointSimpan', utama, 'spkode')
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="tjmlbarang" left="10" top="87" text="Jumlah Barang"/>
	<s:Label id="tpoin" right="140" top="87" text="Poin"/>
	<s:Label id="tcatatan" left="10" top="108" text="Catatan"/>
	<s:TextInput id="txtkode" y="40" left="105" width="270" maxChars="25"/>
	<s:TextInput id="txtnama" left="105" right="25" top="61" maxChars="100" />
	<s:TextInput id="txtjmlbarang" left="105" width="110" top="82" maxChars="10" />
	<s:TextInput id="txtpoin" right="25" top="82" width="110" maxChars="10"/>
	<s:TextArea id="txtcatatan" left="105" right="25" top="103" bottom="10" maxChars="250"/>
</s:Module>
