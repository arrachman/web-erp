<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			[Bindable]private var arrisicombo:ArrayCollection;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				arrisicombo = new ArrayCollection([{dbulan:parentApplication.l('Bulan'),dnumber:0},{dbulan:parentApplication.l('Minggu'),dnumber:1},{dbulan:parentApplication.l('Hari'),dnumber:2}]);
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode,tnama,tdiskon1,tdiskon2,tdenda,tperiodedenda,tcatatan,thariberlaku1,thariberlaku2,thari1,thari2,tjatuhtempo]);
				parentApplication.F_txtInOut(txtkode,'','M1_TermsCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode,txtnama,cmbper,txtketerangan]);
				parentApplication.F_TextInputNumberDesimalMode([txtdiskon,txtdiskon2,txtdenda]);
				parentApplication.F_TextInputNumberOnlyMode([txthariberlaku,txthariberlaku2,txtjatuhtempo]);
				parentApplication.F_RequiredLabel([tkode, tnama, tdiskon1, tdiskon2, tdenda, tperiodedenda, thariberlaku1, thariberlaku2, tjatuhtempo]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].trkode;
					txtnama.text=dg.dataProvider[dg.selectedCell.rowIndex].trnama;
					o.txtdiskon = dg.dataProvider[dg.selectedCell.rowIndex].trdiskon1;
					o.txtdiskon2 = dg.dataProvider[dg.selectedCell.rowIndex].trdiskon2;
					o.txtdenda = dg.dataProvider[dg.selectedCell.rowIndex].trdenda;
					o.txthariberlaku = dg.dataProvider[dg.selectedCell.rowIndex].trharidiskon1;
					o.txthariberlaku2 = dg.dataProvider[dg.selectedCell.rowIndex].trharidiskon2;
					o.txtjatuhtempo = dg.dataProvider[dg.selectedCell.rowIndex].trharijatuhtempo;
					txtdiskon.text=parentApplication.m.nfNominal.format(o.txtdiskon);
					txtdiskon2.text=parentApplication.m.nfNominal.format(o.txtdiskon2);
					txtdenda.text=parentApplication.m.nfNominal.format(o.txtdenda);
					txthariberlaku.text=o.txthariberlaku;
					txthariberlaku2.text=o.txthariberlaku2;
					txtjatuhtempo.text=o.txtjatuhtempo;
					cmbper.selectedIndex=dg.dataProvider[dg.selectedCell.rowIndex].trdendaper;					
					txtketerangan.text=dg.dataProvider[dg.selectedCell.rowIndex].trcatatan;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].traktif));
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				o.txtdiskon = 0; o.txtdiskon2 = 0; o.txtdenda = 0; o.txthariberlaku = 0; o.txthariberlaku2 = 0; o.txtjatuhtempo = 0;
				parentApplication.F_KosongkanText([txtkode,txtnama, txtdiskon,txthariberlaku,txtdiskon2,txthariberlaku2,txtdenda,txtjatuhtempo,txtketerangan]);
				txtdiskon.text = parentApplication.m.nfNominal.format(o.txtdiskon); txtdiskon2.text = parentApplication.m.nfNominal.format(o.txtdiskon2);
				txtdenda.text = parentApplication.m.nfNominal.format(o.txtdenda); txthariberlaku.text = o.txthariberlaku;
				txthariberlaku2.text = o.txthariberlaku2; txtjatuhtempo.text = o.txtjatuhtempo;
				cmbper.selectedIndex = 0;
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong(
					[{t:txtkode, n:'Kode'},
					{t:txtnama, n:'Nama'},
					{t:txtdiskon, n:'Diskon1'},
					{t:txthariberlaku, n:'Hari Berlaku1'},
					{t:txtdiskon2, n:'Diskon2'},
					{t:txthariberlaku, n:'Hari Berlaku2'},
					{t:txtdenda, n:'Denda'},
					{t:txtjatuhtempo, n:'Jatuh Tempo'},
					]) == true){
					arr = [txtkode.text,txtnama.text,o.txtdiskon,txthariberlaku.text,
						o.txtdiskon2,txthariberlaku2.text,o.txtdenda,txtjatuhtempo.text,
						cmbper.selectedIndex,txtketerangan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_TermsSimpan', utama, 'trkode')
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="tdiskon1" left="10" top="87" text="Diskon 1"/>
	<s:Label id="tdiskon2" left="10" top="108" text="Diskon 2"/>
	<s:Label id="tdenda" left="10" top="129" text="Denda"/>
	<s:Label id="tperiodedenda" left="10" top="150" text="Periode Denda"/>
	<s:Label id="tcatatan" left="10" top="171" text="Catatan"/>
	<s:Label id="thariberlaku1" left="188" top="87" text="hari. Berlaku"/>
	<s:Label id="thariberlaku2" left="188" top="108" text="hari. Berlaku"/>
	<s:Label id="tjatuhtempo" left="186" top="129" text="Jatuh Tempo"/>
	<s:Label left="165" top="91" height="12" text="%"/>
	<s:Label left="165" top="110" height="12" text="%"/>
	<s:Label left="165" top="130" text="%"/>
	<s:Label id="thari1" left="328" top="87" height="12" text="hari"/>
	<s:Label id="thari2" left="328" top="108" height="12" text="hari"/>
	<s:TextInput id="txtkode" y="40" left="111" width="209" maxChars="25"/>
	<s:TextInput id="txtnama" y="61" left="111" width="209" maxChars="100"/>
	<s:TextInput id="txtdiskon" left="111" top="82" width="50" maxChars="11"/>
	<s:TextInput id="txthariberlaku" left="270" top="82" width="50" maxChars="11"/>
	<s:TextInput id="txtdiskon2" left="111" top="103" width="50" maxChars="11"/>
	<s:TextInput id="txthariberlaku2" left="270" top="103" width="50" maxChars="11"/>
	<s:TextInput id="txtdenda" left="111" top="124" width="50" maxChars="11"/>
	<s:TextInput id="txtjatuhtempo" left="270" top="124" width="50" maxChars="11"/>
	<s:ComboBox id="cmbper" labelField="dbulan" left="111" top="145" width="209" height="22" dataProvider="{arrisicombo}"/>
	<s:TextArea id="txtketerangan" left="111" right="10" top="166" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="332" y="40" label="Aktif" selected="true"/>
</s:Module>
