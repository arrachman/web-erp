<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			[Bindable]private var arrisicombo:ArrayCollection;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				arrisicombo = new ArrayCollection([{dkode:parentApplication.l('Aplikasi')},{dkode:parentApplication.l('Grup')},{dkode:parentApplication.l('Kelas')},{dkode:parentApplication.l('Lokasi')},{dkode:parentApplication.l('Merek')},{dkode:parentApplication.l('Status')},{dkode:parentApplication.l('Tipe')},{dkode:parentApplication.l('Kendaraan')},{dkode:parentApplication.l('Metode')},{dkode:parentApplication.l('Pengirim')},{dkode:parentApplication.l('Model')},{dkode:parentApplication.l('Transportasi')},{dkode:parentApplication.l('Ukuran')},{dkode:parentApplication.l('Warna')}]);
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tjenis,tkode,tnama,tcatatan]);
				parentApplication.F_txtInOut(txtkode,"ada",'M1_OtherCekId');
				parentApplication.F_RequiredLabel([tjenis, tkode, tnama]);
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					cmbjenis.enabled=false;
					cmbjenis.selectedIndex = dg.dataProvider[dg.selectedCell.rowIndex].ojenis;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].okode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].onama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].ocatatan;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].oaktif));
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan]);
				cmbjenis.selectedIndex = 0;
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [cmbjenis.selectedIndex,txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_OtherSimpan', utama, 'okode')
					cmbjenis.enabled = true;
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tjenis" left="10" top="44" text="Jenis"/>
	<s:Label id="tkode" left="10" top="65" text="Kode"/>
	<s:Label id="tnama" left="10" top="86" text="Nama"/>
	<s:Label id="tcatatan" left="10" top="107" text="Catatan"/>
	<s:ComboBox id="cmbjenis" x="70" y="38" width="118" dataProvider="{arrisicombo}" labelField="dkode"/>
	<s:TextInput id="txtkode" y="60" left="70" width="100" maxChars="25" change="parentApplication.vfplus=cmbjenis.selectedIndex+'△'+txtkode.text"/>
	<s:TextInput id="txtnama" left="70" right="10" top="81" maxChars="100" />
	<s:TextArea id="txtcatatan" left="70" right="10" top="102" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="191" y="40" label="Aktif" selected="true"/>
	
</s:Module>
