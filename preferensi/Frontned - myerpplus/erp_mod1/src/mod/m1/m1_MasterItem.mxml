			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtSatuan':
						paket='CdM1_Unit';
						wsfilter='ukode = "' + txtSatuan.text.split('"').join('\\"') +'"';
						break;
					case 'txtsupplier':
						paket='CdM1_Contact';
						wsfilter='kkategori = "S" AND kkode = "' + txtsupplier.text.split('"').join('\\"') +'"';
						csfilter='kkategori = "S"';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtSatuan":txtSatuan.text='';break;
					case "txtsupplier":
						txtsupplier.text='';
						idsupplier = 0
						break;
				}
			}
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				var isfound:Boolean = false;
				var arrayhakakses:Object;
				arrayhakakses = FlexGlobals.topLevelApplication.m.ArrUserMenuCustom
				for(var i:int=0;i<FlexGlobals.topLevelApplication.m.ArrUserMenuCustom.length;i++)
				{
					//Alert.show(arrayhakakses[i].mid+" && "+arrayhakakses[i].pcid+" && "+arrayhakakses[i].pckode+" && "+arrayhakakses[i].urakses);
					if(arrayhakakses[i].mid == 1 && arrayhakakses[i].pcid == 2  && arrayhakakses[i].pckode == "Harga Beli" && arrayhakakses[i].urakses == 1){
						isfound = true; break;
					}
				}
				//Alert.show(dg.columnsLength+"")
				if(isfound == true){
					dg.columns.getItemAt(9).visible = true;
				}else{
					dg.columns.getItemAt(9).visible = false;
				}
				tbarang.text = parentApplication.l('Barang')+' :';
				parentApplication.F_KosongkanText([txtkode,txtTipeBarang, txtnama, txtStok1,txtStok2,txtSatuan]);
				if(dgStok.dataProvider != null){
					dgStok.dataProvider.removeAll();
				}
				dg.dataProvider.removeAll();
				//				parentApplication.f_formMasterTampil();
			}
			public var vfileextention:int=0;
			public function f_cetak():void
			{
				var flt:String="";var srt:String="b.bkode, b.burutan";var grp:String="b.bkode, blg.blgnamalokasi";
				o.str = parentApplication.StrFilter;
				if (txtkode.text !=""){
					flt += o.str("bkode", txtkode.text);
				}
				if (txtnama.text !=""){
					if (flt != ""){flt +=" And "}
					flt+= o.str("bnama", txtnama.text);
				}
				if (txtTipeBarang.text !=""){
					if (flt != ""){flt +=" And "}
					flt+= o.str("btipe", txtkode.text);
				}
				if (txtSatuan.text !=""){
					if (flt != ""){flt +=" And "}
					flt+= o.str("bsatuan", txtSatuan.text);
				}
				if (txtStok1.text==""){if (txtStok2.text!=''){txtStok1.text=txtStok2.text}}
				if (txtStok2.text==""){if (txtStok1.text!=''){txtStok2.text=txtStok1.text}}
				if (txtStok1.text !=""){
					if (flt != ""){flt +=" And "}
					flt+= o.str("bstok", txtStok1.text, 9, txtStok2.text);
				}
				if (txtcatatan.text !=""){
					if (flt != ""){flt +=" And "}
					flt+= o.str("bcatatan", txtcatatan.text);
				}
//				Alert.show(flt);
				parentApplication.F_openReport(1,int(arr[8][1]),2,flt,srt,grp,vfileextention);
				vfileextention = 0;
			}
