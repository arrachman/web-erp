			public function f_filterdata():String{
				var f:String = '';
				if(txtkode.text != '')
					f = parentApplication.TambahFilter(f, 'bkode LIKE "%'+txtkode.text.split('"').join('\\"')+'%"');
				if(txtnama.text != '')
					f = parentApplication.TambahFilter(f, 'bnama LIKE "%'+txtnama.text.split('"').join('\\"')+'%"');
				if(txtTipeBarang.text != '')
					f = parentApplication.TambahFilter(f, 'btipe LIKE "%'+txtTipeBarang.text.split('"').join('\\"')+'%"');
				if(txtSatuan.text != '')
					f = parentApplication.TambahFilter(f, 'bsatuan LIKE "%'+txtSatuan.text.split('"').join('\\"')+'%"');
				if (txtStok1.text==""){if (txtStok2.text!=''){txtStok1.text=txtStok2.text}}
				if (txtStok2.text==""){if (txtStok1.text!=''){txtStok2.text=txtStok1.text}}
				if(txtStok1.text != '')
					f = parentApplication.TambahFilter(f, 'bstok between "'+txtStok1.text.split('"').join('\\"')+'" and "'+txtStok2.text.split('"').join('\\"')+'"');
				if(txtcatatan.text != '')
					f = parentApplication.TambahFilter(f, 'bcatatan LIKE "%'+txtcatatan.text.split('"').join('\\"')+'%"');
				if(txtsupplier.text.length > 0)
					f = parentApplication.TambahFilter(f, 'kid = "'+idsupplier+'"');
				
				return f;
			}
			
