			public function f_wsHasil():void{
				var o:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					switch(s){
						case 'getstok':
							if (parentApplication.wsArrUtama.length>0){
								dgStok.dataProvider=parentApplication.wsArrUtama;}
							break;
						case 'txtSatuan':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtSatuan.text = o.ukode;
							break;
						case 'txtsupplier':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtsupplier.text = o.kkode;
							idsupplier = o.kid
							break;
						case "TransaksiTerakhir" :
							o = parentApplication.wsArrUtama.getItemAt(0);
							lbltransaksiterakhir.visible = true;bdrtransaksiterakhir.visible = true;lblbarang1.visible = true;
							if (sumberterakhir=="PO"){
								lbltransaksiterakhir.text="Order Pembelian Terakhir"
								lblbarang1.text="Barang : " + dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bkode;
							}else if (sumberterakhir=="SO"){
								lbltransaksiterakhir.text="Order Penjualan Terakhir"
								lblbarang1.text="Barang : " + dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bkode;
							}else if (sumberterakhir=="RI"){
								lbltransaksiterakhir.text="Pembelian Terakhir"
								lblbarang1.text="Barang : " + dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bkode;
							}else if (sumberterakhir=="SI"){
								lbltransaksiterakhir.text="Penjualan Terakhir"
								lblbarang1.text="Barang : " + dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bkode;
							}
							txtbukti.text = o.notransaksi;
							txttanggal.text = o.tgl;
							txtsuplier.text = o.kontaknama;
							txtjumlah.text = o.jml;
							txtharga.text=parentApplication.m.nfNominal.format(o.harga);
					}
				}else{
					switch(parentApplication.subject){
						case 'txtSatuan':txtSatuan.text='';break;
						case 'txtsupplier':
							txtsupplier.text='';
							idsupplier = 0
							break;
						case 'getstok':
							try{dgStok.dataProvider.removeAll() ;break;} 
							catch(error:Error){break;}
						case "TransaksiTerakhir" : 
							lbltransaksiterakhir.visible = false;bdrtransaksiterakhir.visible = false;lblbarang1.visible = false;
					}
				}
			}
