			public function f_filter(target:String):Array
			{
				var paket:String='',dgrid: Object, wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String = '';
				try{
					/* if(tab.selectedIndex == 0){
						dgrid = dghasil.dataProvider.getItemAt(dghasil.selectedCell.rowIndex)
					} */
				} 
				catch(error:Error){}
				switch(target){
					case 'kodebarang':
						paket = 'CdM1_Item';
						wsfilter = '(baktif=1 AND bassembly <> 1) AND (bhpp="'+FlexGlobals.topLevelApplication.getSetting(0,'company','HppGlobal')+'" or bhpp = "I") and bkode = "'+dgrid.kodebarang+'"';
						csfilter = '(baktif=1 AND bassembly <> 1) AND (bhpp="'+FlexGlobals.topLevelApplication.getSetting(0,'company','HppGlobal')+'" or bhpp = "I")';
						sort = "bkode asc";
						break;
					case "satuan":
						paket = "CdM1_Unit";
						wsfilter = 'uaktif=1 AND ukode = "'+dgrid.satuan+'"';
						csfilter = 'uaktif=1';
						sort = "ukode asc";
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber = "PD"';
						sort = 'tndkode asc';
						break;
					case "gudangasal":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode = "'+ dgrid.gudangasal +'"';
						csfilter = 'waktif=1';
						sort = "wkode asc";
						break;
					case "gudangproduksi":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode = "'+ dgrid.gudangproduksi +'"';
						csfilter = 'waktif=1';
						sort = "wkode asc";
						break;
					case "gudangtujuan":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode = "'+ dgrid.gudangtujuan +'"';
						csfilter = 'waktif=1';
						sort = "wkode asc";
						break;
					case "costcenter":
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+ dgrid.costcenter +'"';
						csfilter = 'ccaktif=1';
						sort = "cckode asc";
						break;
					case "divisi":
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+ dgrid.divisi +'"';
						csfilter = 'daktif=1';
						sort = "dkode asc";
						break;
					case "subdivisi":
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif=1 AND sddivisi = "'+dgrid.divisi.split('"').join('\\"')+'" AND sdkode = "'+dgrid.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif=1 AND sddivisi = "'+dgrid.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case "proyek":
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+ dgrid.proyek +'"';
						csfilter = 'paktif=1';
						sort = "pkode asc";
						break;
					case "txtGudangBahan":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode = "'+ txtGudangBahan.text +'"';
						csfilter = 'waktif=1';
						sort = "wkode asc";
						break;
					case "txtGudangHasil":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode = "'+ txtGudangHasil.text +'"';
						csfilter = 'waktif=1';
						sort = "wkode asc";
						break;
					case 'txtkategorimesin':
						paket = 'M1_Machine_CategorySearch';
						wsfilter = 'mckode = "'+txtkategorimesin.text.split('"').join('\\"')+'"';
						sort = "mckode asc";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
			}
			
			
			
