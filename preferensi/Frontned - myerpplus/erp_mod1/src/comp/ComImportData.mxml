<?xml version="1.0" encoding="utf-8"?>
<s:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009"
			   xmlns:s="library://ns.adobe.com/flex/spark"
			   xmlns:mx="library://ns.adobe.com/flex/mx"
			   xmlns:net="flash.net.*"
			   height="380" width="572" keyDown="titlewindow1_keyDownHandler(event)" close="titlewindow1_closeHandler()"
			   creationComplete="titlewindow1_initializeHandler(event)">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Menu;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			import mx.managers.PopUpManager;
			
			public var p:Object = {}, sumber:String, kolom:Array;
			
			protected function titlewindow1_initializeHandler(event:FlexEvent):void
			{
				this.title = "Import Data";
				p = parentApplication.m[parentApplication.idmod].child;
				FlexGlobals.topLevelApplication.F_RegGrid(p.arr[8][0], p.arr[8][1], [dg]); 
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_tambah); // Tambah
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_replace); // Replace
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_import); // Import
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_downloadTemplate); // Download Template
				
				function f_tambah():void
				{
					var i:int, j:int, data:String = '';
					for(i=0;i<dg.dataProviderLength;i++){
						if(i>0)data += FlexGlobals.topLevelApplication.sptRow;
						for(j=0;j<kolom.length;j++){
							if(j>0)data += FlexGlobals.topLevelApplication.sptField;
							data += dg.dataProvider[i][kolom[j]];
						}
					}
					FlexGlobals.topLevelApplication.F_wsSimpan("importdata_simpan", 'M0_ImportDataSimpan', parentApplication.userid, false, data, sumber);
				}
				
				function f_replace():void
				{
					
				}
				
				function f_import():void
				{
					var arr:Array = [];
					arr.push(new FileFilter("Excel 97-2003 Workbook (*.xls)","*.xls"));
					arr.push(new FileFilter("Excel Workbook (*.xlsx)","*.xlsx"));
					fileReference.browse(arr);
				}
				
				function f_downloadTemplate():void
				{
					
				}
				
				function f_mbClose():void
				{
					f_close();
				}
			}
			
			protected function titlewindow1_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ESCAPE)
					f_close();
			}
			
			protected function titlewindow1_closeHandler():void
			{
				f_close();
			}
			
			protected function f_close():void
			{
				PopUpManager.removePopUp(this);
			}
			
			private function fileReference_select(e:Event):void {
				fileReference.load();
			}
			
			private function fileReference_complete(e:Event):void {
				FlexGlobals.topLevelApplication.F_wsUpload(FlexGlobals.topLevelApplication.sptParam+"importdata", "importdata", parentApplication.userid, sumber, fileReference.type, fileReference.data, 0, fileReference.name, '', fileReference.size, FlexGlobals.topLevelApplication.DefaultTanggalforDB); 
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="list">
			<s:source>
				<fx:XMLList xmlns="list">
					<topmenu label="Tambah" icon=""/>
					<topmenu label="Replace" icon=""/>
					<topmenu label="Import" icon=""/>
					<topmenu label="Download Template" icon=""/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection> 
		<net:FileReference id="fileReference" select="fileReference_select(event)" complete="fileReference_complete(event)" />
	</fx:Declarations>
	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{list}" iconField="@icon" labelField="@label"/>
	<s:DataGrid id="dg" left="10" right="10" top="40" bottom="10"/>
</s:TitleWindow>