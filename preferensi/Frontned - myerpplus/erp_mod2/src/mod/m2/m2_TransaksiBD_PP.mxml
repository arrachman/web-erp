						csfilter = 'tndaktif=1 AND tndsumber="BD"';
						sort = 'tndkode asc';
						break;
					case "costcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dgbarang.dataProvider.getItemAt(dgbarang.selectedCell.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi": // Divisi
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dgbarang.dataProvider.getItemAt(dgbarang.selectedCell.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi": //sub divisi
						paket = "CdM1_Subdivision";
						wsfilter = 'sdaktif=1 AND sdkode = "'+dgbarang.dataProvider.getItemAt(dgbarang.selectedCell.rowIndex).subdivisi+'" AND sddivisi="'+dgbarang.dataProvider.getItemAt(dgbarang.selectedCell.rowIndex).divisi+'"';
