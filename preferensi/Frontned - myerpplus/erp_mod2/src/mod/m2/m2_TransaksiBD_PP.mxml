					//					}
				}
				
				
			}
			public function f_hitungTotal():void
			{
				o.bdjumlah = 0; o.bdjumlahvalas=0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).chk==1){
						o.bdjumlah += Number(dg.dataProvider.getItemAt(i).jumlah);
						o.bdjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas);
					}
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.bdjumlah);
				lbltotalvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.bdjumlahvalas);
			}
			
			protected function cmbjenis_changeHandler(event:IndexChangeEvent):void
			{
				
				this.callLater(nanti);
				// TODO Auto-generated method stub
				function nanti():void
				{
					o.cekid = false;
					for(i = 0; i<dg.dataProviderLength; i++){
						if(dg.dataProvider[i].norek.length > 0){
							o.cekid = true; 
						}
					}
					
					if(o.cekid){
						Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
							if(e.detail == Alert.YES){
								F_setEnabled();
								FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
								o.cmb = cmbjenis.selectedIndex;
							}else{
								cmbjenis.selectedIndex = int(o.cmb);
								F_setEnabled()
							}
						});
					}else{
						o.cmb = cmbjenis.selectedIndex;
						F_setEnabled();
					}
					
				}
				
				
				
			}
			
			public function F_setEnabled():void{
				switch(cmbjenis.selectedIndex){
					case 0 :
						F_EnabledText([txtcabang, txtlokasi, txtcostcenter, txtdivisi, txtproyek]);
						FlexGlobals.topLevelApplication.F_KosongkanText([txtcabang, txtlokasi, txtcostcenter, txtdivisi, txtproyek, lblcabang, lbllokasi, lblcostcenter, lbldivisi, lblproyek]);
						break;
					case 1:
						F_EnabledText([txtcabang], true);
						F_EnabledText([txtlokasi, txtcostcenter, txtdivisi, txtproyek]);
						FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi, txtcostcenter, txtdivisi, txtproyek, lbllokasi, lblcostcenter, lbldivisi, lblproyek]);
						break;
					case 2:
						F_EnabledText([txtlokasi], true);
						F_EnabledText([txtcabang, txtcostcenter, txtdivisi, txtproyek]);
						FlexGlobals.topLevelApplication.F_KosongkanText([txtcabang, txtcostcenter, txtdivisi, txtproyek, lblcabang, lblcostcenter, lbldivisi, lblproyek]);
						break;
					case 3:
						F_EnabledText([txtcostcenter], true);
						F_EnabledText([txtlokasi, txtcabang, txtdivisi, txtproyek]);
						FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi, txtcabang, txtdivisi, txtproyek, lbllokasi, lblcabang, lbldivisi, lblproyek]);
						break;
					case 4:
						F_EnabledText([txtdivisi], true);
						F_EnabledText([txtlokasi, txtcostcenter, txtcabang, txtproyek]);
						FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi, txtcostcenter, txtcabang, txtproyek, lbllokasi, lblcostcenter, lblcabang, lblproyek]);
						break;
					case 5:
						F_EnabledText([txtproyek], true);
						F_EnabledText([txtlokasi, txtcostcenter, txtcabang, txtdivisi]);
						FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi, txtcostcenter, txtcabang, txtdivisi, lbllokasi, lblcostcenter, lblcabang, lbldivisi]);
						break;
				}
			}
