			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "tampilData":
						for(i=dg.dataProviderLength-1;i>=0;i--){
							if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
								dg.dataProvider.removeItemAt(i);
							}
						}
						f_hitungTotal();
						break;
					case "txtmatauang":parentApplication.F_KosongkanText([txtmatauang]);break;
				}
			}
			public function centang():void{
				ac2.removeAll();
				for (var i:int = 0; i < dg.dataProviderLength; i++) 
					if(dg.dataProvider[i].norek.length > 0){
						if(dg.dataProvider.getItemAt(i).chk==1){
							with(dg.dataProvider.getItemAt(i))	
								ac2.addItem({No:i+1, norek:norek, idbddetail:idbddetail, idbd:idbd,jumlah:jumlah, jumlahvalas:jumlahvalas, subdivisi:subdivisi,
									matauang:txtmatauang.text,kurs:o.txtkurs, jumlah:jumlah,jumlahvalas:jumlahvalas,catatan:catatan, isclose:isclose, 
									customtext1:customtext1, customtext2:customtext2, customtext3:customtext3, customdbl1:customdbl1, customdbl2:customdbl2,
									customdbl3:customdbl3,customdate1:customdate1,customdate2:customdate2,customdate3:customdate3});
						}
						
					}
			}
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				centang();
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String = '', strBarang:String = '', tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi){
						// Set Utama
						with(o){
							a = [bdid, bdcabang, bdlokasi, bdsumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
