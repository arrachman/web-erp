				FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
				FlexGlobals.topLevelApplication.F_defaultGridItem(dgbarang);
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "BD");
				//set progress
				mb.menuBarItems[0].enabled=true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				cmbprogress.enabled = true;
				txtnotransaksi.text = 'Auto';
				FlexGlobals.topLevelApplication.FormFilter = '';
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalvalas],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				isUpdate = false;
				F_setEnabled();
				txtkontak.text = FlexGlobals.topLevelApplication.ukontakkode;
				lblkontak.text = FlexGlobals.topLevelApplication.ukontaknama;
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("BD");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("BD",1);
				parentApplication.F_SetNilaiText([dttgl, dttglanggaran, dttglanggaran0], parentApplication.DefaultTanggal);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtkontakperson, txtakun1, txtakun2, txtcabang, txtlokasi, txtcostcenter, txtdivisi, txtproyek, lblcabang, lbllokasi, lblcostcenter, lbldivisi, lblproyek])
				
					o.bdid = 0; o.bdcabang = FlexGlobals.topLevelApplication.ucabang; o.bdlokasi = FlexGlobals.topLevelApplication.ulokasi; 
					o.bdsumber = "BD"; o.bdkodepa = 0; o.bdkontak = FlexGlobals.topLevelApplication.ukontak; o.bdkontakperson; 
					o.bdanggaransubdivisi = ""; o.bdstatussebelumnya = 0; o.bdjmlrevisi = 0; o.bdcetakanke= 0; o.bdisclose = 0; 
					o.bdinputuser = FlexGlobals.topLevelApplication.userid; o.bdinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.bdmodifikasiuser = FlexGlobals.topLevelApplication.userid; o.bdmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.bdposting = 0; o.bdpostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.bdcustomtext1 = ""; o.bdcustomtext2 = ''; o.bdcustomtext3 = ''; o.bdcustomtext4 = ''; o.bdcustomtext5 = ''; 
					o.bdcustomint1 = 0; o.bdcustomint2 = 0; o.bdcustomint3 = 0; 
					o.bdcustomdbl1 = 0; o.bdcustomdbl2 = 0; o.bdcustomdbl3 = 0; 
					o.bdcustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.bdcustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.bdcustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
				
				f_focusOnMe();
				
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			
			protected function f_wsTampil(page:int = 0, sort:String = 'cnomor asc'):void
			{
				var filter : String = 'tahun = year("'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglanggaran.text)+'") and bulan = month("'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglanggaran.text)+'")';
				switch (cmbjenis.selectedIndex){
					case 0:
						F_wsSearch("tampilData", "CdM2_Realization", page, 0, filter, sort, "", "", f_filterdata());
						break;
					case 1:
						if(txtcabang.text.length > 0)
							F_wsSearch("tampilData", "CdM2_Realization_Branch", page, 0, filter+' AND cabang = "'+txtcabang.text+'"', sort, "", "", f_filterdata());
						else
							Alert.show(FlexGlobals.topLevelApplication.l("Cabang harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
						break;
					case 2: 
						if(txtlokasi.text.length > 0)
							F_wsSearch("tampilData", "CdM2_Realization_Location", page, 0, filter+' AND lokasi = "'+txtlokasi.text+'"', sort, "", "", f_filterdata());
						else
							Alert.show(FlexGlobals.topLevelApplication.l("Lokasi harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
						break;
					case 3:
						if(txtcostcenter.text.length > 0)
							F_wsSearch("tampilData", "CdM2_Realization_Costcenter", page, 0, filter+' AND costcenter = "'+txtcostcenter.text+'"', sort, "", "", f_filterdata());
						else
							Alert.show(FlexGlobals.topLevelApplication.l("Cost Center harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
						break;
					case 4:
						if(txtdivisi.text.length > 0)
							F_wsSearch("tampilData", "CdM2_Realization_Division", page, 0, filter+' AND divisi = "'+txtdivisi.text+'"', sort, "", "", f_filterdata());
						else
							Alert.show(FlexGlobals.topLevelApplication.l("Divisi harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
						break;
					case 5:
						if(txtproyek.text.length > 0)
							F_wsSearch("tampilData", "CdM2_Realization_Project", page, 0, filter+' AND proyek = "'+txtproyek.text+'"', sort,"", "", f_filterdata());
						else
							Alert.show(FlexGlobals.topLevelApplication.l("Proyek harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
						break;
				}
			}
			public function f_filterdata():String{4
				var f:String='cgd = "D" AND caktif = 1';
				
				if (txtakun1.text.length > 0 && txtakun2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'cnomor BETWEEN "'+txtakun1.text+'" AND "'+txtakun2.text+'"');
				}
				if (txtakun1.text.length > 0 && txtakun2.text.length == 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'cnomor >="'+txtakun1.text+'"');
				}
				if (txtakun1.text.length == 0 && txtakun2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'cnomor <= "'+txtakun2.text+'"');
				}
				for(i=0; i<dg.dataProviderLength; i++){
					if(dg.dataProvider[i].chk == 1){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'(cnomor <>"'+dg.dataProvider.getItemAt(i).norek+'")'); 
					}
				}
				
				return f;
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(2,135,jenissimpan)){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
