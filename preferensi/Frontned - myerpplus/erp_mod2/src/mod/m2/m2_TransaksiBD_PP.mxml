						wsfilter = 'paktif=1 AND pkode = "'+dgbarang.dataProvider.getItemAt(dgbarang.selectedCell.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
