						dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(false, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.customdbl1 = (Number(dgrid1.jml) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.bjmllapangan);
						dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml; 
