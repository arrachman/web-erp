								txtcostcenter.text, txtdivisi.text, bdanggaransubdivisi, txtproyek.text, txturaian.text, txtcatatan.text, txtmatauang.text, 
								o.txtkurs, cmbprogress.selectedItem.v, bdstatussebelumnya, bdjmlrevisi, bdcetakanke, bdisclose, bdinputuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(bdinputtgl), bdmodifikasiuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(bdmodifikasitgl), bdposting, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(bdpostingtgl), bdcustomtext1, bdcustomtext2, 
								bdcustomtext3, bdcustomtext4, bdcustomtext5, bdcustomint1, bdcustomint2, bdcustomint3, bdcustomdbl1, 
								bdcustomdbl2, bdcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(dttglanggaran0.text), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(bdcustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(bdcustomdate3)];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
						
						//Detail
						if (ac2.length > 0){
							for(i=0;i<ac2.length;i++){
								with(ac2.getItemAt(i)){
									a = [idbddetail, idbd, norek, txtmatauang.text, o.txtkurs, jumlah, jumlahvalas, 
										catatan, txtcostcenter.text, txtdivisi.text, subdivisi, txtproyek.text, i+1, isclose, 
										customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detail =  FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+ FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							}
						}
						
						
						//Item
						for(i=0;i<dgbarang.dataProviderLength;i++){
							with(dgbarang.dataProvider.getItemAt(i)){
								if(dgbarang.dataProvider.getItemAt(i).idbddetail != undefined){
									a = [idbddetail, idbd, idbarang, namabarang, tipebarang, jml, satuan, 
										nilaisatuan, jmlbarang, satuanbarang, matauang, kurs, hargafix, harga, 
										diskon, jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, 
										lokasi, gudang, costcenter, divisi, subdivisi, proyek, catatan, 
										(i+1), isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
										customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)strBarang = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else strBarang += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);	
								}
							}
						}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_BdSimpan", parentApplication.userid, isUpdate, utama, detail + FlexGlobals.topLevelApplication.sptSubParam + strBarang);
					}
				}
				
