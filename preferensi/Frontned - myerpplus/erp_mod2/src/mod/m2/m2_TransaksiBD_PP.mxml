			public function f_focusOnMe():void
			{
				cmbjenis.setFocus();
			}
			
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "checkBoxHeader":
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case "checkBox":
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
			protected function f_persiapan():void
			{
				tab.focusEnabled = false
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				ft=FlexGlobals.topLevelApplication.F_tglFormatDB;
				hf= FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				//set cmbjenis
				
				//set cmbstatus
				
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				FlexGlobals.topLevelApplication.F_RequiredLabel([ttanggal, ttanggalanggaran, tnotransaksi, tprogress, tjenis]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([takun, tcabang, tlokasi, tdivisi, tcostcenter, tproyek, tnotransaksi, tprogress, tcatatan])
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl, dttglanggaran, dttglanggaran0]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress,cmbjenis]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan, txtkontakperson]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtkontak, txtmatauang, txtcabang, txtlokasi, txtcostcenter, txtdivisi, txtproyek, txtakun1, txtakun2]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,chkauto,chkposting]);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLink);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(2,135,jenissimpan)){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void{FlexGlobals.topLevelApplication.f_bukaTransaksi("Bd");}
				function f_mbReset():void{
					mb.menuBarItems[4].enabled = false;
					mb.menuBarItems[5].enabled = false;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
					
				}
				function f_mbTampilkan():void{
					if(cmbjenis.selectedIndex < 0){
						Alert.show(FlexGlobals.topLevelApplication.l('Jenis harus dipilih terlebih dahulu !'),FlexGlobals.topLevelApplication.l('Informasi'));
					}else{
						f_wsTampil();
					}
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[4].enabled)FlexGlobals.topLevelApplication.F_OpenNotes(o.bdgsumber,o.bdid,txtnotransaksi.text);
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[5].enabled)FlexGlobals.topLevelApplication.F_OpenUploadFile('BD', o.bdid,txtnotransaksi.text);
				}
				function f_mbLink():void {
					if(mb.menuBarItems[6].enabled)FlexGlobals.topLevelApplication.f_mbLinks(2,'Bd');
				}
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
					if(event.keyCode == Keyboard.ENTER){
						dg.setFocus();
						dg.setSelectedCell(0,0);
					}
				}
				);
				
				
				
				//cmbjenis.setFocus();
				F_wsSearch("jenis","CdM0_Realization_Category",1,50,'(aktif = 1)', "kode asc")
				FlexGlobals.topLevelApplication.F_RegGrid(2,135,[dg,dgbarang],'transaksi');
				f_validasi();
				
			}
			
			// WS Search
			public function F_wsSearch(Subject:String, paket:String, pageNumber:int = 0, itemLimit:int = 0, strFilter:String = "", strSort:String = "", formatTgl:String = '', formatTglWaktu:String = '', filter2:String = ""):void
			{
				if(formatTgl == '')formatTgl = FlexGlobals.topLevelApplication.m.formatDate;
				if(formatTglWaktu == '')formatTglWaktu = FlexGlobals.topLevelApplication.m.formatDate+" "+FlexGlobals.topLevelApplication.m.formatTime
				FlexGlobals.topLevelApplication.F_callWS(Subject, paket, pageNumber+FlexGlobals.topLevelApplication.sptSubParam+itemLimit+FlexGlobals.topLevelApplication.sptSubParam+strFilter+FlexGlobals.topLevelApplication.sptSubParam+strSort+FlexGlobals.topLevelApplication.sptSubParam+formatTgl+FlexGlobals.topLevelApplication.sptSubParam+formatTglWaktu,0,1,filter2)
			}
			
			public function f_validasi():void{
				
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "BD");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
					
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M2_BdHistoryGetdataById', idtransaksi, 0, 0, '', 'bdid ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M2_BdGetdataById', idtransaksi, 0, 0, '', 'bdid ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
