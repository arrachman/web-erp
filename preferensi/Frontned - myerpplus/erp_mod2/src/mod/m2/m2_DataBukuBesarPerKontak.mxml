	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Text;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			
			import spark.events.GridEvent;
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array;
			public var o:Object = {}, idbayarke:String='', iduser:String='';
			public function f_focusOnMe():void
			{
				
			}
			
			public function f_persiapan():void
			{
				// Config Paging
				dg1.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = '0';
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(2, 90);
				a = [2, 6, 19, 'Sm', false];
				parentApplication.F_TranslateLabel([ttanggal, tnorekening, tkontak, tjenislaporan]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tnorekening, tkontak]);
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				parentApplication.F_ComboBoxStandard([cmbjenislaporan]);
				parentApplication.F_txtpencarian([txtkontak1, txtnorekening1]);
				parentApplication.F_SetNavigasiKeyboard([]);
				
				FlexGlobals.topLevelApplication.F_setGridJson(2, 97);
				FlexGlobals.topLevelApplication.registerGrid([dg1], 'data');
				
				dttgl2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				txtnorekening2.addEventListener(FocusEvent.FOCUS_IN, f_changenorek);
				txtkontak2.addEventListener(FocusEvent.FOCUS_IN, f_changekontak);
				
				var rowindex:int = 0, columnindex:int = 0;
				dg1.addEventListener(GridEvent.GRID_ROLL_OVER, f_dgROLL_OVER);
				function f_dgROLL_OVER(e:GridEvent):void
				{
					if(dg1.dataProviderLength > 0){
						rowindex = e.rowIndex;
						columnindex = e.columnIndex;
					}
				}
				
				var vCMI:ContextMenuItem;
				dg1.contextMenu = new ContextMenu;
				dg1.contextMenu.hideBuiltInItems();
				dg1.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_MENU_SELECT);
				vCMI = new ContextMenuItem('Jurnal Voucher')      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jurnalVocher); 
				dg1.contextMenu.customItems.push(vCMI);    
				
				
				
				function f_MENU_SELECT():void
				{
					dg1.setSelectedCell(rowindex, columnindex);
				}
				function f_jurnalVocher():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(2, 97, 11)){
						
						if(dg1.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(2, 97, 11))
							FlexGlobals.topLevelApplication.F_wsSearch(FlexGlobals.topLevelApplication.sptParam+'tampilFDJurnalVocher', 'M2_Transaction_Journal_VoucherSearch', 0, 0, "tnotransaksi = '"+dg1.dataProvider[dg1.selectedCell.rowIndex].tnotransaksi+"'", "tgrup, turutan");
					}
				}
				
				ttwpopup.addEventListener(CloseEvent.CLOSE,f_close);
				function f_close():void{
					grppopup.visible = false;
					gridjv.dataProvider.removeAll();
				}
				// fungsi menubar
				// fungsi menubar
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbCetak);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbExport);
				function f_mbTampilkan():void
				{
					if(mb.menuBarItems[0].enabled)
						if(int(txtpaging.text) == 0)
							f_formDataTampil();
						else
							f_formDataTampil(int(txtpaging.text));
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbCetak():void
				{
					var filter:String = parentApplication.F_tglFormatDB(dttgl1.text)+'▲'+parentApplication.F_tglFormatDB(dttgl2.text)+'▲'+txtnorekening1.text+'▲'+txtnorekening2.text+'▲'+txtkontak1.text+'▲'+txtkontak2.text;
					FlexGlobals.topLevelApplication.F_openReport(2, 90, cmbjenislaporan.selectedItem.ritem, filter, '', '', 0);
				}
				function f_mbExport(e:MenuEvent):void
				{
					var filter:String = parentApplication.F_tglFormatDB(dttgl1.text)+'▲'+parentApplication.F_tglFormatDB(dttgl2.text)+'▲'+txtnorekening1.text+'▲'+txtnorekening2.text;
					switch(e.label){
						case "PDF": FlexGlobals.topLevelApplication.F_openReport(2, 90, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Ms.Excel": FlexGlobals.topLevelApplication.F_openReport(2, 90, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Html": FlexGlobals.topLevelApplication.F_openReport(2, 90, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Ms.Word": FlexGlobals.topLevelApplication.F_openReport(2, 90, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Text": FlexGlobals.topLevelApplication.F_openReport(2, 90, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Image": FlexGlobals.topLevelApplication.F_openReport(2, 90, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
					}
				}
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				function f_changenorek():void{
					txtnorekening2.text = txtnorekening1.text;	
				}
				function f_changekontak():void{
					txtkontak2.text = txtkontak1.text;
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_formDataTampil(int(txtpaging.text));
				}
				function f_firstCLICK():void
				{
					f_formDataTampil();
				}
				function f_previousCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)-1);
				}
				function f_nextCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)+1);
				}
				function f_lastCLICK():void
				{
					f_formDataTampil(int(-1));
				}
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.HOME:
							if(int(txtpaging.text)>1)
								f_formDataTampil();
							break;
						case Keyboard.PAGE_UP:
							if(int(txtpaging.text)-1>0)
								f_formDataTampil(int(txtpaging.text)-1);
							break;
						case Keyboard.PAGE_DOWN:
							f_formDataTampil(int(txtpaging.text)+1);
							break;
						case Keyboard.END:
							f_formDataTampil(-1);
							break;
						case Keyboard.P:
							if(e.ctrlKey)
								f_cetak();
							break;
						case Keyboard.R:
							if(e.ctrlKey)
								f_kondisiAwal();
							break;
					}
				}
				
				if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
					mb.menuBarItems[0].enabled = false;
					o.filter = parentApplication.m.ArrFilter[0];
					o.a = o.filter.split("AND")
					o.filter = sp(o.a[0])+'▲'+sp(o.a[1])+'▲'+sp(o.a[2])+'▲'+sp(o.a[3])+'▲'+sp(o.a[4])+'▲'+sp(o.a[5])+'▲cnomor';
					o.statistik = true;
					//					if(o.arr[0] == 'statistik')
					//						parentApplication.F_SetNilaiText([txtnorekening1, txtnorekening2], parentApplication.m.ArrFilter[1]);
					//						parentApplication.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
					f_formDataTampil(1);
				}else{
					f_kondisiAwal();
				}
				
				function sp(data:String):String
				{//param1 = "value1" AND param2 = "value2"
					return data.split('"')[1];
				}
				
				
			}
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				dttgl1.setFocus();
				parentApplication.F_KosongkanText([dttgl1,dttgl2,txtnorekening1,txtnorekening2,txtkontak1,txtkontak2]);
				parentApplication.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				//				parentApplication.F_SetNilaiText([txtkontak1, txtkontak2], parentApplication.ukontakkode);
				mb.menuBarItems[0].enabled = true;
				dg1.dataProvider.removeAll();
//				cmbstatus.selectedIndex = o.DefaultStatus;
			}
			
			public function f_formDataTampil(page:int = 1):void
			{
				if(o.statistik){
					FlexGlobals.topLevelApplication.F_wsSimpan("Tampilkan", 'M2_GeneralLedger', 0, false, o.filter, '', page, 20, '', '');
				}else if(txtnorekening1.text.length > 0 && txtkontak1.text.length > 0){
					FlexGlobals.topLevelApplication.F_wsSimpan("Tampilkan", 'M2_GeneralLedger', 0, false, parentApplication.F_tglFormatDB(dttgl1.text)+'▲'+parentApplication.F_tglFormatDB(dttgl2.text)+'▲'+txtnorekening1.text+'▲'+txtnorekening2.text+'▲'+txtkontak1.text+'▲'+txtkontak2.text+'▲cnomor', '', page, 20, '', '');
				}else if(txtnorekening1.text.length == 0 && txtkontak1.text.length > 0){
					Alert.show("No Akun harus diisi dengan benar !","Information");
				}else if(txtnorekening1.text.length > 0 && txtkontak1.text.length == 0){
					Alert.show("Kontak harus diisi dengan benar !","Information");
				}else{
					Alert.show("Kontak dan No Akun harus diisi dengan benar !","Information");
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var moduleid:int=0, menuid:int=0, sumber:String="";
				switch(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsumber){
					case "AJ": moduleid=2; menuid=8; break;
					case "AP": moduleid=4; menuid=8; break;
					case "AS": moduleid=5; menuid=5; break;
					case "CB": moduleid=2; menuid=65; break;
					case "CD": moduleid=2; menuid=4; break;
					case "CR": moduleid=2; menuid=3; break;
					case "DA": moduleid=7; menuid=11; break;
					case "GJ": moduleid=2; menuid=7; break;
					case "GRN": moduleid=4; menuid=10; break;
					case "IB": moduleid=3; menuid=23; break;
					case "IP": moduleid=5; menuid=44; break;
					case "PD": moduleid=6; menuid=8; break;
					case "PP": moduleid=4; menuid=44; break;
					case "PV": moduleid=5; menuid=14; break;
					case "RG": moduleid=2; menuid=9; break;
					case "RGC": moduleid=2; menuid=11; break;
					case "RM": moduleid=2; menuid=5; break;
					case "RP": moduleid=5; menuid=41; break;
					case "RV": moduleid=2; menuid=13; break;
					case "SA": moduleid=3; menuid=6; break;
					case "SG": moduleid=2; menuid=10; break;
					case "SGC": moduleid=2; menuid=12; break;
					case "SM": moduleid=2; menuid=6; break;
					case "VP": moduleid=4; menuid=15; break;
					
//					tissaldoawal
					case "RI":
						if(dg1.dataProvider[dg1.selectedCell.rowIndex].tissaldoawal==0){
							moduleid=4; menuid=11; 
						}else{
							moduleid=4; menuid=51; sumber='RI';
						}
						break;
					
					case "PRT": 
						if(dg1.dataProvider[dg1.selectedCell.rowIndex].tissaldoawal==0){
							moduleid=4; menuid=13;
						}else{
							moduleid=4; menuid=51; sumber='PRT';
						}
						break;
					case "SI":
						if(dg1.dataProvider[dg1.selectedCell.rowIndex].tissaldoawal==0){
							moduleid=5; menuid=10; 
						}else{
							moduleid=4; menuid=51; sumber='Si';
						}
						break;
					case "SR": 
						if(dg1.dataProvider[dg1.selectedCell.rowIndex].tissaldoawal==0){
							moduleid=5; menuid=12; 
						}else{
							moduleid=4; menuid=51; sumber='Sr';
						}
						break;
				}
				
				if(dg1.dataProvider[dg1.selectedCell.rowIndex].tissaldoawal==0){
					if(parentApplication.apaBisaAkses(a[0], a[2], 4)){
						FlexGlobals.topLevelApplication.openForm(moduleid, menuid, dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tidtransaksi);
					}
				}else{
					if(parentApplication.apaBisaAkses(a[0], a[2], 4)){
						FlexGlobals.topLevelApplication.openForm(moduleid, menuid, dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tidtransaksi, [dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsumber]);
					}
				}
				
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtnorekening1":
						paket = 'CdM1_Coa';
						csfilter = "caktif=1 and cgd = 'D'";
						wsfilter = "caktif=1 AND cnomor ='"+ txtnorekening1.text+"' and cgd = 'D'";
						csfield = 2;
						break;
					case "txtnorekening2":
						paket = 'CdM1_Coa';
						csfilter = "caktif=1";
						wsfilter = "caktif=1 AND cnomor ='"+ txtnorekening2.text+"'";
						csfield = 2;
						break;
					case "txtkontak1":
						paket = 'CdM1_Contact';
						csfilter = "kaktif=1";
						wsfilter = "kaktif=1 AND kkode ='"+txtkontak1.text+"'";
						break;
					case "txtkontak2":
						paket = 'CdM1_Contact';
						csfilter = "kaktif=1";
						wsfilter = "kaktif=1 AND kkode ='"+txtkontak2.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(parentApplication.wsSuccess){
					if(parentApplication.wsArrUtama.getItemAt.length >= 0)ws = parentApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case "txtnorekening1":
							txtnorekening1.text = ws.cnomor;
							txtnorekening2.text = ws.cnomor;
							lblnoakun.text = ws.cnama;
							break;
						case "txtnorekening2":
							txtnorekening2.text = ws.cnomor;
							break;
						case "txtkontak1":
							txtkontak1.text = ws.kkode;
							txtkontak2.text = ws.kkode;
							lblkontak.text = ws.knama;
							break;
						case "txtkontak2":
							txtkontak2.text = ws.kkode;
							break;
						case "Tampilkan":
							dg1.dataProvider = parentApplication.wsArrUtama;
							imgfirst.enabled = parentApplication.wsIsPrev;
							imgprevious.enabled = parentApplication.wsIsPrev;
							imgnext.enabled = parentApplication.wsIsNext;
							imglast.enabled = parentApplication.wsIsNext;
							txtpaging.text = parentApplication.wsCurPage;
							for(i=0;i<dg1.dataProviderLength;i++)
								dg1.dataProvider[i].no = (((parentApplication.wsCurPage-1)*20)+(i+1));
							parentApplication.F_dgRefresh(dg1);
							dg1.setFocus();
							dg1.setSelectedCell(0, 0);
							break;
					}
				}else{
					if(parentApplication.F_validasiFalse(s))
						switch(s){
							case "Tampilkan":
								dg1.dataProvider.removeAll();
								break;
						}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtnorekening1":parentApplication.F_KosongkanText([txtnorekening1]);break;
					case "txtnorekening2":parentApplication.F_KosongkanText([txtnorekening2]);break;
					case "txtkontak1":parentApplication.F_KosongkanText([txtkontak1]);break;
					case "txtkontak2":parentApplication.F_KosongkanText([txtkontak2]);break;
				}
			}
			
