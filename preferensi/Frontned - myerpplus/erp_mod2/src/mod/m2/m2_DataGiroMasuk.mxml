			public function f_persiapan():void
			{
				// Config Paging
				dg1.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = '0';
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(2, 100);
				cmbjenislaporan.selectedIndex = 0;
				a = [2, 6, 19, 'Sm', false];
				parentApplication.F_TranslateLabel([ttanggaljt, tnogiro, tkontak, tjenislaporan, ttanggaljt0, takun, tstatus0]);
				parentApplication.F_DateFieldStandard([dttgllJT, dttgllJT2, dttgll1, dttgll2]);
				parentApplication.F_ComboBoxStandard([cmbjenislaporan, cmbstatus, cmbstatusJT]);
				parentApplication.F_txtpencarian([txtkontak, txtbank, txtakun]);
				
				parentApplication.F_SetNavigasiKeyboard([txtnogiro1]);
				cmbstatusJT.dataProvider = new ArrayCollection([{l:'Semua',v:-1},{l:'Belum',v:0},{l:'Sudah',v:1}]);
				FlexGlobals.topLevelApplication.F_setGridJson(2, 100);
				FlexGlobals.topLevelApplication.registerGrid([dg1], 'data');
				
				dttgll2.addEventListener(FocusEvent.FOCUS_IN, f_changedate2);
				dttgllJT2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				txtnogiro2.addEventListener(FocusEvent.FOCUS_IN, f_changenorek);
				
				//				o.arr = parentApplication.m.ArrFilter;
				//				if(o.arr.length > 0)
				//					if(o.arr[0] == 'statistik')
				//					{
				//						txtnorekening1.text = o.arr[1];
				//						txtkontak2.text = o.arr[2];
				//						
				//						// statistik, cnomor1;
				//					}
				var rowindex:int = 0, columnindex:int = 0;
				dg1.addEventListener(GridEvent.GRID_ROLL_OVER, f_dgROLL_OVER);
				function f_dgROLL_OVER(e:GridEvent):void
				{
					if(dg1.dataProviderLength > 0){
						rowindex = e.rowIndex;
						columnindex = e.columnIndex;
					}
				}
				
				var vCMI:ContextMenuItem;
				dg1.contextMenu = new ContextMenu;
				dg1.contextMenu.hideBuiltInItems();
				dg1.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_MENU_SELECT);
				vCMI = new ContextMenuItem('Jurnal Voucher')      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jurnalVocher); 
				dg1.contextMenu.customItems.push(vCMI);    
				
				
				
				function f_MENU_SELECT():void
				{
					dg1.setSelectedCell(rowindex, columnindex);
				}
				
				function f_jurnalVocher():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(2, 100, 11)){
						
						if(dg1.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(2, 100, 11))
							FlexGlobals.topLevelApplication.F_wsSearch(FlexGlobals.topLevelApplication.sptParam+'tampilFDJurnalVocher', 'M2_Transaction_Journal_VoucherSearch', 0, 0, "tnotransaksi = '"+dg1.dataProvider[dg1.selectedCell.rowIndex].glnotransaksi+"'", "tgrup, turutan");
					}
				}
				
				ttwpopup.addEventListener(CloseEvent.CLOSE,f_close);
				function f_close():void{
					grppopup.visible = false;
					gridjv.dataProvider.removeAll();
				}
				
				// fungsi menubar
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbCetak);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbExport);
				function f_mbTampilkan():void
				{
					if(mb.menuBarItems[0].enabled)
						if(int(txtpaging.text) == 0)
							f_formDataTampil();
						else
							f_formDataTampil(int(txtpaging.text));
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				
				function f_mbCetak():void
				{
					FlexGlobals.topLevelApplication.F_openReport(2, 100, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', 0, dttgll1.text+" s/d "+dttgll2.text);
				}
				function f_mbExport(e:MenuEvent):void
				{
					switch(e.label){
						case "PDF": FlexGlobals.topLevelApplication.F_openReport(2, 100, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.data, dttgll1.text+" s/d "+dttgll2.text);
							break;
						case "Ms.Excel": FlexGlobals.topLevelApplication.F_openReport(2, 100, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.data, dttgll1.text+" s/d "+dttgll2.text);
							break;
						case "Html": FlexGlobals.topLevelApplication.F_openReport(2, 100, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.data, dttgll1.text+" s/d "+dttgll2.text);
							break;
						case "Ms.Word": FlexGlobals.topLevelApplication.F_openReport(2, 100, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.data, dttgll1.text+" s/d "+dttgll2.text);
							break;
						case "Text": FlexGlobals.topLevelApplication.F_openReport(2, 100, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.data, dttgll1.text+" s/d "+dttgll2.text);
							break;
						case "Image": FlexGlobals.topLevelApplication.F_openReport(2, 100, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.data, dttgll1.text+" s/d "+dttgll2.text);
							break;
					}
				}
				function f_changedate():void{
					dttgllJT2.text = dttgllJT.text;
				}
				function f_changedate2():void{
					dttgll2.text = dttgll1.text;
				}
				function f_changenorek():void{
					txtnogiro2.text = txtnogiro1.text;	
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_formDataTampil(int(txtpaging.text));
				}
				function f_firstCLICK():void
				{
					f_formDataTampil();
				}
				function f_previousCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)-1);
				}
				function f_nextCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)+1);
				}
				function f_lastCLICK():void
				{
					f_formDataTampil(int(-1));
				}
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.HOME:
							if(int(txtpaging.text)>1)
								f_formDataTampil();
							break;
						case Keyboard.PAGE_UP:
							if(int(txtpaging.text)-1>0)
								f_formDataTampil(int(txtpaging.text)-1);
							break;
						case Keyboard.PAGE_DOWN:
							f_formDataTampil(int(txtpaging.text)+1);
							break;
						case Keyboard.END:
							f_formDataTampil(-1);
							break;
						case Keyboard.P:
							if(e.ctrlKey)
								f_cetak();
							break;
						case Keyboard.R:
							if(e.ctrlKey)
								f_kondisiAwal();
							break;
					}
				}
				
				var arr:Array;
				if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
					mb.menuBarItems[0].enabled = false;
					o.filter = parentApplication.m.ArrFilter[0];
					arr = o.filter.split("  =");
					if(arr[0] == "glumurklasifikasi"){
						switch(int(sp(o.filter))){
							case 0:o.filter = "((DATEDIFF(now(), gltgljthtempo)) < 0) and gljenis = 0 and glstatus = 0";break;
							case 1:o.filter = "(((DATEDIFF(now(), gltgljthtempo)) >= 0) and ((DATEDIFF(now(), gltgljthtempo)) <= 30)) and gljenis = 0 and glstatus = 0";break;
							case 2:o.filter = "(((DATEDIFF(now(), gltgljthtempo)) >= 31) and ((DATEDIFF(now(), gltgljthtempo)) <= 60)) and gljenis = 0 and glstatus = 0";break;
							case 3:o.filter = "(((DATEDIFF(now(), gltgljthtempo)) >= 61) and ((DATEDIFF(now(), gltgljthtempo)) <= 90)) and gljenis = 0 and glstatus = 0";break;
							case 4:o.filter = "((DATEDIFF(now(), gltgljthtempo)) >= 91) and gljenis = 0 and glstatus = 0";break;
						}
					}
					o.statistik = true;
					
					f_formDataTampil(1);
				}else{
					f_kondisiAwal();
				}
				
				function sp(data:String):String
				{//param1 = "value1" AND param2 = "value2"
//					return "";
					return data.split('"')[1];
				}
				
				
				FlexGlobals.topLevelApplication.F_wsSearch('status',"CdM0_Status_Giro",0,0,'');
				
			}
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				parentApplication.F_KosongkanText([txtnogiro1,txtnogiro2,txtkontak, txtbank, txtakun]);
				cmbstatus.selectedIndex = o.DefaultStatus; cmbstatusJT.selectedIndex = 0;
				parentApplication.F_SetNilaiText([dttgllJT, dttgllJT2, dttgll1, dttgll2], parentApplication.DefaultTanggal);
				dttgll1.text = FlexGlobals.topLevelApplication.DefaultTanggal;
				mb.menuBarItems[0].enabled = true;
				dg1.dataProvider.removeAll();
			}
			
			public function f_formDataTampil(page:int = 1):void
			{
				if(o.statistik){
					FlexGlobals.topLevelApplication.F_wsSearch("Tampilkan", 'M2_Giro_ListSearch', page, 20, o.filter,"glnogiro asc");
				}else{
					FlexGlobals.topLevelApplication.F_wsSearch("Tampilkan", 'M2_Giro_ListSearch', page, 20, f_filterdata(), "glnogiro asc");
				}
				
			}
			
			public function f_filterdata():String{
				var f:String="gljenis=0";
				
				if(dttgllJT.text.length > 0 && dttgllJT2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT.text.split('"').join('\\"'))+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT2.text.split('"').join('\\"'))+'"');
				}else if(dttgllJT.text.length > 0 && dttgllJT2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT.text.split('"').join('\\"'))+'"');
				}else if(dttgllJT.text.length <= 0 && dttgllJT2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT2.text.split('"').join('\\"'))+'"');
				}
				
				if(dttgll1.text.length > 0 && dttgll2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'ttgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgll1.text.split('"').join('\\"'))+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgll2.text.split('"').join('\\"'))+'"');
				}else if(dttgll1.text.length > 0 && dttgll2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'ttgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgll1.text.split('"').join('\\"'))+'"');
				}else if(dttgll1.text.length <= 0 && dttgll2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'ttgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgll2.text.split('"').join('\\"'))+'"');
				}
				
				if(cmbstatusJT.selectedIndex == 1){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal)+'"');
				}else if(cmbstatusJT.selectedIndex == 2){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal)+'"');
				}
//				if(dttgllJT.text.length > 0){
//					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo = "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT.text.split('"').join('\\"'))+'"');
//				}
//				
//				if(txtnogiro1.text.length > 0){
//					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro like "%'+txtnogiro1.text.split('"').join('\\"')+'%"');
//				}
				if(txtnogiro1.text.length > 0 && txtnogiro2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro Between "'+txtnogiro1.text.split('"').join('\\"')+'" and "'+txtnogiro2.text.split('"').join('\\"')+'"');
				}else if(txtnogiro1.text.length > 0 && txtnogiro2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro >= "'+txtnogiro1.text.split('"').join('\\"')+'"');
				}else if(txtnogiro1.text.length <= 0 && txtnogiro2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro <= "'+txtnogiro2.text.split('"').join('\\"')+'"');
				}
				
				if(txtbank.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glbank ="'+txtbank.text.split('"').join('\\"')+'"');
				}
				if(txtakun.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glrekbank ="'+txtakun.text.split('"').join('\\"')+'"');
				}
				if(txtkontak.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glkontak ="'+vIdkontak+'"');
				}
				if(cmbstatus.selectedIndex > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glstatus ="'+cmbstatus.selectedItem.kode+'"');
				}
				
				return f;
				
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var moduleid:int=0, menuid:int=0;
				switch(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).glsumber){
					case "SM": moduleid=2; menuid=6; break;
					case "RM": moduleid=2; menuid=5; break;
					case "CB": moduleid=2; menuid=65; break;
					case "AP": moduleid=4; menuid=8; break;
					case "IP": moduleid=5; menuid=44; break;
					case "AS": moduleid=5; menuid=5; break;
					case "RP": moduleid=5; menuid=41; break;
					case "PV": moduleid=5; menuid=14; break;
				}
				if(parentApplication.apaBisaAkses(a[0], a[2], 4)){
					FlexGlobals.topLevelApplication.openForm(moduleid, menuid, dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).glidtransaksi);
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtbank":
						paket = 'CdM1_Bank';
						wsfilter = 'baktif=1 AND bkode = "'+txtbank.text+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break
					case "txtkontak":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif=1 AND kkode = "'+txtkontak.text+'"';
						csfilter = 'kaktif=1';
						sort = 'kkode asc';
						break; 
					case "txtakun":
						paket = 'CdM1_Coa';
						wsfilter = '(cgd ="D" AND caktif = 1) and cnomor = "'+txtakun.text+'" and ctipe = 1';
						csfilter = 'cgd ="D" AND caktif = 1 and ctipe = 1';
						sort = 'cnomor asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(parentApplication.wsSuccess){
					if(parentApplication.wsArrUtama.getItemAt.length >= 0)ws = parentApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case "txtbank":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtbank.text = ws.bkode;
							lblbank.text = ws.bnama
							break
						case "txtkontak":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkontak.text = ws.kkode;
							lblkontak.text = ws.knama;
							vIdkontak = ws.kid;
							break; 
						case "txtakun":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtakun.text = ws.cnomor;
							lblakun.text = ws.cnama;
							vIdkontak = ws.kid;
							break;
						case "status":
							cmbstatus.dataProvider = new ArrayCollection([{l:'Semua', v:-1}]);
							for(i = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama[i]){
									cmbstatus.dataProvider.addItem({l : nama, kode:kode});
								}
							}
							cmbstatus.selectedIndex = 0;
							break;
						case "Tampilkan":
							dg1.dataProvider = parentApplication.wsArrUtama;
							imgfirst.enabled = parentApplication.wsIsPrev;
							imgprevious.enabled = parentApplication.wsIsPrev;
							imgnext.enabled = parentApplication.wsIsNext;
							imglast.enabled = parentApplication.wsIsNext;
							txtpaging.text = parentApplication.wsCurPage;
							for(i=0;i<dg1.dataProviderLength;i++)
								dg1.dataProvider[i].no = (((parentApplication.wsCurPage-1)*20)+(i+1));
							parentApplication.F_dgRefresh(dg1);
							dg1.setFocus();
							dg1.setSelectedCell(0, 0);
							break;
					}
				}else{
					if(parentApplication.F_validasiFalse(s))
						switch(s){
							case "Tampilkan":
								dg1.dataProvider.removeAll();
								break;
						}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtbank":parentApplication.F_KosongkanText([txtbank, lblbank]);break;
					case "txtkontak":parentApplication.F_KosongkanText([txtkontak, lblkontak]);break;
					case "txtakun":parentApplication.F_KosongkanText([txtakun, lblakun]);break;
					case "Tampilkan":
						dg1.dataProvider.removeAll();
						break;
				}
			}
			
