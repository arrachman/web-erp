					if(txtbayarke.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtbayarke,'Bayar ke');
					for(i=0; i<dg.dataProviderLength; i++){
						if(dg.dataProvider.getItemAt(i).noakun.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dg,'No Akun');
//						if(dg.dataProvider.getItemAt(i).jumlah <= 0)FlexGlobals.topLevelApplication.msgAlert(dg,'Jumlah');
