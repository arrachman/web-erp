			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtbayarke":parentApplication.F_KosongkanText([txtbayarke, lblbayarke]);break;
					case "txtakunkas":parentApplication.F_KosongkanText([txtakunkas, lblakunkas]);break;
					case "txtmatauang":parentApplication.F_KosongkanText([txtmatauang]);break;
					case "txtlokasi":parentApplication.F_KosongkanText([txtlokasi, lbllokasi]);break;
				}
			}
			
			protected function f_simpan():void
			{
				var	a:Array, utama:String, detail:String, tgl:String;
				o.tanggal = dttgl.text;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi){
						// Set Utama
						with(o){
							a = [cdid, cdcabang, txtlokasi.text, cdsumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
								cdkodepa, cdkontak, txtkontakperson.text, txtakunkas.text, txturaian.text, txtcatatan.text, txtmatauang.text, 
								o.txtkurs, cdjumlah, cdjumlahvalas, cdjumlahbayar, cdjumlahbayarvalas, cdstatusbayar, cdtgllunas, 
								cmbprogress.selectedItem.v, cdstatussebelumnya, cdjmlrevisi, cdcetakanke, cdisclose, cdinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(cdinputtgl), 
								cdmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(cdmodifikasitgl), int(chkposting.selected), cdcustomtext1, cdcustomtext2, cdcustomtext3, cdcustomtext4, 
								cdcustomtext5, cdcustomint1, cdcustomint2, cdcustomint3, cdcustomdbl1, cdcustomdbl2, cdcustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(cdcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(cdcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(cdcustomdate3)];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
						// Set Detail
						for(i=0;i<dg.dataProviderLength;i++)
							with(dg.dataProvider.getItemAt(i)){
								a = [idcddetail, idcd, noakun, txtmatauang.text, o.txtkurs, jumlah, jumlahvalas, 
									catatan, costcenter, divisi, subdivisi, proyek, i+1, isclose, 
									customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_CdSimpan", parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
