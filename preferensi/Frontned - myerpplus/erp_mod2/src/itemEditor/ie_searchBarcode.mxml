<?xml version="1.0" encoding="utf-8"?>	
<s:GridItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009"
				  xmlns:s="library://ns.adobe.com/flex/spark"
				  xmlns:mx="library://ns.adobe.com/flex/mx"
				  clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.FlexEvent;
			
			import spark.formatters.NumberFormatter;
			
			protected var dataTI:String = "";
			override public function set value(newValue:Object):void 
			{
				txt.text = newValue as String;
			}
			
			override public function get value():Object 
			{
				return dataTI;
			}
			
			override public function setFocus():void 
			{
				txt.setFocus();
			}
			
			protected function img_clickHandler(event:MouseEvent):void
			{
				FlexGlobals.topLevelApplication.F_popUpCari(column.dataField);
			}
			
			protected function txt_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.F12)
				{
					FlexGlobals.topLevelApplication.F_popUpCari(column.dataField);
				}
			}
			
			protected function txt_textInputHandler(event:TextEvent):void
			{
				dataTI += event.text;
			}
			 
		]]>
	</fx:Script>
	
	<s:TextInput id="txt" right="25" width="100%" height="100%" keyDown="txt_keyDownHandler(event)" textInput="txt_textInputHandler(event)"/>
	<s:Image id="img" source="{parentApplication.tbfind}" top="5" right="4" useHandCursor="true" buttonMode="true" mouseChildren="false" click="img_clickHandler(event)"/>
</s:GridItemEditor>
