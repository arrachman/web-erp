			public function f_historyorderpembelian():void{
				modul = '4'; sumber = 'Po';
				FlexGlobals.topLevelApplication.openFormX("Transaksi Order Pembelian Terakhir", 0, "mod/m1/m1_Item_History.swf",1,20,'t1',"x",[dg, modul, sumber]);
