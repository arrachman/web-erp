				modul = '5'; sumber = 'So';
				FlexGlobals.topLevelApplication.openFormX("Transaksi Order Penjualan Terakhir", 0, "mod/m1/m1_Item_History.swf",1,20,'t1',"x",[dg, modul, sumber]);
			}
			public function f_historypembelian():void{
				modul = '4'; sumber = 'Ri';
				FlexGlobals.topLevelApplication.openFormX("Transaksi Pembelian Terakhir", 0, "mod/m1/m1_Item_History.swf",1,20,'t1',"x",[dg, modul, sumber]);
			}
			public function f_historypenjualan():void{
				modul = '5'; sumber = 'Si';
				FlexGlobals.topLevelApplication.openFormX("Transaksi Penjualan Terakhir", 0, "mod/m1/m1_Item_History.swf",1,20,'t1',"x",[dg, modul, sumber]);
			}
			
			public function f_kondisiAwal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama, txtkategori]);
				tbarang.text = parentApplication.l('Barang')+' :';
				transaksiterakhir.visible = false; tampilgambar.visible = false;
				cmbStatus.selectedIndex = -1;
				chkdatatidakaktif.selected = false;
				dg.dataProvider.removeAll();
				dgstok.dataProvider.removeAll();
				mb.menuBarItems[0].enabled = true;
				o.statistik = false
				f_focusOnMe();
			}
			
			public function f_formDataTampil(page:int = 1):void
			{
				if(parentApplication.apaBisaAkses(1, 72, 1) == true){
					if(o.statistik){
						FlexGlobals.topLevelApplication.F_wsSearch("Tampilkan", 'M1_Item_InformationSearch', page, 20, o.filter, 'bkode asc');
					}else{
						FlexGlobals.topLevelApplication.F_wsSearch("Tampilkan", 'M1_Item_InformationSearch', page, 20, f_filterdata(), 'bkode asc');
					}
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategori':
						paket = 'CdM1_Item_Category';
						wsfilter = '(icaktif = 1) AND ickode ="'+txtkategori.text.split('"').join('\\"')+'"';
						csfilter = '(icaktif = 1)';
						csfield = 2;
						sort = 'ickode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_filterdata():String{
				var f:String = '';
				if(txtkode.text != '')
					f = parentApplication.TambahFilter(f, 'bkode LIKE "%'+txtkode.text.split('"').join('\\"')+'%"');
				if(txtnama.text != '')
					f = parentApplication.TambahFilter(f, 'bnama LIKE "%'+txtnama.text.split('"').join('\\"')+'%"');
				if(txtkategori.text != '')
					f = parentApplication.TambahFilter(f, 'bkategori LIKE "%'+txtkategori.text.split('"').join('\\"')+'%"');
				if(cmbStatus.selectedIndex >= 0)
					f = parentApplication.TambahFilter(f, 'bstatusmoving = "'+cmbStatus.selectedItem.v+'"');
				if(chkdatatidakaktif.selected == false)
					f = parentApplication.TambahFilter(f, 'baktif = 1');
				return f;
			}
			
			public function f_wsHasil():void
			{
				if (dg.dataProvider != null && parentApplication.rowIndex < dg.dataProviderLength)
				var ob : Object = dg.dataProvider[parentApplication.rowIndex];
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){
						case 'txtkategori':
							txtkategori.text = obj.ickode;
							break;
						case 'TransaksiTerakhir':
							tbarang1.text = parentApplication.l('Barang')+" : "+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bkode;
							ttransaksiterakhir.text = parentApplication.l("Transaksi Terakhir ")+sumberterakhirnama;
							txtbukti.text = obj.notransaksi;
							txttanggal.text = obj.tgl;
							txtkontak.text = obj.kontaknama;
							txtjumlah.text = obj.jml;
							txtharga.text = FlexGlobals.topLevelApplication.F_formatNominal(obj.harga);
							break;
						case 'Tampilkan':
							dg.dataProvider = parentApplication.wsArrUtama;
							imgfirst.enabled = parentApplication.wsIsPrev;
							imgprevious.enabled = parentApplication.wsIsPrev;
							imgnext.enabled = parentApplication.wsIsNext;
							imglast.enabled = parentApplication.wsIsNext;
							txtpaging.text = parentApplication.wsCurPage;
							for(var i:int =0;i<dg.dataProviderLength;i++)
								dg.dataProvider[i].no = (((parentApplication.wsCurPage-1)*20)+(i+1));
							parentApplication.F_dgRefresh(dg);
							dg.setFocus();
							dg.setSelectedCell(mydgrow, mydgcol);
							break;
						case 'getstok':
							if (parentApplication.wsArrUtama.length>0){
								dgstok.dataProvider=parentApplication.wsArrUtama;}
							break;
					}
				}else{
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'TransaksiTerakhir':
								FlexGlobals.topLevelApplication.F_KosongkanText([txtbukti, txttanggal, txtkontak]);
								FlexGlobals.topLevelApplication.F_SetNilaiText([txtjumlah, txtharga], 0);
								break;
							case 'Tampilkan':
								dg.dataProvider.removeAll();
								Alert.show(parentApplication.wsErrmessage, 'Information');
								break;
							case 'getstok':
								dgstok.dataProvider.removeAll();
								Alert.show(parentApplication.wsErrmessage, 'Information');
								break;
						}
				}
				parentApplication.F_dgRefresh(dg);
			}
			
			public function f_kosongkanText(target:String):void
			{
				parentApplication.vpFocusEvent = true;
				switch(target){
					case 'txtkategori':parentApplication.F_KosongkanText([txtkategori]);break;
				}
			}
							
			public function f_cetak():void
			{
				FlexGlobals.topLevelApplication.F_openReport(1, 11, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', 0);
			}
			
			private function f_showstok():void{
				FlexGlobals.topLevelApplication.F_wsSearch("getstok", 'M1_Item_Stock_WarehouseSearch', 0, 0, 'idbarang='+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bid, '');
				mydgrow2 = mydgrow;
				sisa = int(dg.dataProvider.getItemAt(mydgrow).bstok) - int(dg.dataProvider.getItemAt(mydgrow).bjmlorderjual);
			}
			
			protected function dg_clickHandler(event:MouseEvent):void
			{
				transaksiterakhir.visible = false;
				if(dg.dataProviderLength > 0){
					mydgcol = dg.selectedCell.columnIndex; mydgrow=dg.selectedCell.rowIndex;
					f_showstok();
					tbarang.text = parentApplication.l('Barang')+" : "+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bkode;
					transaksiterakhir.visible = false; tampilgambar.visible = false;
				}
			}
			
