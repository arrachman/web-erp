				function f_barangmutasikhusus():void{
					FlexGlobals.topLevelApplication.openFormX("Barang Mutasi Khusus", 0, "mod/m1/m1_Item_SpecialMutation.swf",1,20,'t1',"x",[dg, modul, sumber]);
