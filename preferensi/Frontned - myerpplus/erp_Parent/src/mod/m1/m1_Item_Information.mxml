				FlexGlobals.topLevelApplication.F_wsDelete("TransaksiTerakhir", 'M1_ItemTransaksiTerakhir',obj.userid,dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bid + "△" +sumberterakhir,0,0,'', '');
				transaksiterakhir.visible = true; tampilgambar.visible = false;
