			protected function f_persiapan():void
			{
				// Config Paging
				parentApplication.m[parentApplication.idmod].child.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = '0';
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				cmbStatus.dataProvider = new ArrayCollection([{l:parentApplication.l('Fast'), v:'F'}, {l:parentApplication.l('Medium'), v:'M'}, {l:parentApplication.l('Slow'), v:'S'}, {l:parentApplication.l('Dead'), v:'D'}]);
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(1, 11);
				chkdatatidakaktif.label = FlexGlobals.topLevelApplication.l(chkdatatidakaktif.label);
				parentApplication.F_TranslateLabel([tkodebarang,ttipe,tnama,tjenislaporan,tkategori,tkualitas,tstokpergudang,tbarang,ttransaksiterakhir,tbarang1,tbukti,ttgl,tkontak,tjml,tharga]);
				parentApplication.F_RequiredLabel([]);
				parentApplication.F_ComboBoxStandard([cmbStatus, cmbjenislaporan]);
				parentApplication.F_txtpencarian([txtkategori]);
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama]);
				
				FlexGlobals.topLevelApplication.F_setGridJson(1, 72);
				FlexGlobals.topLevelApplication.registerGrid([dg,dgstok], 'data');
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Tampilkan", icon:"tbpreview"},
					{label:"Reset", icon:"tbreset"},
					{label:"Cetak", icon:"tbprint"},
					{label:"Export", icon:"tbexport", children:[
						{label:"Ms.Excel", icon:"tbexcel", data:"1"},
						{label:"Html", icon:"tbhtml", data:"2"},
						{label:"Ms.Word", icon:"tbword", data:"3"},
						{label:"Text", icon:"tbtxt", data:"4"},
						{label:"Image", icon:"tbtif", data:"5"}]
					},
					{label:"Transaksi Terakhir", icon:"tblasttrans", children:[
						{label:"Order Pembelian", icon:"tbpo", data:"0"},
						{label:"Order Penjualan", icon:"tbso", data:"1"},
						{label:"Pembelian", icon:"tbri", data:"2"},
						{label:"Penjualan", icon:"tbsi", data:"3"}]
					},
					{label:"History Transaksi", icon:"tbhistory", children:[
						{label:"History Order Pembelian", icon:"tbpo", data:"0"},
						{label:"History Order Penjualan", icon:"tbso", data:"1"},
						{label:"History Pembelian", icon:"tbri", data:"2"},
						{label:"History Penjualan", icon:"tbsi", data:"3"}]
					}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbCetak);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbExport);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbTransaksiTerkait);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbHistory);
				function f_mbTampilkan():void
				{
					if(int(txtpaging.text) == 0)
						f_formDataTampil();
					else
						f_formDataTampil(int(txtpaging.text));
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbCetak():void
				{
					FlexGlobals.topLevelApplication.F_openReport(1, 11, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', 0);
				}
				function f_mbExport(e:MenuEvent):void
				{
					switch(e.label){
						case 'Ms.Excel': FlexGlobals.topLevelApplication.F_openReport(1, 11, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Html': FlexGlobals.topLevelApplication.F_openReport(1, 11, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Ms.Word': FlexGlobals.topLevelApplication.F_openReport(1, 11, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Text': FlexGlobals.topLevelApplication.F_openReport(1, 11, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Image': FlexGlobals.topLevelApplication.F_openReport(1, 11, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
					}
				}
				function f_mbTransaksiTerkait(e:MenuEvent):void
				{
					if(parentApplication.apaBisaAkses(1, 72, 12) == true){
						if(dg.selectedCell != null)
						switch(e.label){
							case 'Order Pembelian': f_orderpembelianterakhir();
								break;
							case 'Order Penjualan': f_orderpenjualanterakhir();
								break;
							case 'Pembelian': f_pembelianterakhir();
								break;
							case 'Penjualan': f_penjualanterakhir();
								break;
						}
					}
				}
				function f_mbHistory(e:MenuEvent):void
				{
					if(dg.selectedCell != null)
					switch(e.label){
						case 'History Order Pembelian': f_historyorderpembelian();
							break;
						case 'History Order Penjualan': f_historyorderpenjualan();
							break;
						case 'History Pembelian': f_historypembelian();
							break;
						case 'History Penjualan': f_historypenjualan();
							break;
					}
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_formDataTampil(int(txtpaging.text));
				}
				function f_firstCLICK():void
				{
					f_formDataTampil();
				}
				function f_previousCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)-1);
				}
				function f_nextCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)+1);
				}
				function f_lastCLICK():void
				{
					f_formDataTampil(int(-1));
				}
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.HOME:
							if(int(txtpaging.text)>1)
								f_formDataTampil();
							break;
						case Keyboard.PAGE_UP:
							if(int(txtpaging.text)-1>0)
								f_formDataTampil(int(txtpaging.text)-1);
							break;
						case Keyboard.PAGE_DOWN:
							f_formDataTampil(int(txtpaging.text)+1);
							break;
						case Keyboard.END:
							f_formDataTampil(-1);
							break;
						case Keyboard.P:
							if(e.ctrlKey)
								f_cetak();
							break;
						case Keyboard.R:
							if(e.ctrlKey)
								f_mbReset();
							break;
					}
				}
				if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
					mb.menuBarItems[0].enabled = false;
					o.filter = parentApplication.m.ArrFilter[0]
					o.statistik = true;
					f_formDataTampil(1);
				}else{
					f_kondisiAwal();
				}
				dg_contextmenu();
			}
			
