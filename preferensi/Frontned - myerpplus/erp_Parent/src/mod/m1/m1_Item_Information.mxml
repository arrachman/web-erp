				dg.addEventListener(GridEvent.GRID_ROLL_OVER, f_GRID_ROLL_OVER);
				dg.selectionMode = "singleCell";
				dg.doubleClickEnabled = true;
				dg.contextMenu = new ContextMenu;
				dg.contextMenu.hideBuiltInItems();
				dg.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_dgMENU_SELECT);
				var vCMI:ContextMenuItem;
				vCMI = new ContextMenuItem(parentApplication.l('Informasi Stok'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_informasistok); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('History Transaksi'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_historytransaksi); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('Order Pembelian Terakhir'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_transaksiterakhirPO); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('Order Penjualan Terakhir'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_transaksiterakhirSO); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('Pembelian Terakhir'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_transaksiterakhirRI); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('Penjualan Terakhir'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_transaksiterakhirSI); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('Mutasi Stok'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_mutasistok); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('History Order Pembelian'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_historderpembelian); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('History Order Penjualan'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_historderpenjualan); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('History Pembelian'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_histpembelian); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('History Penjualan'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_histpenjualan); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('Barang Khusus'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_barangkhusus); 
				dg.contextMenu.customItems.push(vCMI);
//				vCMI = new ContextMenuItem('Barang Mutasi Khusus')
//				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_barangmutasikhusus); 
//				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(parentApplication.l('Tampilkan Gambar'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_tampilkangambar); 
				dg.contextMenu.customItems.push(vCMI);
				
				function f_informasistok():void{
					FlexGlobals.topLevelApplication.openFormX("Barang Informasi Stok", 0, "mod/m1/m1_Item_InformationStok.swf",0,0,'t1',"x",[dg]);
				}
				function f_historytransaksi():void{
					FlexGlobals.topLevelApplication.openFormX("History Transaksi", 0, "mod/m1/m1_Item_HistoryTransaction.swf",0,0,'t1',"x",[dg]);
				}
				function f_transaksiterakhirPO():void{
					f_orderpembelianterakhir();
				}
				function f_transaksiterakhirSO():void{
					f_orderpenjualanterakhir();
				}
				function f_transaksiterakhirRI():void{
					f_pembelianterakhir();
				}
				function f_transaksiterakhirSI():void{
					f_penjualanterakhir();
				}
				function f_mutasistok():void{
					FlexGlobals.topLevelApplication.openFormX("Barang Mutasi Stok", 0, "mod/m1/m1_Item_MutationStok.swf",1,20,'t1',"x",[dg]);
				}
				function f_historderpembelian():void{
					f_historyorderpembelian();
				}
				function f_historderpenjualan():void{
					f_historyorderpenjualan();
				}
