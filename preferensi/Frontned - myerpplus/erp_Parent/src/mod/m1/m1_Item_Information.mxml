				function f_tampilkangambar():void{
					if(dg.dataProvider.length > 0)
						if(dg.dataProvider[dg.selectedCell.rowIndex].fnamafile.length > 0){
							imggambar.source = "../files/f1/Item/"+dg.dataProvider[dg.selectedCell.rowIndex].fnamafile;
