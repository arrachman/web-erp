			public function f_orderpembelianterakhir():void{
				sumberterakhir = 'PO'; sumberterakhirnama = parentApplication.l('Order Pembelian');
				FlexGlobals.topLevelApplication.F_wsDelete("TransaksiTerakhir", 'M1_ItemTransaksiTerakhir',obj.userid,dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bid + "△" +sumberterakhir,0,0,'', '');
				transaksiterakhir.visible = true; tampilgambar.visible = false;
			}
			public function f_orderpenjualanterakhir():void{
				sumberterakhir = 'SO'; sumberterakhirnama = parentApplication.l('Order Penjualan');
				FlexGlobals.topLevelApplication.F_wsDelete("TransaksiTerakhir", 'M1_ItemTransaksiTerakhir',obj.userid,dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bid + "△" +sumberterakhir,0,0,'', '');
				transaksiterakhir.visible = true; tampilgambar.visible = false;
