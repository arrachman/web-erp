<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			
			import org.hamcrest.collection.array;
			
			import spark.components.Image;
			
			public var arr:Array, obj:Object={}, o:Object = {}, dg:DataGrid, idbarang:int, i:Image; 
			protected var arrMenuBar:ArrayCollection;
//			protected var img:Image;
			
			public function f_focusOnMe():void
			{
				txtkode.setFocus();
			}
			
			protected function f_persiapan():void
			{
				dg = parentApplication.m.ArrFilter[0];
				FlexGlobals.topLevelApplication.F_TranslateLabel([tinformasistok,tstokpergudang,ttransaksiterakhir,tkode,tnama,ttipe,tstok,tsatuan,thargareguler,thargacabang,tstokminimal,tstokmaksimal,
					tsumber1,tbukti1,ttgl1,tsupplier1,tjml1,tharga1,tsumber2,tbukti2,ttgl2,tsupplier2,tjml2,tharga2,tsumber3,tbukti3,ttgl3,tcustomer3,tjml3,tharga3,tsumber4,tbukti4,ttgl4,tcustomer4,tjml4,tharga4]);
				parentApplication.F_txtpencarian([txtkode]);
				parentApplication.F_SetNavigasiKeyboard([potxtbukti,sotxtbukti,ivtxtbukti,pjtxtbukti]);
				parentApplication.F_setGridJson(1, 11);
				parentApplication.registerGrid([dginformasi]);
				if(parentApplication.FormFilter != ''){
					idbarang = dg.dataProvider[dg.selectedCell.rowIndex].bid;
					f_isiinfo(dg.dataProvider[dg.selectedCell.rowIndex]);	
				}
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Tampilkan" ,icon:"tbpreview"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				function f_mbTampilkan():void
				{
					if(txtkode.text.length > 0)
					FlexGlobals.topLevelApplication.F_wsSearch("getstok", 'M1_Item_Stock_WarehouseSearch', 0, 0, 'idbarang='+idbarang, '');
				}
			}
			private function f_isiinfo(ob:Object):void{
				txtkode.text = ob.bkode;
				txtnama.text=ob.bnama;
				txttipe.text=ob.btipe;
				txtstok.text=ob.bstok;
				txtsatuan.text=ob.bsatuan;
				txthargareguler.text=parentApplication.m.nfNominal.format(ob.bhargajual1);
				txthargacabang.text=parentApplication.m.nfNominal.format(ob.bhargajual2);
				txtstokminimal.text=parentApplication.m.nfNumber.format(ob.bstokminimal);
				txtstokmaksimal.text=parentApplication.m.nfNumber.format(ob.bstokmaksimal);
				FlexGlobals.topLevelApplication.F_wsSearch("getstok", 'M1_Item_Stock_WarehouseSearch', 0, 0, 'idbarang='+idbarang, '');
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					 case 'txtkode':
						paket='CdM1_Item';
						wsfilter='bkode = "' + txtkode.text.split('"').join('\\"') +'"';break; 
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					 case "txtkode":
						 FlexGlobals.topLevelApplication.F_KosongkanText([txtkode,txttipe,txtnama,txtstok,txtsatuan,txthargareguler,txthargacabang,txtstokminimal,txtstokmaksimal,potxtsumber,potxtbukti,potxttanggal,potxtsuplier,potxtjumlah,potxtharga,pjtxtsumber,pjtxtbukti,pjtxttanggal,pjtxtsuplier,pjtxtjumlah,pjtxtharga,sotxtsumber,sotxtbukti,sotxttanggal,sotxtcustomer,sotxtjumlah,sotxtharga,ivtxtsumber,ivtxtbukti,ivtxttanggal,ivtxtcustomer,ivtxtjumlah,ivtxtharga]);
						 dginformasi.dataProvider.removeAll();
						 break;
				}
			}
			public function f_wsHasil():void
			{
				var s:Object;
				obj = parentApplication;
				s = obj.subject;
				var ira:int=parentApplication.rowIndex;
				obj.F_configMasterInputHasil();
				if(obj.wsSuccess == true){
					switch(s){
						case 'txtkode':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							idbarang = obj.bid;
							FlexGlobals.topLevelApplication.F_KosongkanText([potxtsumber, potxttanggal, potxtjumlah, potxtbukti, potxtsuplier, potxtharga,
								pjtxtsumber, pjtxttanggal, pjtxtjumlah, pjtxtbukti, pjtxtsuplier, pjtxtharga, sotxtsumber, sotxttanggal, sotxtjumlah, sotxtbukti, sotxtcustomer, sotxtharga,
								ivtxtsumber, ivtxttanggal, ivtxtjumlah, ivtxtbukti, ivtxtcustomer, ivtxtharga]);
							f_isiinfo(obj);
							break;
						case 'getstok':
							obj = parentApplication;
							if (parentApplication.wsArrUtama.length>0){
								dginformasi.dataProvider=obj.wsArrUtama;}
							obj.F_wsDelete("TransaksiTerakhir", 'M1_ItemTransaksiTerakhir',obj.userid,idbarang + "△",0,0,'', '');
							break;
						case 'TransaksiTerakhir':
							if(obj.wsArrUtama.length > 0){
								//PO 
								potxtsumber.text =obj.wsArrUtama.getItemAt(0).sumber;	potxtbukti.text = obj.wsArrUtama.getItemAt(0).notransaksi;
								potxttanggal.text = obj.wsArrUtama.getItemAt(0).tgl;	potxtsuplier.text = obj.wsArrUtama.getItemAt(0).kontaknama;
								potxtjumlah.text = obj.wsArrUtama.getItemAt(0).jml;		potxtharga.text=obj.m.nfNominal.format(obj.wsArrUtama.getItemAt(0).harga);
							}
							if(obj.wsArrUtama.length > 1){
								//RI/PJ
								pjtxtsumber.text =obj.wsArrUtama.getItemAt(1).sumber;	pjtxtbukti.text = obj.wsArrUtama.getItemAt(1).notransaksi;
								pjtxttanggal.text = obj.wsArrUtama.getItemAt(1).tgl;	pjtxtsuplier.text = obj.wsArrUtama.getItemAt(1).kontaknama;
								pjtxtjumlah.text = obj.wsArrUtama.getItemAt(1).jml;		pjtxtharga.text=obj.m.nfNominal.format(obj.wsArrUtama.getItemAt(1).harga);
							}
							if(obj.wsArrUtama.length > 2){
								//SO
								sotxtsumber.text =obj.wsArrUtama.getItemAt(2).sumber;	sotxtbukti.text = obj.wsArrUtama.getItemAt(2).notransaksi;
								sotxttanggal.text = obj.wsArrUtama.getItemAt(2).tgl;	sotxtcustomer.text = obj.wsArrUtama.getItemAt(2).kontaknama;
								sotxtjumlah.text = obj.wsArrUtama.getItemAt(2).jml;		sotxtharga.text=obj.m.nfNominal.format(obj.wsArrUtama.getItemAt(2).harga);
							}
							if(obj.wsArrUtama.length > 3){
								//SI
								ivtxtsumber.text =obj.wsArrUtama.getItemAt(3).sumber;	ivtxtbukti.text = obj.wsArrUtama.getItemAt(3).notransaksi;
								ivtxttanggal.text = obj.wsArrUtama.getItemAt(3).tgl;	ivtxtcustomer.text = obj.wsArrUtama.getItemAt(3).kontaknama;
								ivtxtjumlah.text = obj.wsArrUtama.getItemAt(3).jml;		ivtxtharga.text=obj.m.nfNominal.format(obj.wsArrUtama.getItemAt(3).harga);
							}
							break;
					}
				}else{
					if(obj.F_validasiFalse(s) == true)
						switch(s){
						case 'getstok':
							try{dginformasi.dataProvider.removeAll() ;break;} 
							catch(error:Error){break;}
						}
				}
				f_focusOnMe();
			}
			[Bindable] [Embed(source="assets/tb/preview.png")]  public var tbpreview:Class;
		]]>
	</fx:Script>
