<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				parentApplication.F_txtpencarian([txtcabang]);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tkodetransaksi, tcabang, talamat1, talamat2, tkota, tkodepos, tnotelp, tnofax, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama, tkodetransaksi, tcabang]);
				parentApplication.F_txtInOut(txtkode,'','M1_LocationCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama,txtkodetransaksi,txtalamat,txtalamat2,txtkota,txtkodepos,txtnotelp,txtnofax,txtcatatan]);
				parentApplication.F_TextInputNumberDesimalMode([txtluas]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].lkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].lnama;
					txtkodetransaksi.text=dg.dataProvider[dg.selectedCell.rowIndex].lkodetransaksi;
					txtcabang.text=dg.dataProvider[dg.selectedCell.rowIndex].lcabang;
					txtalamat.text = dg.dataProvider[dg.selectedCell.rowIndex].lalamat1;
					txtalamat2.text = dg.dataProvider[dg.selectedCell.rowIndex].lalamat2;
					txtkota.text = dg.dataProvider[dg.selectedCell.rowIndex].lkota;
					txtkodepos.text = dg.dataProvider[dg.selectedCell.rowIndex].lkodepos;
					txtnotelp.text = dg.dataProvider[dg.selectedCell.rowIndex].lnotelp;
					txtnofax.text = dg.dataProvider[dg.selectedCell.rowIndex].lnofax;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].lcatatan;
					o.txtluas = dg.dataProvider[dg.selectedCell.rowIndex].lluas;
					txtluas.text = parentApplication.m.nfNominal.format(o.txtluas)
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].laktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtkodetransaksi,txtcabang,txtalamat,txtalamat2,txtkota,txtkodepos,txtnotelp,txtnofax,txtcatatan]);
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}, {t:txtcabang, n:'Cabang', e:'Branch'}, {t:txtkodetransaksi, n:'Kode Transaksi', e:'Transaction Code'}]) == true){
					//cckode, ccnama, cccatatan, ccinputuser, ccinputtgl, ccmodifikasiuser, ccmodifikasitgl
					arr = [txtkode.text,txtnama.text,txtkodetransaksi.text,txtcabang.text,int(chkaktif.selected),txtalamat.text,txtalamat2.text,txtkota.text,txtkodepos.text,txtnotelp.text,txtnofax.text,txtcatatan.text,vUserId,vDefDt,vUserIdEdit,vDefDt, o.txtluas];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_LocationSimpan', utama, 'lkode')
					vUserIdEdit = 0;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = 'baktif = 1';
						wsfilter = 'baktif = 1 and bkode = "'+ txtcabang.text.split('"').join('\\"') +'"';
						sort = 'bkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtcabang':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtcabang.text = o.bkode;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtcabang': txtcabang.text = ''; break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcabang':parentApplication.F_KosongkanText([txtcabang, lbllokasi]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
		<s:Label id="tkode" left="10" top="43" text="Kode"/>
		<s:Label id="tnama" left="10" top="64" text="Nama"/>
		<s:Label id="tkodetransaksi" left="10" top="85" text="Kode Transaksi"/>
		<s:Label id="tcabang" left="10" top="107" text="Cabang"/>
	<s:Label id="tcabang0" left="10" top="128" text="Luas"/>
	<s:Label id="tcabang1" left="255" top="127" text="M2"/>
	
		<s:Label id="talamat1" left="10" top="150" text="Alamat"/>
		<s:Label id="talamat2" left="10" top="208" text="Alamat2"/>
		<s:Label id="tkota" left="10" top="245" text="Kota"/>
		<s:Label id="tkodepos" left="10" top="266" text="Kode Pos"/>
		<s:Label id="tnotelp" left="10" top="286" text="No Telp"/>
		<s:Label id="tnofax" left="10" top="307" text="No Fax"/>
		<s:Label id="tcatatan" left="10" top="338" text="Catatan"/>
		<s:Label id="lbllokasi" left="276" top="105"/>
		<s:TextInput id="txtkode" y="37" left="110" width="231" maxChars="25" change="txtkodetransaksi.text = txtkode.text"/>
		<s:TextInput id="txtnama" left="110" right="10" top="58" maxChars="100"/>
		<s:TextInput id="txtkodetransaksi" y="79" left="110" width="140" maxChars="5"/>
		<s:TextInput id="txtcabang" top="100" left="110" width="140"/>
		<s:TextInput id="txtluas" top="121" left="110" width="140"/>
		<s:TextArea id="txtalamat" left="110" right="10" top="142" height="39" maxChars="250"/>
		<s:TextArea id="txtalamat2" left="110" right="10" top="180" height="58" maxChars="250"/>
		<s:TextInput id="txtkota" left="110" top="237" width="140"/>
		<s:TextInput id="txtkodepos" left="110" top="258" width="140" maxChars="25"/>
		<s:TextInput id="txtnotelp" left="110" top="279" width="140" maxChars="25"/>
		<s:TextInput id="txtnofax" left="110" top="300" width="140" maxChars="25"/>
		<s:TextArea id="txtcatatan" left="110" right="10" top="321" bottom="35" maxChars="250"/>
		<s:CheckBox id="chkaktif" x="345" y="38" label="Aktif" selected="true"/>
</s:Module>
