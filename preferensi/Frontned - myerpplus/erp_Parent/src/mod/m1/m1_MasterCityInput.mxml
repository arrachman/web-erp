<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				if(parentApplication.m[parentApplication.idmodcurr].child.hasOwnProperty('dg'))
					dg = parentApplication.m[parentApplication.idmodcurr].child.dg;
				else
					dg = parentApplication.m[parentApplication.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tpropinsi, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_CityCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_txtpencarian([txtprovinsi]);
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				
				if(parentApplication.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ckode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].cnama;
					txtprovinsi.text = dg.dataProvider[dg.selectedCell.rowIndex].cpropinsi;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].ccatatan;
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].caktif=="0")
					{
						chkaktif.selected = false;
					}else{
						chkaktif.selected = true;
					}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama, txtprovinsi, txtcatatan]);
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					//cckode, ccnama, cccatatan, ccinputuser, ccinputtgl, ccmodifikasiuser, ccmodifikasitgl
					arr = [txtkode.text,txtnama.text,txtprovinsi.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_CitySimpan', utama, 'ckode')
					vUserIdEdit = 0;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtprovinsi':
						paket = 'CdM1_Province';
						csfilter = 'paktif = 1';
						wsfilter = 'paktif = 1 and pkode = "'+txtprovinsi.text.split('"').join('\\"')+'"';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtprovinsi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtprovinsi.text = o.pkode;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtprovinsi': txtprovinsi.text = ''; break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtprovinsi':parentApplication.F_KosongkanText([txtprovinsi]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" right="1" top="-1" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="64" text="Nama"/>
	<s:Label id="tpropinsi" left="10" top="86" text="Propinsi"/>
	<s:Label id="tcatatan" left="10" top="107" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="70" width="272" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58" height="22" maxChars="100"/>
	<s:TextInput id="txtprovinsi" top="79" left="70" width="100" maxChars="25"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="100" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="346" y="38" label="Aktif" selected="true"/>
</s:Module>
