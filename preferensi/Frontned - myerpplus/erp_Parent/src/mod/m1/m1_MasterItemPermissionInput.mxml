<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkjual.label = FlexGlobals.topLevelApplication.l(chkjual.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_Item_PermissionCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ipkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].ipnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].ipcatatan;
					o.ipcustomtext1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext1; 
					o.ipcustomtext2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext2; 
					o.ipcustomtext3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext3;
					o.ipcustomtext4=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext4; 
					o.ipcustomtext5=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext5; 
					o.ipcustomint1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomint1; 
					o.ipcustomint2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomint2; 
					o.ipcustomint3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomint3; 
					o.ipcustomdbl1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdbl1; 
					o.ipcustomdbl2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdbl2; 
					o.ipcustomdbl3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdbl3; 
					o.ipcustomdate1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdate1; 
					o.ipcustomdate2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdate2; 
					o.ipcustomdate3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdate3;
					vUserIdEdit = parentApplication.userid;
					
					if (dg.dataProvider[dg.selectedCell.rowIndex].ipjual=="0"){
						chkjual.selected = false;
					}else {
						chkjual.selected = true;
					}
					if (dg.dataProvider[dg.selectedCell.rowIndex].ipmutasipusat=="0"){chkmutasipusat.selected = false;}else {chkmutasipusat.selected = true;}
					if (dg.dataProvider[dg.selectedCell.rowIndex].ippermintaanmutasi=="0"){chkpermintaanmutasi.selected = false;}else {chkpermintaanmutasi.selected = true;}
					if (dg.dataProvider[dg.selectedCell.rowIndex].ipmutasicabang=="0"){chkmutasikecabang.selected = false;}else {chkmutasikecabang.selected = true;}
					if (dg.dataProvider[dg.selectedCell.rowIndex].ipretursupplier=="0"){chkretursupplier.selected = false;}else {chkretursupplier.selected = true;}
					if (dg.dataProvider[dg.selectedCell.rowIndex].ippermintaanpembelian=="0"){chkpermintaanpembelian.selected = false;}else {chkpermintaanpembelian.selected = true;}
					
					if(chkjual.selected==true){chkjual.label='Yes';}else{chkjual.label='No';}
					if(chkmutasipusat.selected==true){chkmutasipusat.label='Yes';}else{chkmutasipusat.label='No';}
					if(chkpermintaanmutasi.selected==true){chkpermintaanmutasi.label='Yes';}else{chkpermintaanmutasi.label='No';}
					if(chkmutasikecabang.selected==true){chkmutasikecabang.label='Yes';}else{chkmutasikecabang.label='No';}
					if(chkpermintaanpembelian.selected==true){chkpermintaanpembelian.label='Yes';}else{chkpermintaanpembelian.label='No';}
					if(chkretursupplier.selected==true){chkretursupplier.label='Yes';}else{chkretursupplier.label='No';}
					
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan]);
				chkjual.selected = true; chkmutasipusat.selected = true; chkpermintaanmutasi.selected = true; chkmutasikecabang.selected = true; chkretursupplier.selected = true; chkpermintaanpembelian.selected = true;
				chkjual.label = 'Yes'; chkmutasipusat.label = 'Yes'; chkpermintaanmutasi.label = 'Yes'; chkmutasikecabang.label = 'Yes'; chkretursupplier.label = 'Yes'; chkpermintaanpembelian.label = 'Yes';
				o.ipcustomtext1=""; o.ipcustomtext2=""; o.ipcustomtext3=""; o.ipcustomtext4=""; o.ipcustomtext5=""; o.ipcustomint1=0; 
				o.ipcustomint2=0; o.ipcustomint3=0; o.ipcustomdbl1=0; o.ipcustomdbl2=0; o.ipcustomdbl3=0; o.ipcustomdate1=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.ipcustomdate2=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.ipcustomdate3=FlexGlobals.topLevelApplication.DefaultTanggal;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
//					'ipkode, ipnama, ipcatatan, ipjual, ipmutasipusat, ippermintaanmutasi,
//        'ipmutasicabang, ipretursupplier, ippermintaanpembelian,
//					'ipinputuser, ipinputtgl, ipmodifikasiuser, ipmodifikasipgl, ipcustomtext1,
//        'ipcustomtext2, ipcustomtext3, ipcustomtext4, ipcustomtext5, ipcustomint1, ipcustomint2,
//        'ipcustomint3, ipcustomdbl1, ipcustomdbl2, ipcustomdbl3, ipcustomdate1, ipcustomdate2, ipcustomdate3
					
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkjual.selected), int(chkmutasipusat.selected), int(chkpermintaanmutasi.selected),
						int(chkmutasikecabang.selected), int(chkretursupplier.selected),int(chkpermintaanpembelian.selected),  vUserId,vDefDt,vUserIdEdit,vDefDt,
						o.ipcustomtext1, o.ipcustomtext2, o.ipcustomtext3, o.ipcustomtext4, o.ipcustomtext5, o.ipcustomint1, 
						o.ipcustomint2, o.ipcustomint3, o.ipcustomdbl1, o.ipcustomdbl2, o.ipcustomdbl3, 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ipcustomdate1), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ipcustomdate2), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ipcustomdate3)];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_Item_PermissionSimpan', utama, 'ipkode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="65" text="Nama"/>
	
	
	<s:Label id="tcatatan" left="10" top="171" text="Keterangan"/>
	<s:TextInput id="txtkode" y="37" left="140" width="217"/>
	<s:TextInput id="txtnama" left="140" right="10" top="58"/>
	<s:TextArea id="txtcatatan" left="141" right="10" top="147" bottom="19" maxChars="250"/>
	<s:Label left="9" top="89" text="Jual (J)"/>
	<s:Label left="9" top="109" text="Mutasi ke Pusat (R)"/>
	<s:Label left="9" top="129" text="Permintaan Mutasi (T)"/>
	<s:Label left="214" top="88" text="Mutasi ke Cabang (K)"/>
	<s:Label left="214" top="109" text="Retur ke Supplier (R)"/>
	<s:Label left="214" top="127" text="Permintaan Pembelian (P)"/>
	
	<s:CheckBox id="chkjual" x="141" y="84" label="Yes" selected="true" click="if(chkjual.selected==true){chkjual.label='Yes';}else{chkjual.label='No';}"/>
	<s:CheckBox id="chkmutasipusat" x="141" y="104" label="Yes" selected="true" click="if(chkmutasipusat.selected==true){chkmutasipusat.label='Yes';}else{chkmutasipusat.label='No';}"/>
	<s:CheckBox id="chkpermintaanmutasi" x="141" y="124" label="Yes" selected="true" click="if(chkpermintaanmutasi.selected==true){chkpermintaanmutasi.label='Yes';}else{chkpermintaanmutasi.label='No';}"/>
	<s:CheckBox id="chkmutasikecabang" x="369" y="84" label="Yes" selected="true" click="if(chkmutasikecabang.selected==true){chkmutasikecabang.label='Yes';}else{chkmutasikecabang.label='No';}"/>
	<s:CheckBox id="chkretursupplier" x="369" y="102" label="Yes" selected="true" click="if(chkretursupplier.selected==true){chkretursupplier.label='Yes';}else{chkretursupplier.label='No';}"/>
	<s:CheckBox id="chkpermintaanpembelian" x="369" y="121" label="Yes" selected="true" click="if(chkpermintaanpembelian.selected==true){chkpermintaanpembelian.label='Yes';}else{chkpermintaanpembelian.label='No';}"/>
</s:Module>
