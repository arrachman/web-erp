<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			private var idlocation:int;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				parentApplication.F_txtpencarian([txtgudang]);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tgudang]);
				parentApplication.F_RequiredLabel([tkode, tnama, tgudang]);
				parentApplication.F_txtInOut(txtkode,'','M1_Item_LocationCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					idlocation = dg.dataProvider[dg.selectedCell.rowIndex].ilid;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ilkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].ilnama;
					txtgudang.text = dg.dataProvider[dg.selectedCell.rowIndex].ilgudang;
					lbldivisi.text = dg.dataProvider[dg.selectedCell.rowIndex].ilgudangnama;
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].ilaktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama,txtgudang,lbldivisi]);
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}, {t:txtgudang, n:'Gudang', e:'Warehouse'}]) == true){
					if (isUpdate==false){
						arr = ['0',txtkode.text,txtnama.text,txtgudang.text,vUserId,vDefDt,0,vDefDt];
					}else{
						arr = [idlocation,txtkode.text,txtnama.text,txtgudang.text,vUserId,vDefDt,vUserIdEdit,vDefDt];
					}
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_Item_LocationSimpan', utama, 'ilkode')
					vUserIdEdit = 0;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						csfilter = 'waktif = 1';
						wsfilter = 'waktif = 1 and wkode = "'+ txtgudang.text.split('"').join('\\"') +'"';
						sort = 'wkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtgudang':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtgudang.text = o.wkode;
							lbldivisi.text = o.wnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtgudang': txtgudang.text = ''; lbldivisi.text = ''; break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtgudang':parentApplication.F_KosongkanText([txtgudang, lbldivisi]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="64" text="Nama"/>
	<s:Label id="tgudang" left="10" top="84" text="Gudang"/>
	<s:Label id="lbldivisi" left="199" top="86"/>
	<s:TextInput id="txtkode" y="37" left="70" width="100" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58" maxChars="100" />
	<s:TextInput id="txtgudang" top="79" left="70" width="100" maxChars="25"/>
	<s:CheckBox id="chkaktif" x="174" y="38" label="Aktif" selected="true" visible="false"/>
</s:Module>
