<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode,tnama,tdivisi,tcatatan]);
				parentApplication.F_txtpencarian([txtdivisi, txtsubdivisi]);
				parentApplication.F_txtInOut(txtkode,'','M1_DepartmentCekId');
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].dpkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].dpnama;
					txtdivisi.text = dg.dataProvider[dg.selectedCell.rowIndex].dpdivisi;
					lbldivisi.text = dg.dataProvider[dg.selectedCell.rowIndex].dpdivisinama;
					txtsubdivisi.text = dg.dataProvider[dg.selectedCell.rowIndex].dpsubdivisi;
					lblsubdivisi.text = dg.dataProvider[dg.selectedCell.rowIndex].dpsubdivisinama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].dpcatatan;
					
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].dpaktif));
					userEdit = parentApplication.userid;
					o.dpcustomtext1 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomtext1;
					o.dpcustomtext2 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomtext2; 
					o.dpcustomtext3 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomtext3; 
					o.dpcustomtext4 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomtext4; 
					o.dpcustomtext5 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomtext5; 
					o.dpcustomint1 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomint1; 
					o.dpcustomint2 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomint2; 
					o.dpcustomint3 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomint3; 
					o.dpcustomdbl1 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomdbl1; 
					o.dpcustomdbl2 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomdbl2; 
					o.dpcustomdbl3 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomdbl3; 
					o.dpcustomdate1 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomdate1; 
					o.dpcustomdate2 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomdate2; 
					o.dpcustomdate3 = dg.dataProvider[dg.selectedCell.rowIndex].dpcustomdate3;
						
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan,txtdivisi,lbldivisi,txtsubdivisi,lblsubdivisi]);
				chkaktif.selected = true;
				o.dpcustomtext1 = "";
				o.dpcustomtext2 = "";
				o.dpcustomtext3 = "";
				o.dpcustomtext4 = "";
				o.dpcustomtext5 = "";
				o.dpcustomint1 = 0;
				o.dpcustomint2 = 0;
				o.dpcustomint3 = 0;
				o.dpcustomdbl1 = 0;
				o.dpcustomdbl2 = 0;
				o.dpcustomdbl3 = 0;
				o.dpcustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal;
				o.dpcustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal;
				o.dpcustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					arr = [txtkode.text,txtnama.text, txtdivisi.text, txtsubdivisi.text, txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt,
						o.dpcustomtext1, o.dpcustomtext2, o.dpcustomtext3, o.dpcustomtext4, 
						o.dpcustomtext5, o.dpcustomint1, o.dpcustomint2, o.dpcustomint3, o.dpcustomdbl1, o.dpcustomdbl2, o.dpcustomdbl3, 
						o.dpcustomdate1, o.dpcustomdate2, o.dpcustomdate3];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_DepartmentSimpan', utama, 'dpkode')
					userEdit = 0;
				}
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtdivisi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtdivisi.text = o.dkode;
							lbldivisi.text = o.dnama;
							FlexGlobals.topLevelApplication.F_KosongkanText([txtsubdivisi, lblsubdivisi]);
							break;
						case 'txtsubdivisi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtsubdivisi.text = o.sdkode;
							lblsubdivisi.text = o.sdnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtdivisi': break;
							case 'txtsubdivisi': break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtdivisi':parentApplication.F_KosongkanText([txtdivisi, lbldivisi]);break;
					case 'txtsubdivisi':parentApplication.F_KosongkanText([txtsubdivisi, lblsubdivisi]);break;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtdivisi':
						paket = 'CdM1_Division';
						csfilter = "daktif = 1";
						wsfilter = "daktif = 1 and dkode = '"+ txtdivisi.text +"'";
						break;
					case 'txtsubdivisi':
						if(txtdivisi.text.length > 0){
							paket = 'CdM1_Subdivision';
							csfilter = "sdaktif = 1 AND sddivisi = '"+txtdivisi.text+"'";
							wsfilter = "sdaktif = 1 AND sddivisi = '"+txtdivisi.text+"' and sdkode = '"+ txtsubdivisi.text +"'";
						}else{
							txtdivisi.setFocus();
							Alert.show("Divisi harus diisi terlebih dahulu", "Informasi");
						}
						
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="tdivisi" left="10" top="87" text="Divisi"/>
	<s:Label id="tsubdivisi" left="10" top="108" text="Subdivisi"/>
	<s:Label id="tcatatan" left="10" top="148" text="Catatan"/>
	<s:Label id="lbldivisi" left="208" top="87"/>
	<s:Label id="lblsubdivisi" left="208" top="107"/>
	<s:TextInput id="txtkode" y="40" left="70" width="270" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="61" maxChars="100" />
	<s:TextInput id="txtdivisi" top="82" left="70" width="100" />
	<s:TextInput id="txtsubdivisi" top="103" left="70" width="100" />
	<s:TextArea id="txtcatatan" left="70" right="10" top="124" bottom="10" maxChars="250"/>	
	<s:CheckBox id="chkaktif" x="350" y="41" label="Aktif" selected="true"/>
</s:Module>
