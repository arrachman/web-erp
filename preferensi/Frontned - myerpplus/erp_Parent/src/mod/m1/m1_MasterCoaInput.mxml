			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtSubDari':
						if(txtSubDari.enabled){
							paket = 'CdM1_Coa';
							wsfilter = 'caktif = 1 and clevel = '+Cmblevel.selectedItem.data+' and '+filtertipe+' and cnomor = "'+ txtSubDari.text +'"';
							csfilter = 'caktif = 1 and clevel = '+Cmblevel.selectedItem.data+' and '+filtertipe;
						}
						break;
					case 'txtCabang':
						paket = 'CdM1_Branch';
						csfilter = 'baktif = 1';
						wsfilter = "baktif = 1 and bkode = '"+ txtCabang.text +"'";
						break;
					case 'txtLokasi':
						if(txtCabang.text.length > 0){
							paket = 'CdM1_Location';
							csfilter = "laktif = 1 and lcabang ='"+txtCabang.text+"'";
							wsfilter = "laktif = 1 and lcabang ='"+txtCabang.text+"' and lkode = '"+ txtLokasi.text +"'";
						}else{
							Alert.show('Cabang harus diisi terlebih dahulu');
							FlexGlobals.topLevelApplication.F_KosongkanText([txtLokasi, LblLokasi]);
						}
						break;
					case 'txtDivisi':
						paket = 'CdM1_Division';
						csfilter = 'daktif = 1';
						wsfilter = "daktif = 1 and dkode = '"+ txtDivisi.text +"'";
						break;
					case 'txtBank':
						paket = 'CdM1_Bank';
						csfilter = 'baktif = 1';
						wsfilter = "baktif = 1 and bkode = '"+ txtBank.text +"'";
						break;
					case 'txtMataUang':
						paket = 'CdM1_Currency';
						csfilter = 'caktif = 1';
						wsfilter = "caktif = 1 and ckode = '"+ txtMataUang.text +"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){
						case 'coatree':
							o = parentApplication.wsArrUtama.getItemAt(0);
							break;
						case 'txtSubDari':
							if (ChkSubDari.selected==true){
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtSubDari.text = o.cnomor;
							LblSubDari.text = o.cnama;}
							break;
						case 'txtCabang':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtCabang.text = o.bkode;
							Lblcabang.text = o.bnama;
							FlexGlobals.topLevelApplication.F_KosongkanText([txtLokasi, LblLokasi]);break;
							break;
						case 'txtLokasi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtLokasi.text = o.lkode;
							LblLokasi.text = o.lnama;
							break;
						case 'txtDivisi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtDivisi.text = o.dkode;
							LblDevisi.text = o.dnama;
							break;
						case 'txtBank':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtBank.text = o.bkode;
							LblBank.text = o.bnama;
							break;
						case 'txtMataUang':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtMataUang.text = o.ckode;
							LblMataUang.text = o.cnama;
							uang = o.ckode;
							FlexGlobals.topLevelApplication.vpVarCurrent = uang;
							labelUang = o.cnama;
							FlexGlobals.topLevelApplication.F_wsSimpan('coaTerkait', 'M1_CoaTerkait', parentApplication.userid, false, txtkode.text, '', 0, 0, '', '', '', '');
							
							break;
						case 'coaTerkait':
							Alert.show('Matauang tidak bisa diedit', 'Information');
							break;
					}
				}else{
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'coatree':
								o = parentApplication;
								TreeCoa.dataProvider = XML(FlexGlobals.topLevelApplication.ob_resultWs.toString());
								break;
							case 'coaTerkait': txtMataUang.text = uang; LblMataUang.text = labelUang; FlexGlobals.topLevelApplication.subject = "coaTerkait"; break;
							case 'txtSubDari':break;
							case 'txtCabang':break;
							case 'txtLokasi':break;
							case 'txtDivisi':break;
							case 'txtBank':break;
							case 'txtMataUang':break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'coatree':
						o = parentApplication;
						TreeCoa.dataProvider = XML(FlexGlobals.topLevelApplication.ob_resultWs.toString());
						break;
					case 'txtSubDari':parentApplication.F_KosongkanText([txtSubDari, LblSubDari]);break;
					case 'txtCabang':parentApplication.F_KosongkanText([txtCabang, Lblcabang, txtLokasi, LblLokasi]);break;
					case 'txtLokasi':parentApplication.F_KosongkanText([txtLokasi, LblLokasi]);break;
					case 'txtDivisi':parentApplication.F_KosongkanText([txtDivisi, LblDevisi]);break;
					case 'txtBank':parentApplication.F_KosongkanText([txtBank, LblBank]);break;
					case 'txtMataUang':parentApplication.F_KosongkanText([txtMataUang, LblMataUang]);break;
				}
			}
			[Bindable] public var selectedNode:XML;
			private var Clevel:int=0;
			protected function TreeCoa_clickHandler(event:MouseEvent):void
			{
				selectedNode=TreeCoa.selectedItem as XML;
				if(ChkSubDari.selected)
				{
					if(selectedNode.@level == Cmblevel.selectedItem.data){
						Clevel = selectedNode.@level;
						if(CmbTipe.selectedItem.data == 0 || CmbTipe.selectedItem.data == 1 || CmbTipe.selectedItem.data == 2 || CmbTipe.selectedItem.data == 3 || CmbTipe.selectedItem.data == 4 || CmbTipe.selectedItem.data == 5 || CmbTipe.selectedItem.data == 6){
							if(selectedNode.@tipe == 0 || selectedNode.@tipe == 1 || selectedNode.@tipe == 2 || selectedNode.@tipe == 3 || selectedNode.@tipe == 4 || selectedNode.@tipe == 5 || selectedNode.@tipe == 6){
								if (Clevel > 4 ){
									Alert.show("Akun Detail tidak dapat dijadikan Induk" + " \n" + "Silahkan pilih kembali", 'Information');return;
								}else{
									txtSubDari.text = selectedNode.@nomor;
									LblSubDari.text = selectedNode.@nama;
								}
							}else{
								FlexGlobals.topLevelApplication.F_KosongkanText([txtSubDari,LblSubDari]);
							}
						}else if(CmbTipe.selectedItem.data == 7 || CmbTipe.selectedItem.data == 8 || CmbTipe.selectedItem.data == 9){
							if(selectedNode.@tipe == 7 || selectedNode.@tipe == 8 || selectedNode.@tipe == 9){
								if (Clevel > 4 ){
									Alert.show("Akun Detail tidak dapat dijadikan Induk" + " \n" + "Silahkan pilih kembali", 'Information');return;
								}else{
									txtSubDari.text = selectedNode.@nomor;
									LblSubDari.text = selectedNode.@nama;
								}
							}else{
								FlexGlobals.topLevelApplication.F_KosongkanText([txtSubDari,LblSubDari]);
							}
						}else if(CmbTipe.selectedItem.data == 10){
							if(selectedNode.@tipe == 10){
								if (Clevel > 4 ){
									Alert.show("Akun Detail tidak dapat dijadikan Induk" + " \n" + "Silahkan pilih kembali", 'Information');return;
								}else{
									txtSubDari.text = selectedNode.@nomor;
