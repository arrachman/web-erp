			protected function CmbTipe_changeHandler(event:ListEvent):void
			{
				if(CmbTipe.selectedItem.data == 0 || CmbTipe.selectedItem.data == 1 || CmbTipe.selectedItem.data == 2 || CmbTipe.selectedItem.data == 3 || CmbTipe.selectedItem.data == 4 || CmbTipe.selectedItem.data == 5 || CmbTipe.selectedItem.data == 6){
					CmbJenis.selectedIndex = 0; filtertipe = '(ctipe = 0 OR ctipe = 1 OR ctipe = 2 OR ctipe = 3 OR ctipe = 4 OR ctipe = 5 OR ctipe = 6)';
				}else if(CmbTipe.selectedItem.data == 7 || CmbTipe.selectedItem.data == 8 || CmbTipe.selectedItem.data == 9){
					CmbJenis.selectedIndex = 1; filtertipe = '(ctipe = 7 OR ctipe = 8 OR ctipe = 9)';
				}else if(CmbTipe.selectedItem.data == 10){
					CmbJenis.selectedIndex = 2; filtertipe = '(ctipe = 10)';
				}else if(CmbTipe.selectedItem.data == 11){
					CmbJenis.selectedIndex = 3; filtertipe = '(ctipe = 11)';
				}else if(CmbTipe.selectedItem.data == 12 || CmbTipe.selectedItem.data == 13){
					CmbJenis.selectedIndex = 4; filtertipe = '(ctipe = 12 OR ctipe = 13)';
				}else if(CmbTipe.selectedItem.data == 14){
					CmbJenis.selectedIndex = 3; filtertipe = '(ctipe = 14)';
				}else if(CmbTipe.selectedItem.data == 15){
					CmbJenis.selectedIndex = 4; filtertipe = '(ctipe = 15)';
				}
				if(tipe != CmbTipe.selectedItem.tipe){
					FlexGlobals.topLevelApplication.F_KosongkanText([txtSubDari,LblSubDari]);
					tipe =  CmbTipe.selectedItem.tipe;
				}
			}
			
			protected function Cmblevel_changeHandler(event:ListEvent):void
			{
				if(Cmblevel.selectedItem.data > 0){
					ChkSubDari.selected = true;
					txtSubDari.enabled = true;
				}else{
					ChkSubDari.selected = false;
					txtSubDari.enabled = false;
					FlexGlobals.topLevelApplication.F_KosongkanText([txtSubDari, LblSubDari]);
				}
			}
			
