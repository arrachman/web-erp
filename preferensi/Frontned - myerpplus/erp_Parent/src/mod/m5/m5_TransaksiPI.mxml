			public function f_hitungGrid():void
			{ 
				var dgrid: Object; 
				for(i = 0; i<dg1.dataProviderLength; i++){ 
					dgrid = dg1.dataProvider[i];
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon); 
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon; 
//					dgrid.jmlpajak1 = (Number(dgrid.nilaipajak1)/100) * dgrid.subtotal; 
//					dgrid.jmlpajak2 = (Number(dgrid.nilaipajak2)/100) * dgrid.subtotal; 
					dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
				} 
			} 
			protected function chkhargapajak_changeHandler(event:Event):void
			{
				// TODO Auto-generated method stub
				for(var Index:int = 0; Index<dg1.dataProviderLength; Index++){
					var dgrid:Object;
					dgrid = dg1.dataProvider[Index];
					if(chkhargapajak.selected == true){
						dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					}else{
						dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					}
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
				f_hitungTotalDetail();
			}
			
