				function f_mbAmbilSO():void
				{
					if(txtcustomer.text.length <= 0 || txtmatauang.text.length <= 0){
						pesanAlert = ''; validasi = true;
						if(txtcustomer.text.length <=0 || txtmatauang.text.length <= 0){
							if(txtcustomer.text.length <=0)parentApplication.msgAlert(txtcustomer,'Customer');
							if(txtmatauang.text.length <=0)parentApplication.msgAlert(txtmatauang,'Uang');
							if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
						}
					}else{
						parentApplication.F_popUpCari("ambilSO");
					}
				}
				function f_mbCatatan():void
