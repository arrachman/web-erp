			protected var img:Image, i:int, isUpdate:Boolean, vUang:String, vTgl:String, vNotransaksi:String, vDefNotransaksi:String, tgljatuhtempo:String, vrekdiskon:String, vrekpajak1:String, vrekpajak2:String, vrekbiayalain:String, vrekbayar:String, getNotransaksi:String, customerkode:String='';
			[Bindable] public var u:ArrayCollection;
			public var tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal;
			public var validasi:Boolean, pesanAlert:String, t:TitleWindow, o:Object = {}, obj:Object = {}, n:Object = {};
