			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
						switch(dataField){
							case 'jml':
							case 'harga':
							case 'pajak1':
							case 'pajak2':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								jmlbarang = Number(jml) * Number(nilaisatuan);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
								jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'diskon':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
								jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'jmldiskon':
								vMsg = ''; vMsgIng = ''; validasi = true;
								dgrid1 = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
									if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
									if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
									jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
								}
								break;
							case 'subtotal':
								hargaDariSubtotal.hitungHargaDariSubtotal(dg);
								break;
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
			public function f_focusOnMe():void
			{
				txtcustomer.setFocus();
			}
			
			protected function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tcustomer, tsalesman, turaian, ttanggal, tnotransaksi, tuang, tkurs, tprogress, tkontakperson, ttermin, tcatatan, talamatcustomer, talamatkirim, tekspedisi, ttglkirim, tnoref, ttglnoref, ttotal, tdiskon, tpajak1, tpajak2, tbiayalain, ttotaltransaksi]);
				parentApplication.F_RequiredLabel([tcustomer, tsalesman, ttanggal, tnotransaksi, tuang, tkurs, tprogress]);
				cmbasalbarang.dataProvider = new ArrayCollection([{l:'Lokal', v:'0'}, {l:'Import', v:'1'}]);
				cmbcarabayar.dataProvider = new ArrayCollection([{l:'Tunai', v:'0'}, {l:'Kredit', v:'1'}]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalkirim, dttanggalnoref, dttgljt]);
				parentApplication.F_ComboBoxStandard([cmbprogress, cmbasalbarang, cmbcarabayar]);
				parentApplication.F_txtpencarian([txtcustomer, txtsalesman, txtmatauang, txttermin, txtekspedisi]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan, txtdiskonnilai, lblpajak1, lblpajak2, txtbiayalainnilai]);
