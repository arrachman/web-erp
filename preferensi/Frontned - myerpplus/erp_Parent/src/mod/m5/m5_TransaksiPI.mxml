				n.vtotalpajak1 = 0;
				n.vtotalpajak2 = 0;
				o.txtbiayalainnilai = 0;
				o.txtdiskonnilai = 0;
				o.txtdiskonnilai = 0;
				o.txtbiayalainnilai = 0;
				o.txtdiskonpersen = 0;
				o.txtbiayalainpersen = 0;
				o.txtkurs = 0;
				ktingkatjual = 0;
				dg1.editable = false;
				dg1.toolTip = "Customer harus diisi terlebih dahulu sebelum memilih barang";
				chkhargapajak.selected = false;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Need Approval', v:1}, {l:'Approved', v:2}]);
				parentApplication.F_SetNilaiText([dttanggal, dttanggalkirim, dttanggalnoref, dttgljt], parentApplication.DefaultTanggal);
				parentApplication.F_SetNilaiText([txtdiskonnilai, txtdiskonpersen, txtbiayalainnilai, txtbiayalainpersen], parentApplication.m.nfNominal.format(0));
				parentApplication.F_KosongkanText([txtcustomer, txtkontakperson, txtsalesman, txtgudang, txtmatauang, txtkurs, txttermin, txturaian, txtcatatan, txtalamatcustomer, txtalamatkirim, txtnoref, lblcustomer, lblsalesman, lblgudang, lbltermin, txtekspedisi]);
				cmbasalbarang.selectedIndex = 0;
				cmbasalbarang.textInput.text = 'Lokal';
				cmbcarabayar.selectedIndex = 0;
				txtgudang.text = parentApplication.ugudang;
				lblgudang.text = parentApplication.ugudangnama;
				txtmatauang.text = parentApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = parentApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = parentApplication.m.nfNominal.format(o.txtkurs);
				cmbprogress.enabled = true;
				cmbprogress.selectedIndex = 2;
				txturaian.text = parentApplication.getNomor("PI");
				txtcatatan.text = parentApplication.getNomor("PI",1);
				lbltotal.text = '0,00';
				lblpajak1.text = '0,00';
				lblpajak2.text = '0,00';
				lbltotaltransaksi.text = '0,00';
				vrekdiskon = parentApplication.getSetting(0, 'akun', 'DiskonPenjualan');
				vrekpajak1 = parentApplication.getSetting(0, 'akun', 'PajakPenjualan');
				vrekpajak2 = parentApplication.getSetting(0, 'akun', 'PajakPenjualan');
				vrekbiayalain = parentApplication.getSetting(0, 'akun', 'BiayaLain');
				vrekbayar = parentApplication.getSetting(0, 'akun', 'Kas');
				txtdiskonnilai.toolTip = parentApplication.getSetting(0, 'akun', 'DiskonPenjualan') + "-" + parentApplication.getSetting(0, 'akunnama', 'DiskonPenjualan'); 
				lblpajak1.toolTip = parentApplication.getSetting(0, 'akun', 'PajakPenjualan') + "-" + parentApplication.getSetting(0, 'akunnama', 'PajakPenjualan');
				lblpajak2.toolTip = parentApplication.getSetting(0, 'akun', 'PajakPenjualan') + "-" + parentApplication.getSetting(0, 'akunnama', 'PajakPenjualan');
				txtbiayalainnilai.toolTip = parentApplication.getSetting(0, 'akun', 'BiayaLain') + "-" + parentApplication.getSetting(0, 'akunnama', 'BiayaLain');
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				mb.menuBarItems[8].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				f_matauangFungsional();
				
				u = new ArrayCollection([{
					piid:0, picabang:parentApplication.ucabang, pilokasi:parentApplication.ulokasi, pigudang:txtgudang.text, piasalbarang:cmbasalbarang.textInput.text, piasalbarangkategori:0, pijenispenjualan:'', 
					pijenispenjualankategori:0, picarabayar:cmbcarabayar.selectedItem.v, pisumber:'PI', piautonotransaksi:int(chkauto.selected), pinotransaksi:txtnotransaksi.text, pitgl:dttanggal.text, pikodepa:0, 
					picustomer:0, picustomerkontak:txtkontakperson.text, pi1alamat1:txtalamatcustomer.text, pi1alamat2:'', pi1alamat3:'', pi2alamat1:txtalamatkirim.text, pi2alamat2:'', 
					pi2alamat3:'', pibagianpenjualan:0, piekspedisi:txtekspedisi.text, pitglkirim:dttanggalkirim.text, pitermin:txttermin.text, pitgljatuhtempo:tglDB, piuraian:txturaian.text, 
					picatatan:txtcatatan.text, pinoref:txtnoref.text, pitglnoref:dttanggalnoref.text, pitglpenutupan:parentApplication.m.DateFirst, pimatauang:txtmatauang.text, pikurs:o.txtkurs, pihargatermasukpajak:0, 
					pitotal:0, pidiskonpersen:0, pijmldiskon:0, pitotalpajak1detail:0, pitotalpajak2detail:0, pibiayalainpersen:0, pibiayalain:0, 
					pitotaltransaksi:0, pijmlbayar:0, pirekdiskon:vrekdiskon, pirekpajak1:vrekpajak1, pirekpajak2:vrekpajak2, pirekbiayalain:vrekbiayalain, pirekbayar:vrekbayar, piidsq:0, piidso:0, 
					pistatuspl:0, pistatusdo:0, pistatusdr:0, pistatussi:0, pistatusrnr:0, pistatussr:0, pistatus:cmbprogress.selectedItem.v, 
					pistatussebelumnya:0, pijmlrevisi:0, picetakanke:0, piinputuser:parentApplication.userid, piinputtgl:tglDB, pimodifikasiuser:0, pimodifikasitgl:tglDB, 
					piisclose:0, pitutupperiode:0, picustomtext1:'', picustomtext2:'', picustomtext3:'', picustomtext4:'', picustomtext5:'', 
					picustomint1:0, picustomint2:0, picustomint3:0, picustomdbl1:0, picustomdbl2:0, picustomdbl3:0, picustomdate1:parentApplication.m.DateFirst, 
					picustomdate2:parentApplication.m.DateFirst, picustomdate3:parentApplication.m.DateFirst
				}]);
				
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 2){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					o.o.nilaipajak1 = 0;
					o.o.nilaipajak2 = 0;
					return
				}
				if(column == 'add'){
					
				}else if(column == 'del'){
					
				}else{
					with(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex)){
						switch(column){
							case 'jml':
							case 'harga':
							case 'pajak1':
							case 'pajak2':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								jmlbarang = Number(jml) * Number(nilaisatuan);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
								jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'diskon':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
								jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'jmldiskon':
								vMsg = ''; vMsgIng = ''; validasi = true;
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
									if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
									if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
									jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
								}
								break;
							case 'subtotal':
								hargaDariSubtotal.hitungHargaDariSubtotal(dg);
								break;
						}
					}
				}
				parentApplication.F_dgRefresh(dg);
				f_hitungTotalDetail();
			}
			
