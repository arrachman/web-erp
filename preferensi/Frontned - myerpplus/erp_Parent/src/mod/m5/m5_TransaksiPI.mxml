				parentApplication.F_TextInputDiskonbertingkat([txtdiskonpersen, txtbiayalainpersen]);
				parentApplication.F_TextInputNumberDesimalMode([txtdiskonnilai, txtbiayalainnilai, txtkurs]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				
				txtdiskonnilai.addEventListener(KeyboardEvent.KEY_DOWN, removeSkip);
				txtbiayalainnilai.addEventListener(KeyboardEvent.KEY_DOWN, removeSkip);
				function removeSkip(event:KeyboardEvent):void
				{
					if((event.keyCode==Keyboard.DOWN)||(event.keyCode==Keyboard.ENTER))
					parentApplication.focusMgr(true);
					else if(event.keyCode==Keyboard.UP)
						parentApplication.focusMgr(false);
				}
				
				// fungsi menubar
