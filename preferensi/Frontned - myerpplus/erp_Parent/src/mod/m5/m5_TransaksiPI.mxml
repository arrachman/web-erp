								ob.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, ob.nilaipajak2, ob.subtotal, ob.nilaipajak1, ob.nilaipajak2);
								f_hitungTotalDetail();
								break;
							case 'pajak2':
								ob.pajak2 = '';
								ob.nilaipajak2 = 0;
//								ob.jmlpajak2 = 0;
								ob.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, ob.nilaipajak1, ob.subtotal, ob.nilaipajak1, ob.nilaipajak2);
								ob.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, ob.nilaipajak2, ob.subtotal, ob.nilaipajak1, ob.nilaipajak2);
								f_hitungTotalDetail();
								break;
							case 'gudang':
								ob.gudang = '';
								break;
							case 'costcenter':
								ob.costcenter = '';
								break;
							case 'divisi':
								ob.divisi = '';
								break;
							case 'subdivisi':
								ob.subdivisi = '';
								break;
							case 'proyek':
								ob.proyek = '';
								break;
							case 'matauang':
								ob.matauang = '';
								ob.kurs = '';
								break;
							case 'cabang':
								ob.cabang = '';
								break;
							case 'lokasi':
								ob.lokasi = '';
								break;
							case 'tampil':
							case 'tampilHistory':
							case 'simpan':
								Alert.show(parentApplication.l(parentApplication.wsErrmessage), parentApplication.l('Informasi'));
								break;
						}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcustomer':parentApplication.F_KosongkanText([txtcustomer, lblcustomer]);break;
					case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
					case 'txtsalesman':parentApplication.F_KosongkanText([txtsalesman, lblsalesman]);break;
					case 'txtgudang':parentApplication.F_KosongkanText([txtgudang, lblgudang]);break;
					case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang, txtkurs]);break;
					case 'txttermin':parentApplication.F_KosongkanText([txttermin, lbltermin]);dttgljt.text = dttanggal.text;break;
					case 'txtekspedisi':parentApplication.F_KosongkanText([txtekspedisi]);break;
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String, tgl:String;
				n.dttanggal = dttanggal.text;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){
						u.refresh();
						// Set Utama
						with(u.getItemAt(0))
							a = [piid, picabang, pilokasi, txtgudang.text, cmbasalbarang.textInput.text, piasalbarangkategori, pijenispenjualan, 
								pijenispenjualankategori, cmbcarabayar.selectedItem.v, pisumber, int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), pikodepa, 
								picustomer, txtkontakperson.text, txtalamatcustomer.text, pi1alamat2, pi1alamat3, txtalamatkirim.text, pi2alamat2, 
								pi2alamat3, pibagianpenjualan, txtekspedisi.text, parentApplication.F_tglFormatDB(dttanggalkirim.text), txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgljt.text), txturaian.text, 
								txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), parentApplication.F_tglFormatDB(pitglpenutupan), txtmatauang.text, o.txtkurs, int(chkhargapajak.selected), 
								n.vtotal, o.txtdiskonpersen, o.txtdiskonnilai, n.vtotalpajak1, n.vtotalpajak2, o.txtbiayalainpersen, o.txtbiayalainnilai, 
								n.vtotaltransaksi, pijmlbayar, vrekdiskon, vrekpajak1, vrekpajak2, vrekbiayalain, vrekbayar, 
								piidsq, piidso, pistatuspl, pistatusdo, pistatusdr, pistatussi, pistatusrnr, pistatussr, cmbprogress.selectedItem.v, 
								pistatussebelumnya, pijmlrevisi, picetakanke, piinputuser, parentApplication.F_tglFormatDB(piinputtgl), pimodifikasiuser, parentApplication.F_tglFormatDB(pimodifikasitgl), 
								piisclose, pitutupperiode, picustomtext1, picustomtext2, picustomtext3, picustomtext4, picustomtext5, 
								picustomint1, picustomint2, picustomint3, picustomdbl1, picustomdbl2, picustomdbl3, parentApplication.F_tglFormatDB(picustomdate1), 
								parentApplication.F_tglFormatDB(picustomdate2), parentApplication.F_tglFormatDB(picustomdate3)];
						utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++)
							with(dg1.dataProvider.getItemAt(i)){
								a = [idpidetail, idpi, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(txtkurs.text), harga, diskon, 
									jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, lokasi, 
									gudang, costcenter, divisi, subdivisi, proyek, catatan, (i+1), 
									idsqdetail, idsodetail, jmlpl, statuspl, jmldo, statusdo, jmldr, 
									statusdr, jmlsi, statussi, jmlrnr, statusrnr, jmlsr, statussr, isclose, customtext1, customtext2, 
									customtext3, customdbl1, customdbl2, customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						parentApplication.F_wsSimpan('simpan', "M5_PiSimpan", parentApplication.userid, isUpdate, utama, detail);	// kirim ketika simpan ke WS
						
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					pesanAlert = '';
					parentApplication.F_hapusBarisKosongGrid(dg1);
					if(cmbasalbarang.selectedIndex < 0 || cmbasalbarang.textInput.text.length == 0)parentApplication.msgAlert(cmbasalbarang,'Asal Barang');
					if(cmbcarabayar.selectedIndex < 0 || cmbcarabayar.textInput.text.length == 0)parentApplication.msgAlert(cmbcarabayar,'Cara Bayar');
					if(txtcustomer.text.length == 0)parentApplication.msgAlert(txtcustomer,'Customer');
					if(txtsalesman.text.length == 0)parentApplication.msgAlert(txtsalesman,'Salesman');
					if(txtgudang.text.length == 0)parentApplication.msgAlert(txtgudang,'Gudang');
					if(dttanggal.text.length == 0)parentApplication.msgAlert(dttanggal,'Tanggal');
					if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(txtmatauang.text.length == 0)parentApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length == 0)parentApplication.msgAlert(txtkurs,'Kurs');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)parentApplication.msgAlert(cmbprogress,'Progress');
					if(dg1.dataProvider.getItemAt(0).idsqdetail == null )parentApplication.msgAlert(dg1,'Detail Item');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
			
			public function f_hitungTotalDetail():void
			{
				n.vtotal=0;
				n.vtotalpajak1=0;
				n.vtotalpajak2=0;
				for(var i:int=0;i<dg1.dataProvider.length;i++){
					if(dg1.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg1.dataProvider.getItemAt(i).subtotal);
					if(dg1.dataProvider.getItemAt(i).jmlpajak1 != undefined)n.vtotalpajak1 += Number(dg1.dataProvider.getItemAt(i).jmlpajak1);
					if(dg1.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg1.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = parentApplication.m.nfNominal.format(n.vtotal);
				lblpajak1.text = parentApplication.m.nfNominal.format(n.vtotalpajak1);
				lblpajak2.text = parentApplication.m.nfNominal.format(n.vtotalpajak2);
				
				o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
				txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
				o.txtbiayalainnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtbiayalainpersen);
				txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
				
				f_hitungTotalUtama();
			}
			
			public function f_hitungTotalUtama():void
			{
				if(chkhargapajak.selected == false){
					n.vtotaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak1) + Number(n.vtotalpajak2) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
				}else{
					n.vtotaltransaksi = (Number(n.vtotal) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
				}
					
				lbltotaltransaksi.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				parentApplication.F_acAdd(dg1);
				dg1.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
