			public function f_noPack():void
			{
				var b:Boolean, c:Boolean;
				if(dg1.columns.getItemAt(dg1.selectedCell.columnIndex).dataField == 'nopack'){
					// hapus semua grid berat jika kosong
					if(dg2.dataProvider.getItemAt(0).nopack == '' || dg2.dataProvider.getItemAt(0).nopack == undefined || dg2.dataProvider.getItemAt(0).nopack == null){
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
					}
					// cek apa ada current input no pack yg di ganti
					b = true;
					for(i=0;i<dg1.dataProviderLength;i++){
						if(parentApplication.vpVarCurrent == dg1.dataProvider.getItemAt(i).nopack){
							b = false;
							break;
						}
					}
					// jika curret input no pack ndk ada maka di hapus di grid pack
					if(b == true){
						for(i=0;i<dg2.dataProviderLength;i++){
							if(dg2.dataProvider.getItemAt(i).nopack == parentApplication.vpVarCurrent){
								dg2.dataProvider.removeItemAt(i);
								for(i=i;i<dg2.dataProviderLength;i++){
									dg2.dataProvider.getItemAt(i).no = (i+1);
								}
								break;
							}
						}
					}
					// cek apa ada nopack yg sama
					c = true;
					for(i=0;i<dg2.dataProviderLength;i++){
						if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).nopack == dg2.dataProvider.getItemAt(i).nopack){
							c = false;
							break;
						}
					}
					// jika tidak ada nopack yg sama maka tambahkan
					if(c == true){
						dg2.dataProvider.addItem({no:dg2.dataProvider.length+1, nopack:dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).nopack, bentuk:'', berat:'', catatan:'', idplpack:0, idpl:0, customtext1:'', customtext2:'', customtext3:'', 
						customdbl1:0, customdbl2:0, customdbl3:0, customdate1:parentApplication.m.DateFirst, customdate2:parentApplication.m.DateFirst, customdate3:parentApplication.m.DateFirst});
						if(dg2.dataProvider.getItemAt(0).nopack == "" || dg2.dataProvider.getItemAt(0).nopack == undefined || dg2.dataProvider.getItemAt(0).nopack == null){
							dg2.dataProvider.removeItemAt(0);
						}
					}
					dg1.setFocus();
				}
			}
			
