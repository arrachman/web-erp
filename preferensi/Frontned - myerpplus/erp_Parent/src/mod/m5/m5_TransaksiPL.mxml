								plcustomer, txtkontakperson.text, txtalamatcustomer.text, pl1alamat2, pl1alamat3, txtalamatkirim.text, pl2alamat2, 
								pl2alamat3, plbagianpenjualan, plbagianpengepakan, txtekspedisi.text, parentApplication.F_tglFormatDB(dttanggalkirim.text), txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgljt.text), 
								txturaian.text, txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), parentApplication.F_tglFormatDB(pltglpenutupan), txtmatauang.text, o.txtkurs, 
								plhargatermasukpajak, n.vtotal, n.vdiskonpersen, n.vjmldiskon, n.vtotalpajak1, n.vtotalpajak2, n.vbiayalainpersen, 
								n.vjmlbiayalain, n.totaltransaksi, vrekdiskon, vrekpajak1, vrekpajak2, vrekbiayalain, plidsq, 
								plidso, plidpi, plstatusdo, plstatusdr, plstatussi, plstatusrnr, plstatussr, 
								cmbprogress.selectedItem.v, plstatussebelumnya, pljmlrevisi, plcetakanke, plinputuser, parentApplication.F_tglFormatDB(plinputtgl), plmodifikasiuser, 
								parentApplication.F_tglFormatDB(plmodifikasitgl), plisclose, plcustomtext1, plcustomtext2, plcustomtext3, plcustomtext4, plcustomtext5, 
								plcustomint1, plcustomint2, plcustomint3, plcustomdbl1, plcustomdbl2, plcustomdbl3, parentApplication.F_tglFormatDB(plcustomdate1), 
								parentApplication.F_tglFormatDB(plcustomdate2), parentApplication.F_tglFormatDB(plcustomdate3)];
						utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++)
							with(dg1.dataProvider.getItemAt(i)){
								a = [idpldetail, idpl, idbarang, namabarang, tipebarang, nopack, jml, 
									satuan, nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(txtkurs.text), harga, 
									diskon, jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, 
									lokasi, gudang, costcenter, divisi, subdivisi, proyek, catatan, 
									(i+1), idsqdetail, idsodetail, idpidetail, jmldo, statusdo, jmldr, 
									statusdr, jmlsi, statussi, jmlrnr, statusrnr, jmlsr, 
									statussr, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
									customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
