			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String='';
				if(dg1.selectedCell != null)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtcustomer':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+txtcustomer.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="C")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).plcustomer+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).plcustomer+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtsalesman':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="M") AND kkode ="'+txtsalesman.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif=1 AND wkode ="'+txtgudang.text.split('"').join('\\"')+'"';
						csfilter = 'waktif=1';
						csfield = 2;
