			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var grid:Object;
				if(tab.selectedIndex ==0 ){grid = dg1}
				else if(tab.selectedIndex == 1){grid = dg2}
				switch (components){
					case 'calculator':
						grid.dataProvider[grid.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex))
						switch(dataField){
							case 'jml':
							case 'harga':
							case 'pajak1':
							case 'pajak2':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								jmlbarang = Number(jml) * Number(nilaisatuan);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'diskon':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'jmldiskon':
								vMsg = ''; vMsgIng = ''; validasi = true;
								dgrid1 = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
									if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
									if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								}
								break;
							case 'nopack':
								f_noPack();
								break;
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(grid, grid.selectedCell.rowIndex);
						break;
				}
			}
			
