			public function f_grid(dg:DataGrid, column:String):void
			{ 
				var gridpacking:Object= {};
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 1){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					o.o.nilaipajak1 = 0;
					o.o.nilaipajak2 = 0;
					o.o.harga = 0;
					o.o.diskon = 0;
					o.o.jmldiskon = 0;
					return
				}
				var a:Array = new Array;
				var i:int, j:int, b:Boolean = true;
				if(column == 'add'){
					
				}else if(column == 'del'){
					switch(column){
						case 'del':
							for(i=0;i<dg2.dataProviderLength;i++){
								b = true;
								for(j=0;j<dg1.dataProviderLength;j++)
									if(dg2.dataProvider[i].nopack == dg1.dataProvider[j].nopack){
										b = false;
										break;
									}
								if(b == true){
									dg2.dataProvider.removeItemAt(i);
									for(i=i;i<dg2.dataProviderLength;i++){
										dg2.dataProvider.getItemAt(i).no = (i+1);
									}
									break;
								}
							}
						break;
					}
				}else{
					with(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex)){
						switch(column){
							case 'jml':
							case 'harga':
							case 'pajak1':
							case 'pajak2':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								jmlbarang = Number(jml) * Number(nilaisatuan);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'diskon':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								parentApplication.F_hargaTotal(dg1);
								break;
							case 'jmldiskon':
								vMsg = ''; vMsgIng = ''; validasi = true;
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
									if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
									if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
	//								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
	//								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								}
								break;
							case 'nopack':
								if(tab.selectedIndex == 0){
									f_noPack();
								}else{
									gridpacking = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
									gridpacking.no = dg2.dataProvider.length+1; gridpacking.bentuk = ''; gridpacking.berat=''; gridpacking.catatan=''; gridpacking.idplpack=0; gridpacking.idpl=0; gridpacking.customtext1=''; gridpacking.customtext2=''; gridpacking.customtext3=''; 
									gridpacking.customdbl1=0; gridpacking.customdbl2=0; gridpacking.customdbl3=0; gridpacking.customdate1=parentApplication.m.DateFirst; gridpacking.customdate2=parentApplication.m.DateFirst; gridpacking.customdate3=parentApplication.m.DateFirst;
								}
								break;
						}
					}
				}
				parentApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
