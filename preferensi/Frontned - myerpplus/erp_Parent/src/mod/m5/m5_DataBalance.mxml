			public function f_persiapan():void
			{
				p=parentApplication;
				
				
				// module, menu transaksi, menu, sumber, approvell
				if(txtsumber.text == 'SI' || txtsumber.text == ''){
					a = [5, 51, 23, 'Si', false];
				}else if (txtsumber.text == 'SR'){
					a = [5, 51, 25, 'Sr', false];
