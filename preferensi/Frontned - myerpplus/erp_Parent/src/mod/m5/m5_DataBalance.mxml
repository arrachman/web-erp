							FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M5_'+a[3]+'BUpdateStatus', FlexGlobals.topLevelApplication.userid, id, 'unclose', false, int(txtpaging.text), 20, f_filterdata(), txtsumber.text+"inputtgl desc");
						else if(status == 2 || status == 3 || status == 4)
							FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M5_'+a[3]+'BUpdateStatus', FlexGlobals.topLevelApplication.userid, id, '7', false, int(txtpaging.text), 20, f_filterdata(), txtsumber.text+"inputtgl desc");
						else Alert.show('Status Approved, Inprogress dan Complete yang bisa di Close', 'Peringatan');		
				}
				
			}
			
