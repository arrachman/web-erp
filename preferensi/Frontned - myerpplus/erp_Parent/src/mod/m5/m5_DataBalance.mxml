					}else{
						cmbjenislaporan.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Pilih Jenis Laporan dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}
				}
				
				function f_transaksiTerkait():void
				{
					if(dg.dataProviderLength > 0)
						FlexGlobals.topLevelApplication.F_wsGetDataById(FlexGlobals.topLevelApplication.sptParam+'tampilFDTransaksiTerkait', 'M5_'+a[3]+'Terkait', dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"]); 
				}
				
				function f_jurnalVocher():void
				{
					var notransaksi:String = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"notransaksi"];
					if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 11) == true)
