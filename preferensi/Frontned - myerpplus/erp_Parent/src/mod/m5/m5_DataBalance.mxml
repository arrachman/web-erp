							else Alert.show(FlexGlobals.topLevelApplication.l('Hanya status approved yang bisa di jadikan Draft'), FlexGlobals.topLevelApplication.l('Peringatan'));
				}
				
				function f_jadikanCloseUnclose():void
				{
					var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"status"];
					var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"];
					var statussebelumnya:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"statussebelumnya"];
					if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 10) == true)
