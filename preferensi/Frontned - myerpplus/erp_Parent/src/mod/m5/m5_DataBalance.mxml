				}
				
				function f_jadikanDraft():void
				{
					var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"status"];
					var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"];
