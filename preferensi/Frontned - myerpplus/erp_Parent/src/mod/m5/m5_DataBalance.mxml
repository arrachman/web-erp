	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			
			import spark.events.GridEvent;
			import spark.events.GridSortEvent;
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array, idkontak:int, iduser:String='';
			private var p:Object;
			public var o:Object = {};
			public var f:String="";
			
			public function mbclick():void{
				// Config Menu Bar
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_tampilkan); // tampil
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_reset); // reset
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_tambah); // tambah
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_cetak); // cetak
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbItemClick); 
				
				function f_tampilkan():void
				{
					if(txtsumber.text.length == 0){
						Alert.show(FlexGlobals.topLevelApplication.l("Sumber harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}else{
						if(int(txtpaging.text) == 0)
							f_formDataTampil(1);
						else
							f_formDataTampil(int(txtpaging.text));
					}
					
				}
				
				function f_reset():void
				{
					f_kondisiAwal();
				}
				
				function f_tambah():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 1) == true){
						FlexGlobals.topLevelApplication.openFormX("Saldo Awal Piutang", 0, "mod/M5/M5_TransaksiBalance.swf", 0, 0, "t2");
					}
				}
				function f_cetak():void
				{
					if(cmbjenislaporan.selectedIndex >= 0){
						var mnid:int
						if(txtsumber.text == "SI"){
							FlexGlobals.topLevelApplication.F_openReport(5, 10, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', 0, FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text), txtsumber.text.toUpperCase());
						}else if(txtsumber.text == 'SR'){
							FlexGlobals.topLevelApplication.F_openReport(5, 12, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', 0, FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text), txtsumber.text.toUpperCase());
						}
					}else{
						cmbjenislaporan.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Pilih Jenis Laporan dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}
				}
				var m : Object; var sumber:String;
				function f_mbItemClick(e:MenuEvent):void
				{
					
					switch(e.label){
						case 'Bantuan':f_bantuan();
							break;
						case 'Edit':f_edit();
							break;
						case 'Hapus':f_hapus();
							break;
						case 'Cetak Detail':f_cetakDetail();
							break;
						case 'Transaksi Terkait':f_transaksiTerkait();
							break;
						case 'Jurnal Voucher':f_jurnalVocher();
							break;
						case 'Jadikan Draft':f_jadikanDraft();
							break;
						case 'Jadikan Close/Unclose':f_jadikanCloseUnclose();
							break;
						default:
							if(cmbjenislaporan.selectedIndex >= 0){
								var mnid:int
								if(txtsumber.text == "SI"){
									FlexGlobals.topLevelApplication.F_openReport(5, 10, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data, FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text), txtsumber.text.toUpperCase());
								}else if(txtsumber.text == 'SR'){
									FlexGlobals.topLevelApplication.F_openReport(5, 12, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data, FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text), txtsumber.text.toUpperCase());
								}
							}else{
								cmbjenislaporan.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Pilih Jenis Laporan dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}
					}
				}
				
				function f_bantuan():void
				{
					FlexGlobals.topLevelApplication.F_help(a[0], a[1]);
				}
				
				function f_edit():void
				{
					if(dg.selectedCell != null){
						var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
						FlexGlobals.topLevelApplication.openFormX("Saldo Awal Piutang", 0, "mod/M5/M5_TransaksiBalance.swf", 0, 0, "t2", String(id));
					} 
				}
				
				function f_hapus():void
				{
					var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"status"];
					var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
					if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 3) == true)
						if(status == 0 || status == 5 || status == 6)
							Alert.show(FlexGlobals.topLevelApplication.l("Apakah Anda yakin akan menghapus No. Transaksi ini ?", 1), 'Information', 3, null, function(e:Object):void{	
								if(e.detail == Alert.YES)
									FlexGlobals.topLevelApplication.F_wsDelete(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M'+a[0]+'_'+a[3]+'BDelete', FlexGlobals.topLevelApplication.userid, id.toString(), int(txtpaging.text), 20, f_filterdata(), a[3]+"inputtgl desc");
							});
						else Alert.show('Status Draft, Revisi dan Reject yang bisa di hapus', 'Peringatan');
				}
				
				
				function f_cetakDetail():void
				{ 
					var mnid :int, fil:String='';
					if(cmbjenislaporan.selectedIndex >= 0){
						if(f.length == 0){
							fil = (txtsumber.text.toLowerCase()+"notransaksi = '"+dg.dataProvider[dg.selectedCell.rowIndex][txtsumber.text.toLowerCase()+"notransaksi"]+"'");
						}else{
							fil = f + " AND ("+txtsumber.text.toLowerCase()+"notransaksi = '"+dg.dataProvider[dg.selectedCell.rowIndex][txtsumber.text.toLowerCase()+"notransaksi"]+"')";
						}
						if(txtsumber.text == 'SI'){
							mnid = 10;
						}else if(txtsumber.text == 'SR'){
							mnid = 12;
						}
						FlexGlobals.topLevelApplication.F_openReport(5, mnid, cmbjenislaporan.selectedItem.ritem, fil,'', '', 0, FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text), txtsumber.text.toUpperCase(), dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"]);
					}else{
						cmbjenislaporan.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Pilih Jenis Laporan dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}
				}
				
				function f_transaksiTerkait():void
				{
					if(dg.dataProviderLength > 0)
						FlexGlobals.topLevelApplication.F_wsGetDataById(FlexGlobals.topLevelApplication.sptParam+'tampilFDTransaksiTerkait', 'M5_'+a[3]+'Terkait', dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"]); 
				}
				
				function f_jurnalVocher():void
				{
					var notransaksi:String = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"notransaksi"];
					if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 11) == true)
						FlexGlobals.topLevelApplication.F_wsSearch(FlexGlobals.topLevelApplication.sptParam+'tampilFDJurnalVocher', 'M2_Transaction_Journal_VoucherSearch', 0, 0, "tnotransaksi = '"+notransaksi+"'", "tgrup, turutan"); 
				}
				
				function f_jadikanDraft():void
				{
					var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"status"];
					var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"];
					if(dg.dataProviderLength > 0)
						if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 2) == true)
							if(status == 2)
								FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M5_'+a[3]+'BUpdateStatus', FlexGlobals.topLevelApplication.userid, id, '0', false, int(txtpaging.text), 20, f_filterdata(), txtsumber.text.toLowerCase()+'inputtgl desc');
							else Alert.show(FlexGlobals.topLevelApplication.l('Hanya status approved yang bisa di jadikan Draft'), FlexGlobals.topLevelApplication.l('Peringatan'));
				}
				
				function f_jadikanCloseUnclose():void
				{
					var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"status"];
					var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"];
					var statussebelumnya:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"statussebelumnya"];
					if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 10) == true)
						if(status == 7)
							FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M5_'+a[3]+'BUpdateStatus', FlexGlobals.topLevelApplication.userid, id, 'unclose', false, int(txtpaging.text), 20, f_filterdata(), txtsumber.text+"inputtgl desc");
						else if(status == 2 || status == 3 || status == 4)
							FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M5_'+a[3]+'BUpdateStatus', FlexGlobals.topLevelApplication.userid, id, '7', false, int(txtpaging.text), 20, f_filterdata(), txtsumber.text+"inputtgl desc");
						else Alert.show('Status Approved, Inprogress dan Complete yang bisa di Close', 'Peringatan');		
				}
			}
			
			
			// Form Data
			public function F_persiapanFormData():void
			{
				var vSort:Boolean = true, vPosisi:int = 0, vCMI:ContextMenuItem, arr:Array = new Array;
				FlexGlobals.topLevelApplication.F_RegGrid(5, a[2], [dg], 'data');
				addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				// Config Paging
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = "0";
				txtpaging.maxChars = 4;
				imgfirst.enabled = false;
				imgprevious.enabled = false;
				imgnext.enabled = false;
				imglast.enabled = false;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				function f_KEY_DOWN(e:KeyboardEvent):void
				{ 
					var id:int
					if(e.ctrlKey)
						switch(e.keyCode){
							
						}
					else 
						switch(e.keyCode){
							case Keyboard.HOME:
								if(int(txtpaging.text)>1)
									f_formDataTampil();
								break;
							case Keyboard.PAGE_UP:
								if(int(txtpaging.text)-1>0)
									f_formDataTampil(int(txtpaging.text)-1);
								break;
							case Keyboard.PAGE_DOWN:
								f_formDataTampil(int(txtpaging.text)+1);
								break;
							case Keyboard.END:
								f_formDataTampil(-1);
								break;
							case Keyboard.F5:
								if(int(txtpaging.text) == 0)
									f_formDataTampil(1);
								else
									f_formDataTampil(int(txtpaging.text)); 
								break;
						}
				}
				
				
				function f_firstCLICK():void
				{
					if(int(txtpaging.text)>1)
						f_formDataTampil();
				}
				
				function f_previousCLICK():void
				{
					if(int(txtpaging.text)-1>0)
						f_formDataTampil(int(txtpaging.text)-1);
				}
				
				function f_nextCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)+1);
				}
				
				function f_lastCLICK():void
				{
					f_formDataTampil(int(-1));
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_formDataTampil(int(txtpaging.text));
				}
				
				
				
				
				// Config Pop Up
				FlexGlobals.topLevelApplication.F_standartTransaksiTerkait(gridjv);
				FlexGlobals.topLevelApplication.F_standartTransaksiTerkait(gridtts);
				FlexGlobals.topLevelApplication.F_standartTransaksiTerkait(gridtt);
				gridjv.dataProvider = new ArrayCollection();
				gridtt.dataProvider = new ArrayCollection();
				gridtts.dataProvider = new ArrayCollection();
				ttwpopup.addEventListener(mx.events.CloseEvent.CLOSE, f_ttwClose);
				ttwpopup.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_ttwKEY_DOWN);
				
				// Config Grid
				dg.dataProvider = new ArrayCollection();
				dg.addEventListener(GridEvent.GRID_ROLL_OVER, f_dgROLL_OVER);
				dg.addEventListener(GridSortEvent.SORT_CHANGING, f_dgSort_changing);
				dg.selectionMode = "singleCell";
				dg.contextMenu = new ContextMenu;
				dg.contextMenu.hideBuiltInItems();
				dg.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_MENU_SELECT);
				vCMI = new ContextMenuItem(FlexGlobals.topLevelApplication.l('Cetak Transaksi ini'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_cetakDetail);
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem('Transaksi Terkait')
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_transaksiTerkait); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem('Jurnal Voucher')      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jurnalVocher); 
				dg.contextMenu.customItems.push(vCMI);
				
				vCMI = new ContextMenuItem('Jadikan Draft')      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jadikanDraft);  
				dg.contextMenu.customItems.push(vCMI);   
				
				vCMI = new ContextMenuItem('Jadikan Close / Unclose')     
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jadikanCloseUnclose);  
				dg.contextMenu.customItems.push(vCMI); 
				
				vCMI = new ContextMenuItem('History Transaksi')     
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_history);  
				dg.contextMenu.customItems.push(vCMI); 
				
				vCMI = new ContextMenuItem('Hapus')     
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_hapus);  
				dg.contextMenu.customItems.push(vCMI);  
				
				function f_ttwClose():void
				{
					grppopup.visible = false;
					gridterkait.visible = false;
					gridjv.dataProvider.removeAll();
					gridtts.dataProvider.removeAll();
					gridtt.dataProvider.removeAll();
					
					dg.setFocus();
				}
				
				function f_ttwKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ESCAPE)
						f_ttwClose();
				}
				
				function f_dgROLL_OVER(e:GridEvent):void
				{
					if(dg.dataProviderLength > 0){
						arr[0] = e.rowIndex;
						arr[1] = e.columnIndex;
					}
				}
				
				function f_dgSort_changing(e:GridSortEvent):void
				{
					var om:Object = dg.columns.getItemAt(int(e.columnIndices)).dataField;
					if(vSort == true){
						vSort = false;
						f_formDataTampil(1, String(om));
					}else if(vPosisi != int(e.columnIndices)){
						vSort = false;
						f_formDataTampil(1, String(om));
					}else{
						vSort = true;
						dg.dataProvider.removeAll();
						f_formDataTampil(1, om+' DESC');
					}
				}
				
				function f_MENU_SELECT():void
				{
					arr[2] = arr[0]; //row
					arr[3] = arr[1]; //col
					dg.setSelectedCell(arr[2], arr[3]);
				}
				
				
				
				
				function f_hapus():void
				{
					var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"status"];
					var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"];
					if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 3) == true)
						if(status == 0 || status == 5 || status == 6)
							Alert.show(FlexGlobals.topLevelApplication.l("Apakah Anda yakin akan menghapus No. Transaksi ini ?", 1), 'Information', 3, null, function(e:Object):void{	
								if(e.detail == Alert.YES)
									FlexGlobals.topLevelApplication.F_wsDelete(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M'+a[0]+'_'+a[3]+'BDelete', FlexGlobals.topLevelApplication.userid, id.toString(), int(txtpaging.text), 20, f_filterdata(), a[3]+"inputtgl desc");
							});
						else Alert.show('Status Draft, Revisi dan Reject yang bisa di hapus', 'Peringatan');
				}
				
				
				
				
				
				function f_edit():void
				{
					if(dg.selectedCell != null){
						var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"];
						FlexGlobals.topLevelApplication.openFormX("Saldo Awal Piutang", 0, "mod/M5/M5_TransaksiBalance.swf", 0, 0, "t2", String(id));
					} 
				}
				
				function f_history():void
				{
					if(dg.selectedCell != null){
						var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[txtsumber.text.toLowerCase()+"id"];
						if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 4) == true){
							
							FlexGlobals.topLevelApplication.openFormX ("History Saldo Awal Piutang", 0, "mod/m0/m0_HistoryTransaksi.swf", 0, 0, "t3", String(id),[a[3], a[0], a[2], a[3]]);
						}
					} 
				}
				
				function f_cetak():void
				{
					FlexGlobals.topLevelApplication.F_openReport(a[0], a[1], cmbjenislaporan.selectedItem.ritem, f_filterdata());
				}
				
				
				function f_cetakDetail():void
				{ 
