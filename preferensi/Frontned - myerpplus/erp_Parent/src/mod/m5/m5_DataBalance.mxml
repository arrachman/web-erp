			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtterimadari1':
						paket = 'CdM1_Contact';
						csfilter = "kaktif=1 and kkategori ='C'";
						wsfilter = "kaktif=1 and kkategori ='C' AND kkode ='"+ txtterimadari1.text+"'";
						csfield = 2;
						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = "laktif=1";
						wsfilter = "laktif=1 AND lkode ='"+txtlokasi.text+"'";
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = "baktif=1";
						wsfilter = "baktif=1 AND bkode ='"+txtcabang.text+"'";
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = "uaktif=1";
						wsfilter = "uaktif=1 AND ukode ='"+txtuser.text+"'";
						break;
					case 'txtuang':
						paket = 'CdM1_Currency';
						csfilter = "caktif=1";
						wsfilter = "caktif=1 AND ckode ='"+txtuang.text+"'";
						break;
					case "txtsumber":
						paket = "CdM0_Nomor";
						wsfilter = '(kodetabel = "SI" or kodetabel="SR") and kodetabel ="'+txtsumber.text+'"';
						csfilter = 'kodetabel = "SI" or kodetabel="SR"';
						csfield = 2;
						sort = 'kodetabel asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(p.wsSuccess == true){
					if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtterimadari1':
							txtterimadari1.text = ws.kkode;
							idkontak = ws.kid;
							break;
						case 'txtlokasi':
							txtlokasi.text = ws.lkode;
							break;
						case 'txtcabang':
							txtcabang.text = ws.bkode;
							break;
						case 'txtuser':
							txtuser.text = ws.ukode;
							iduser = ws.userid;
							break;
						case 'txtuang':
							txtuang.text = ws.ckode;
							break;
						case "txtsumber":
							txtsumber.text = ws.kodetabel;
							if(txtsumber.text == 'SI'){
								cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(5, 10);
								a[2] = 23; a[3] = 'Si';
							}else if(txtsumber.text == 'SR'){
								cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(5, 12);
								a[2] = 25; a[3] = 'Sr';
							}
							F_persiapanFormData()
							cmbjenislaporan.selectedIndex = 0;
							break;
					}
				}else{
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtterimadari1':p.F_KosongkanText([txtterimadari1]);break;
					case 'txtlokasi':p.F_KosongkanText([txtlokasi]);break;
					case 'txtcabang':p.F_KosongkanText([txtcabang]);break;
					case 'txtuser':p.F_KosongkanText([txtuser]);break;
					case 'txtuang':p.F_KosongkanText([txtuang]);break;
					case 'txtsumber':p.F_KosongkanText([txtsumber]);break;
				}
			}
			
			public function f_filterdata():String{
				
				var s :String = cmbstatus.textInput.text;
				if(txtsumber.text == 'SI'){
					f = 'sisaldoawal = 1';
					if(txtterimadari1.text!='')
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'sicustomer = '+idkontak+'');
					if(txtuser.text!='')
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'siinputuser = "'+iduser+'"');
					if(txtuang.text!='')
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'simatauang = "'+txtuang.text+'"');
					if(s.length == 0){
						
					}else if(s == 'Semua'){
						cmbstatus.selectedIndex = 0;
						
					}else if(s == 'Aktif'){
						cmbstatus.selectedIndex = 1;
						f = FlexGlobals.topLevelApplication.TambahFilter(f, "sistatus = 2 OR sistatus = 3 OR sistatus = 4 OR sistatus = 7");
						//	else if(s == 'Draft')
						//		filter = TambahFilter(filter, ""+f+"status = 0 AND "+f+"inputuser = "+userid);
					}else
						f = FlexGlobals.topLevelApplication.TambahFilter(f, "sistatus = "+cmbstatus.selectedItem.v);
					if(txtnotransaksi1.text != '' && txtnotransaksi2.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'sinotransaksi BETWEEN "'+txtnotransaksi1.text+'" AND "'+txtnotransaksi2.text+'"');
					
					if(dttgl1.text != '' && dttgl2.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'sitgl BETWEEN "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'" AND "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
					else if(dttgl1.text != '') 
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'sitgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'"'); 
					else if(dttgl2.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'sitgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
					
					if(txtlokasi.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'silokasi LIKE "%'+txtlokasi.text+'%"');
					
					if(txturaian.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'siuraian LIKE "%'+txturaian.text+'%"');
					
					if(txtcatatan.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'sicatatan LIKE "%'+txtcatatan.text+'%"');
					
					if(txtcabang.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'sicabang LIKE "%'+txtcabang.text+'%"');
				}
					
				else if(txtsumber.text == "SR"){
					f = 'srsaldoawal = 1';
					if(txtterimadari1.text!='')
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'srcustomer = '+idkontak+'');
					if(txtuser.text!='')
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'srinputuser = "'+iduser+'"');
					if(txtuang.text!='')
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'srmatauang = "'+txtuang.text+'"');
					if(s.length == 0){
						
					}else if(s == 'Semua'){
						cmbstatus.selectedIndex = 0;
						
					}else if(s == 'Aktif'){
						cmbstatus.selectedIndex = 1;
						f = FlexGlobals.topLevelApplication.TambahFilter(f, "srstatus = 2 OR srstatus = 3 OR srstatus = 4 OR srstatus = 7");
						//	else if(s == 'Draft')
						//		filter = TambahFilter(filter, ""+f+"status = 0 AND "+f+"inputuser = "+userid);
					}else
						f = FlexGlobals.topLevelApplication.TambahFilter(f, "srstatus = "+cmbstatus.selectedItem.v);
					if(txtnotransaksi1.text != '' && txtnotransaksi2.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'srnotransaksi BETWEEN "'+txtnotransaksi1.text+'" AND "'+txtnotransaksi2.text+'"');
					
					if(dttgl1.text != '' && dttgl2.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'srtgl BETWEEN "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'" AND "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
					else if(dttgl1.text != '') 
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'srtgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'"'); 
					else if(dttgl2.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'srtgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
					
					if(txtlokasi.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'srlokasi LIKE "%'+txtlokasi.text+'%"');
					
					if(txturaian.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'sruraian LIKE "%'+txturaian.text+'%"');
					
					if(txtcatatan.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'srcatatan LIKE "%'+txtcatatan.text+'%"');
					
					if(txtcabang.text != '')
						f = FlexGlobals.topLevelApplication.TambahFilter(f, 'srcabang LIKE "%'+txtcabang.text+'%"');
				}
				
				return f;
			}
			
