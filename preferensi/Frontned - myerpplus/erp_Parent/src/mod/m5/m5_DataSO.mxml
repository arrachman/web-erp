// fokus ke no txtnotransaksi saat form pertama dibuka ======================================
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
// persiapan persiapan ======================================================================	
			public function f_persiapan():void
			{
				p=parentApplication;
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnotransaksi, ttanggal, tcustomer, turaian, tcatatan, tjenislaporan, tsalesman, tuser, tlokasi, tcabang, tstatus, tuang]);
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(5, 4);				//(ambil report dari database)
				a = [5, 4, 17, 'So', false];
				p.F_persiapanFormData(this);
				var ct:FatkurGanteng =  new FatkurGanteng;
				ct.f_copyTransaksi(dg);
				p.F_DateFieldStandard([dttgl1, dttgl2, dttglkirim1, dttglkirim2]);														// daftarkan fungsi-fungsi datefield
				p.F_ComboBoxStandard([cmbjenislaporan,  cmbstatus]);											// daftarkan fungsi-fungsi combobox
				p.F_txtpencarian([txtcustomer1, txtlokasi, txtuser, txtsalesman, txtcabang, txtuang, txtcatatan]);		// daftarkan fungsi-fungsi text input yang pencarian
				p.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2, txturaian, txtcatatan]);				// daftarkan fungsi-fungsi text input
//				txtnotransaksi1.addEventListener(spark.events.TextOperationEvent.CHANGE, f_change);				// digunakan untuk pengisian text input lain ketika fokus out
//				dttgl1.addEventListener(spark.events.TextOperationEvent.CHANGE, f_changedate);					// digunakan untuk pengisian datefield lain ketika fokus out
				function f_change():void{
					txtnotransaksi2.text = txtnotransaksi1.text;
				}
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				f_kondisiAwal();
			}
			
// set kondisi awal ketika form dibuka ======================================
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				cmbstatus.selectedIndex = o.DefaultStatus;
				txturaian.text = p.getNomor("SO");
				txtlokasi.text = p.ulokasi;
				txtcabang.text = p.ucabang;
				txtuser.text = p.userid;
				p.F_SetNilaiText([dttgl1, dttgl2], p.DefaultTanggal);
				p.F_KosongkanText([txtnotransaksi1, txtnotransaksi2, txtcustomer1, txturaian, txtcatatan, txtsalesman, txtuser, txtuang]);
				dg.dataProvider.removeAll();
			}
			
// digunakan untuk duka form transaksi ======================================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				if(parentApplication.apaBisaAkses(a[0], a[1], 4) == true)
				FlexGlobals.topLevelApplication.openForm(a[0], a[1], dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[a[3].toLowerCase()+'id']);
			}
			
// set kondisi untuk filter =============================================
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtcustomer1':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+txtcustomer1.text.split('"').join('\\"')+'"';		// dipakai ketika validasi dari textinput
						csfilter = '(kaktif=1 AND kkategori="C")';																// dipakai ketika buka form komponen pencarian
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtcustomer2':
						paket = 'CdM1_Contact';
//						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+txtcustomer2.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="C")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = 'laktif=1';
						wsfilter = 'laktif=1 AND lkode ="'+txtlokasi.text.split('"').join('\\"')+'"';
						sort = 'lkode asc';
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = 'uaktif=1';
						wsfilter = 'uaktif=1 AND ukode ="'+txtuser.text.split('"').join('\\"')+'"';
						sort = 'ukode asc';
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = 'uaktif=1';
						wsfilter = 'uaktif=1 AND ukode ="'+txtuser.text.split('"').join('\\"')+'"';
						sort = 'ukode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						wsfilter = 'tnaktif=1 AND tnsumber = "SO" AND tncatatan = "'+txtcatatan.text+'"';
						csfilter = 'tnaktif=1 AND tnsumber = "SO"';
						sort = 'tnkode asc';
						break;
					case 'txtsalesman':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="M") AND kkode ="'+txtsalesman.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = 'baktif=1';
						wsfilter = 'baktif=1 AND bkode ="'+txtcabang.text.split('"').join('\\"')+'"';
						sort = 'bkode asc';
						break;
					case 'txtuang':
						paket = 'CdM1_Currency';
						csfilter = "caktif=1";
						wsfilter = "caktif=1 AND ckode ='"+txtuang.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
// set kondisi saat set ketika selesai pencarian ==================================
			// set ketika benar ====================================
			public var customer1:String, customer2:String, salesman:String, inputuser:String;
			public function f_wsHasil():void
			{
				var o:Object, s:String = p.subject, i:int;
				if(p.wsSuccess == true){
					if(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt.length >= 0)o = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtcustomer1':
							txtcustomer1.text = o.kkode;
							customer1 = o.kid;
						case 'txtcustomer2':
//							txtcustomer2.text = o.kkode;
							customer2 = o.kid;
							break;
						case 'txtlokasi':
							txtlokasi.text = o.lkode;
							break;
						case 'txtuser':
							txtuser.text = o.ukode;
							inputuser = o.userid;
							break;
						case 'txtsalesman':
							txtsalesman.text = o.kkode;
							salesman = o.kid;
							break;
						case 'txtcabang':
							txtcabang.text = o.bkode;
							break;
						case 'txtuang':
							txtuang.text = o.ckode;
							break;
						case 'txtcatatan':
							txtcatatan.text = o.tncatatan;
							break;
					}
				}else{					
				// set ketika salah ====================================
					if(p.F_validasiFalse(s) == true)
						switch(s){
							case 'txtcustomer1':txtcustomer1.text = ""; customer1 = "0"; break;
							case 'txtlokasi':txtlokasi.text = "";break;
							case 'txtuser':txtuser.text = ""; inputuser = "0"; break;
							case 'txtsalesman':txtsalesman.text = ""; salesman = "0"; break;
							case 'txtcabang':txtcabang.text = "0"; break;
						}
				}
			}
			
// pengosongan textinput ketika pencarian tidak ditemukan ================================
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcustomer1':p.F_KosongkanText([txtcustomer1]);customer1 = '';break;
//					case 'txtcustomer2':p.F_KosongkanText([txtcustomer2]);customer2 = '';break;
					case 'txtlokasi':p.F_KosongkanText([txtlokasi]);break;
					case 'txtuser':p.F_KosongkanText([txtuser]);inputuser = '';break;
					case 'txtsalesman':p.F_KosongkanText([txtsalesman]);salesman = '';break;
					case 'txtcabang':p.F_KosongkanText([txtcabang]);break;
					case 'txtuang':p.F_KosongkanText([txtuang]);break;
				}
			}
			
// pengisian filter untuk report =========================================================
			public function f_filterdata():String{
				var f:String="";
				f = FlexGlobals.topLevelApplication.F_standartFilter();
				if(txtcustomer1.text!='')
					f = p.TambahFilter(f,'socustomer ='+customer1+'');
				if(txtsalesman.text!='')
					f = p.TambahFilter(f,'sobagianpenjualan ='+salesman);
				if(txtuser.text!='')
					f = p.TambahFilter(f,'soinputuser ='+inputuser);
				if(txtuang.text!='')
					f = p.TambahFilter(f,'somatauang ="'+txtuang.text+'"');
				if(txtuang.text!='')
					f = p.TambahFilter(f,'somatauang ="'+txtuang.text+'"');
				if(dttglkirim1.text != '' && dttglkirim2.text != '')
					f = p.TambahFilter(f, 'sotglkirim BETWEEN "'+p.F_tglFormatDB(dttglkirim1.text)+'" AND "'+p.F_tglFormatDB(dttglkirim2.text)+'"'); 
				else if(dttglkirim1.text != '') 
					f = p.TambahFilter(f, 'sotglkirim >= "'+p.F_tglFormatDB(dttglkirim1.text)+'"'); 
				else if(dttglkirim2.text != '')
					f = p.TambahFilter(f, 'sotglkirim <= "'+p.F_tglFormatDB(dttglkirim2.text)+'"'); 
				
				return f;
			}
			
