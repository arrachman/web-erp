				o.percentWidth = 100;
				o.height = 200;
				return o;
			}
			public function create(boxjudul:HBox, boxcontent:HBox):void{
				kotakgrafik.addElement(boxjudul);
				kotakgrafik.validateNow();
				kotakgrafik.addElement(boxcontent);
				kotakgrafik.validateNow();
			}
			
			public function paketcontent(cc:String):ColumnChart
			{
				o[cc+"c"] = new CategoryAxis;
				o[cc+"c"].categoryField = "bulan";
				
				function f(element:ChartItem, index:Number):IFill{
					var c:SolidColor = new SolidColor(0x008000);
					if(dg1.dataProvider[cc.split("crt")[1]]['kpiperiode'] == "Y"){
						switch(o['arr'+cc.split("crt")[1]].getItemAt(index)['warna']){
							case 'red':c.color = 0xFF0000;break;	
							case 'yellow':c.color = 0xa5bc4e;break;	
							case 'green':c.color = 0xe90b07;break;	
							default:c.color = 0x1b95d9;break;
						} 
						
					}else
					switch(o['arr'+cc.split("crt")[1]].getItemAt(7+index)['warna']){
						case 'red':c.color = 0xFF0000;break;	
						case 'yellow':c.color = 0xFF9900;break;	
						case 'green':c.color = 0x008000;break;	
						default:c.color = 0x000000;break;
					} 
					return c; 
				}
				var a:ColumnSeries;
				o[cc+"cs"] = new ColumnSeries;
				o[cc+"cs"].xField = "bulan";
				o[cc+"cs"].yField = "val";
				o[cc+"cs"].fillFunction = f;
				o[cc+"cs"].addEventListener(MouseEvent.CLICK, function():void
				{
					bukaform(code[cc.split("crt")[1]], o[cc])
				});
				
				o[cc] = new ColumnChart;
				o[cc].id = cc;
				o[cc].percentWidth = 50;
				o[cc].height = 200;
				o[cc].setStyle("color", "0x323232")
				o[cc].showDataTips = true;
				o[cc].selectionMode = "single";
				o[cc].horizontalAxis = o[cc+"c"];
				o[cc].series = [o[cc+"cs"]];
				return o[cc];
			}
			
			public function paketjudul(label:String, img:String):Group
			{ 
				// - Membuat Group 
				var g:Group = new Group;
				g.percentWidth = 50;
				var ge:GradientEntry = new GradientEntry;
				ge.color = 0xADEFFF;
				var ge2:GradientEntry = new GradientEntry;
				ge2.color = 0x81CBED;
				var lg:LinearGradient = new LinearGradient;
				lg.x = 43;
				lg.y = 0;
				lg.scaleX = 20;
				lg.rotation = 90;
				lg.entries = [ge, ge2];
				var r:Rect = new Rect;
				r.left=0;
				r.right=0;
				r.top=0;
				r.bottom=0;
				r.fill = lg;
				g.addElement(r);
				g.validateNow();
				
				ge = new GradientEntry;
				ge.color = 0xffffff;
				ge.ratio = 0;
				ge.alpha = 0.55;
				ge2 = new GradientEntry;
				ge2.color = 0xffffff;
				ge2.ratio = 0;
				ge2.alpha = 0.15;
				lg = new LinearGradient;
				lg.x = 43;
				lg.y = 0;
				lg.scaleX = 20;
				lg.rotation = 90;
				lg.entries = [ge, ge2];
				
				var p:Path = new Path;
				p.left = 0;
				p.right = 0;
				p.data = "M 0 0 L 84 0 L 84 15 C 84 15 44 5 0 15 C 0 15 0 0 0 0 Z";
				p.fill = lg;
				g.addElement(p);
				g.validateNow();
				
				o[label] = new Label;
				o[label].id = label;
				o[label].y = 10;
				o[label].left = 42;
				o[label].setStyle("fontWeight", "bold");
				g.addElement(o[label]);
				g.validateNow();
				
				var i:Image = new Image;
				i.y = 5;
				i.left = 10;
				i.width = 25;
				i.height = 20;
				i.source = tbchartbar;
				g.addElement(i);
				g.validateNow();
				
				o[img] = new Image;
				o[img].id = img;
				o[img].y = 2;
				o[img].right = 10;
				o[img].height = 26;
				o[img].verticalAlign = "middle";
				o[img].source = tbup;
				o[img].useHandCursor = true;
				o[img].buttonMode = true;
				o[img].mouseChildren = true;
				o[img].addEventListener(flash.events.MouseEvent.CLICK, function():void{imgclick(o['arr'+label.split("lbl")[1]], code[label.split("lbl")[1]], o[label])});
				g.addElement(o[img]);
				g.validateNow();
				return g;
			}
			
			public function M8_KPIGetData():void{
				if(cmbtahun.selectedIndex >= 0 && cmbbulan.selectedIndex >= 0)
					FlexGlobals.topLevelApplication.F_wsSimpan("getData", "M8_KPISearch", 0, 0, cmbtahun.textInput.text+"-"+cmbbulan.selectedItem.v+"-01", "", 0, 0, "kpimodule = 5 AND kpiaktif = 1");
				else
					Alert.show("Pilih tahun dan bulan dulu", "Informasi");
			}
			
			public function imgclick(arr:ArrayCollection, kode:String, lbl:Object):void{
				if(lbl.id == "lblmax"){
					kotakmax.visible = false;
					kotakgrafik.visible = true;
					return;
				}
				o["crtmaxcs"].fillFunction = fmax;
				function fmax(element:ChartItem, index:Number):IFill{
					var c:SolidColor = new SolidColor(0x008000);
					switch(arr.getItemAt(index)['warna']){
						case 'red':c.color = 0xFF0000;break;	
						case 'yellow':c.color = 0xFF9900;break;	
						case 'green':c.color = 0x008000;break;	
						default:c.color = 0x000000;break;
					} 
					return c; 
				}
				kotakmax.visible = true;
				kotakgrafik.visible = false;
				o['lblmax'].text = lbl.text;
				o['crtmax'].dataProvider = new ArrayCollection(arr.toArray().slice(0, 12));
			}
			public var tahunkmrn:int, tahunskrng:int, bulanskrng:int;
