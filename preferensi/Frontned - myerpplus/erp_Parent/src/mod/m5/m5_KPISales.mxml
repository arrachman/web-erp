			public function f_wsHasil():void
			{
				var i:int, j:int, y:int, ob:Object = parentApplication.wsArrUtama;
				switch(parentApplication.subject){
					case 'getData':
						if(!parentApplication.wsSuccess){
							Alert.show(parentApplication.wsErrmessage, "Informasi")
							return;
						}
						thnfilter = int(cmbtahun.textInput.text);
						blnfilter = (cmbbulan.selectedIndex+1);
						dg1.dataProvider = parentApplication.wsArrUtama;
						for(i=0;i<dg1.dataProviderLength;i++){
							dg1.dataProvider[i]['kpicurrent'] = parentApplication.m.nfNominal.format(dg1.dataProvider[i]['kpicurrent']);
							dg1.dataProvider[i]['kpiprevious'] = parentApplication.m.nfNominal.format(dg1.dataProvider[i]['kpiprevious']);
							dg1.dataProvider[i]['kpicurrent_right'] = true;
							dg1.dataProvider[i]['kpiprevious_right'] = true;
						}
						FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
						if(lblinfo.text != "Please Wait\nRendering Form : 100%"){
							i=0;
							n=parentApplication.wsArrUtama.length; 
							tmr.repeatCount = n;
							lblinfo.text = "Please Wait\nRendering Form : 0%";
							grpBusy.visible = true;
							parentApplication.m.tmrBusy.reset();
							parentApplication.m.tmrBusy.start();
							buat();
						}else{
							isigrafik(code);
						}
						break;
					case 'c-M8_KPIGetData':
						var ctahun:String = cmbtahun.textInput.text;
						if(ctahun == '')ctahun == parentApplication.DefaultTanggalforDB.split('-')[0];
						tahunkmrn = (int(ctahun)-1); tahunskrng = int(ctahun); bulanskrng = cmbbulan.selectedIndex+1;
						dg1.dataProvider = new ArrayCollection(parentApplication.ob_resultWs.KpiList.toArray()); 
						parentApplication.subject = "c-M8_KpiGetDataAll";
						var f:String = "tahun BETWEEN "+tahunkmrn+" AND "+tahunskrng;
						break;
				}
				
				function isigrafik(cod:Array):void{
					var d:Array, l:Array;
					ob = parentApplication.wsArrUtama;
					isibulanx(ob.length, (cmbbulan.selectedIndex+1));
					for(i=0;i<ob.length;i++){
						o['lbl'+i].text = ob[i].kpinama; 
						cod[i] = ob[i].kpikode;
						o["img"+i].source = tbup;
						d = ob[i].kpidetail.split("|");
						if(d.length > 1) 
							for(j=0;j<d.length;j++){
								l = d[j].split('~'); 
								var n:int = getItemIndexByProperty(o['arr'+i], 'idx', String(l[1]-1));
								o['arr'+i].getItemAt(n)['val'] = parentApplication.m.nfNominal.format(l[2]).split(",").join(".");
								o['arr'+i].getItemAt(n)['warna'] = l[3];
								o['arr'+i].setItemAt(o['arr'+i].getItemAt(n), n);
							}
						if(parentApplication.wsArrUtama[i].kpiperiode == "Y")
							o['crt'+i].dataProvider = new ArrayCollection(o['arr'+i].toArray()['slice'](0, 3));
						else
							o['crt'+i].dataProvider = new ArrayCollection(o['arr'+i].toArray()['slice'](7, 12));
					}
					
					
				}
				
				function isibulanx(len:int, filterbulan:int):void{
					for(i=0;i<len;i++){
						o['arr'+i] = new ArrayCollection;
						if(parentApplication.wsArrUtama[i].kpiperiode == "Y"){
							for(j=2;j>=0;j--)
								o['arr'+i].addItem({bulan:int(thnfilter-j), idx:int(thnfilter-j), data:0});
						}else
							for(j=filterbulan;j<(filterbulan+12);j++){
								if(j>11)
									o['arr'+i].addItem({bulan:bulan[j-12]+" "+cmbtahun.textInput.text, idx:(j-12), val:0});
								else
									o['arr'+i].addItem({bulan:bulan[j]+" "+(int(cmbtahun.textInput.text)-1), idx:j, val:0});
							}
					}
				}
			}
			
