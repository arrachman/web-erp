				cmbbulan.dataProvider = new ArrayCollection(arrbulan.toArray());
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbtahun, cmbbulan]);
				cmbtahun.selectedIndex = getItemIndexByProperty(arrtahun, 'l', parentApplication.DefaultTanggalforDB.split('-')[0]);
				cmbbulan.selectedIndex = int(parentApplication.DefaultTanggalforDB.split('-')[1])-1;
				tbngrafik.selected = true;
				tbntabel.selected = false;
				kotakmax.visible = false;
				tbngrafik.addEventListener(flash.events.MouseEvent.CLICK, function():void{
					tbngrafik.selected = true;
					tbntabel.selected = false;
					grpgrafik.visible = true;
					dg1.visible = false;
				});
				tbntabel.addEventListener(flash.events.MouseEvent.CLICK, function():void{
					tbngrafik.selected = false;
					tbntabel.selected = true;
					grpgrafik.visible = false;
					dg1.visible = true;
				});
				btntampilkan.addEventListener(flash.events.MouseEvent.CLICK, function():void{
					M8_KPIGetData();
					
					if(o.bmax){
						o.bmax = false;
						o['boxjudulmax'] = boxjudul();
						o['boxcontentmax'] = boxcontent();
						o['boxcontentmax'].height = undefined;
						o['boxcontentmax'].percentHeight = 100;
						
						o.o = paketjudul('lblmax', 'imgmax');
						o.o.percentWidth = 100;
						o.o.height = 50;
						o['boxjudulmax'].addElement(o.o);
						o.o = paketcontent('crtmax');
						o.o.percentWidth = 100;
						o.o.percentHeight = 100;
						o.o.height = undefined;
						o['boxcontentmax'].addElement(o.o);
						o['imgmax'].source = tbdown;
						kotakmax.addElement(o['boxjudulmax']);
						kotakmax.addElement(o['boxcontentmax']);
					}
