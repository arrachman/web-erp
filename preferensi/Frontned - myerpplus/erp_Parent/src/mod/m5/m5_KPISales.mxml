				btncetak.addEventListener(flash.events.MouseEvent.CLICK, function():void{
					exporto = 'pdf';
					//					M0_UserreportSearch();
				});
				FlexGlobals.topLevelApplication.F_RegGrid(5, 49, [dg1]);
				this.callLater(dg1config);
				function dg1config():void
				{
					dg1.selectionMode = "singleCell";
				}
			}
			public function add():void
			{ 
				d += 90/(n-1);
				lblinfo.text = "Please Wait\nRendering Form : "+(d+10).toString().split(".")[0]+"%";
				if((i+1) == n){
					lblinfo.text = "Please Wait\nRendering Form : 100%";
					grpBusy.visible = false;
					parentApplication.m.tmrBusy.stop();
					parentApplication.grpBusy.visible = false;
					M8_KPIGetData();
					return; 
				}  
				if(i%2 == 0){
					create(o['boxjudul'+i], o['boxcontent'+i]);
					parentApplication.validateNow();
				}
				i++;
			}
			
			public function buat():void
			{
				if(n == i){
					i=0;
					d=0;
					lblinfo.text = "Please Wait\nRendering Form : 10%";
					tmr.addEventListener(TimerEvent.TIMER, function():void{
						d += 90/(n-1);
						lblinfo.text = "Please Wait\nRendering Form : "+(d+10).toString().split(".")[0]+"%";
						if((i+1) == n){
							lblinfo.text = "Please Wait\nRendering Form : 100%";
							grpBusy.visible = false;
							parentApplication.m.tmrBusy.stop();
							parentApplication.grpBusy.visible = false;
							M8_KPIGetData();
							return; 
						}  
						if(i%2 == 0){
							create(o['boxjudul'+i], o['boxcontent'+i]);
							parentApplication.validateNow();
						}
						i++;
					});
					tmr.start();
					return; 
				} 
				if(i%2 == 0){
					o.i = i;
					o['boxjudul'+o.i] = boxjudul();
					o['boxcontent'+o.i] = boxcontent();
					parentApplication.validateNow();
				} 
				o['boxjudul'+o.i].addElement(paketjudul('lbl'+i, 'img'+i));
				o['boxjudul'+o.i].validateNow();
				o['boxcontent'+o.i].addElement(paketcontent('crt'+i));
				o['boxcontent'+o.i].validateNow();
				i++;
				buat();
			}
			
			public function boxjudul():HBox
			{
