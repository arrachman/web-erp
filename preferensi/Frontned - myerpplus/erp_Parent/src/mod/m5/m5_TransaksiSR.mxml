				public function f_hitungGrid():void{
					var dgrid:Object;
					for(i = 0; i<dg.dataProviderLength; i++){
						dgrid = dg.dataProvider[i]
						dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
						dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
//						dgrid.jmlpajak1 = (Number(dgrid.nilaipajak1)/100) * dgrid.subtotal;
//						dgrid.jmlpajak2 = (Number(dgrid.nilaipajak2)/100) * dgrid.subtotal;
						dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					}
					f_hitungTotalDetail();
					f_hitungTotalUtama();
				}
				
