				public function f_grid(dg:DataGrid, column:String):void
				{ 
					o.a = column.split('|');
					if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 2){
						if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
						else o.d = dg.dataProvider.getItemAt(o.a[1]);
						o.o.nilaisatuan = 0;
						o.o.nilaipajak1 = 0;
						o.o.nilaipajak2 = 0;
						return
					}
					if(column == 'add'){
					}else if(column == 'del'){
						
					}else{
						with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
							switch(column){
								case 'jml':
									customdbl1 = (Number(jml) *  Number(nilaisatuan))/ Number(nilaisatuanlapangan);
//									customdbl1 = Number(jml) / Number(nilaisatuanlapangan);
								case 'harga':
								case 'pajak1':
								case 'pajak2':
									jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
//									jmlbarang = jml * nilaisatuan;
									jmlbarang = Number(jml) * Number(nilaisatuan);
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
									jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
									parentApplication.F_hargaTotal(dg);
									break;
//								case 'customdbl1':
//									jml = Number(customdbl1) * Number(nilaisatuanlapangan);
//									jmlbarang = Number(jml) * Number(nilaisatuan);
//									break;
//								case 'customdbl1':
//									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//									jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
//									jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
//									jml = Number(customdbl1) * Number(nilaisatuanlapangan);
//									jmlbarang = Number(jml) * Number(nilaisatuan);
//									FlexGlobals.topLevelApplication.F_hargaTotal(dg);
//									break;
								case 'customdbl1':
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
									jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
									//								jml = Number(customdbl1) * Number(nilaisatuanlapangan);
									//								jmlbarang = Number(jml) * Number(nilaisatuan);
									jml = (Number(nilaisatuanlapangan) / Number(nilaisatuan)) * Number(customdbl1)
									jmlbarang = Number(jml) * Number(nilaisatuan);
									parentApplication.F_hargaTotal(dg);
									FlexGlobals.topLevelApplication.F_hargaTotal(dg);
									break;
								case 'diskon':
									jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
									jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
									parentApplication.F_hargaTotal(dg);
									break;
								case 'jmldiskon':
									pesanAlert = ''; pesanAlertIng = ''; validasi = true;
									dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
									if(dgrid1.jml == 0 || dgrid1.harga == 0){
										if(dgrid1.jml == 0)FlexGlobals.topLevelApplication.msgAlert(dg, 'Jumlah barang');
										if(dgrid1.harga == 0)FlexGlobals.topLevelApplication.msgAlert(dg, "Harga");
										if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert','');
										dgrid1.jmldiskon = 0;
										dgrid1.diskon= 0;
									}else{
										diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
										subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
//										jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
//										jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
										jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak1, subtotal, nilaipajak1, nilaipajak2);
										jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, nilaipajak2, subtotal, nilaipajak1, nilaipajak2);
									}
									break;
								case 'pre_del':
									hapusserial();
									hapusbatch();
									break;
								case 'subtotal':
									hargaDariSubtotal.hitungHargaDariSubtotal(dg);
									break;
							}
						}
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
					f_hitungTotalDetail()
				}
				
				//hapus serial jika barangnya tidak ada
				public function hapusserial():void{
					var s:int;
					if(ac_Serial.length > 0){
						for(s=ac_Serial.length-1; s>=0; s--){
							if(ac_Serial[s].nstidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
								ac_Serial.removeItemAt(s);
							}
						}
					}
				}
				
				public function hapusbatch():void{
					var b:int;
					
					if(ac_Batch.length > 0){
						for(b=ac_Batch.length-1; b>=0; b--){
							if(ac_Batch[b].nbtidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
								ac_Batch.removeItemAt(b);
							}
						}
					}
				}
