				public function f_kosongkanText(target:String):void
				{
					switch(target){
						case 'txtcustomer':parentApplication.F_KosongkanText([txtcustomer, lblcustomer]);break;
						case 'txtsalesman':parentApplication.F_KosongkanText([txtsalesman, lblsalesman]);break;
						case 'txtgudang':parentApplication.F_KosongkanText([txtgudang,lblgudang]);break;
						case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang, txtkurs]);break;
						case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
						case 'txttermin':parentApplication.F_KosongkanText([txttermin,lbltermin]);dttgljt.text = txttanggal.text;break;
						case 'txtbagpengiriman':parentApplication.F_KosongkanText([txtbagpengiriman,lblbagpengiriman]);break;
						case 'txtcatatan':parentApplication.F_KosongkanText([txtcatatan]);break;
						case 'txtexpedisi':parentApplication.F_KosongkanText([txtexpedisi]);break;
						case 'chk_HK':dg.dataProvider[parentApplication.rowIndex].hk = 0;break;
					}
				}
				
