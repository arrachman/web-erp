					function f_getRNR():void{
						if(txtcustomer.text.length <= 0 || txtmatauang.text.length <= 0){
							pesanAlert = ''; pesanAlertIng = ''; validasi = true;
							if(txtcustomer.text.length <=0 || txtmatauang.text.length <= 0){
								if(txtcustomer.text.length <=0)FlexGlobals.topLevelApplication.msgAlert(txtcustomer,'Customer');
								if(txtmatauang.text.length <=0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang, "Uang");
								if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert','');
							}
						}else{
							parentApplication.F_popUpCari('AmbilRnr');
						}
					}
					function f_getSI():void{
						if(txtcustomer.text.length <= 0 || txtmatauang.text.length <= 0){
							pesanAlert = ''; pesanAlertIng = ''; validasi = true;
							if(txtcustomer.text.length <=0 || txtmatauang.text.length <= 0){
