				public function  msgAlert(focus: Object, inggris: String, indonesia: String):void
				{ 
					if(validasi == true)focus.setFocus();
					pesanAlertIng += inggris+', ';
					pesanAlert += indonesia+', ';
					if(focus == 'clear'){
						pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
						pesanAlert += " harus diisi dengan benar";
						pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
						pesanAlertIng += " must be filled";
						Alert.show(pesanAlertIng+"  ("+pesanAlert+") " , "Information");}	
					validasi = false; 
				}
				
				public function f_hitungTotalDetail():void
				{
					n.vtotal=0;
					n.vtotalpajak1=0;
					n.vtotalpajak2=0;
					for(var i:int=0;i<dg.dataProvider.length;i++){
						if(dg.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg.dataProvider.getItemAt(i).subtotal);
						if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)n.vtotalpajak1 += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
						if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
					}
					lbltotal.text = parentApplication.m.nfNominal.format(n.vtotal);
					lblpajak1.text = parentApplication.m.nfNominal.format(n.vtotalpajak1);
					lblpajak2.text = parentApplication.m.nfNominal.format(n.vtotalpajak2);
					
					o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
					txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
					o.txtbiayalainnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtbiayalainpersen);
					txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
					
					f_hitungTotalUtama();
				}
				
				public function f_hitungTotalUtama():void
				{
					if(chkhargapajak.selected == false){
						n.vtotaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak1) + Number(n.vtotalpajak2) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
					}else{
						n.vtotaltransaksi = (Number(n.vtotal) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
					}
					
					
					lbltotaltransaksi.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
				}
				
				public function f_defaultGrid():void
				{
					parentApplication.rowIndex = 0;
					dg.dataProvider.removeAll();
					parentApplication.F_acAdd(dg);
					dg.setSelectedCell(0, 1);
					f_focusOnMe();
				}
				
				protected function f_chkAuto():void
				{
					if(FlexGlobals.topLevelApplication.FormFilter != ''){
						if(chkauto.selected == true){
							txtnotransaksi.enabled = false;
							txtnotransaksi.text = getNotransaksi;
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = getNotransaksi;
							txtnotransaksi.setFocus();
						}
					}else{
						if(chkauto.selected == true){
							txtnotransaksi.enabled = false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							txtnotransaksi.setFocus();
						}
					}
				}
				
				public function hitungtglJatuhTempo():void
				{
					u.getItemAt(0).srtgljatuhtempo = parentApplication.F_tglJatuhTempo(txttanggal.text, tgljatuhtempo);
				}
				
