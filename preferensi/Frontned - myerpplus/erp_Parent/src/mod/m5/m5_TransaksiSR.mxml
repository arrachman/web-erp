				public function f_validasi():void{
					//set getdata by id===============================================================================================
					var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
					var idtransaksi : String = filtersplit[0];
					if(FlexGlobals.topLevelApplication.FormFilter == ''){
						//input
						f_kondisiAwal();
					}else{
						if(filtersplit[1] == 'history'){
							//history
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_SrHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else {
							//edit
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_SrGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
					//end of set getdata by id===============================================================================================
				}
