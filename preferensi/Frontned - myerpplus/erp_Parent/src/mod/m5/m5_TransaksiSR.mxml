				public var indexjenis :int
				protected function cmbjenis_changeHandler(event:IndexChangeEvent):void
				{
					// TODO Auto-generated method stub
					if(cmbjenis.selectedIndex == 0){
						tbintang.visible = false;
						txtmatauang.enabled = true;
					}else{
						tbintang.visible = true;
						txtmatauang.enabled = false;
					}
					
					
				}
				
				protected function cmbjenis_closeHandler(event:DropDownEvent):void
				{
					// TODO Auto-generated method stub
					if(dg.dataProviderLength >= 1 && dg.dataProvider[0].kodebarang != ""){
						Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{	
							if(e.detail == Alert.YES){
								
								
								u.getItemAt(0).sridsi = 0;
								FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
								o.txtdiskonpersen = 0;
								o.txtbiayalainpersen = 0;
								txtdiskonpersen.text = parentApplication.m.nfNominal.format(o.txtdiskonpersen.toString());
								txtbiayalainpersen.text = parentApplication.m.nfNominal.format(o.txtbiayalainpersen.toString());
								
								f_hitungGrid();
								
								o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
								txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
								
								o.txtbiayalainnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtbiayalainpersen);
								txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
								
								txtnoSI.text = "";
								f_hitungTotalUtama();
							}else{
								cmbjenis.selectedIndex = indexjenis;
							}
						});
					}
				}
				
				protected function chkhargapajak_changeHandler(event:Event):void
				{
					// TODO Auto-generated method stub
					for(var Index:int = 0; Index<dg.dataProviderLength; Index++){
						var dgrid:Object;
						dgrid = dg.dataProvider[Index];
						if(chkhargapajak.selected == true){
							dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
							dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						}else{
							dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
							dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						}
						
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
					f_hitungTotalDetail();
					
				}
			]]>
