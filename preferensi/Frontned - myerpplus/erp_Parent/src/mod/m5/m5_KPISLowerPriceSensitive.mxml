<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  creationComplete="script();f_Load(event)"
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%">
	<fx:Script source="script.as"/>
	<fx:Script>
		<![CDATA[
			[Bindable] [Embed(source="assets/tb/show.png")]  public var tbshow:Class;
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			protected function f_Load(event:FlexEvent):void
			{
				wstampil();
				btntampilkan.addEventListener(flash.events.MouseEvent.CLICK, function():void{wstampil()});
				btnhitung.addEventListener(flash.events.MouseEvent.CLICK, function():void{wshitung()});
			}
			
			public function f_wsHasil():void
			{
				ob = parentApplication.wsArrUtama;
				switch(parentApplication.subject){
					case "hitung":
						arrdg.removeAll();
						if (parentApplication.wsSuccess){
							arrdg.addItem({variable:"Penjualan Normal",value:f_FormatUang(ob[0].lpspenjualannormal)});
							arrdg.addItem({variable:"Total Penjualan",value:f_FormatUang(ob[0].lpstotalpenjualan)});
							arrdg.addItem({variable:"Hasil",value:f_FormatUang(ob[0].lpshasil)});
							arrdg.addItem({variable:"Update Terakhir",value:ob[0].lpsinputtgl});	
							arrdg.addItem({variable:"User",value:ob[0].unama});
							dg.dataProvider = new ArrayCollection(arrdg.toArray());
						}else{
							dg.dataProvider = null;
						}
						break;
					case "c-wshitung":
						if(parentApplication.ob_resultWs.success==true)
							wstampil();
						else{
							dg.dataProvider = null;
							Alert.show(ob.errmessage, 'Konfirmasi');
						}
						break;
				}
			}
				
			public function wstampil():void{
				wshitung()
			}
			
			public function wshitung():void{
				FlexGlobals.topLevelApplication.F_wsSimpan("hitung", "M8_LowerPriceSensitive", parentApplication.userid, undefined, cmbtahun.selectedItem.l+FlexGlobals.topLevelApplication.sptField+(cmbbulan.selectedIndex+1));
			}
			
			protected function dg_clickHandler(event:MouseEvent):void
			{
//				var tgl1:String, tgl2:String; 
//				if(dg.selectedCell.columnIndex == 1)
//					if(dg.selectedCell.rowIndex == 2)
//						parentApplication.openFormX("Penjualan Normal", 0, "mod/m0/m0_DataKPI.swf", 100, 100, "t1",'V_M5_IvPenjualanNormalSearch|'+cmbtahun.textInput.text+'|'+(cmbbulan.selectedIndex+1)+'|AND harga>=hargapricelist',1);
//					else if(dg.selectedCell.rowIndex == 3){
//						parentApplication.openFormX("Total Penjualan", 0, "mod/m0/m0_DataKPI.swf", 100, 100, "t1",'V_M5_IvPenjualanNormalSearch|'+cmbtahun.textInput.text+'|'+(cmbbulan.selectedIndex+1)+'|',1);
//					}
			}
		]]>
	</fx:Script>
	<mx:VDividedBox width="100%" height="100%">
		<s:Group width="100%" height="45">
			<s:Label x="10" y="19" text="Tahun"/>
			<s:ComboBox id="cmbtahun" x="51" y="12" width="90"/>
			<s:Label x="150" y="19" text="Bulan"/>
			<s:ComboBox id="cmbbulan" x="191" y="12" width="90"/>
			<s:Button id="btntampilkan" x="422" y="10" width="115" height="25" label="Tampilkan" icon="{tbshow}" visible="false"/>
			<s:Button id="btnhitung" x="296" y="10" width="115" height="25" label="Tampilkan" icon="{tbshow}"/>
		</s:Group>
		<s:DataGrid id="dg" width="100%" height="100%" click="dg_clickHandler(event)" selectionMode="singleCell">
			<s:columns>
				<s:ArrayList>
					<s:GridColumn headerText="Variable" dataField="variable" width="200"/>
					<s:GridColumn headerText="Value" dataField="value">
						<s:itemRenderer>
							<fx:Component>
								<s:GridItemRenderer>
									<fx:Script>
										<![CDATA[
											protected function label1_renderHandler(event:Event):void
											{
												if(data.variable == 'Penjualan Normal' || data.variable == 'Total Penjualan'){
													lbllink.visible = true;
													lbllink2.visible = false
												}else{
													lbllink.visible = false;
													lbllink2.visible = true;
												}
											}
										]]>
									</fx:Script>
									<s:Label id="lbllink" text="{data.value}" paddingTop="10" paddingLeft="10" color='#009ad4' rollOver="setStyle('textDecoration','underline')" render="label1_renderHandler(event)" rollOut="setStyle('textDecoration','none')" useHandCursor="true" buttonMode="true" mouseChildren="false"/>
									<s:Label id="lbllink2" text="{data.value}" paddingTop="10" paddingLeft="10"/>
								</s:GridItemRenderer>
							</fx:Component>
						</s:itemRenderer>
					</s:GridColumn>
				</s:ArrayList>
			</s:columns>
		</s:DataGrid>
		<s:Image height="160" source="assets/kpi/m5/lowerpricesensitive.png"/>
	</mx:VDividedBox>
</s:Module>
