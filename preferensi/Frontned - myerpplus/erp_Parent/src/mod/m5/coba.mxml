			public function f_wsHasil():void
			{
				if (dg1.dataProvider != null && parentApplication.rowIndex < dg1.dataProviderLength)
					var ob : Object = dg1.dataProvider[parentApplication.rowIndex];
				var s:String = parentApplication.subject, sort:String='';
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtcustomer':
							o.cekid = false;
							for(i = 0; i<dg1.dataProviderLength; i++){
								if((dg1.dataProvider[i].iddodetail > 0 && dg1.dataProvider[i].iddodetail != undefined) || (dg1.dataProvider[i].iddrdetail > 0 && dg1.dataProvider[i].iddrdetail != undefined)){
									o.cekid = true; 
								}
							}
							
							if(o.cekid == true && o.customerkode != obj.kkode){
								
								Alert.show('Data akan dihapus, lanjutkan ?', 'Confirmation', 3, null, function(e:Object):void{ 
									if(e.detail == Alert.YES){
										txtcustomer.text = obj.kkode;
