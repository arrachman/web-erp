				}
			}
			
			public function f_filtersb():void{
				fserial = 's'; fbatch = 'b';
				for(i=0; i<dg1.dataProviderLength; i++){
					if(dg1.dataProvider[i].bserial ==	1){
						if(fserial == 's'){
							fserial = '(nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangtujuan+'")';
						}else{
							fserial += ' or (nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangtujuan+'")';
						}
					}
					
					if(dg1.dataProvider[i].bbatch ==	1){
						if(fbatch == 'b'){
							fbatch = '(nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangtujuan+'")';
						}else{
							fbatch += ' or (nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangtujuan+'")';
						}
					}
				}
			}
			
