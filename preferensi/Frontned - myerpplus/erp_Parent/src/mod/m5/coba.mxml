										txtgudang.text, nbtidbatchin];
									if(batch == ''){batch = FlexGlobals.topLevelApplication.F_splitArrayToString(a);}
									else {batch += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);}
								}
							}
						}
						//set serial
						if(acserialdetail.length <= 0){
							serial = '';
						}else{
							for(i=0;i<acserialdetail.length; i++){
								with(acserialdetail.getItemAt(i)){
									a = [nstid, nstjenismutasi, nstidbarang, nstkode, nstsumber, nstidtransaksi, nstsatuan, 
										nstjml, nstcustomtext1, nstcustomtext2, nstcustomtext3, nstcustomdbl1, nstcustomdbl2, nstcustomdbl3, 
										parentApplication.F_tglFormatDB(nstcustomdate1), parentApplication.F_tglFormatDB(nstcustomdate2), 
										parentApplication.F_tglFormatDB(nstcustomdate3),
										txtgudang.text, nstidserialin];
									if(i == 0){serial = FlexGlobals.topLevelApplication.F_splitArrayToString(a);}
									else {serial += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);}
								}
							}
						}
						//						parentApplication.F_wsSimpan('simpan', "M5_SiSimpan", parentApplication.userid, isUpdate, utama, detail);	// kirim ketika simpan ke WS
						parentApplication.F_wsSimpan("simpan", "M5_SiSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+batch+"△"+serial);
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					vMsgIng = "";
					vMsg = "";
					o.serial = false; o.batch = false;
					for(i = 0; i<dg1.dataProviderLength; i++){
						if(dg1.dataProvider[i].bserial == 1 && acserialdetail.length <= 0){
							o.serial = true;
						}
						if(dg1.dataProvider[i].bbatch == 1 && acbatchdetail.length <= 0){
							o.batch = true;
						}
					}
					if(o.serial == true)msgAlert(dg1,'Serial Number','Serial Number');
					if(o.batch == true)msgAlert(dg1,'Batch Number','Batch Number');
					if(cmbasalbarang.selectedIndex < 0 || cmbasalbarang.textInput.text.length == 0)msgAlert(cmbasalbarang,'Item Origin','Asal Barang');
					if(cmbcarabayar.selectedIndex < 0 || cmbcarabayar.textInput.text.length == 0)msgAlert(cmbcarabayar,'Payment Method','Cara Bayar');
					if(txtcustomer.text.length == 0)msgAlert(txtcustomer,'Customer','Customer');
					if(txtsalesman.text.length == 0)msgAlert(txtsalesman,'Salesman','Salesman');
					if(dttanggal.text.length == 0)msgAlert(dttanggal,'Tanggal','Tanggal');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(txtmatauang.text.length == 0)msgAlert(txtmatauang,'Currency','Mata Uang');
					if(txtkurs.text.length == 0)msgAlert(txtkurs,'Rate','Kurs');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)msgAlert(cmbprogress,'Progress','Progress');
					if(dg1.dataProvider.getItemAt(0).idsqdetail == null )msgAlert(dg1,'Item Detail','Detail Item');
					if(vMsg != '')msgAlert('clear', '', '');
					else {
						for(var i:int=0;i<dg1.dataProvider.length;i++){
							if(dg1.dataProvider.getItemAt(i).hk == false && dg1.dataProvider.getItemAt(i).bhpp == 'I'){
								validasi = false;
								// Mencari kolom index field 'hk'
								for(var j:int=0;j<dg1.columnsLength;j++){
									if(dg1.columns.getItemAt(j).dataField == 'hk')
										break;
								}
								dg1.setFocus(); dg1.setSelectedCell(i, j);
								Alert.show('Special cogs must be checked (Hpp khusus harus tercentang)', 'Information');
								break;
							}
						}
					}
				}
			}
			
			public function msgAlert(focus: Object, inggris: String, indonesia: String):void
			{ 
				if(validasi == true)focus.setFocus();
				vMsgIng += inggris+', ';
				vMsg += indonesia+', ';
				if(focus == 'clear'){
					vMsg = vMsg.substr(0, vMsg.length-4);
					vMsg += " harus diisi dengan benar";
					vMsgIng = vMsgIng.substr(0, vMsgIng.length-4);
					vMsgIng += " must be filled";
					Alert.show(vMsgIng+"  ("+vMsg+")"  , "Information");} 
				validasi = false; 
			}
			
			public function f_hitungTotalDetail():void
			{
				n.vtotal=0;
				n.vtotalpajak1=0;
				n.vtotalpajak2=0;
				for(var i:int=0;i<dg1.dataProvider.length;i++){
					if(dg1.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg1.dataProvider.getItemAt(i).subtotal);
					if(dg1.dataProvider.getItemAt(i).jmlpajak1 != undefined)n.vtotalpajak1 += Number(dg1.dataProvider.getItemAt(i).jmlpajak1);
					if(dg1.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg1.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = parentApplication.m.nfNominal.format(n.vtotal);
				lblpajak1.text = parentApplication.m.nfNominal.format(n.vtotalpajak1);
				lblpajak2.text = parentApplication.m.nfNominal.format(n.vtotalpajak2);
				
				o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
				txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
				o.txtbiayalainnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtbiayalainpersen);
				txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
				
				
				f_hitungTotalUtama();
			}
			
			public function f_hitungTotalUtama():void
			{
				n.vtotaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak1) + Number(n.vtotalpajak2) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
				
				lbltotaltransaksi.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				parentApplication.F_acAdd(dg1);
				dg1.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
			public function hitungtglJatuhTempo():void
			{
				u.getItemAt(0).sitgljatuhtempo = parentApplication.F_tglJatuhTempo(dttanggal.text, tgljatuhtempo);
			}
			
