										txtalamatcustomer.text = obj.k1alamat1+'\n'+obj.k1alamat2;
										txtalamatkirim.text = obj.k2alamat1+'\n'+obj.k2alamat2;
										o.customerkode = obj.kkode;
										o.customer = obj.kid;
										o.customernama = obj.knama
										
										txtsalesman.text = obj.ksalesmankode;
										lblsalesman.text = obj.ksalesmannama;
										u.getItemAt(0).sibagianpenjualan = obj.ksalesman;
