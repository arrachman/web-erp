					o.rnrcustomtext4 = ''; o.rnrcustomtext5 = ''; o.rnrcustomint1 = 0; o.rnrcustomint2 = 0; o.rnrcustomint3 = 0; o.rnrcustomdbl1 = 0; o.rnrcustomdbl2 = 0; o.rnrcustomdbl3 = 0; 
