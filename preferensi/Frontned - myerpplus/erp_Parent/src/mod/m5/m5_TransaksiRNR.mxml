						wsfilter = "isclose = 0";
						break;
					case 'pajak1':
						paket = 'CdM1_Tax';
						wsfilter = "taktif=1 AND tkode ='"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pajak1+"'";
						csfilter = "taktif=1";
						csfield = 2;
						break;
					case 'pajak2':
						paket = 'CdM1_Tax';
						wsfilter = "taktif=1 AND tkode ='"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pajak2+"'";
						csfilter = "taktif=1";
						csfield = 2;
						break;
					case 'gudangasal':
						paket = 'CdM1_Warehouse';
						wsfilter = "waktif=1 AND wkode ='"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).gudangasal+"'";
						csfilter = "waktif=1";
