				FlexGlobals.topLevelApplication.F_txtpencarian([txtcustomer, txtmatauang,txtgudang,txttermin,txtsalesman,txtekspedisi]);
				parentApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,chkauto, txtkurs,txtnoref,chkposting]);
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Ambil SI", icon:"tbfind", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_AmbilSI);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLinks);
				
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled==true)
						var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(5,11,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Rnr');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
				}
				function f_AmbilSI():void{
					pesanAlert = '';
					if(txtmatauang.text.length > 0 && txtcustomer.text.length > 0){
						FlexGlobals.topLevelApplication.F_popUpCari("AmbilSI");
					}else{
						if(txtcustomer.text.length <= 0)parentApplication.msgAlert(txtcustomer, 'Customer', 'Customer');
						if(txtmatauang.text.length <= 0)parentApplication.msgAlert(txtgudang, 'Uang', 'Currency');
						if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
					}
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[4].enabled==true)FlexGlobals.topLevelApplication.F_OpenNotes(o.rnrsumber,o.rnrid,txtnotransaksi.text);
				}
				function f_mbUpload():void{
					if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('RNR', o.rnrid,txtnotransaksi.text);
				}
				function f_mbLinks():void{
					FlexGlobals.topLevelApplication.f_mbLinks(5, 'Rnr');
				}
				
