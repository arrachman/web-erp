			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcustomer':parentApplication.F_KosongkanText([txtcustomer, lblcustomer]);break;
					case 'txtsalesman':parentApplication.F_KosongkanText([txtsalesman, lblsalesman]);break;
					case 'txtgudang':parentApplication.F_KosongkanText([txtgudang, lblgudang]);break;
					case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang]);break;
					case 'txttermin':parentApplication.F_KosongkanText([txttermin]);break;
				}
			}
			
			
