					o.rnrtotaltransaksi = 0; o.rnrjmlbayar = 0; o.rnrstatuslunas = 0; o.rnrtgllunas = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.rnrsdhbayarpajak = 0; o.rnrtglbayarpajak = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.rnrrekdiskon = FlexGlobals.topLevelApplication.getSetting(0,'akun','DiskonPenjualan'); 
					o.rnrrekpajak1 = FlexGlobals.topLevelApplication.getSetting(0,'akun','DiskonPenjualan'); 
					o.rnrrekpajak2 = FlexGlobals.topLevelApplication.getSetting(0,'akun','DiskonPenjualan'); 
					o.rnrrekbiayalain = FlexGlobals.topLevelApplication.getSetting(0,'akun','DiskonPenjualan'); 
					o.rnrrekbayar = FlexGlobals.topLevelApplication.getSetting(0,'akun','DiskonPenjualan'); o.rnridsq = 0; o.rnridso = 0; 
					o.rnridpl = 0; o.rnriddo = 0; o.rnriddr = 0; o.rnridpi = 0; o.rnridsi = 0; o.rnrstatussr = 0; o.rnrstatussebelumnya = 0; 
					o.rnrjmlrevisi = 0; o.rnrcetakanke = 0; o.rnrinputuser = FlexGlobals.topLevelApplication.userid; 
