				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				FlexGlobals.topLevelApplication.F_RequiredLabel([tcustomer, tsalesman, tgudang, tnotransaksi, tuang, tprogress]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tcustomer, tsalesman, tgudang, turaian, tnotransaksi, tuang, tprogress, tkontakperson, talamatcustomer, talamatkontakperson
				,tekspedisi, tcatatan, ttanggalkirim, tnoref, ttanggalnoref, tnofakturpajak]);
				
				
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				cmbcarabayar.dataProvider = new ArrayCollection([{l:'Tunai', v:1}, {l:'Kredit', v: 2}]);
				cmbasalbarang.dataProvider = new ArrayCollection([{l:'Lokal', v:1}, {l:'Import', v: 2}]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttglnoref,dttglkirim]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
