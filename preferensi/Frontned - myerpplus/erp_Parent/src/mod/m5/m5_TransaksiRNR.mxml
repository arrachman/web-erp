						csfilter = "kaktif='1' and kkategori='M'";
						csfield = 2;
						break;
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						wsfilter = "eaktif=1 AND wkode='"+txtgudang.text+"'";
						csfilter = "eaktif=1";
						csfield = 2;
						break;
					case 'txtmatauang':
						paket = 'CdM1_Currency';
						wsfilter = "caktif=1 AND ckode = '"+txtmatauang.text+"'";
						csfilter = "caktif=1";
						break;
					case 'txttermin':
