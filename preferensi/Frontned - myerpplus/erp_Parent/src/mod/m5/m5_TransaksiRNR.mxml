						wsfilter = "taktif=1 AND tkode = '"+txttermin.text+"'";
						csfilter = "taktif=1";
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = "tnaktif=1 AND tnsumber='RNR'";
