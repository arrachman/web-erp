					//grid detail
//					case 'kodebarang':
//						paket = 'CdM1_Item';
//						wsfilter = "baktif=1 and bkode ='"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+"'";
//						csfilter = "baktif=1";
//						csfield = 2;
//						break;
