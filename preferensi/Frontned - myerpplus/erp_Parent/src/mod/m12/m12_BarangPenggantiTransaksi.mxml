			public function f_validasi():void{
				
				var jmlpengali:Number = FlexGlobals.topLevelApplication.m.ArrFilter[0];
				var ktingkatjual : String = FlexGlobals.topLevelApplication.m.ArrFilter[1];
				vIdbarang = FlexGlobals.topLevelApplication.m.ArrFilter[2];
				rowindex = FlexGlobals.topLevelApplication.m.ArrFilter[3];
//				p.F_insertDG(p.dg_pos, rowindex, []);
				dg_bpengganti.dataProvider.removeAll();
				for(var c:int=0; c < FlexGlobals.topLevelApplication.m.ArrPos_Substitution_Item_DetailSetting.length; c++){
					with(FlexGlobals.topLevelApplication.m.ArrPos_Substitution_Item_DetailSetting[c]){
						if(siid == FlexGlobals.topLevelApplication.FormFilter){
							dg_bpengganti.dataProvider.addItem({
								chk:0,
								kodebarang:bkode,
								tipebarang: btipe,
								namabarang: bnama,
								kategoribarang:bkategori,
								stok : bstok,
								jml: Number(jmlpengali) * Number(jml),
								satuan: bsatuan,
								hk: false,
								harga: 0,
								diskon: 0,
								jmldiskon: 0,
								subtotal: 0, //hitung
								pajak1: '',
								pajak2: '',
								gudangasal: FlexGlobals.topLevelApplication.ugudang,
								donotransaksi: '',
								catatan: '',
								costcenter: '',
								divisi: '',
								subdivisi: '',
								proyek: '',
								idsidetail: 0,
								idsi: 0,
								idbarang: bid,
								nilaisatuan: bnilaisatuan,
								jmlbarang: jmlpengali * jml, //hitung
								satuanbarang: bsatuan,
								matauang: parentApplication.getSetting(0, 'accounting', 'MataUangFungsional'),
								kurs: parentApplication.getSetting(0, 'accounting', 'Kurs'),
								idhppkhususmasuk: 0,
								idhppfifomasuk: 0,
								hargapricelist: bhargajual1,
								hpp: bhppaverage,
								jmlpajak1: 0, //hitung
								jmlpajak2: 0, //hitung
								cabang: parentApplication.ucabang,
								lokasi: parentApplication.ulokasi,
								gudangtransit: parentApplication.getSetting(3, 'defaultgudang', 'GudangTransit'),
								gudangtujuan: FlexGlobals.topLevelApplication.ugudang,
								rekpersediaan: brekpersediaan,
								rekhargapokok: brekhargapokok,
								rekdiskonpenjualan: brekdiskonpenjualan,
								rekpenjualan: brekpenjualan,
								idsqdetail: 0,
								idsodetail: 0,
								idpldetail: 0,
								iddodetail: 0,
								iddrdetail: 0,
								idpidetail: 0,
								jmlrnr: 0,
								statusrnr: 0,
								jmlsr: 0,
								statussr: 0,
								isclose: 0,
								customtext1: '',
								customtext2: '',
								customtext3: '',
								customdbl1: 0,
								customdbl2: 0,
								customdbl3: 0,
								customdate1: parentApplication.m.DateFirst,
								customdate2: parentApplication.m.DateFirst,
								customdate3: parentApplication.m.DateFirst,
								bhpp: bhpp,
								bserial: bserial,
								bbatch: bbatch,
								nilaipajak1: 0,
								nilaipajak2: 0,
								isbonus: 0,
								isbonusfrom : 0,
								ispenggantifrom : vIdbarang,
								bhargajual1:bhargajual1, 
								bhargajual2:bhargajual2, 
								bhargajual3:bhargajual3, 
								bhargajual4:bhargajual4, 
								bhargajual5:bhargajual5, 
								bdiskonjual1:bdiskonjual1, 
								bdiskonjual2:bdiskonjual2, 
								bdiskonjual3:bdiskonjual3,
								bdiskonjual4:bdiskonjual4, 
								bdiskonjual5:bdiskonjual5})
							
						}
					}
				}
				
				for(var i:int = 0; i<dg_bpengganti.dataProviderLength; i++){
					
					switch (ktingkatjual){
						case "1":
							dg_bpengganti.dataProvider[i].harga = dg_bpengganti.dataProvider[i].bhargajual1;
							dg_bpengganti.dataProvider[i].diskon = dg_bpengganti.dataProvider[i].bdiskonjual1;
							break;
						case "2":
							dg_bpengganti.dataProvider[i].harga = dg_bpengganti.dataProvider[i].bhargajual2;
							dg_bpengganti.dataProvider[i].diskon = dg_bpengganti.dataProvider[i].bdiskonjual2;
							break;
						case "3":
							dg_bpengganti.dataProvider[i].harga = dg_bpengganti.dataProvider[i].bhargajual3;
							dg_bpengganti.dataProvider[i].diskon = dg_bpengganti.dataProvider[i].bdiskonjual3;
							break;
						case "4":
							dg_bpengganti.dataProvider[i].harga = dg_bpengganti.dataProvider[i].bhargajual4;
							dg_bpengganti.dataProvider[i].diskon = dg_bpengganti.dataProvider[i].bdiskonjual4;
							break;
						case "5":
							dg_bpengganti.dataProvider[i].harga = dg_bpengganti.dataProvider[i].bhargajual5;
							dg_bpengganti.dataProvider[i].diskon = dg_bpengganti.dataProvider[i].bdiskonjual5;
							break;
					}
					dg_bpengganti.dataProvider[i].jmldiskon = (Number(dg_bpengganti.dataProvider[i].diskon)/100)*Number(dg_bpengganti.dataProvider[i].harga);
					dg_bpengganti.dataProvider[i].subtotal = Number(dg_bpengganti.dataProvider[i].jml) * Number(dg_bpengganti.dataProvider[i].harga) - Number(dg_bpengganti.dataProvider[i].jmldiskon); //hitung
				}
				dg_bpengganti.setFocus();
				dg_bpengganti.setSelectedCell(0, 0);
				
			}
