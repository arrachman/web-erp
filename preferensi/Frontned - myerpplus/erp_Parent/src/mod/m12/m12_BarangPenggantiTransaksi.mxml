			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(p.dg_pos);
						FlexGlobals.topLevelApplication.F_acAdd(p.dg_pos);
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBoxHeader':
						for (i=0; i<dg_bpengganti.dataProviderLength; i++){
							dg_bpengganti.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case 'checkBox':
						dg_bpengganti.dataProvider.getItemAt(dg_bpengganti.selectedCell.rowIndex).chk = data;
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg_bpengganti);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case 'jumlah':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) /o.txtkurs;
								
							}else{
								jumlahvalas = 0;
								
							}
						}
						
						break;
					case 'jumlahvalas':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
								
							}else{
								jumlahvalas = 0;
								
							}
						}
						break
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
