<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				if(parentApplication.m[parentApplication.idmodcurr].child.hasOwnProperty('dg'))
					dg = parentApplication.m[parentApplication.idmodcurr].child.dg;
				else
					dg = parentApplication.m[parentApplication.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tkategori, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama, tkategori]);
				parentApplication.F_txtInOut(txtkode,'','M12_AreaCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_txtpencarian([txtkategori]);
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				
				if(parentApplication.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].akode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].anama;
					txtkategori.text = dg.dataProvider[dg.selectedCell.rowIndex].akategori;
					lblkategori.text = dg.dataProvider[dg.selectedCell.rowIndex].acnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].acatatan;
					vUserIdEdit = parentApplication.userid;
					o.acustomtext1 = dg.dataProvider[dg.selectedCell.rowIndex].acustomtext1; 
					o.acustomtext2 = dg.dataProvider[dg.selectedCell.rowIndex].acustomtext2;
					o.acustomtext3 = dg.dataProvider[dg.selectedCell.rowIndex].acustomtext3;
					o.acustomtext4 = dg.dataProvider[dg.selectedCell.rowIndex].acustomtext4;
					o.acustomtext5 = dg.dataProvider[dg.selectedCell.rowIndex].acustomtext5;
					o.acustomint1 = dg.dataProvider[dg.selectedCell.rowIndex].acustomint1;
					o.acustomint2 = dg.dataProvider[dg.selectedCell.rowIndex].acustomint2;
					o.acustomint3 = dg.dataProvider[dg.selectedCell.rowIndex].acustomint3;
					o.acustomdbl1 = dg.dataProvider[dg.selectedCell.rowIndex].acustomdbl1;
					o.acustomdbl2 = dg.dataProvider[dg.selectedCell.rowIndex].acustomdbl2;
					o.acustomdbl3 = dg.dataProvider[dg.selectedCell.rowIndex].acustomdbl3;
					o.acustomdate1 = dg.dataProvider[dg.selectedCell.rowIndex].acustomdate1;
					o.acustomdate2 = dg.dataProvider[dg.selectedCell.rowIndex].acustomdate2;
					o.acustomdate3 = dg.dataProvider[dg.selectedCell.rowIndex].acustomdate3;
					if (dg.dataProvider[dg.selectedCell.rowIndex].caktif=="0")
					{
						chkaktif.selected = false;
					}else{
						chkaktif.selected = true;
					}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama, txtkategori, txtcatatan, lblkategori]);
				o.acustomtext1 = ''; o.acustomtext2 = ''; o.acustomtext3 = ''; o.acustomtext4 = ''; o.acustomtext5 = '';
				o.acustomint1 = 0; o.acustomint2 = 0; o.acustomint3 = 0;
				o.acustomdbl1 = 0; o.acustomdbl2 = 0; o.acustomdbl3 = 0; 
				o.acustomdate1 = parentApplication.m.DateFirst; o.acustomdate2 = parentApplication.m.DateFirst; o.acustomdate3 = parentApplication.m.DateFirst;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kategori', e:'Category'}, {t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					arr = [txtkategori.text, txtkode.text, txtnama.text, txtcatatan.text, int(chkaktif.selected), vUserId, vDefDt, vUserIdEdit, vDefDt,
							String(o.acustomtext1), String(o.acustomtext2), String(o.acustomtext3), String(o.acustomtext4), String(o.acustomtext5),
							int(o.acustomint1), int(o.acustomint2), int(o.acustomint3), 
							Number(o.acustomdbl1), Number(o.acustomdbl2), Number(o.acustomdbl3),
							parentApplication.F_tglFormatDB(o.acustomdate1), parentApplication.F_tglFormatDB(o.acustomdate2), parentApplication.F_tglFormatDB(o.acustomdate3)];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M12_AreaSimpan', utama, 'akode')
					vUserIdEdit = 0;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategori':
						paket = 'CdM12_Area_Category';
						csfilter = 'acaktif = 1';
						wsfilter = 'acaktif = 1 and ackode = "'+txtkategori.text.split('"').join('\\"')+'"';
						sort = 'ackode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtkategori':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtkategori.text = o.ackode;
							lblkategori.text = o.acnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtkategori': txtkategori.text = ''; lblkategori.text = ''; break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkategori':parentApplication.F_KosongkanText([txtkategori, lblkategori]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" right="1" top="-1" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkategori" left="10" top="87" text="Kategori"/>	
	<s:Label id="lblkategori" left="202" top="84"/>
	<s:Label id="tkode" left="10" top="42" text="Kode"/>
	<s:Label id="tnama" left="10" top="64" text="Nama"/>
	<s:Label id="tcatatan" left="10" top="109" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="70" width="272" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58" height="22" maxChars="100"/>
	<s:TextInput id="txtkategori" top="79" left="70" width="100" maxChars="25"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="100" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="346" y="38" label="Aktif" selected="true"/>
</s:Module>
