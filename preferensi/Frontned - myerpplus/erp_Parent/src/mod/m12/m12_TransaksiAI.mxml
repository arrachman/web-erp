							//							Alert.show(arr2.nogrup);
							
							//							acAdditional.addItem({idadditional: arr2.idadditional, 
							//								idbi: arr2.idbi, 
							//								idbidetail: arr2.idbidetail, 
							//								kodebarang2: arr2.kodebarang2, 
							//								namabarang: arr2.namabarang, 
							//								idbarang: arr2.idbarang, 
							//								jml: arr2.jml, 
