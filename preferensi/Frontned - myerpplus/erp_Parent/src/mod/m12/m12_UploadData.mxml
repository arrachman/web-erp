					FlexGlobals.topLevelApplication.f_setVariableWS();
					//					parentApplication.subject = "Upload";
					if(FlexGlobals.topLevelApplication.wsSuccess == true){
						if(FlexGlobals.topLevelApplication.subject == "simpan"){
							f_Uploaded();
						}else if(FlexGlobals.topLevelApplication.subject == "hapus"){
							FlexGlobals.topLevelApplication.F_wsSearch("GetId", "M5_SiGetUpload", 0,0,"siuploaded = 0 AND sistatus = 2 ", "siid ASC");
						}
						
					}else{
