				try
				{
					// Set okLabel jadi Reload
					//					Alert.okLabel = parentApplication.l('Load Ulang');
					
					BtnLogin.enabled = false;
					status.source = red;
					statusnama.text = "Failed to connect"
					// Muncul Konfirmasi Alert Saat Web Service mengalami error atau gangguan
					Alert.show(parentApplication.l('MyERP Plus tidak terkoneksi dengan server !'), parentApplication.l('Konfirmasi'), 4, null);
					
					// Set default okLabel jadi Ok
					//					Alert.okLabel = 'Ok'; 	
				} 
				catch(error:Error) 
				{
					Alert.show(error.getStackTrace(), parentApplication.l('Informasi'));
				}
				
			}
			
			// Fungsi load myWs
			public function F_wsOperation_load(event:LoadEvent):void
			{
				try
				{
					BtnLogin.enabled = true;
					status.source = grn;
					statusnama.text = "Connected";
					// Inisialisasi parent
					//					f_persiapanInduk();
				} 
				catch(error:Error) 
				{
					Alert.show(error.getStackTrace(), parentApplication.l('Informasi'));
				}
			}
			
			// Fungsi invoke myWs
			public function F_wsOperation_invoke(event:InvokeEvent):void
			{
				try
				{
				} 
				catch(error:Error) 
				{
					Alert.show(error.getStackTrace(), parentApplication.l('Informasi'));
				}
			}
			
			
			
			public function f_sendProgress(data:String, status:Boolean):void
			{
				j++;
				if(status == true){
					if(j > jmlProgress){
						close = true;
						return;
					}
					lblProses.text = data;
				}else{
					lblProses.text = parentApplication.l("Upload failed")+" "+data;
					close = true;
					return;
				}
				num += 100/jmlProgress;
				pb.setProgress(num, 100);
				lblPersen.text = String(uint(num))+" %";
			}
		]]>
