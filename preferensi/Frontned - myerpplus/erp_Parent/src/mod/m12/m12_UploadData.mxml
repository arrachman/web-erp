			public var vUrlWS:String, myWs:WebService;
			public function f_ConnectWS():void
			{
				if(BtnLogin0.enabled)
				{
					vUrlWS = parentApplication.getSetting(0, 'company', 'UrlWS');
					myWs = new WebService;
					myWs.addEventListener(ResultEvent.RESULT, F_wsOperation_result);
					myWs.addEventListener(FaultEvent.FAULT, F_wsOperation_fault);
					myWs.addEventListener(LoadEvent.LOAD, F_wsOperation_load);
					myWs.addEventListener(InvokeEvent.INVOKE, F_wsOperation_invoke);
					myWs.wsdl = vUrlWS+"/ws/myerpplus.asmx?wsdl";
					myWs.showBusyCursor = true;
					myWs.loadWSDL();
					status.source = yellow;
					statusnama.text = "Authenticating...";
					
				}
			}
			
