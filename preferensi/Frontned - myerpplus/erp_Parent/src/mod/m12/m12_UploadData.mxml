				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					switch(s){
						case 'GetId':
							jmlProgress = FlexGlobals.topLevelApplication.wsArrUtama.length;
							jmldata = 0;
							//tmr = new Timer(1000, FlexGlobals.topLevelApplication.wsArrUtama.length);
							idsi = FlexGlobals.topLevelApplication.wsArrUtama;
							//tmr.start();
							
							f_getdata();
							break;
						case "GetData":
							validasi = true;
							u = FlexGlobals.topLevelApplication.wsArrUtama;
							arrdetail = FlexGlobals.topLevelApplication.wsArrDetail;
							arrpay = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[4], FlexGlobals.topLevelApplication.vData[4]);
							
							f_simpan();
							break;
						case 'simpan':
							//							3602b0e7c2ee4eab6c473e9fcce80b20★M5_SiUploaded★0△0△△△dd/MM/yyyy△dd/MM/yyyy H:mm:ss★3★0★1△
							f_Uploaded();
							//							FlexGlobals.topLevelApplication.F_wsUpdateStatus("Uploaded", 'M5_SiUploaded', FlexGlobals.topLevelApplication.userid, idsi[jmldata].siid, '', false, 0, 0);
							break;
						case "Uploaded":
							jmldata++;
							jmlberhasil++;
							if(jmlProgress > jmldata){
								f_getdata();
							}else{
								Alert.show("Upload data selesai : \n "+jmlberhasil+" berhasil \n "+jmlgagal+" gagal", "Informasi");
								f_sendProgress('Upload Done', true);
								lblProses.text = "Upload Done";
								lblPersen.text = "100 %"
								BtnLogin.enabled = true;
								BtnLogin0.enabled = true;
							}
							break;
					}
				}else{					
					switch(parentApplication.subject){
						
						
						case 'GetId':
						case "GetData":
						case "Uploaded":
							Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, "Informasi");
							BtnLogin.enabled = true;
							BtnLogin0.enabled = true;
							break;
						case 'simpan':
							
							Alert.show(""+FlexGlobals.topLevelApplication.wsErrmessage+". Klik OK untuk melanjutkan proses Upload Data", "Informasi", 0, null, function(e:Object):void{		
								jmldata++;
								jmlgagal++;
								Alert.show(jmldata+" - "+jmlgagal);
								if(jmlProgress > jmldata){
									f_getdata();
								}else{
									Alert.show("Upload data selesai : \n "+jmlberhasil+" berhasil \n "+jmlgagal+" gagal", "Informasi");
									f_sendProgress('Upload Done', true);
									lblProses.text = "Upload Done";
									lblPersen.text = "100 %"
									BtnLogin.enabled = true;
									BtnLogin0.enabled = true;
								}
							});
							break;
					}
				}
			}
			
