								FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							}else if(tab.selectedIndex == 1){
								FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.dg2.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
								FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.dg2.setSelectedCell(0,0);
								FlexGlobals.topLevelApplication.rowIndex = 0;
								FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							}
							FlexGlobals.topLevelApplication.closeFormPopUp(1);
							
							
							break;
						
						
						
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
							case 'tampilBarang':
								FlexGlobals.topLevelApplication.F_defaultGridItem(dgbarang);
								break;
							case 'simpan':
								if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.tab.selectedIndex == 0){
