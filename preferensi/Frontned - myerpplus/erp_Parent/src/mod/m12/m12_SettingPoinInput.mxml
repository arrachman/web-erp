			public function f_validasi():void{
				f_focusOnMe();
				if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.tab.selectedIndex == 0){
					if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.hasOwnProperty('dg'))
						dg = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.dg;
				}else{
					if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.hasOwnProperty('dg2'))
						dg2 = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.dg2;
				}
				
				
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.tab.selectedIndex == 0){
						
						txtkategoripos.text = dg.dataProvider[dg.selectedCell.rowIndex].pikategori;
						FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
						lblkategoripos.text = dg.dataProvider[dg.selectedCell.rowIndex].pcnama;
						
						txtkodebarang.text = dg.dataProvider[dg.selectedCell.rowIndex].bkode;
						lblkodebarang.text = dg.dataProvider[dg.selectedCell.rowIndex].bnama;
						o.piidbarang = dg.dataProvider[dg.selectedCell.rowIndex].piidbarang;
						o.id = o.piidbarang;
						isUpdate = true;
						FlexGlobals.topLevelApplication.F_wsSearch("tampilBarang","M12_Pos_Point_ItemSearch",0,0,"pikategori = '"+txtkategoripos.text+"' AND piidbarang = "+o.piidbarang+"","bkode asc, pioperator asc, pijml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
					}else{
						f_kondisiAwal();
					}
					
					
				}
			}
			protected function f_kondisiAwal():void
			{
				
				isUpdate = false;
				txtkategoripos.setFocus();
				txtkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.txtkategoripos.text;
				FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
				if(txtkategoripos.text.length > 0){
					
					FlexGlobals.topLevelApplication.F_wsGetDataById('jenispoin', 'M12_Pos_Category_SettingGetdataById', txtkategoripos.text, 0, 0, 'smodule = 0 and sgrup = "app" AND skode="Point"', 'surutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
				}
				f_setdefaultdata();
				f_setdtbarang();
				lblkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.lblkategoripos.text;
				//set utama
				o.piidbarang = 0;
				o.id = o.piidbarang;
				tabtotal.enabled = false;
				tabbarang.enabled = false;
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid:Object
				switch (components){
					case  'calculator':
						dgbarang.dataProvider[dgbarang.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dgbarang, dgbarang.selectedCell.rowIndex);
						if(Number(data) > 0){
							
						}
						break;
					case 'comboBox':
						if(dataField == "pioperator"){
							if(data !=0){
								dgbarang.dataProvider[dgbarang.selectedCell.rowIndex].pijml2 = 0;
							}
							
						}
						if(dataField == "ptoperator"){
							if(data !=0){
								dgtotal.dataProvider[dgtotal.selectedCell.rowIndex].ptjml2 = 0;
							}
							
						}
						//Alert.show(dgtotal.dataProvider[dgtotal.selectedCell.rowIndex].ptoperator);
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'pioperator'){
							return new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
						}
						if(dataField == 'ptoperator'){
							return new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
						}
				}
				return new ArrayCollection([]);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if(column == 'add' || o.a[0] == 'add'){
					if(tab.selectedIndex == 1){
						f_setdefaultdata();
					}else if(tab.selectedIndex == 0){
						f_setdtbarang()
					}
				}
				switch(column){
					
					case 'pijml2':
						with(dgbarang.dataProvider.getItemAt(dgbarang.selectedCell.rowIndex)){
							if(pioperator != 0){
								pijml2 = 0;
							}
						}
						FlexGlobals.topLevelApplication.F_dgRefresh(dgbarang);
						break;
					
					case 'ptjml2':
						with(dgtotal.dataProvider.getItemAt(dgtotal.selectedCell.rowIndex)){
							if(ptoperator != 0){
								ptjml2 = 0;
							}
						}
						FlexGlobals.topLevelApplication.F_dgRefresh(dgtotal);
						break;
					
				}
				
				
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos': //kategoripos
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
						csfilter = 'pcaktif=1';
						sort = 'pckode asc';
						break;
					
					case 'txtkodebarang': //kode barang
						if(txtkategoripos.text.length > 0){
							FlexGlobals.topLevelApplication.kategoriPOS = txtkategoripos.text;
							paket = 'CdM12_ItemCategoryPOS';
							wsfilter = 'baktif=1 and bkode ="'+txtkodebarang.text+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}else{
							Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
						}
						break;
					
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'txtkategoripos':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkategoripos.text = ws.pckode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
							lblkategoripos.text = ws.pcnama;
							FlexGlobals.topLevelApplication.F_wsGetDataById('jenispoin', 'M12_Pos_Category_SettingGetdataById', txtkategoripos.text, 0, 0, 'smodule = 0 and sgrup = "app" AND skode="Point"', 'surutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							break;
						case 'jenispoin':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							cmbjenispoin.selectedIndex = ws.pcsnilai;
							f_changetab()
							break;
						case 'txtkodebarang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkodebarang.text = ws.bkode;
							lblkodebarang.text = ws.bnama;
							o.piidbarang = ws.bid;
//							if(o.id != 0){
//								Alert.show('Data akan dihapus, lanjutkan?', 'Confirmation', 3, null, function(e:Object):void{	
//									if(e.detail == Alert.YES){
//										FlexGlobals.topLevelApplication.F_wsSearch("tampilBarang","M12_Pos_Point_ItemSearch",0,0,"pikategori = '"+txtkategoripos.text+"' AND piidbarang = "+o.piidbarang+"","",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
//									}
//								});
//							}
							FlexGlobals.topLevelApplication.F_wsSearch("tampilBarang","M12_Pos_Point_ItemSearch",0,0,"pikategori = '"+txtkategoripos.text+"' AND piidbarang = "+o.piidbarang+"","bkode asc, pioperator asc, pijml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
							
							o.id = o.piidbarang;
							break;
						case 'tampilBarang':
							dgbarang.dataProvider.removeAll();
							for(i = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(i)){
									dgbarang.dataProvider.addItem({no:i+1,
										pikategori:pikategori, piidbarang:piidbarang, pioperator:pioperator, 
										pijml1:pijml1, pijml2:pijml2, pijmlpoint:pijmlpoint, picustomtext1:picustomtext1, 
										picustomtext2:picustomtext2, picustomtext3:picustomtext3, picustomtext4:picustomtext4, 
										picustomtext5:picustomtext5, picustomint1:picustomint1, picustomint2:picustomint2, picustomint3:picustomint3, 
										picustomdbl1:picustomdbl1, picustomdbl2:picustomdbl2, picustomdbl3:picustomdbl3, 
										picustomdate1:picustomdate1, picustomdate2:picustomdate2, picustomdate3:picustomdate3});
								}
							}
							FlexGlobals.topLevelApplication.F_wsGetDataById('jenispoin', 'M12_Pos_Category_SettingGetdataById', txtkategoripos.text, 0, 0, 'smodule = 0 and sgrup = "app" AND skode="Point"', 'surutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							break;
						case "tampilTotal":
							f_focusOnMe();
							isUpdate = true;
							dgtotal.dataProvider.removeAll();
							for(i = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(i)){
									dgtotal.dataProvider.addItem({no:i+1,
										ptkategori:ptkategori, ptoperator:ptoperator, ptjml1:ptjml1, ptjml2:ptjml2, ptjmlpoint:ptjmlpoint, 
										ptcustomtext1:ptcustomtext1, ptcustomtext2:ptcustomtext2, 
										ptcustomtext3:ptcustomtext3, ptcustomtext4:ptcustomtext4, ptcustomtext5:ptcustomtext5, 
										ptcustomint1:ptcustomint1, ptcustomint2:ptcustomint2, ptcustomint3:ptcustomint3, ptcustomdbl1:ptcustomdbl1, 
										ptcustomdbl2:ptcustomdbl2, ptcustomdbl3:ptcustomdbl3, ptcustomdate1:ptcustomdate1, 
										ptcustomdate2:ptcustomdate2, ptcustomdate3:ptcustomdate3});
								}
							}
							
							break;
						case 'simpan':
							if(tab.selectedIndex == 0){
								FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.dg.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
								FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.dg.setSelectedCell(0,0);
