						// Set Utama
						// Set Detail
						if(tab.selectedIndex == 0){
							for(i=0;i<dgbarang.dataProviderLength;i++){
								with(dgbarang.dataProvider.getItemAt(i)){
									a = [txtkategoripos.text, o.piidbarang, pioperator, pijml1, pijml2, pijmlpoint, picustomtext1, 
										picustomtext2, picustomtext3, picustomtext4, picustomtext5, picustomint1, picustomint2, picustomint3, 
										picustomdbl1, picustomdbl2, picustomdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate3),
										FlexGlobals.topLevelApplication.F_tglFormatDB(pitgl1),
										FlexGlobals.topLevelApplication.F_tglFormatDB(pitgl2)];
									if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							}
							
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_Pos_Point_ItemSimpan", parentApplication.userid, isUpdate, detail, "",1,20,p.f_filterdata(),p.arr[1]);
							
						}else{
							for(i=0;i<dgtotal.dataProviderLength;i++){
								with(dgtotal.dataProvider.getItemAt(i)){
									a = [txtkategoripos.text, ptoperator, ptjml1, ptjml2, ptjmlpoint, ptcustomtext1, ptcustomtext2, 
										ptcustomtext3, ptcustomtext4, ptcustomtext5, ptcustomint1, ptcustomint2, ptcustomint3, ptcustomdbl1, 
										ptcustomdbl2, ptcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(ptcustomdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(ptcustomdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(ptcustomdate3),
										FlexGlobals.topLevelApplication.F_tglFormatDB(pttgl1),
										FlexGlobals.topLevelApplication.F_tglFormatDB(pttgl2)];
									if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							}
							
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_Pos_Point_TransactionSimpan", parentApplication.userid, isUpdate, detail, "",1,20,p.f_filterdata(),p.arr[1]);
							
						}
						
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = ""; 
					pesanAlertIng = '';
					//FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgbarang);
					if(txtkategoripos.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkategoripos, 'Kategori POS');
					if(tab.selectedIndex == 0){
						if(txtkodebarang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkodebarang, 'Kode Barang');
						for(i=0; i<dgbarang.dataProviderLength; i++){
							if(dgbarang.dataProvider.getItemAt(i).pijml1 == 0)FlexGlobals.topLevelApplication.msgAlert(dgbarang,'Jml 1');
						}
					}
					else{
						for(i=0; i<dgtotal.dataProviderLength; i++){
							if(dgtotal.dataProvider.getItemAt(i).ptjml1 == 0)FlexGlobals.topLevelApplication.msgAlert(dgbarang,'Jml 1');
						}
					}
//					for(i=0; i<dgbarang.dataProviderLength; i++){
//						if(dgbarang.dataProvider.getItemAt(i).dijml1 == 0)FlexGlobals.topLevelApplication.msgAlert(dgbarang,'Jml 1');
//					}
					
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
					f_hitungTotal();
					
					
				}
			}
			
