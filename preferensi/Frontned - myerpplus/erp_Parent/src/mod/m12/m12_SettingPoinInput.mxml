									}
								}
								
								
								break;
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkategoripos':parentApplication.F_KosongkanText([txtkategoripos, lblkategoripos]);break;
					case 'txtkodebarang':
						parentApplication.F_KosongkanText([txtkodebarang, lblkodebarang]);
						o.id = 0;
						break;
					case 'tampilBarang':
						FlexGlobals.topLevelApplication.F_defaultGridItem(dgbarang)
						break;
				}
			}
			public function f_changetab():void{
				switch (cmbjenispoin.selectedIndex){
					case 0:
						tabtotal.enabled = false;
						tabbarang.enabled = false;
						break;
					case 1:
						tab.selectedIndex = 0;
						tabbarang.enabled = true;
						tabtotal.enabled = false;
						break;
					case 2:
						tab.selectedIndex = 1;
						tabtotal.enabled = true;
						tabbarang.enabled = false;
						FlexGlobals.topLevelApplication.F_wsSearch("tampilTotal","M12_Pos_Point_TransactionSearch",0,0,"ptkategori = '"+txtkategoripos.text+"'","ptoperator asc, ptjml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
						break;
				}
			}
			protected function f_simpan():void
