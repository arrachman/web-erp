<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.CheckBox;
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String,pesanAlertIng:String, c:CheckBox,UFungsional:String, img:Image, i:int, isUpdate:Boolean;
			public var o:Object = {},no:int;
			[Bindable] public var ac2:ArrayCollection = new ArrayCollection();
			public var vIdkontak:int, arrColumn:Array = new Array;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction, getNotransaksi:String;
			public function f_focusOnMe():void
			{
				txtnogiro1.setFocus();
			}
			
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBoxHeader':
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case 'checkBox':
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
			protected function f_persiapan():void
			{
				tab.focusEnabled = false;
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RequiredLabel([ttanggal, tnotransaksi, tprogress]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnogiro, ttanggaljt, tbank, tkontak, takun, tstatus, turaian, ttanggal, tnotransaksi, tprogress, tcatatan])
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttgllJT,dttgllJT2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress,cmbstatus]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtmatauang, txtakun, txtbank, txtkontak]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,txtnogiro1,txtnogiro2,chkauto,chkposting]);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLink);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(2,10,jenissimpan)==true){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void{FlexGlobals.topLevelApplication.f_bukaTransaksi("Sg");}
				function f_mbReset():void{
					mb.menuBarItems[4].enabled = false;
					mb.menuBarItems[5].enabled = false;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					cmbstatus.selectedIndex = 0;
					f_kondisiAwal(); 
				}
				function f_mbTampilkan():void{
					
					if(cmbstatus.selectedIndex < 0){
						Alert.show(FlexGlobals.topLevelApplication.l('Status harus dipilih terlebih dahulu !'),FlexGlobals.topLevelApplication.l('Informasi'));
					}else{
						f_wsTampil();
					}
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[4].enabled==true){
						FlexGlobals.topLevelApplication.F_OpenNotes(o.sgsumber,o.sgid,txtnotransaksi.text);
					}
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[5].enabled==true){
						FlexGlobals.topLevelApplication.F_OpenUploadFile('SG', o.sgid,txtnotransaksi.text);
					}
					
				}
				function f_mbLink():void {
					if(mb.menuBarItems[6].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(2,'Sg');
				}
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				txtnogiro1.addEventListener(FocusEvent.FOCUS_OUT, function setfokus():void{
					txtnogiro2.text = txtnogiro1.text;
				});
				dttgllJT2.addEventListener(FocusEvent.FOCUS_IN, function setdate():void{
					dttgllJT2.text = dttgllJT.text;
				});
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
						if(event.keyCode == Keyboard.ENTER){
							dg.setFocus();
							dg.setSelectedCell(0,0);
						}
					}
				);
				
				FlexGlobals.topLevelApplication.F_RegGrid(2,10,[dg],'transaksi');
				f_validasi();
				
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
					FlexGlobals.topLevelApplication.F_wsSearch('status',"CdM0_Status_Giro",0,0,'kode <> 1');
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M2_SgHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M2_SgGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled=true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				cmbprogress.selectedIndex = 1;
				txtnotransaksi.text = 'Auto';
				FlexGlobals.topLevelApplication.FormFilter = '';
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalvalas],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				isUpdate = false;
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("SG");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("SG",1);
				parentApplication.F_SetNilaiText([dttgl], parentApplication.DefaultTanggal);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtakun,txtbank,txtkontak,txtnogiro1,txtnogiro2,dttgllJT,dttgllJT2, lblakun, lblbank, lblkontak])
				o.sgid=0; o.sgcabang=FlexGlobals.topLevelApplication.ucabang; o.sglokasi=FlexGlobals.topLevelApplication.ulokasi; 
				o.sgsumber='SG';o.sgkodepa=0; o.sgkontak=1; o.sgkontakperson=''; 
				o.sgjumlah=0; o.sgjumlahvalas=0; o.sgstatussgc=0; o.sgstatussebelumnya=0; o.sgjmlrevisi=0; o.sgcetakanke=0; 
				o.sgisclose=0; o.sginputuser=FlexGlobals.topLevelApplication.userid; o.sginputtgl=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.sgmodifikasiuser=0; o.sgmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal; o.sgcustomtext1=''; 
				o.sgcustomtext2=''; o.sgcustomtext3=''; o.sgcustomtext4='';o. sgcustomtext5=''; o.sgcustomint1=0; o.sgcustomint2=0; o.sgcustomint3=0; 
				o.sgcustomdbl1=0; o.sgcustomdbl2=0; o.sgcustomdbl3=0; o.sgcustomdate1=FlexGlobals.topLevelApplication.m.DateFirst; 
				o.sgcustomdate2= FlexGlobals.topLevelApplication.m.DateFirst; o.sgcustomdate3=FlexGlobals.topLevelApplication.m.DateFirst;
				
				f_focusOnMe();
				
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			
			protected function f_wsTampil(page:int = 0, sort:String = 'gltgljthtempo asc, glbank asc, glnogiro asc'):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("tampilGiro", "M2_Giro_ListSearch", page, 0, f_filterdata(), sort);
			}
			
			public function f_filterdata():String{
				var f:String="gljenis=1";
				
				if(dttgllJT.text.length > 0 && dttgllJT2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT.text.split('"').join('\\"'))+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT2.text.split('"').join('\\"'))+'"');
				}else if(dttgllJT.text.length > 0 && dttgllJT2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT.text.split('"').join('\\"'))+'"');
				}else if(dttgllJT.text.length <= 0 && dttgllJT2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'gltgljthtempo <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgllJT2.text.split('"').join('\\"'))+'"');
				}
				
				if(txtnogiro1.text.length > 0 && txtnogiro2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro Between "'+txtnogiro1.text.split('"').join('\\"')+'" and "'+txtnogiro2.text.split('"').join('\\"')+'"');
				}else if(txtnogiro1.text.length > 0 && txtnogiro2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro >= "'+txtnogiro1.text.split('"').join('\\"')+'"');
				}else if(txtnogiro1.text.length <= 0 && txtnogiro2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro <= "'+txtnogiro2.text.split('"').join('\\"')+'"');
				}
				
				if(txtbank.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glbank ="'+txtbank.text.split('"').join('\\"')+'"');
				}
				if(txtakun.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glrekbank ="'+txtakun.text.split('"').join('\\"')+'"');
				}
				if(txtkontak.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glkontak ="'+vIdkontak+'"');
				}
				if(cmbstatus.selectedIndex >= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'glstatus ="'+cmbstatus.selectedItem.kode+'"');
				}
				for(i=0; i<dg.dataProviderLength; i++){
					if(dg.dataProvider[i].chk == 1){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro <>"'+dg.dataProvider.getItemAt(i).nogiro.split('"').join('\\"')+'"'); 
					}
				}
				
				return f;
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(2,10,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case 'chk':
						f_hitungTotal();
						break;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'noakun': //no rek
						paket = 'CdM1_Coa';
						wsfilter = 'cgd ="D" AND caktif = 1 AND ctipe = 1 AND cnomor = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).noakun+'"';
						csfilter = 'cgd ="D" AND caktif = 1 AND ctipe = 1';
						sort = 'cnomor asc';
						break;
					case 'bank': //no rek
						paket = 'CdM1_Bank';
						wsfilter = 'baktif=1 AND bkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).bank+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber="SG"';
						sort = 'tndcatatan asc';
						break;
					case 'txtbank':
						paket = 'CdM1_Bank';
						wsfilter = 'baktif=1 AND bkode = "'+txtbank.text+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break
					case 'txtkontak':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif=1 AND kkode = "'+txtkontak.text+'"';
						csfilter = 'kaktif=1';
						sort = 'kkode asc';
						break; 
					case 'txtakun':
						paket = 'CdM1_Coa';
						wsfilter = '(cgd ="D" AND caktif = 1) and cnomor = "'+txtakun.text+'" and ctipe = 1';
						csfilter = 'cgd ="D" AND caktif = 1 and ctipe = 1';
						sort = 'cnomor asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber="SG"';
						sort = 'tndsumber asc';
						break;
					case 'txtmatauang':
						txtkurs.text = "          ";
						paket = 'CdM1_Currency';
						wsfilter = 'caktif=1 AND ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = "tnaktif=1 AND tnsumber='SG'";
						csfield = 2;
						sort = 'tnkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'txtmatauang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtmatauang.text = ws.ckode;
							o.txtkurs = ws.ckurs;
							txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
							if(txtmatauang.text != UFungsional){
								txtkurs.enabled =true;
							}else{
								txtkurs.enabled = false;
							}
							for (i=0; i<dg.dataProvider.length; i++) {
								dg.dataProvider.getItemAt(i).matauang = txtmatauang.text;
								dg.dataProvider.getItemAt(i).kurs = o.txtkurs;
							}
							f_wsTampil();
							break;
						case 'txtbank':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtbank.text = ws.bkode;
							lblbank.text = ws.bnama
							break
						case 'txtkontak':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkontak.text = ws.kkode;
							lblkontak.text = ws.knama;
							vIdkontak = ws.kid;
							break; 
						case 'txtakun':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtakun.text = ws.cnomor;
							lblakun.text = ws.cnama;
							break;
						case 'txtcatatan':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtcatatan.text = o.tncatatan;
							break;
						case 'noakun':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							var arr:Object = dg.dataProvider.getItemAt(parentApplication.rowIndex)
							arr.noakun = ws.cnomor;
							arr.namaakun = ws.cnama;
							FlexGlobals.topLevelApplication.F_dgRefresh(dg);
							break;
						case 'bank':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = ws.bkode;
							break;
						case 'status':
							cmbstatus.dataProvider.removeAll();
							for(i = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama[i]){
									cmbstatus.dataProvider.addItem({l : nama, kode:kode});
								}
							}
							cmbstatus.selectedIndex = 0;
							break;
						case 'tampil':
							f_focusOnMe();
							isUpdate = true;
							mb.menuBarItems[4].enabled = true;
							mb.menuBarItems[5].enabled = true;
							mb.menuBarItems[6].enabled = true;
							mb.menuBarItems[7].visible = false;
							with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)){
								txturaian.text = sguraian;
								txtcatatan.text = sgcatatan;
								dttgl.text = sgtgl;
								txtnotransaksi.text= sgnotransaksi;
								
								if (sgautonotransaksi ==1){
									chkauto.selected = true; txtnotransaksi.enabled=false;
									
								}else if (sgautonotransaksi==0){chkauto.selected = false; txtnotransaksi.enabled=true;}
								chkposting.selected = Boolean(sgposting)
								txtmatauang.text=sgmatauang;
								o.txtkurs = sgkurs
								txtkurs.text=FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
								if (sgmatauang != UFungsional){
									txtkurs.enabled=true;
								}else{
									txtkurs.enabled=false;
								}
								
								
								if(sgstatus!=7){
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									if(sgstatus ==0){
										cmbprogress.selectedIndex=0;
										mb.menuBarItems[0].enabled=true;
									}else if(sgstatus ==2){
										cmbprogress.selectedIndex=1;
										mb.menuBarItems[0].enabled=false;
									}
									
								}
								else {
									cmbprogress.dataProvider = new ArrayCollection([{l:'Close', v:7}]);
									cmbprogress.selectedIndex=0;
									mb.menuBarItems[0].enabled=false;
									cmbprogress.enabled = false;
								}
								
								o.sgid=sgid; o.sgcabang=sgcabang; o.sglokasi=sglokasi; 
								o.sgsumber=sgsumber;o.sgkodepa=sgkodepa; o.sgkontak=sgkontak; o.sgkontakperson=sgkontakperson; 
								o.sgjumlah=sgjumlah; o.sgjumlahvalas=sgjumlahvalas; o.sgstatussgc=sgstatussgc; o.sgstatussebelumnya=sgstatussebelumnya; o.sgjmlrevisi=sgjmlrevisi; o.sgcetakanke=sgcetakanke; 
								o.sgisclose=sgisclose; o.sginputuser=sginputuser; o.sginputtgl=sginputtgl; 
								o.sgmodifikasiuser=FlexGlobals.topLevelApplication.userid; o.sgmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal; o.sgcustomtext1=sgcustomtext1; 
