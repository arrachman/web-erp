			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcatatan':parentApplication.F_KosongkanText([txtcatatan]);break;
					case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang]);break;
					case 'txtbank':parentApplication.F_KosongkanText([txtbank, lblbank]);break;
					case 'txtkontak':parentApplication.F_KosongkanText([txtkontak, lblkontak]);break;
					case 'txtakun':parentApplication.F_KosongkanText([txtakun, lblakun]);break;
					case 'tampilGiro':
						for(i=dg.dataProviderLength-1;i>=0;i--){
							if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
								dg.dataProvider.removeItemAt(i);
							}
						}
						break;
					case 'tampil':
					case 'simpan':
						Alert.show(FlexGlobals.topLevelApplication.l(FlexGlobals.topLevelApplication.wsErrmessage), FlexGlobals.topLevelApplication.l('Informasi'));
						break;
				}
			}
			public function centang():void{
				ac2.removeAll();
				for (var i:int = 0; i < dg.dataProviderLength; i++)
					if(dg.dataProvider[i].noakun.length > 0){
						if(dg.dataProvider.getItemAt(i).chk==1){
							with(dg.dataProvider.getItemAt(i))		
								ac2.addItem({No:i+1, noakun:noakun, idsgdetail:idsgdetail, idsg:idsg, nogiro:nogiro,matauang:matauang,kurs:kurs, jumlah:jumlah,jumlahvalas:jumlahvalas,catatan:catatan,  statussgc:statussgc, isclose:isclose, customtext1:customtext1, customtext2:customtext2, customtext3:customtext3, customdbl1:customdbl1, customdbl2:customdbl2,
									customdbl3:customdbl3,customdate1:customdate1,customdate2:customdate2,customdate3:customdate3,rekgiro:rekgiro,statusgiro:statusgiro, noacbank:noacbank,tgljt:tgljt, kontakid:kontakid, bank:bank});
						}
					}
			}
			protected function f_simpan():void
			{
				centang();
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
							// Set Utama
							with(o){
								a = [sgid, sgcabang, sglokasi, sgsumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
									sgkodepa, sgkontak, sgkontakperson, txturaian.text, txtcatatan.text, txtmatauang.text, o.txtkurs, 
									sgjumlah, sgjumlahvalas, sgstatussgc, cmbprogress.selectedItem.v, sgstatussebelumnya, sgjmlrevisi, sgcetakanke, 
									sgisclose, sginputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(sginputtgl), sgmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(sgmodifikasitgl), int(chkposting.selected), sgcustomtext1, 
									sgcustomtext2, sgcustomtext3, sgcustomtext4, sgcustomtext5, sgcustomint1, sgcustomint2, sgcustomint3, 
									sgcustomdbl1, sgcustomdbl2, sgcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(sgcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(sgcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(sgcustomdate3)];
								utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
							
							for(i=0;i<ac2.length;i++)
								with(ac2.getItemAt(i)){
									a = [idsgdetail, idsg, nogiro, kontakid, matauang, kurs, jumlah, 
										jumlahvalas, bank, noacbank, noakun, rekgiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), catatan, 
										i+1, statusgiro, statussgc, isclose, customtext1, customtext2, customtext3, 
										customdbl1, customdbl2, customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detail =  FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+ FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_SgSimpan", parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(txtmatauang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(txtnotransaksi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(ac2.length <= 0){
						FlexGlobals.topLevelApplication.msgAlert(dg, 'Data')
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert',  '');		
					
					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi == true)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						//return myalert;
						//\n
						validasi = false;						
					}
//					if(ac2.length <= 0){
//						ac2.addItem({No:i+1, noakun:'', idsgdetail:0, idsg:0, nogiro:'',matauang:'',kurs:0, jumlah:0,jumlahvalas:0,catatan:'',  statussgc:0, isclose:0, customtext1:'', customtext2:'', customtext3:'', customdbl1:0, customdbl2:0,
//							customdbl3:0,customdate1:FlexGlobals.topLevelApplication.m.DateFirst,customdate2:FlexGlobals.topLevelApplication.m.DateFirst,customdate3:FlexGlobals.topLevelApplication.m.DateFirst,rekgiro:'',statusgiro:0, noacbank:'',tgljt:FlexGlobals.topLevelApplication.m.DateFirst, 
//							kontakid:0, bank:''});
//					}
				}
				
				
			}
			public function f_hitungTotal():void
			{
				o.sgjumlah = 0; o.sgjumlahvalas=0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).chk==1){
						o.sgjumlah += Number(dg.dataProvider.getItemAt(i).jumlah);
						o.sgjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas);
					}
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sgjumlah);
				lbltotalvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sgjumlahvalas);
			}
			
