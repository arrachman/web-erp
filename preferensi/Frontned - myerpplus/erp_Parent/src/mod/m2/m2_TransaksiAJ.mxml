				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).debitvalas = dg.dataProvider.getItemAt(i).debit/o.txtkurs;
						dg.dataProvider.getItemAt(i).kreditvalas = dg.dataProvider.getItemAt(i).kredit/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).debitvalas = 0;
						dg.dataProvider.getItemAt(i).kreditvalas = 0;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}
			}
			public var vtotal:Number;
			public function f_hitungTotal():void
			{
				o.ajdebit = 0; o.ajdebitvalas = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).debit != undefined)o.ajdebit += Number(dg.dataProvider.getItemAt(i).debit);
					if(dg.dataProvider.getItemAt(i).debitvalas != undefined)o.ajdebitvalas += Number(dg.dataProvider.getItemAt(i).debitvalas)
				}
				
				lbltotaldebit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ajdebit);
				lbltotaldebitvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ajdebitvalas)
				
				
				o.ajkredit = 0; o.ajkreditvalas = 0; 
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).kredit != undefined)o.ajkredit += Number(dg.dataProvider.getItemAt(i).kredit);
					if(dg.dataProvider.getItemAt(i).kreditvalas != undefined)o.ajkreditvalas += Number(dg.dataProvider.getItemAt(i).kreditvalas);
				}
				lbltotalkredit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ajkredit);
				lbltotalkreditvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ajkreditvalas)
				
			}
			
			
