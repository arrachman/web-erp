			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkontak':parentApplication.F_KosongkanText([txtkontak, lblkontak]);break;
					case 'txtkontakperson':FlexGlobals.topLevelApplication.F_KosongkanText([txtkontakperson]);break;
					case 'txtcatatan':FlexGlobals.topLevelApplication.F_KosongkanText([txtcatatan]);break;
					case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang]);break;
				}
			}
			
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
							// Set Utama 
							with(o){
								a = [ajid, ajcabang, ajlokasi, ajsumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
									ajkodepa, ajkontak, txtkontakperson.text, txturaian.text, txtcatatan.text, txtmatauang.text, o.txtkurs, 
									ajdebit, ajdebitvalas, ajkredit, ajkreditvalas, ajjumlahbayar, ajjumlahbayarvalas, ajstatusbayar, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(ajtgllunas), cmbprogress.selectedItem.v, ajstatussebelumnya, ajjmlrevisi, ajcetakanke, ajisclose, ajinputuser, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(ajinputtgl), ajmodifikasiuser, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(ajmodifikasitgl), int(chkposting.selected), ajcustomtext1, ajcustomtext2, ajcustomtext3, 
									ajcustomtext4, ajcustomtext5, ajcustomint1, ajcustomint2, ajcustomint3, ajcustomdbl1, ajcustomdbl2, 
									ajcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(ajcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(ajcustomdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(ajcustomdate3)];
								utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
							// Set Detail
							for(i=0;i<dg.dataProviderLength;i++)
								with(dg.dataProvider.getItemAt(i)){
									a = [idajdetail, idaj, noakun, txtmatauang.text, o.txtkurs, debit, debitvalas, 
										kredit, kreditvalas, catatan, costcenter, divisi, subdivisi, proyek, 
										i+1, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
										customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_AjSimpan", parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
