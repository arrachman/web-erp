			public function f_hitungTotal():void
			{
				o.sgcjumlah = 0; o.sgcjumlahvalas=0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).chk==1){
						o.sgcjumlah += Number(dg.dataProvider.getItemAt(i).jumlah);
						o.sgcjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas);
					}
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sgcjumlah);
				lbltotalvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sgcjumlahvalas);
			}
