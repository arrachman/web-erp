<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Text;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			
			import spark.events.GridEvent;
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array;
			public var o:Object = {}, idbayarke:String='', iduser:String='';
			private var kontak1:String = '', kontak2:String = '', user:String = '';
			protected var arrMenuBar:ArrayCollection;
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			public function f_persiapan():void
			{
				// Config Paging
				parentApplication.m[parentApplication.idmod].child.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = '0';
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(2, 95);
				cmbstatus.dataProvider = new ArrayCollection([{l:'Semua', v:-1}, {l:'Aktif', v:15}, {l:'Draft', v:0}, {l:'Approved', v:2}, {l:'In Progress', v:3}, {l:'Complete', v:4}, {l:'Close', v:7}]);
				parentApplication.F_TranslateLabel([ttanggal, tnotranaksi, tkontak, turaian, tuser, tstatus, tmatauang, tsumber, tjenislaporan]);
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				parentApplication.F_ComboBoxStandard([cmbjenislaporan, cmbstatus]);
				parentApplication.F_txtpencarian([txtkontak1, txtkontak2, txtuser, txtmatauang, txtsumber]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2, txturaian]);
				
				FlexGlobals.topLevelApplication.F_setGridJson(2, 95);
				FlexGlobals.topLevelApplication.registerGrid([dg1], 'data');
				
				txtnotransaksi2.addEventListener(FocusEvent.FOCUS_IN, f_changenotransaksi);
				dttgl2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				txtkontak2.addEventListener(FocusEvent.FOCUS_IN, f_changekontak);

				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Tampilkan", icon:"tbpreview"},
					{label:"Reset", icon:"tbreset"},
					{label:"Cetak", icon:"tbprint", data:"0"},
					{label:"Export", icon:"tbexport", children:[
						{label:"Ms.Excel", icon:"tbexcel", data:"1"},
						{label:"Html", icon:"tbhtml", data:"2"},
						{label:"Ms.Word", icon:"tbword", data:"3"},
						{label:"Text", icon:"tbtxt", data:"4"},
						{label:"Image", icon:"tbtif", data:"5"}]
					}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbCetak);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbExport);
				function f_mbTampilkan():void
				{
					if(int(txtpaging.text) == 0)
						f_formDataTampil();
					else
						f_formDataTampil(int(txtpaging.text));
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbCetak():void
				{
					FlexGlobals.topLevelApplication.F_openReport(2, 95, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', 0);
				}
				function f_mbExport(e:MenuEvent):void
				{
					switch(e.label){
						case 'PDF': FlexGlobals.topLevelApplication.F_openReport(2, 95, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Ms.Excel': FlexGlobals.topLevelApplication.F_openReport(2, 95, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Html': FlexGlobals.topLevelApplication.F_openReport(2, 95, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Ms.Word': FlexGlobals.topLevelApplication.F_openReport(2, 95, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Text': FlexGlobals.topLevelApplication.F_openReport(2, 95, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
						case 'Image': FlexGlobals.topLevelApplication.F_openReport(2, 95, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.@data);
							break;
					}
				}
				function f_changenotransaksi():void{
					txtnotransaksi2.text = txtnotransaksi1.text;	
				}
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				function f_changekontak():void{
					txtkontak2.text = txtkontak1.text;
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_formDataTampil(int(txtpaging.text));
				}
				function f_firstCLICK():void
				{
					f_formDataTampil();
				}
				function f_previousCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)-1);
				}
				function f_nextCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)+1);
				}
				function f_lastCLICK():void
				{
					f_formDataTampil(int(-1));
				}
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.HOME:
							if(int(txtpaging.text)>1)
								f_formDataTampil();
							break;
						case Keyboard.PAGE_UP:
							if(int(txtpaging.text)-1>0)
								f_formDataTampil(int(txtpaging.text)-1);
							break;
						case Keyboard.PAGE_DOWN:
							f_formDataTampil(int(txtpaging.text)+1);
							break;
						case Keyboard.END:
							f_formDataTampil(-1);
							break;
						case Keyboard.P:
							if(e.ctrlKey)
								f_mbCetak();
							break;
						case Keyboard.R:
							if(e.ctrlKey)
								f_kondisiAwal();
							break;
					}
				}
				
				dg_contextmenu();
				f_kondisiAwal();
			}
			
			protected function dg_contextmenu():void
			{
				var vCMI:ContextMenuItem, arr:Array = new Array;
				ttwpopup.addEventListener(mx.events.CloseEvent.CLOSE, f_ttwClose);
				ttwpopup.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_ttwKEY_DOWN);
				dg1.contextMenu = new ContextMenu;
				dg1.contextMenu.hideBuiltInItems();
				dg1.addEventListener(GridEvent.GRID_ROLL_OVER, f_dgROLL_OVER);
				dg1.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_MENU_SELECT);
				vCMI = new ContextMenuItem('Jurnal Voucher')      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jurnalVocher); 
				dg1.contextMenu.customItems.push(vCMI);
				
				function f_dgROLL_OVER(e:GridEvent):void
				{
					if(dg1.dataProviderLength > 0){
						arr[0] = e.rowIndex;
						arr[1] = e.columnIndex;
					}
				}
				function f_MENU_SELECT():void
				{
					arr[2] = arr[0]; //row
					arr[3] = arr[1]; //col
					dg1.setSelectedCell(arr[2], arr[3]);
				}
				function f_ttwClose():void
				{
					grppopup.visible = false;
					gridjv.visible = false;
					gridtt.visible = false;
					gridjv.dataProvider.removeAll();
					dg1.setFocus();
				}
				function f_ttwKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ESCAPE)
						f_ttwClose();
				}
				function f_jurnalVocher():void
				{
					if(parentApplication.apaBisaAkses(2, 95, 11) == true){
						if(dg1.selectedCell == null){
							Alert.show("Pilih data dulu", "Informasi");
							return;
						} 
						var notransaksi:String = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tnotransaksi;
						if(notransaksi == null){
							Alert.show("Pilih No Transaksi dulu", "Informasi");
							return;
						}
						if(dg1.dataProviderLength > 0 && parentApplication.apaBisaAkses(2, 95, 11) == true)
							parentApplication.F_wsSearch(parentApplication.sptParam+'tampilFDJurnalVocher', 'M2_Transaction_Journal_VoucherSearch', 0, 0, "tnotransaksi = '"+notransaksi+"'", "tgrup, turutan");
					}
				}
			}
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				cmbstatus.selectedIndex = o.DefaultStatus;
				parentApplication.F_KosongkanText([dttgl1,dttgl2,txtnotransaksi1,txtnotransaksi2,txtkontak1,txtkontak2,txturaian,txtuser,txtmatauang, txtsumber]);
				parentApplication.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				kontak1 = ""; kontak2 = ""; user = "";
				dg1.dataProvider.removeAll();
			}
			
			public function f_formDataTampil(page:int = 1):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("Tampilkan", 'M2_Data_Journal_VoucherSearch', page, 20, f_filterdata(), 'ttgl desc, tinputtgl desc');
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var moduleid:int=0, menuid:int=0;
				switch(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsumber){
					case 'AJ': moduleid=2; menuid=8; break;
					case 'AP': moduleid=4; menuid=8; break;
					case 'AS': moduleid=5; menuid=5; break;
					case 'CB': moduleid=2; menuid=65; break;
					case 'CD': moduleid=2; menuid=4; break;
					case 'CR': moduleid=2; menuid=3; break;
					case 'DA': moduleid=7; menuid=11; break;
					case 'GJ': moduleid=2; menuid=7; break;
					case 'GRN': moduleid=4; menuid=10; break;
					case 'IB': moduleid=3; menuid=23; break;
					case 'IP': moduleid=5; menuid=44; break;
					case 'PD': moduleid=6; menuid=8; break;
					case 'PP': moduleid=4; menuid=44; break;
					case 'PRT': if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsaldoawal==0){moduleid=4; menuid=13;}else{moduleid=4; menuid=51;} break;
					case 'PV': moduleid=5; menuid=14; break;
					case 'RG': moduleid=2; menuid=9; break;
					case 'RGC': moduleid=2; menuid=11; break;
					case 'RI': if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsaldoawal==0){moduleid=4; menuid=11;}else{moduleid=4; menuid=51;} break;
					case 'RM': moduleid=2; menuid=5; break;
					case 'RP': moduleid=5; menuid=41; break;
					case 'RV': moduleid=2; menuid=13; break;
					case 'SA': moduleid=3; menuid=6; break;
					case 'SG': moduleid=2; menuid=10; break;
					case 'SGC': moduleid=2; menuid=12; break;
					case 'SI': if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsaldoawal==0){moduleid=5; menuid=10;}else{moduleid=5; menuid=51;} break;
					case 'SM': moduleid=2; menuid=6; break;
					case 'SR': if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsaldoawal==0){moduleid=5; menuid=12;}else{moduleid=5; menuid=51;} break;
					case 'VP': moduleid=4; menuid=15; break;
				}
				if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsaldoawal == 0){
					FlexGlobals.topLevelApplication.openForm(moduleid, menuid, dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tidtransaksi);
				}else{
					FlexGlobals.topLevelApplication.openForm(moduleid, menuid, dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tidtransaksi, [dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).tsumber]);
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkontak1':
						paket = 'CdM1_Contact';
						csfilter = "kaktif=1";
						wsfilter = "kaktif=1 AND kkode ='"+txtkontak1.text+"'";
						break;
					case 'txtkontak2':
						paket = 'CdM1_Contact';
						csfilter = "kaktif=1";
						wsfilter = "kaktif=1 AND kkode ='"+txtkontak2.text+"'";
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = "uaktif=1";
						wsfilter = "uaktif=1 AND ukode ='"+txtuser.text+"'";
						break;
					case 'txtmatauang':
						paket = 'CdM1_Currency';
						csfilter = "caktif=1";
						wsfilter = "caktif=1 AND ckode ='"+txtmatauang.text+"'";
						break;
					case 'txtsumber':
						paket = 'CdM0_Nomor';
						csfilter = "transaksifa=1";
						wsfilter = "transaksifa=1 AND kodetabel ='"+txtsumber.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(parentApplication.wsSuccess == true){
					if(parentApplication.wsArrUtama.getItemAt.length >= 0)ws = parentApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtkontak1':
							txtkontak1.text = ws.kkode;
							kontak1 = ws.kid;
							break;
						case 'txtkontak2':
							txtkontak2.text = ws.kkode;
							kontak2 = ws.kid;
							break;
						case 'txtuser':
							txtuser.text = ws.ukode;
							user = ws.userid;
							break;
						case 'txtmatauang':
							txtmatauang.text = ws.ckode;
							break;
						case 'txtsumber':
							txtsumber.text = ws.kodetabel;
							break;
						case 'tampilFDJurnalVocher':
							ttwpopup.horizontalCenter = 0;
							ttwpopup.right = 0;
							grppopup.visible = true;
							ttwpopup.title = 'Jurnal Voucher';
							gridjv.visible = true;
							gridjv.dataProvider = parentApplication.wsArrUtama;
							gridjv.setSelectedCell(0, 0);
							gridjv.setFocus();
							break;
						case 'Tampilkan':
							dg1.dataProvider = parentApplication.wsArrUtama;
							imgfirst.enabled = parentApplication.wsIsPrev;
							imgprevious.enabled = parentApplication.wsIsPrev;
							imgnext.enabled = parentApplication.wsIsNext;
							imglast.enabled = parentApplication.wsIsNext;
							txtpaging.text = parentApplication.wsCurPage;
							for(i=0;i<dg1.dataProviderLength;i++)
								dg1.dataProvider[i].no = (((parentApplication.wsCurPage-1)*20)+(i+1));
							parentApplication.F_dgRefresh(dg1);
							dg1.setFocus();
							dg1.setSelectedCell(0, 0);
							break;
					}
				}else{
					if(parentApplication.F_validasiFalse(s) || s == "Tampilkan")
						switch(s){
							case 'tampilFDJurnalVocher':
								Alert.show(parentApplication.wsErrmessage);
								break;
							case 'Tampilkan':
								dg1.dataProvider.removeAll();
								break;
						}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkontak1':parentApplication.F_KosongkanText([txtkontak1]);break;
					case 'txtkontak2':parentApplication.F_KosongkanText([txtkontak2]);break;
					case 'txtuser':parentApplication.F_KosongkanText([txtuser]);user='';break;
					case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang]);break;
					case 'txtsumber':parentApplication.F_KosongkanText([txtsumber]);break;
				}
			}
			
			public function f_filterdata():String{
				var f:String = '';
				if(txtnotransaksi1.text != '' && txtnotransaksi2.text != '')
					f = parentApplication.TambahFilter(f, 'tnotransaksi BETWEEN "'+txtnotransaksi1.text.split('"').join('\\"')+'" AND "'+txtnotransaksi2.text.split('"').join('\\"')+'"'); 
				else if(txtnotransaksi1.text != '') 
					f = parentApplication.TambahFilter(f, 'tnotransaksi >= "'+txtnotransaksi1.text.split('"').join('\\"')+'"'); 
				else if(txtnotransaksi2.text != '')
					f = parentApplication.TambahFilter(f, 'tnotransaksi <= "'+txtnotransaksi2.text.split('"').join('\\"')+'"');
				if(dttgl1.text != '' && dttgl2.text != '')
					f = parentApplication.TambahFilter(f, 'ttgl BETWEEN "'+parentApplication.F_tglFormatDB(dttgl1.text)+'" AND "'+parentApplication.F_tglFormatDB(dttgl2.text)+'"'); 
				else if(dttgl1.text != '') 
					f = parentApplication.TambahFilter(f, 'ttgl >= "'+parentApplication.F_tglFormatDB(dttgl1.text)+'"'); 
				else if(dttgl2.text != '')
					f = parentApplication.TambahFilter(f, 'ttgl <= "'+parentApplication.F_tglFormatDB(dttgl2.text)+'"');
				if(txtkontak1.text != '' && txtkontak2.text != '')
					f = parentApplication.TambahFilter(f, 'tkontakkode BETWEEN "'+txtkontak1.text+'" AND "'+txtkontak2.text+'"'); 
				else if(txtkontak1.text != '')
					f = parentApplication.TambahFilter(f, 'tkontakkode >= "'+txtkontak1.text+'"'); 
				else if(txtkontak2.text != '')
					f = parentApplication.TambahFilter(f, 'tkontakkode <= "'+txtkontak2.text+'"');
				if(txturaian.text != '')
					f = parentApplication.TambahFilter(f, 'turaian LIKE "%'+txturaian.text.split('"').join('\\"')+'%"');
				if(txtuser.text != '')
					f = parentApplication.TambahFilter(f, 'tinputuserkode = "'+txtuser.text+'"');
				if(cmbstatus.selectedIndex > 0){
					if(cmbstatus.selectedItem.v == 15){ f = parentApplication.TambahFilter(f, "tstatus = 2 OR tstatus = 3 OR tstatus = 4 OR tstatus = 7"); }
					else { f = parentApplication.TambahFilter(f, 'tstatus = "'+cmbstatus.selectedItem.v+'"'); }
				}
				if(txtmatauang.text != '')
					f = parentApplication.TambahFilter(f, 'tmatauang LIKE "%'+txtmatauang.text.split('"').join('\\"')+'%"');
				if(txtsumber.text != '')
					f = parentApplication.TambahFilter(f, 'tsumber = "'+txtsumber.text.split('"').join('\\"')+'"');
				return f;
			}
			
			public function f_hitungTotal():void{}
