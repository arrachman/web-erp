			protected function dg1_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.ctrlKey){
					switch (event.keyCode){
						case Keyboard.C:
							if(dg1.selectedCell != null){
								flash.system.System.setClipboard(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex)[dg1.columns.getItemAt(dg1.selectedCell.columnIndex).dataField]);
							}
							break;
					}
				}
			}
			
		]]>
	</fx:Script>
