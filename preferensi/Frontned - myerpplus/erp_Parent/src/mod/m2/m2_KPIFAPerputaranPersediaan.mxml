<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  creationComplete="script();f_Load(event)"
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%">
	<fx:Script source="script.as"/>
	<fx:Script>
		<![CDATA[
			[Bindable] [Embed(source="assets/tb/show.png")]  public var tbshow:Class;
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			protected function f_Load(event:FlexEvent):void
			{
				wstampil();
				btntampilkan.addEventListener(flash.events.MouseEvent.CLICK, function():void{wstampil()});
				btnhitung.addEventListener(flash.events.MouseEvent.CLICK, function():void{wshitung()});
			}
			
			public function f_wsHasil():void
			{
				ob = parentApplication.wsArrUtama;
				switch(parentApplication.subject){
					case "hitung":
						arrdg.removeAll();
						if (parentApplication.wsSuccess){
							arrdg.addItem({variable:"Saldo Awal",value:f_FormatUang(ob[0].psdawal)});
							arrdg.addItem({variable:"Saldo Akhir",value:f_FormatUang(ob[0].psdakhir)});
							arrdg.addItem({variable:"Persediaan",value:f_FormatUang(ob[0].psdpersediaan)});
							arrdg.addItem({variable:"Penjualan",value:f_FormatUang(ob[0].psdpenjualan)});
							arrdg.addItem({variable:"Jumlah Hari",value:ob[0].psdjmlhari});
							arrdg.addItem({variable:"Penjualan Per Hari",value:f_FormatUang(ob[0].psdpenjualanperhari)});
							arrdg.addItem({variable:"Hasil",value:f_FormatUang(ob[0].psdhasil)});
							arrdg.addItem({variable:"Update Terakhir",value:ob[0].psdinputtgl});	
							arrdg.addItem({variable:"User",value:ob[0].unama});
							dg.dataProvider = new ArrayCollection(arrdg.toArray());
						}else{
							dg.dataProvider = null;
						}
						break;
					case "c-wshitung":
						if(parentApplication.ob_resultWs.success==true)
							wstampil();
						else{
							dg.dataProvider = null;
							Alert.show(ob.errmessage, 'Konfirmasi');
						}
						break;
					case "c-CariData_coa":
						if(ob.success==true){
							var akun1:String, akun2:String, akunnama:String, tgl1:String, tgl2:String;
							akun1 = ob.ListCari[0].s1;
							akun2 = ob.ListCari[ob.ListCari.length-1].s1;
							akunnama = ob.ListCari[0].s2;
							tgl1 = cmbtahun.textInput.text+"-"+(cmbbulan.selectedIndex+1)+"-01";
							tgl2 = cmbtahun.textInput.text+"-"+(cmbbulan.selectedIndex+1)+"-"+ldm();
							var filter:String;
							filter = "^"+akun1+"^,^"+akun2+"^,^"+tgl1+"^,^"+tgl2+"^,^^,^^,^^,^%^,^^,^^,^^,^^,^^";
							parentApplication.openReport(2, 51, 1,"Buku Besar (pdf)", filter,'','pdf',1,"Periode "+tgl1+" s.d. "+tgl2,akunnama,akun1,akun2);
						}
						break;
				}
			}
			
			public function wstampil():void{
				wshitung();
			}
			
			public function wshitung():void{
				FlexGlobals.topLevelApplication.F_wsSimpan("hitung", "M8_InventoryTurnOver", parentApplication.userid, undefined, cmbtahun.selectedItem.l+FlexGlobals.topLevelApplication.sptField+(cmbbulan.selectedIndex+1));
			}
			
			protected function dg_clickHandler(event:MouseEvent):void
			{
				ws('CariData_coa');
//				if(dg.selectedCell.columnIndex == 1)
//					if(dg.selectedCell.rowIndex == 2)
//						parentApplication.myWs0.CariData(wAcc, 0, 0, "cpersediaan=1", "", "coa", "cnomor ASC");
//					else if(dg.selectedCell.rowIndex == 3)
//						parentApplication.myWs0.CariData(wAcc, 0, 0, "cpersediaan=1", "", "coa", "cnomor ASC");
//					else if(dg.selectedCell.rowIndex == 5)
//						parentApplication.myWs0.CariData(wAcc, 0, 0, "cpenjualan=1", "", "coa", "cnomor ASC");
			}
		]]>
	</fx:Script>
	<mx:VDividedBox width="100%" height="100%">
		<s:Group width="100%" height="45">
			<s:Label x="10" y="19" text="Tahun"/>
			<s:ComboBox id="cmbtahun" x="51" y="12" width="90"/>
			<s:Label x="150" y="19" text="Bulan"/>
			<s:ComboBox id="cmbbulan" x="191" y="12" width="90"/>
			<s:Button id="btntampilkan" x="422" y="10" width="115" height="25" label="Tampilkan" icon="{tbshow}" visible="false"/>
			<s:Button id="btnhitung" x="296" y="10" width="115" height="25" label="Tampilkan" icon="{tbshow}"/>
		</s:Group>
		<s:DataGrid id="dg" width="100%" height="100%" click="dg_clickHandler(event)" selectionMode="singleCell">
			<s:columns>
				<s:ArrayList>
					<s:GridColumn headerText="Variable" dataField="variable" width="200"/>
					<s:GridColumn headerText="Value" dataField="value">
					<s:itemRenderer>
						<fx:Component>
							<s:GridItemRenderer>
								<fx:Script>
									<![CDATA[
										protected function label1_renderHandler(event:Event):void
										{
											if(data.variable == 'Saldo Awal Persediaan' || data.variable == 'Saldo Akhir Persediaan' || data.variable == 'Penjualan'){
												lbllink.visible = true;
												lbllink2.visible = false
											}else{
												lbllink.visible = false;
												lbllink2.visible = true;
											}
										}
									]]>
								</fx:Script>
								<s:Label id="lbllink" text="{data.value}" paddingTop="10" paddingLeft="10" color='#009ad4' rollOver="setStyle('textDecoration','underline')" render="label1_renderHandler(event)" rollOut="setStyle('textDecoration','none')" useHandCursor="true" buttonMode="true" mouseChildren="false"/>
								<s:Label id="lbllink2" text="{data.value}" paddingTop="10" paddingLeft="10"/>
							</s:GridItemRenderer>
						</fx:Component>
					</s:itemRenderer>
					</s:GridColumn>
				</s:ArrayList>
			</s:columns>
		</s:DataGrid>
		<s:Image height="160" source="assets/kpi/m2/perputaranpersediaan.png"/>
	</mx:VDividedBox>
</s:Module>
