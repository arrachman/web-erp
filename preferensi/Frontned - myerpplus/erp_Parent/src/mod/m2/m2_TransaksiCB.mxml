<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.Image;
			
			public var validasi:Boolean, pesanAlert:String, pesanAlertIng:String, img:Image, UFungsional:String, i:int, isUpdate:Boolean, hf:Object;
			[Bindable] public var o:Object={},no:int;
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number, dgrid:Object={};
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction, getNotransaksi:String;
			
			public function f_focusOnMe():void
			{
				txtkontak.setFocus();
			}
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'carabayar')
							return new ArrayCollection([{l:'Masuk', v:0}, {l:'Keluar', v:1}]);
						break;
				}
				return new ArrayCollection([]);
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						if(Number(data) > 0){
							if(txtmatauang.text == UFungsional){
								if(dataField == 'debitvalas'){
									Alert.show(FlexGlobals.topLevelApplication.l('Debit Valas harus 0 karena mata uang fungsional'), FlexGlobals.topLevelApplication.l('Informasi'));
									dg1.dataProvider[dg1.selectedCell.rowIndex].debitvalas = 0;
								}
								if(dataField == 'kreditvalas'){
									Alert.show(FlexGlobals.topLevelApplication.l('Kredit Valas harus 0 karena mata uang fungsional'), FlexGlobals.topLevelApplication.l('Informasi'));
									dg1.dataProvider[dg1.selectedCell.rowIndex].kreditvalas = 0;
								}
							}else{
								if(dataField == 'debitvalas'){
									dg1.dataProvider[dg1.selectedCell.rowIndex].debitvalas = data;
									dg1.dataProvider[dg1.selectedCell.rowIndex].debit = dg1.dataProvider[dg1.selectedCell.rowIndex].debitvalas * o.txtkurs;
									dg1.dataProvider[dg1.selectedCell.rowIndex].kredit = 0;
									dg1.dataProvider[dg1.selectedCell.rowIndex].kreditvalas = 0;
									
								}
								if(dataField == 'debit'){
									dg1.dataProvider[dg1.selectedCell.rowIndex].debit = data;
									dg1.dataProvider[dg1.selectedCell.rowIndex].debitvalas = dg1.dataProvider[dg1.selectedCell.rowIndex].debit / o.txtkurs;
									dg1.dataProvider[dg1.selectedCell.rowIndex].kredit = 0;
									dg1.dataProvider[dg1.selectedCell.rowIndex].kreditvalas = 0;
									
								}
								if(dataField == 'kreditvalas'){
									dg1.dataProvider[dg1.selectedCell.rowIndex].kreditvalas = data;
									dg1.dataProvider[dg1.selectedCell.rowIndex].kredit = dg1.dataProvider[dg1.selectedCell.rowIndex].debitvalas * o.txtkurs;
									dg1.dataProvider[dg1.selectedCell.rowIndex].debit = 0;
									dg1.dataProvider[dg1.selectedCell.rowIndex].debitvalas = 0;
								}
								if(dataField == 'kredit'){
									dg1.dataProvider[dg1.selectedCell.rowIndex].kredit = data;
									dg1.dataProvider[dg1.selectedCell.rowIndex].kreditvalas = dg1.dataProvider[dg1.selectedCell.rowIndex].kredit / o.txtkurs;
									dg1.dataProvider[dg1.selectedCell.rowIndex].debit = 0;
									dg1.dataProvider[dg1.selectedCell.rowIndex].debitvalas = 0;
									
								}
							}
						}
						break;
				}
				f_hitungTotal(); f_hitungvalas();
			}
			protected function f_persiapan():void
			{
				tab.focusEnabled = false ; 
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				parentApplication.F_tabvalidatenow(tab);
				parentApplication.F_RequiredLabel([tkontak, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs]);
				parentApplication.F_TranslateLabel([tkontak, ttanggal, tnotransaksi, tmatauang, tprogress, turaian, tkontakperson, tcatatan]);
				parentApplication.F_DateFieldStandard([dttgl]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtkontak, txtmatauang]);
				parentApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				parentApplication.F_TextInputNumberDesimalMode([txtkurs]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,chkauto,chkposting]);
				
				UFungsional= FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				hf = FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLink);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(2,65,jenissimpan)==true){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Cb");
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
					f_kondisiAwal();
					mb.menuBarItems[3].enabled=false;
					mb.menuBarItems[4].enabled=false;
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[3].enabled==true)FlexGlobals.topLevelApplication.F_OpenNotes(o.cbsumber,o.cbid,txtnotransaksi.text);
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('Cb', o.cbid,txtnotransaksi.text);
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(2,'Cb');
				}
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
						if(event.keyCode == Keyboard.ENTER){
							dg1.setFocus();
							dg1.setSelectedCell(0,1);
						}
					}
				);
				
				FlexGlobals.topLevelApplication.F_RegGrid(2,65,[dg1, dg2],'transaksi');
				
				f_validasi();
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M2_CbHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M2_CbGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				o.txtkurs = 0;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				cmbprogress.selectedIndex = 1 ;
				txtnotransaksi.text = 'Auto';
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				parentApplication.F_SetNilaiText([lbltotaldebit,lbltotaldebitvalas,lbltotalkredit,lbltotalkreditvalas],FlexGlobals.topLevelApplication.m.nfNominal.format('0'));
				isUpdate = false;
				txtkontak.setFocus();
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("CB");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("CB",1);
				parentApplication.F_SetNilaiText([dttgl], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtkontak, lblkontak,txtkontakperson]);
				
				o.cbid=0, o.cbcabang=parentApplication.ucabang, o.cblokasi=parentApplication.ulokasi, o.cbsumber='CB', o.cbautonotransaksi=0, o.cbnotransaksi=txtnotransaksi.text, o.cbtgl=dttgl.text, 
				o.cbkodepa=0, o.cbkontak=0, o.cbkontakperson=txtkontakperson.text, o.cburaian=txturaian.text, o.cbcatatan=txtcatatan.text, o.cbmatauang=txtmatauang.text, o.cbkurs=o.txtkurs, 
				o.cbdebit=0, o.cbdebitvalas=0, o.cbkredit=0, o.cbkreditvalas=0, o.cbjumlahbayar=0, o.cbjumlahbayarvalas=0, o.cbstatusbayar=0, 
				o.cbtgllunas=FlexGlobals.topLevelApplication.m.DateFirst, o.cbstatus=cmbprogress.selectedItem.v, o.cbstatussebelumnya=0, o.cbjmlrevisi=0, o.cbcetakanke=0, o.cbisclose=0, o.cbinputuser=parentApplication.userid, 
				o.cbinputtgl=FlexGlobals.topLevelApplication.m.DateFirst, o.cbmodifikasiuser=0, o.cbmodifikasitgl=FlexGlobals.topLevelApplication.m.DateFirst, o.cbposting=0, o.cbcustomtext1='', o.cbcustomtext2='', o.cbcustomtext3='', 
				o.cbcustomtext4='', o.cbcustomtext5='', o.cbcustomint1=0, o.cbcustomint2=0, o.cbcustomint3=0, o.cbcustomdbl1=0, o.cbcustomdbl2=0, 
				o.cbcustomdbl3=0, o.cbcustomdate1=FlexGlobals.topLevelApplication.m.DateFirst, o.cbcustomdate2=FlexGlobals.topLevelApplication.m.DateFirst, o.cbcustomdate3=FlexGlobals.topLevelApplication.m.DateFirst
				
				for(i=0; i<dg1.dataProviderLength; i++){
					dg1.dataProvider.getItemAt(i).noakun=''; 
					dg1.dataProvider.getItemAt(i).debit=0;
					dg1.dataProvider.getItemAt(i).kredit=0;
				}
				
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(2,65,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add') && dg.id == "dg2"){
					if(o.a.length == 1)o.o = dg2.dataProvider.getItemAt(dg2.dataProviderLength-1);
					else o.d = dg2.dataProvider.getItemAt(o.a[1]);
					o.o.idcb = 0;
					o.o.idcbcarabayar = 0;
					o.o.jenisgiro = 0;
					o.o.jumlah = 0;
					o.o.jumlahvalas = 0;
					o.o.nogiro = '';
					o.o.tgljt = parentApplication.DefaultTanggal;
					o.o.bank = '';
					o.o.noacbank = '';
					o.o.rekbank = '';
					o.o.rekgiro = '';
					o.o.matauang = txtmatauang.text;
					o.o.txtkurs = o.txtkurs;
					o.o.catatan = '';
				return
				}
				
				if(parentApplication.rowIndex < dg.dataProviderLength)
				with(dg.dataProvider.getItemAt(parentApplication.rowIndex))
					switch(column){
						case 'debit':
							if (txtmatauang.text != UFungsional){
								debitvalas = Number(debit) /o.txtkurs;
								kredit = 0;
								kreditvalas = 0;
							}else{
								debitvalas = 0;
								kredit = 0;
								kreditvalas = 0;
							}
							break;
						case 'debitvalas':
							if (txtmatauang.text != UFungsional){
								debit = Number(debitvalas) * o.txtkurs;
								kredit = 0;
								kreditvalas = 0;
							}else{
								debitvalas = 0;
								kredit = 0;
								kreditvalas = 0;
							}
							break;
						case 'kredit':
							if (txtmatauang.text != UFungsional){
								kreditvalas = Number(kredit) /o.txtkurs;
								debit = 0;
								debitvalas = 0;
							}else{
								kreditvalas = 0;
								debit = 0;
								debitvalas = 0;
							}
							break;
						case 'kreditvalas':
							if (txtmatauang.text != UFungsional){
								kredit = Number(kreditvalas) * o.txtkurs;
								debit = 0;
								debitvalas = 0;
							}else{
								kreditvalas = 0;
								debit = 0;
								debitvalas = 0;
							}
						case 'jumlah':
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) /o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
							break;
						case 'jumlahvalas':
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
							break;
					}
				
				FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
				FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				if(tab.selectedIndex == 0){
					dgrid = dg1;
				}else{
					dgrid = dg2;
				}
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode ="'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case "txtkontak":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif=1 and kkode ="'+txtkontak.text+'"';
						csfilter = 'kaktif=1';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.cbkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.cbkontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif=1 AND tnsumber="CB"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case "noakun":
						paket = "CdM1_Coa";
						if(tab.selectedIndex == 0){
							wsfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.dataProvider.getItemAt(dgrid.selectedCell.rowIndex).noakun+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else{
							wsfilter = '(cgd = "D" and cdc = "D" and ctipe = "1" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.dataProvider.getItemAt(dgrid.selectedCell.rowIndex).noakun+'"';
							csfilter = '(cgd = "D" and cdc = "D" and ctipe = "1" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}
						sort = 'cnomor asc';
						break;
					case "catatan":
						paket = "CdM1_Transaction_Note_Detail";
						csfilter = 'tndaktif=1 AND tndsumber="CB"';
						sort = 'tndsumber asc';
						break;
					case "costcenter":
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dgrid.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi":
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dgrid.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi":
						paket = "CdM1_Subdivision";
						wsfilter = 'sdkode = "'+dgrid.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dgrid.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'" AND sdaktif=1';
						csfilter = 'sdaktif=1 AND sddivisi="'+dgrid.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						sort = 'sdkode asc';
						break;
					case "proyek":
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+dgrid.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
					case "bank":
						paket = "CdM1_Bank";
						wsfilter = 'baktif=1 AND bkode = "'+dgrid.dataProvider.getItemAt(parentApplication.rowIndex).bank+'"';
						csfilter = 'baktif=1';
						sort = 'bkode';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				if(tab.selectedIndex == 0){
					dgrid = dg1;
				}else{
					dgrid = dg2;
				}
				var ws:Object, s:String = parentApplication.subject;
				var ob : Object ;
				if(parentApplication.wsSuccess == true){
					ws = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtkontak':
							txtkontak.text = ws.kkode;
							lblkontak.text = ws.knama;
							o.cbkontak = ws.kid;
							break;
						case 'txtkontakperson':
							txtkontakperson.text = ws.kakodekontak;
							break;
						case 'txtcatatan':
							txtcatatan.text = ws.tncatatan;
							break;
						case 'txtmatauang':
							txtkurs.text = "          ";
							txtmatauang.text = ws.ckode;
							o.txtkurs = ws.ckurs;
							txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
							for(i=0;i<dg1.dataProvider.length;i++){
								with(dg1.dataProvider.getItemAt(i)){
									matauang = txtmatauang.text;
									kurs = o.txtkurs;
								}
							}
							for(i=0;i<dg2.dataProvider.length;i++){
								with(dg2.dataProvider.getItemAt(i)){
									matauang = txtmatauang.text;
									kurs = o.txtkurs;
								}
							}
