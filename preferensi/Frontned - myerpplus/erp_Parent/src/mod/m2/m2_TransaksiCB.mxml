						for(var ii:int=0;ii<dg2.dataProviderLength;ii++){
							with(dg2.dataProvider.getItemAt(ii)){
								if(int(carabayar)==0){
									norekbank = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'GiroMasuk');
								}else{
									norekbank = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'GiroMasuk');
								}
								aa = [idcbcarabayar, idcb, int(carabayar), matauang, o.txtkurs, jumlah, jumlahvalas, 
									nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, noacbank, noakun, norekbank, catatan, 
									ii+1];
								if(ii == 0)giro = FlexGlobals.topLevelApplication.F_splitArrayToString(aa);
								else giro += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(aa);
							}
						}
						if(dg2.dataProvider.getItemAt(0).noakun == '' || dg2.dataProvider.getItemAt(0).noakun == null || dg2.dataProvider.getItemAt(0).noakun == undefined){
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_CbSimpan", parentApplication.userid, isUpdate, utama, detail+"△");
						}else{
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_CbSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+giro);
						}
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = '';
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg2);
					
					if(txtnotransaksi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(txtmatauang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0 || o.txtkurs == 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(txtkontak.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkontak,'Kontak');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					
					for(i = 0; i< dg1.dataProviderLength; i++){
						if(dg1.dataProvider[i].noakun.length <= 0){FlexGlobals.topLevelApplication.msgAlert(dg1,'No Akun')};
						if(dg1.dataProvider[i].debit == 0 && dg1.dataProvider[i].kredit == 0){FlexGlobals.topLevelApplication.msgAlert(dg1,'Jumlah Debit Kredit')};
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					
					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi == true)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						validasi = false;						
					}
					f_hitungTotal();
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg1.dataProviderLength; i++){
						dg1.dataProvider.getItemAt(i).debitvalas = dg1.dataProvider.getItemAt(i).debit/o.txtkurs;
						dg1.dataProvider.getItemAt(i).kreditvalas = dg1.dataProvider.getItemAt(i).kredit/o.txtkurs;
					}
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg1.dataProviderLength; i++){
						dg1.dataProvider.getItemAt(i).debitvalas = 0;
						dg1.dataProvider.getItemAt(i).kreditvalas = 0;
					}
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
				FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
			}
			public var vtotal:Number;
			public function f_hitungTotal():void
			{
				o.cbdebit = 0; o.cbdebitvalas = 0;
				for(i=0;i<dg1.dataProviderLength;i++){
					if(dg1.dataProvider.getItemAt(i).debit != undefined)o.cbdebit += Number(dg1.dataProvider.getItemAt(i).debit);
					if(dg1.dataProvider.getItemAt(i).debitvalas != undefined)o.cbdebitvalas += Number(dg1.dataProvider.getItemAt(i).debitvalas)
				}
				lbltotaldebit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.cbdebit);
				lbltotaldebitvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.cbdebitvalas)
				
				
				o.cbkredit = 0; o.cbkreditvalas = 0; 
				for(i=0;i<dg1.dataProviderLength;i++){
					if(dg1.dataProvider.getItemAt(i).kredit != undefined)o.cbkredit += Number(dg1.dataProvider.getItemAt(i).kredit);
					if(dg1.dataProvider.getItemAt(i).kreditvalas != undefined)o.cbkreditvalas += Number(dg1.dataProvider.getItemAt(i).kreditvalas);
				}
				lbltotalkredit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.cbkredit);
				lbltotalkreditvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.cbkreditvalas)
			}
