									dg.idsmcarabayar = 0;
									dg.idsm = o.smid;
									FlexGlobals.topLevelApplication.F_dgRefresh(dg2)
								}
								break;
							case 'costcenter':
								if (tab.selectedIndex == 0){
									dg1.dataProvider.getItemAt(parentApplication.rowIndex).costcenter = '';
									parentApplication.F_dgRefresh(dg1);
								}
								break;
							case'bank':
								if(tab.selectedIndex ==1){
									dg2.dataProvider.getItemAt(parentApplication.rowIndex).bank = '';
									FlexGlobals.topLevelApplication.F_dgRefresh(dg2)
								}
								break;
							case 'divisi':
								if (tab.selectedIndex == 0){
									dg1.dataProvider.getItemAt(parentApplication.rowIndex).divisi = '';
									parentApplication.F_dgRefresh(dg1);
								}
								break;
							case 'subdivisi':
								if (tab.selectedIndex == 0){
									dg1.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi = '';
									parentApplication.F_dgRefresh(dg1);
								}
								break;
							case 'catatan':
								if (tab.selectedIndex == 0){
									dg1.dataProvider.getItemAt(parentApplication.rowIndex).catatan = '';
									parentApplication.F_dgRefresh(dg1);
								}
								break;
							case 'proyek':
