					if(txtkurs.text.length <= 0 || o.txtkurs == 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(cmbcarabayar.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Cara Bayar');
					
					if(cmbcarabayar.selectedIndex == 1){
						for(i = 0; i< dg1.dataProviderLength; i++){
							if(dg1.dataProvider[i].noakun.length <= 0){FlexGlobals.topLevelApplication.msgAlert(dg1, 'No Akun');}
							if(dg1.dataProvider[i].jumlah == 0){FlexGlobals.topLevelApplication.msgAlert(dg1, 'Jumlah');}
						}
						for(var a:int=0; a<dg2.dataProviderLength; a++){
							if(dg2.dataProvider[a].noakun.length <= 0){FlexGlobals.topLevelApplication.msgAlert(dg2, 'No Akun Giro');}
							if(dg2.dataProvider[a].bank.length <= 0){FlexGlobals.topLevelApplication.msgAlert(dg2, 'Bank');}
							if(dg2.dataProvider[a].nogiro.length <= 0){FlexGlobals.topLevelApplication.msgAlert(dg2, 'No Giro');}
							if(dg2.dataProvider[a].jumlah == 0){FlexGlobals.topLevelApplication.msgAlert(dg2, 'Jumlah');}
							if(dg2.dataProvider[a].norek == undefined){msgAlert(dg2,'AC Bank Number', 'No AC Bank');}
						}
					}else{
						for(i = 0; i< dg1.dataProviderLength; i++){
							if(dg1.dataProvider[i].noakun.length <= 0){msgAlert(dg1,'Account Number', 'No Akun');}
							if(dg1.dataProvider[i].jumlah == 0){msgAlert(dg1,'Amount', 'Jumlah');}
						}
					}
					
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi == true)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						//return myalert;
						//\n
