//						dgrid1.isclose = 0;
//						FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
//					}
//					
//					if(dg2.dataProvider[dg2.dataProviderLength - 1].noakun == '' || dg2.dataProvider[dg2.dataProviderLength - 1].noakun == undefined){
//						var dgrid2:Object;
