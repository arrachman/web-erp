								lbltotalgiro.visible = false;
								lbltotalgirovalas.visible = false;
								lblcaptiongirovalas.visible = false;
								txtakunbank.enabled = true;
							}
							f_hitungTotal();
							break;
						case 'simpan':
							FlexGlobals.topLevelApplication.FormFilter='';
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_alertCetak(2,6,'SM', FlexGlobals.topLevelApplication.wsIdtransaksi, FlexGlobals.topLevelApplication.wsErrmessage, o.tanggal+" s.d "+o.tanggal);
							
							break;
						case 'print':
							FlexGlobals.topLevelApplication.F_openReportDefault(2,6,"smid = "+FlexGlobals.topLevelApplication.wsIdtransaksi+"");
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'noakun':
								if(tab.selectedIndex==0){
									dg=dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
									dg.idno = 0;
									dg.noakun = '';
									dg.namaakun = '';
