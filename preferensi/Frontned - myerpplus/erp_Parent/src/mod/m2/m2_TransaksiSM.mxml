//					}
					f_hitungTotal();
				}
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				var a:Number
				//				if (tab.selectedIndex==0){
				o.smjumlah = 0; o.smjumlahvalas=0;
				for(i=0;i<dg1.dataProviderLength;i++){
					if(dg1.dataProvider.getItemAt(i).jumlah > 0)o.smjumlah += Number(dg1.dataProvider.getItemAt(i).jumlah);
					if(dg1.dataProvider.getItemAt(i).jumlahvalas > 0)o.smjumlahvalas += Number(dg1.dataProvider.getItemAt(i).jumlahvalas);
				}
				
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.smjumlah);
				lbltotalvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.smjumlahvalas);
				
				//				}else if (tab.selectedIndex==1){
				o.jumlahgiro=0; o.jumlahgirovalas=0;
				for(a=0;a<dg2.dataProviderLength;a++){
					if(dg2.dataProvider.getItemAt(a).jumlah > 0)o.jumlahgiro += Number(dg2.dataProvider.getItemAt(a).jumlah);
					if(dg2.dataProvider.getItemAt(a).jumlahvalas > 0)o.jumlahgirovalas += Number(dg2.dataProvider.getItemAt(a).jumlahvalas);

				}	
				lbltotalgiro.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.jumlahgiro);
				lbltotalgirovalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.jumlahgirovalas)
				//				}
				
				
				
			}
			
			
