	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array;
			private var p:Object;
			public var o:Object = {};
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			public function f_persiapan():void
			{
				p=parentApplication;
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(6, 7);
				
				// module, menu transaksi, menu, sumber, approvell
				a = [6, 7, 14, 'Mrn', false];
				p.F_persiapanFormData(this);
				// Daftarkan fungsi-fungsi text input
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbjenislaporan,cmbstatus]);
				p.F_txtpencarian([txtlokasi, txtcabang, txtuser ]);
				p.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2, txturaian,txtcatatan]);
				txtnotransaksi2.addEventListener(FocusEvent.FOCUS_IN, f_change);
				function f_change():void{
					txtnotransaksi2.text = txtnotransaksi1.text;	
				}
				dttgl2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				gridtt.addEventListener(KeyboardEvent.KEY_DOWN, f_GRID_KEY_DOWN);
				function f_GRID_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.C:
							flash.system.System.setClipboard(gridtt.dataProvider.getItemAt(gridtt.selectedCell.rowIndex)[gridtt.columns.getItemAt(gridtt.selectedCell.columnIndex).dataField]);
							break;
					}
				}
				f_kondisiAwal();
			}
			
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				txtcabang.text = parentApplication.ucabang;
				p.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				p.F_KosongkanText([txtnotransaksi1,txtnotransaksi2,txturaian,txtuser,txturaian,txtcatatan]);
				cmbstatus.selectedIndex = o.DefaultStatus;
				o.user = txtuser.text;
				dg.dataProvider.removeAll();
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				FlexGlobals.topLevelApplication.openForm(6, 7, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).mrnid);
				
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = "laktif=1";
						wsfilter = "laktif=1 AND lkode ='"+txtlokasi.text+"'";
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = "baktif=1";
						wsfilter = "baktif=1 AND bkode ='"+txtcabang.text+"'";
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = 'uaktif=1';
						wsfilter = 'uaktif=1 AND ukode ="'+txtuser.text.split('"').join('\\"')+'"';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(p.wsSuccess == true){
					if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
					switch(s){
						
						case 'txtlokasi':
							txtlokasi.text = ws.lkode;
							break;
						case 'txtcabang':
							txtcabang.text = ws.bkode;
							break;
						case 'txtuser':
							txtuser.text = ws.ukode;
							o.user = ws.userid
							break;
					}
				}else{
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					
					case 'txtlokasi':p.F_KosongkanText([txtlokasi]);break;
					case 'txtcabang':p.F_KosongkanText([txtcabang]);break;
					case 'txtuser':p.F_KosongkanText([txtuser]);break;
				}
			}
			
			public function f_filterdata():String{
				var f:String="";
				
				var	tgl1:String = parentApplication.F_tglFormatDB(dttgl1.text), tgl2:String = parentApplication.F_tglFormatDB(dttgl2.text);
				
				f=FlexGlobals.topLevelApplication.F_standartFilter();
				if(txtnotransaksi1.text != '' && txtnotransaksi2.text != '')
					f =parentApplication.TambahFilter(f, "mrnnotransaksi BETWEEN '"+txtnotransaksi1.text.split('"').join('\\"')+"' AND '"+txtnotransaksi2.text.split('"').join('\\"')+"'");
				
//				if(dttgl1.text != '' && dttgl2.text != '')
//					f = parentApplication.TambahFilter(f, "mrntgl BETWEEN '"+tgl1+"' AND '"+tgl2+"'"); 
//				else if(dttgl1.text != '') 
//					f = parentApplication.TambahFilter(f, "mrntgl >= '"+tgl1+"'"); 
//				else if(dttgl2.text != '')
//					f = parentApplication.TambahFilter(f, "mrntgl <= '"+tgl2+"'"); 
				
				if(txturaian.text != '')
					f = parentApplication.TambahFilter(f,"mrnuraian LIKE '%"+txturaian.text.split('"').join('\\"')+"%'");
				
				if(txtcatatan.text != '')
					f = parentApplication.TambahFilter(f,"mrncatatan LIKE '%"+txtcatatan.text.split('"').join('\\"')+"%'");
				
				
				
//				if(txtcabang.text != '')
//					f = FlexGlobals.topLevelApplication.TambahFilter(f,"mrncabang = '"+txtcabang.text.split('"').join('\\"')+"'");
//				
//				if(txtlokasi.text!='')
//					f = FlexGlobals.topLevelApplication.TambahFilter(f,"mrnlokasi = '"+txtlokasi.text.split('"').join('\\"')+"'");
				
				if(txtuser.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,"mrninputuser='"+o.user+"'");
				return f;
			}
			
			public function f_hitungTotal():void{}
			[Bindable] [Embed(source="assets/nav/f.png")]  public var navf:Class;
			[Bindable] [Embed(source="assets/nav/p.png")]  public var navp:Class;
			[Bindable] [Embed(source="assets/nav/n.png")]  public var navn:Class;
			[Bindable] [Embed(source="assets/nav/l.png")]  public var navl:Class;
