				function validasiForm():void
				{
					var i:int;
					validasi = true;
					vMsg = "";
					vMsgIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(txttermin.text.length == 0){
						o.aetgljatuhtempo = dttgl.text;
					}
					if(txtsupplier.text.length <= 0)msgAlert(txtsupplier,'Supplier', 'Supplier');
					if(txtmatauang.text.length <= 0)msgAlert(txtmatauang,'Mata Uang','Currency');
					if(txtkurs.text.length <= 0)msgAlert(txtkurs,'Kurs','Rate');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(dttgl.text.length <= 0)msgAlert(dttgl,'Tanggal','Date');
					if(cmbprogress.selectedIndex < 0)msgAlert(cmbprogress,'Progress','Progress');
					
					f_hitungTotal();
				}
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.aetotal = 0;
				o.aetotalpajak1detail = 0;
				o.aetotalpajak2detail = 0;
				o.aetotaltransaksi = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).subtotal != undefined)o.aetotal += Number(dg.dataProvider.getItemAt(i).subtotal);
					if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.aetotalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.aetotalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aetotal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aetotalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aetotalpajak2detail);
				
				o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.aetotal, o.txtdiskonpersen);
				txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal);
				o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.aetotal, o.txtbiayalainpersen);
				txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal);
				f_hitungTotalUtama();
				//				o.aetotaltransaksi= (Number(o.aetotal) + Number(o.aetotalpajak1detail) + Number(o.aetotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				//				o.risisa= ((o.aetotal + o.aetotalpajak1detail + o.aetotalpajak2detail + o.txtbiayalainnominal) - o.txtdiskonnominal);
				//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aetotaltransaksi);
				//				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.risisa);
			}
			
			public function f_hitungTotalUtama():void
			{
				o.aetotaltransaksi= (Number(o.aetotal) + Number(o.aetotalpajak1detail) + Number(o.aetotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				o.risisa= ((o.aetotal + o.aetotalpajak1detail + o.aetotalpajak2detail + o.txtbiayalainnominal) - o.txtdiskonnominal);
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aetotaltransaksi);
				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.risisa);
			}
			
			public function f_hitungGrid():void{
				var dgrid:Object;
				for(i = 0; i<dg.dataProviderLength; i++){
					dgrid = dg.dataProvider[i]
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
					dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
					dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
				}
				
				f_hitungTotal();
			}
			
			public function f_setDetail():void{
