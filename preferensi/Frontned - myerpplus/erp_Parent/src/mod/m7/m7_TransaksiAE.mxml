								aediskonpersen, aejmldiskon, aetotalpajak1detail, aetotalpajak2detail, aebiayalainpersen, aebiayalain, aetotaltransaksi, 
								aejmlbayar, aerekdiskon, aerekpajak1, aerekpajak2, aerekbiayalain, aerekbayar, aeidar, 
