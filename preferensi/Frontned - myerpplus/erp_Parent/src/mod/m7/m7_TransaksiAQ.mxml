			public function f_focusOnMe():void
			{
				txtsupplier.setFocus();
			}
			
			public function msgAlert(focus: Object, indonesia: String, inggris: String):void
			{		
				if(validasi == true)focus.setFocus();
				vMsgIng += inggris+', ';
				vMsg += indonesia+', ';
				if(focus == 'clear'){
					vMsg = vMsg.substr(0, vMsg.length-4);
					vMsg += " harus diisi dengan benar terlebih dahulu";
					
					vMsgIng = vMsgIng.substr(0, vMsgIng.length-4);
					vMsgIng += " must be filled in correctly first";
					Alert.show(vMsg+" !" , "Information");}	
				validasi = false;						
			}
			
			
			protected function f_persiapan():void
			{
				ft= FlexGlobals.topLevelApplication.F_tglFormatDB;
				hf=FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tsupplier, tnogrup, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tsupplier,tgudang, turaian, ttanggal, tnotransaksi, tmatauang, tprogress, tkontakperson, tcatatan, talamatkontakperson, talamatsupplier, ttotal, ttotaltransaksi, tdiskon, tbiayalain]);
				tab.focusEnabled = false;
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				cmbcarabayar.dataProvider = new ArrayCollection([{l:'Tunai', v:1}, {l:'Kredit', v: 2}]);
				cmbasalbarang.dataProvider = new ArrayCollection([{l:'Lokal', v:1}, {l:'Import', v: 2}]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttgldipenuhi,dttglnoref]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson,txtnogrup]);
				parentApplication.F_ComboBoxStandard([cmbprogress,cmbcarabayar,cmbasalbarang]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs,txtdiskonnominal,txtbiayalainpersen,txtbiayalainnominal]);
				FlexGlobals.topLevelApplication.F_TextInputDiskonbertingkat([txtdiskonpersen]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtsupplier, txtmatauang,txtgudang,txttermin]);
				parentApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,chkauto,chkautogrup, txtkurs,txtnoref]);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_AmbilAR);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				function f_mbUpload():void {
					if(mb.menuBarItems[3].enabled==true){FlexGlobals.topLevelApplication.F_OpenUploadFile('AQ', o.aqid,txtnotransaksi.text)};
				}
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled==true)f_simpan();
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
					mb.menuBarItems[3].enabled =false;
					mb.menuBarItems[4].enabled =false;
				}
				function f_AmbilAR():void{
					if(txtmatauang.text.length > 0 ){
						FlexGlobals.topLevelApplication.F_popUpCari("AmbilAR");
					}else{
						if(txtmatauang.text.length <=0)msgAlert(txtmatauang, 'Mata Uang', 'Currency');
						if(vMsg != '' && vMsgIng != '')msgAlert('clear', '','');	
					}
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[4].enabled==true){FlexGlobals.topLevelApplication.F_OpenNotes(o.aqsumber,o.aqid,txtnotransaksi.text)};
				}
				//set persen biaya lain dan diskon
				txtdiskonnominal.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtdiskonpersen=(o.txtdiskonnominal / o.aqtotal) * 100;
					txtdiskonpersen.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtdiskonpersen);
					f_hitungTotalUtama();
				});
				
				txtbiayalainnominal.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtbiayalainpersen=(o.txtbiayalainnominal / o.aqtotal) * 100;
					txtbiayalainpersen.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtbiayalainpersen)
					f_hitungTotalUtama();
				});
				
				//set nominal biayalain dan diskon
				txtdiskonpersen.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1,o.aqtotal, o.txtdiskonpersen);
					txtdiskonnominal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtdiskonnominal);
					f_hitungTotalUtama();
				});
				
				txtbiayalainpersen.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtbiayalainnominal = o.txtbiayalainpersen/100 * o.aqtotal;
					txtbiayalainnominal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtbiayalainnominal)
					f_hitungTotalUtama();
				});
				
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
				}
				
				//change auto no grup
				chkautogrup.addEventListener(Event.CHANGE,f_changegrup);
				function f_changegrup ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkautogrup.selected ==true){
							txtnogrup.enabled =false;
							txtnogrup.text = 'Auto';
						}else{
							txtnogrup.enabled = true;
							txtnogrup.text = '';
							if(txtnogrup.enabled==true)txtnogrup.setFocus();
						}
					}else{
						if (chkautogrup.selected ==true){
							txtnogrup.enabled =false;
							txtnogrup.text = 'Auto';
						}else{
							txtnogrup.enabled =true;
							txtnogrup.setFocus();
						}
					}
				}
				
				//				cmbprogress.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(e:KeyboardEvent):void{
				//					if(e.keyCode == Keyboard.ENTER){
				//						dg.setFocus();
				//						dg.setSelectedCell(0,1);
				//					}
				//				});
				FlexGlobals.topLevelApplication.F_RegGrid(7,4,[dg],'transaksi');
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M7_AqHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						if(FlexGlobals.topLevelApplication.FormFilter != 'Jadikanaqbaru'){
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M7_AqGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else if (FlexGlobals.topLevelApplication.FormFilter == 'Jadikanaqbaru'){
							FlexGlobals.topLevelApplication.F_wsGetDataById('Aqbaru', 'M7_AqGetdataById', parentApplication.m.ArrFilter[0], 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
				}
				//end ofset getdata by id===============================================================================================
				
				
				
			}
			
