								dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi = '';
								parentApplication.F_dgRefresh(dg);
								
								break;
							case 'catatan':
								dg.dataProvider.getItemAt(parentApplication.rowIndex).catatan = '';
								parentApplication.F_dgRefresh(dg);
								
								break;
							case 'proyek': // proyek
								dg.dataProvider.getItemAt(parentApplication.rowIndex).proyek = '';
								parentApplication.F_dgRefresh(dg);
								break;
							case 'aqbaru':
							case 'tampil':
							case 'simpan':
								Alert.show(parentApplication.wsErrmessage, 'Information');
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
