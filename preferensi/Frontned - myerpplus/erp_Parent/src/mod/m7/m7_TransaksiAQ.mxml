								dgrid.pajak2 = '';
								dgrid.jmlpajak2 = 0;
								dgrid.pajak2nilai = 0;
								f_hitungTotal()
								break;
							
							case 'supplierkode':
								dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								dgrid.supplierkode = '';
								dgrid.supplier = 0;
								break;
							case 'costcenter': // Cost Center
								dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter = '';
								parentApplication.F_dgRefresh(dg);
								break;
							case 'divisi': // Divisi
								dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi = '';
								parentApplication.F_dgRefresh(dg);
								break;
							case 'subdivisi': //sub divisi
