			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							f_simpan();
						}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid1:Object;
				switch (components){
					case  'calculator':
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						switch (dataField){
							case 'jml':
							case 'harga':
							case 'diskon':
								dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
								dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml, 
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							case 'jmldiskon':
								dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0){
										Alert.show("Item Amount can't be 0 (Jumlah barang tidak boleh 0)", 'Information');
									}else if(dgrid1.harga == 0){
										Alert.show("Price can't be 0 (Harga tidak boleh 0)", "Information");
									}else if(dgrid1.jml == 0 && dgrid1.harga == 0){
										Alert.show("Item Amount and Price can't be 0 (Jumlah barang dan Harga tidak boleh 0)", "Information");
									}
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
									
								}
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							
						}
						break;
				}
				f_hitungTotal();
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array, dgrid1:Object;
				switch(column){ 
					case 'namaasset':
						dgrid1 = dg.dataProvider[dg.selectedCell.rowIndex];
						dgrid1.idaqdetail = 0; 
						dgrid1.idaq = 0; 
						dgrid1.idasset = 0;
						dgrid1.jml = 1; 
						dgrid1.satuan = "";
						dgrid1.harga = 0; 
						dgrid1.diskon = 0;
						dgrid1.jmldiskon = 0;
						dgrid1.pajak1 = "";
						dgrid1.jmlpajak1 = 0;
						dgrid1.pajak2 = ""; 
						dgrid1.jmlpajak2 = 0; 
						dgrid1.pajak1nilai = 0;
						dgrid1.pajak2nilai = 0;
						dgrid1.cabang = o.aqcabang;
						dgrid1.lokasi = o.aqlokasi;
						dgrid1.costcenter = "";
						dgrid1.divisi = "";
						dgrid1.subdivisi = "";
						dgrid1.proyek = ""; 
						dgrid1.catatan = ""; 
						dgrid1.urutan = 0; 
						dgrid1.idardetail = 0;
						dgrid1.jmlao = 0; 
						dgrid1.statusao = 0; 
						dgrid1.jmlae = 0; 
						dgrid1.statusae = 0; 
						dgrid1.jmlai = 0; 
						dgrid1.statusai = 0; 
						dgrid1.jmlrealisasi = 0; 
						dgrid1.statusrealisasi = 0; 
						dgrid1.isclose = 0; 
						dgrid1.customtext1 = ""; 
						dgrid1.customtext2 = ""; 
						dgrid1.customtext3 = ""; 
						dgrid1.customdbl1 = 0; 
						dgrid1.customdbl2 = 0; 
						dgrid1.customdbl3 = 0; 
						dgrid1.customdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
						dgrid1.customdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
						dgrid1.customdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
						break
					case 'jml':
					case 'harga':
					case 'diskon':
						dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
						dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml, 
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'jmldiskon':
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
						if(dgrid1.jml == 0 || dgrid1.harga == 0){
							if(dgrid1.jml == 0){
								Alert.show("Quantity can't be 0 (Jumlah tidak boleh 0)", 'Information');
							}else if(dgrid1.harga == 0){
								Alert.show("Price can't be 0 (Harga tidak boleh 0)", "Information");
							}else if(dgrid1.jml == 0 && dgrid1.harga == 0){
								Alert.show("Quantity and Price can't be 0 (Jumlah dan Harga tidak boleh 0)", "Information");
							}
							dgrid1.jmldiskon = 0;
							dgrid1.diskon= 0;
						}else{
							dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
							
						}
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'pajak1':
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'pajak2':
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
				}
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, id:String = '', csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtsupplier":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif="1" and kkategori="S" and kkode ="'+txtsupplier.text+'"';
						csfilter = 'kaktif="1" and kkategori="S"';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.aqsupplier+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.aqsupplier+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtgudang":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode="'+txtgudang.text+'"';
						csfilter = 'waktif=1';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break;
					case "txttermin":
						paket = "CdM1_Terms";
