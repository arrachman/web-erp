				o.aq2alamat1 = ""; o.aq2alamat2 = ""; o.aq2alamat3 = ""; o.aqbagianpembelian = 0; 
				o.aqtgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aqtglpenutupan = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aqhargatermasukpajak = 0; o.aqtotal = 0; o.aqdiskonpersen = 0; o.aqdiskon = 0; o.aqtotalpajak1detail = 0; 
				o.aqtotalpajak2detail = 0; o.aqbiayalainpersen = 0; o.aqbiayalain = 0; o.aqtotaltransaksi = 0; 
				o.aqidar = 0; o.aqstatusao = 0; o.aqstatusae = 0; o.aqstatusai = 0; 
				o.aqstatusrealisasi = 0; o.aqstatussebelumnya = 0; o.aqjmlrevisi = 0; o.aqcetakanke = 0; 
				o.aqinputuser = FlexGlobals.topLevelApplication.userid; o.aqinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aqmodifikasiuser = 0; o.aqmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aqposting = 0; o.aqpostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.aqisclose = 0; 
				o.aqcustomtext1 = ""; o.aqcustomtext2 = ""; 
				o.aqcustomtext3 = ""; o.aqcustomtext4 = ""; o.aqcustomtext5 = ""; 
				o.aqcustomint1 = 0; o.aqcustomint2 = 0; o.aqcustomint3 = 0; o.aqcustomdbl1 = 0; 
				o.aqcustomdbl2 = 0; o.aqcustomdbl3 = 0; 
				o.aqcustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aqcustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aqcustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
				
				
				chkautogrup.selected = true;
