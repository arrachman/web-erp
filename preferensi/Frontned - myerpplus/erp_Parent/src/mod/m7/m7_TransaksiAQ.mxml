				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.aqtotal = 0;
				o.aqtotalpajak1detail = 0;
				o.aqtotalpajak2detail = 0;
				o.aqtotaltransaksi = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).subtotal != undefined)o.aqtotal += Number(dg.dataProvider.getItemAt(i).subtotal);
					if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.aqtotalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.aqtotalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aqtotal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aqtotalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aqtotalpajak2detail);
				
				o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.aqtotal, o.txtdiskonpersen);
				txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal);
				o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.aqtotal, o.txtbiayalainpersen);
				txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal);
				f_hitungTotalUtama();
				//				o.aqtotaltransaksi= (Number(o.aqtotal) + Number(o.aqtotalpajak1detail) + Number(o.aqtotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aqtotaltransaksi);
			}
			
			public function f_hitungTotalUtama():void
			{
				o.aqtotaltransaksi= (Number(o.aqtotal) + Number(o.aqtotalpajak1detail) + Number(o.aqtotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aqtotaltransaksi);
			}
			
			public function f_hitungGrid():void{
				var dgrid:Object;
				for(i = 0; i<dg.dataProviderLength; i++){
					dgrid = dg.dataProvider[i]
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
					dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
					dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
				}
				
				f_hitungTotal();
			}
			
