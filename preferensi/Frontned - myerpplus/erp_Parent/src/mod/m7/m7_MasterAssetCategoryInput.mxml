<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="442" height="244"
		  creationComplete="f_persiapan();">
	<fx:Script source="KeyNavigator.as"/>
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				dg = p.m[p.idmodcurr].child.dg;
				FlexGlobals.topLevelApplication.F_TranslateLabel([lblkode, lblnama, lblkatpajak, lblrekaktiva, lblrekakumdepresiasi, lblrekdepresiasi]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([lblkode, lblnama, lblkatpajak, lblrekaktiva, lblrekakumdepresiasi, lblrekdepresiasi]);
				FlexGlobals.topLevelApplication.F_txtInOut(txtkode,'','M7_Asset_CategoryCekId');
				F_txtpencarian([txtkelompok,txtaktiva,txtdepresiasi,txtakudepre]);
				parentApplication.F_configMasterInput();
				F_SetNavigasiKeyboard([txtkode, txtnama, txtumur, txtpenyusutan,txtmetode]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ackode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].acnama;
					txtumur.text = dg.dataProvider[dg.selectedCell.rowIndex].ackategoripajakumur;
					txtmetode.text = dg.dataProvider[dg.selectedCell.rowIndex].ackategoripajakmetodenama;
					txtpenyusutan.text = dg.dataProvider[dg.selectedCell.rowIndex].ackategoripajakpenyusutan;
					txtkelompok.text = dg.dataProvider[dg.selectedCell.rowIndex].ackategoripajak;
					txtaktiva.text = dg.dataProvider[dg.selectedCell.rowIndex].acrekasset;
					txtdepresiasi.text = dg.dataProvider[dg.selectedCell.rowIndex].acrekdepresiasi;
					txtakudepre.text = dg.dataProvider[dg.selectedCell.rowIndex].acrekakumdepresiasi;
					vUserIdEdit = parentApplication.userid;
					//if (dg.dataProvider[dg.selectedCell.rowIndex].itaktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtumur,txtpenyusutan]);
				
				txtaktiva.text = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'Aset');
				txtdepresiasi.text = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'Depresiasi');
				txtakudepre.text = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'AkumDepresiasi');
				//chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					arr = [txtkode.text,txtnama.text,txtkelompok.text,txtakudepre.text,txtdepresiasi.text,txtaktiva.text,vUserId,
						vDefDt,vUserIdEdit,vDefDt,'','','','','',0,0,0,0,0,0,vDefDt,vDefDt,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M7_Asset_CategorySimpan', utama, 'ackode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkelompok':
						paket = 'CdM7_Asset_Category_Tax';
						wsfilter = "actkode = '"+ txtkelompok.text +"'";
						break;
					case 'txtaktiva':
						paket = 'CdM1_Coa';
						wsfilter = "cgd = 'D' AND cnomor = '"+txtaktiva.text+"'";
						csfilter = "cgd = 'D'";
						break;
					case 'txtdepresiasi':
						paket = 'CdM1_Coa';
						wsfilter = "cgd = 'D' AND cnomor = '"+txtdepresiasi.text+"'";
						csfilter = "cgd = 'D'";
						break;
					case 'txtakudepre':
						paket = 'CdM1_Coa';
						wsfilter = "cgd = 'D' AND cnomor = '"+txtakudepre.text+"'";
						csfilter = "cgd = 'D'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){
						case 'txtkelompok':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtkelompok.text = o.actkode;
							txtumur.text = o.actumur;
							txtmetode.text = o.actmetodenama;
							txtpenyusutan.text = o.actpenyusutan;
							break;
						case 'txtaktiva':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtaktiva.text = o.cnomor;
							break;
						case 'txtdepresiasi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtdepresiasi.text = o.cnomor;
							break;
						case 'txtakudepre':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtakudepre.text = o.cnomor;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtkelompok':break;
							case 'txtaktiva':break;
							case 'txtdepresiasi':break;
							case 'txtakudepre':break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkelompok':parentApplication.F_KosongkanText([txtkelompok]);break;
					case 'txtaktiva':parentApplication.F_KosongkanText([txtaktiva]);break;
					case 'txtdepresiasi':parentApplication.F_KosongkanText([txtdepresiasi]);break;
					case 'txtakudepre':parentApplication.F_KosongkanText([txtakudepre]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="lblkode" left="10" top="46" text="Kode"/>
	<s:Label id="lblnama" left="10" top="68" text="Nama"/>
	<s:Label id="lblkatpajak" left="10" top="89" text="Kelompok Aktiva Tetap Pajak"/>
	<s:Label left="10" top="110" text="Metode"/>
	<s:Label left="10" top="132" text="Umur Ekonomis Pajak"/>
	<s:Label left="10" top="153" text="Tarif Penyusutan Pajak"/>
	<s:Label id="lblrekaktiva" left="10" top="175" text="Rek.Aktiva"/>
	<s:Label id="lblrekdepresiasi" left="10" top="197" text="Rek.Depresiasi"/>
	<s:Label id="lblrekakumdepresiasi" left="11" top="219" text="Rek.Akumulasi Depresiasi"/>
	<s:Label y="150" left="276" height="12" text="%"/>
	<s:Label y="130" left="276" height="12" text="Bulan"/>
	<s:TextInput id="txtkode" y="40" left="187" width="87" maxChars="3"/>
	<s:TextInput id="txtnama" maxChars="50" left="187" right="10" top="61"/>
	<s:TextInput id="txtkelompok" left="187" top="82" width="87"/>
	<s:TextInput id="txtmetode" y="103" left="187" width="245" enabled="false" />
	<s:TextInput id="txtpenyusutan" y="145" left="187" width="87" enabled="false" textAlign="right"/>
	<s:TextInput id="txtumur" left="187" top="124" width="87" enabled="false" textAlign="right"/>
	<s:TextInput id="txtaktiva" left="187" top="166" width="87"/>
	<s:TextInput id="txtdepresiasi" left="187" top="187" width="87"/>
	<s:TextInput id="txtakudepre" left="187" top="208" width="87"/>
	<s:Label id="lblaktiva" left="301" top="172"/>
	<s:Label id="lbldepresiasi" left="301" top="193"/>
	<s:Label id="lblakudepre" left="301" top="214"/>
</s:Module>
