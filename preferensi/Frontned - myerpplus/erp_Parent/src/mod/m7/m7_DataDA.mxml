					<topmenu label="Reset" icon="tbreset"/>
					<topmenu label="Tambah" icon="tbadd"/>
					<topmenu label="Cetak" icon="tbprint">
						<topmenu label="PDF" icon="tbpdf" data="0"/>
						<topmenu label="Ms.Excel" icon="tbexcel" data="1"/>
						<topmenu label="Html" icon="tbhtml" data="2"/>
						<topmenu label="Ms.Word" icon="tbword" data="3"/>
						<topmenu label="Text" icon="tbtxt" data="4"/>
						<topmenu label="Image" icon="tbtif" data="5"/>
