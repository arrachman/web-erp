			}
			
// pengisian filter untuk report =========================================================
			public function f_filterdata():String{
				var f:String="";
				if(cmbstatus.textInput.text.length == 0){
					
				}else if(cmbstatus.textInput.text == 'Semua'){
					cmbstatus.selectedIndex = 0;
				}else if(cmbstatus.textInput.text == 'Aktif'){
					cmbstatus.selectedIndex = 1;
					f = p.TambahFilter(f, "Dastatus = 2 OR "+f+"status = 3 OR "+f+"status = 4 OR "+f+"status = 7");
				}else{
					f = p.TambahFilter(f, "Dastatus = "+cmbstatus.selectedItem.v);
				}
				
				if(txtnotransaksi1.text != '' && txtnotransaksi2.text != '')
					f = p.TambahFilter(f, 'Danotransaksi BETWEEN "'+txtnotransaksi1.text+'" AND "'+txtnotransaksi2.text+'"');
				
				if(dttgl1.text != '' && dttgl2.text != '')
					f = p.TambahFilter(f, 'Datgl BETWEEN "'+p.F_tglFormatDB(dttgl1.text)+'" AND "'+p.F_tglFormatDB(dttgl2.text)+'"'); 
				else if(dttgl1.text != '') 
					f = p.TambahFilter(f, 'Datgl >= "'+p.F_tglFormatDB(dttgl1.text)+'"'); 
				else if(dttgl2.text != '')
					f = p.TambahFilter(f, 'Datgl <= "'+p.F_tglFormatDB(dttgl2.text)+'"'); 
				
				if(txturaian.text != '')
					f = p.TambahFilter(f, 'Dauraian LIKE "%'+txturaian.text+'%"');
				return f;
			}
			
