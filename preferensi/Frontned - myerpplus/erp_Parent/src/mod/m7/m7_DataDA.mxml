// persiapan persiapan ======================================================================	
			public function f_persiapan():void
			{
				p=parentApplication;
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnotranskasi, ttanggal, turaian, tjenislaporan, tstatus]);
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(7, 12);												//(ambil report dari database)
