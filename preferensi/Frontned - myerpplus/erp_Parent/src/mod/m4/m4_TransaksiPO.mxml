										lblsupplier.text = ws.knama;
										parentApplication.vpVarCurrent = txtsupplier.text;
										o.posupplier = ws.kid
										txaalamatsupplier.text = ws.k1alamat1+'\n'+ws.k1alamat2;
										txaalamatkontakperson.text = ws.k2alamat1+'\n'+ws.k2alamat2;
										o.supplierkode = ws.kkode;
										o.supplier = ws.kid;
										o.suppliernama = ws.knama;
										o.kpkp = ws.kpkp;
										FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
									}else{
										txtsupplier.text = o.supplierkode;
										parentApplication.vpVarCurrent = txtsupplier.text;
										o.posupplier = o.supplier;
										lblsupplier.text = o.suppliernama;
									}
								});
							}else{
								txtsupplier.text = ws.kkode;
								lblsupplier.text = ws.knama;
								o.posupplier = ws.kid
								txaalamatsupplier.text = ws.k1alamat1+'\n'+ws.k1alamat2;
								txaalamatkontakperson.text = ws.k2alamat1+'\n'+ws.k2alamat2;
								o.supplierkode = ws.kkode;
								o.supplier = ws.kid;
								o.suppliernama = ws.knama;
								o.kpkp = ws.kpkp;
							}
							
							break;
						case 'txtkontakperson':
							ws = parentApplication.wsArrUtama.getItemAt(0)
							txtkontakperson.text = ws.kakodekontak;
							break;
						case 'txtgudang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
