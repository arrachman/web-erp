				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.pototal = 0;
				o.pototalpajak1detail = 0;
				o.pototalpajak2detail = 0;
				o.pototaltransaksi = 0;
				o.totalbiaya = 0;
				for(i=0;i<dg.dataProvider.length;i++){
					if(dg.dataProvider.getItemAt(i).subtotal != undefined)o.pototal += Number(dg.dataProvider.getItemAt(i).subtotal);
					if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.pototalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.pototalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
				
				for(var m:int = 0; m<dgbiaya.dataProviderLength; m++){
					if(dgbiaya.dataProvider.getItemAt(m).jumlah > 0 && dgbiaya.dataProvider.getItemAt(m).kurs > 0){
						o.totalbiaya += (Number(dgbiaya.dataProvider.getItemAt(m).jumlah) * Number(dgbiaya.dataProvider.getItemAt(m).kurs));
					}
				}
				
				lbltotalbiaya.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totalbiaya); 
				
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pototal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pototalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pototalpajak2detail);
				
				o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.pototal, o.txtdiskonpersen);
				txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal);
				o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.pototal, o.txtbiayalainpersen);
				txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal);
				f_hitungTotalUtama();
//				o.pototaltransaksi= (Number(o.pototal) + Number(o.pototalpajak1detail) + Number(o.pototalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pototaltransaksi);
			}
			
			public function f_hitungTotalUtama():void
			{
				if(chkhargapajak.selected == false){
					o.pototaltransaksi= (Number(o.pototal) + Number(o.pototalpajak1detail) + Number(o.pototalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				}else{
					o.pototaltransaksi= (Number(o.pototal) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				}
				
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pototaltransaksi);
			}
			
			public function f_hitungGrid():void{
				var dgrid:Object;
				for(i = 0; i<dg.dataProviderLength; i++){
					dgrid = dg.dataProvider[i]
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
//					dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
//					dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
					
					dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.pajak1nilai, dgrid.subtotal, dgrid.pajak1nilai, dgrid.pajak2nilai);
					dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.pajak2nilai, dgrid.subtotal, dgrid.pajak1nilai, dgrid.pajak2nilai);
				}
				
				f_hitungTotal();
			}
			
			protected function chkhargapajak_changeHandler(event:Event):void
			{
				// TODO Auto-generated method stub
				for(var Index:int = 0; Index<dg.dataProviderLength; Index++){
					var dgrid1:Object;
					dgrid1 = dg.dataProvider[Index];
					if(chkhargapajak.selected == true){
						dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(true, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(true, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
					}else{
						dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(false, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(false, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
					}
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
