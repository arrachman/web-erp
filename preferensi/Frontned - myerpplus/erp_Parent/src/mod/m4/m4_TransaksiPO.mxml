			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtsupplier':parentApplication.F_KosongkanText([txtsupplier, lblsupplier]);break;
					case 'txtgudang':parentApplication.F_KosongkanText([txtgudang, lblgudang]);break;
					case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang,txtkurs]);break;
					case 'txttermin':parentApplication.F_KosongkanText([txttermin]);break;
				}
			}
			
			
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, cost:String = "", tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
						
						//Set Utama
						with(o){
							a = [poid, pocabang, polokasi, txtgudang.text, poasalbarang, 0, pojenispembelian, 
								pojenispembeliankategori, 0, posumber, int(chkauto.selected), txtnotransaksi.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), pokodepa, 
								posupplier, txtkontakperson.text, txaalamatsupplier.text, po1alamat2, po1alamat3, txaalamatkontakperson.text, po2alamat2, 
								po2alamat3, pobagianpembelian, FlexGlobals.topLevelApplication.F_tglFormatDB(potgldipenuhi), txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgljt.text), txturaian.text, txtcatatan.text, 
								txtnoref.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttglnoref.text), FlexGlobals.topLevelApplication.F_tglFormatDB(potglpenutupan), txtmatauang.text, o.txtkurs, int(chkhargapajak.selected), pototal, 
								o.txtdiskonpersen, o.txtdiskonnominal, pototalpajak1detail, pototalpajak2detail, o.txtbiayalainpersen, o.txtbiayalainnominal, pototaltransaksi, 
								pojmlbayar, porekdiskon, porekpajak1, porekpajak2, porekbiayalain, porekbayar, poidpr, 
								poidcs, poidrq, poidbs, postatusipc, postatusgrn, postatusri, postatusdnr, 
								postatusprt, cmbprogress.selectedItem.v, postatussebelumnya, pojmlrevisi, pocetakanke, poinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(poinputtgl), 
								pomodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(pomodifikasitgl), poisclose, pocustomtext1, pocustomtext2, pocustomtext3, pocustomtext4, 
								pocustomtext5, pocustomint1, pocustomint2, pocustomint3, pocustomdbl1, pocustomdbl2, pocustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(pocustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(pocustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(pocustomdate3)];
							utama = f_splitArrayToString(a);
						}
						//Set Detail
						for(i=0;i<dg.dataProviderLength;i++){
							with(dg.dataProvider.getItemAt(i)){
								a = [idpodetail, idpo, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, o.txtkurs, Number(hargafix), harga, 
									diskon, jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, 
									lokasi, gudang, costcenter, divisi, subdivisi, proyek, catatan, 
									(i+1), idprdetail, idcsdetail, idrqdetail, idbsdetail, jmlipc, statusipc, 
									jmlgrn, statusgrn, jmlri, statusri, jmldnr, statusdnr, jmlprt, 
									statusprt, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
									customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail =f_splitArrayToString(a);
								else detail += "▲"+f_splitArrayToString(a);
							}
						}
				
						// Set Cost
						for(var ib:int=0;ib<dgbiaya.dataProviderLength;ib++){
							with(dgbiaya.dataProvider.getItemAt(ib)){
								if(dgbiaya.dataProvider.getItemAt(ib).idpocost != undefined){
									a = [idpocost, idpo, kodecost, matauang, kurs, jumlah, rekdebit, 
										rekkredit, kontak, termasukhpp, catatan, costcenter, divisi, subdivisi, 
										proyek, ib+1, idprcost, idcscost, idrqcost, idbscost, jumlahipc, 
										statusipc, jumlahgrn, statusgrn, jumlahri, statusri, jumlahbayar, statusbayar, 
										isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(ib == 0)cost = f_splitArrayToString(a);
									else cost += "▲"+f_splitArrayToString(a);
								}
								
							}
						}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M4_PoSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+cost);
						
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					if(txttermin.text.length == 0){
						o.potgljatuhtempo= dttgl.text;
					}
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(txtsupplier.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtsupplier,'Supplier');
					if(txtmatauang.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(txtnotransaksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					for(i=0; i< dg.dataProviderLength; i++){
						if(dg.dataProvider.getItemAt(i).kodebarang == '' || dg.dataProvider.getItemAt(i).kodebarang == undefined)FlexGlobals.topLevelApplication.msgAlert(dg,'Kode Barang');
						if(dg.dataProvider.getItemAt(i).jml.length <= 0 || dg.dataProvider.getItemAt(i).jml == 0)FlexGlobals.topLevelApplication.msgAlert(dg,'Jumlah');
