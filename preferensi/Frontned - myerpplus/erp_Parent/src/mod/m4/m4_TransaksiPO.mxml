			public function format (textinput:Object, param:String):void{
				var b:Object = {}
				param = String(param).split(FlexGlobals.topLevelApplication.m.nfNominal.decimalSeparator).join('.');
				b.temp = param.split('+');
				if(b.temp.length > 1){
					b.s = FlexGlobals.topLevelApplication.m.nfNominal.format(b.temp[0]);
					for(i=1;i<b.temp.length;i++)
						b.s += "+"+FlexGlobals.topLevelApplication.m.nfNominal.format(b.temp[i]);
					textinput.text = b.s;
				}else {
					textinput.text = FlexGlobals.topLevelApplication.m.nfNominal.format(param);
				}
			}
			public function f_wsHasil():void
			{
				parentApplication.vpVarCurrent = txtsupplier.text;
				var ws:Object, s:String = parentApplication.subject, sort:String='';
				if(parentApplication.wsSuccess == true){
					switch(s){	
						
						case 'txtsupplier':
							o.cekid = false;
							ws = parentApplication.wsArrUtama.getItemAt(0);
							
							for(i = 0; i<dg.dataProviderLength; i++){
								if(dg.dataProvider[i].idrqdetail > 0 && dg.dataProvider[i].idrqdetail != undefined){
									o.cekid = true; 
								}
							}
							
							if(o.cekid == true && o.supplierkode != ws.kkode){
								
								Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
									if(e.detail == Alert.YES){
