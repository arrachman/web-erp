				o.pojenispembeliankategori=0; o.posumber='PO'; o.pokodepa=0; 
				o.posupplier=0; o.po1alamat1=txaalamatsupplier.text; o.po1alamat2=''; o.po1alamat3=''; o.po2alamat1=txaalamatkontakperson.text; o.po2alamat2='';
				o.po2alamat3=''; o.pobagianpembelian=FlexGlobals.topLevelApplication.ukontak; o.potgldipenuhi=FlexGlobals.topLevelApplication.m.DateFirst; o.potgljatuhtempo= dttgl.text;
				o.potglpenutupan=FlexGlobals.topLevelApplication.m.DateFirst; o.pohargatermasukpajak=0; o.pototal=0; 
				o.podiskonpersen=0; o.pojmldiskon=0; o.pototalpajak1detail=0; o.pototalpajak2detail=0; o.pobiayalainpersen=0; o.pobiayalain=0; o.pototaltransaksi=0; 
