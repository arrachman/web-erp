			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_PoHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
							FlexGlobals.topLevelApplication.m.ArrFilter[0]
							if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
								idtransaksi = parentApplication.m.ArrFilter[0];
								idtransaksi = idtransaksi.replace('p1  = "', '');
								idtransaksi = idtransaksi.replace('"', '');
								FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_PoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}else{
								if(FlexGlobals.topLevelApplication.m.ArrFilter == "copyTransaksi"){
									FlexGlobals.topLevelApplication.F_wsGetDataById('copyTransaksi', 'M4_PoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
								}else{
									f_kondisiAwal();
									FlexGlobals.topLevelApplication.F_wsGetDataById('tampilRQ', 'M4_RqGetdataById',FlexGlobals.topLevelApplication.m.ArrFilter[0], 0, 0, FlexGlobals.topLevelApplication.m.ArrFilter[1], 'urutan ASC', FlexGlobals.topLevelApplication.m.formatDate, FlexGlobals.topLevelApplication.m.formatDate);
								}
							}
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_PoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							mb.menuBarItems[4].enabled =true;
							mb.menuBarItems[5].enabled =true;
						}
					}
				}
				ttotalbiaya.text = "Total Biaya ["+FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional')+"]"
				//end ofset getdata by id===============================================================================================
			}
