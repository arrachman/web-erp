										ws = parentApplication.wsArrUtama.getItemAt(0);
										txtmatauang.text = ws.ckode;
										o.txtkurs = ws.ckurs;
										txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
										for(i=0;i<dg.dataProvider.length;i++){
											with(dg.dataProvider.getItemAt(i)){
												matauang = txtmatauang.text;
												kurs = o.txtkurs;
											}
										}
										if(txtmatauang.text != UFungsional){
											txtkurs.enabled = true;
										}else{txtkurs.enabled = false;}
									}else{
										txtmatauang.text = uang;
										txtkurs.text = FlexGlobals.topLevelApplication.F_formatNominal(o.txtkurs);
									}
								});
							}else{
								ws = parentApplication.wsArrUtama.getItemAt(0);
								txtmatauang.text = ws.ckode;
								o.txtkurs = ws.ckurs
