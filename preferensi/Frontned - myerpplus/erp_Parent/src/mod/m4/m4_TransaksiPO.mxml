							for(i=0;i<dg.dataProvider.length;i++){
								with(dg.dataProvider.getItemAt(i)){
									gudang = txtgudang.text;
								}
							}
							break;
						case 'txtmatauang':
							var cekuang:Boolean, uang:String='';
							cekuang = false;
							for(i=0;i<dg.dataProvider.length;i++){
								if(((dg.dataProvider.getItemAt(i).idprdetail != undefined && dg.dataProvider.getItemAt(i).idprdetail != 0) || (dg.dataProvider.getItemAt(i).idrqdetail != undefined && dg.dataProvider.getItemAt(i).idrqdetail != 0)) && dg.dataProvider.getItemAt(i).matauang != parentApplication.wsArrUtama.getItemAt(0).ckode){
									cekuang = true; uang = dg.dataProvider.getItemAt(i).matauang;
								}
