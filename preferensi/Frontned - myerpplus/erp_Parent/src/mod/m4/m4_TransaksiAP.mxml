		<fx:Script> 
			<![CDATA[			
				import MyClass.SettingNoTransaction;
				
				import mx.collections.ArrayCollection;
				import mx.controls.Alert;
				import mx.core.FlexGlobals;
				import mx.events.CalendarLayoutChangeEvent;
				import mx.events.FlexEvent;
				
				import spark.components.Image;
				import spark.components.NumericStepper;
				import spark.components.RadioButton;
				
				public var validasi:Boolean,pesanAlertIng:String,	pesanAlert:String, img:Image, UFungsional:String, 
				i:int,fu:Object, isUpdate:Boolean, hf:Object, ft:Object, uangPO:String;;
				public  var o:Object={};
				public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number;
				[Bindable]protected var arrMenuBar:ArrayCollection;
				public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction, terminharijatuhtempo:Number = 0;
				public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
				{
					switch (components){
						case  'calculator':
							dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
							if(Number(data) > 0){
								if(txtmatauang.text == UFungsional){
									if(dataField == 'jumlahvalas'){
										Alert.show(FlexGlobals.topLevelApplication.l('Jumlah Valas harus 0 karena mata uang fungsional'), FlexGlobals.topLevelApplication.l('Informasi'));
										dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = 0;
									}
									
								}else{
									if(dataField == 'jumlahvalas'){
										dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = data;
										dg.dataProvider[dg.selectedCell.rowIndex].jumlah = dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas * o.txtkurs;
										
									}
									if(dataField == 'jumlah'){
										dg.dataProvider[dg.selectedCell.rowIndex].jumlah = data;
										dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = dg.dataProvider[dg.selectedCell.rowIndex].jumlah / o.txtkurs;
									}
								}
							}
							break;
					}
					f_hitungTotal();
					f_hitungvalas();
					
				}
				public function f_focusOnMe():void
				{
					cmbjenis.setFocus();
				}
				
				protected function f_persiapan():void
				{
					ft= FlexGlobals.topLevelApplication.F_tglFormatDB;
					hf=FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
					FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
					tab.focusEnabled = false;
					
					//setting editable tanggal
					if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
					else dttgl.enabled = false;
					FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
					
					
					fu=FlexGlobals.topLevelApplication.m.nfNominal.format;
					UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
					FlexGlobals.topLevelApplication.F_RequiredLabel([tjenis, tsupplier, takun, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs]);
					FlexGlobals.topLevelApplication.F_TranslateLabel([tjenis, tsupplier, takun, tnopo, turaian, ttanggal, tnotransaksi, tmatauang, tkurs, tprogress,
					tkontakperson, ttermin, tbagianpembayaran, talamatsupplier, talamatkontakperson, tcostcenter, tdivisi, tsubdivisi, tproyek]);
					
					cmbjenis.selectedIndex=0;
					FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
					cmbjenis.dataProvider = new ArrayCollection([{l:'UM Pembelian',v:0},{l:'Titipan',v:1}]);
					FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttanggalnoref, dttgljt]);
					FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress,cmbjenis]);
					FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
					FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
					FlexGlobals.topLevelApplication.F_txtpencarian([txtsupplier, txtnopo,txtakun,txtmatauang,txttermin,txtbagpembayaran,txtcostcenter,txtdivisi,txtsubdivisi,txtproyek]);
					FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,txtnoref,chkauto,chkposting]);
					tab.tabFocusEnabled = false;
					
					// fungsi menubar
					arrMenuBar = new ArrayCollection([
								{label:"Simpan", icon:"tbsave", enabled:"true"},
								{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
								{label:"Reset", icon:"tbreset", enabled:"true"},
								{label:"Catatan", icon:"tbnote", enabled:"false"},
								{label:"File", icon:"tbattachment", enabled:"false"},
								{label:"Links", icon:"tblink", enabled:"false"},
								{label:"History", icon:"tbhistory", enabled:"true"},
								{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
					FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
					
					mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
					mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
					mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
					mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
					mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
					mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
					
					function f_mbSimpan():void
					{
						f_delundefined(dg);
						if(mb.menuBarItems[0].enabled ==true){
							var jenissimpan:int = 1;
							if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(4,8,jenissimpan)==true){
								f_simpan();
							}
						}
					}
					function f_mbBuka():void
					{
						FlexGlobals.topLevelApplication.f_bukaTransaksi("Ap"); 
					}
					function f_mbReset():void{
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
						f_kondisiAwal(); 
					}
					function f_mbCatatan():void{
						if (mb.menuBarItems[3].enabled==true){FlexGlobals.topLevelApplication.F_OpenNotes(o.apsumber,o.apid,txtnotransaksi.text);}
					}
					function f_mbUpload():void {
						if(mb.menuBarItems[4].enabled==true){FlexGlobals.topLevelApplication.F_OpenUploadFile('AP',o.apsumber,txtnotransaksi.text)};
					}
					function f_mbLinks():void
					{
						if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(4,'Ap');
					}
					
					this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
					function f_KEY_DOWN(e:KeyboardEvent):void
					{
						switch(e.keyCode){
							case Keyboard.S:if(e.ctrlKey)
								if(mb.menuBarItems[0].enabled ==true){
									var jenissimpan:int = 1;
									if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
									if(FlexGlobals.topLevelApplication.apaBisaAkses(4,8,jenissimpan)==true){
										f_simpan();
									}
								}
								break;
						}
					}
					chkposting.addEventListener(KeyboardEvent.KEY_DOWN, function keydown(e:KeyboardEvent):void{
						if(e.keyCode == Keyboard.ENTER || e.keyCode == Keyboard.DOWN){
							dg.setSelectedCell(0,1)
						}
					});
					
					// untuk ambil setting dari Json
					//FlexGlobals.topLevelApplication.F_setGridJson(4, 8);
					FlexGlobals.topLevelApplication.F_RegGrid(4,8,[dg],'transaksi');
					f_validasi();
				}
				public function f_validasi():void{
					//set getdata by id===============================================================================================
					var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
					var idtransaksi :String = filtersplit[0];
					if(FlexGlobals.topLevelApplication.FormFilter == ''){
						f_kondisiAwal();
					}else{
						if(filtersplit.length > 1){
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_ApHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else {
							if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
								idtransaksi = parentApplication.m.ArrFilter[0];
								idtransaksi = idtransaksi.replace('p1  = "', '');
								idtransaksi = idtransaksi.replace('"', '');
								FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_ApGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}else{
								FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_ApGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}
						}
					}
					//end ofset getdata by id===============================================================================================
				}
				
				protected function f_kondisiAwal():void
				{
					cmbprogress.enabled = true;
					mb.menuBarItems[0].enabled = true;
					mb.menuBarItems[3].enabled = false;
					mb.menuBarItems[4].enabled = false;
					mb.menuBarItems[5].enabled = false;
					mb.menuBarItems[6].visible = false;
					mb.menuBarItems[7].visible = false;
					cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Need Approval', v:1}, {l:'Approved', v:2}]);
					tab.selectedIndex=0;
					cmbprogress.selectedIndex=2;
					txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
					matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
					uangPO = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
					o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
					txtkurs.text = fu(o.txtkurs);
					txtkurs.enabled = false;
					f_focusOnMe(); 
					isUpdate = false;
					txtakun.text= FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'UMPembelian');//Ambil dari m0_setting 'kode coa'
					lblakun.text= FlexGlobals.topLevelApplication.getSetting(0, 'akunnama', 'UMPembelian');//Ambil dari m0_setting 'nama coa'
					txtnotransaksi.text = 'Auto';		
					txturaian.text = parentApplication.getNomor("AP");
					txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("AP",1);
					parentApplication.F_SetNilaiText([dttgl,dttanggalnoref, dttgljt], parentApplication.DefaultTanggal);
					parentApplication.F_KosongkanText([txtsupplier, txtnopo, lblsupplier,txtkontakperson,txtnoref,txaalamatkontakperson,txaalamatsupplier,txtcostcenter,txtdivisi,txtsubdivisi,txttermin,txtproyek]);
					txtbagpembayaran.text = FlexGlobals.topLevelApplication.ukontakkode;
					lblbagpembelian.text = FlexGlobals.topLevelApplication.ukontaknama;
					FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalvalas],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
					o.apid = 0; o.apcabang = FlexGlobals.topLevelApplication.ucabang; o.aplokasi = FlexGlobals.topLevelApplication.ulokasi; o.apsumber="AP"; 
					o.apkodepa = 0; o.apkontak = 0; o.ap1alamat1 = txaalamatsupplier.text; o.ap1alamat2 = ''; o.ap1alamat3 = ''; 
					o.ap2alamat1 = txaalamatkontakperson.text; o.ap2alamat2 = ''; o.ap2alamat3 = ''; o.aptgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal; o.apidpo = 0; 
					o.apjumlah = 0; o.apjumlahvalas = 0; o.apjumlahbayar = 0; o.apjumlahbayarvalas = 0; o.apstatusbayar = 0; o.aptgllunas = parentApplication.m.DateFirst; 
					o.apstatussebelumnya = 0; o.apjmlrevisi = 0; o.apcetakanke = 0; 
					o.apinputuser = FlexGlobals.topLevelApplication.userid; o.apinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
					o.apmodifikasiuser = 0; o.apmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.apisclose = 0; o.apcustomtext1 = ''; 
					o.apcustomtext2 = ''; o.apcustomtext3 = ''; o.apcustomtext4 = ''; o.apcustomtext5  = '';
					o.apcustomint1 = 0; o.apcustomint2 = 0; o.apcustomint3 = 0; 
					o.apcustomdbl1 = 0; o.apcustomdbl2 = 0; o.apcustomdbl3 = 0; 
					o.apcustomdate1 = parentApplication.m.DateFirst; o.apcustomdate2 = parentApplication.m.DateFirst; 
					o.apcustomdate3 = parentApplication.m.DateFirst;
					o.apbagianpembayaran = FlexGlobals.topLevelApplication.ukontak;
					
					settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				}
				
				public function f_grid(dg:DataGrid, column:String):void
				{ 
					//dg.setSelectedCell(0,0);
					switch(column){
						case 'jumlah':
							with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
								if (txtmatauang.text != UFungsional){
									jumlahvalas = Number(jumlah) / o.txtkurs;
								}else{
									jumlahvalas = 0;
								}
							}
							
							break;
						case 'jumlahvalas':
							with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
								if (txtmatauang.text != UFungsional){
									jumlah = Number(jumlahvalas) * o.txtkurs;
								}else{
									jumlahvalas = 0;
								}
							}
							break;
						case 'bank':
						case 'nogiro':
						case 'noacbank':
							editable();
							break;
							
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
					f_hitungTotal()
					f_hitungvalas()
				}
				public function editable():void{
					if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==0 || dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==3){
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = '';
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).noacbank = '';
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank_enabled = 0;
						//Alert.show('Bank, No Giro, No AC Bank tidak dapat diisi, karena cara bayar '+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayarnama+'','Information');
					}
					
					else {
						if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar == 1){
							dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
							//Alert.show('No Giro tidak dapat diisi, karena cara bayar '+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayarnama+'','Information');
							
						}
					}
				}
				
				public function f_filter(target:String):Array
				{
					var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, dgrid:Object;
					if(dg.selectedCell != null)dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
					switch(target){
						case 'txtnopo':
							if(txtnopo.enabled == true){
								if(txtsupplier.text.length > 0){
									paket = 'CdM4_Po';
									wsfilter = '(postatus= 2 OR postatus=3) AND (posupplier ='+o.apkontak+' AND poisclose=0) and (pomatauang = "'+txtmatauang.text+'") and ponotransaksi="'+ txtnopo.text +'"';
									csfilter = '(postatus= 2 OR postatus=3) AND (posupplier ='+o.apkontak+' AND poisclose=0) and (pomatauang = "'+txtmatauang.text+'")';
									sort = 'ponotransaksi desc';
								}else{
									Alert.show(FlexGlobals.topLevelApplication.l('Silahkan isi Supplier terlebih dahulu !'), FlexGlobals.topLevelApplication.l('Informasi'));
								}
							
							}
							break;
						case 'txtsupplier':
							paket = 'CdM1_Contact';
							wsfilter = '(kaktif = 1 AND kkategori="S") AND kkode ="'+txtsupplier.text+'"';
							csfilter = '(kaktif = 1 AND kkategori="S")';
							csfield = 2;
							sort = 'kkode asc';
							break;
						case "txtkontakperson":
							paket = "CdM1_Contact_Attention";
							wsfilter = 'kaidkontak ='+o.apkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
							csfilter = 'kaidkontak ='+o.apkontak+'';
							csfield = 2;
							sort = 'kakodekontak asc';
							break;
						case "txtakun":
							paket = "CdM1_Coa";
							wsfilter = 'caktif=1 AND cgd="D" AND cnomor ="'+txtakun.text+'"';
							csfilter = 'caktif=1 AND cgd="D"';
							csfield = 2;
							sort = 'cnomor asc';
							break;
						case "txtmatauang":
							paket = "CdM1_Currency";
							wsfilter = 'caktif = 1 AND ckode = "'+ txtmatauang.text +'"';
							csfilter = 'caktif=1';
							sort = 'ckode asc';
							break;
						case "txtcatatan":
							paket = "CdM1_Transaction_Note";
							csfilter = 'tnaktif = 1 AND tnsumber = "AP"';
							sort = 'tnkode asc';
							break;
						case "txttermin":
							paket = "CdM1_Terms";
							wsfilter = 'traktif = 1 AND trkode = "'+ txttermin.text +'"';
							csfilter = 'traktif=1';
							sort = 'trkode asc';
							break;
						case "txtbagpembayaran":
							paket = "CdM1_Contact";
							wsfilter = '(kaktif = 1 AND kkategori="K") AND kkode ="'+txtbagpembayaran.text+'"';
							csfilter = '(kaktif = 1 AND kkategori="K")';
							csfield = 4;
							sort = 'kkode asc';
							break;
						case "txtcostcenter":
							paket = "CdM1_Cost_Center";
							wsfilter = 'ccaktif = 1 AND cckode = "'+ txtcostcenter.text +'"';
							csfilter = 'ccaktif=1';
							sort = 'cckode asc';
							break;
						case "txtdivisi":
							paket = "CdM1_Division";
							wsfilter = 'daktif = 1 AND dkode = "'+ txtdivisi.text +'"';
							csfilter = 'daktif=1';
							sort = 'dkode asc';
							break;
						case "txtsubdivisi":
							paket = "CdM1_Subdivision";
							wsfilter = 'sdaktif = 1 AND sddivisi = "'+ txtdivisi.text +'" AND sdkode = "'+ txtsubdivisi.text +'"';
							csfilter = 'sdaktif = 1 AND sddivisi = "'+ txtdivisi.text +'"';
							sort = 'sdkode asc';
							break;
						case "txtproyek":
							paket = "CdM1_Project";
							wsfilter = 'paktif = 1 AND pkode = "'+ txtproyek.text +'"';
							csfilter = 'paktif=1';
							sort = 'pkode asc';
							break;
						case "carabayarnama":
							paket = "CdM0_Carabayar";
							wsfilter = 'nama = "'+dgrid.carabayarnama+'"';
							break;
						case "rekbank":
							paket = "CdM1_Coa";
							if (dgrid.carabayar=="0"){
								wsfilter = '(cgd="D" and caktif=1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
								csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
							}else if (dgrid.carabayar=="1"){
								wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
								csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
							}else if (dgrid.carabayar=="2"){
								wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
								csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
							}else if (dgrid.carabayar=="3"){
								wsfilter = '(cgd="D" and caktif=1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
								csfilter = '(cgd ="D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
							}else if (dgrid.carabayar == '' || dgrid.carabayar == undefined){
								wsfilter = 'Asdfsdf';
								csfilter = 'Asdfsdfsdf';
							}
							sort = 'cnomor asc';
							break;
						case "bank":
							if(dgrid.carabayar == 1 || dgrid.carabayar == 2){
								paket = "CdM1_Bank";
								wsfilter = 'baktif = 1 AND bkode = "'+dgrid.bank+'"';
								csfilter = 'baktif=1';
								sort = 'bkode asc';
							}
							break;
						case 'catatan':
							paket = 'CdM1_Transaction_Note_Detail';
							csfilter = "tndaktif=1 AND tndsumber='AP'";
							break;
					}
					return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
				}

				public function f_wsHasil():void
				{
					var ws:Object, s:String = parentApplication.subject;
					var ob : Object;
					if(FlexGlobals.topLevelApplication.wsSuccess == true){
						
						switch(s){	
