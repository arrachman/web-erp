									apinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(apinputtgl), apmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(apmodifikasitgl), int(chkposting.selected), apisclose, apcustomtext1, 
									apcustomtext2, apcustomtext3, apcustomtext4, apcustomtext5, apcustomint1, apcustomint2, apcustomint3, 
									apcustomdbl1, apcustomdbl2, apcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(apcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(apcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(apcustomdate3)];
								utama = f_splitArrayToString(a);
							}
							// Set Detail
							for(var c:int=0; c<dg.dataProviderLength; c++){
								with(dg.dataProvider.getItemAt(c)){
									if(carabayar == 2){
										rekgiro = FlexGlobals.topLevelApplication.getSetting(0,'akun','GiroKeluar');
									}else{
										rekgiro = "";
									}
									
									a = [idapcarabayar, idap, carabayar, matauang, kurs, jumlah, jumlahvalas, 
										nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, noacbank, rekbank, rekgiro, catatan, 
										c+1, isclose];
									if(detail == '')detail =f_splitArrayToString(a);
									else detail += "▲"+f_splitArrayToString(a);
								}
							}
							
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M4_ApSimpan", FlexGlobals.topLevelApplication.userid, isUpdate, utama, detail);
						}
					}
					
					function validasiForm():void
					{
						var i:int;
						validasi = true;
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
						pesanAlert = "";
						pesanAlertIng = '';
						if(txtsupplier.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtsupplier,'Supplier');
						if(txtakun.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtakun,'Akun', 'Account');
						if(txtmatauang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
						if(txtkurs.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs', 'Rate');
						if(txtnotransaksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
						if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal', 'Date');
						if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
						if(cmbjenis.selectedIndex == 0){
							if(txtnopo.text.length <= 0){
								FlexGlobals.topLevelApplication.msgAlert(txtnopo, 'No. PO');
							}
						}
						
						for(i = 0; i<dg.dataProviderLength; i++){
							if(dg.dataProvider[i].carabayarnama == '' || dg.dataProvider[i].carabayarnama == undefined){FlexGlobals.topLevelApplication.msgAlert(dg,'Cara Bayar');}
							
							if(dg.dataProvider[i].rekbank == '' || dg.dataProvider[i].rekbank == undefined){FlexGlobals.topLevelApplication.msgAlert(dg,'No Akun');}
						}
						
						if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');
						if(txttermin.text.length == 0){
							o.aptgljatuhtempo = dttgl.text;
						}
						
						
						function msgAlert(focus: Object, indonesia: String, inggris: String):void
						{		
							if(validasi == true)focus.setFocus();
							pesanAlertIng += inggris+', ';
							pesanAlert += indonesia+', ';
							if(focus == 'clear'){
								pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
								pesanAlert += " harus diisi dengan benar terlebih dahulu";
								
								pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
								pesanAlertIng += " must be filled";
								Alert.show(pesanAlert+" !" , "Information");}	
							validasi = false;						
						}
						
						f_hitungTotal();
						f_hitungvalas()
					}
					
					
					function f_splitArrayToString(a:Array):String
					{
						var s:String, j:int;
						for(j=0;j<a.length;j++){
							if(j==0)s = a[j];
							else s += "▼"+a[j];
						}
						return s;
					}
				}
				
				private var vtotal:Number=0,vvalas:Number=0;
				public function f_hitungTotal():void
				{
					o.apjumlah=0;  o.apjumlahvalas=0;
					for(var i:int=0;i<dg.dataProvider.length;i++){
						o.apjumlah += Number(dg.dataProvider.getItemAt(i).jumlah)
						o.apjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas)
					}
					lbltotal.text = fu(o.apjumlah);
					lbltotalvalas.text = fu(o.apjumlahvalas);
				}
				
				public function f_hitungvalas():void{
					if(txtmatauang.text != UFungsional){
						txtkurs.enabled=true;
						for(i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).jumlahvalas = dg.dataProvider.getItemAt(i).jumlah/o.txtkurs;
						}
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
					}else{
						txtkurs.enabled=false;
						for(i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).jumlahvalas = 0;
						}
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
					}
				}
				
				protected function chkauto_clickHandler(event:MouseEvent):void
				{
					if (chkauto.selected==true)txtnotransaksi.enabled=false;
					else txtnotransaksi.enabled=true;
				}
				
				protected function dttgl_changeHandler(event:CalendarLayoutChangeEvent):void
				{
					dttgljt.text = FlexGlobals.topLevelApplication.F_tglJatuhTempo(dttgl.text,terminharijatuhtempo);
				}
				
				
