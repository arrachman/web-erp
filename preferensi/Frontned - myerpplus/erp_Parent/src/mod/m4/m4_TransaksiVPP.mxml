				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				//set total detail
				o.totalRI = 0; o.totalRIvalas = 0; o.totalAP = 0; o.totalAPvalas = 0;  o.totalPRT = 0; o.totalPRTvalas = 0; o.totalCOA = 0; o.totalCOAvalas = 0; 
				o.diskonterminRI = 0; o.diskonterminAP = 0; o.diskonterminPRT = 0; 
				o.diskonterminRIvalas = 0; o.diskonterminAPvalas = 0; o.diskonterminPRTvalas = 0;
				o.totaltransaksiRI = 0; o.totaltransaksiAP = 0; o.totaltransaksiPRT = 0; o.totaltransaksiCOA = 0; o.totaltransaksiBYR = 0;
				o.terbayarRI = 0; o.terbayarAP = 0; o.terbayarPRT = 0;
				o.sisaRI = 0; o.sisaAP = 0; o.sisaPRT = 0;
				//set total bawah
				o.vpptotalap = 0; o.vpptotalapvalas = 0; o.vpptotalar = 0; o.vpptotalarvalas = 0; o.vppselisihkurs = 0;
				o.vppdiskontermin = 0; o.vppdiskonterminvalas =  0; o.vppbayar = 0; o.vppbayarvalas = 0;
				//dgRI
				for(i = 0; i< dgRI.dataProviderLength; i++){
					if(dgRI.dataProvider[i].chk == true){
						o.totalRI += Number(dgRI.dataProvider[i].jmlbayar);
						o.totalRIvalas += Number(dgRI.dataProvider[i].jmlbayarvalas);
						o.diskonterminRI += Number(dgRI.dataProvider[i].jmldiskontermin);
						o.diskonterminRIvalas += Number(dgRI.dataProvider[i].jmldiskonterminvalas);
						// hitung total tiap tiap tab
						o.totaltransaksiRI += Number(dgRI.dataProvider[i].totaltransaksi);
						o.terbayarRI += Number(dgRI.dataProvider[i].terbayar);
						o.sisaRI = Number(o.totaltransaksiRI - o.terbayarRI);
					}
				}
				//dgAP
				for(i = 0; i< dgAP.dataProviderLength; i++){
					if(dgAP.dataProvider[i].chk == true){
						o.totalAP += Number(dgAP.dataProvider[i].jmlbayar);
						o.totalAPvalas += Number(dgAP.dataProvider[i].jmlbayarvalas);
						o.diskonterminAP += Number(dgAP.dataProvider[i].jmldiskontermin);
						o.diskonterminAPvalas += Number(dgAP.dataProvider[i].jmldiskonterminvalas);
						// hitung total tiap tiap tab
						o.totaltransaksiAP += Number(dgAP.dataProvider[i].totaltransaksi);
						o.terbayarAP += Number(dgAP.dataProvider[i].terbayar);
						o.sisaAP = Number(o.totaltransaksiAP - o.terbayarAP);
					}
				}
				//dg PRT
				for(i = 0; i< dgPRT.dataProviderLength; i++){
					if(dgPRT.dataProvider[i].chk == true){
						o.totalPRT += Number(dgPRT.dataProvider[i].jmlbayar);
						o.totalPRTvalas += Number(dgPRT.dataProvider[i].jmlbayarvalas);
						o.diskonterminPRT += Number(dgPRT.dataProvider[i].jmldiskontermin);
						o.diskonterminPRTvalas += Number(dgPRT.dataProvider[i].jmldiskonterminvalas);
						// hitung total tiap tiap tab
						o.totaltransaksiPRT += Number(dgPRT.dataProvider[i].totaltransaksi);
						o.terbayarPRT += Number(dgPRT.dataProvider[i].terbayar);
						o.sisaPRT = Number(o.totaltransaksiPRT - o.terbayarPRT);
					}
				}
				//dg Coa
				for(i = 0; i< dgCOA.dataProviderLength; i++){
					if(dgCOA.dataProvider.getItemAt(i).jmlbayar != undefined){o.totalCOA += Number(dgCOA.dataProvider[i].jmlbayar);}
					if(dgCOA.dataProvider.getItemAt(i).jmlbayarvalas != undefined){o.totalCOAvalas += Number(dgCOA.dataProvider[i].jmlbayarvalas);}
					// hitung total tiap tiap tab
					if(dgCOA.dataProvider.getItemAt(i).jmlbayar != undefined){o.totaltransaksiCOA += Number(dgCOA.dataProvider[i].jmlbayar);}
				}
				//dg Bayar
				for(i = 0; i< dgBayar.dataProviderLength; i++){
					if(dgBayar.dataProvider.getItemAt(i).jumlah != undefined){o.totaltransaksiBYR += Number(dgBayar.dataProvider[i].jumlah);}
				}
				
				//hitungtotalap
				o.vpptotalap = o.totalRI + o.totalCOA;
				o.vpptotalapvalas = o.totalRIvalas + o.totalCOAvalas;
				//hitungtotalar
				o.vpptotalar = o.totalAP + o.totalPRT;
				o.vpptotalarvalas = o.totalAPvalas + o.totalPRTvalas;
				//hitung diskon termin
				o.vppdiskontermin = o.diskonterminRI + o.diskonterminAP + o.diskonterminPRT;
				o.vppdiskonterminvalas = o.diskonterminRIvalas + o.diskonterminAPvalas + o.diskonterminPRTvalas;
				//hitung selisih kurs
				if(txtmatauang.text != UFungsional){
					o.vppselisihkurs = o.vpptotalap - o.vpptotalar - o.vppdiskontermin - ((o.vpptotalapvalas - o.vpptotalarvalas - o.vppdiskonterminvalas) * o.txtkurs);
				}
				//hitungbayar
				o.vppbayar = o.vpptotalap - o.vpptotalar - o.vppdiskontermin -  o.vppselisihkurs;
				o.vppbayarvalas = o.vpptotalapvalas - o.vpptotalarvalas - o.vppdiskonterminvalas;
				//set label
				lbltotalAP.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vpptotalap); lbltotalAPvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vpptotalapvalas);
				lbltotalAR.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vpptotalar); lbltotalARvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vpptotalarvalas);
				lbldiskontermin.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vppdiskontermin); lbldiskonterminvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vppdiskonterminvalas);
				lblselisihkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vppselisihkurs);
				lblbayar.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vppbayar); lblbayarvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.vppbayarvalas);
				// set label tiap tiap tab
				lbltotaltransaksiRI1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiRI); lbltotaltransaksiAP1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiAP); lbltotaltransaksiPRT1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiPRT);
				lblterbayarRI1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.terbayarRI); lblterbayarAP1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.terbayarAP); lblterbayarPRT1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.terbayarPRT);
				lblsisaRI1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sisaRI); lblsisaAP1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sisaAP); lblsisaPRT1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sisaPRT);
				lbltotaltransaksiCOA1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiCOA); lbltotaltransaksiBYR1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiBYR);
			}
			
			protected function f_dinamikValueGrid(dg:DataGrid, rowIndex:int):void{
				with(dg.dataProvider.getItemAt(rowIndex)){
					if(vUang == txtmatauang.text)
						jmlbayarvalas = 0;
					else jmlbayarvalas = jmlbayar/h.getItemAt(0).kurs;
					diskontermin = f_diskonTermin(dttglbayar.text, '', tgl, haridiskon1, haridiskon2, diskon1, diskon2);
					jmldiskontermin = jmlbayar*(diskontermin/100);
					jmldiskonterminvalas = jmlbayarvalas*(diskontermin/100); 
				}
			}
			
			protected function f_diskonTermin(tglbayar:String, tglgiro:String, tgl:String, haridiskon1:int, haridiskon2:int, diskon1:int, diskon2:int):int
			{
				var tglselisih:int, i:int;
				if(tglbayar == '')
					return 0;
				if(tglgiro == '')tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglbayar, tgl)
				else tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglbayar, tglgiro);
				if(tglselisih <= haridiskon1)
					return diskon1;
				else if(tglselisih <= haridiskon2)
					return diskon2;
				else return 0;
			}
			
			protected function dvd_dividerPressHandler(event:DividerEvent):void
			{
				if(tab.selectedIndex == 0){
					if(boxfilter1.height < 5){
						lbl1.text = 'Sembunyikan Filter';
						btnexpand.visible = false;
						btncollapse.visible = true;
					}else{
						lbl1.text = 'Tampilkan Filter';
						btnexpand.visible = true;
						btncollapse.visible = false;
					}
				}
					
				else if(tab.selectedIndex == 1){
					if(boxfilter2.height < 5){
						lbl2.text = 'Sembunyikan Filter';
						btnexpand2.visible = false;
						btncollapse2.visible = true;
					}else{
						lbl2.text = 'Tampilkan Filter';
						btnexpand2.visible = true;
						btncollapse2.visible = false;
					}
				}
					
				else if(tab.selectedIndex == 2){
					if(boxfilter3.height < 5){
						lbl3.text = 'Sembunyikan Filter';
						btnexpand3.visible = false;
						btncollapse3.visible = true;
					}else{
						lbl3.text = 'Tampilkan Filter';
						btnexpand3.visible = true;
						btncollapse3.visible = false;
					}
				}
			}
			
			public var loop:int = -1;
			public function f_uangRefreshGrid():void
			{
				loop++;
				if(dgRI.dataProvider.length > 0 && dgRI.dataProvider[0].notransaksi != '' && loop == 0){
					FlexGlobals.topLevelApplication.F_wsSearch('Vpp_TakeData', 'M4_VppTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dgAP.dataProvider.length > 0 && dgAP.dataProvider[0].notransaksi != '' && loop == 1){
					FlexGlobals.topLevelApplication.F_wsSearch('Vpp_TakeData', 'M4_VppTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dgPRT.dataProvider.length > 0 && dgPRT.dataProvider[0].notransaksi != '' && loop == 2){
					FlexGlobals.topLevelApplication.F_wsSearch('Vpp_TakeData', 'M4_VppTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(loop < 3)f_uangRefreshGrid();
				if(loop > 2){ cekfilter = false; }
			}
			
