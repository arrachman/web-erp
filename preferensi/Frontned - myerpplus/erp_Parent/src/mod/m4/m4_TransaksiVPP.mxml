								with(dgBayar.dataProvider.getItemAt(i)){
									a = [idvppcarabayar, idvpp, carabayar, matauang, kurs, jumlah, jumlahvalas, 
										nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, noacbank, rekbank, rekgiro, catatan, 
										urutan, jmlvp, jmlvpvalas, statusvp, isclose];
									if(i == 0)pay =f_splitArrayToString(a);
									else pay += "▲"+f_splitArrayToString(a);
								}
							}
						}else{
							pay = '';
						}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M4_VppSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+pay);
						
					}
				}
				
