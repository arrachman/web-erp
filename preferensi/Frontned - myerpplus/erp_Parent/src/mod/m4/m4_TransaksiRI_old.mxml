										FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate3),txtgudang.text, nbtidbatchin];
									if(b == 0){batch = f_splitArrayToString(a);}
									else {batch += "▲"+f_splitArrayToString(a);}
								}
							}
						}
						//set serial
						if(ac_Serial.length <= 0){
							serial = '';
						}else{
							for(var s:int=0;s<ac_Serial.length; s++){
								with(ac_Serial.getItemAt(s)){
									a = [nstid, nstjenismutasi, nstidbarang, nstkode, nstsumber, nstidtransaksi, nstsatuan, 
