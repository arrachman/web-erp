								jmlvalas = 0;
							}else{
								jmlvalas = o.ritotaltransaksi;
							}
							arrpay.addItem({idricarabayar:0, idri:0, carabayar: 0, matauang:txtmatauang.text, kurs:o.txtkurs, jumlah:Number(o.ritotaltransaksi) * Number(o.txtkurs), jumlahvalas:jmlvalas, 
								nogiro:"", tgljt:FlexGlobals.topLevelApplication.DefaultTanggal, bank:"", noacbank:"", 
								rekbank: vrektunai, rekgiro:"", catatan:"", 
								urutan:0, isclose:0});
						}else{
							arrpay.removeAll()
						}
						if(txttermin.text.length > 0){
							dttgljt.text = dttgljt.text;
						}else{
							dttgljt.text = o.sitgljatuhtempo;
						}
						//Set Utama
						with(o){
							a = [riid, ricabang, rilokasi, txtgudang.text, cmbasalbarang.selectedIndex, riasalbarangkategori, rijenispembelian, 
								cmbjenispembelian.selectedIndex, cmbcarabayar.selectedIndex, risumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), rikodepa, 
