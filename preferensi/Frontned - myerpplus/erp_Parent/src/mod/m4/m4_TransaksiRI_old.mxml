								riidpo, riidipc, riidgrn, ristatusdnr, ristatusprt, cmbprogress.selectedItem.v, ristatussebelumnya, 
								rijmlrevisi, ricetakanke, riinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(riinputtgl), rimodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(rimodifikasitgl), int(chkposting.selected), 
								ritutupperiode, riisclose, ricustomtext1, ricustomtext2, ricustomtext3, ricustomtext4, ricustomtext5, 
