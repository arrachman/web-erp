								ri2alamat3, ribagianpembelian, txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgljt.text), txturaian.text, txtcatatan.text, txtnoref.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttglnoref.text), FlexGlobals.topLevelApplication.F_tglFormatDB(ritglpenutupan), txtmatauang.text, o.txtkurs, int(chkhargapajak.selected), ritotal, o.txtdiskonpersen, 
								o.txtdiskonnominal, ritotalpajak1detail, ritotalpajak2detail, o.txtbiayalainpersen, o.txtbiayalainnominal, 
								ritotaltransaksi, rijmlbayar, 
