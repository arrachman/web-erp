					case 'txtbagpembelian':parentApplication.F_KosongkanText([txtbagpembelian, lblbagpembelian]);break;
				}
			}
			
			
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, batch:String, serial:String, biaya:String = "", pay:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
						
						arrpay.removeAll();
