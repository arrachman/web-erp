				function f_SetHargaPO():void {
					filterPO=''; filterGRN='';
					if(mb.menuBarItems[6].enabled == true){
						for(i=0; i<dg1.dataProviderLength; i++){
							if (dg1.dataProvider.getItemAt(i).idpodetail != 0) {
								if (filterPO == ''){
									filterPO = 'idpodetail = ' + dg1.dataProvider.getItemAt(i).idpodetail +'';
								}else{
									filterPO += ' OR idpodetail = ' + dg1.dataProvider.getItemAt(i).idpodetail +'';
								}
							}else if (dg1.dataProvider.getItemAt(i).idgrndetail != 0) {
								if (filterGRN == ''){
									filterGRN = 'idgrndetail = ' + dg1.dataProvider.getItemAt(i).idgrndetail +'';
								}else{
									filterGRN += ' OR idgrndetail = ' + dg1.dataProvider.getItemAt(i).idgrndetail +'';
								}
							}
						}
						if(filterPO != '' && filterGRN != ''){FlexGlobals.topLevelApplication.F_wsSearch('POdetailSearch', 'M4_Po_Detail_VSearch', 0, 0, filterPO, '');}
						else if(filterPO != ''){FlexGlobals.topLevelApplication.F_wsSearch('POdetailSearch', 'M4_Po_Detail_VSearch', 0, 0, filterPO, '');}
						else if(filterGRN != ''){FlexGlobals.topLevelApplication.F_wsSearch('GRNdetailSearch', 'M4_Grn_Detail_VSearch', 0, 0, filterGRN, '');}
					}
				}
				
				
