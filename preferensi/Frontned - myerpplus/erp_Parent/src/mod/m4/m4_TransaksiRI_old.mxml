									if(s == 0){serial = f_splitArrayToString(a);}
									else {serial += "▲"+f_splitArrayToString(a);}
								}
							}
						}
						
						//Set Biaya
						if(dgbiaya.dataProvider[0].idricost != undefined){
							
							for(i=0;i<dgbiaya.dataProviderLength;i++){
								with(dgbiaya.dataProvider[i]){
									
									a = [idricost, idri, kodecost, matauang, kurs, jumlah, catatan, 
										costcenter, divisi, subdivisi, proyek, i+1, idprcost, idcscost, 
										idrqcost, idbscost, idpocost, idipccost, idgrncost, jumlahbayar, statusbayar, 
										isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3), rekdebit, rekkredit,
										kontak, termasukhpp];
									if(i == 0)biaya =f_splitArrayToString(a);
									else biaya += "▲"+f_splitArrayToString(a);
								}
							}
						}
						
						//Set Pay
						if(arrpay.length > 0){
							for(i=0;i<arrpay.length; i++){
								with(arrpay.getItemAt(i)){
									a = [idricarabayar, idri, carabayar, matauang, kurs, jumlah, jumlahvalas, 
										nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, noacbank, rekbank, rekgiro, catatan, 
										i+1, isclose];
									if(i == 0){pay = FlexGlobals.topLevelApplication.F_splitArrayToString(a);}
									else {pay += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);}
								}
							}
						}else{
							pay = ""
						}
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M4_RiSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+batch+"△"+serial+"△"+biaya+"△"+pay);
						
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					if(txttermin.text.length == 0){
						o.ritgljatuhtempo = dttgl.text;
					}
					if(txtsupplier.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtsupplier,'Supplier');
					if(txtmatauang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(txtnotransaksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					
					for(i=0; i< dg1.dataProviderLength; i++){
						if(dg1.dataProvider.getItemAt(i).kodebarang.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dg1,'Kode Barang');
						if(dg1.dataProvider.getItemAt(i).jml.length <= 0 || dg1.dataProvider.getItemAt(i).jml == 0)FlexGlobals.topLevelApplication.msgAlert(dg1,'Jumlah');
						if(dg1.dataProvider.getItemAt(i).satuan.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dg1,'Satuan');
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');
					f_hitungTotal();
				}
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.ritotal = 0;
				o.totalbiaya = 0;
				o.ritotal = 0;
				o.ritotalpajak1detail = 0;
				o.ritotalpajak2detail = 0;
				o.ritotaltransaksi = 0;
//				if(tab.selectedIndex == 0){
					for(i=0;i<dg1.dataProviderLength;i++){
						if(dg1.dataProvider.getItemAt(i).subtotal != undefined)o.ritotal += Number(dg1.dataProvider.getItemAt(i).subtotal);
						if(dg1.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.ritotalpajak1detail += Number(dg1.dataProvider.getItemAt(i).jmlpajak1);
						if(dg1.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.ritotalpajak2detail += Number(dg1.dataProvider.getItemAt(i).jmlpajak2);
					}
//				}
					for(var m:int = 0; m<dgbiaya.dataProviderLength; m++){
						if(dgbiaya.dataProvider.getItemAt(m).jumlah > 0 && dgbiaya.dataProvider.getItemAt(m).kurs > 0){
							o.totalbiaya += (Number(dgbiaya.dataProvider.getItemAt(m).jumlah) * Number(dgbiaya.dataProvider.getItemAt(m).kurs));
						}
					}
				
				lbltotalbiaya.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totalbiaya); 
				
				lbltotaldetail.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ritotal); 
//				o.ritotal = Number(o.ritotal);
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ritotal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ritotalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ritotalpajak2detail);
				
				o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.ritotal, o.txtdiskonpersen);
				txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal);
				o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.ritotal, o.txtbiayalainpersen);
				txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal);
				f_hitungTotalUtama();
//				o.ritotaltransaksi= (Number(o.ritotal) + Number(o.ritotalpajak1detail) + Number(o.ritotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
//				o.risisa= ((o.ritotal + o.ritotalpajak1detail + o.ritotalpajak2detail + o.txtbiayalainnominal) - o.txtdiskonnominal);
//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ritotaltransaksi);
//				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.risisa);
			}
			
			public function f_hitungTotalUtama():void
			{
				if(chkhargapajak.selected == false){
					o.ritotaltransaksi= (Number(o.ritotal) + Number(o.ritotalpajak1detail) + Number(o.ritotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
					o.risisa= ((o.ritotal + o.ritotalpajak1detail + o.ritotalpajak2detail + o.txtbiayalainnominal) - o.txtdiskonnominal);
				}else{
					o.ritotaltransaksi= (Number(o.ritotal) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
					o.risisa= ((o.ritotal + o.txtbiayalainnominal) - o.txtdiskonnominal);
				}
				
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.ritotaltransaksi);
				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.risisa);
				if(cmbcarabayar.selectedIndex == 0){
					txtjmlbayar.text = parentApplication.m.nfNominal.format(o.ritotaltransaksi);
				}
			}
			
			public function f_hitungGrid():void{
				var dgrid:Object;
				for(i = 0; i<dg1.dataProviderLength; i++){
					dgrid = dg1.dataProvider[i]
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
//					dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
//					dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
					dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.pajak1nilai, dgrid.subtotal, dgrid.pajak1nilai, dgrid.pajak2nilai);
					dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.pajak2nilai, dgrid.subtotal, dgrid.pajak1nilai, dgrid.pajak2nilai);
				}
				
				f_hitungTotal();
			}
			
