							utama = f_splitArrayToString(a);
						}
						//Set Detail
						for(i=0;i<dg1.dataProviderLength;i++){
							with(dg1.dataProvider.getItemAt(i)){
								a = [idridetail, idri, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, o.txtkurs, Number(hargafix), harga, 
									diskon, jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, 
									lokasi, gudang, rekpersediaan, rekdiskonpembelian, rekhutangsementara, costcenter, divisi, 
									subdivisi, proyek, catatan, (i+1), idprdetail, idcsdetail, idrqdetail, 
									idbsdetail, idpodetail, idipcdetail, idgrndetail, jmldnr, statusdnr, jmlprt, 
									statusprt, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
									customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail =f_splitArrayToString(a);
								else detail += "▲"+f_splitArrayToString(a);
							}
						}
						
						if(ac_Batch.length <= 0){
							batch = "";
						}else{
							for(var b:int=0; b<ac_Batch.length; b++){
								with(ac_Batch.getItemAt(b)){
									a = [nbtid, nbtjenismutasi, nbtidbarang, nbtkode, nbtsumber, nbtidtransaksi, nbtsatuan, 
										nbtjml, nbtcustomtext1, nbtcustomtext2, nbtcustomtext3, nbtcustomdbl1, nbtcustomdbl2, nbtcustomdbl3, 
