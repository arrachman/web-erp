			protected function cmbjenispembelian_changeHandler(event:IndexChangeEvent):void
			{
				this.callLater(nanti);
				// TODO Auto-generated method stub
				
				
				function nanti():void
				{
					o.cekid = false;
					for(i = 0; i<dg1.dataProviderLength; i++){
						if(dg1.dataProvider[i].kodebarang != ""){
							o.cekid = true; 
						}
					}
					if(o.cekid == true){
						Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
							if(e.detail == Alert.YES){
								if(cmbjenispembelian.selectedIndex ==0){
									mb.menuBarItems[4].enabled = true;
									mb.menuBarItems[5].enabled = false;
									
									dg1.columns.getItemAt(1).editable = false;//kodebarang
									dg1.columns.getItemAt(5).editable = false;//satuan
									dg1.columns.getItemAt(7).editable = false;//harga
									dg1.columns.getItemAt(8).editable = false;//diskon
									dg1.columns.getItemAt(9).editable = false;//jumlah diskon
									dg1.columns.getItemAt(12).editable = false;//pajak1
									dg1.columns.getItemAt(14).editable = false;//pajak2
									
									//FlexGlobals.topLevelApplication.F_setGridJson(4, 11);
								}else{
									mb.menuBarItems[4].enabled = false;
									mb.menuBarItems[5].enabled = true;
									//FlexGlobals.topLevelApplication.F_setGridJson(4, 6);
									dg1.columns.getItemAt(1).editable = true;//kodebarang
									dg1.columns.getItemAt(5).editable = true;//satuan
									dg1.columns.getItemAt(7).editable = true;//harga
									dg1.columns.getItemAt(8).editable = true;//diskon
									dg1.columns.getItemAt(9).editable = true;//jumlah diskon
									dg1.columns.getItemAt(12).editable = true;//pajak1
									dg1.columns.getItemAt(14).editable = true;//pajak2
								}
								FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
								o.cmb = cmbjenispembelian.selectedIndex;
							}else{
								cmbjenispembelian.selectedIndex = int(o.cmb);
							}
						});
					}else{
						if(cmbjenispembelian.selectedIndex ==0){
							mb.menuBarItems[4].enabled = true;
							mb.menuBarItems[5].enabled = false;
							dg1.columns.getItemAt(1).editable = false;//kodebarang
							dg1.columns.getItemAt(5).editable = false;//satuan
							dg1.columns.getItemAt(7).editable = false;//harga
							dg1.columns.getItemAt(8).editable = false;//diskon
							dg1.columns.getItemAt(9).editable = false;//jumlah diskon
							dg1.columns.getItemAt(12).editable = false;//pajak1
							dg1.columns.getItemAt(14).editable = false;//pajak2
							//FlexGlobals.topLevelApplication.F_setGridJson(4, 11);
						}else{
							mb.menuBarItems[4].enabled = false;
							mb.menuBarItems[5].enabled = true;
							dg1.columns.getItemAt(1).editable = true;//kodebarang
							dg1.columns.getItemAt(5).editable = true;//satuan
							dg1.columns.getItemAt(7).editable = true;//harga
							dg1.columns.getItemAt(8).editable = true;//diskon
							dg1.columns.getItemAt(9).editable = true;//jumlah diskon
							dg1.columns.getItemAt(12).editable = true;//pajak1
							dg1.columns.getItemAt(14).editable = true;//pajak2
							
							//FlexGlobals.topLevelApplication.F_setGridJson(4, 6);
//							FlexGlobals.topLevelApplication.registerGrid([dg], 'TransaksiBarang');
						}
						
						//FlexGlobals.topLevelApplication.registerGrid([dg], 'TransaksiBarang');
						o.cmb = cmbjenispembelian.selectedIndex;
					}
					
				}
			}
			
