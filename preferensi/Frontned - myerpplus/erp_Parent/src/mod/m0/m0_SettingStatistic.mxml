			protected function vx_resizeHandler(event:ResizeEvent):void
			{
				p = parentApplication;
				vx.height = BoxGrupMenu.height-28;
				vx.validateNow();
				if(event.oldHeight > BoxGrupMenu.height){
					// turun 
					if(parentApplication.m.objTemp.hasOwnProperty('mod'))
						if(o.mod[int(vx.height/30)] != null){
							for(i=int(vx.height/30);i<o.mod.length;i++){
								if(o.mod.length > (i+1)){
									o.mod[i+1].height = 28;
									o.mod[i+1].width = 28;
									hxbottom.addChild(o.mod[i+1]);
								}
							}
							if(((vx.height/30)-int(vx.height/30)) <= 0.1){
								o.mod[int(vx.height/30)].height = 28;
								o.mod[int(vx.height/30)].width = 28;
								hxbottom.addChildAt(o.mod[int(vx.height/30)], 0);
							} 
							if(bHxbottom == false){
								bHxbottom = true
								hxbottom.removeChild(btnbottom);
							}
						}
				}else{
					// naik
					if(parentApplication.m.objTemp.hasOwnProperty('mod'))
						if(o.mod[int(vx.height/30)] != null){
							for(i=0;i<int(vx.height/30);i++){
								if(o.mod.length > (i+1)){
									o.mod[i].height = 30;
									o.mod[i].percentWidth = 100;
									vx.addChildAt(o.mod[i], i);
								}
							}
							if(((vx.height/30)-int(vx.height/30)) > 0.1){
								o.mod[int(vx.height/30)].height = 30;
								o.mod[int(vx.height/30)].percentWidth = 100;
								vx.addChild(o.mod[int(vx.height/30)]);
							}
							if(hxbottom.numChildren == 0){
								bHxbottom = false;
								hxbottom.addChild(btnbottom);
							}
						}
				}
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				o.a = column.split('|');
				if(column == 'add' || o.a[0] == 'add'){
					if(o.a.length == 1)o.d = dg.dataProvider[dg.dataProviderLength-1];
					else o.d = dg.dataProvider[o.a[1]];
					if(dg.id == "dgprogress"){
						o.d.v = "";
						o.d.t = 0;
						o.d.o = 0;
						o.d.f = "";
					}else if(dg.id == "dgstandart"){
						o.d.v = "";
						o.d.t = 0;
						o.d.o = 0;
						o.d.f = "";
					}else if(dg.id == "dgsort"){
						o.d.f = "";
						o.d.s = 0;
					}else{
						o.d.l = parentApplication.l("New Komp")+" "+o.d.no;
						o.d.f = "";
						o.d.k = 0;
						o.d.w = 128;
						o.d.p = '';
						o.d.s = 0;
						if(o.a.length == 1)p.F_dgColumnRefresh(dg, dg.dataProviderLength-1);
						else p.F_dgColumnRefresh(dg, o.a[1]);
						o.a = null;
					}
				}
			}
			
			protected function f_simpan():void
			{				
				var s:String = '{"s":[', j:int, i:int;
				for(i=0;i<arr.length;i++){
					s += FlexGlobals.topLevelApplication.F_jsonEncode(arr[i]['i'], arr[i].detail, ['i', 'b', 'p', 'f', 's', 'l', 'n', 'g', 'd']);
					if(i<arr.length-1)s += ", "
				}
				s += ']}';
				s = s.split('"property":').join('"d":');
				p.F_wsJson('set', 'M0_SetFileLibrary', "statistic/"+moduleid+"_"+idmenu, s);
			}
			
			public function getItemIndexByProperty(array:ArrayCollection, property:String, value:String):int
			{
				for (var i:Number = 0; i < array.length; i++)
				{
					var obj:Object = Object(array[i])
					if (obj[property] == value)
						return i;
				}
				return -1;
				
				array.getItemIndex();
			}
			
			public function f_getProperty(components:String, dataField:String, data:Object, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'o')
							return new ArrayCollection([{l:"Berisi", v:0},{l:"=", v:1},{l:"<>", v:2},{l:">", v:3},{l:"<", v:4},{l:">=", v:6},{l:"<=", v:7},{l:"Diawali", v:8},{l:"Diakhiri", v:9}]);
						if(dataField == 't')
							return new ArrayCollection([{l:"Mapping", v:0},{l:"Text", v:1},{l:"Date", v:2}]);
						if(dataField == 'v')
							return new ArrayCollection([{l:"Hari ini", v:0},{l:"Awal Bulan", v:1},{l:"Akhir Bulan", v:2},{l:"Kosong", v:3}]);
						if(dataField == 's')
							return new ArrayCollection([{l:"ASC", v:0},{l:"DESC", v:1}]);
						break;
					case 'custom':
						if(dataField == 'v')
							if(dgprogress.visible)
								return act(dgprogress);
							else
								return act(dgstandart);
						break;
				}
				return new ArrayCollection([]);
				
				function act(dg:DataGrid):String
				{
					if(dg.dataProvider == null)
						return "text";
					else if(int(data) < dg.dataProviderLength){
							if(dg.dataProvider[int(data)].t == 2)
								return "comboBox";
							return "text";
					}else
						return "text";
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch(components){
					case 'comboBox':
						if(dataField == 't'){
							if(dgprogress.visible)
								act(dgprogress);
							else
								act(dgstandart);
						}
						break;
				}
				
				function act(dg:DataGrid):void
				{
					o.o = dg.dataProvider[p.rowIndex];
					switch(data){
						case 0:
							o.o.v = "";
							break;
						case 1:
							o.o.v = "";
							break;
						case 2:
							o.o.v = 0;
							break;
					}
					FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, p.rowIndex);
				}
			}
			
