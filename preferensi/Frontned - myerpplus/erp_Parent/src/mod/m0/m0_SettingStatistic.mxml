				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtlabel, txtfilter, txtsort, txt1, txt2, txt3, txt4, txt5]);
 
				arr = new ArrayCollection;
				FlexGlobals.topLevelApplication.F_wsGetDataById('MenuTree', 'M0_MenuTree', parentApplication.ubahasa, 0, 0, "mid <> 1", "mntype <> 1 AND mntype <> 2 AND mntype <> 3 AND mntype <> 4 AND mntype <> 5 AND mntype <> 7")
