						case 'get':
							parentApplication.m.statistic = FlexGlobals.topLevelApplication.wsJson.form;
							break;
						case 'txtpaketws':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtpaketws.text = ws.skode;
							txtlabel.text = ws.snama;
							break;
						case 'txtpilih':
							var b:Object;
							ws = parentApplication.wsArrUtama.getItemAt(0);
							switch(cmbform.selectedIndex){
								case 0:
									lblinfo.text = "Filter";
									txtpilih.text = ws.mnname;
									o.mnmoduleid = ws.mnmoduleid;
									o.mnid = ws.mnid;
									vis([dgstandart]);
									FlexGlobals.topLevelApplication.F_defaultGridItem(dgstandart);
									dgstandart.setFocus();
									dgstandart.setSelectedCell(0, 0);
									break;
								case 1:
									lblinfo.text = "Filter";
									txtpilih.text = ws.mnname;
									o.mnmoduleid = ws.mnmoduleid;
									o.mnid = ws.mnid;
									vis([dgstandart]);
									FlexGlobals.topLevelApplication.F_defaultGridItem(dgstandart);
									dgstandart.setFocus();
									dgstandart.setSelectedCell(0, 0);
									break;
								case 2:
									o.ritem = ws.ritem;
									o.rmenu = ws.rmenuid;
									o.rmodule = ws.rmoduleid;
									txtpilih.text = ws.rreportname;
									vis([dgstandart, dgprogress], false);
									if(ws.rquery == 2){
										lblinfo.text = "Report Progress";
										vis([dgprogress]);
										dgprogress.dataProvider.removeAll();
										for(i=0;i<parentApplication.m.laporan.length;i++){
											if(parentApplication.m.laporan[i].n == ws.rmoduleid+"_"+ws.rmenuid){
												b = parentApplication.m.laporan[i][ws.rid][0].property;
