			public function cx(custom:Boolean = false):ContextMenu
			{
				var vCMI:ContextMenuItem;
				var obj:ContextMenu = new ContextMenu;
				obj.hideBuiltInItems();
				obj.addEventListener(ContextMenuEvent.MENU_SELECT, function(e:ContextMenuEvent):void{
					var d:int = String(e.mouseTarget)['split'](".").length, ob:Object;
					ob = e.mouseTarget;
					if(d > 13)
						for(i=0;i<d-13;i++)
							ob = ob.parent;
					boxselected = ob;
				});
				if(custom){
					vCMI = new ContextMenuItem('Setting');
					vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, setting);
					obj.customItems.push(vCMI);
				}
				vCMI = new ContextMenuItem('Add Grafik');
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, function(e:ContextMenuEvent):void{
					addgrafik();
					o.nografik++;
				});
				obj.customItems.push(vCMI);
				vCMI = new ContextMenuItem('Add Grid');
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, function(e:ContextMenuEvent):void{
					addgrid();
					o.nogrid++;
				});
				obj.customItems.push(vCMI);
				vCMI = new ContextMenuItem('Remove');
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, function(e:ContextMenuEvent):void{
					var d:int = String(e.mouseTarget)['split'](".").length, ob:Object;
					try
					{
						e.mouseTarget.parent.removeChild(e.mouseTarget);
						arr.removeItemAt(getItemIndexByProperty(arr, "id", String(e.mouseTarget)))
					} 
					catch(error:Error) 
					{
						ob = e.mouseTarget;
						for(i=0;i<d-18;i++)
							ob = ob.parent;
						if(ob.id == null)
							ob = ob.parent;
						o.o = getItemIndexByProperty(arr[getItemIndexByProperty(arr, "id", boxselected.id)].detail, "i", "v"+ob.id);
						arr[getItemIndexByProperty(arr, "id", boxselected.id)].detail.removeItemAt(o.o)
						ob = e.mouseTarget;
						if(d > 14)
							for(i=0;i<d-14;i++)
								ob = ob.parent;
						ob.parent.removeChild(ob);
					}
				});
				obj.customItems.push(vCMI);
				return obj;
				
				function setting(e:ContextMenuEvent):void
				{
					var d:int = String(e.mouseTarget)['split'](".").length, ob:Object;
					ob = e.mouseTarget;
