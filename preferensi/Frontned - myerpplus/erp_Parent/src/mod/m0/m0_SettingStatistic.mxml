			protected function vis(ar:Array, vis:Boolean = true):void
			{
				var a:Array = new Array;
				for(i=0;i<ar.length;i++){
					if(vis && ar[i].id.split("lbl").length > 1)
						a[a.length] = ar[i];
					if(ar[i].id.split("lbl").length > 1 && o[ar[i].id+"l"] != undefined)
						o[ar[i].id+"l"].visible = vis;
					ar[i].visible = vis;
				}
				if(a.length >= 0)
					parentApplication.callLater(F_RequiredLabelLater, [a]);
				
				function F_RequiredLabelLater(ar:Array):void
				{
					for(i=0;i<ar.length;i++){
						if(o[ar[i].id+"l"] != undefined)
							o[ar[i].id+"l"].left = (int(ar[i].left)+int(ar[i].width)+3);
					}
				}
			}
			
