				function F_RequiredLabel(ar:Array, color:String = 'red'):void
				{
					parentApplication.callLater(F_Required, [ar, color]);
				}
				
				function f_GRID_KEY_DOWN(e:KeyboardEvent, ac:ArrayCollection, dg:DataGrid):void{
					switch(e.keyCode){
						case Keyboard.UP:
							if(e.ctrlKey && p.rowIndex > 0){
								o.g = ac.getItemAt(p.rowIndex-1);
								ac.setItemAt(ac.getItemAt(p.rowIndex), p.rowIndex-1);
								ac.setItemAt(o.g, p.rowIndex);
								ac.getItemAt(p.rowIndex-1).no = p.rowIndex;
								ac.getItemAt(p.rowIndex).no = p.rowIndex+1;
								dg.setSelectedCell(p.rowIndex-1, p.columnIndex);
							} 
							break;
						case Keyboard.DOWN:
							if(e.ctrlKey && p.rowIndex < ac.length-1){
								o.g = ac.getItemAt(p.rowIndex+1);
								ac.setItemAt(ac.getItemAt(p.rowIndex), p.rowIndex+1);
								ac.setItemAt(o.g, p.rowIndex);
								ac.getItemAt(p.rowIndex+1).no = p.rowIndex+2;
								ac.getItemAt(p.rowIndex).no = p.rowIndex+1;
								dg.setSelectedCell(p.rowIndex+1, p.columnIndex);
							}						
							break;
					}
				}
			
				function F_Required(ar:Array, color:String):void
				{
					for(i=0;i<ar.length;i++){
						o[ar[i].id+"l"] = new spark.components.Label;
						o[ar[i].id+"l"].left = (int(ar[i].left)+int(ar[i].width)+3);
						o[ar[i].id+"l"].y = ar[i].y;
						o[ar[i].id+"l"].text = "*";
						o[ar[i].id+"l"].setStyle('color', color);
						ar[i].parent.addElement(o[ar[i].id+"l"]);
					}
				}
			}
			public function buatbox(id:String, h:int):void
			{
				if(lblmenu.text.length == 0){
					Alert.show('Pilih Menu dulu', 'Informasi');
					return;
				} 
				o[id] = new HBox;
				o[id].id = id;
				o[id].percentWidth = 100;
				o[id].height = h;
				o[id].setStyle("verticalGap", 0);
				o[id].setStyle("borderAlpha", 1);
				o[id].setStyle("paddingBottom", 10);
				o[id].setStyle("backgroundColor", "#f5f4f4");
				o[id].addEventListener(MouseEvent.CLICK, function(e:MouseEvent):void{
					boxselected = e.currentTarget;
				});
				o[id].contextMenu = cx();
				o.settingbox[id] = new Image;
				o.settingbox[id].source = config;
				o.settingbox[id].top = 10;
				o.settingbox[id].left = 10;
				o.settingbox[id].useHandCursor = true;
				o.settingbox[id].buttonMode = true;
				o.settingbox[id].mouseChildren = true;
				o.settingbox[id].addEventListener(MouseEvent.CLICK, function(e:MouseEvent):void{
					o.i = getItemIndexByProperty(arr, "id", boxselected.id);
					grpsetting.visible = true;
					pnlsettingbox.visible = true;
					o.txtheightbox = arr[o.i].i.split("|")[1];
					txtheightbox.text = o.txtheightbox;
				});
				o[id].addElement(o.settingbox[id]);
				boxselected = o[id];
				box.addElement(o[id]);
				
				o.o = id+"|"+h;
				arr.addItem({id:id, i:o.o, detail:new ArrayCollection});
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtpaketws':
						paket = 'CdM0_StatisticPacket';
						wsfilter = 'skode = "'+txtpaketws.text+'"';
						break;
					case 'txtpilih':
						switch(cmbform.selectedIndex){
							case 0:
								paket = 'M0_MenuSearch';
								wsfilter = 'mnactive = 1 AND mnlevel = 2 AND mntype = 2 AND mnname = "'+txtpilih.text+'"';
								csfilter = 'mnactive = 1 AND mnlevel = 2 AND mntype = 2';
								break;
							case 1:
								paket = 'M0_MenuSearch';
								wsfilter = 'mnactive = 1 AND mnlevel = 2 AND (mntype = 3 or mntype = 1) AND mnname = "'+txtpilih.text+'"';
								csfilter = 'mnactive = 1 AND mnlevel = 2 AND (mntype = 3 or mntype = 1)';
								break;
							case 2:
								paket = 'CdM0_ReportPacket';
								wsfilter = 'rreportname = "'+txtpilih.text+'"';
							break;
							default:
								cmbform.setFocus();
								Alert.show(parentApplication.l("Pilih Jenis Form dulu"), parentApplication.l("Infromasi"));
						}
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function addgrid():void
			{
				if(boxselected == null){
					Alert.show("Buat box dulu", "Informasi");
