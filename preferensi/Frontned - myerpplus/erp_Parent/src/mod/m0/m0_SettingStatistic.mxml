												if(o.b[i].s == 1)
													dgprogress.dataProvider.addItem({no:(dgprogress.dataProviderLength+1), f:o.b[i].f+" 2", t:int(getValue('t', o.b[i].f+" 2")), v:getValue('v', o.b[i].f+" 2")});
											}
											break; 
