				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_box1);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_box2);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_box3);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_addgrafik);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_addgrid);
				mbpnlsetting.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbpnlsettingSimpan);
				mbpnlsetting.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbpnlsettingCancel);
				mbpnlsettingbox.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbpnlsettingSimpanbox);
				mbpnlsettingbox.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbpnlsettingCancelbox);
				
				function f_mbpnlsettingSimpanbox():void
				{
					if(o.txtheightbox < 200){
						txtheightbox.setFocus();
						Alert.show("Height box minimal 200", "Informasi")
						return;
					}
					o.i = getItemIndexByProperty(arr, "id", boxselected.id);
					arr[o.i].i = arr[o.i].i.split("|")[0]+"|"+o.txtheightbox;
					boxselected.height = o.txtheightbox;
					f_mbpnlsettingCancelbox();
				}
				
				function f_mbpnlsettingCancelbox():void
				{
					grpsetting.visible = false;
					pnlsettingbox.visible = false;
					txtheightbox.text = '0';
					o.txtheightbox = 0;
				}
				
				function f_mbpnlsettingSimpan():void
				{
					// validasi paket ws
					if(txtpaketws.text.length == 0){
						txtpaketws.setFocus();
						Alert.show(parentApplication.l("Isi paket WS dulu"), parentApplication.l("Informasi"));
						return;
					}
					
					//set index
					o.o = olast.slice(1, olast.length);
					o.i = getItemIndexByProperty(arr, "id", boxselected.id);
					o.i2 = getItemIndexByProperty(arr[o.i].detail, "i", olast);
					
					//set label kotak
					o['lbl'+o.o].text = txtlabel.text+" ("+o.o+")";
					
					// validasi grafik
					o.o = arr[o.i].detail[o.i2];
					if(o.o.g.length > 0)
						if(validasiInputanGrafik())
							return;
						
					//set ke array semua inputan
					o.o.p = txtpaketws.text;
					o.o.b = txtlabel.text;
					o.o.f = txtfilter.text;
					o.o.s = txtsort.text;
					o.o.l = txtlimit.text;
					o.o.n = txtpagenumber.text;
					o.o.g = isigrafik(o.o.g);
					o.o.d = "0|||||||";
					
					//refresh array setelah di isi
					arr[o.i].detail.refresh();
					
					//jika detail di centang
					if(cbxdetailisavailable.selected){
						
						//Validasi Detail
						if(validasiDetail())
							return;
						
						switch(cmbform.selectedIndex){
							case 0:
							case 1:
								FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgstandart);
								o.f = "";
								for(i=0;i<dgstandart.dataProviderLength;i++){
									if(i > 0)o.f += FlexGlobals.topLevelApplication.sptRow;
									o.f += FlexGlobals.topLevelApplication.F_splitArrayToString([dgstandart.dataProvider[i].f, dgstandart.dataProvider[i].t, dgstandart.dataProvider[i].v, dgstandart.dataProvider[i].o]);
								}
								o.s = "";
								for(i=0;i<dgsort.dataProviderLength;i++){
									if(i > 0)o.s += FlexGlobals.topLevelApplication.sptRow;
									o.s += FlexGlobals.topLevelApplication.F_splitArrayToString([dgsort.dataProvider[i].f, dgsort.dataProvider[i].s]);
								}
								arr[o.i].detail[o.i2].d = "1|"+cmbform.selectedIndex+"|"+txtpilih.text+"|"+o.mnmoduleid+"|"+o.mnid+"|"+o.f+"|"+o.s;
								break;
							case 2:
								if(dgstandart.visible){ 
									// jika report standart
									FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgstandart);
									o.f = "";
									for(i=0;i<dgstandart.dataProviderLength;i++){
										if(i > 0)o.f += FlexGlobals.topLevelApplication.sptRow;
										o.f += FlexGlobals.topLevelApplication.F_splitArrayToString([dgstandart.dataProvider[i].f, dgstandart.dataProvider[i].t, dgstandart.dataProvider[i].v, dgstandart.dataProvider[i].o]);
									}
									o.s = "";
									for(i=0;i<dgsort.dataProviderLength;i++){
										if(i > 0)o.s += FlexGlobals.topLevelApplication.sptRow;
										o.s += FlexGlobals.topLevelApplication.F_splitArrayToString([dgsort.dataProvider[i].f, dgsort.dataProvider[i].s]);
									}
								}else{
									// jika report progress
									FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgprogress);
									o.f = "";
									for(i=0;i<dgprogress.dataProviderLength;i++){
										if(i > 0)o.f += FlexGlobals.topLevelApplication.sptRow;
										o.f += FlexGlobals.topLevelApplication.F_splitArrayToString([dgprogress.dataProvider[i].f, dgprogress.dataProvider[i].t, dgprogress.dataProvider[i].v]);
									}
									o.s = "";
									for(i=0;i<dgsort.dataProviderLength;i++){
										if(i > 0)o.s += FlexGlobals.topLevelApplication.sptRow;
										o.s += FlexGlobals.topLevelApplication.F_splitArrayToString([dgsort.dataProvider[i].f, dgsort.dataProvider[i].s]);
									}

								}
								arr[o.i].detail[o.i2].d = "1|2|"+o.rmodule+"|"+o.rmenu+"|"+o.ritem+"|"+int(dgstandart.visible)+"|"+o.f+"|"+o.s;
							break;
						}
							 
						
					}
					f_mbpnlsettingCancel();					
					function validasiDetail():Boolean
					{
						if(cmbform.selectedIndex < 0){
							cmbform.setFocus();
							Alert.show("Pilih Jenis Form dulu", "Informasi");
							return true;
						}
						if(txtpilih.text.length == 0){
							txtpilih.setFocus();
							Alert.show(lblinfo.text+" dulu", "Informasi");
							return true;
						}
						return false;
					}
					
					function isigrafik(data:String):String
					{
						if(data.length > 0){
							//get grid dgy
							o.s1 = "";
							for(i=0;i<dgy.dataProviderLength;i++){
								if(i > 0)o.s1 += FlexGlobals.topLevelApplication.sptRow;
								o.s1 += dgy.dataProvider[i].y;
							}
							
							//get grid dgxyd
							o.s2 = "";
							for(i=0;i<dgxyd.dataProviderLength;i++){
								if(i > 0)o.s2 += FlexGlobals.topLevelApplication.sptRow;
								o.s2 += FlexGlobals.topLevelApplication.F_splitArrayToString([dgxyd.dataProvider[i].y, dgxyd.dataProvider[i].x, dgxyd.dataProvider[i].n]);
							}
							
							return cmbpilihgrafik.selectedIndex+"|"+txt1.text+"|"+txt2.text+"|"+txt3.text+"|"+txt4.text+"|"+txt5.text+"|"+o.s1+"|"+o.s2;
						}
						
						return "";
					}
					
					function validasiInputanGrafik():Boolean
					{
						if(cmbpilihgrafik.selectedIndex < 0){
							cmbpilihgrafik.setFocus();
							Alert.show("Pilih Grafik dulu", "Informasi");
							return true;
						}
						
						switch(cmbpilihgrafik.selectedItem.l){
							case "Column":
								if(input([1]))return true;
								if(inputdg(dgy))return true;
								break;
							case "Area":
								if(input([1]))return true;
								if(inputdg(dgy))return true;
								break;
							case "Bar":
								if(input([1]))return true;
								if(inputdg(dgy))return true;
								break;
							case "CandleStick":
								if(input([1, 2, 3, 4, 5]))return true;
								break;
							case "Bubble":
								if(input([1, 2, 3, 4]))return true;
								break;
							case "HLOC":
								if(input([1, 2, 3, 4, 5]))return true;
								break;
							case "Line":
								if(input([1]))return true;
								if(inputdg(dgy))return true;
								break;
							case "Pie":
								if(input([1, 2]))return true;
								break;
							case "Plot":
								if(inputdg(dgxyd))return true;
								break;
						}
						return false;
							
						function inputdg(dg:DataGrid):Boolean
						{
							FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
							if(dg.dataProvider[0].y.length == 0){
								dg.setFocus();
								Alert.show("Isi dulu grid grafik");
								return true;
							}
							return false;
						}
						
						function input(ar:Array):Boolean
						{	
							for(i=0;i<ar.length;i++){
								if(o.ini['txt'+ar[i]].text.length == 0){
									o.ini['txt'+ar[i]].setFocus;
									Alert.show(o.ini['lbl'+ar[i]].text+" di isi dulu", "Informasi");
									return true;
								}
							}
							return false;
						}
					}
					
				}
				
