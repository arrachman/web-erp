			protected function f_treeClick(event:ListEvent):void
			{
				if(!parentApplication.apaBisaAkses(0, 14, 4))
					return;
				
				lblmenu.visible = true;
				selectedNode=Tree(event.target).selectedItem as XML;
				var StrLabel:String = selectedNode.@l;
				var IsPopup:int = selectedNode.@p;
				var StrURL:String = selectedNode.@u;
				var Tinggi:int = selectedNode.@tg;
				var Lebar:int = selectedNode.@lb;
				var Tipe:String = selectedNode.@t;
				var j:int, n:int, x:int, d:int;
				idmenu = selectedNode.@id;
				lblmenu.text = StrLabel;
				for(i=0;i<parentApplication.m.statistic.length;i++){
					if(parentApplication.m.statistic[i].n == moduleid+"_"+idmenu){
						box.removeAllElements();
						arr.removeAll();
						idmodule = moduleid;
						o.obj = parentApplication.m.statistic[i].s;
						numbox = 0;
						for(j=0;j<o.obj.length;j++){
							o.a = o.obj[j].id.split("|");
							o.oi = o.a[0].split('b')['join']('');
							if(o.oi > numbox)
								numbox = o.oi;
							if(o.a[1] < 200)o.a[1] = 200;
							buatbox(o.a[0], o.a[1]);
							o.ob = o.obj[j].d;
							boxselected = o[o.a[0]];
							o.igrafik = 0;
							o.igrid = 0;
							for(n=0;n<o.ob.length;n++){
								o.oi = o.ob[n].i.slice(2, o.ob[n].i.length);
								if(o.ob[n].g.length > 0){
									if(o.oi > o.igrafik)
										o.igrafik = o.oi;
									o.nografik = o.oi;
									addgrafik();
									if(o.ob[n].b.length > 0)
										o['lblg'+o.nografik].text = o.ob[n].b+" "+ o['lblg'+o.nografik].text;
								}else{
									if(o.oi > o.igrid)
										o.igrid = o.oi;
									o.nogrid = o.oi;
									addgrid();
									if(o.ob[n].b.length > 0)
										o['lbld'+o.nogrid].text = o.ob[n].b+" "+ o['lbld'+o.nogrid].text; 
								}
								olast = o.ob[n].i;
								
								arr[o.i].detail[arr[o.i].detail.length-1] = o.ob[n];
							}
							o.igrafik++;
							o.igrid++;
							o.nografik = o.igrafik;
							o.nogrid = o.igrid;
						}
						numbox++;
					}
				}
			}
			
