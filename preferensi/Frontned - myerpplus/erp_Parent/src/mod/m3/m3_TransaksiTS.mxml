// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBox':																				// mengeset untuk checobox
						if(data == true && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == 'I')		// melakukan pencarian ketika klik checkbox maka melakukan pencarian barang HPP khusus
							parentApplication.F_popUpCari('chk_HK');												
						break;
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
						switch(dataField){
							case 'jumlah':
								jmlbarang = Number(jumlah) * Number(nilaisatuan);
								break;
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
			public function f_filtersb():void{
				fserial = 's'; fbatch = 'b';
				for(i=0; i<dg1.dataProviderLength; i++){
					if(dg1.dataProvider[i].bserial ==	1){
						if(fserial == 's'){
							fserial = '(nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}else{
							fserial += ' or (nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}
					}
					
					if(dg1.dataProvider[i].bbatch ==	1){
						if(fbatch == 'b'){
							fbatch = '(nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}else{
							fbatch += ' or (nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}
					}
				}
			}
			
			
