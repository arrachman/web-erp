			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_TsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_TsGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			protected function f_kondisiAwal():void
			{
				isUpdate = false;																					// set untuk isupdate
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);			// set item combobox progress pertama kali
				if(parentApplication.getSetting(0, 'options', 'JenisMutasiStok') == 1){
					cmbjenis.selectedIndex = 1;
				}else{
					cmbjenis.selectedIndex = 0;
				}
				
				parentApplication.F_SetNilaiText([dttanggal, dttanggalnoref], parentApplication.DefaultTanggal);	// set datefield dengan tanggal sekarang
				parentApplication.F_SetNilaiText([], 0);															// set text input dengan nilai 0
				parentApplication.F_KosongkanText([txtbagianmutasi, lblbagianmutasi, txtkontakperson, txtgudangasal, lblgudangasal, txtgudangtransit, lblgudangtransit, txtgudangtujuan, lblgudangtujuan, txtcatatan, txtnoref]);	// set kosongkan text input
				txtnotransaksi.text = 'Auto';																		// set notransaksi dengan text "Auto"		
				txturaian.text = parentApplication.getNomor("TS");													// set text input uraian dengan ambil dari setting database
				txtcatatan.text = parentApplication.getNomor("TS",1);												// set text input catatan dengan ambil dari setting database
				txtgudangasal.text = parentApplication.ugudang;														// set text input gudang dengan ambil dari parent
				lblgudangasal.text = parentApplication.ugudangnama;													// set label gudang dengan ambil dari parent
				txtgudangtransit.text = parentApplication.getSetting(3, 'defaultgudang', 'GudangTransit');			// set text input gudang transit dengan ambil dari setting database
				lblgudangtransit.text = parentApplication.getSetting(3, 'defaultgudang', 'GudangTransitNama');		// set label gudang transit dengan ambil dari setting database
				cmbprogress.enabled = true;																			// set combobox progress untuk bisa diedit
				cmbprogress.selectedIndex = 1;																		// set combobox progress untuk menselect index yang nomer satu
				mb.menuBarItems[0].enabled = true;																	// set menubar untuk bisa diklik
				mb.menuBarItems[7].enabled = false;																	// set menubar untuk bisa diklik
				mb.menuBarItems[8].enabled = false;
				mb.menuBarItems[9].enabled = false;// set menubar untuk bisa diklik
				mb.menuBarItems[10].visible = false;
				mb.menuBarItems[11].visible = false;
				if (vTgl == '0'){																					// set ketika default tanggal yang diambil dari setting bernilai 1 maka tanggal tidak bisa edit.
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){																			// set ketika default notransaksi yang diambil dari setting bernilai 1 maka checkbox auto terselect dan tidak dapat edit
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{																								// set ketika default notransaksi yang diambil dari setting tidak bernilai 1 maka mengecek vDefNotransaksi
					if (vDefNotransaksi == '0'){																	// set ketika vDefNotransaksi yang diambil dari setting bernilai 0 maka checkbox tidak terselect
						chkauto.selected = false;
					}else{
						chkauto.selected = true;																	// set ketika vDefNotransaksi yang diambil dari setting bernilai 0 maka checkbox tidak terselect
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
// set utama ==============================================
				u = new ArrayCollection([{
					tsid:0, tscabang:parentApplication.ucabang, tslokasi:parentApplication.ulokasi, tsgudangasal:'', tsgudangtransit:'', tsgudangtujuan:'', tssumber:'TS', 
					tsautonotransaksi:0, tsnotransaksi:txtnotransaksi.text, tstgl:dttanggal.text, tskodepa:0, tsbagianmutasi:parentApplication.ukontak, tsbagianmutasikontak:txtkontakperson.text, tsuraian:txturaian.text, 
					tscatatan:txtcatatan.text, tsnoref:txtnoref.text, tstglnoref:dttanggalnoref.text, tsidmr:0, tsstatusrs:0, tsstatus:cmbprogress.selectedItem.v, tsstatussebelumnya:0, 
					tsjmlrevisi:0, tscetakanke:0, tsinputuser:parentApplication.userid, tsinputtgl:tglDB, tsmodifikasiuser:0, tsmodifikasitgl:tglDB, tsisclose:0, 
					tscustomtext1:'', tscustomtext2:'', tscustomtext3:'', tscustomtext4:'', tscustomtext5:'', tscustomint1:0, tscustomint2:0, 
					tscustomint3:0, tscustomdbl1:0, tscustomdbl2:0, tscustomdbl3:0, tscustomdate1:parentApplication.m.DateFirst, tscustomdate2:parentApplication.m.DateFirst, tscustomdate3:parentApplication.m.DateFirst
				}]);
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
// set untuk fungsi keyboard =================================================
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)f_simpan();
						break;
				}
			}	
			
// set untuk fungsi perhitungan2 pada grid =================================================
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				if(parentApplication.rowIndex < dg1.dataProviderLength)
				with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
					switch(column){
//						case 'jumlah':
//							customdbl1 = Number(jumlah) / Number(nilaisatuanlapangan);
//							jmlbarang = Number(jumlah) * Number(nilaisatuan);
//							break;
						case 'pre_del':
							hapusserial();
							hapusbatch();
							break;
//						case 'customdbl1':
