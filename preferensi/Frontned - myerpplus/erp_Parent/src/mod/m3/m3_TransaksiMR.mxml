	<fx:Script> 
		<![CDATA[
			import MyClass.SettingNoTransaction;
			
			import flashx.textLayout.factory.TruncationOptions;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			
			import org.hamcrest.mxml.collection.Array;
			
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			protected var img:Image, i:int, isUpdate:Boolean, vUang:String, vTgl:String, vNotransaksi:String, vDefNotransaksi:String, getNotransaksi:String;
			[Bindable] public var u:ArrayCollection;
			public var validasi:Boolean, pesanAlert:String, t:TitleWindow, tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal;
			public var o:Object = {}, n:Object = {}, obj:Object = {};
			protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction;
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
							switch(dataField){
								case 'jumlah':
									jmlbarang = Number(jumlah) * Number(nilaisatuan);
									break;
							}
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
// set fokus ketika pertama kali form diload ===================================
			public function f_focusOnMe():void
			{
				txtdimintaoleh.setFocus();
			}
			
// set persiapan form ==========================================================
			public function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tdimintaoleh, tmintake, tgudangasal, tgudangtujuan, turaian, ttanggal, tnotransaksi, ttgldibutuhkan, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref]);
				parentApplication.F_RequiredLabel([tdimintaoleh, tmintake, tgudangasal, tgudangtujuan, ttanggal, tnotransaksi, ttgldibutuhkan, tprogress]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggaldibutuhkan, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtdimintaoleh, txtdimintake, txtgudangasal, txtgudangtujuan]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref]);
//				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Ambil Picking List", icon:"tbtake", enabled:"true", children:[
						{label:"Per Barang", icon:"tbtake", enabled:"true"},
						{label:"Semua Barang", icon:"tbtake", enabled:"true"}]},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
//				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbAmbilPicking);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[8].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbItemClick); 
				
				function f_mbItemClick(e:MenuEvent):void
				{
					
					switch(e.index){
						case 0:
							if(txtgudangtujuan.text.length > 0){
								FlexGlobals.topLevelApplication.F_popUpCari("AmbilPicking");
							}else{
								Alert.show("Gudang Tujuan harus diisi terlebih dahulu", "Informasi");
							}
							break;
						
						case 1:
							if(txtgudangtujuan.text.length > 0){
								FlexGlobals.topLevelApplication.F_wsSearch("AmbilPicking2","CdM1_ItemPickingList",0,0,'baktif=1 AND bassembly <> 1 AND btagpermintaanmutasi = 1', 'bkode asc',"","",FlexGlobals.topLevelApplication.userid, txtgudangtujuan.text)
							}else{
								Alert.show("Gudang Tujuan harus diisi terlebih dahulu", "Informasi");
							}
							break;
						
					}
				}
				
				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(3,3,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Mr');
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbAmbilPicking():void
				{
					if(txtgudangtujuan.text.length > 0){
						FlexGlobals.topLevelApplication.F_popUpCari("AmbilPicking");
					}else{
						Alert.show("Gudang Tujuan harus diisi terlebih dahulu", "Informasi");
					}
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[4].enabled == true){
						parentApplication.F_OpenNotes('Mr', u.getItemAt(0).mrid, txtnotransaksi.text);
					}
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[5].enabled == true){
						parentApplication.F_OpenUploadFile('MR', u.getItemAt(0).mrid, txtnotransaksi.text);
					}
				}
				function f_mbLinks():void
				{
					FlexGlobals.topLevelApplication.f_mbLinks(3, 'Mr');
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(3, 3, [dg1], 'TransaksiBarang');
				f_validasi();
			}
			
			public function f_validasi():void
			{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_MrHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					else  {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_MrGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				isUpdate = false;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				parentApplication.F_SetNilaiText([dttanggal, dttanggaldibutuhkan, dttanggalnoref], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtdimintaoleh, lbldimintaoleh, txtnotransaksi, txtdimintake, lbldimintake, txtgudangasal, lblgudangasal, txtgudangtujuan, lblgudangtujuan, txtcatatan, txtnoref]);
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("MR");
				txtcatatan.text = parentApplication.getNomor("MR",1);
				txtdimintaoleh.text = parentApplication.ukontakkode;
				parentApplication.vpVarCurrent = txtdimintaoleh.text;
				lbldimintaoleh.text = parentApplication.ukontaknama;
				txtgudangtujuan.text = parentApplication.ugudang;
				lblgudangtujuan.text = parentApplication.ugudangnama;
				FlexGlobals.topLevelApplication.txtGudang = parentApplication.ugudang;
				cmbprogress.enabled = true;
				cmbprogress.selectedIndex = 1;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				mb.menuBarItems[8].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				u = new ArrayCollection([{
					mrid:0, mrcabang:parentApplication.ucabang, mrlokasi:parentApplication.ulokasi, mrgudangasal:parentApplication.ugudang, mrgudangtujuan:'', mrsumber:'MR', mrautonotransaksi:0, 
					mrnotransaksi:txtnotransaksi.text, mrtgl:dttanggal.text, mrkodepa:0, mrdimintaoleh:parentApplication.ukontak, mrdimintaolehkontak:0, mrmintake:0, mrtgldipakai:dttanggaldibutuhkan.text, 
					mruraian:txturaian.text, mrcatatan:txtcatatan.text, mrnoref:txtnoref, mrtglnoref:dttanggalnoref, mrstatusts:0, mrstatusrs:0, mrstatus:cmbprogress.selectedItem.v, 
					mrstatussebelumnya:0, mrjmlrevisi:0, mrcetakanke:0, mrinputuser:parentApplication.userid, mrinputtgl:tglDB, 
					mrmodifikasiuser:0, mrmodifikasitgl:tglDB, mrisclose:0, mrcustomtext1:'', mrcustomtext2:'', mrcustomtext3:'', mrcustomtext4:'', 
					mrcustomtext5:'', mrcustomint1:0, mrcustomint2:0, mrcustomint3:0, mrcustomdbl1:0, mrcustomdbl2:0, mrcustomdbl3:0, 
					mrcustomdate1:parentApplication.m.DateFirst, mrcustomdate2:parentApplication.m.DateFirst, mrcustomdate3:parentApplication.m.DateFirst
				}]);
				
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				if(parentApplication.rowIndex < dg1.dataProviderLength)
				with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
					switch(column){
						case 'jumlah':
							customdbl1 = (Number(jumlah) *  Number(nilaisatuan))/ Number(nilaisatuanlapangan);
							jmlbarang = Number(jumlah) * Number(nilaisatuan);
//							customdbl1 = Number(jumlah) / Number(nilaisatuanlapangan);
							break;
						case 'customdbl1':
							jumlah = (Number(nilaisatuanlapangan) / Number(nilaisatuan)) * Number(customdbl1)
							jmlbarang = Number(jumlah) * Number(nilaisatuan);
//							jumlah = Number(customdbl1) * Number(nilaisatuanlapangan);
//							jmlbarang = Number(jumlah) * Number(nilaisatuan);
							break;
					}
				}
				parentApplication.F_dgRefresh(dg);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
						var  jenissimpan:int = 1;
						if(isUpdate == false){
							jenissimpan = 1
						}else{
							jenissimpan = 2
						}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(3,3,jenissimpan)==true){
							f_simpan();
						}
						}
						break;
				}
			}	
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtdimintaoleh':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1) AND kkode ="'+txtdimintaoleh.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif = 1)';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtdimintake':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M") AND kkode ="'+txtdimintake.text.split("'").join("\\'")+'"';
						csfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).mrdimintaoleh+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).mrdimintaoleh+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtgudangasal':
						paket = 'CdM1_Warehouse';
						wsfilter = 'wkode ="'+txtgudangasal.text.split('"').join('\\"')+'"';
						csfilter = '';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case 'txtgudangtujuan':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode ="'+txtgudangtujuan.text.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "MR"';
						sort = 'tnkode asc';
						break;
					case 'kode':
						if(txtgudangtujuan.text.length > 0){
							FlexGlobals.topLevelApplication.txtGudang = FlexGlobals.topLevelApplication.sptSubParam+txtgudangtujuan.text;
							
							paket = 'CdM1_Item';
							wsfilter = 'baktif = 1 AND bassembly <> 1 AND bkode = "'+obj.kode.split('"').join('\\"')+'"';
							csfilter = 'baktif = 1 AND bassembly <> 1';
							sort = 'bkode asc';
						}else{
							Alert.show("Gudang tujuan harus diisi terlebih dahulu", "Informasi");
						}
						
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif = 1 AND ukode = "'+obj.satuan.split('"').join('\\"')+'"';
						csfilter = 'uaktif = 1';
						sort = 'ukode asc';
						break;
					case 'customtext1':
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif = 1 AND ukode = "'+obj.customtext1.split('"').join('\\"')+'"';
						csfilter = 'uaktif = 1';
						sort = 'ukode asc';
						break;
					case 'matauang':
						paket = 'CdM1_Currency';
						wsfilter = 'caktif = 1 AND ckode = "'+obj.matauang.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						sort = 'ckode asc';
						break;
					case 'cabang':
						paket = 'CdM1_Branch';
						wsfilter = 'baktif = 1 AND bkode = "'+obj.cabang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'lokasi':
						paket = 'CdM1_Location';
						wsfilter = 'laktif = 1 AND lkode = "'+obj.lokasi.split('"').join('\\"')+'"';
						csfilter = 'laktif = 1';
						sort = 'lkode asc';
						break;
					case 'gudangasal':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode = "'+obj.gudangasal.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'gudangtujuan':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode = "'+obj.gudangtujuan.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "MR"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'" AND sdkode = "'+obj.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case 'proyek':
						paket = 'CdM1_Project';
						wsfilter = 'paktif = 1 AND pkode = "'+obj.proyek.split('"').join('\\"')+'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
					case 'Test': 
						paket = 'M3_MrSearch';
						sort = 'mrinputtgl desc';
						break;
					case "AmbilPicking":
						paket = "CdM1_ItemPickingList";
						wsfilter = 'baktif=1 AND bassembly <> 1 AND btagpermintaanmutasi = 1';
						csfilter = 'baktif=1 AND bassembly <> 1 AND btagpermintaanmutasi = 1';
						csfield = 2;
						sort = 'bkode asc';
						checkbox = true;
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				if (dg1.dataProvider != null && parentApplication.rowIndex < dg1.dataProviderLength)
				var ob : Object = dg1.dataProvider[parentApplication.rowIndex];
				var s:String = parentApplication.subject;
				var p:int = 0;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtdimintaoleh':
							txtdimintaoleh.text = obj.kkode;
							lbldimintaoleh.text = obj.knama;
							u.getItemAt(0).mrdimintaoleh = obj.kid;
							break;
						case 'txtkontakperson':
							txtkontakperson.text = obj.kakodekontak;
							u.getItemAt(0).mrdimintaolehkontak = obj.kaid;
							break;
						case 'txtdimintake':
							txtdimintake.text = obj.kkode;
							lbldimintake.text = obj.knama;
							u.getItemAt(0).mrmintake = obj.kid;
							break;
						case 'txtgudangasal':
							txtgudangasal.text = obj.wkode;
							lblgudangasal.text = obj.wnama;
							for(i=0;i<dg1.dataProvider.length;i++){
								dg1.dataProvider.getItemAt(i).gudangasal = obj.wkode;
							}
//							FlexGlobals.topLevelApplication.txtGudang = txtgudangasal.text;
							break;
						case 'txtgudangtujuan':
							txtgudangtujuan.text = obj.wkode;
							lblgudangtujuan.text = obj.wnama;
							for(i=0;i<dg1.dataProvider.length;i++){
								dg1.dataProvider.getItemAt(i).gudangtujuan = obj.wkode;
							}
							FlexGlobals.topLevelApplication.txtGudang = txtgudangtujuan.text;
							break;
						case 'txtcatatan':
							txtcatatan.text = obj.tncatatan;
							break;
						case 'kode':
							ob.idbarang = obj.bid;
							ob.kode = obj.bkode;
							ob.tipe = obj.btipe;
							ob.nama = obj.bnama;
							ob.jumlah = 1;
							ob.satuan = obj.bsatuandefault;
							ob.catatan = '';
