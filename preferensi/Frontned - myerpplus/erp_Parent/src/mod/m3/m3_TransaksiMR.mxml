							case 'proyek':
								ob.proyek = '';
								break;
							case 'tampil':
							case 'tampilHistory':
							case 'simpan':
								Alert.show(parentApplication.wsErrmessage, parentApplication.l('Informasi'));
								break;
						}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtdimintaoleh':parentApplication.F_KosongkanText([txtdimintaoleh, lbldimintaoleh]);break;
					case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
					case 'txtdimintake':parentApplication.F_KosongkanText([txtdimintake, lbldimintake]);break;
					case 'txtgudangasal':parentApplication.F_KosongkanText([txtgudangasal, lblgudangasal]);break;
					case 'txtgudangtujuan':parentApplication.F_KosongkanText([txtgudangtujuan, lblgudangtujuan]);break;
					case 'txtcatatan':parentApplication.F_KosongkanText([txtcatatan]);break;
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				n.dttanggal = dttanggal.text;
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){
						u.refresh();
						// Set Utama
						with(u.getItemAt(0))
							a = [mrid, mrcabang, mrlokasi, txtgudangasal.text, txtgudangtujuan.text, mrsumber, int(chkauto.selected), 
								txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), mrkodepa, mrdimintaoleh, txtkontakperson.text, mrmintake, parentApplication.F_tglFormatDB(dttanggaldibutuhkan.text), 
								txturaian.text, txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), mrstatusts, mrstatusrs, cmbprogress.selectedItem.v, 
								mrstatussebelumnya, mrjmlrevisi, mrcetakanke, mrinputuser, parentApplication.F_tglFormatDB(mrinputtgl), mrmodifikasiuser, parentApplication.F_tglFormatDB(mrmodifikasitgl), 
								mrisclose, mrcustomtext1, mrcustomtext2, mrcustomtext3, mrcustomtext4, mrcustomtext5, mrcustomint1, 
								mrcustomint2, mrcustomint3, mrcustomdbl1, mrcustomdbl2, mrcustomdbl3, parentApplication.F_tglFormatDB(mrcustomdate1), parentApplication.F_tglFormatDB(mrcustomdate2), 
								parentApplication.F_tglFormatDB(mrcustomdate3)];
						utama = parentApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++)
							with(dg1.dataProvider.getItemAt(i)){
								a = [idmrdetail, idmr, idbarang, nama, tipe, jumlah, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, kurs, hargabeli, hargajual, 
									stokterakhir, cabang, lokasi, gudangasal, gudangtujuan, costcenter, divisi, 
									subdivisi, proyek, catatan, (i+1), jmlts, statusts, jmlrs, 
									statusrs, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
									customdbl3, parentApplication.F_tglFormatDB(customdt1), parentApplication.F_tglFormatDB(customdt2), parentApplication.F_tglFormatDB(customdt3)];
								if(i == 0)detail = parentApplication.F_splitArrayToString(a);
								else detail += "▲"+parentApplication.F_splitArrayToString(a);
							}
						parentApplication.F_wsSimpan('simpan', "M3_MrSimpan", parentApplication.userid, isUpdate, utama, detail);	// kirim ketika simpan ke WS
					}
				}
				
				function validasiForm():void
				{
					pesanAlert='';
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					if(txtdimintaoleh.text.length == 0)parentApplication.msgAlert(txtdimintaoleh,'Diminta Oleh');
					if(txtdimintake.text.length == 0)parentApplication.msgAlert(txtdimintake,'Diminta Ke');
					if(txtgudangasal.text.length == 0)parentApplication.msgAlert(txtgudangasal,'Gudang Asal');
					if(txtgudangtujuan.text.length == 0)parentApplication.msgAlert(txtgudangtujuan,'Gudang Tujuan');
					if(dttanggal.text.length == 0)parentApplication.msgAlert(dttanggal,'Tanggal');
					if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttanggaldibutuhkan.text.length == 0)parentApplication.msgAlert(dttanggaldibutuhkan,'Tanggal Dibutuhkan');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)parentApplication.msgAlert(cmbprogress,'Progress');
					if(dg1.dataProvider.getItemAt(0).idmrdetail == null )parentApplication.msgAlert(dg1,'Detail Item');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
				
			public function f_hitungTotal():void
			{
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				parentApplication.F_acAdd(dg1);			// menambah 1 baris lagi
				dg1.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
