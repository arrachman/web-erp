			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtbagianmutasi':parentApplication.F_KosongkanText([txtbagianmutasi, lblbagianmutasi]);break;
					case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
					case 'txtgudangasal':parentApplication.F_KosongkanText([txtgudangasal, lblgudangasal]);break;
					case 'txtgudangtransit':parentApplication.F_KosongkanText([txtgudangtransit, lblgudangtransit]);break;
					case 'txtgudangtujuan':parentApplication.F_KosongkanText([txtgudangtujuan, lblgudangtujuan]);break;
					case 'txtcatatan':parentApplication.F_KosongkanText([txtcatatan]);break;
					case 'chk_HK':dg1.dataProvider[parentApplication.rowIndex].hk = 0;break;
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				var serial:String = '', batch:String = '';
				n.dttanggal = dttanggal.text;
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){
						u.refresh();
						// Set Utama
						with(u.getItemAt(0))
							a = [tsid, tscabang, tslokasi, txtgudangasal.text, txtgudangtransit.text, txtgudangtujuan.text, tssumber, 
								int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), tskodepa, tsbagianmutasi, txtkontakperson.text, txturaian.text, 
								txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), tsidmr, tsstatusrs, cmbprogress.selectedItem.v, tsstatussebelumnya, 
								tsjmlrevisi, tscetakanke, tsinputuser, parentApplication.F_tglFormatDB(tsinputtgl), tsmodifikasiuser, parentApplication.F_tglFormatDB(tsmodifikasitgl), tsisclose, 
								tscustomtext1, tscustomtext2, tscustomtext3, tscustomtext4, tscustomtext5, tscustomint1, tscustomint2, 
								tscustomint3, tscustomdbl1, tscustomdbl2, tscustomdbl3, parentApplication.F_tglFormatDB(tscustomdate1), parentApplication.F_tglFormatDB(tscustomdate2), parentApplication.F_tglFormatDB(tscustomdate3)];
						utama = parentApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++){
							with(dg1.dataProvider.getItemAt(i)){
								a = [idtsdetail, idts, idbarang, nama, tipe, jumlah, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, idhppkhususmasuk, cabang, lokasi, gudangasal, 
									gudangtransit, gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, 
									(i+1), idmrdetail, jmlrs, statusrs, isclose, customtext1, customtext2, 
									customtext3, customdbl1, customdbl2, customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = parentApplication.F_splitArrayToString(a);
								else detail += "▲"+parentApplication.F_splitArrayToString(a);
							}
						}
						
						//set serial
						for(var ib:int=0;ib < acserialdetail.length;ib++){
							with(acserialdetail.getItemAt(ib)){
								a = [nstid, nstjenismutasi, nstidbarang, nstkode, nstsumber, nstidtransaksi, nstsatuan, 
									1, nstcustomtext1, nstcustomtext2, nstcustomtext3, nstcustomdbl1, nstcustomdbl2, nstcustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate3),
									txtgudangasal.text, nstidserialin];
								if(serial == '')serial =FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else serial += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						// Set batch
						for(var ibb:int=0; ibb < acbatchdetail.length; ibb++){
							with(acbatchdetail.getItemAt(ibb)){
								a = [nbtid, nbtjenismutasi, nbtidbarang, nbtkode, nbtsumber, nbtidtransaksi, nbtsatuan, 
									nbtjml, nbtcustomtext1, nbtcustomtext2, nbtcustomtext3, nbtcustomdbl1, nbtcustomdbl2, nbtcustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate3),
									txtgudangasal.text, nbtidbatchin];
								if(ibb == 0)batch =FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else batch += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						
						parentApplication.F_wsSimpan("simpan", "M3_TsSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+batch+"△"+serial);
					}
				}
				
