<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:net="flash.net.*"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	
	<fx:Script> 
		<![CDATA[			
			import comp.ComKhusus;
			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.containers.Form;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			import mx.managers.PopUpManager;
			
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String, pesanAlertIng:String, img:Image, i:int, vUang:String, vTgl:String, vNotransaksi:String, vDefNotransaksi:String, getNotransaksi:String;
			public var isUpdate:Boolean;
			[Bindable] public var u:ArrayCollection;
			[Bindable]public var acserial:ArrayCollection= new ArrayCollection();
			[Bindable]public var acbatch:ArrayCollection= new ArrayCollection();
			[Bindable]public var acserialdetail:ArrayCollection= new ArrayCollection();
			[Bindable]public var acbatchdetail:ArrayCollection= new ArrayCollection();
			[Bindable]public var ws_Batch:ArrayCollection= new ArrayCollection();
			[Bindable]public var ws_Serial:ArrayCollection= new ArrayCollection();
			public var fserial : String = 's';
			public var fbatch : String = 'b';
			public var pencarian:ComKhusus;
			
			public var tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal;
			public var o:Object = {}, n:Object = {};
			public var obj:Object = {};
			
			[Bindable]protected var arrMenuBar:ArrayCollection;
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
			// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBox':																				// mengeset untuk checobox
						if(data == true && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == 'I')		// melakukan pencarian ketika klik checkbox maka melakukan pencarian barang HPP khusus
							parentApplication.F_popUpCari('chk_HK');												
						break;
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
							switch(dataField){
								case 'jumlah':
									jmlbarang = Number(jumlah) * Number(nilaisatuan);
									break;
							}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
			public function f_filtersb():void{
				fserial = 's'; fbatch = 'b';
				for(i=0; i<dg1.dataProviderLength; i++){
					if(dg1.dataProvider[i].bserial ==	1){
						if(fserial == 's'){
							fserial = '(nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}else{
							fserial += ' or (nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}
					}
					
					if(dg1.dataProvider[i].bbatch ==	1){
						if(fbatch == 'b'){
							fbatch = '(nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}else{
							fbatch += ' or (nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangasal+'")';
						}
					}
				}
			}
			
			
			// set fokus ketika pertama kali form diload ===================================
			public function f_focusOnMe():void
			{
				txtgudangasal.setFocus();
			}
			
			// set persiapan form ==========================================================
			protected function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tbagmutasi, tgudangasal, tgudangtransit, tgudangtujuan, turaian, ttanggal, tnotransaksi, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref]);
				parentApplication.F_RequiredLabel([tgudangasal, tgudangtransit, tgudangtujuan, ttanggal, tnotransaksi, tprogress]);															// set jika terdapat tab pada form
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalnoref]);									// daftarkan fungsi-fungsi datefield
				parentApplication.F_ComboBoxStandard([cmbprogress]);												// daftarkan fungsi-fungsi combobox
				parentApplication.F_txtpencarian([txtgudangasal, txtgudangtujuan]);				// daftarkan fungsi-fungsi pencarian
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);								// daftarkan fungsi-fungsi pencarian khusus
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref]);						// daftarkan funsgi-fungsi textinput
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');								// set default tanggal dari database apakah bisa edit atau tidak
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');					// set default notransaksi dari database apakah bisa edit atau tidak
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');		// set default untuk checkbox notransaksi apakah tercentang atau tidak
				tab.tabFocusEnabled = false;																		// set ketika dari textinput maka langsung fokus ke grid, tidak ke tab dahulu
				
				// fungsi menubar ==============================================================
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Ambil MR", icon:"tbtake", enabled:"true"},
					{label:"No.Serial/Batch Out", icon:"tbserialout", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"Ambil No. Serial/Batch", icon:"tbtake", children:[
						{label:"Serial", icon:"tbserialout"},
						{label:"Batch", icon:"tbserialout"}]},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbAmbilMR);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_SerialBatch);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[9].addEventListener(MouseEvent.CLICK, f_mbHistory);
				//mb.menuBarItems[10].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbPilih);
				function f_mbSimpan():void
				{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(3,4,jenissimpan)==true){
							f_simpan();
						}
					}
				}
				
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Ts");
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';	// mengosongkan kembali form filter
					f_kondisiAwal();
					acserialdetail.removeAll();
					acbatchdetail.removeAll();
				}
				function f_mbAmbilMR():void
				{
					if(txtgudangasal.text.length <= 0 && txtgudangtujuan.text.length <= 0){
						txtgudangasal.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal dan Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}else if(txtgudangasal.text.length <= 0){
						txtgudangasal.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}else if(txtgudangtujuan.text.length <= 0){
						txtgudangtujuan.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}else{
//						parentApplication.F_popUpCari("ambilMR");
						parentApplication.F_popUpCari("ambilTS");
					}
				}
				function f_SerialBatch():void{
					if(mb.menuBarItems[4].enabled==true){
						o.ceks = true; o.cekb = true;
						o.sumber = 'TS';
						o.moduleid = 3;
						o.mnid = 4;
						o.idgrid = dg1.id;
						o.gudang = txtgudangasal.text;
						f_filtersb();
						o.aserial = acserialdetail;
						o.abatch = acbatchdetail;
						
						FlexGlobals.topLevelApplication.openFormX("No. Serial/Batch",1,'mod/m0/m0_SerialOut.swf',426,602,'t1');
					}
					
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[5].enabled == true){
						parentApplication.F_OpenNotes('Ts', u.getItemAt(0).tsid, txtnotransaksi.text);			// buka form note transaksi
					}
				}
				
				function f_mbUpload():void
				{
					if(mb.menuBarItems[6].enabled == true){
						parentApplication.F_OpenUploadFile('TS', u.getItemAt(0).tsid, txtnotransaksi.text);		// buka form upload file
					}
				}
				
				function f_mbLinks():void
				{
					if(mb.menuBarItems[7].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(3,'Ts');
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
				function f_mbPilih(e:MenuEvent):void{
					switch (e.label){
						case 'Serial':
							FlexGlobals.topLevelApplication.F_popUpCari("AmbilSerial");
							break;
						case 'Batch' :
							FlexGlobals.topLevelApplication.F_popUpCari("AmbilBatch");
							break;
					}
				}
				// untuk ambil setting dari Json ===============================================
				FlexGlobals.topLevelApplication.F_RegGrid(3, 4, [dg1], 'TransaksiBarang');
				f_validasi();
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_TsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_TsGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			protected function f_kondisiAwal():void
			{
				isUpdate = false;																					// set untuk isupdate
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);			// set item combobox progress pertama kali
				parentApplication.F_SetNilaiText([dttanggal, dttanggalnoref], parentApplication.DefaultTanggal);	// set datefield dengan tanggal sekarang
				parentApplication.F_SetNilaiText([], 0);															// set text input dengan nilai 0
				parentApplication.F_KosongkanText([txtbagianmutasi, lblbagianmutasi, txtkontakperson, txtgudangasal, lblgudangasal, txtgudangtransit, lblgudangtransit, txtgudangtujuan, lblgudangtujuan, txtcatatan, txtnoref]);	// set kosongkan text input
				txtnotransaksi.text = 'Auto';																		// set notransaksi dengan text "Auto"		
				txturaian.text = parentApplication.getNomor("TS");													// set text input uraian dengan ambil dari setting database
				txtcatatan.text = parentApplication.getNomor("TS",1);												// set text input catatan dengan ambil dari setting database
				txtgudangasal.text = parentApplication.ugudang;														// set text input gudang dengan ambil dari parent
				lblgudangasal.text = parentApplication.ugudangnama;													// set label gudang dengan ambil dari parent
				txtgudangtransit.text = parentApplication.getSetting(3, 'defaultgudang', 'GudangTransit');			// set text input gudang transit dengan ambil dari setting database
				lblgudangtransit.text = parentApplication.getSetting(3, 'defaultgudang', 'GudangTransitNama');		// set label gudang transit dengan ambil dari setting database
				cmbprogress.enabled = true;																			// set combobox progress untuk bisa diedit
				cmbprogress.selectedIndex = 1;																		// set combobox progress untuk menselect index yang nomer satu
				mb.menuBarItems[0].enabled = true;																	// set menubar untuk bisa diklik
				mb.menuBarItems[5].enabled = false;																	// set menubar untuk bisa diklik
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].enabled = false;// set menubar untuk bisa diklik
				mb.menuBarItems[9].visible = false;
				mb.menuBarItems[10].visible = false;
				if (vTgl == '0'){																					// set ketika default tanggal yang diambil dari setting bernilai 1 maka tanggal tidak bisa edit.
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){																			// set ketika default notransaksi yang diambil dari setting bernilai 1 maka checkbox auto terselect dan tidak dapat edit
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{																								// set ketika default notransaksi yang diambil dari setting tidak bernilai 1 maka mengecek vDefNotransaksi
					if (vDefNotransaksi == '0'){																	// set ketika vDefNotransaksi yang diambil dari setting bernilai 0 maka checkbox tidak terselect
						chkauto.selected = false;
					}else{
						chkauto.selected = true;																	// set ketika vDefNotransaksi yang diambil dari setting bernilai 0 maka checkbox tidak terselect
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				// set utama ==============================================
				u = new ArrayCollection([{
					tsid:0, tscabang:parentApplication.ucabang, tslokasi:parentApplication.ulokasi, tsgudangasal:'', tsgudangtransit:'', tsgudangtujuan:'', tssumber:'TS', 
					tsautonotransaksi:0, tsnotransaksi:txtnotransaksi.text, tstgl:dttanggal.text, tskodepa:0, tsbagianmutasi:parentApplication.ukontak, tsbagianmutasikontak:txtkontakperson.text, tsuraian:txturaian.text, 
					tscatatan:txtcatatan.text, tsnoref:txtnoref.text, tstglnoref:dttanggalnoref.text, tsidmr:0, tsstatusrs:0, tsstatus:cmbprogress.selectedItem.v, tsstatussebelumnya:0, 
					tsjmlrevisi:0, tscetakanke:0, tsinputuser:parentApplication.userid, tsinputtgl:tglDB, tsmodifikasiuser:0, tsmodifikasitgl:tglDB, tsisclose:0, 
					tscustomtext1:'', tscustomtext2:'', tscustomtext3:'', tscustomtext4:'', tscustomtext5:'', tscustomint1:0, tscustomint2:0, 
					tscustomint3:0, tscustomdbl1:0, tscustomdbl2:0, tscustomdbl3:0, tscustomdate1:parentApplication.m.DateFirst, tscustomdate2:parentApplication.m.DateFirst, tscustomdate3:parentApplication.m.DateFirst
				}]);
			}
			
			// set untuk fungsi keyboard =================================================
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(3,4,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			// set untuk fungsi perhitungan2 pada grid =================================================
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				if(parentApplication.rowIndex < dg1.dataProviderLength)
					with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
						switch(column){
							case 'jumlah':
								jmlbarang = Number(jumlah) * Number(nilaisatuan);
								break;
							case 'pre_del':
								hapusserial();
								hapusbatch();
								break;
						}
					}
				parentApplication.F_dgRefresh(dg);
			}
			
			// set filter transaksi =====================================================================
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String='';
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)	// ketika kondisi ini maka var obj akan terisi
					obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtbagianmutasi':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M") AND kkode ="'+txtbagianmutasi.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).tsbagianmutasi+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).tsbagianmutasi;
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtgudangasal':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif=1 AND wkode ="'+txtgudangasal.text.split('"').join('\\"')+'"';
						csfilter = 'waktif=1';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case 'txtgudangtransit':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif=1 AND wkode ="'+txtgudangtransit.text.split('"').join('\\"')+'"';
						csfilter = 'waktif=1';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case 'txtgudangtujuan':
						paket = 'CdM1_WarehouseAll';
						wsfilter = 'waktif=1 AND wkode ="'+txtgudangtujuan.text.split('"').join('\\"')+'"';
						csfilter = 'waktif=1';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif=1 AND tnsumber = "TS"';
						sort = 'tnkode asc';
						break;
					case "AmbilSerial":
						paket = 'CdM1_NoSerialGroup';
						csfilter = 'nsiisclose = 0 and nsigudang = "'+txtgudangasal.text+'"';
						sort = 'nsikode ASC';
						checkbox = true;
						id = 'nsikode';
						pencarian = new ComKhusus;
						PopUpManager.addPopUp(pencarian, this, true);
						PopUpManager.removePopUp(pencarian);
						pencarian.vSort = sort;
						pencarian.vPaket = paket;
						pencarian.idmodule = parentApplication.idmod; 
						pencarian.vTarget = target;
						pencarian.vFilterDefault = csfilter;
						pencarian.vModeCB = checkbox;
						pencarian.kondisi = '';
						pencarian.vID = id;
						pencarian.f_kondisiAwal();
						return ['', wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
						break;
					case "AmbilBatch":
						paket = 'CdM1_NoBatchGroup';
						csfilter = 'nbiisclose = 0 and nbigudang = "'+txtgudangasal.text+'"';
						sort = 'nbikode ASC'
						checkbox = true;
						id = 'nbikode';
						pencarian = new ComKhusus;
						PopUpManager.addPopUp(pencarian, this, true);
						PopUpManager.removePopUp(pencarian);
						pencarian.vSort = sort;
						pencarian.vPaket = paket;
						pencarian.idmodule = parentApplication.idmod; 
						pencarian.vTarget = target;
						pencarian.vFilterDefault = csfilter;
						pencarian.vModeCB = checkbox;
						pencarian.kondisi = '';
						pencarian.vID = id;
						pencarian.f_kondisiAwal();
						return ['', wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
						break;
					case 'kode':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 AND bkode = "'+obj.kode.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1';
						sort = 'bkode asc';
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif=1 AND ukode = "'+obj.satuan.split('"').join('\\"')+'"';
						csfilter = 'uaktif=1';
						sort = 'ukode asc';
						break;
					case 'chk_HK':
						paket = 'CdM1_Cogs_Special_In';
