			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
			public function f_tampilkan():void
			{
				parentApplication.vpFocusEvent = true;
				strFilter = '';
				strSort = cmbsort.selectedItem.sort+', bkode asc';
				if(txtgudang.text.length <= 0){txtgudang.setFocus(); Alert.show(parentApplication.l('Gudang harus diisi terlebih dahulu'), parentApplication.l('Informasi')); return;}
				if(txtkode1.text != '' && txtkode2.text != ''){
					strFilter = parentApplication.TambahFilter(strFilter, 'bkode BETWEEN "'+txtkode1.text+'" AND "'+txtkode2.text+'"'); 
				}else if(txtkode1.text != ''){
					strFilter = parentApplication.TambahFilter(strFilter, 'bkode >= "'+txtkode1.text+'"'); 
				}else if(txtkode2.text != ''){
					strFilter = parentApplication.TambahFilter(strFilter, 'bkode <= "'+txtkode2.text+'"');
				}
				if(txtlokasi1.text != '' && txtlokasi2.text != ''){
					strFilter = parentApplication.TambahFilter(strFilter, 'blgkodelokasi BETWEEN "'+txtlokasi1.text+'" AND "'+txtlokasi2.text+'"'); 
				}else if(txtlokasi1.text != ''){
					strFilter = parentApplication.TambahFilter(strFilter, 'blgkodelokasi >= "'+txtlokasi1.text+'"'); 
				}else if(txtlokasi2.text != ''){
					strFilter = parentApplication.TambahFilter(strFilter, 'blgkodelokasi <= "'+txtlokasi2.text+'"');
				}
				if(txtgudang.text != ''){
					strFilter = parentApplication.TambahFilter(strFilter, 'kgudang = "'+ txtgudang.text +'"');
				}
				if(txtfilter.text != ''){
					switch(cmboperation.selectedIndex){
						case 0:strFilter+=' AND '+cmbfield.selectedItem.v+' like "%'+txtfilter.text.split('"').join('\\"')+'%"'; break;
						case 1:strFilter+=' AND '+cmbfield.selectedItem.v+' ="'+txtfilter.text.split('"').join('\\"')+'"'; break;
						case 2:strFilter+=' AND '+cmbfield.selectedItem.v+' <> "'+txtfilter.text.split('"').join('\\"')+'"'; break;
						case 3:strFilter+=' AND '+cmbfield.selectedItem.v+' < "'+txtfilter.text.split('"').join('\\"')+'"';	break;
						case 4:strFilter+=' AND '+cmbfield.selectedItem.v+' > "'+txtfilter.text.split('"').join('\\"')+'"'; break;
						case 5:strFilter+=' AND '+cmbfield.selectedItem.v+' <= "'+txtfilter.text.split('"').join('\\"')+'"'; break;
						case 6:strFilter+=' AND '+cmbfield.selectedItem.v+' >= "'+txtfilter.text.split('"').join('\\"')+'"'; break;
						case 7:strFilter+=' AND '+cmbfield.selectedItem.v+' like "'+txtfilter.text.split('"').join('\\"')+'%"'; break;
						case 8:strFilter+=' AND '+cmbfield.selectedItem.v+' like "%'+txtfilter.text.split('"').join('\\"')+'"';	break;
					}
				}
				parentApplication.F_wsSearch('tampilkan', 'M3_Sp_TakedataSearch', 0, 0, strFilter, strSort);
//					}
//				}
			}
			
			
