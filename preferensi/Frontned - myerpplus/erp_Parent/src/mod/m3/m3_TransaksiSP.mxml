	<fx:Script> 
		<![CDATA[			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			protected var img:Image, i:int, isUpdate:Boolean, vUang:String, vTgl:String, vNotransaksi:String, vDefNotransaksi:String, getNotransaksi:String;
			[Bindable] public var u:ArrayCollection;
			public var validasi:Boolean, pesanAlert:String, t:TitleWindow, tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal;
			public var o:Object = {}, n:Object = {};
			public var obj:Object = {};
			protected var arrMenuBar:ArrayCollection;
			
			public var strFilter:String = "";
			public var strSort:String = "";
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
// mengeset ketika change pada grid =========================================			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
						switch(dataField){
							case 'satuan':
							case 'jmlbagus':
							case 'jmlrusak':
							case 'jmlselisih':
								with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
									jmlfisik = Number(jmlbagus) + Number(jmlrusak),
										selisih = Number(jmlsistem - jmlfisik),
										jmlbarangsistem = Number(jmlsistem) * nilaisatuan,
										jmlbarangfisik = Number(jmlfisik) * nilaisatuan,
										jmlbarangbagus = Number(jmlbagus) * nilaisatuan,
										jmlbarangrusak = Number(jmlrusak) * nilaisatuan,
										selisihbarang = Number(selisih) * nilaisatuan
								break;
							case 'jmlsistem':
									selisih = Number(jmlsistem) - int(jmlfisik),
										jmlbarangsistem = Number(jmlsistem) * nilaisatuan,
										jmlbarangfisik = Number(jmlfisik) * nilaisatuan,
										selisihbarang = Number(selisih) * nilaisatuan
								break;
							case 'selisih':
									selisihbarang = Number(selisih) * nilaisatuan
								break;
							case 'jmlfisik':
									jmlbarangfisik = Number(jmlfisik) * nilaisatuan,
									selisih = Number(jmlsistem - jmlfisik),
									selisihbarang = Number(jmlsistem - jmlfisik) * nilaisatuan
								break;
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
// set fokus ketika pertama kali form diload ===================================			
			public function f_focusOnMe():void
			{
				txtgudang.setFocus();
			}

// set persiapan form ==========================================================
			public var TampilkanStockSistem:Boolean;
			public var sort : String;
			public function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tbagSP, tgudang, tlokasi, tkode, tfilter, turaian, ttanggal, tnotransaksi, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref]);
				parentApplication.F_RequiredLabel([tgudang, ttanggal, tnotransaksi, tprogress]);
				cmbfield.dataProvider = new ArrayCollection([{l:'Tipe', v:'btipe'}, {l:'Nama', v:'bnama'}, {l:'Satuan', v:'bsatuan'}]);
				cmboperation.dataProvider = new ArrayCollection([{l:'Berisi'}, {l:'='}, {l:'<>'}, {l:'<'}, {l:'>'}, {l:'<='}, {l:'>='}, {l:'Diawali'}, {l:'Diakhiri'}]);
				cmbsort.dataProvider = new ArrayCollection([{l:'Lokasi, Kategori', v:'0', sort : "blgnamalokasi, bkategori"}, {l:'Lokasi', v:'1', sort:"blgnamalokasi"}, {l:'Kategori, Lokasi', v:'2', sort:"bkategori, blgnamalokasi"}, {l:'Kategori', v:'3', sort:"bkategori"}]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress, cmbfield, cmboperation, cmbtahap, cmbsort]);
				parentApplication.F_txtpencarian([txtgudang, txtlokasi1, txtlokasi2, txtkode1, txtkode2]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref, txtfilter]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				if(parentApplication.getSetting(3, 'stockopname', 'TampilkanStockSistem') == 0){
					TampilkanStockSistem = false;
				}else{
					TampilkanStockSistem = true;
				}
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[8].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				
				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(3,7,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Sp');
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbTampilkan():void
				{
					f_tampilkan();
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[4].enabled == true){
						parentApplication.F_OpenNotes('Sp', u.getItemAt(0).spid, txtnotransaksi.text);
					}
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[5].enabled == true){
						parentApplication.F_OpenUploadFile('SP', u.getItemAt(0).spid, txtnotransaksi.text);
					}
				}
				function f_mbLinks():void
				{
					FlexGlobals.topLevelApplication.f_mbLinks(3, 'Sp');
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(3, 7, [dg1], 'TransaksiBarang');
				f_validasi();
				f_kondisiAwal();
			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_SpHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					else  {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_SpGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				isUpdate = false;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				parentApplication.F_SetNilaiText([dttanggal, dttanggalnoref], parentApplication.DefaultTanggal);
				parentApplication.F_SetNilaiText([], 0);
				parentApplication.F_KosongkanText([txtgudang, lblgudang, txtlokasi1, txtlokasi2, txtkode1, txtkode2, txtfilter, txtbagianstokopname, txtkontakperson, txturaian, txtcatatan, txtnoref]);
				txtnotransaksi.text = 'Auto';
				txtbagianstokopname.text = parentApplication.ukontakkode;
				lblbagianstokopname.text = parentApplication.ukontaknama;
				txturaian.text = parentApplication.getNomor("SP");
				txtcatatan.text = parentApplication.getNomor("SP",1);
				txtgudang.text = parentApplication.ugudang;
				parentApplication.vpVarCurrent = txtgudang.text;
				lblgudang.text = parentApplication.ugudangnama;
				cmbprogress.enabled = true;
				cmbprogress.selectedIndex = 1;
				cmbsort.selectedIndex = FlexGlobals.topLevelApplication.getSetting(3,"stockopname","DefaultOrder")
				if(cmbtahap.dataProvider.length > 0){
					cmbtahap.dataProvider.removeAll();
				}
				for(var a:int = 0; a< int(parentApplication.getSetting(3, 'stockopname', 'JmlStepStockOpname')); a++){
					cmbtahap.dataProvider.addItem({l:"Tahap "+int(a+1), v:int(a+1)})
				}
				cmbtahap.selectedIndex = 0;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				mb.menuBarItems[8].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				u = new ArrayCollection([{spid:0, spcabang:parentApplication.ucabang, splokasi:parentApplication.ulokasi, spgudang:parentApplication.ugudang, spsumber:'SP', spautonotransaksi:0, spnotransaksi:txtnotransaksi.text, 
					sptgl:dttanggal.text, spkodepa:0, spbagiansp:parentApplication.ukontak, spbagianspkontak:txtkontakperson.text, spuraian:txturaian.text, spcatatan:txtcatatan.text, spnoref:txtnoref.text, 
					sptglnoref:dttanggalnoref.text, spstatussa:0, spstatus:cmbprogress.selectedItem.v, spstatussebelumnya:0, spjmlrevisi:0, spcetakanke:0, spinputuser:parentApplication.userid, 
					spinputtgl:tglDB, spmodifikasiuser:0, spmodifikasitgl:tglDB, spposting:0, sptutupperiode:0, spisclose:0, spcustomtext1:'', 
					spcustomtext2:'', spcustomtext3:'', spcustomtext4:'', spcustomtext5:'', spcustomint1:0, spcustomint2:0, spcustomint3:0, 
					spcustomdbl1:0, spcustomdbl2:0, spcustomdbl3:0, spcustomdate1:parentApplication.m.DateFirst, spcustomdate2:parentApplication.m.DateFirst, spcustomdate3:parentApplication.m.DateFirst}]);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
						var  jenissimpan:int = 1;
						if(isUpdate == false){
							jenissimpan = 1
						}else{
							jenissimpan = 2
						}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(3,7,jenissimpan)==true){
							f_simpan();
						}
						}
						break;
					case Keyboard.F:
						if(e.ctrlKey)f_tampilkan();
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				switch(column){
					case 'satuan':
//					case 'nilaisatuan':
					case 'jmlbagussetting':
					case 'jmlbagus':
					case 'jmlrusak':
					case 'jmlselisih':
//						with(dg.dataProvider.getItemAt(parentApplication.rowIndex)){
//							jmlbagus = Number(jmlbagussetting)
//							jmlfisik = Number(jmlbagus) + int(jmlrusak);
//							selisih = Number(jmlsistem - jmlfisik);
//							jmlbarangsistem = Number(jmlsistem) * nilaisatuan;
//							jmlbarangfisik = Number(jmlfisik) * nilaisatuan;
//							jmlbarangbagus = Number(jmlbagus) * nilaisatuan;
//							jmlbarangrusak = Number(jmlrusak) * nilaisatuan;
//							selisihbarang = Number(selisih) * nilaisatuan;
//							if(TampilkanStockSistem == true){
//								selisihsetting = selisih;
//							}
//						}
						with(dg.dataProvider.getItemAt(parentApplication.rowIndex)){
//							jmlfisik = Number(jmlbagus) + int(jmlrusak);
							jmlfisik = Number(jmlbagussetting) + int(jmlrusak);
							selisih = Number(jmlsistem - jmlfisik);
//							jmlbarangsistem = Number(jmlsistem) * nilaisatuan;
//							jmlbarangfisik = Number(jmlfisik) * nilaisatuan;
//							jmlbarangbagus = Number(jmlbagus) * nilaisatuan;
//							jmlbarangrusak = Number(jmlrusak) * nilaisatuan;
//							selisihbarang = Number(selisih) * nilaisatuan;
							jmlbarangsistem = Number(jmlsistem) * nilaisatuan;
							jmlbarangfisik = Number(jmlfisik) * nilaisatuan;
							jmlbarangbagus = Number(jmlbagussetting) * nilaisatuan;
							jmlbarangrusak = Number(jmlrusak) * nilaisatuan;
							selisihbarang = Number(selisih) * nilaisatuan;
							if(TampilkanStockSistem == true){
								selisihsetting = selisih;
							}
						}
						
						break;
					case 'jmlsistem':
						with(dg.dataProvider.getItemAt(parentApplication.rowIndex)){
							selisih = Number(jmlsistem) - int(jmlfisik);
							jmlbarangsistem = Number(jmlsistem) * nilaisatuan;
							jmlbarangfisik = Number(jmlfisik) * nilaisatuan;
							selisihbarang = Number(selisih) * nilaisatuan;
							
							if(TampilkanStockSistem == true){
								selisihsetting = selisih;
							}
						}
							
						break;
					case 'selisih':
						with(dg.dataProvider.getItemAt(parentApplication.rowIndex)){
							selisihbarang = Number(selisih) * nilaisatuan
							if(TampilkanStockSistem == true){
								selisihsetting = selisih;
							}
						}
						break;
					case 'jmlfisik':
						with(dg.dataProvider.getItemAt(parentApplication.rowIndex)){
							jmlbarangfisik = Number(jmlfisik) * nilaisatuan;
							selisih = Number(jmlsistem - jmlfisik);
							selisihbarang = Number(jmlsistem - jmlfisik) * nilaisatuan
							if(TampilkanStockSistem == true){
								selisihsetting = selisih;
							}
						}
						
						break;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode ="'+txtgudang.text.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'txtlokasi1':
						paket = 'M1_Item_LocationSearch';
						wsfilter = 'ilkode ="'+txtlokasi1.text.split('"').join('\\"')+'"';
						csfilter = '';
						sort = 'ilkode asc';
						break;
					case 'txtlokasi2':
						paket = 'M1_Item_LocationSearch';
						wsfilter = 'ilkode ="'+txtlokasi2.text.split('"').join('\\"')+'"';
						csfilter = '';
						sort = 'ilkode asc';
						break;
					case 'txtkode1':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 AND baktif = 1 AND bkode ="'+txtkode1.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1';
						sort = 'bkode asc';
						break;
					case 'txtkode2':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 AND baktif = 1 AND bkode ="'+txtkode2.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1';
						sort = 'bkode asc';
						break;
					case 'txtbagianstokopname':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M") AND kkode ="'+txtbagianstokopname.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).spbagiansp+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).spbagiansp+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "SP"'; 
						sort = 'tnkode asc';
						break;
					case 'kodebarang':
						if(txtgudang.text != ''){
							paket = 'M3_Sp_TakedataSearch';
							wsfilter = 'kgudang = "'+txtgudang.text+'" AND bkode = "'+obj.kodebarang.split('"').join('\\"')+'"';
							csfilter = 'kgudang = "'+txtgudang.text+'"'; 
							sort = 'bkode asc';
						}else{
							Alert.show("Gudang harus diisi terlebih dahulu", "Informasi");
						}
						break;
					case 'cabang':
						paket = 'CdM1_Branch';
						wsfilter = 'baktif = 1 AND bkode = "'+obj.cabang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'lokasi':
						paket = 'CdM1_Location';
						wsfilter = 'laktif = 1 AND lkode = "'+obj.lokasi.split('"').join('\\"')+'"';
						csfilter = 'laktif = 1';
						sort = 'lkode asc';
						break;
					case 'gudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode = "'+obj.gudang.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "SP"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'" AND sdkode = "'+obj.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case 'proyek':
						paket = 'CdM1_Project';
						wsfilter = 'paktif = 1 AND pkode = "'+obj.proyek.split('"').join('\\"')+'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
