					case 'txtlokasi1':parentApplication.F_KosongkanText([txtlokasi1]);break;
					case 'txtlokasi2':parentApplication.F_KosongkanText([txtlokasi2]);break;
					case 'txtkode1':parentApplication.F_KosongkanText([txtkode1]);break;
