	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Text;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.CheckBox;
			import spark.components.DataGrid;
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String, pesanAlertIng:String, img:Image, i:int, vUang:String, vTgl:String, vNotransaksi:String, vDefNotransaksi:String, vPosting:String, nreklawan:String, getNotransaksi:String;
			[Bindable] public var u:ArrayCollection;
			public var tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal, isUpdate:Boolean;
			public var o:Object = {}, n:Object = {};
			public var obj:Object = {};
			[Bindable]public var ac_Serial:ArrayCollection = new ArrayCollection();
			[Bindable]public var ac_Batch:ArrayCollection = new ArrayCollection();
			[Bindable]public var ws_Serial:ArrayCollection = new ArrayCollection();
			[Bindable]public var ws_Batch:ArrayCollection = new ArrayCollection();
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction;
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
			// mengeset ketika change pada grid =========================================			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBox':																				// mengeset untuk checobox
						if(data == true && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == 'I')		// melakukan pencarian ketika klik checkbox maka melakukan pencarian barang HPP khusus
							parentApplication.F_popUpCari('chk_HK');
						break;
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex))
							switch(dataField){
								case 'nilaisatuan':
									jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan,
									jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan
									break;
								case 'jmlmasuk':
									jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan,
									jmlkeluar = 0,
									jmlbarangkeluar = 0
									if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == "I" && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).jmlkeluar > 0){
										dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 1;
									}else{
										dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 0;
									}
									break;
								case 'jmlkeluar':
									jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan,
									jmlmasuk = 0,
									jmlbarangmasuk = 0
									if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == "I" && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).jmlkeluar > 0){
										dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 1;
									}else{
										dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 0;
									}
									break;
							}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
			// set fokus ketika pertama kali form diload ===================================
			public function f_focusOnMe():void
			{
				txtgudang.setFocus();
			}
			
			// set persiapan form ==========================================================
			protected function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tbagpenyesuaian, tgudang, turaian, ttanggal, tnotransaksi, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref]);
				parentApplication.F_RequiredLabel([tgudang, ttanggal, tnotransaksi, tprogress]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtbagianpenyesuaian, txtgudang]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				vPosting = parentApplication.getSetting(0, 'accounting', 'AutoPosting');
				tab.tabFocusEnabled = false;
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"No Serial/Batch In", icon:"tbserialin", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbSerialIn);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[8].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				function f_mbSimpan():void
				{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(3,23,jenissimpan)==true){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Ib")
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					ac_Batch.removeAll();
					ac_Serial.removeAll();
					f_kondisiAwal();
				}
				function f_mbSerialIn():void {
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					if(mb.menuBarItems[3].enabled==true){
						o.moduleid = 3; o.mnid = 23; o.ibid = u[0].ibid; o.sumber = 'IB'; o.idgrid = dg1.id;
						FlexGlobals.topLevelApplication.openFormX( "Serial / Batch Number",1,'mod/m0/m0_SerialBatchIn.swf',350,650,'t1');
					}
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[4].enabled == true){
						parentApplication.F_OpenNotes('Ib', u.getItemAt(0).ibid, txtnotransaksi.text);
					}
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[5].enabled == true){
						parentApplication.F_OpenUploadFile('IB', u.getItemAt(0).ibid, txtnotransaksi.text);
					}
				}
				function f_mbLinks():void
				{
					if(mb.menuBarItems[6].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(3,'Ib');
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
				//setting grid=========================================================================================
				FlexGlobals.topLevelApplication.F_RegGrid(3, 23, [dg1], 'TransaksiBarang');
				f_validasi();
				//end of setting grid=========================================================================================
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_IbHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_IbGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			protected function f_kondisiAwal():void
			{
				o.txtkurs = parentApplication.getSetting(0, 'accounting', 'Kurs');
				o.txtmatauang = parentApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				isUpdate = false;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				parentApplication.F_SetNilaiText([dttanggal, dttanggalnoref], parentApplication.DefaultTanggal);
				parentApplication.F_SetNilaiText([], 0);
				parentApplication.F_KosongkanText([txtbagianpenyesuaian, lblbagianpenyesuaian, txtkontakperson, txtgudang, lblgudang, txturaian, txtcatatan, txtnoref]);
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("IB");
				txtcatatan.text = parentApplication.getNomor("IB",1);
				txtgudang.text = parentApplication.ugudang;
				lblgudang.text = parentApplication.ugudangnama;
				cmbprogress.enabled = true;
				cmbprogress.selectedIndex = 1;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				mb.menuBarItems[8].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				if (vPosting == '1'){
					chkposting.selected = true;
				}else{
					chkposting.selected = false;
				}
				
				u = new ArrayCollection([{ibid:0, ibcabang:parentApplication.ucabang, iblokasi:parentApplication.ulokasi, ibgudang:parentApplication.ugudang, ibsumber:'IB', ibjenis:'', ibautonotransaksi:0, 
					ibnotransaksi:txtnotransaksi.text, ibtgl:dttanggal.text, ibkodepa:0, ibbagianib:parentApplication.ukontak, ibbagianibkontak:txtkontakperson.text, ibmatauang:o.txtmatauang, ibkurs:o.txtkurs, 
					iburaian:txturaian.text, ibcatatan:txtcatatan.text, ibnoref:txtnoref.text, ibtglnoref:dttanggalnoref.text, ibstatus:cmbprogress.selectedItem.v, ibstatussebelumnya:0, ibjmlrevisi:0, 
					ibcetakanke:0, ibinputuser:parentApplication.userid, ibinputtgl:tglDB, ibmodifikasiuser:0, ibmodifikasitgl:tglDB, ibposting:0, ibpostingtgl:parentApplication.m.DateFirst, 
					ibtutupperiode:0, ibisclose:0, ibcustomtext1:'', ibcustomtext2:'', ibcustomtext3:'', ibcustomtext4:'', ibcustomtext5:'', 
					ibcustomint1:0, ibcustomint2:0, ibcustomint3:0, ibcustomdbl1:0, ibcustomdbl2:0, ibcustomdbl3:0, ibcustomdate1:parentApplication.m.DateFirst, 
					ibcustomdate2:parentApplication.m.DateFirst, ibcustomdate3:parentApplication.m.DateFirst}]);
				
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(3,23,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				mb.menuBarItems[2].enabled = true;
				mb.menuBarItems[3].enabled = true;
				
				if(parentApplication.rowIndex < dg1.dataProviderLength)
				with(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex)){
				switch(column){
					case 'nilaisatuan':
							jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan,
							jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan
						break;
					case 'jml':
							//jmlbarang = int(jml) * int(nilaisatuan)
							jmlbarang = Number(nilaisatuan) * Number(jml);
						break;
					case 'jmlmasuk':
						jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan,
						jmlkeluar = 0,
						jmlbarangkeluar = 0
						if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == "I" && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).jmlkeluar > 0){
							dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 1;
						}else{
							dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 0;
						}
						break;
					case 'jmlkeluar':
						jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan,
						jmlmasuk = 0,
						jmlbarangmasuk = 0
						if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == "I" && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).jmlkeluar > 0){
							dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 1;
						}else{
							dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 0;
						}
						break;
					}
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String='';
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtbagianpenyesuaian':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M") AND kkode ="'+txtbagianpenyesuaian.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).ibbagianib+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).ibbagianib+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode ="'+txtgudang.text.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "IB"';
						sort = 'tnkode asc';
						break;
					case 'kodebarang':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 AND bkode = "'+obj.kodebarang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1';
						sort = 'bkode asc';
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif = 1 AND ukode = "'+obj.satuan.split('"').join('\\"')+'"';
						csfilter = 'uaktif = 1';
						sort = 'ukode asc';
						break;
					case 'chk_HK':
						paket = 'CdM1_Cogs_Special_In';
						csfilter = 'isclose = 0 AND idbarang ='+dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).idbarang;
						break;
					case 'reklawan':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif = 1 AND cgd = "D" AND cnama = "'+obj.reklawan.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						sort = 'cnomor asc';
						break;
					case 'matauang':
						paket = 'CdM1_Currency';
						wsfilter = 'caktif = 1 AND ckode = "'+obj.matauang.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						sort = 'ckode asc';
						break;
					case 'cabang':
						paket = 'CdM1_Branch';
						wsfilter = 'baktif = 1 AND bkode = "'+obj.cabang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'lokasi':
						paket = 'CdM1_Location';
						wsfilter = 'laktif = 1 AND lkode = "'+obj.lokasi.split('"').join('\\"')+'"';
						csfilter = 'laktif = 1';
						sort = 'lkode asc';
						break;
					case 'gudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode = "'+obj.gudang.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "IB"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'" AND sdkode = "'+obj.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case 'proyek':
						paket = 'CdM1_Project';
						wsfilter = 'paktif = 1 AND pkode = "'+obj.proyek.split('"').join('\\"')+'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
			}
			
			public function f_wsHasil():void
			{
				if (dg1.dataProvider != null && parentApplication.rowIndex < dg1.dataProviderLength)
					var ob : Object = dg1.dataProvider[parentApplication.rowIndex];
				var b:Object = {}; var g:int; var r:Object = {}; var j:int; // variabel untuk setting serial
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama[0];
					switch(s){	
						case 'txtbagianpenyesuaian':
							txtbagianpenyesuaian.text = obj.kkode;
							lblbagianpenyesuaian.text = obj.knama;
							u.getItemAt(0).ibbagianib = obj.kid;
							break;
						case 'txtkontakperson':
							txtkontakperson.text = obj.kakodekontak;
							break;
						case 'txtgudang':
							txtgudang.text = obj.wkode;
							lblgudang.text = obj.wnama;
							for(i=0;i<dg1.dataProvider.length;i++){
								dg1.dataProvider.getItemAt(i).gudang = txtgudang.text;
							}
							break;
						case 'txtcatatan':
							txtcatatan.text = obj.tncatatan;
							break;
						case 'kodebarang':
							ob.idibdetail = 0;
							ob.idib = 0; 
							ob.idbarang = obj.bid, 
							ob.kodebarang = obj.bkode;
							ob.tipebarang = obj.btipe;
							ob.namabarang = obj.bnama;
							ob.jml = 0, 
							ob.satuan = obj.bsatuandefault;
							ob.nilaisatuan = obj.bnilaisatuandefault;
							ob.jmlbarang = Number(ob.jml) * Number(ob.nilaisatuan); 
							ob.satuanbarang = obj.bsatuan;
							ob.matauang = o.txtmatauang; 
							ob.kurs = o.txtkurs;
							ob.hpplama = obj.bhppaverage;
							ob.hpp = obj.bhppaverage;
							ob.rekpersediaan = obj.brekpersediaan;
							ob.cabang = parentApplication.ucabang;
