								parentApplication.F_tglFormatDB(ibcustomdate2), parentApplication.F_tglFormatDB(ibcustomdate3)];
						utama = parentApplication.F_splitArrayToString(a);
						
						for(i=0;i<dg1.dataProviderLength;i++){
							with(dg1.dataProvider.getItemAt(i)){
								a = [idibdetail, idib, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, kurs, hpplama, hpp, 
									rekpersediaan, cabang, lokasi, gudang, costcenter, divisi, subdivisi, 
									proyek, catatan, (i+1), isclose, customtext1, customtext2, customtext3, 
									customdbl1, customdbl2, customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = parentApplication.F_splitArrayToString(a);
								else detail += "▲"+parentApplication.F_splitArrayToString(a);
							}
						}
						
						if(ac_Batch.length <= 0){
							batch = "";
						}else{
							for(var b:int=0; b<ac_Batch.length; b++){
								with(ac_Batch.getItemAt(b)){
									a = [nbtid, nbtjenismutasi, nbtidbarang, nbtkode, nbtsumber, nbtidtransaksi, nbtsatuan, 
										nbtjml, nbtcustomtext1, nbtcustomtext2, nbtcustomtext3, nbtcustomdbl1, nbtcustomdbl2, nbtcustomdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate3),
										txtgudang.text, nbtidbatchin];
									if(b == 0){batch = parentApplication.F_splitArrayToString(a);}
									else {batch += "▲"+parentApplication.F_splitArrayToString(a);}
								}
							}
						}
						
						if(ac_Serial.length <= 0){
							serial = '';
						}else{
							for(var s:int=0;s<ac_Serial.length; s++){
								with(ac_Serial.getItemAt(s)){
									a = [nstid, nstjenismutasi, nstidbarang, nstkode, nstsumber, nstidtransaksi, nstsatuan, 
										nstjml, nstcustomtext1, nstcustomtext2, nstcustomtext3, nstcustomdbl1, nstcustomdbl2, nstcustomdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate3),
										txtgudang.text, nstidserialin];
									if(s == 0){serial = parentApplication.F_splitArrayToString(a);}
									else {serial += "▲"+parentApplication.F_splitArrayToString(a);}
								}
							}
						}
						parentApplication.F_wsSimpan("simpan", "M3_IbSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+batch+"△"+serial);
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					pesanAlertIng = "";
					pesanAlert = "";
					if(txtgudang.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtgudang,'Gudang');
					if(dttanggal.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(dttanggal,'Tanggal');
					if(txtnotransaksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(dg1.dataProvider.getItemAt(0).idibdetail == null )FlexGlobals.topLevelApplication.msgAlert(dg1,'Detail Item');
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
//					for(i = 0; i<dg1.dataProviderLength; i++){
//						if(dg1.dataProvider[i].hpp == 0 || dg1.dataProvider[i].hpp == undefined){
//							validasi = false;
//							for(var g:int=0;g<dg1.columnsLength;g++){
//								if(dg1.columns.getItemAt(g).dataField == 'hpp')
//									break;
//							}
//							dg1.setFocus(); dg1.setSelectedCell(i, g);
//							Alert.show('HPP Update harus diisi dengan benar !', 'Information');
//						}
//					}
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi == true)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlertIng+"  ("+pesanAlert+")" , "Information");}	
						validasi = false; 
					}
				}
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				parentApplication.F_acAdd(dg1);
				dg1.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
