			public function f_select(b:Boolean, idx:int):void
			{
				var ob:Object = dg.dataProvider.getItemAt(idx), j:int;
				if(b == true){
					arr.addItem({});
					for(j=0;j<p.vKolomLength;j++)
						arr.setItemAt(ob, arr.length-1);
					ob.cb = true;
				}else{
					ob.cb = false;
					for(i=0;i<arr.length;i++){
						o = arr.getItemAt(i);
						if(o[vID] == ob[vID]){
							arr.removeItemAt(i);
							break;
						}
					}
				}
				arr.refresh();
				p.F_dgRefresh(dg);
			}
			
