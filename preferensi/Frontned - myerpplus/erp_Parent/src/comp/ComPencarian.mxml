					if(vPaket == "CdM1_Item")
					{
						ir = new ClassFactory(ir_multiline);
					}
					else
					{
						ir = new ClassFactory(r_gridItemRenderer);
						
						if(align==0){
							ir.properties = {columnTextAlign:"left"};
						}else if(align==1){
							ir.properties = {columnTextAlign:"center"};
						}else if(align==2){ 
							ir.properties = {columnTextAlign:"right"};
						}
					}
					 
					if(align==0){
						hr.properties = {headerTextAlign:"left"};
					}else if(align==1){
						hr.properties = {headerTextAlign:"center"};
					}else if(align==2){ 
						hr.properties = {headerTextAlign:"right"};
					}
					cmbFilter.dataProvider.addItem({l:headerText, v:dataField});
					dg.columns.addItem(p.F_tambahKolomGrid(width, dataField, headerText, false, visible, labelFunction, hr, ir, undefined));
				}
				
