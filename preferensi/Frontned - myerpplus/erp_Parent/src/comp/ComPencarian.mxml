			// Gabungkan FilterDefault dg filter dari form dan text input filter
			protected function joinFilter(data:String):String
			{
				if(filterDefault.length == 0)
					return data;
				else if(data.length > 0)
					return filterDefault+" AND "+data;
				else
					return filterDefault;
			}
			
			protected function f_filter(event:MouseEvent):void
			{
				f_paketFilter();
			}
			
			protected function f_txtFilterKeyDown(event:KeyboardEvent):void
			{
				if(event.keyCode==Keyboard.ENTER)
					if(txtfilter.text.length > 0)
						f_paketFilter();
					else dg.setFocus();
					else if(event.keyCode==Keyboard.DOWN)
					{
						dg.selectedIndex = 0;
						dg.setFocus();
					}
			}
			
			public function f_cbClick():void
			{
				if(dg.dataProvider.getItemAt(dg.selectedIndex).cb == true)
					f_select(true, dg.selectedIndex);
				else
					f_select(false, dg.selectedIndex);
			}
			
			public function f_pilih():void
			{
				var txt:TextInput;
				if(validasi == true && dg.selectedIndex >= 0){
					PopUpManager.removePopUp(this);
					if(vModeCB == false) 
						if(dg.selectedIndex >= 0){
							arr.addItem({});
							for(i=0;i<p.vKolomLength;i++)
								arr.setItemAt(dg.dataProvider.getItemAt(dg.selectedIndex), arr.length-1);
						}else arr = null;
					arr.refresh();
					p.wsSuccess = true;
					p.subject = vTarget;
					p.wsArrUtama = arr;
					p.m[idmodule].child.f_wsHasil();
					p.F_csTrue();
					if(p.m[idmodule].child.hasOwnProperty(vTarget)){
						try
						{
							txt = p.m[idmodule].child[vTarget];
							txt.selectRange(0, txt.text.length);
						}
						catch(e:Error){}
					}
					if(parentApplication.m.bukacompencarian2)
					{
						parentApplication.m.bukacompencarian2 = false;
					}else
					parentApplication.m.bukacompencarian = false;
				}
			} 
			
			protected function f_batal():void
			{
				if(validasi == true){
					p.F_csFalse();
					PopUpManager.removePopUp(this);
					p.wsSuccess = false;
					p.subject = vTarget;
					p.vpFocusEvent = true;
					if(p.m[idmodule].child.hasOwnProperty("f_comPencarianBatal"))
						p.m[idmodule].child.f_comPencarianBatal();
					if(parentApplication.m.bukacompencarian2)
					{
						parentApplication.m.bukacompencarian2 = false;
					}else
					parentApplication.m.bukacompencarian = false;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var x:int;
				if(components == 'checkBoxHeader')
					for(x=0;x<dg.dataProviderLength;x++){
						if(dg.dataProvider.getItemAt(x).cb != data)
							f_select(data, x);
					}
				else if(components == 'checkBox')
					f_cbClick();
			}

