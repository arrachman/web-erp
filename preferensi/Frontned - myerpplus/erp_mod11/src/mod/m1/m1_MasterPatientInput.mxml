					cmbAgama.dataProvider = new ArrayCollection([{l:'Islam',v:1},{l:'Protestan',v:2},{l:'Katolik',v:3},{l:'Hindu',v:4},{l:'Budha',v:5},{l:'Kong Hu Cu',v:6}]);
					isUpdate = true;
					//txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].pkode;
					txtNama.text = dg.dataProvider[dg.selectedCell.rowIndex].pnama;
					if(dg.dataProvider[dg.selectedCell.rowIndex].pprefix == 'An')cmbPrefix.selectedIndex = 0;
					else if(dg.dataProvider[dg.selectedCell.rowIndex].pprefix == 'Tn')cmbPrefix.selectedIndex = 1;
					else if(dg.dataProvider[dg.selectedCell.rowIndex].pprefix == 'Ny')cmbPrefix.selectedIndex = 2;
					else if(dg.dataProvider[dg.selectedCell.rowIndex].pprefix == 'Sdr')cmbPrefix.selectedIndex = 3;
					else if(dg.dataProvider[dg.selectedCell.rowIndex].pprefix == 'By')cmbPrefix.selectedIndex = 4;
					else if(dg.dataProvider[dg.selectedCell.rowIndex].pprefix == 'ByNy')cmbPrefix.selectedIndex = 5;
					else if(dg.dataProvider[dg.selectedCell.rowIndex].pprefix == 'Nn')cmbPrefix.selectedIndex = 6;
					else cmbPrefix.selectedIndex = -1;
					//Alert.show(dg.dataProvider[dg.selectedCell.rowIndex].ptgllahir);
					dtTglLahir.text = dg.dataProvider[dg.selectedCell.rowIndex].ptgllahir;
					txtUmur.text = dg.dataProvider[dg.selectedCell.rowIndex].pumur;
					//cmbketumur.selectedIndex = dg.dataProvider[dg.selectedCell.rowIndex].pketumur-1;
					//Alert.show(dg.dataProvider[dg.selectedCell.rowIndex].pketumur);
					if(dg.dataProvider[dg.selectedCell.rowIndex].pjeniskelamin == 'L')cmbJenisKelamin.selectedIndex = 0;
					else if(dg.dataProvider[dg.selectedCell.rowIndex].pjeniskelamin == 'P')cmbJenisKelamin.selectedIndex = 1;
					else cmbJenisKelamin.selectedIndex = -1;
					cmbStatusPerkawinan.selectedIndex = Number(dg.dataProvider[dg.selectedCell.rowIndex].pstatusperkawinan)-1;
					cmbAgama.selectedIndex = Number(dg.dataProvider[dg.selectedCell.rowIndex].pagama)-1;
					txtAyah.text = dg.dataProvider[dg.selectedCell.rowIndex].payah;
					txtIbu.text = dg.dataProvider[dg.selectedCell.rowIndex].pibu;
					txtSuamiIstri.text = dg.dataProvider[dg.selectedCell.rowIndex].psuamiistri;
					txtNoTelepon.text = dg.dataProvider[dg.selectedCell.rowIndex].pnotelepon;
					txtNoFax.text = dg.dataProvider[dg.selectedCell.rowIndex].pnofax;
					txtNoHP.text = dg.dataProvider[dg.selectedCell.rowIndex].pnohp;
					txtNoTelpLain.text =dg.dataProvider[dg.selectedCell.rowIndex].pnoteleponlain;
					txtEmail.text = dg.dataProvider[dg.selectedCell.rowIndex].pemail;
					txtAlamat.text = dg.dataProvider[dg.selectedCell.rowIndex].palamat;
					txtDesa.text = dg.dataProvider[dg.selectedCell.rowIndex].pdesa;
					txtKecamatan.text = dg.dataProvider[dg.selectedCell.rowIndex].pkecamatan;
					txtKota.text = dg.dataProvider[dg.selectedCell.rowIndex].pkota;
					txtProvinsi.text = dg.dataProvider[dg.selectedCell.rowIndex].pprovinsi;
					txtNegara.text = dg.dataProvider[dg.selectedCell.rowIndex].pnegara;
					lblNamaDesa.text = dg.dataProvider[dg.selectedCell.rowIndex].pdesanama;
					lblNamaKecamatan.text = dg.dataProvider[dg.selectedCell.rowIndex].pkecamatannama;
					lblNamaKota.text = dg.dataProvider[dg.selectedCell.rowIndex].pkotanama;
					lblNamaProvinsi.text = dg.dataProvider[dg.selectedCell.rowIndex].pprovinsinama;
					lblNamaNegara.text = dg.dataProvider[dg.selectedCell.rowIndex].pnegaranama;
					txtKodePos.text = dg.dataProvider[dg.selectedCell.rowIndex].pkodepos;
					txtKeluargaLain.text = dg.dataProvider[dg.selectedCell.rowIndex].pkeluargalain;
					txtCatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].pcatatan;
					txtKategoriPasien.text = dg.dataProvider[dg.selectedCell.rowIndex].pkategoripasien;
					lblKategoriPasien.text = dg.dataProvider[dg.selectedCell.rowIndex].pkategoripasiennama;
					txtTingkatJual.text = dg.dataProvider[dg.selectedCell.rowIndex].ptingkatjual;
					vUserIdEdit = parentApplication.userid;
					pid = dg.dataProvider[dg.selectedCell.rowIndex].pid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].paktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_SetNilaiText([dtTglLahir], parentApplication.DefaultTanggal);
				cmbPrefix.dataProvider = new ArrayCollection([{l:'An'},{l:'Tn'},{l:'Ny'},{l:'Sdr'},{l:'By'},{l:'ByNy'},{l:'Nn'}]);
				cmbketumur.dataProvider = new ArrayCollection([{l:'Hari'},{l:'Minggu'},{l:'Bulan'},{l:'Tahun'}]);
				cmbJenisKelamin.dataProvider = new ArrayCollection([{l:'L'},{l:'P'}]);
				cmbStatusPerkawinan.dataProvider = new ArrayCollection([{l:'Belum Kawin',v:1},{l:'Sudah Kawin',v:2},{l:'Cerai Hidup',v:3},{l:'Cerai Mati',v:4},{l:'Janda',v:5},{l:'Duda',v:6}]);
				cmbAgama.dataProvider = new ArrayCollection([{l:'Islam',v:1},{l:'Protestan',v:2},{l:'Katolik',v:3},{l:'Hindu',v:4},{l:'Budha',v:5},{l:'Kong Hu Cu',v:6}]);
				cmbAgama.selectedIndex = 0;
				cmbPrefix.selectedIndex = 0;
				cmbJenisKelamin.selectedIndex = 0;
				cmbStatusPerkawinan.selectedIndex = 0;
				cmbketumur.selectedIndex = 3;
				parentApplication.F_KosongkanText([txtDesa,txtKecamatan, lblNamaDesa, lblNamaKecamatan, lblNamaKota, lblNamaNegara, lblNamaProvinsi, txtkode,txtNama,txtUmur,txtAyah,txtIbu,txtSuamiIstri,txtNoTelepon,txtKota,txtProvinsi,txtNegara,
					txtNoFax,txtNoHP,txtEmail,txtAlamat,txtKodePos,txtKeluargaLain,txtNoTelpLain,txtCatatan,txtKategoriPasien,txtTingkatJual]);
				txtKategoriPasien.text = parentApplication.getSetting(11, 'kategoripasien', 'Umum');
				lblKategoriPasien.text = parentApplication.getSetting(11, 'kategoripasiennama', 'Umum');
				txtTingkatJual.text = parentApplication.getSetting(11, 'tingkatjual', 'TingkatJual');
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String, vStatusKawin:int = 0, vAgama:int = 0;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtNama, n:'Nama', e:'Name'}, 
					{t:txtKategoriPasien, n:'Kategori Pasien', e:'Patient Category'},
					{t:dtTglLahir, n:'Tgl Lahir', e:'Birthday'}, {t:txtNoHP, n:'No HP', e:'HP'}, {t:txtAlamat, n:'Alamat', e:'Address'}]) == true){
					//akode,nama, prefix, tgllahir, umur, jeniskelamin, statusperkawinan, agama, ayah, ibu, suamiistri, notelepon, nofax, nohp, email, alamat, kota, provinsi, negara, 
					//kodepos, keluargalain, noteleponlain, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					parentApplication.m.P1 = txtkode.text;
					parentApplication.m.P2 = txtNama.text;
					parentApplication.m.P1_field = "pkode";
					parentApplication.m.P2_field = "pnama";
					
					if(cmbAgama.selectedIndex != -1)vAgama = cmbAgama.selectedItem.v;
					if(cmbStatusPerkawinan.selectedIndex != -1)vStatusKawin = cmbStatusPerkawinan.selectedItem.v;
					arr = [pid, txtkode.text,txtNama.text,cmbPrefix.textInput.text,parentApplication.F_tglFormatDB(dtTglLahir.text),Number(txtUmur.text),cmbJenisKelamin.textInput.text,
						vStatusKawin,vAgama,txtAyah.text,txtIbu.text,txtSuamiIstri.text,txtNoTelepon.text,txtNoFax.text,
						txtNoHP.text,txtEmail.text,txtAlamat.text,txtKota.text,txtProvinsi.text,txtNegara.text,txtKodePos.text,txtKeluargaLain.text,txtNoTelpLain.text,
						txtCatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt,Number(txtTingkatJual.text),txtKategoriPasien.text,lblKategoriPasien.text, txtDesa.text, txtKecamatan.text];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_PatientSimpan', utama, '')
					vUserIdEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtDesa':
						paket = 'CdM1_Village';
						wsfilter = '(vaktif = 1) AND vkode ="'+txtDesa.text.split('"').join('\\"')+'"';
						csfilter = '(vaktif = 1)';
						csfield = 2;
						sort = 'vkode asc';
						break;
					case 'txtKecamatan':
						paket = 'CdM1_Subdistrict';
						wsfilter = '(sdaktif = 1) AND sdkode ="'+txtKecamatan.text.split('"').join('\\"')+'"';
						csfilter = '(sdaktif = 1)';
						csfield = 2;
						sort = 'sdkode asc';
						break;
					case 'txtProvinsi':
						paket = 'CdM1_Province';
						wsfilter = '(paktif = 1) AND pkode ="'+txtProvinsi.text.split('"').join('\\"')+'"';
						csfilter = '(paktif = 1)';
						csfield = 2;
						sort = 'pkode asc';
						break;
					case 'txtKota':
						paket = 'CdM1_City';
						wsfilter = '(caktif = 1) AND ckode ="'+txtKota.text.split('"').join('\\"')+'"';
						csfilter = '(caktif = 1)';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case 'txtNegara':
						paket = 'CdM1_Country';
						wsfilter = '(caktif = 1) AND ckode ="'+txtNegara.text.split('"').join('\\"')+'"';
						csfilter = '(caktif = 1)';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case 'txtKategoriPasien':
						paket = 'CdM1_Patient_Category';
						wsfilter = '(pcaktif = 1) AND pckode ="'+txtKategoriPasien.text.split('"').join('\\"')+'"';
						csfilter = '(pcaktif = 1)';
						csfield = 2;
						sort = 'pckode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){			
						case 'txtDesa':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtDesa.text = o.vkode; 
							lblNamaDesa.text = o.vnama;
							txtKecamatan.text = o.vkec;
							lblNamaKecamatan.text = o.vkecnama; 
							txtKota.text = o.vkab; 
							lblNamaKota.text = o.vkabnama;
							txtProvinsi.text = o.vprov; 
							lblNamaProvinsi.text = o.vprovnama;
							txtNegara.text = o.vnegara;
							lblNamaNegara.text = o.vnegaranama;
							break;
						case 'txtKecamatan':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtKecamatan.text = o.sdkode;
							lblNamaKecamatan.text = o.sdnama;
							txtKota.text = o.sdkab; 
							lblNamaKota.text = o.sdkabnama;
							txtProvinsi.text = o.sdprov; 
							lblNamaProvinsi.text = o.sdprovnama;
							txtNegara.text = o.sdnegara;
							lblNamaNegara.text = o.sdnegaranama;
							break;
						case 'txtKota':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtKota.text = o.ckode; 
							lblNamaKota.text = o.cnama;
							txtProvinsi.text = o.cpropinsi; 
							lblNamaProvinsi.text = o.cpropinsi;
							txtNegara.text = o.cnegara;
							lblNamaNegara.text = o.cnegaranama;
							break;
						case 'txtNegara':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtNegara.text = o.ckode; 
							lblNamaNegara.text = o.cnama;
							break;
						case 'txtProvinsi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtProvinsi.text = o.pkode; 
							lblNamaProvinsi.text = o.pnama;
							break;
						case 'txtKategoriPasien':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtKategoriPasien.text = o.pckode;
							txtTingkatJual.text = o.pctingkatjual;
							lblKategoriPasien.text = o.pcnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtDesa':parentApplication.F_KosongkanText([txtDesa, lblNamaDesa]);break;
							case 'txtKecamatan':parentApplication.F_KosongkanText([txtKecamatan, lblNamaKecamatan]);break;
							case 'txtKota':parentApplication.F_KosongkanText([txtKota, lblNamaKota]);break;
							case 'txtNegara':parentApplication.F_KosongkanText([txtNegara, lblNamaNegara]);break;
							case 'txtProvinsi':parentApplication.F_KosongkanText([txtProvinsi, lblNamaProvinsi]);break;
							case 'txtKategoriPasien': txtKategoriPasien.text = '';break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtDesa':parentApplication.F_KosongkanText([txtDesa, lblNamaDesa]);break;
					case 'txtKecamatan':parentApplication.F_KosongkanText([txtKecamatan, lblNamaKecamatan]);break;
					case 'txtKota':parentApplication.F_KosongkanText([txtKota, lblNamaKota]);break;
					case 'txtNegara':parentApplication.F_KosongkanText([txtNegara, lblNamaNegara]);break;
					case 'txtProvinsi':parentApplication.F_KosongkanText([txtProvinsi, lblNamaProvinsi]);break;
					case 'txtKategoriPasien':parentApplication.F_KosongkanText([txtKategoriPasien]);break;
				}
			}
			
