<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode,tnama,tkamar,tcatatan]);
				parentApplication.F_txtpencarian([txtkamar]);
				parentApplication.F_txtInOut(txtkode,'','M1_BedCekId');
				parentApplication.F_RequiredLabel([tkode, tnama, tkamar]);
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].bkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].bnama;
					txtkamar.text = dg.dataProvider[dg.selectedCell.rowIndex].bkamar;
					lblkamar.text = dg.dataProvider[dg.selectedCell.rowIndex].bkamarnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].bcatatan;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].baktif));
					o.bisclose = dg.dataProvider[dg.selectedCell.rowIndex].bisclose;
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan,txtkamar,lblkamar]);
				chkaktif.selected = true;
				o.bisclose = 0;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}, {t:txtkamar, n:'Kamar'}]) == true){
					arr = [txtkode.text,txtkamar.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),o.bisclose,vUserId,vDefDt,userEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_BedSimpan', utama, 'bkode')
					userEdit = 0;
				}
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtkamar':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtkamar.text = o.rkode;
							lblkamar.text = o.rnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtkamar': break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkamar':parentApplication.F_KosongkanText([txtkamar, lblkamar]);break;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkamar':
						paket = 'CdM1_Room';
						csfilter = "raktif = 1";
						wsfilter = "raktif = 1 and rkode = '"+ txtkamar.text +"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="tkamar" left="10" top="87" text="Kamar"/>
	<s:Label id="tcatatan" left="10" top="108" text="Catatan"/>
	<s:Label id="lblkamar" left="208" top="87"/>
	<s:TextInput id="txtkode" y="40" left="70" width="270" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="61" maxChars="100" />
	<s:TextInput id="txtkamar" top="82" left="70" width="100" />
	<s:TextArea id="txtcatatan" left="70" right="10" top="103" bottom="10" maxChars="250"/>	
	<s:CheckBox id="chkaktif" x="350" y="41" label="Aktif" selected="true"/>
</s:Module>
