<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, iid:int=0, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, idkelompok:int = 0;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				FlexGlobals.topLevelApplication.F_txtpencarian([txtkelompok]);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tcatatan, tkelompok]);
				parentApplication.F_RequiredLabel([tkode]);
				//parentApplication.F_txtInOut(txtkode,'','M1_InsurerCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode,txtnama,txtkelompok,txtcatatan,txtkatharga]);
				if(p.FormFilter != ''){
					isUpdate = true;
					//txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].lrkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].lrnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].lrcatatan;
					txtkatharga.text = dg.dataProvider[dg.selectedCell.rowIndex].lrstandart;
					txtkelompok.text = dg.dataProvider[dg.selectedCell.rowIndex].lrkelompoknama;
					//tnamakelompok.text = dg.dataProvider[dg.selectedCell.rowIndex].lrnamakelompok;
					idkelompok = dg.dataProvider[dg.selectedCell.rowIndex].lrkelompok;
					iid = dg.dataProvider[dg.selectedCell.rowIndex].lrid;
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].lraktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan,txtkatharga]);
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [iid,txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt,txtkatharga.text,idkelompok];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_LabResultSimpan', utama, 'lrkode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkode':
						paket = 'CdM1_Item_Category';
						wsfilter = 'icaktif = 1 AND ickode = "'+txtkode.text.split('"').join('\\"')+'"';
						csfilter = 'icaktif = 1';
						sort = 'ickode asc';
						break;
					case 'txtnama':
						if(txtkode.text == ""){
							txtkode.setFocus();
							Alert.show("Tentukan jenis terlebih dahulu");
						}
						else{
							paket = 'CdM1_Item';
							wsfilter = 'baktif = 1 AND bjenis = "J" AND bkategori = "'+txtkode.text+'" AND bkode = "'+txtnama.text.split('"').join('\\"')+'"';
							csfilter = 'baktif = 1 AND bjenis = "J" AND bkategori = "'+txtkode.text+'"';
							sort = 'bkode asc';
						}
						break;
					case 'txtkelompok':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bjenis = "J" AND bkategori = "LAB" AND bkode = "'+txtkelompok.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bjenis = "J" AND bkategori = "LAB"';
						sort = 'bkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){					
						case 'txtkode':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtkode.text = o.ickode; 
							break;
						case 'txtnama':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtnama.text = o.bkode; 
							break;
						case 'txtkelompok':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtkelompok.text = o.bnama;
							tnamakelompok.text = o.bnama;
							idkelompok = o.bid;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtkode': txtkode.text = ''; break;
							case 'txtnama': txtnama.text = ''; break;
							case 'txtkelompok' :
								txtkelompok.text = '';
								tnamakelompok.text = '';
								idkelompok = 0;
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkode':parentApplication.F_KosongkanText([txtkode]);break;
					case 'txtnama':parentApplication.F_KosongkanText([txtnama]);break;
					case 'txtkelompok':parentApplication.F_KosongkanText([txtkelompok,tnamakelompok]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="46" text="Kode"/>
	<s:Label id="tnama" left="10" top="68" text="Nama"/>
	<s:Label id="tcatatan" left="10" top="89" text="Standart"/>
	<s:TextInput id="txtkode" left="94" top="40" width="198" maxChars="25"/>
	<s:TextInput id="txtnama" left="94" top="61" width="198" maxChars="100"/>
	<s:TextInput id="txtkatharga" left="94" top="82" width="198" maxChars="100"/>
	<s:TextInput id="txtkelompok" left="94" top="103" width="198" maxChars="100"/>
	<s:TextArea id="txtcatatan" left="94" right="10" top="124" bottom="10" maxChars="250"/>	
	<s:CheckBox id="chkaktif" x="329" y="42" label="Aktif" selected="true"/>
	<s:Label id="tcatatan0" left="10" top="131" text="Catatan"/>
	<s:Label id="tkelompok" left="10" top="110" text="Kelompok"/>
	<s:Label id="tnamakelompok" visible="false" left="330" top="110" width="551"/>
</s:Module>
