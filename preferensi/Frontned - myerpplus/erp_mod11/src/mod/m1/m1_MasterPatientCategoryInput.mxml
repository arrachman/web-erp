<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"  
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0, tingkatjual:int=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg; 
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, ttingkatjual, tcatatan, tawalan]);
				parentApplication.F_txtpencarian([txttingkatjual]);
				parentApplication.F_txtInOut(txtkode,'','M1_Patient_CategoryCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_RequiredLabel([tkode, tnama, ttingkatjual, tawalan]);
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtawalan, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false; 
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].pckode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].pcnama;
					txttingkatjual.text = dg.dataProvider[dg.selectedCell.rowIndex].pctingkatjualnama;
					tingkatjual = dg.dataProvider[dg.selectedCell.rowIndex].pctingkatjual;
					txtawalan.text = dg.dataProvider[dg.selectedCell.rowIndex].pcawalannotran;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].pccatatan;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].pcaktif));
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txttingkatjual,txtcatatan,txtawalan]);
				tingkatjual = 0;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}, {t:txttingkatjual, n:'Tingkat Jual'}]) == true){
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt,tingkatjual,txtawalan.text];
					utama = parentApplication.F_splitArrayToString(arr);
					FlexGlobals.topLevelApplication.F_MasterSimpan(baru, 'M1_Patient_CategorySimpan', utama,'pckode');
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txttingkatjual':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txttingkatjual.text = o.nama;
							tingkatjual = o.kode;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txttingkatjual': break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txttingkatjual':parentApplication.F_KosongkanText([txttingkatjual]);tingkatjual=0;break;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txttingkatjual':
						paket = 'CdM0_Selling_Rate';
						wsfilter = "nama = '"+ txttingkatjual.text +"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="ttingkatjual" left="10" top="87" text="Tingkat Jual"/>
	<s:Label id="tcatatan" left="10" top="128" text="Catatan"/>
	<s:TextInput id="txtkode" y="40" left="86" width="100" maxChars="50"/>
	<s:TextInput id="txtnama" left="86" right="10" top="61" maxChars="50" />
	<s:TextInput id="txttingkatjual" left="86" width="151" top="82" maxChars="50" />
	<s:TextInput id="txtawalan" left="86" width="151" top="103" maxChars="50" />
	<s:TextArea id="txtcatatan" left="86" right="10" top="124" bottom="9" maxChars="250"/>	
	<s:CheckBox id="chkaktif" x="196" y="41" label="Aktif" selected="true"/>
	<s:Label id="tawalan" left="10" top="108" text="Awalan"/>
</s:Module>
