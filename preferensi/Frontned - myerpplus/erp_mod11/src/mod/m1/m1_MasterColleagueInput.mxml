<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection; 
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, pid:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				FlexGlobals.topLevelApplication.F_txtpencarian([txtKota,txtProvinsi,txtNegara,txtRekDebit,txtRekKredit]);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, lblAlamat,lblKota,lblNegara, lblProvinsi, lblKodePos, lblCatatan, lblEmail, lblNama,lblNoFax,lblNoHP,lblNoTelepon,lblRekDebit,lblRekKredit]);
				parentApplication.F_RequiredLabel([tkode, lblNama]);
				parentApplication.F_txtInOut(txtkode,'','M1_ColleagueCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtNama,txtNoTelepon, txtNoFax,txtNoHP,txtEmail,txtAlamat,txtKodePos,txtCatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ckode;
					txtNama.text = dg.dataProvider[dg.selectedCell.rowIndex].cnama;
					txtRekDebit.text = dg.dataProvider[dg.selectedCell.rowIndex].cdebit;
					txtRekKredit.text = dg.dataProvider[dg.selectedCell.rowIndex].ckredit;
					txtNoTelepon.text = dg.dataProvider[dg.selectedCell.rowIndex].cnotelepon;
					txtNoFax.text = dg.dataProvider[dg.selectedCell.rowIndex].cnofax;
					txtNoHP.text = dg.dataProvider[dg.selectedCell.rowIndex].cnohp;
					txtEmail.text = dg.dataProvider[dg.selectedCell.rowIndex].cemail;
					txtAlamat.text = dg.dataProvider[dg.selectedCell.rowIndex].calamat;
					txtKota.text = dg.dataProvider[dg.selectedCell.rowIndex].ckota;
					txtProvinsi.text = dg.dataProvider[dg.selectedCell.rowIndex].cprovinsi;
					txtNegara.text = dg.dataProvider[dg.selectedCell.rowIndex].cnegara;
					txtKodePos.text = dg.dataProvider[dg.selectedCell.rowIndex].ckodepos;
					txtCatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].ccatatan;
					vUserIdEdit = parentApplication.userid;
					pid = dg.dataProvider[dg.selectedCell.rowIndex].cid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].caktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtNama,txtNoTelepon,txtKota,txtProvinsi,txtNegara,
					txtNoFax,txtNoHP,txtEmail,txtAlamat,txtKodePos,txtRekDebit,txtRekKredit,txtCatatan]);
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtNama, n:'Nama', e:'Name'}]) == true){
					//akode,nama, prefix, tgllahir, umur, jeniskelamin, statusperkawinan, agama, ayah, ibu, suamiistri, notelepon, nofax, nohp, email, alamat, kota, provinsi, negara, 
					//kodepos, keluargalain, noteleponlain, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [pid, txtkode.text,txtNama.text,txtRekDebit.text,txtRekKredit.text,txtNoTelepon.text,txtNoFax.text,
						txtNoHP.text,txtEmail.text,txtAlamat.text,txtKota.text,txtProvinsi.text,txtNegara.text,txtKodePos.text,
						txtCatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_ColleagueSimpan', utama, '')
					vUserIdEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtProvinsi':
						paket = 'CdM1_Province';
						wsfilter = '(paktif = 1) AND pkode ="'+txtProvinsi.text.split('"').join('\\"')+'"';
						csfilter = '(paktif = 1)';
						csfield = 2;
						sort = 'pkode asc';
						break;
					case 'txtKota':
						paket = 'CdM1_City';
						wsfilter = '(caktif = 1) AND ckode ="'+txtKota.text.split('"').join('\\"')+'"';
						csfilter = '(caktif = 1)';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case 'txtNegara':
						paket = 'CdM1_Country';
						wsfilter = '(caktif = 1) AND ckode ="'+txtNegara.text.split('"').join('\\"')+'"';
						csfilter = '(caktif = 1)';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case 'txtRekDebit':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd = "D" AND cnomor = "'+txtRekDebit.text.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 AND cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'txtRekKredit':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd = "D" AND cnomor = "'+txtRekKredit.text.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 AND cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtKota':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtKota.text = o.ckode; 
							break;
						case 'txtNegara':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtNegara.text = o.ckode; 
							break;
						case 'txtProvinsi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtProvinsi.text = o.pkode; 
							break;
						case 'txtRekDebit':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtRekDebit.text = o.cnomor; 
							break;
						case 'txtRekKredit':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtRekKredit.text = o.cnomor; 
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtKota': txtKota.text = ''; break;
							case 'txtNegara': txtNegara.text = ''; break;
							case 'txtProvinsi': txtProvinsi.text = ''; break;
							case 'txtRekDebit':txtRekDebit.text = '';break;
							case 'txtRekKredit':txtRekKredit.text = '';break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtKota':parentApplication.F_KosongkanText([txtKota]);break;
					case 'txtNegara':parentApplication.F_KosongkanText([txtNegara]);break;
					case 'txtProvinsi':parentApplication.F_KosongkanText([txtProvinsi]);break;
					case 'txtRekDebit':parentApplication.F_KosongkanText([txtRekDebit]);break;
					case 'txtRekKredit':parentApplication.F_KosongkanText([txtRekKredit]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
