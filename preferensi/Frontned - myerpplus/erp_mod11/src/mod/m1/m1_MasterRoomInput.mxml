				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan,txtharga1,txtharga2,txtharga3,txtharga4,txtharga5,txtDiskonJual1,txtDiskonJual2,txtDiskonJual3,txtDiskonJual4,txtDiskonJual5,txtjmlkasur]);
				o.txtharga1 = 0; o.txtharga2 = 0; o.txtharga3 = 0; o.txtharga4 = 0; o.txtharga5 = 0;
				o.txtDiskonJual1 = 0; o.txtDiskonJual2 = 0; o.txtDiskonJual3 = 0; o.txtDiskonJual4 = 0; o.txtDiskonJual5 = 0;
				txtharga1.text = parentApplication.F_formatNominal(o.txtharga1);
				txtharga2.text = parentApplication.F_formatNominal(o.txtharga2);
				txtharga3.text = parentApplication.F_formatNominal(o.txtharga3);
				txtharga4.text = parentApplication.F_formatNominal(o.txtharga4);
				txtharga5.text = parentApplication.F_formatNominal(o.txtharga5);
				txtDiskonJual1.text = parentApplication.F_formatNominal(o.txtDiskonJual1);
				txtDiskonJual2.text = parentApplication.F_formatNominal(o.txtDiskonJual2);
				txtDiskonJual3.text = parentApplication.F_formatNominal(o.txtDiskonJual3);
				txtDiskonJual4.text = parentApplication.F_formatNominal(o.txtDiskonJual4);
				txtDiskonJual5.text = parentApplication.F_formatNominal(o.txtDiskonJual5);
				o.txtjmlkasur = 0;
				txtjmlkasur.text = parentApplication.m.nfNumber.format(o.txtjmlkasur);
				chkaktif.selected = true;
				o.risclose = 0;
				o.rcustomtext1 = '';
				o.rcustomtext2 = '';
				o.rcustomtext3 = '';
				o.rcustomtext4 = '';
				o.rcustomtext5 = '';
				o.rcustomint1 = 0;
				o.rcustomint2 = 0;
				o.rcustomint3 = 0;
				o.rcustomint4 = 0;
				o.rcustomint5 = 0;
				o.rcustomdbl1 = 0;
				o.rcustomdbl2 = 0;
				o.rcustomdbl3 = 0;
				o.rcustomdbl4 = 0;
				o.rcustomdbl5 = 0;
				o.rcustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst;
				o.rcustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst;
				o.rcustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				o.rcustomdate4 = FlexGlobals.topLevelApplication.m.DateFirst;
				o.rcustomdate5 = FlexGlobals.topLevelApplication.m.DateFirst;
				
				txtrekpersediaan.text = p.getSetting(0, "akun", "Persediaan");
				txtrekpenjualan.text = p.getSetting(0, "akun", "PendapatanPenjualan");
				txtrekdiskonpenjualan.text = p.getSetting(0, "akun", "DiskonPenjualan");
				txtrekhpp.text = p.getSetting(0, "akun", "HargaPokokPenjualan");
				
				lblpersediaan.text = p.getSetting(0, "akunnama", "Persediaan");
				lblpenjualan.text = p.getSetting(0, "akunnama", "PendapatanPenjualan");
				lbldiskonpenjualan.text = p.getSetting(0, "akunnama", "DiskonPenjualan");
				lblhpp.text = p.getSetting(0, "akunnama", "HargaPokokPenjualan");
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}, {t:txtjmlkasur, n:'Jml Kasur'}, {t:txtrekpersediaan, n:'Rek. Persediaan'}, {t:txtrekpenjualan, n:'Rek. Penjualan'}, {t:txtrekdiskonpenjualan, n:'Rek. Diskon Penjualan'}, {t:txtrekhpp, n:'Rek. HPP'}]) == true){
					arr = [txtkode.text,txtnama.text,o.txtharga1,o.txtharga2,o.txtharga3,o.txtharga4,o.txtharga5,o.txtDiskonJual1,o.txtDiskonJual2,o.txtDiskonJual3,o.txtDiskonJual4,o.txtDiskonJual5,o.txtjmlkasur,txtcatatan.text,txtrekpersediaan.text,txtrekhpp.text,txtrekdiskonpenjualan.text,txtrekpenjualan.text,int(chkaktif.selected),o.risclose,vUserId,vDefDt,userEdit,vDefDt,o.rcustomtext1, o.rcustomtext2, o.rcustomtext3, o.rcustomtext4, o.rcustomtext5,o.rcustomint1, o.rcustomint2, o.rcustomint3, o.rcustomint4, o.rcustomint5, o.rcustomdbl1, o.rcustomdbl2, o.rcustomdbl3, o.rcustomdbl4, o.rcustomdbl5, o.rcustomdate1, o.rcustomdate2, o.rcustomdate3, o.rcustomdate4, o.rcustomdate5, cmbKelas.selectedItem.v];
					utama = parentApplication.F_splitArrayToString(arr);
//					Alert.show(o.txtDiskonJual1+'|'+o.txtDiskonJual2+'|'+o.txtDiskonJual3+'|'+o.txtDiskonJual4+'|'+o.txtDiskonJual5+'|')
					parentApplication.F_MasterSimpan(baru, 'M1_RoomSimpan', utama, 'rkode')
					userEdit = 0;
				}
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtrekpersediaan':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtrekpersediaan.text = o.cnomor;
							lblpersediaan.text = o.cnama;
							break;
						case 'txtrekhpp':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtrekhpp.text = o.cnomor;
							lblhpp.text = o.cnama;
							break;
						case 'txtrekdiskonpenjualan':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtrekdiskonpenjualan.text = o.cnomor;
							lbldiskonpenjualan.text = o.cnama;
							break;
						case 'txtrekpenjualan':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtrekpenjualan.text = o.cnomor;
							lblpenjualan.text = o.cnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtdivisi': break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtrekpersediaan':parentApplication.F_KosongkanText([txtrekpersediaan, lblpersediaan]);break;
					case 'txtrekhpp':parentApplication.F_KosongkanText([txtrekhpp, lblhpp]);break;
					case 'txtrekdiskonpenjualan':parentApplication.F_KosongkanText([txtrekdiskonpenjualan, lbldiskonpenjualan]);break;
					case 'txtrekpenjualan':parentApplication.F_KosongkanText([txtrekpenjualan, lblpenjualan]);break;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtrekpersediaan':
						if(txtrekpersediaan.enabled == true){
							paket = 'CdM1_Coa';
							csfilter = 'cgd="d" and caktif = 1';
							wsfilter = 'cgd="d" and caktif = 1 and cnomor= "'+ txtrekpersediaan.text.split('"').join('\\"') +'"';
						}
						break;
					case 'txtrekhpp':
						if(txtrekhpp.enabled == true){
							paket = 'CdM1_Coa';
							csfilter = 'cgd="d" and caktif = 1';
							wsfilter = 'cgd="d" and caktif = 1 and cnomor= "'+ txtrekhpp.text.split('"').join('\\"') +'"';
						}
						break;
					case 'txtrekdiskonpenjualan':
						if(txtrekdiskonpenjualan.enabled == true){
							paket = 'CdM1_Coa';
							csfilter = 'cgd="d" and caktif = 1';
							wsfilter = 'cgd="d" and caktif = 1 and cnomor= "'+ txtrekdiskonpenjualan.text.split('"').join('\\"') +'"';
						}
						break;
					case 'txtrekpenjualan':
						if(txtrekpenjualan.enabled == true){
							paket = 'CdM1_Coa';
							csfilter = 'cgd="d" and caktif = 1';
							wsfilter = 'cgd="d" and caktif = 1 and cnomor= "'+ txtrekpenjualan.text.split('"').join('\\"') +'"';
						}
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
