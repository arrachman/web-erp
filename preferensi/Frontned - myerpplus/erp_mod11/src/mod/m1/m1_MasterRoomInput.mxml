					o.txtDiskonJual5 = dg.dataProvider[dg.selectedCell.rowIndex].rdiskonjual5;
					txtharga1.text = parentApplication.F_formatNominal(o.txtharga1);
					txtharga2.text = parentApplication.F_formatNominal(o.txtharga2);
					txtharga3.text = parentApplication.F_formatNominal(o.txtharga3);
					txtharga4.text = parentApplication.F_formatNominal(o.txtharga4);
					txtharga5.text = parentApplication.F_formatNominal(o.txtharga5);
					txtDiskonJual1.text = parentApplication.F_formatNominal(o.txtDiskonJual1);
					txtDiskonJual2.text = parentApplication.F_formatNominal(o.txtDiskonJual2);
					txtDiskonJual3.text = parentApplication.F_formatNominal(o.txtDiskonJual3);
					txtDiskonJual4.text = parentApplication.F_formatNominal(o.txtDiskonJual4);
					txtDiskonJual5.text = parentApplication.F_formatNominal(o.txtDiskonJual5);
					o.txtjmlkasur = dg.dataProvider[dg.selectedCell.rowIndex].rjmlkasur;
					txtjmlkasur.text = parentApplication.m.nfNumber.format(o.txtjmlkasur);
					txtrekdiskonpenjualan.text = dg.dataProvider[dg.selectedCell.rowIndex].rrekdiskonpenjualan;
					txtrekhpp.text = dg.dataProvider[dg.selectedCell.rowIndex].rrekhargapokok;
					txtrekpenjualan.text = dg.dataProvider[dg.selectedCell.rowIndex].rrekpenjualan;
