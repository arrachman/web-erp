			protected function cmbPerawatan_changeHandler(event:IndexChangeEvent):void
			{
				txtNoRetur.text = "";
				if(cmbPerawatan.textInput.text != ""){
					lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
					if(cmbPerawatan.selectedIndex == 0){
						txtGudang.text = 'RI';
						lblNamaGudang.text = 'Rawat Inap';
					}
					else{
						txtGudang.text = 'RJ';
						lblNamaGudang.text = 'Rawat Jalan';
					}
				}
				
			}
			
			protected function cmbJenisTransaksi_changeHandler(event:IndexChangeEvent):void
			{
				txtNoRetur.text = ""
				if(cmbJenisTransaksi.selectedIndex == 1){
					txtkunjungan.enabled = false;
					//cmbPerawatan.enabled = false;
					txtKamar.enabled = false;
					//cmbPerawatan.selectedIndex = 1;
					//lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
					//txtGudang.text = 'RJ';
					//lblNamaGudang.text = 'Rawat Jalan';
					//txtGudang.enabled = false;
					//u.getItemAt(0).roperawatan = "PL";
					u.getItemAt(0).rocustomer = FlexGlobals.topLevelApplication.getSetting(11,'company','Customer');
				}
				else{
					txtkunjungan.enabled = true;
					cmbPerawatan.enabled = true;
					txtKamar.enabled = true;
					cmbPerawatan.selectedIndex = 0;
					lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
					txtGudang.text = 'RI';
					lblNamaGudang.text = 'Rawat Inap';
					txtGudang.enabled = true;
					//u.getItemAt(0).roperawatan = "";
					u.getItemAt(0).rocustomer = 0;
				} 
			}
			
			public var vfplus:String='';
			protected function txtNoRetur_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER){
					vfplus = '';
					if(txtNoRetur.text != ""){
						if(cmbPerawatan.textInput.text == ""){
							Alert.show("Perawatan harus dipilih terlebih dahulu");
						}
						else if(txtKategoriPasien.text == ""){
							Alert.show("Kategori pasien harus dipilih terlebih dahulu");
						}
						else{
							noReturCek = txtNoRetur.text;
							if(cmbPerawatan.textInput.text == 'RI' && cmbPerawatan.selectedIndex == 0){
								for(var k:int=noReturCek.length;k<5;k++){
									noReturCek = "0"+noReturCek;
								}
							}
							else{
								for(var kl:int=noReturCek.length;kl<3;kl++){
									noReturCek = "0"+noReturCek;
								}
							} 
							if (vKeyOut==true){
								if (vCurr != txtNoRetur.text && isUpdate == false)
									if (vfplus==''){
										var ArrayTgl:Array = dttanggal.text.split("/");
										vfplus=''; 
										//'FlexGlobals.topLevelApplication.F_wsDelete('cekid',paket,FlexGlobals.topLevelApplication.userid,param);
										//F_txtInOut(txtnoref.text+"~|~"+cmbPerawatan.textInput.text+"~|~"+txtKategoriPasien.text,txtnoref,'','M11_AkCekNoRef');
										FlexGlobals.topLevelApplication.F_wsGetDataById('cekid', 'M11_RoCekNoRef', noReturCek+"~"+cmbPerawatan.textInput.text+"~"+txtKategoriPasien.text+"~"+ArrayTgl[2], 0,'', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
										//Alert.show("Test Test Test");
									}else
										FlexGlobals.topLevelApplication.F_wsDelete('cekid','M11_RoCekNoRef',FlexGlobals.topLevelApplication.userid,vfplus);
								vKeyOut = false;
							}else vKeyOut = true; 
						}
					}
				} 
			}
			
			protected function txtNoRetur_focusInHandler(event:FocusEvent):void
			{
				if(vCurr != ''){
					//			if (fplus == '') 
					vCurr = txtnoref.text;
					vKeyOut=true;
				}  
			}
			
		]]>
