				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(11,41,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Ro');
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
					f_kondisiAwal();
					//					FlexGlobals.topLevelApplication.f_reloadReset();
				}
				function f_mbCatatan():void
