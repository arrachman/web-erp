					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						p.o.txtkartudebit = o.jumlah;
						p.txtkartudebit.text = parentApplication.m.nfNumber.format(p.o.txtkartudebit);
						p.f_hitungTotal();
						parentApplication.F_hapusBarisKosongGrid(p.dg1);
						if(p.dg1.dataProviderLength == 1 && p.dg1.dataProvider[0].notransaksi == ""){
							FlexGlobals.topLevelApplication.F_acAdd(p.dg1);
							parentApplication.F_hapusBarisKosongGrid(p.dg1);
						}else{
							FlexGlobals.topLevelApplication.F_acAdd(p.dg1);
						}
						
						/* if(p.o.txtjmlbayar < p.o.txttotaltransaksi){
							p.txtborderbayar.visible = true;
							p.bordervisible = true;
						}else{
							p.txtborderbayar.visible = false;
							p.bordervisible = false;
						} */
						
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
