			}
			
			protected function f_simpan():void
			{
				FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg_debit);
				if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.arrdebit.length > 0){
					FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.arrdebit.removeAll();
				}
				for(i = 0; i<dg_debit.dataProviderLength; i++){
					with(dg_debit.dataProvider[i]){
						p.arrdebit.addItem({idkwcarabayar:0, idkw:0, carabayar: 5, matauang:matauang, kurs:kurs, jumlah:jumlah, jumlahvalas:0, 
							nogiro:"", tgljt:FlexGlobals.topLevelApplication.DefaultTanggal, bank:bank, noacbank:noacbank, 
							rekbank:rekbank, rekgiro:"", catatan:catatan, rekbanknama:rekbanknama,
							urutan:i+1, isclose:0});
					}
					
				}
				FlexGlobals.topLevelApplication.closeFormPopUp(1)
				p.o.txtkartudebit = o.jumlah;
				p.txtkartudebit.text = parentApplication.m.nfNumber.format(p.o.txtkartudebit);
				p.f_hitungTotal();
				
				/* if(p.o.txtjmlbayar < p.o.txttotaltransaksi){
					p.txtborderbayar.visible = true;
					p.bordervisible = true;
				}else{
					p.txtborderbayar.visible = false;
					p.bordervisible = false;
				} */
				
				if(p.dg1.dataProviderLength == 1 && p.dg1.dataProvider[0].notransaksi == ""){
					FlexGlobals.topLevelApplication.F_acAdd(p.dg1);
					parentApplication.F_hapusBarisKosongGrid(p.dg1);
				}else{
					parentApplication.F_hapusBarisKosongGrid(p.dg1);
					FlexGlobals.topLevelApplication.F_acAdd(p.dg1);
				}
				
			}
			
			private var vtotal:Number=0,vvalas:Number=0;
			public function f_hitungTotall():void
			{
				o.jumlah = 0
				for(var i:int=0;i<dg_debit.dataProvider.length;i++){
					if(dg_debit.dataProvider.getItemAt(i).jumlah != undefined)o.jumlah += Number(dg_debit.dataProvider.getItemAt(i).jumlah);
				}
				
				lbltotal.text = parentApplication.m.nfNumber.format(o.jumlah);
			}
			
			
