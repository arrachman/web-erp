			protected function f_kondisiAwal():void
			{
				
				lbltotal.text = parentApplication.m.nfNumber.format(0);
				if(p.arrdebit.length > 0){
					dg_debit.dataProvider = p.arrdebit;
					//					dg_debit.dataProvider.removeAll();
					//					
					for(i = 0; i < dg_debit.dataProviderLength; i++){
						dg_debit.dataProvider[i].no = i+1;
					}
					
					f_hitungTotall();
				}else{
					dg_debit.dataProvider.removeAll();
					FlexGlobals.topLevelApplication.F_acAdd(dg_debit);
				}
				
				dg_debit.setFocus();
				dg_debit.setSelectedCell(0,1);
			}
			
			public function f_grid(dg_debit:DataGrid, column:String):void
