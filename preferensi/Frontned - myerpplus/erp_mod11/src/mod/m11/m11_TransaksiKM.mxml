				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(11, 7, [dg1], 'transaksi');
				f_validasi();
			}
			
			public function f_validasi():void
			{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M11_KmHistoryGetdataById', idtransaksi, 0, 0, '', '', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M11_KmGetdataById', idtransaksi, 0, 0, '', '', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				var CurrentDateTime:Date = new Date();
				nmrjam.textDisplay.text = CurrentDateTime.getHours().toString();
				nmrmenit.textDisplay.text = doubleDigitFormat(CurrentDateTime.getMinutes());
				nmrdetik.textDisplay.text = doubleDigitFormat(CurrentDateTime.getSeconds());
				isUpdate = false;
				cmbPerawatan.dataProvider = new ArrayCollection([{l:'RI',v:'Rawat Inap'},{l:'RJ',v:'Rawat Jalan'}]);
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				parentApplication.F_SetNilaiText([dttanggal, dttanggalnoref, dttanggalmasuk], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtkunjungan, lblkunjungan, txtkamar, lblkamar, txtkasur, lblkasur, txtnotransaksi, txtkontakperson, txtcatatan, txtnoref, txtKategoriPasien, lblNamaKatPasien]);
				txtnotransaksi.text = 'Auto';
				nmrjam.value = 0;
				nmrmenit.value = 0;
				nmrdetik.value = 0;
				txturaian.text = parentApplication.getNomor("KM");
				txtcatatan.text = parentApplication.getNomor("KM",1);
				parentApplication.vpVarCurrent = txtkunjungan.text;
				cmbprogress.enabled = true;
				cmbprogress.selectedIndex = 1;
				cmbPerawatan.selectedIndex = 0;
				lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
				o.txtmatauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				tingkatjual = 1;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = true;
				mb.menuBarItems[7].visible = false;
				mb.menuBarItems[8].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				u = new ArrayCollection([{
					kmid:0, kmcabang:parentApplication.ucabang, kmlokasi:parentApplication.ulokasi, kmgudang:parentApplication.ugudang, kmsumber:'KM', 
					kmautonotransaksi:int(chkauto.selected), kmnotransaksi:txtnotransaksi.text, kmtgl:dttanggal.text, kmkodepa:0, kmcustomer:0, 
        			kmcustomerkontak:txtkontakperson.text, kmuraian:txturaian.text, kmcatatan:txtcatatan.text, kmnoref:txtnoref.text, kmtglnoref:dttanggalnoref.text, 
					kmmatauang:o.txtmatauang, kmkurs:o.txtkurs, kmidkj:0, kmkamar:txtkamar.text, kmkasur:txtkasur.text, kmtglmasuk:dttanggalmasuk.text, 
					kmtglkeluar:'01/01/1971', kmjmlhari:0, kmharga:0, kmtotaltransaksi:0, kmrekpersediaan:'', kmrekhargapokok:'', kmrekdiskonpenjualan:'', kmrekpenjualan:'', 
					kmstatusrealisasi:0, kmstatus:cmbprogress.selectedItem.v, kmstatussebelumnya:0, kmjmlrevisi:0, kmcetakanke:0, 
					kminputuser:FlexGlobals.topLevelApplication.userid, kminputtgl:tglDB, kmmodifikasiuser:0, kmmodifikasitgl:tglDB, kmposting:0, kmisclose:0, 
					kmcustomtext1:'', kmcustomtext2:'', kmcustomtext3:'', kmcustomtext4:'', kmcustomtext5:'', kmcustomtext6:'', kmcustomtext7:'', 
        			kmcustomtext8:'', kmcustomtext9:'', kmcustomtext10:'', kmcustomtext11:'', kmcustomtext12:'', 
					kmcustomtext13:'', kmcustomtext14:'', kmcustomtext15:'', kmcustomtext16:'', kmcustomtext17:'', 
        			kmcustomtext18:'', kmcustomtext19:'', kmcustomtext20:'', kmcustomint1:0, kmcustomint2:0, 
					kmcustomint3:0, kmcustomint4:0, kmcustomint5:0, kmcustomint6:0, kmcustomint7:0, 
        			kmcustomint8:0, kmcustomint9:0, kmcustomint10:0, kmcustomint11:0, kmcustomint12:0, 
					kmcustomint13:0, kmcustomint14:0, kmcustomint15:0, kmcustomint16:0, kmcustomint17:0, 
        			kmcustomint18:0, kmcustomint19:0, kmcustomint20:0, kmcustomdbl1:0, kmcustomdbl2:0, 
					kmcustomdbl3:0, kmcustomdbl4:0, kmcustomdbl5:0, kmcustomdbl6:0, kmcustomdbl7:0, 
        			kmcustomdbl8:0, kmcustomdbl9:0, kmcustomdbl10:0, kmcustomdbl11:0, kmcustomdbl12:0, 
					kmcustomdbl13:0, kmcustomdbl14:0, kmcustomdbl15:0, kmcustomdbl16:0, kmcustomdbl17:0, 
        			kmcustomdbl18:0, kmcustomdbl19:0, kmcustomdbl20:0, kmcustomdate1:parentApplication.m.DateFirst, kmcustomdate2:parentApplication.m.DateFirst, 
					kmcustomdate3:parentApplication.m.DateFirst, kmcustomdate4:parentApplication.m.DateFirst, kmcustomdate5:parentApplication.m.DateFirst, kmcustomdate6:parentApplication.m.DateFirst, kmcustomdate7:parentApplication.m.DateFirst, 
        			kmcustomdate8:parentApplication.m.DateFirst, kmcustomdate9:parentApplication.m.DateFirst, kmcustomdate10:parentApplication.m.DateFirst, kmcustomdate11:parentApplication.m.DateFirst, kmcustomdate12:parentApplication.m.DateFirst, 
					kmcustomdate13:parentApplication.m.DateFirst, kmcustomdate14:parentApplication.m.DateFirst, kmcustomdate15:parentApplication.m.DateFirst, kmcustomdate16:parentApplication.m.DateFirst, kmcustomdate17:parentApplication.m.DateFirst, 
        			kmcustomdate18:parentApplication.m.DateFirst, kmcustomdate19:parentApplication.m.DateFirst, kmcustomdate20:parentApplication.m.DateFirst, kmperawatan:'', kmkategoripasien:'', kmawalankatpasien:''
				}]);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
						if(isUpdate == false){
							jenissimpan = 1
						}else{
							jenissimpan = 2
						}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(11,7,jenissimpan)==true){
							f_simpan();
						}
						break;
						}
				}
			}	
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtkunjungan':
						paket = 'CdM11_Kj';
						wsfilter = '(kjstatus = 2 OR kjstatus = 3) AND kjstatuskamar = 0 AND kjnotransaksi ="'+txtkunjungan.text.split('"').join('\\"')+'"';
						csfilter = '(kjstatus = 2 OR kjstatus = 3) AND kjstatuskamar = 0';
						csfield = 2;
						sort = 'kjinputtgl desc';
						break;
					case 'txtkamar':
						paket = 'CdM1_Room';
						wsfilter = '(raktif = 1 AND risclose = 0) AND rkode ="'+txtkamar.text.split('"').join('\\"')+'"';
						csfilter = '(raktif = 1 AND risclose = 0)';
						csfield = 2;
						sort = 'rkode asc';
						break;
					case 'txtkasur':
						paket = 'CdM1_Bed';
						wsfilter = '(baktif = 1 AND bisclose = 0 AND bkamar = "'+txtkamar.text+'") AND bkode ="'+txtkasur.text.split('"').join('\\"')+'"';
						csfilter = '(baktif = 1 AND bisclose = 0 AND bkamar = "'+txtkamar.text+'")';
						csfield = 2;
						sort = 'bkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).mrdimintaoleh+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).mrdimintaoleh+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "KM"';
						sort = 'tnkode asc';
						break;
					case 'txtKategoriPasien':
						paket = 'CdM1_Patient_Category';
						wsfilter = '(pcaktif = 1) AND pckode ="'+txtKategoriPasien.text.split('"').join('\\"')+'"';
						csfilter = '(pcaktif = 1)';
						csfield = 2;
						sort = 'pckode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				if (dg1.dataProvider != null && parentApplication.rowIndex < dg1.dataProviderLength)
				var ob : Object = dg1.dataProvider[parentApplication.rowIndex];
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtkunjungan':
							txtkunjungan.text = obj.kjnotransaksi;
							lblkunjungan.text = obj.kjnama;
							u.getItemAt(0).kmcustomer = obj.kjidpasien;
							u.getItemAt(0).kmidkj = obj.kjid;
							tingkatjual = obj.kjtingkatjual;
							if(obj.kjperawatan == 'RI')cmbPerawatan.selectedIndex = 0;
							else cmbPerawatan.selectedIndex = 1;
							lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
							txtKategoriPasien.text = obj.kjkategoripasien;
							lblNamaKatPasien.text = obj.kjkategoripasiennama;
							txtkamar.text = obj.kjkamar;
							lblkamar.text = obj.kjkamarnama;
							u.getItemAt(0).kmawalankatpasien = obj.kjawalannotran;
							FlexGlobals.topLevelApplication.F_wsSearch('KmSearch', 'M11_KmSearch', 0, 0, '(Kmstatus = 2 OR Kmstatus = 3 OR Kmstatus = 4 OR Kmstatus = 7) AND (Kmidkj = '+obj.kjid+')', 'Kminputtgl desc');
							break;
						case 'txtKategoriPasien':
							txtKategoriPasien.text = obj.pckode;
							lblNamaKatPasien.text = obj.pcnama;
							u.getItemAt(0).kmkategoripasien = obj.pckode;
							u.getItemAt(0).kmawalankatpasien = obj.pcawalannotran;
							break;
						case 'txtkamar':
							txtkamar.text = obj.rkode;
							lblkamar.text = obj.rnama;
							u.getItemAt(0).kmjmlhari = 1;
							u.getItemAt(0).kmharga = obj["rhargajual"+tingkatjual];
							u.getItemAt(0).kmtotaltransaksi = (u.getItemAt(0).kmjmlhari * obj["rhargajual"+tingkatjual]);
							u.getItemAt(0).kmrekpersediaan = obj.rrekpersediaan;
							u.getItemAt(0).kmrekhargapokok = obj.rrekhargapokok;
							u.getItemAt(0).kmrekdiskonpenjualan = obj.rrekdiskonpenjualan;
							u.getItemAt(0).kmrekpenjualan = obj.rrekpenjualan;
							break;
						case 'txtkasur':
							txtkasur.text = obj.bkode;
							lblkasur.text = obj.bnama;
							break;
						case 'txtkontakperson':
							txtkontakperson.text = obj.kakodekontak;
							u.getItemAt(0).mrdimintaolehkontak = obj.kaid;
							break;
						case 'txtcatatan':
							txtcatatan.text = obj.tncatatan;
							break;
						case 'KmSearch':
							var data:String;
							dg1.dataProvider.removeAll();
							for(i=0;i<parentApplication.wsArrUtama.length;i++){
								obj = parentApplication.wsArrUtama.getItemAt(i);
								if(obj.kmtglkeluar != '1971-01-01 00:00:00')
								{
									data = obj.kmtglkeluar;
								}else{
									data = "";
								}
								dg1.dataProvider.addItem({
									no : dg1.dataProviderLength+1,
									kmtglmasuk : obj.kmtglmasuk,
									kmkamarnama : obj.kmkamarnama,
									kmkasurnama : obj.kmkasurnama,
									kmtglkeluar : data
									
								});
							}
							parentApplication.F_dgRefresh(dg1);
							break;
						case 'tampil':
							var arr:Array, ar:Array;
							f_focusOnMe();
							mb.menuBarItems[3].enabled = true;
							mb.menuBarItems[4].enabled = true;
							mb.menuBarItems[5].enabled = true;
							mb.menuBarItems[6].enabled = true;
							mb.menuBarItems[7].visible = false;
							mb.menuBarItems[8].visible = false;
							if(parentApplication.wsArrUtama.length < 0)return;
							with(parentApplication.wsArrUtama.getItemAt(0)){
								isUpdate = true;
								txtkunjungan.text = kmnotransaksikj;
								parentApplication.vpVarCurrent = txtkunjungan.text;
								lblkunjungan.text = kmcustomernama;
								txtkamar.text = kmkamar;
								lblkamar.text = kmkamarnama;
								txtkasur.text = kmkasur;
								lblkasur.text = kmkasurnama;
								txturaian.text = kmuraian;
								dttanggal.text = kmtgl;
								txtnotransaksi.text = kmnotransaksi;
								chkauto.selected = Boolean(int(kmautonotransaksi));
								arr = kmtglmasuk.split(" ");
								if(arr[1] ==  null){
									arr[1] = '00:00:00'
								}
								ar = arr[1].split(":");
								dttanggalmasuk.text = arr[0];
								nmrjam.value = ar[0];
								nmrmenit.value = ar[1];
								nmrdetik.value = ar[2];
								if(int(kmstatus) == 0){
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									cmbprogress.selectedIndex = 0;
									cmbprogress.enabled = true;
									mb.menuBarItems[0].enabled = true;
								}else{
									cmbprogress.dataProvider = new  ArrayCollection([{l : 'Approved', v : 2},{l : 'Inprogress', v : 3}, {l : 'Complete', v : 4},{l : 'Close', v : 7}]);
									if(kmstatus == 2){cmbprogress.selectedIndex = 0}
									else  if(kmstatus == 3){cmbprogress.selectedIndex = 1}
									else  if(kmstatus == 4){cmbprogress.selectedIndex = 2}
									else  if(kmstatus == 7){cmbprogress.selectedIndex = 3}
									cmbprogress.enabled = false;
									mb.menuBarItems[0].enabled = false;
								}
								txtkontakperson.text = kmcustomerkontak;
								txtcatatan.text = kmcatatan;
								txtnoref.text = kmnoref;
