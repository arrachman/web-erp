			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tkunjungan, tkamar, tkasur, turaian, ttanggal, tnotransaksi, ttanggalmasuk, tjammasuk, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref, lblPerawatan, lblKategoriPasien]);
				parentApplication.F_RequiredLabel([tkunjungan, tkamar, tkasur, ttanggal, tnotransaksi, ttanggalmasuk, tjammasuk, tprogress, lblPerawatan, lblKategoriPasien]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalmasuk, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress,cmbPerawatan]);
				parentApplication.F_txtpencarian([txtkunjungan, txtkamar, txtkasur, txtKategoriPasien]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref, nmrjam, nmrmenit, nmrdetik]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"Keluar Kamar", icon:"tbkeluarkamar", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbKeluarKamar);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[8].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(11,7,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Km');
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[3].enabled == true){
						parentApplication.F_OpenNotes('Km', u.getItemAt(0).kmid, txtnotransaksi.text);
					}
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[4].enabled == true){
						parentApplication.F_OpenUploadFile('KM', u.getItemAt(0).kmid, txtnotransaksi.text);
					}
				}
				function f_mbLinks():void
				{
					FlexGlobals.topLevelApplication.f_mbLinks(11, 'Km');
