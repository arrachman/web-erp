				function validasiForm():void
				{
					pesanAlert='';
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					if(txtkunjungan.text.length == 0)parentApplication.msgAlert(txtkunjungan,'Kunjungan');
					if(cmbPerawatan.textInput.text.length == 0)parentApplication.msgAlert(cmbPerawatan,'Perawatan');
					if(txtKategoriPasien.text.length == 0)parentApplication.msgAlert(txtKategoriPasien,'Kategori Pasien');
					if(txtkamar.text.length == 0)parentApplication.msgAlert(txtkamar,'Kamar');
					if(txtkasur.text.length == 0)parentApplication.msgAlert(txtkasur,'Kasur');
					if(dttanggalmasuk.text.length == 0)parentApplication.msgAlert(dttanggalmasuk,'Tanggal Masuk');
					if(nmrjam.textDisplay.text.length == 0 || nmrmenit.textDisplay.text.length == 0 || nmrdetik.textDisplay.text.length == 0)parentApplication.msgAlert(nmrjam,'Jam');
