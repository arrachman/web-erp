					function validasiForm():void 
					{
						pesanAlert='';
						validasi = true;
						parentApplication.F_hapusBarisKosongGrid(dg1);
						/* if(chkPJ.selected == false)if(txtkunjungan.text.length == 0)parentApplication.msgAlert(txtkunjungan,'Kunjungan');
						if(chkPJ.selected == false)if(cmbPerawatan.textInput.text.length == 0)parentApplication.msgAlert(cmbPerawatan,'Perawatan'); */
						if(cmbJenisTransaksi.selectedIndex == 0)if(txtkunjungan.text.length == 0)parentApplication.msgAlert(txtkunjungan,'Kunjungan');
						if(cmbJenisLab.textInput.text.length == 0)parentApplication.msgAlert(cmbJenisLab,'Jenis Lab');
						if(cmbJenisTransaksi.selectedIndex == 0)if(cmbPerawatan.textInput.text.length == 0)parentApplication.msgAlert(cmbPerawatan,'Perawatan');
						if(txtKategoriPasien.text.length == 0)parentApplication.msgAlert(txtKategoriPasien,'Kategori Pasien');
						if(dttanggal.text.length == 0)parentApplication.msgAlert(dttanggal,'Tanggal');
						if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
						if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)parentApplication.msgAlert(cmbprogress,'Progress');
						if(txtPetugas.text.length == 0)parentApplication.msgAlert(txtPetugas,'Petugas');
						if(dg1.dataProvider.getItemAt(0).idlbdetail == null)parentApplication.msgAlert(dg1,'Detail Jenis Pemeriksaan');
						if(dg2.dataProvider.getItemAt(0).idlbhasil == null)parentApplication.msgAlert(dg2,'Detail Hasil Lab');
						for (var j:int = 0; j < dg2.dataProvider.length; j++) 
						{
							if(dg2.dataProvider.getItemAt(j).kode != "" && dg2.dataProvider.getItemAt(j).kode != "." && dg2.dataProvider.getItemAt(j).kode != null){
								if(dg2.dataProvider.getItemAt(j).hasil == ''){
									parentApplication.msgAlert(dg2,'Baris '+int(j+1)+' Hasil');
									break;
								}
							}
						} 
						
						if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
					}
				}
				
				public function f_hitungTotal():void
				{
					n.vtotal=0;
					for(var i:int=0;i<dg1.dataProvider.length;i++){
						if(dg1.dataProvider.getItemAt(i).subtotal != undefined)
							n.vtotal += Number(dg1.dataProvider.getItemAt(i).subtotal);
					}
					lbltotal.text = parentApplication.m.nfNominal.format(n.vtotal);
				}
				
				public function f_defaultGrid():void
				{
					parentApplication.rowIndex = 0;
					dg1.dataProvider.removeAll();
					dg2.dataProvider.removeAll();
					parentApplication.F_acAdd(dg1);			// menambah 1 baris lagi
					parentApplication.F_acAdd(dg2);	
					dg1.setSelectedCell(0, 1);
					f_focusOnMe();
				}
				
				protected function f_chkAuto():void
				{
					if(FlexGlobals.topLevelApplication.FormFilter != ''){
						if(chkauto.selected == true){
							txtnotransaksi.enabled = false;
							txtnotransaksi.text = getNotransaksi;
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = getNotransaksi;
							txtnotransaksi.setFocus();
						}
					}else{
						if(chkauto.selected == true){
							txtnotransaksi.enabled = false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							txtnotransaksi.setFocus();
						}
					}
				}
				
