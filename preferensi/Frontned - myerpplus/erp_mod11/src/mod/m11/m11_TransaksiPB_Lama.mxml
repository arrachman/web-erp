			public var validasi:Boolean, pesanAlert:String, t:TitleWindow, img:Image, UFungsional:String, i:int,fu:Object, isUpdate:Boolean, hf:Object, ft:Object;
			public  var o:Object={}, n:Object={}, TOTALAK:Number=0, TOTALKM:Number=0, TOTALLU:Number=0, TOTALLB:Number=0, TOTALRK:Number=0, TOTALRO:Number=0, TOTALTAGIHAN:Number=0;
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number;
			protected var arrMenuBar:ArrayCollection;
			//public var dg:DataGrid;
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						if(Number(data) > 0){
							if(txtmatauang.text == UFungsional){
								if(dataField == 'jumlahvalas'){
									Alert.show(parentApplication.l('Jumlah Valas harus 0 karena mata uang fungsional'), parentApplication.l('Informasi'));
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = 0;
								}
								
							}else{
								if(dataField == 'jumlahvalas'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas * o.txtkurs;
									
								}
								if(dataField == 'jumlah'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = dg.dataProvider[dg.selectedCell.rowIndex].jumlah / o.txtkurs;
								}
							}
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			public function f_focusOnMe():void
			{
				txtKunjungan.setFocus();
			}
			
			protected function f_persiapan():void
			{
				ft= FlexGlobals.topLevelApplication.F_tglFormatDB;
				hf=FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				tab.focusEnabled = false;
				fu=FlexGlobals.topLevelApplication.m.nfNominal.format;
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				FlexGlobals.topLevelApplication.F_TranslateLabel([lblkunjungan,  takun, ttanggal, tnotransaksi, tmatauang, tkurs, tprogress, tkontakperson, ttermin, tbagianterima, talamatsupplier, tcostcenter, tdivisi, tsubdivisi, tproyek, lblPerawatan, lblKategoriPasien, lblKamar, tkasir]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([lblkunjungan, takun, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs, lblPerawatan, lblKategoriPasien, tkasir]);
				
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttanggalnoref,dtTglKeluar,dtTglMeninggal]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress,cmbPerawatan]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtKunjungan,txtakun,txtmatauang,txttermin,txtbagianterima,txtcostcenter,txtdivisi,txtsubdivisi,txtproyek,txtKategoriPasien,txtKamar,txtkasir]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,txtnoref,chkauto,chkposting]);
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"false"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
				function f_mbSimpan():void{
					f_delundefined(dg);
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(11,22,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Pb');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.FormFilter = '';
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal();
				}
				function f_mbCatatan():void{
					if (mb.menuBarItems[3].enabled==true){FlexGlobals.topLevelApplication.F_OpenNotes(o.pbsumber,o.pbid,txtnotransaksi.text);}
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('PB', o.pbid,txtnotransaksi.text);
				}
				function f_mbLinks():void
				{
					FlexGlobals.topLevelApplication.f_mbLinks(11, 'Pb');
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(11,22,[dg],'transaksi');
				f_validasi();
				
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.S:if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(11,22,jenissimpan)==true){
								f_simpan();
							}
						}
							break;
					}
				}
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN, function keydown(e:KeyboardEvent):void{
					if(e.keyCode == Keyboard.ENTER || e.keyCode == Keyboard.DOWN){
						dg.setSelectedCell(0,1)
					}
				});
				
			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				else{
					if(filtersplit.length > 1){
						cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
//						tab.selectedIndex=0;
						cmbprogress.selectedIndex=1;
						txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
						matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
						o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
						kurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
						txtkurs.text = fu(o.txtkurs);
						txtkurs.enabled = false;
						//f_focusOnMe(); 
						isUpdate = false;
						txtakun.text= FlexGlobals.topLevelApplication.getSetting(11, 'akun', 'PiutangSementara');//Ambil dari m0_setting 'kode coa'
						lblakun.text= FlexGlobals.topLevelApplication.getSetting(11, 'akunnama', 'PiutangSementara');//Ambil dari m0_setting 'nama coa'
//						parentApplication.F_SetNilaiText([dttgl,dttanggalnoref], parentApplication.DefaultTanggal);
						dttgl.text = FlexGlobals.topLevelApplication.DefaultTanggal;
						txturaian.text = parentApplication.getNomor("PB");
						txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("PB",1);
						//txtKunjungan.setFocus();
						FlexGlobals.topLevelApplication.F_wsSearch('txtKunjungan','CdM11_Kj',0,0,'(kjstatus = 2 OR kjstatus = 3) AND kjnotransaksi ="'+filtersplit[0].split('"').join('\\"')+'"','kjinputtgl desc');
						//FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_AsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M11_PbGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				cmbprogress.enabled = true;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				mb.menuBarItems[7].visible = false;
				cmbPerawatan.dataProvider = new ArrayCollection([{l:'RI',v:'Rawat Inap'},{l:'RJ',v:'Rawat Jalan'}]);
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				tab.selectedIndex=0;
				cmbprogress.selectedIndex=1;
				cmbPerawatan.selectedIndex = 0;
				lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				kurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = fu(o.txtkurs);
				txtkurs.enabled = false;
				f_focusOnMe(); 
				isUpdate = false;
				txtakun.text= FlexGlobals.topLevelApplication.getSetting(11, 'akun', 'PiutangSementara');//Ambil dari m0_setting 'kode coa'
				lblakun.text= FlexGlobals.topLevelApplication.getSetting(11, 'akunnama', 'PiutangSementara');//Ambil dari m0_setting 'nama coa'
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("PB");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("PB",1);
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotaltagihan,lbltotal,lbltotalvalas],fu(0));
				parentApplication.F_SetNilaiText([dttgl,dttanggalnoref,dtTglKeluar,dtTglMeninggal], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([lblNamaKunjungan,txtKunjungan,txtkontakperson,txtnoref,txaalamatrekanan,txtcostcenter,txtdivisi,txtsubdivisi,txttermin,txtproyek,txtKategoriPasien,lblNamaKatPasien,txtKamar,lblNamaKamar,txtkasir,lblkasir]);
				txtbagianterima.text = FlexGlobals.topLevelApplication.ukontakkode;
				lblbagpenjualan.text = FlexGlobals.topLevelApplication.ukontaknama;
				
				o.idpbcarabayar = 0; o.pbid = 0; o.pbcabang = FlexGlobals.topLevelApplication.ucabang; o.pblokasi = FlexGlobals.topLevelApplication.ulokasi; o.pbsumber="PB"; 
				o.pbkodepa = 0; o.pbkontak = 0; o.pbalamat = txaalamatrekanan.text; o.pbtgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal;
				o.pbjumlah = 0; o.pbjumlahvalas = 0; o.pbjumlahbayar = 0; o.pbjumlahbayarvalas = 0; o.pbstatusbayar = 0; o.pbtgllunas = parentApplication.m.DateFirst; 
				o.pbstatussebelumnya = 0; o.pbjmlrevisi = 0; o.pbcetakanke = 0; 
				o.pbinputuser = FlexGlobals.topLevelApplication.userid; o.pbinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.pbmodifikasiuser = 0; o.pbmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.pbisclose = 0; o.pbcustomtext1 = ''; 
				o.pbcustomtext2 = ''; o.pbcustomtext3 = ''; o.pbcustomtext4 = ''; o.pbcustomtext5  = '';
				o.pbcustomint1 = 0; o.pbcustomint2 = 0; o.pbcustomint3 = 0; 
				o.pbcustomdbl1 = 0; o.pbcustomdbl2 = 0; o.pbcustomdbl3 = 0; 
				o.pbcustomdate1 = parentApplication.m.DateFirst; o.pbcustomdate2 = parentApplication.m.DateFirst; 
				o.pbcustomdate3 = parentApplication.m.DateFirst; o.pbidkj = 0;
				o.pbbagianterima = FlexGlobals.topLevelApplication.ukontak;
				o.pbperawatan = ''; o.pbkategoripasien = ''; o.pbkamar = ''; o.pbkasir = 0; o.pbawalankatpasien = '';
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				//setting no transaksi
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoNoTransaction')==0){
					if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction')==1){
						chkauto.selected = true;
						txtnotransaksi.text = 'Auto';	
						txtnotransaksi.enabled = false;
					}else{
						chkauto.selected = false;
						txtnotransaksi.text = '';	
						txtnotransaksi.enabled = true;
					}
				}else{
					chkauto.selected = true;
					chkauto.enabled = false;
					txtnotransaksi.text = 'Auto';	
					txtnotransaksi.enabled = false;
				}
				
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case 'jumlah':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) / o.txtkurs;
								
							}else{
								jumlahvalas = 0;
							}
						}
						
						break;
					case 'jumlahvalas':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
						}
						break;
					case 'bank':
					case 'nogiro':
					case 'noacbank':
						editable();
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungvalas()
				f_hitungTotal()
				
			}
			
			public function editable():void{
				if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==0 || dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==3){
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).noacbank = '';
				}
					
				else {
					if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar == 1){
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
						
					}
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, dgrid:Object;
				if(dg.selectedCell != null)dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
				switch(target){
					case 'txtKunjungan':
						paket = 'CdM11_Kj';
						wsfilter = '(kjstatus = 2 OR kjstatus = 3) AND kjnotransaksi ="'+txtKunjungan.text.split('"').join('\\"')+'"';
						csfilter = '(kjstatus = 2 OR kjstatus = 3)';
						csfield = 2;
						sort = 'kjinputtgl desc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.pbkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.pbkontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtakun":
						paket = "CdM1_Coa";
						csfilter='caktif=1 and cgd="D"';
						wsfilter = 'caktif=1 AND cgd="D" AND cnomor ="'+txtakun.text+'"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif = 1 AND ckode = "'+ txtmatauang.text +'"';
						csfilter = 'caktif = 1';
						sort = 'ckode asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif = 1 AND tnsumber = "AS"';
						sort = 'tnkode asc';
						break;
					case "txttermin":
						paket = "CdM1_Terms";
						wsfilter = 'traktif = 1 AND trkode = "'+ txttermin.text +'"';
						csfilter = 'traktif = 1';
						sort = 'tpbode asc';
						break;
					case "txtbagianterima":
						paket = "CdM1_Contact";
						wsfilter = '(kaktif = 1 AND kkategori="K") AND kkode ="'+txtbagianterima.text+'"';
						csfilter = '(kaktif = 1 AND kkategori="K")';
						csfield = 4;
						sort = 'kkode asc';
						break;
					case "txtcostcenter":
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif = 1 AND cckode = "'+ txtcostcenter.text +'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case "txtdivisi":
						paket = "CdM1_Division";
						wsfilter = 'daktif = 1 AND dkode = "'+ txtdivisi.text +'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case "txtsubdivisi":
						paket = "CdM1_Subdivision";
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+txtdivisi.text+'" AND sdkode = "'+ txtsubdivisi.text +'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+txtdivisi.text+'"';
						sort = 'sdkode asc';
						break;
					case "txtproyek":
						paket = "CdM1_Project";
						wsfilter = 'paktif = 1 AND pkode = "'+ txtproyek.text +'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
					case "carabayarnama":
						paket = "CdM0_Carabayar";
						wsfilter = 'nama = "'+dgrid.carabayarnama+'"';
						break;
					case "rekbank":
						paket = "CdM1_Coa";
						if (dgrid.carabayar=="0"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="1"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="2"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="3"){
							wsfilter = '(cgd="D" and caktif=1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="" || dgrid.carabayar== undefined){
							wsfilter = 'AA';
							csfilter = 'AA';
						}
						sort = 'cnomor asc';
						break;
					case "bank":
						if(dgrid.carabayar == 1 || dgrid.carabayar == 2){
							paket = "CdM1_Bank";
							wsfilter = 'baktif = 1 AND bkode = "'+dgrid.bank+'"';
							csfilter = 'baktif = 1';
							sort = 'bkode asc';
						}
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber = "PB"';
						sort = 'tndkode asc';
						break;
