					validasiForm();
					if(validasi == true){
						if(dtTglKeluar.text != "")tglkeluar = FlexGlobals.topLevelApplication.F_tglFormatDB(dtTglKeluar.text);
						if(dtTglMeninggal.text != "")tglmeninggal = FlexGlobals.topLevelApplication.F_tglFormatDB(dtTglMeninggal.text);
						//u.refresh();
						// Set Utama
						with(o){ 
							a = [pbid, pbcabang, pblokasi, pbsumber, int(chkauto.selected), txtnotransaksi.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), pbkodepa, pbkontak, txtkontakperson.text, pbalamat,
								pbbagianterima, txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(pbtgljatuhtempo),
								txtakun.text, txturaian.text, txtcatatan.text, txtnoref.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttanggalnoref.text), txtmatauang.text, o.txtkurs, 
								pbjumlah, pbjumlahvalas, pbjumlahbayar, pbjumlahbayarvalas, pbstatusbayar, FlexGlobals.topLevelApplication.F_tglFormatDB(pbtgllunas), txtcostcenter.text, 
								txtdivisi.text, txtsubdivisi.text, txtproyek.text, cmbprogress.selectedItem.v, pbstatussebelumnya, pbjmlrevisi, pbcetakanke, 
								pbinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(pbinputtgl), pbmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(pbmodifikasitgl), int(chkposting.selected), pbisclose, pbcustomtext1, 
								pbcustomtext2, pbcustomtext3, pbcustomtext4, pbcustomtext5, pbcustomint1, pbcustomint2, pbcustomint3, 
								pbcustomdbl1, pbcustomdbl2, pbcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(pbcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(pbcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(pbcustomdate3),pbidkj,
								cmbPerawatan.textInput.text, txtKategoriPasien.text, txtKamar.text, pbkasir, pbawalankatpasien, tglkeluar, tglmeninggal];
							utama = f_splitArrayToString(a);
						}
						// Set Detailb
						for(var c:int=0; c<dg.dataProviderLength; c++){
							with(dg.dataProvider.getItemAt(c)){
								a = [idpbcarabayar, idpb, carabayar, matauang, parentApplication.F_hapusFormatCurrency(txtkurs.text), jumlah, jumlahvalas, 
									nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, noacbank, rekbank, rekgiro, catatan, 
									c+1, isclose];
								if(detail == '')detail =f_splitArrayToString(a);
								else detail += "▲"+f_splitArrayToString(a);
							}
						}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M11_PbSimpan", FlexGlobals.topLevelApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					var i:int, totaltagihandg:Number=0;
					validasi = true;
					pesanAlert = '';
					parentApplication.F_hapusBarisKosongGrid(dg);
					if(txttermin.text.length == 0){o.pbtgljatuhtempo = dttgl.text;}
					if(txtKunjungan.text.length <= 0)parentApplication.msgAlert(txtKunjungan,'Kunjungan');
					if(cmbPerawatan.textInput.text.length == 0)parentApplication.msgAlert(cmbPerawatan,'Perawatan');
					if(txtKategoriPasien.text.length == 0)parentApplication.msgAlert(txtKategoriPasien,'Kategori Pasien');
					if(txtakun.text.length <= 0)parentApplication.msgAlert(txtakun,'Akun');
					if(txtkasir.text.length <= 0)parentApplication.msgAlert(txtakun,'Kasir');
					if(txtmatauang.text.length <= 0)parentApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)parentApplication.msgAlert(txtkurs,'Kurs');
					if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)parentApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)parentApplication.msgAlert(cmbprogress,'Progress');
					if(dg.dataProvider.getItemAt(0).rekbank == null  || dg.dataProvider.getItemAt(0).rekbank == '')parentApplication.msgAlert(dg,'Detail Item');
					for(var kl:int=0;kl<dg.dataProviderLength;kl++){
						totaltagihandg += dg.dataProvider.getItemAt(kl).jumlah;
					}
					if(totaltagihandg < TOTALTAGIHAN)parentApplication.msgAlert(dg,'Jumlah Bayar tidak boleh kurang dari Total Tagihan, ');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');	
					if(txttermin.text.length == 0){
						o.pbtgljatuhtempo = dttgl.text;
					}
					f_hitungTotal();
					f_hitungvalas();
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			private var vtotal:Number=0,vvalas:Number=0;
			public function f_hitungTotal():void
			{
				o.pbjumlah=0;  o.pbjumlahvalas=0;
				for(var i:int=0;i<dg.dataProvider.length;i++){
					o.pbjumlah += Number(dg.dataProvider.getItemAt(i).jumlah)
					o.pbjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas)
				}
				lbltotal.text = fu(o.pbjumlah);
				lbltotalvalas.text =fu(o.pbjumlahvalas);
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = dg.dataProvider.getItemAt(i).jumlah/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = 0; 
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}
			}
			protected function chkauto_clickHandler(event:MouseEvent):void
			{
				if (chkauto.selected==true)txtnotransaksi.enabled=false;
				else txtnotransaksi.enabled=true;
			}
			
			public function f_hitungTotalUtama():void
			{
				n.vtotaltransaksi = (Number(TOTALAK) + Number(TOTALKM) + Number(TOTALLB) + Number(TOTALLU) + Number(TOTALRK)) - Number(TOTALRO);
				TOTALTAGIHAN = n.vtotaltransaksi;
				
				lbltotaltagihan.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
			}
			
