			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkunjungan':parentApplication.F_KosongkanText([txtkunjungan, lblkunjungan]);break;
					case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
					case 'txtcatatan':parentApplication.F_KosongkanText([txtcatatan]);break;
					case 'txtKategoriPasien':parentApplication.F_KosongkanText([txtKategoriPasien, lblNamaKatPasien]);break;
					case 'txtKamar':parentApplication.F_KosongkanText([txtKamar, lblNamaKamar]);break;
				}
			}
			
