			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				if(parentApplication.rowIndex < dg1.dataProviderLength)
					with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
						switch(column){
							case 'jml':
							case 'harga':
							case 'pajak1':
							case 'pajak2':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								jmltotal = Number(jml) * Number(nilaisatuan);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								break;
							case 'diskon':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								break;
							case 'jmldiskon':
								vMsg = ''; vMsgIng = '';
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
									if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
									if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								}
								break;
						}
					}
				parentApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtkunjungan':
						if(txtkunjungan.enabled == true){
							paket = 'CdM11_Kj';
							wsfilter = '(kjstatus = 2 OR kjstatus = 3) AND kjnotransaksi ="'+txtkontakperson.text.split('"').join('\\"')+'"';
							csfilter = '(kjstatus = 2 OR kjstatus = 3)';
							csfield = 2;
							sort = 'kjinputtgl desc';
						}
						break;
					case 'txtKategoriPasien':
						if(txtKategoriPasien.enabled == true){
							paket = 'CdM1_Patient_Category';
							wsfilter = '(pcaktif = 1) AND pckode ="'+txtKategoriPasien.text.split('"').join('\\"')+'"';
							csfilter = '(pcaktif = 1)';
							csfield = 2;
							sort = 'pckode asc';
						}
						break;
					case 'txtKamar':
						if(txtKamar.enabled == true){
							paket = 'CdM1_Room';
							wsfilter = '(raktif = 1 AND risclose = 0) AND rkode ="'+txtKamar.text.split('"').join('\\"')+'"';
							csfilter = '(raktif = 1 AND risclose = 0)';
							csfield = 2;
							sort = 'rkode asc';
						}
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "AK"';
						sort = 'tnkode asc';
						break;
					case 'jenis':
						if(txtkunjungan.text == "" && chkPJ.selected == false){
							txtkunjungan.setFocus();
							Alert.show(FlexGlobals.topLevelApplication.l("No Kunjungan harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
						}
						else{
							paket = 'CdM1_Item_Category';
							wsfilter = 'icaktif = 1 AND ickode = "'+obj.jenis.split('"').join('\\"')+'"';
							csfilter = 'icaktif = 1';
							sort = 'ickode asc';
						}
						break;
					case 'kodelayanan':
						if(txtkunjungan.text == "" && chkPJ.selected == false){
							txtkunjungan.setFocus();
							Alert.show(FlexGlobals.topLevelApplication.l("No Kunjungan harus diisi terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
						}
						else{
							paket = 'CdM1_Item';
							wsfilter = 'baktif = 1 AND bjenis = "P" AND bkategori = "O" AND bkode = "'+obj.kodelayanan.split('"').join('\\"')+'"';
							csfilter = 'baktif = 1 AND bjenis = "P" AND bkategori = "O"';
							sort = 'bkode asc';
						}
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif = 1 AND ukode = "'+obj.satuan.split('"').join('\\"')+'"';
						csfilter = 'uaktif = 1';
						sort = 'ukode asc';
						break;
					case 'cabang':
						paket = 'CdM1_Branch';
						wsfilter = 'baktif = 1 AND bkode = "'+obj.cabang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'lokasi':
						paket = 'CdM1_Location';
						wsfilter = 'laktif = 1 AND lkode = "'+obj.lokasi.split('"').join('\\"')+'"';
						csfilter = 'laktif = 1';
						sort = 'lkode asc';
						break;
					case 'kodedokter':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkategori = "K" AND kkode = "'+obj.lokasi.split('"').join('\\"')+'"';
						csfilter = 'kaktif = 1 AND kkategori = "K"';
						sort = 'kkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "AK"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
