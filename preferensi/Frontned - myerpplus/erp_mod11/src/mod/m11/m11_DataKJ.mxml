	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.TitleWindow;
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array, idkontak:int, iduser:String='', t:TitleWindow;
			private var p:Object; public var o:Object = {};
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			public function f_persiapan():void
			{
				p=parentApplication;
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(11, 3);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tperawatan, tsupplier, ttanggal, tnotransaksi, tstatus, turaian, tjenislaporan, tcatatan, tinputuser, tcabang, tlokasi, tnopasien,tnamapasien,talamat,tayah,tibu]);
				// module, menu transaksi, menu, sumber, approvell
				a = [11, 3, 9, 'Kj', false];
				p.F_persiapanFormData(this);
				// Daftarkan fungsi-fungsi text input
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbjenislaporan,cmbstatus, cmbperawatan]);
				p.F_txtpencarian([txtlokasi, txtcabang, txtuser]);
				p.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2, txturaian,txtcatatan,txtnopasien,txtnamapasien,txtalamat,txtayah,txtibu]);
				txtnotransaksi2.addEventListener(FocusEvent.FOCUS_IN, f_change);
				function f_change():void{
					if(txtnotransaksi2.text == ''){
						txtnotransaksi2.text = txtnotransaksi1.text;	
					}
				}
				
				dttgl2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				f_kondisiAwal();
			}
			
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				txtcabang.text = parentApplication.ucabang;
				p.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				p.F_KosongkanText([txtnotransaksi1,txtnotransaksi2,txturaian,txtuser,txturaian,txtcatatan,txtnopasien,txtnamapasien,txtalamat,txtayah,txtibu]);
				o.user = txtuser.text;
				dg.dataProvider.removeAll();
				cmbstatus.selectedIndex = o.DefaultStatus;
				cmbperawatan.dataProvider = new ArrayCollection([{l:'Rawat Inap', v:'RI'}, {l:'Rawat Jalan', v:'RJ'}]);
				cmbperawatan.selectedIndex=0;
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				if(parentApplication.apaBisaAkses(a[0], a[2], 4)){
					FlexGlobals.topLevelApplication.openForm(a[0], a[1], dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[a[3].toLowerCase()+'id']);
				}
				//FlexGlobals.topLevelApplication.openForm(11, 3, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kjid);
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					//					case 'txtgudang':
					//						paket = 'CdM1_Warehouse';
					//						wsfilter = "wkode ='"+txtgudang.text+"'";
					//						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = "laktif=1";
						wsfilter = "laktif=1 AND lkode ='"+txtlokasi.text+"'";
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = "baktif=1";
						wsfilter = "baktif=1 AND bkode ='"+txtcabang.text+"'";
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = "uaktif=1";
						wsfilter = "uaktif=1 ANd ukode ='"+txtuser.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(p.wsSuccess == true){
					if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtlokasi':
							txtlokasi.text = ws.lkode;
							break;
						case 'txtcabang':
							txtcabang.text = ws.bkode;
							break;
						case 'txtuser':
							txtuser.text = ws.ukode;
							iduser = ws.userid;
							break;
						//						case 'txtgudang':
						//							txtgudang.text = ws.wkode;
						//							break;
					}
				}else{
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtlokasi':p.F_KosongkanText([txtlokasi]);break;
					case 'txtcabang':p.F_KosongkanText([txtcabang]);break;
					case 'txtuser':p.F_KosongkanText([txtuser]);break;
				}
			}
			
			public function f_filterdata():String{
				var f:String="";
				f = FlexGlobals.topLevelApplication.F_standartFilter();
				if(txtuser.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kjinputuser = "'+iduser+'"');
				if(txtnopasien.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kjnopasien Like "%'+txtnopasien.text+'%"');
				if(txtnamapasien.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kjnama Like "%'+txtnamapasien.text+'%"');
				if(txtalamat.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kjalamat Like "%'+txtalamat.text+'%"');
				if(txtayah.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kjayah Like "%'+txtayah.text+'%"');
				if(txtibu.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kjibu Like "%'+txtibu.text+'%"');
				if(cmbperawatan.selectedIndex >= 0)
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kjperawatan = "'+cmbperawatan.selectedItem.v+'"');
				return f;
			}
			
			public function f_hitungTotal():void{}
