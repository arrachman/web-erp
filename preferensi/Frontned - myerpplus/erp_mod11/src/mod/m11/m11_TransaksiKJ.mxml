			public function f_hitungTotalDetail():void
			{
				var notranAK:String = '', notranAK1:String = '', statusada:int = 0;
				n.vtotalLU=0;
				n.vtotalKM=0;
				n.vtotalAK=0;
				n.vtotalLB=0;
				n.vtotalRK=0;
				n.vtotalRO=0;
				n.vtotalResep=0;
				n.vtotalRacik=0;
				n.vtotalEmbalase=0;
				n.vtotalAKRK=0;
				n.vtotalLBRK=0;
				for(var i:int=0;i<dg1.dataProvider.length;i++){
					if(dg1.dataProvider.getItemAt(i).subtotal != undefined)n.vtotalLU += Number(dg1.dataProvider.getItemAt(i).subtotal);
				}
				/* for(var j:int=0;j<dg2.dataProvider.length;j++){
					if(dg2.dataProvider.getItemAt(j).kmtotaltransaksi != undefined)n.vtotalKM += Number(dg2.dataProvider.getItemAt(j).kmtotaltransaksi);
				} */
				for(var k:int=0;k<dg3.dataProvider.length;k++){
					if(dg3.dataProvider.getItemAt(k).subtotal != undefined){
						n.vtotalAK += Number(dg3.dataProvider.getItemAt(k).subtotal);
						//n.vtotalAKRK += Number(dg3.dataProvider.getItemAt(k).subtotal);
					}
				}
				for(var l:int=0;l<dg4.dataProvider.length;l++){
					if(dg4.dataProvider.getItemAt(l).subtotal != undefined){
						n.vtotalLB += Number(dg4.dataProvider.getItemAt(l).subtotal);
						//n.vtotalLBRK += Number(dg4.dataProvider.getItemAt(l).subtotal);
					}
				}
				for(var m:int=0;m<dg5.dataProvider.length;m++){
					if(dg5.dataProvider.getItemAt(m).jumlah != undefined)n.vtotalRK += Number(dg5.dataProvider.getItemAt(m).jumlah);
					if(dg5.dataProvider.getItemAt(m).jumlah != undefined && dg5.dataProvider.getItemAt(m).rkkategori == 0)n.vtotalAKRK += Number(dg5.dataProvider.getItemAt(m).jumlah);
					if(dg5.dataProvider.getItemAt(m).jumlah != undefined && dg5.dataProvider.getItemAt(m).rkkategori == 1)n.vtotalLBRK += Number(dg5.dataProvider.getItemAt(m).jumlah);
				}
				for(var kl:int=0;kl<dg6.dataProvider.length;kl++){
					if(dg6.dataProvider.getItemAt(kl).subtotal != undefined)n.vtotalRO += Number(dg6.dataProvider.getItemAt(kl).subtotal);
				}
				if(dg3.dataProviderLength > 0){
					notranAK = dg3.dataProvider.getItemAt(0).aknotransaksi;
					for(var ak:int = 0;ak<dg3.dataProviderLength;ak++){
						if(dg3.dataProvider.getItemAt(ak).aknotransaksi == notranAK && statusada == 0){
							if(dg3.dataProvider.getItemAt(ak).akresep != undefined){
								n.vtotalResep += Number(dg3.dataProvider.getItemAt(ak).akresep);	
							}
							if(dg3.dataProvider.getItemAt(ak).akracik != undefined){
								n.vtotalRacik += Number(dg3.dataProvider.getItemAt(ak).akracik);	
							}
							if(dg3.dataProvider.getItemAt(ak).akembalase != undefined){
								n.vtotalEmbalase += Number(dg3.dataProvider.getItemAt(ak).akembalase);	
							}
							statusada = 1;
						}
						else{
							notranAK1 = dg3.dataProvider.getItemAt(ak).aknotransaksi;
							if(notranAK == notranAK1)statusada = 1
							else{
								notranAK = dg3.dataProvider.getItemAt(ak).aknotransaksi;
								statusada = 0;
								if(dg3.dataProvider.getItemAt(ak).akresep != undefined){
									n.vtotalResep += Number(dg3.dataProvider.getItemAt(ak).akresep);	
								}
								if(dg3.dataProvider.getItemAt(ak).akresep != undefined){
									n.vtotalRacik += Number(dg3.dataProvider.getItemAt(ak).akracik);	
								}
								if(dg3.dataProvider.getItemAt(ak).akresep != undefined){
									n.vtotalEmbalase += Number(dg3.dataProvider.getItemAt(ak).akembalase);	
								}
								statusada = 1;
							}
						}
					}
				}
				
				totalLU = n.vtotalLU;
				totalAK = n.vtotalAK;
				totalKM = n.vtotalKM;
				totalLB = n.vtotalLB;
				totalRK = n.vtotalRK;
				totalRO = n.vtotalRO;
				TotalResep = n.vtotalResep;
				TotalRacik = n.vtotalRacik;
				TotalEmbalase = n.vtotalEmbalase;
				totalAKFix = n.vtotalAK+n.vtotalResep+n.vtotalRacik+n.vtotalEmbalase;
				
				lblLUTotalTransaksi.text = parentApplication.m.nfNominal.format(n.vtotalLU);
				//lblKMTotalTransaksi.text = parentApplication.m.nfNominal.format(n.vtotalKM);
				lblAKTotalTransaksi.text = parentApplication.m.nfNominal.format(n.vtotalAK+n.vtotalResep+n.vtotalRacik+n.vtotalEmbalase);
				lblLBTotalTransaksi.text = parentApplication.m.nfNominal.format(n.vtotalLB);
				lblRKTotalTransaksi.text = parentApplication.m.nfNominal.format(n.vtotalRK);
				lblROTotalTransaksi.text = parentApplication.m.nfNominal.format(n.vtotalRO);
				lblAKResep.text = parentApplication.m.nfNominal.format(n.vtotalResep);
				lblAKRacik.text = parentApplication.m.nfNominal.format(n.vtotalRacik);
				lblAKEmbalase.text = parentApplication.m.nfNominal.format(n.vtotalEmbalase);
				lblAKTotalObat.text = parentApplication.m.nfNominal.format(n.vtotalAK);
				/* lblTotalAK.text = parentApplication.m.nfNominal.format(n.vtotalAKRK+n.vtotalResep+n.vtotalRacik+n.vtotalEmbalase);
				lblTotalLB.text = parentApplication.m.nfNominal.format(n.vtotalLBRK); */
				lblTotalAK.text = parentApplication.m.nfNominal.format(n.vtotalAK+n.vtotalResep+n.vtotalRacik+n.vtotalEmbalase+n.vtotalAKRK);
				lblTotalLB.text = parentApplication.m.nfNominal.format(n.vtotalLB+n.vtotalLBRK);
				lblTotalLU.text = parentApplication.m.nfNominal.format(n.vtotalLU);
				lblTotalRO.text = "("+parentApplication.m.nfNominal.format(n.vtotalRO)+")";
				lblTotalRK.text = parentApplication.m.nfNominal.format(n.vtotalRK);
				f_hitungTotalUtama();
			}
			
			public function f_hitungTotalUtama():void
			{
				n.vtotaltransaksi = (Number(n.vtotalLU) /* + Number(n.vtotalKM) */ + Number(n.vtotalAK+n.vtotalResep+n.vtotalRacik+n.vtotalEmbalase) + Number(n.vtotalLB) + Number(n.vtotalRK)) - Number(n.vtotalRO) ;
				TotalSemua = n.vtotaltransaksi;
				
				lblTotalTagihan.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
			}
			
			protected function cmbPerawatan_changeHandler(event:IndexChangeEvent):void
			{
