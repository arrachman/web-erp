			protected function dtTglLahir_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER){
					var tglsekarang:Date = new Date();
					var tahunsekarang:Number;
					var tahunlahir:Number;
					var hasilsplit:Array;
					tahunsekarang = Number(tglsekarang.fullYear);
					hasilsplit = dtTglLahir.text.split("/");
					tahunlahir = Number(hasilsplit[2]);
					txtUmur.text = (tahunsekarang-tahunlahir).toString();
				}
			}
			
			protected function txtUmur_changeHandler(event:TextOperationEvent):void
			{
				var tglsekarang:Date = new Date();
				var tahunsekarang:Number;
				var tahunlahir:Number;
				tahunsekarang = Number(tglsekarang.fullYear);
				tahunlahir = Number(txtUmur.text);
				dtTglLahir.text = "01/01/"+(tahunsekarang-tahunlahir).toString();
			}
			
