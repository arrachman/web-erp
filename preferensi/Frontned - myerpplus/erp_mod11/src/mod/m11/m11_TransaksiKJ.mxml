			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String = '', kondisi:String = '';
				//if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtNoPasien':
						paket = 'CdM1_Patient';
						wsfilter = '(paktif = 1) AND pkode ="'+txtNoPasien.text.split('"').join('\\"')+'"';
						csfilter = '(paktif = 1)'; 
						csfield = 2;
						sort = 'pkode desc';
						kondisi = "tombol";
						//Alert.show(kondisi)
						break;
					case 'txtDirujukOleh':
						if(txtDirujukOleh.enabled == true){
							paket = 'CdM1_Reference';
							wsfilter = 'raktif = 1 AND rjenis = 1 AND rkode = "'+txtDirujukOleh.text.split('"').join('\\"')+'"';
							csfilter = 'raktif = 1 AND rjenis = 1';
							csfield = 2;
							sort = 'rkode asc';
						}
						break;
					case 'txtDirujukKe':
						paket = 'CdM1_Reference';
						wsfilter = 'raktif = 1 AND rjenis = 2 AND rkode = "'+txtDirujukKe.text.split('"').join('\\"')+'"';
						csfilter = 'raktif = 1 AND rjenis = 2';
						csfield = 2;
						sort = 'rkode asc';
						break;
					case 'txtLayanan':
						paket = 'CdM1_Layanan';
						wsfilter = '(laktif = 1) AND lkode = "'+txtLayanan.text.split('"').join('\\"')+'"';
						csfilter = '(laktif = 1)';
						csfield = 2;
						sort = 'lkode asc';
						break;
					case 'txtKamar':
						paket = 'CdM1_Room';
						wsfilter = '(raktif = 1 AND risclose = 0) AND rkode ="'+txtKamar.text.split('"').join('\\"')+'"';
						csfilter = '(raktif = 1 AND risclose = 0)';
						csfield = 2;
						sort = 'rkode asc';
						break;
					case 'txtKategoriPasien':
						paket = 'CdM1_Patient_Category';
						wsfilter = '(pcaktif = 1) AND pckode ="'+txtKategoriPasien.text.split('"').join('\\"')+'"';
						csfilter = '(pcaktif = 1)';
						csfield = 2;
						sort = 'pckode asc';
						break;
					case 'txtDokter':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkategori = "D" AND kkode = "'+txtDokter.text.split('"').join('\\"')+'"';
