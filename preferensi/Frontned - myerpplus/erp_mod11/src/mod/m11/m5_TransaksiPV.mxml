				FlexGlobals.topLevelApplication.F_dgRefresh(dgIP);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgRP);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgSI);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgSR);
				f_hitungTotal();
			}
			
