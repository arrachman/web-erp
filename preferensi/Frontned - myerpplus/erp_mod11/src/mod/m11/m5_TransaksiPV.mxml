							case 'subdivisi':
								dgCOA.dataProvider.getItemAt(dgCOA.selectedCell.rowIndex).subdivisi = '';
								break;
							case 'proyek':
								dgCOA.dataProvider.getItemAt(dgCOA.selectedCell.rowIndex).proyek = '';
								break;
							case 'IC_TakeData':
								if(loop == -1 || loop == 5)loop = tab.selectedIndex;
								if(loop == 0)dg = dgSI;
								else if(loop == 1)dg = dgRP;
								else if(loop == 2)dg = dgIP;
								else if(loop == 3)dg = dgAS;
