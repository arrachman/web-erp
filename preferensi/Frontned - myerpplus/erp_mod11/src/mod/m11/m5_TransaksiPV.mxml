			public var loop:int = -1;
			public function f_uangRefreshGrid():void
			{
				loop++;
				if(dgSI.dataProvider.length > 0 && dgSI.dataProvider[0].notransaksi != '' && loop == 0){
					FlexGlobals.topLevelApplication.F_wsSearch('IC_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dgRP.dataProvider.length > 0 && dgRP.dataProvider[0].notransaksi != '' && loop == 1){
					FlexGlobals.topLevelApplication.F_wsSearch('IC_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dgIP.dataProvider.length > 0 && dgIP.dataProvider[0].notransaksi != '' && loop == 2){
					FlexGlobals.topLevelApplication.F_wsSearch('IC_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dgAS.dataProvider.length > 0 && dgAS.dataProvider[0].notransaksi != '' && loop == 3){
					FlexGlobals.topLevelApplication.F_wsSearch('IC_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dgSR.dataProvider.length > 0 && dgSR.dataProvider[0].notransaksi != '' && loop == 4){
					FlexGlobals.topLevelApplication.F_wsSearch('IC_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(loop < 5)f_uangRefreshGrid();
				if(loop > 4){ cekfilter = false; }
			}
			
