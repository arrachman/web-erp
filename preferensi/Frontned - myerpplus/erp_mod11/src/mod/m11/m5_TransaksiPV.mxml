				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				//set total detail
				o.totalSI = 0; o.totalSIvalas = 0; o.totalAS = 0; o.totalASvalas = 0;  o.totalSR = 0; o.totalSRvalas = 0; o.totalCOA = 0; 
				o.totalCOAvalas = 0; o.totalRP = 0; o.totalRPvalas = 0; o.totalIP = 0; o.totalIPvalas = 0;
				//set diskon detail
				o.diskonterminSI = 0; o.diskonterminAS = 0; o.diskonterminSR = 0; o.diskonterminRP = 0; o.diskonterminIP = 0;
				o.diskonterminSIvalas = 0; o.diskonterminASvalas = 0; o.diskonterminSRvalas = 0; o.diskonterminRPvalas = 0; o.diskonterminIPvalas = 0;
				o.totaltransaksiSI = 0; o.totaltransaksiAS = 0; o.totaltransaksiSR = 0; o.totaltransaksiRP = 0; o.totaltransaksiIP = 0; o.totaltransaksiCOA = 0; 
				o.terbayarSI = 0; o.terbayarAS = 0; o.terbayarSR = 0; o.terbayarRP = 0; o.terbayarIP = 0;
				o.sisaSI = 0; o.sisaAS = 0; o.sisaSR = 0; o.sisaRP = 0; o.sisaIP = 0;
				//set total bawah
				o.pvtotalap = 0; o.pvtotalapvalas = 0; o.pvtotalar = 0; o.pvtotalarvalas = 0; o.pvselisihkurs = 0;
				o.pvdiskontermin = 0; o.pvdiskonterminvalas =  0; o.pvbayar = 0; o.pvbayarvalas = 0;
				o.pvselisihar = 0; o.pvselisiharvalas = 0;
				
				//dgSI
				for(i = 0; i< dgSI.dataProviderLength; i++){
					if(dgSI.dataProvider[i].chk == 1){
						if(dgSI.dataProvider[i].jmlbayar != undefined){
							o.totalSI += Number(dgSI.dataProvider[i].jmlbayar);
							o.totalSIvalas += Number(dgSI.dataProvider[i].jmlbayarvalas);
							o.diskonterminSI += Number(dgSI.dataProvider[i].jmldiskontermin);
							o.diskonterminSIvalas += Number(dgSI.dataProvider[i].jmldiskonterminvalas);
							// hitung total tiap tiap tab
							o.totaltransaksiSI += Number(dgSI.dataProvider[i].totaltransaksi);
							o.terbayarSI += Number(dgSI.dataProvider[i].terbayar);
							o.sisaSI = Number(o.totaltransaksiSI - o.terbayarSI);
						}
					}
				}
				//dgAS
				for(i = 0; i< dgAS.dataProviderLength; i++){
					if(dgAS.dataProvider[i].chk == 1){
						if(dgAS.dataProvider[i].jmlbayar != undefined){
							o.totalAS += Number(dgAS.dataProvider[i].jmlbayar);
							o.totalASvalas += Number(dgAS.dataProvider[i].jmlbayarvalas);
							o.diskonterminAS += Number(dgAS.dataProvider[i].jmldiskontermin);
							o.diskonterminASvalas += Number(dgAS.dataProvider[i].jmldiskonterminvalas);
							// hitung total tiap tiap tab
							o.totaltransaksiAS += Number(dgAS.dataProvider[i].totaltransaksi);
							o.terbayarAS += Number(dgAS.dataProvider[i].terbayar);
							o.sisaAS = Number(o.totaltransaksiAS - o.terbayarAS);
						}
					}
				}
				//dg SR
				for(i = 0; i< dgSR.dataProviderLength; i++){
					if(dgSR.dataProvider[i].chk == 1){
						if(dgSR.dataProvider[i].jmlbayar != undefined){
							o.totalSR += Number(dgSR.dataProvider[i].jmlbayar);
							o.totalSRvalas += Number(dgSR.dataProvider[i].jmlbayarvalas);
							o.diskonterminSR += Number(dgSR.dataProvider[i].jmldiskontermin);
							o.diskonterminSRvalas += Number(dgSR.dataProvider[i].jmldiskonterminvalas);
							// hitung total tiap tiap tab
							o.totaltransaksiSR += Number(dgSR.dataProvider[i].totaltransaksi);
							o.terbayarSR += Number(dgSR.dataProvider[i].terbayar);
							o.sisaSR = Number(o.totaltransaksiSR - o.terbayarSR);
						}
					}
				}
				// dg RP
				for(i = 0; i< dgRP.dataProviderLength; i++){
					if(dgRP.dataProvider[i].chk == 1){
						if(dgRP.dataProvider[i].jmlbayar != undefined){
							o.totalRP += Number(dgRP.dataProvider[i].jmlbayar);
							o.totalRPvalas += Number(dgRP.dataProvider[i].jmlbayarvalas);
							o.diskonterminRP += Number(dgRP.dataProvider[i].jmldiskontermin);
							o.diskonterminRPvalas += Number(dgRP.dataProvider[i].jmldiskonterminvalas);
							// hitung total tiap tiap tab
							o.totaltransaksiRP += Number(dgRP.dataProvider[i].totaltransaksi);
							o.terbayarRP += Number(dgRP.dataProvider[i].terbayar);
							o.sisaRP = Number(o.totaltransaksiRP - o.terbayarRP);
						}
						
					}
				}
				// dgIP
				for(i = 0; i< dgIP.dataProviderLength; i++){
					if(dgIP.dataProvider[i].chk == 1){
						if(dgIP.dataProvider[i].jmlbayar != undefined){
							o.totalIP += Number(dgIP.dataProvider[i].jmlbayar);
							o.totalIPvalas += Number(dgIP.dataProvider[i].jmlbayarvalas);
							o.diskonterminIP += Number(dgIP.dataProvider[i].jmldiskontermin);
							o.diskonterminIPvalas += Number(dgIP.dataProvider[i].jmldiskonterminvalas);
							// hitung total tiap tiap tab
							o.totaltransaksiIP += Number(dgIP.dataProvider[i].totaltransaksi);
							o.terbayarIP += Number(dgIP.dataProvider[i].terbayar);
							o.sisaIP = Number(o.totaltransaksiIP - o.terbayarIP);
						}
						
					}
				}
				for(i = 0; i <dgCOA.dataProviderLength; i++){
					if(dgCOA.dataProvider[i].jmlbayar != undefined){
						o.totalCOA += Number(dgCOA.dataProvider[i].jmlbayar);
						o.totalCOAvalas += Number(dgCOA.dataProvider[i].jmlbayarvalas);
						// hitung total tiap tiap tab
						o.totaltransaksiCOA += Number(dgCOA.dataProvider[i].jmlbayar);
					}
				}
				
				//hitungtotalap
				o.pvtotalar = Number(o.totalSI) + Number(o.totalRP) + Number(o.totalCOA);
				o.pvtotalarvalas = Number(o.totalSIvalas) + Number(o.totalCOAvalas) + Number(o.totalRPvalas);
//				o.pvtotalar = Number(o.totalAS) + Number(o.totalRP) + Number(o.totalSR);
//				o.pvtotalarvalas = Number(o.totalASvalas) + Number(o.totalRPvalas) + Number(o.totalSRvalas);
				//hitungtotalar
				o.pvtotalap = Number(o.totalAS) + Number(o.totalSR) + Number(o.totalIP);
				o.pvtotalapvalas = Number(o.totalASvalas) + Number(o.totalSRvalas) + Number(o.totalIPvalas);
//				o.pvtotalap = Number(o.totalSI) + Number(o.totalCOA) + Number(o.totalIP);
//				o.pvtotalapvalas = Number(o.totalSIvalas) + Number(o.totalCOAvalas) + Number(o.totalIPvalas);
				//hitung diskon termin
				o.pvdiskontermin = Number(o.diskonterminSI) + Number(o.diskonterminAS) + Number(o.diskonterminSR) + Number(o.diskonterminRP) + Number(o.diskonterminIP);
				o.pvdiskonterminvalas = Number(o.diskonterminSIvalas) + Number(o.diskonterminASvalas) + Number(o.diskonterminSRvalas) + Number(o.diskonterminRPvalas) + Number(o.diskonterminIPvalas);
				//hitung selisih kurs
				if(txtmatauang.text != UFungsional){
					o.pvselisihkurs = Number(o.pvtotalap) - Number(o.pvtotalar) - Number(o.pvdiskontermin) - ((Number(o.pvtotalapvalas) - Number(o.pvtotalarvalas) - Number(o.pvdiskonterminvalas)) * Number(o.txtkurs));
				}
				o.pvselisihar = Number(o.pvtotalar) - Number(o.pvtotalap) - Number(o.pvdiskontermin) + Number(o.pvselisihkurs); 
				o.pvselisiharvalas = Number(o.pvtotalarvalas) - Number(o.pvtotalapvalas);
				
				//hitungbayar
//				o.pvbayar = o.pvtotalap - o.pvtotalar - o.pvdiskontermin -  o.pvselisihkurs;
//				o.pvbayarvalas = o.pvtotalapvalas - o.pvtotalarvalas - o.pvdiskonterminvalas;
				//set label
				lblselisihARAP.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvselisihar);
				//lblselisiharvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvselisiharvalas); 
				lbltotalAP.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvtotalap); lbltotalAPvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvtotalapvalas);
				lbltotalAR.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvtotalar); lbltotalARvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvtotalarvalas);
				lbldiskontermin.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvdiskontermin); lbldiskonterminvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvdiskonterminvalas);
				lblselisihkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvselisihkurs);
				lblbayar.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvbayar); lblbayarvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pvbayarvalas);
				// set label tiap tiap tab
				lbltotaltransaksiSI1.text = parentApplication.F_formatNominal(o.totaltransaksiSI); lbltotaltransaksiAS1.text = parentApplication.F_formatNominal(o.totaltransaksiAS); lbltotaltransaksiSR1.text = parentApplication.F_formatNominal(o.totaltransaksiSR); lbltotaltransaksiRP1.text = parentApplication.F_formatNominal(o.totaltransaksiRP); lbltotaltransaksiIP1.text = parentApplication.F_formatNominal(o.totaltransaksiIP);
				lblterbayarSI1.text = parentApplication.F_formatNominal(o.terbayarSI); lblterbayarAS1.text = parentApplication.F_formatNominal(o.terbayarAS); lblterbayarSR1.text = parentApplication.F_formatNominal(o.terbayarSR); lblterbayarRP1.text = parentApplication.F_formatNominal(o.terbayarRP); lblterbayarIP1.text = parentApplication.F_formatNominal(o.terbayarIP);
				lblsisaSI1.text = parentApplication.F_formatNominal(o.sisaSI); lblsisaAS1.text = parentApplication.F_formatNominal(o.sisaAS); lblsisaSR1.text = parentApplication.F_formatNominal(o.sisaSR); lblsisaRP1.text = parentApplication.F_formatNominal(o.sisaRP); lblsisaIP1.text = parentApplication.F_formatNominal(o.sisaIP);
				lbltotaltransaksiCOA1.text = parentApplication.F_formatNominal(o.totaltransaksiCOA);
			}
			
			protected function f_dinamikValueGrid(dg:DataGrid, rowIndex:int):void{
				with(dg.dataProvider.getItemAt(rowIndex)){
					if(vUang == txtmatauang.text)
						jmlbayarvalas = 0;
					else jmlbayarvalas = jmlbayar/h.getItemAt(0).kurs;
					diskontermin = f_diskonTermin(dttgl.text, tgljatuhtempo, tgl, haridiskon1, haridiskon2, diskon1, diskon2);
					jmldiskontermin = jmlbayar*(diskontermin/100);
					jmldiskonterminvalas = jmlbayarvalas*(diskontermin/100); 
				}
			}
			
			protected function f_diskonTermin(tglutama:String, tglgiro:String, tgl:String, haridiskon1:int, haridiskon2:int, diskon1:int, diskon2:int):int
			{
				var tglselisih:int, i:int;
				if(tglutama == '')
					return 0;
				if(tglgiro == '')tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglutama, tgl)
				else tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglutama, tglgiro);
				if(tglselisih <= haridiskon1)
					return diskon1;
				else if(tglselisih <= haridiskon2)
					return diskon2;
				else return 0;
			}
			
			
