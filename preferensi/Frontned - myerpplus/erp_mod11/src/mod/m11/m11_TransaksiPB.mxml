			protected function f_filterdata():String{
				var dg:Object={};
				var f:String='';
				if(tab.selectedIndex == 0){
					//f = FlexGlobals.topLevelApplication.TambahFilter(f,'sumber = "KW"');
					if(dttglKW1.text!="" && dttglKW2.text!=""){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'kwtgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglKW1.text)+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglKW2.text)+'"');
					}
					else if(dttglKW1.text != "") 
						f = parentApplication.TambahFilter(f, 'kwtgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglKW1.text)+'"'); 
					else if(dttglKW2.text != "")
						f = parentApplication.TambahFilter(f, 'kwtgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglKW2.text)+'"'); 
					
					if(txtfnotransaksiKW1.text!="" && txtfnotransaksiKW2.text!=""){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'kwnotransaksi Between "'+txtfnotransaksiKW1.text+'" and "'+txtfnotransaksiKW2.text+'"');
					}
					
					if(txturaian0.text!="" && txturaian0.text.length > 0){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'kwuraian LIKE "%'+txturaian0.text+'%"');
					}
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kwstatus <> 7 AND kwstatus <> 0 AND kwstatus <> 4');
					dg = dgKW;
				}
				return f;
			}
			
