				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
				
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled==true)
						var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(11,22,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Pb');
				}
				function f_mbReset():void{
					f_kondisiAwal(); 
					FlexGlobals.topLevelApplication.F_defaultGridItem(dgKW);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dgCOA);
					mb.menuBarItems[3].enabled =false;
					mb.menuBarItems[4].enabled =false;
				}
				function f_AmbilVPP():void {
					//if(txtcustomer.text.length > 0){
					FlexGlobals.topLevelApplication.F_popUpCari('AmbilKW');
					/* }else{
					Alert.show(parentApplication.l('Customer harap diisi terlebih dahulu'), parentApplication.l('Informasi'));
					} */
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[3].enabled==true)FlexGlobals.topLevelApplication.F_OpenNotes(o.pbsumber,o.pbid,txtnotransaksi.text);
				}
				function f_mbUpload():void{
					if(mb.menuBarItems[4].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('PB', o.pbid,txtnotransaksi.text);
				}
				function f_mbLinks():void{
					FlexGlobals.topLevelApplication.f_mbLinks(11, 'Pb');
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(11,22,[dgKW,dgCOA],'transaksi');
				f_validasi();
				
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
				}
				
				dttglbayar.addEventListener(mx.events.CalendarLayoutChangeEvent.CHANGE, f_dtChange);
				function f_dtChange():void
				{
					for(i=0;i<dgKW.dataProviderLength;i++)
						with(dgKW.dataProvider.getItemAt(i)){
							diskontermin = f_diskonTermin(dttgl.text, tgljatuhtempo, tgl, haridiskon1, haridiskon2, diskon1, diskon2);
							jmldiskontermin = jmlbayar*(diskontermin/100);
							jmldiskonterminvalas = jmlbayarvalas*(diskontermin/100);
						}
					
					
					FlexGlobals.topLevelApplication.F_dgRefresh(dgKW);
					f_hitungTotal();
					
				}
			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_PvHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M11_PvGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
