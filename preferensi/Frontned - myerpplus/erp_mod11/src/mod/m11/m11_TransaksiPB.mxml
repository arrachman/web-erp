				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttglnoref,dttglbayar,dttglKW1,dttglKW2]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtPetugas]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress]);
