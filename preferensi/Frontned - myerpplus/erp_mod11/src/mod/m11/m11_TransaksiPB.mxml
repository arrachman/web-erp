						// hitung total tiap tiap tab
						o.totaltransaksiKW += Number(dgKW.dataProvider[i].total);
					}
				}
				
				for(i = 0; i< dgCOA.dataProviderLength; i++){
					if((dgCOA.dataProvider[i].rekhutangpiutang != "" || dgCOA.dataProvider[i].rekhutangpiutang != null || dgCOA.dataProvider[i].rekhutangpiutang != undefined) && dgCOA.dataProvider[i].jmlbayar != undefined){
						// hitung total tiap tiap tab
						o.totaltransaksiCOA += Number(dgCOA.dataProvider[i].jmlbayar);
					}
				}
				
				//hitunggrandtotal
				o.grandtotal = o.totaltransaksiKW;
				
				//set label
				lbltotalAR.text = parentApplication.m.nfNominal.format(o.grandtotal);
				lbltotaltransaksiCOA1.text = parentApplication.F_formatNominal(o.totaltransaksiCOA);
				// set label tiap tiap tab
				/* lbltotaltransaksiKJ.text = parentApplication.F_formatNominal(o.totaltransaksiKJ);
				lbltotaltransaksiRP1.text = parentApplication.F_formatNominal(o.totaltransaksiLU);
				lbltotaltransaksiIP1.text = parentApplication.F_formatNominal(o.totaltransaksiAK);
				lbltotaltransaksiAS1.text = parentApplication.F_formatNominal(o.totaltransaksiLB); */
			}
			
			protected function f_dinamikValueGrid(dg:DataGrid, rowIndex:int):void{
				with(dg.dataProvider.getItemAt(rowIndex)){
					if(vUang == txtmatauang.text)
						jmlbayarvalas = 0;
					else jmlbayarvalas = jmlbayar/h.getItemAt(0).kurs;
					diskontermin = f_diskonTermin(dttgl.text, tgljatuhtempo, tgl, haridiskon1, haridiskon2, diskon1, diskon2);
					jmldiskontermin = jmlbayar*(diskontermin/100);
					jmldiskonterminvalas = jmlbayarvalas*(diskontermin/100); 
				}
			}
			
			protected function f_diskonTermin(tglutama:String, tglgiro:String, tgl:String, haridiskon1:int, haridiskon2:int, diskon1:int, diskon2:int):int
			{
				var tglselisih:int, i:int;
				if(tglutama == '')
					return 0;
				if(tglgiro == '')tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglutama, tgl)
				else tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglutama, tglgiro);
				if(tglselisih <= haridiskon1)
					return diskon1;
				else if(tglselisih <= haridiskon2)
					return diskon2;
				else return 0;
			}
			
			
			protected function dvd_dividerPressHandler(event:DividerEvent):void
			{
				if(tab.selectedIndex == 0){
					if(boxfilter1.height < 5){
						lbl1.text = 'Sembunyikan Filter';
						btnexpand.visible = false;
						btncollapse.visible = true;
					}else{
						lbl1.text = 'Tampilkan Filter';
						btnexpand.visible = true;
						btncollapse.visible = false;
					}
				}
			}
			
