			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var mnid:int, dg:DataGrid;
				if(tab.selectedIndex == 0){mnid = 50; dg = dgKW}
				
				
				switch (components){
					case 'checkBoxHeader':
						if(dg == dgKW){
							if(data == true){
								if(dg.dataProvider.getItemAt(0).nokuitansi != "" && dg.dataProvider.getItemAt(0).nokuitansi != null
									&& dg.dataProvider.getItemAt(0).nokuitansi != undefined && dg.dataProviderLength > 0){
									Alert.show("Kuitansi tidak boleh dipilih lebih dari 1");
									statusCek = 0;
									for (i=0; i<dg.dataProviderLength; i++){
										dg.dataProvider.getItemAt(i).chk = false;
									}
								}
							}
							else{
								statusCek = 0;
								for (i=0; i<dg.dataProviderLength; i++){
									dg.dataProvider.getItemAt(i).chk = data;
								}
							}
						}
						else{
							for (i=0; i<dg.dataProviderLength; i++){
								dg.dataProvider.getItemAt(i).chk = data;
								
							}
						}
						break;
					
					case 'checkBox':
						if(dg == dgKW){
							if(data == true){
								//Alert.show(statusCek.toString());
								if(statusCek == 0){
									dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
									if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kontak == 0)
										o.pvcustomer = FlexGlobals.topLevelApplication.getSetting(11,'company','Customer');
									else
										o.pvcustomer = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kontak;
									o.pvidic = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idic;	
									statusCek = 1;
								}
								else if(statusCek == 1){
									Alert.show("Kuitansi tidak boleh dipilih lebih dari 1");
									dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = false;
								}
							}
							else{
								statusCek = 0;
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
								o.pvcustomer = 0;
								o.pvidic = 0;
							}								
						}
						/* else{
						if(data == true)o.pvcustomer = FlexGlobals.topLevelApplication.getSetting(11,'company','Customer');
						else o.pvcustomer = 0;
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						} */
						break;
					case 'link':
						FlexGlobals.topLevelApplication.openForm(11, mnid, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idtransaksi);
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
