			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(5,14,jenissimpan)==true){
								f_simpan();
							}
						}
						break;
				}
			}	
			
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array; 
				var dgrid:Object;
				switch(column){
					case 'jmlbayar':
						dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)
						if(dgrid.matauang != ''){
							if(dgrid.matauang == UFungsional){
								dgrid.jmlbayarvalas = 0 ;
							}
							else{
								dgrid.jmlbayarvalas = Number(dgrid.jmlbayar) / Number(dgrid.kurs);
							}
							
							
							
							dgrid.diskontermin = f_diskonTermin(dttgl.text, dgrid.tgljatuhtempo, dgrid.tgl, dgrid.haridiskon1, dgrid.haridiskon2, dgrid.diskon1, dgrid.diskon2);
							dgrid.jmldiskontermin = dgrid.jmlbayar*(dgrid.diskontermin/100);
							dgrid.jmldiskonterminvalas = dgrid.jmlbayarvalas*(dgrid.diskontermin/100);
							f_hitungTotal();
						}
						break;
					case 'jmlbayarvalas':
						dgrid = dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)
						if(dgrid.matauang != ''){
							if(dgrid.matauang != UFungsional){
								dgrid.jmlbayar = dgrid.jmlbayarvalas *  Number(dgrid.kurs);
							}else{
								dgrid.jmlbayarvalas = 0
								dgrid.jmlbayar = Number(dgrid.totaltransaksi) - Number(dgrid.terbayar)
							}
							
							dgrid.diskontermin = f_diskonTermin(dttgl.text, '', dgrid.tgl, dgrid.haridiskon1, dgrid.haridiskon2, dgrid.diskon1, dgrid.diskon2);
							dgrid.jmldiskontermin = dgrid.jmlbayar*(dgrid.diskontermin/100);
							dgrid.jmldiskonterminvalas = dgrid.jmlbayarvalas*(dgrid.diskontermin/100);
							f_hitungTotal();
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var dg:DataGrid
				if(tab.selectedIndex ==0 ){dg = dgKW}
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = "kaidkontak ="+o.pvcustomer+" AND kakodekontak ='"+txtkontakperson.text+"'";
						csfilter = "kaidkontak ="+o.pvcustomer+"";
						csfield = 2;
						break;			
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = "tnaktif=1 AND tnsumber='PB'";
						csfield = 2;
						break;
					case 'txtPetugas':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkategori = "K" AND kkode = "'+txtPetugas.text.split('"').join('\\"')+'"';
						csfilter = 'kaktif = 1 AND kkategori = "K"';
						sort = 'kkode asc';
						break;
					case 'txtbagpenagihan':
						paket = 'CdM1_Contact';
						wsfilter = "kaktif='1' and kkategori='K' and kkode ='"+txtbagpenagihan.text+"'";
						csfilter = "kaktif='1' and kkategori='K'";
						csfield = 2;
						break;
					case 'txtbagterima':
						paket = 'CdM1_Contact';
						wsfilter = "kaktif='1' and kkategori='K' and kkode ='"+txtbagterima.text+"'";
						csfilter = "kaktif='1' and kkategori='K'";
						csfield = 2;
						break;
					case 'nogiro':
						paket = 'CdM2_Giro_List';
						wsfilter = "glnogiro = '"+dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].nogiro+"'";
						csfilter = '';
						csfield = 2;
						break;
					case 'rekhutangpiutang':
						paket = 'CdM1_Coa';
						wsfilter = "caktif=1 AND cgd = 'D' AND cnomor ='"+dgCOA.dataProvider[dgCOA.selectedCell.rowIndex].rekhutangpiutang+"'";
						csfilter = "caktif=1 AND cgd = 'D'"
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = "tndaktif=1 AND tndsumber='PB'";
						break;
					case 'lbldiskontermin':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'lblselisihkurs':
						paket = 'CdM1_Coa';
						csfilter = 'caktif=1 AND cgd = "D"';
						sort = 'cnomor asc';
						break;
					case 'AmbilKW':
						paket = 'CdM11_Kw';
						csfilter = "kwstatuspb <> 2 AND (kwstatus = 2 OR kwstatus = 3)";
						sort = 'kwtgl desc, kwnotransaksi desc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
