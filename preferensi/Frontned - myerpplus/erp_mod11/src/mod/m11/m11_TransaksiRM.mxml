			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String = '', kondisi:String = '';
				//if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtNoPasien':
						paket = 'CdM1_Patient';
						wsfilter = '(paktif = 1) AND pkode ="'+txtNoPasien.text.split('"').join('\\"')+'"';
						csfilter = '(paktif = 1)'; 
						csfield = 2;
						sort = 'pkode desc';
						kondisi = "tombol";
						//Alert.show(kondisi)
						break;
					case 'txtRujukan':
						paket = 'CdM1_Reference';
						wsfilter = 'raktif = 1 AND rjenis = 1 AND rkode = "'+txtRujukan.text.split('"').join('\\"')+'"';
						csfilter = 'raktif = 1 AND rjenis = 1';
						csfield = 2;
						sort = 'rkode asc';
						break;
					case 'txtPetugas':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkategori = "K" AND kkode = "'+txtPetugas.text.split('"').join('\\"')+'"';
						csfilter = 'kaktif = 1 AND kkategori = "K"';
						sort = 'kkode asc';
						break;
					case 'txtLayanan':
						paket = 'CdM1_Layanan';
						wsfilter = '(laktif = 1) AND lkode = "'+txtLayanan.text.split('"').join('\\"')+'"';
						csfilter = '(laktif = 1)';
						csfield = 2;
						sort = 'lkode asc';
						break;
					case 'txtKecelakaan':
						paket = 'CdM1_Accident';
						wsfilter = '(aaktif = 1) AND akode = "'+txtKecelakaan.text.split('"').join('\\"')+'"';
						csfilter = '(aaktif = 1)';
						csfield = 2;
						sort = 'akode asc';
						break;
					case 'txtICD':
						paket = 'CdM1_Icd';
						wsfilter = '(iaktif = 1) AND ikode = "'+txtICD.text.split('"').join('\\"')+'"';
						csfilter = '(iaktif = 1)';
						csfield = 2;
						sort = 'ikode asc';
						break;
					case 'txtICD10':
						paket = 'CdM1_Icd';
						wsfilter = '(iaktif = 1) AND ikode = "'+txtICD10.text.split('"').join('\\"')+'"';
						csfilter = '(iaktif = 1)';
						csfield = 2;
						sort = 'ikode asc';
						break;
					case 'txtTindakanRM':
						paket = 'CdM1_Trm';
						wsfilter = '(trmaktif = 1) AND trmkode = "'+txtTindakanRM.text.split('"').join('\\"')+'"';
						csfilter = '(trmaktif = 1)';
						csfield = 2;
						sort = 'trmkode asc';
						break;
					case 'txtKategoriPasien':
						paket = 'CdM1_Patient_Category';
						wsfilter = '(pcaktif = 1) AND pckode ="'+txtKategoriPasien.text.split('"').join('\\"')+'"';
						csfilter = '(pcaktif = 1)';
						csfield = 2;
						sort = 'pckode asc';
						break;
					case 'txtDokter':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkategori = "D" AND kkode = "'+txtDokter.text.split('"').join('\\"')+'"';
						csfilter = 'kaktif = 1 AND kkategori = "D"';
						sort = 'kkode asc';
						break;
					case 'txtKunjungan':
						paket = 'CdM11_Kj';
						wsfilter = '(kjstatus = 4 OR kjstatus = 3) AND kjnotransaksi ="'+txtKunjungan.text.split('"').join('\\"')+'"';
						csfilter = '(kjstatus = 4 OR kjstatus = 3)';
						csfield = 2;
						sort = 'kjinputtgl desc';
						
						/* paket = 'CdM11_Kj';
						wsfilter = '(kjstatus = 2 OR kjstatus = 3) AND kjnotransaksi ="'+txtkunjungan.text.split('"').join('\\"')+'"';
						csfilter = '(kjstatus = 2 OR kjstatus = 3)';
						csfield = 2;
						sort = 'kjinputtgl desc'; */
						break;
					case 'txtDiagnosa':
						if(cmbPerawatan.textInput.text != ""){
							if(cmbPerawatan.selectedIndex == 0){
								paket = 'CdM1_Diagnosis';
								wsfilter = '(daktif = 1) AND dkategori = "RI" AND dkode ="'+txtDiagnosa.text.split('"').join('\\"')+'"';
								csfilter = '(daktif = 1) AND dkategori = "RI"';
								csfield = 2;
								sort = 'dkode asc';
							}
							else{
								paket = 'CdM1_Diagnosis';
								wsfilter = '(daktif = 1) AND dkategori = "RJ" AND dkode ="'+txtDiagnosa.text.split('"').join('\\"')+'"';
								csfilter = '(daktif = 1) AND dkategori = "RJ"';
								csfield = 2;
								sort = 'dkode asc';
							}
						}
						else{
							cmbPerawatan.setFocus();
							Alert.show("Perawatan harus ditentukan terlebih dahulu");
						}
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id, kondisi];
			}
			
