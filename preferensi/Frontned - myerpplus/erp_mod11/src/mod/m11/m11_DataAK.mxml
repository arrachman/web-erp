		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.TitleWindow;
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array, idkontak:int, iduser:String='', t:TitleWindow;
			private var p:Object; public var o:Object = {};
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			public function f_persiapan():void
			{
				p=parentApplication;
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(11, 6);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkatpasien, tsupplier, ttanggal, tnotransaksi, tnokj, tstatus, turaian, tjenislaporan, tcatatan, tinputuser, tcabang, tlokasi]);
				// module, menu transaksi, menu, sumber, approvell
				a = [11, 6, 12, 'Ak', false];
				p.F_persiapanFormData(this);
				// Daftarkan fungsi-fungsi text input
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbjenislaporan,cmbstatus]);
				p.F_txtpencarian([txtlokasi, txtcabang, txtuser]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtkatpasien]);
				p.F_SetNavigasiKeyboard([txtNamaPasien, txtNoResep, txtnotransaksi1, txtnotransaksi2, txtnotransaksikj1, txtnotransaksikj2, txturaian,txtcatatan]);
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				txtnotransaksi2.addEventListener(FocusEvent.FOCUS_IN, f_change);
				function f_change():void{
					if(txtnotransaksi2.text == ''){
						txtnotransaksi2.text = txtnotransaksi1.text;	
					}
				}
				txtnotransaksikj2.addEventListener(FocusEvent.FOCUS_IN, f_changekj);
				function f_changekj():void{
					if(txtnotransaksikj2.text == ''){
						txtnotransaksikj2.text = txtnotransaksikj1.text;	
					}
				}
				dttgl2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				function f_firstCLICK():void
				{
					p.f_refreshIDmodule(dg);
					if(imgfirst.enabled)
						f_Tampilkan(1);
				}
				
				function f_previousCLICK():void
				{
					p.f_refreshIDmodule(dg)
					if(imgprevious.enabled)
						f_Tampilkan(int(txtpaging.text)-1);
				}
				
				function f_nextCLICK():void
				{
					p.f_refreshIDmodule(dg)
					if(imgnext.enabled)
						f_Tampilkan(int(txtpaging.text)+1);
				}
				
				function f_lastCLICK():void
				{
					p.f_refreshIDmodule(dg)
					if(imglast.enabled)
						f_Tampilkan(int(-1));
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					p.f_refreshIDmodule(dg)
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_Tampilkan(int(txtpaging.text));
				}
				f_kondisiAwal();
			}
			
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				txtcabang.text = parentApplication.ucabang;
				p.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				p.F_KosongkanText([txtkatpasien,txtnotransaksi1,txtnotransaksi2,txtnotransaksikj1,txtnotransaksikj2,txtsupplier,txturaian,txtuser,txturaian,txtcatatan]);
				o.user = txtuser.text;
				dg.dataProvider.removeAll();
				cmbstatus.dataProvider = new ArrayCollection([{l:'Semua', v:-1}, {l:'Aktif', v:15}, {l:'Draft', v:0}, {l:'Need Approval', v:1}, {l:'Approved', v:2}, {l:'In Progress', v:3}, {l:'Complete', v:4}, {l:'Close', v:7}]);
				cmbstatus.selectedIndex = o.DefaultStatus;
			}
			
			public function f_Tampilkan(page:int=1):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("TampilkanData","M11_AkSearch",page,20,f_filterdata());
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				if(parentApplication.apaBisaAkses(a[0], a[2], 4)){
					FlexGlobals.topLevelApplication.openForm(a[0], a[1], dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[a[3].toLowerCase()+'id']);
				}
				//FlexGlobals.topLevelApplication.openForm(11,6, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).akid);
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtsupplier':
						paket = 'CdM1_Contact';
						csfilter = "kaktif=1 and kkategori ='S'";
						wsfilter = "kaktif=1 and kkategori ='S' AND kkode ='"+ txtsupplier.text+"'";
						csfield = 2;
						break;
					//					case 'txtgudang':
					//						paket = 'CdM1_Warehouse';
					//						wsfilter = "wkode ='"+txtgudang.text+"'";
					//						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = "laktif=1";
						wsfilter = "laktif=1 AND lkode ='"+txtlokasi.text+"'";
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = "baktif=1";
						wsfilter = "baktif=1 AND bkode ='"+txtcabang.text+"'";
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = "uaktif=1";
						wsfilter = "uaktif=1 ANd ukode ='"+txtuser.text+"'";
						break;
					case 'txtkatpasien':
						paket = 'CdM1_Patient_Category';
						wsfilter = '(pcaktif = 1) AND pckode ="'+txtkatpasien.text.split('"').join('\\"')+'"';
						csfilter = '(pcaktif = 1)';
						csfield = 2;
						sort = 'pckode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(p.wsSuccess == true){
					//if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
					switch(s){
						case 'TampilkanData':
							for(i=0;i<p.wsArrUtama.length;i++) 
								if(p.wsArrUtama[i]["akmodifikasiusernama"] == "")
									p.wsArrUtama[i]["akmodifikasitgl"] = ""
							dg.dataProvider = p.wsArrUtama; 
							dg.setSelectedCell(0,0);
							FlexGlobals.topLevelApplication.rowIndex = 0;
							imgfirst.enabled = p.wsIsPrev;
							imgprevious.enabled = p.wsIsPrev;
							imgnext.enabled = p.wsIsNext;
							imglast.enabled = p.wsIsNext;
							txtpaging.text = p.wsCurPage;
							for(i=0;i<dg.dataProviderLength;i++)
								dg.dataProvider[i].no = (((p.wsCurPage-1)*20)+(i+1));
							p.F_dgRefresh(dg);
							dg.setFocus();
							dg.setSelectedCell(0,0);
							lbltotal.text = parentApplication.m.nfNominal.format(p.wsArrUtama.getItemAt(0).aktotalsum);
							//if(o.hasOwnProperty('f_grid_change'))o.f_grid_change();
							break;
						case 'txtsupplier':
							if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
							txtsupplier.text = ws.kkode;
							idkontak = ws.kid;
							break;
						case 'txtlokasi':
							if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
							txtlokasi.text = ws.lkode;
							break;
						case 'txtcabang':
							if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
							txtcabang.text = ws.bkode;
							break;
						case 'txtuser':
							if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
							txtuser.text = ws.ukode;
							iduser = ws.userid;
							break;
						case 'txtkatpasien':
							if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
							txtkatpasien.text = ws.pckode;
							break;
						
						//						case 'txtgudang':
						//							txtgudang.text = ws.wkode;
						//							break;
					}
				}else{
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'TampilkanData':
								dg.dataProvider.removeAll();
								lbltotal.text = "0,00";
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtsupplier':p.F_KosongkanText([txtsupplier]);break;
					case 'txtlokasi':p.F_KosongkanText([txtlokasi]);break;
					case 'txtcabang':p.F_KosongkanText([txtcabang]);break;
					case 'txtuser':p.F_KosongkanText([txtuser]);break;
					case 'txtkatpasien':p.F_KosongkanText([txtkatpasien]);break;
				}
			}
			
			public function f_grid_change():void
			{
				lbltotal.text = parentApplication.m.nfNominal.format(p.wsArrUtama.getItemAt(0).aktotalsum);
			}
			
			public function f_filterdata():String{
				var f:String="";
				f = FlexGlobals.topLevelApplication.F_standartFilter();
				
				if(txtnotransaksikj1.text != '' && txtnotransaksikj2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'aknotransaksikj BETWEEN "'+txtnotransaksikj1.text+'" AND "'+txtnotransaksikj2.text+'"');
				//				if(txtgudang.text != '')
				//					f = FlexGlobals.topLevelApplication.TambahFilter(f,'lugudang = "'+txtcabang.text.split("'").join("\\'")+'"');
				if(txtuser.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'akinputuser = "'+iduser+'"');
				if(txtsupplier.text!='' && txtterimadari2.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'aksupplier = '+idkontak+'');
				if(txtNamaPasien.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pnama LIKE "%'+txtNamaPasien.text+'%"');
				if(txtNoResep.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'aknoref LIKE "%'+txtNoResep.text+'%"');
				if(txtkatpasien.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'akkategoripasien LIKE "%'+txtkatpasien.text+'%"');
				return f;
			}
			
			public function f_hitungTotal():void{}
