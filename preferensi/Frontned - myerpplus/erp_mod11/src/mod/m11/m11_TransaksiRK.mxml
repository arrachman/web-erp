				o.idrkcarabayar = 0; o.rkid = 0; o.rkcabang = FlexGlobals.topLevelApplication.ucabang; o.rklokasi = FlexGlobals.topLevelApplication.ulokasi; o.rksumber="RK"; 
				o.rkkodepa = 0; o.rkkontak = 0; o.rkalamat = txaalamatrekanan.text; o.rktgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal;
				o.rkjumlah = 0; o.rkjumlahvalas = 0; o.rkjumlahbayar = 0; o.rkjumlahbayarvalas = 0; o.rkstatusbayar = 0; o.rktgllunas = parentApplication.m.DateFirst; 
				o.rkstatussebelumnya = 0; o.rkjmlrevisi = 0; o.rkcetakanke = 0; 
				o.rkinputuser = FlexGlobals.topLevelApplication.userid; o.rkinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.rkmodifikasiuser = 0; o.rkmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.rkisclose = 0; o.rkcustomtext1 = ''; 
				o.rkcustomtext2 = ''; o.rkcustomtext3 = ''; o.rkcustomtext4 = ''; o.rkcustomtext5  = '';
				o.rkcustomint1 = 0; o.rkcustomint2 = 0; o.rkcustomint3 = 0; 
				o.rkcustomdbl1 = 0; o.rkcustomdbl2 = 0; o.rkcustomdbl3 = 0; 
				o.rkcustomdate1 = parentApplication.m.DateFirst; o.rkcustomdate2 = parentApplication.m.DateFirst; 
				o.rkcustomdate3 = parentApplication.m.DateFirst; o.rkidkj = 0; o.rkjenistransaksi = 0;
				o.rkbagianterima = FlexGlobals.topLevelApplication.ukontak; o.rkperawatan = ''; o.rkkategoripasien = ''; o.rkkamar = ''; o.rkawalankatpasien = ''; o.rkkategori=0;
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				//setting no transaksi
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoNoTransaction')==0){
					if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction')==1){
						chkauto.selected = true;
						txtnotransaksi.text = 'Auto';	
						txtnotransaksi.enabled = false;
					}else{
						chkauto.selected = false;
						txtnotransaksi.text = '';	
						txtnotransaksi.enabled = true;
					}
				}else{
					chkauto.selected = true;
					chkauto.enabled = false;
					txtnotransaksi.text = 'Auto';	
					txtnotransaksi.enabled = false;
				}
				
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.o = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					o.o.jumlah = 0;
					o.o.jumlahvalas = 0;
					return
				}
				switch(column){
					case 'jumlah':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) / o.txtkurs;
								
							}else{
								jumlahvalas = 0;
							}
						}
						
						break;
					case 'jumlahvalas':
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
						}
						break;
					case 'bank':
					case 'nogiro':
					case 'noacbank':
						editable();
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungvalas()
				f_hitungTotal()
				
			}
			
			public function editable():void{
				if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==0 || dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==3){
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).noacbank = '';
				}
					
				else {
					if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar == 1){
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
						
					}
				}
			}
			
