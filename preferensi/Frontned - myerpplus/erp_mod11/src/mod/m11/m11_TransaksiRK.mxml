			protected function cmbPerawatan_changeHandler(event:IndexChangeEvent):void
			{
				lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
			}
			
			protected function cmbJenisTransaksi_changeHandler(event:IndexChangeEvent):void
			{
				if(cmbJenisTransaksi.selectedIndex == 0){
					txtKunjungan.enabled = true;
					cmbPerawatan.selectedIndex = 0;
					cmbPerawatan.enabled = false;
					lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
				}
				else{
					txtKunjungan.enabled = false;
					cmbPerawatan.selectedIndex = 1;
					cmbPerawatan.enabled = false;
					lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
				}
			}
			
		]]>
