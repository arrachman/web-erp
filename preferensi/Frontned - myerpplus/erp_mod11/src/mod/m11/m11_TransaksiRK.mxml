			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						if(Number(data) > 0){
							if(txtmatauang.text == UFungsional){
								if(dataField == 'jumlahvalas'){
									Alert.show(parentApplication.l('Jumlah Valas harus 0 karena mata uang fungsional'), parentApplication.l('Informasi'));
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = 0;
								}
								
							}else{
								if(dataField == 'jumlahvalas'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas * o.txtkurs;
									
								}
								if(dataField == 'jumlah'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = dg.dataProvider[dg.selectedCell.rowIndex].jumlah / o.txtkurs;
								}
							}
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			public function f_focusOnMe():void
			{
				cmbKatRekanan.setFocus();
			}
			
			protected function f_persiapan():void
			{
				ft= FlexGlobals.topLevelApplication.F_tglFormatDB;
				hf=FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				tab.focusEnabled = false;
				fu=FlexGlobals.topLevelApplication.m.nfNominal.format;
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				FlexGlobals.topLevelApplication.F_TranslateLabel([lblKatRekanan,lblkunjungan, tcustomer, takun, ttanggal, tnotransaksi, tmatauang, tkurs, tprogress, tkontakperson, ttermin, tbagianterima, talamatsupplier, tcostcenter, tdivisi, tsubdivisi, tproyek, lblKamar, lblPerawatan, lblKategoriPasien]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([lblKatRekanan, lblkunjungan, tcustomer, takun, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs, lblKategoriPasien, lblPerawatan]);
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttanggalnoref]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbKatRekanan,cmbprogress,cmbPerawatan, cmbJenisTransaksi]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtKunjungan,txtRekanan,txtakun,txtmatauang,txttermin,txtbagianterima,txtcostcenter,txtdivisi,txtsubdivisi,txtproyek,txtKategoriPasien,txtKamar]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,txtnoref,chkauto,chkposting]);
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"false"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
				function f_mbSimpan():void{
					f_delundefined(dg);
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(11,20,jenissimpan)==true){
						f_simpan();
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Rk');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.FormFilter = '';
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal();
//					FlexGlobals.topLevelApplication.f_reloadReset();
				}
				function f_mbCatatan():void{
					if (mb.menuBarItems[3].enabled==true){FlexGlobals.topLevelApplication.F_OpenNotes(o.rksumber,o.rkid,txtnotransaksi.text);}
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('RK', o.rkid,txtnotransaksi.text);
				}
				function f_mbLinks():void
				{
					FlexGlobals.topLevelApplication.f_mbLinks(11, 'Rk');
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(11,20,[dg],'transaksi');
				f_validasi();
				
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.S:if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(11,20,jenissimpan)==true){
								f_simpan();
							}
						}
							break;
					}
				}
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN, function keydown(e:KeyboardEvent):void{
					if(e.keyCode == Keyboard.ENTER || e.keyCode == Keyboard.DOWN){
						dg.setSelectedCell(0,1)
					}
				});
				
			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_AsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M11_RkGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
