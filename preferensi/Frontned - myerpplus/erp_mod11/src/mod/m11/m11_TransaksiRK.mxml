					with (v_dg.dataProvider.getItemAt(i)){
						if (dg.dataProvider.getItemAt(i)['catatan']==undefined){dg.dataProvider.getItemAt(i)['catatan']=''}
						if (dg.dataProvider.getItemAt(i)['bank']==undefined){dg.dataProvider.getItemAt(i)['bank']=''}
						if (dg.dataProvider.getItemAt(i)['rekgiro']==undefined){dg.dataProvider.getItemAt(i)['rekgiro']=''}
						if (dg.dataProvider.getItemAt(i)['noacbank']==undefined){dg.dataProvider.getItemAt(i)['noacbank']=''}
						if (dg.dataProvider.getItemAt(i)['rekbanknama']==undefined){dg.dataProvider.getItemAt(i)['rekbanknama']=''}
					}
				}
			}
			private function f_progress():int{
				if (cmbprogress.selectedIndex==1){
					return 2;
				}else{return 0;}
				return 2;
			}
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				o.txtkurs = 1;
				var a:Array, utama:String, detail:String = '', tgl:String;
				FlexGlobals.topLevelApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){
						//u.refresh();
						// Set Utama
						with(o){
							a = [rkid, rkcabang, rklokasi, rksumber, int(chkauto.selected), txtnotransaksi.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), rkkodepa, rkkontak, txtkontakperson.text, rkalamat,
								rkbagianterima, txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(rktgljatuhtempo),
								txtakun.text, txturaian.text, txtcatatan.text, txtnoref.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttanggalnoref.text), txtmatauang.text, 1, 
								rkjumlah, rkjumlahvalas, rkjumlahbayar, rkjumlahbayarvalas, rkstatusbayar, FlexGlobals.topLevelApplication.F_tglFormatDB(rktgllunas), txtcostcenter.text, 
								txtdivisi.text, txtsubdivisi.text, txtproyek.text, cmbprogress.selectedItem.v, rkstatussebelumnya, rkjmlrevisi, rkcetakanke, 
								rkinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(rkinputtgl), rkmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(rkmodifikasitgl), int(chkposting.selected), rkisclose, rkcustomtext1, 
								rkcustomtext2, rkcustomtext3, rkcustomtext4, rkcustomtext5, rkcustomint1, rkcustomint2, rkcustomint3, 
								rkcustomdbl1, rkcustomdbl2, rkcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(rkcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(rkcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(rkcustomdate3),rkidkj,
								cmbPerawatan.textInput.text, txtKategoriPasien.text, txtKamar.text, rkawalankatpasien, cmbKatRekanan.selectedIndex, cmbJenisTransaksi.selectedIndex];
							utama = f_splitArrayToString(a);
						}
						// Set Detailb
						for(var c:int=0; c<dg.dataProviderLength; c++){
							with(dg.dataProvider.getItemAt(c)){
								a = [idrkcarabayar, idrk, carabayar, matauang, parentApplication.F_hapusFormatCurrency(txtkurs.text), jumlah, jumlahvalas, 
									nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, noacbank, rekbank, rekgiro, catatan, 
									c+1, isclose];
								if(detail == '')detail =f_splitArrayToString(a);
								else detail += "▲"+f_splitArrayToString(a);
							}
						}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M11_RkSimpan", FlexGlobals.topLevelApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = '';
					parentApplication.F_hapusBarisKosongGrid(dg);
					if(txttermin.text.length == 0){o.rktgljatuhtempo = dttgl.text;}
					if(cmbKatRekanan.textInput.text.length == 0)parentApplication.msgAlert(cmbKatRekanan,'Kategori Rekanan');
					if(txtKunjungan.text.length <= 0 && cmbJenisTransaksi.selectedIndex == 0)parentApplication.msgAlert(txtKunjungan,'Kunjungan');
					if(cmbPerawatan.textInput.text.length == 0)parentApplication.msgAlert(cmbPerawatan,'Perawatan');
					if(txtKategoriPasien.text.length == 0)parentApplication.msgAlert(txtKategoriPasien,'Kategori Pasien');
					if(txtRekanan.text.length <= 0)parentApplication.msgAlert(txtRekanan,'Rekanan');
					if(txtakun.text.length <= 0)parentApplication.msgAlert(txtakun,'Akun');
					if(txtmatauang.text.length <= 0)parentApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)parentApplication.msgAlert(txtkurs,'Kurs');
					//if(txtcatatan.text.length <= 0)parentApplication.msgAlert(txtcatatan,'Catatan');
					if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)parentApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)parentApplication.msgAlert(cmbprogress,'Progress');
					if(dg.dataProvider.getItemAt(0).rekbank == null  || dg.dataProvider.getItemAt(0).rekbank == '')parentApplication.msgAlert(dg,'Detail Item');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');	
					if(txttermin.text.length == 0){
						o.rktgljatuhtempo = dttgl.text;
					}
					f_hitungTotal();
					f_hitungvalas();
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			private var vtotal:Number=0,vvalas:Number=0;
			public function f_hitungTotal():void
			{
				o.rkjumlah=0;  o.rkjumlahvalas=0;
				for(var i:int=0;i<dg.dataProvider.length;i++){
					o.rkjumlah += Number(dg.dataProvider.getItemAt(i).jumlah)
					o.rkjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas)
				}
				lbltotal.text = fu(o.rkjumlah);
				lbltotalvalas.text =fu(o.rkjumlahvalas);
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = dg.dataProvider.getItemAt(i).jumlah/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = 0; 
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}
			}
			protected function chkauto_clickHandler(event:MouseEvent):void
			{
				if (chkauto.selected==true)txtnotransaksi.enabled=false;
				else txtnotransaksi.enabled=true;
			}
			
