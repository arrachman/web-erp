				parentApplication.F_KosongkanText([lblNamaKunjungan,txtKunjungan, txtRekanan, lblcustomer,txtkontakperson,txtnoref,txaalamatrekanan,txtcostcenter,txtdivisi,txtsubdivisi,txttermin,txtproyek,txtKategoriPasien,lblNamaKatPasien,txtKamar,lblNamaKamar]);
				txtbagianterima.text = FlexGlobals.topLevelApplication.ukontakkode;
