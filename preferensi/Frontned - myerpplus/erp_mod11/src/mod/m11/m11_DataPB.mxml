	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.FlexTextField;
			import mx.events.FlexEvent;
			
			import spark.components.TitleWindow;
			import spark.events.IndexChangeEvent;
			import spark.events.TextOperationEvent;
			public var arr:Array, arrColumn:Array;
			public var a:Array = new Array;
			private var p:Object,v_userid:int=0;
			public var vfileextention:int=0, t:TitleWindow;
			public var o:Object = {}, idkontak:String='', iduser:String='';
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			public function f_persiapan():void
			{
				p=parentApplication;
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(11, 22);
				
				// module, menu transaksi, menu, sumber, approvell, Sort, Group
				a = [11, 22, 23, 'Pv', false];
				FlexGlobals.topLevelApplication.F_persiapanFormData(this);
				// Daftarkan fungsi-fungsi text input
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbjenislaporan,cmbstatus]);
				p.F_txtpencarian([txtcustomer,txtlokasi, txtcabang, txtuser, txtuang]);
				p.F_SetNavigasiKeyboard([txtnorm, txtnama, txtnotransaksi1, txtnotransaksi2, txturaian,txtcatatan]);
				f_kondisiAwal();
			}
			
			public function f_var(s:String):String
			{
				switch(s){
					case 'paramFormTransaksi':
						return dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pvid;
						break;
					case 'id':
						return dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pvid;
						break;
					case 'status':
						return dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pvstatus;
						break;
					case 'statusSebelumnya':
						return dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pvstatussebelumnya;
						break;
					case 'notransaksi':
						return dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pvnotransaksi;
						break;
					default:
						return '';
				}
			}
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				txtuser.text = p.userid;
				txtlokasi.text = parentApplication.ulokasi;
				txtcabang.text = parentApplication.ucabang;
				p.F_SetNilaiText([dttgl1, dttgl2], p.DefaultTanggal);
				cmbstatus.selectedIndex = o.DefaultStatus;
				p.F_KosongkanText([txtnorm, txtnama, txtnotransaksi1,txtcustomer,txturaian,txtuser,txturaian,txtcatatan,txtuang]);
				dg.dataProvider.removeAll();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtcustomer':
						paket = 'CdM1_Patient';
						csfilter = "paktif=1";
						wsfilter = "paktif=1 AND pkode ='"+ txtcustomer.text+"'";
						csfield = 2;
						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = "laktif=1";
						wsfilter = "laktif=1 AND lkode ='"+txtlokasi.text+"'";
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = "baktif=1";
						wsfilter = "baktif=1 AND bkode ='"+txtcabang.text+"'";
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = "uaktif=1";
						wsfilter = 'uaktif=1 AND ukode ="'+txtuser.text.split('"').join('\\"')+'"';
						break;
					case 'txtuang':
						paket = 'CdM1_Currency';
						csfilter = "caktif=1";
						wsfilter = "caktif=1 AND ckode ='"+txtuang.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = p.subject, i:int;
				if(p.wsSuccess == true){
					if(p.wsArrUtama.getItemAt.length >= 0)o = p.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtcustomer':
							txtcustomer.text = o.pkode;
							idkontak = o.pid;
							break; 
						case 'txtlokasi':
							txtlokasi.text = o.lkode;
							break;
						case 'txtcabang':
							txtcabang.text = o.bkode;
							break;
						case 'txtuser':
							txtuser.text = o.ukode;
							iduser = o.userid;
							break;
						case 'txtuang':
							txtuang.text = o.ckode;
							break;
					}
				}else{
					// 9.2 Result WS False		
					if(p.F_validasiFalse(s) == true)
						switch(s){
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcustomer':p.F_KosongkanText([txtcustomer]);break;
					case 'txtlokasi':p.F_KosongkanText([txtlokasi]);break;
					case 'txtcabang':p.F_KosongkanText([txtcabang]);break;
					case 'txtuser':p.F_KosongkanText([txtuser]);break;
					case 'txtuang':p.F_KosongkanText([txtuang]);break;
				}
			}
			private function f_cekdtkosong(arr1:Array,arr2:Array):void{
				for(var i:int=0;i<arr1.length;i++){
					if (arr1[i].text==''){if (arr2[i].text !=''){arr1[i].text=arr2[i].text;}}
					if (arr2[i].text==''){if (arr1[i].text !=''){arr2[i].text=arr1[i].text;}}
				}
			}
			public function f_filterdata():String{
				var f:String="";
				//sqtglpenutupan
				//f = parentApplication.F_standartFilter();
				
				 if(cmbstatus.textInput.text.length == 0){
					
				}else if(cmbstatus.textInput.text == 'Semua'){
					cmbstatus.selectedIndex = 0;
					//		if(o.a[4] == true)
					//			filter = TambahFilter(filter, "(case "+f+"inputuser WHEN "+userid+" THEN ("+f+"status = 0 OR "+f+"status = 2 OR "+f+"status = 3 OR "+f+"status = 4 OR "+f+"status = 5 OR "+f+"status = 6 OR "+f+"status = 7 OR "+f+"status = 8 OR "+f+"status = 9 OR "+f+"status = 10 OR "+f+"status = 11) else ("+f+"status = 2 OR "+f+"status = 3 OR "+f+"status = 4 OR "+f+"status = 5 OR "+f+"status = 6 OR "+f+"status = 7 OR "+f+"status = 8 OR "+f+"status = 9 OR "+f+"status = 10 OR "+f+"status = 11) end)");
					//		else
					//			filter = TambahFilter(filter, "(case "+f+"inputuser WHEN "+userid+" THEN ("+f+"status = 0 OR "+f+"status = 2 OR "+f+"status = 3 OR "+f+"status = 4 OR "+f+"status = 7) else ("+f+"status = 2 OR "+f+"status = 3 OR "+f+"status = 4 OR "+f+"status = 7) end)");
				}else if(cmbstatus.textInput.text == 'Aktif'){
					cmbstatus.selectedIndex = 1;
					f = p.TambahFilter(f,"pvstatus = 2 OR pvstatus = 3 OR pvstatus = 4 OR pvstatus = 7");
					//	else if(s == 'Draft')
					//		filter = TambahFilter(filter, ""+f+"status = 0 AND "+f+"inputuser = "+userid);
				}else
					f = p.TambahFilter(f,"pvstatus = "+cmbstatus.selectedItem.v);
				
				if(txtnotransaksi1.text != '' && txtnotransaksi2.text != '')
					f = p.TambahFilter(f,'pvnotransaksi BETWEEN "'+txtnotransaksi1.text+'" AND "'+txtnotransaksi2.text+'"');
				
				if(dttgl1.text != '' && dttgl2.text != '')
					f = p.TambahFilter(f,'pvtgl BETWEEN "'+p.F_tglFormatDB(dttgl1.text)+'" AND "'+p.F_tglFormatDB(dttgl2.text)+'"'); 
				else if(dttgl1.text != '') 
					f = p.TambahFilter(f,'pvtgl >= "'+p.F_tglFormatDB(dttgl1.text)+'"'); 
				else if(dttgl2.text != '')
					f = p.TambahFilter(f,'pvtgl <= "'+p.F_tglFormatDB(dttgl2.text)+'"'); 
				
				if(txtlokasi.text != '')
					f = p.TambahFilter(f,'pvlokasi LIKE "%'+txtlokasi.text+'%"');
				
				if(txturaian.text != '')
					f = p.TambahFilter(f,'pvuraian LIKE "%'+txturaian.text+'%"');
				
				if(txtcatatan.text != '')
					f = p.TambahFilter(f,'pvcatatan LIKE "%'+txtcatatan.text+'%"'); 
				
				if(txtcabang.text != '')
					f = p.TambahFilter(f,'pvcabang LIKE "%'+txtcabang.text+'%"');
				if(txtcustomer.text!='' && txtcustomer.text!='')
					f = p.TambahFilter(f,'pvcustomer = '+idkontak+'');
				if(txtuser.text!='')
					f = p.TambahFilter(f,'pvinputuser ='+iduser);
				if(txtuang.text!='')
					f = p.TambahFilter(f,'pvmatauang ="'+txtuang.text+'"');
				if(txtnorm.text != '')
					f = p.TambahFilter(f,'pvnorm LIKE "%'+txtnorm.text+'%"');
				if(txtnama.text != '')
					f = p.TambahFilter(f,'pvnama LIKE "%'+txtnama.text+'%"');
				return f;
			}
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				if(parentApplication.apaBisaAkses(a[0], a[2], 4)){
					FlexGlobals.topLevelApplication.openForm(a[0], a[1], dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[a[3].toLowerCase()+'id']);
				}
				//FlexGlobals.topLevelApplication.openForm(11, 22, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pvid);
				
			}
			public function f_hitungTotal():void{}
			public function f_cetak():void{
				var flt:String="";var srt:String="";var grp:String="";
				flt = f_filterdata();
				FlexGlobals.topLevelApplication.F_openReport(11,22,cmbjenislaporan.selectedItem.ritem,flt,cmbjenislaporan.selectedItem.rorderby,cmbjenislaporan.selectedItem.rgroupby,vfileextention);
			}
