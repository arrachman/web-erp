	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent; 
			
			import spark.components.TitleWindow;
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array, idkontak:int, iduser:String='', t:TitleWindow;
			private var p:Object; public var o:Object = {};
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			public function f_persiapan():void
			{
				p=parentApplication;
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(11, 45);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tsupplier, ttanggal, tnotransaksi, tstatus, turaian, tjenislaporan, tcatatan, tinputuser, tnopasien]);
				// module, menu transaksi, menu, sumber, approvell
				a = [11, 45, 46, 'Rm', false];
				p.F_persiapanFormData(this);
				// Daftarkan fungsi-fungsi text input
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbjenislaporan,cmbstatus]);
				p.F_txtpencarian([txtuser, txtlayanan, txtdiagnosa]);
				p.F_SetNavigasiKeyboard([txtnopasien, txtnama, txtnotransaksi1, txtnotransaksi2, txturaian,txtcatatan,txtnopasien]);
				txtnotransaksi2.addEventListener(FocusEvent.FOCUS_IN, f_change);
				function f_change():void{
					if(txtnotransaksi2.text == ''){
						txtnotransaksi2.text = txtnotransaksi1.text;	
					}
				}
				
				dttgl2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				f_kondisiAwal();
			}
			
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				p.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				p.F_KosongkanText([txtnama,txtnotransaksi1,txtnotransaksi2,txturaian,txtuser,txturaian,txtcatatan,txtnopasien, txtlayanan, txtdiagnosa]);
				o.user = txtuser.text;
				dg.dataProvider.removeAll();
				cmbstatus.dataProvider = new ArrayCollection([{l:'Semua', v:-1}, {l:'Aktif', v:15}, {l:'Draft', v:0}, {l:'Need Approval', v:1}, {l:'Approved', v:2}, {l:'In Progress', v:3}, {l:'Complete', v:4}, {l:'Close', v:7}]);
				cmbstatus.selectedIndex = o.DefaultStatus;
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				if(parentApplication.apaBisaAkses(a[0], a[2], 4)){
					FlexGlobals.topLevelApplication.openForm(a[0], a[1], dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[a[3].toLowerCase()+'id']);
				}
				//FlexGlobals.topLevelApplication.openForm(11, 45, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).rmid);
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					//					case 'txtgudang':
					//						paket = 'CdM1_Warehouse';
					//						wsfilter = "wkode ='"+txtgudang.text+"'";
					//		
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = "uaktif=1";
						wsfilter = "uaktif=1 ANd ukode ='"+txtuser.text+"'";
						break;
					case 'txtlayanan':
						paket = 'CdM1_Layanan';
						wsfilter = '(laktif = 1) AND lkode = "'+txtlayanan.text.split('"').join('\\"')+'"';
						csfilter = '(laktif = 1)';
						csfield = 2;
						sort = 'lkode asc';
						break;
					case 'txtdiagnosa':
						paket = 'CdM1_Icd';
						wsfilter = '(iaktif = 1) AND ikode = "'+txtdiagnosa.text.split('"').join('\\"')+'"';
						csfilter = '(iaktif = 1)';
						csfield = 2;
						sort = 'ikode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(p.wsSuccess == true){
					if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtuser':
							txtuser.text = ws.ukode;
							iduser = ws.userid;
							break;
						case 'txtlayanan':
							txtlayanan.text = ws.lkode;
							/* if((txtLayanan.text == "IMUNI") || (txtLayanan.text == "IM") || (txtLayanan.text == "IMU") || (txtLayanan.text == "IMUN") || (lblNamaLayanan.text == "IMUNISASI") || (lblNamaLayanan.text == "Imunisasi") || (lblNamaLayanan.text == "imunisasi")){
							cmbStatusImunisasi.enabled = true;
							}
							else cmbStatusImunisasi.enabled = false; */
							break;
						case 'txtdiagnosa':
							txtdiagnosa.text = ws.ikode;
							break;
						//						case 'txtgudang':
						//							txtgudang.text = ws.wkode;
						//							break;
					}
				}else{
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtuser':p.F_KosongkanText([txtuser]);break;
				}
			}
			
			public function f_filterdata():String{
				var f:String="";
				//f = FlexGlobals.topLevelApplication.F_standartFilter();
				//f = "(rmstatus = 2 OR rmstatus = 3 OR rmstatus = 4 OR rmstatus = 7)";
				if(dttgl1.text != '' && dttgl2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rmtgl BETWEEN "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'" AND "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
				else if(dttgl1.text != '') 
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rmtgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'"'); 
				else if(dttgl2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rmtgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
				if(txtuser.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rminputuser = "'+iduser+'"');
				if(txtnopasien.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rmnorm Like "%'+txtnopasien.text+'%"');
				if(txtnama.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rmnama LIKE "%'+txtnama.text+'%"');
				if(txtlayanan.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rmlayanan = "'+txtlayanan.text+'"');
				if(txtdiagnosa.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'rmicd10 = "'+txtdiagnosa.text+'"');
				return f;
			}
			
			public function f_hitungTotal():void{}
