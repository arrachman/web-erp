			protected function cmbJenisPasien_changeHandler(event:IndexChangeEvent):void
			{
				if(cmbJenisPasien.textInput.text != ""){
					if(cmbJenisPasien.selectedIndex == 0){
						parentApplication.F_tabvalidatenow(tab);
						if(dgAK.dataProviderLength > 0){
							for(var q1:int = 0;q1<dgAK.dataProviderLength;q1++){
								if(dgAK.dataProvider.getItemAt(q1).chk == true)
									dgAK.dataProvider.getItemAt(q1).chk = false;
							}
						}
						if(dgLU.dataProviderLength > 0){
							for(var q2:int = 0;q2<dgLU.dataProviderLength;q2++){
								if(dgLU.dataProvider.getItemAt(q2).chk == true)
									dgLU.dataProvider.getItemAt(q2).chk = false;
							}
						}
						if(dgLB.dataProviderLength > 0){
							for(var q3:int = 0;q3<dgLB.dataProviderLength;q3++){
								if(dgLB.dataProvider.getItemAt(q3).chk == true)
									dgLB.dataProvider.getItemAt(q3).chk = false;
							}
						}
						statusCek = 0;
						TabLU.enabled = false;
						TabAK.enabled = false;
						TabLB.enabled = false;
						tabKJ.enabled = true;
						dttglkeluar.enabled = true;
						//txtdokter.enabled = true;
					}
					else{
						if(dg1.dataProviderLength > 0){
							for(var q:int = 0;q<dg1.dataProviderLength;q++){
								if(dg1.dataProvider.getItemAt(q).chk == true)
									dg1.dataProvider.getItemAt(q).chk = false;
							}
						}
						statusCek = 0;
						TabLU.enabled = true;
						TabAK.enabled = true;
						TabLB.enabled = true;
						tabKJ.enabled = false;
						dttglkeluar.enabled = false;
						//txtdokter.enabled = false;
						//dttglkeluar.text = '';
						//txtdokter.text = '';
						lblNamaDokter.text = '';
