			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var mnid:int, dg:DataGrid;
				if(tab.selectedIndex == 0){mnid = 3; dg = dg1}
				else if(tab.selectedIndex == 1){mnid = 4; dg = dgLU}
				else if(tab.selectedIndex ==2){mnid = 6; dg = dgAK}
				else if(tab.selectedIndex ==3){mnid = 5; dg = dgLB}
				
				switch (components){
					case 'checkBoxHeader':
						if(dg == dg1){
							if(data == true){
								if(dg.dataProvider.getItemAt(0).notransaksi != "" && dg.dataProvider.getItemAt(0).notransaksi != null
									&& dg.dataProvider.getItemAt(0).notransaksi != undefined && dg.dataProviderLength > 0){
									Alert.show("Kunjungan tidak boleh dipilih lebih dari 1");
									statusCek = 0;
									for (i=0; i<dg.dataProviderLength; i++){
										dg.dataProvider.getItemAt(i).chk = false;
									}
								}
							}
							else{
								statusCek = 0;
								for (i=0; i<dg.dataProviderLength; i++){
									dg.dataProvider.getItemAt(i).chk = data;
								}
							}
						}
						else{
							for (i=0; i<dg.dataProviderLength; i++){
								dg.dataProvider.getItemAt(i).chk = data;
								
							}
						}
						break;
					case 'checkBox':
						if(dg == dg1){
							if(data == true){
								//Alert.show(statusCek.toString());
								if(statusCek == 0){
									dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
									u.getItemAt(0).iccustomer = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kontak;
									statusCek = 1;
								}
								else if(statusCek == 1){
									Alert.show("Kunjungan tidak boleh dipilih lebih dari 1");
									dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = false;
								}
							}
							else{
								statusCek = 0;
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
								u.getItemAt(0).iccustomer = 0;
							}								
						}
						else{
							if(data == true)u.getItemAt(0).iccustomer = FlexGlobals.topLevelApplication.getSetting(11,'company','Customer');
							else u.getItemAt(0).iccustomer = FlexGlobals.topLevelApplication.getSetting(11,'company','Customer');
							dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						}
						break;
					case 'link':
						FlexGlobals.topLevelApplication.openForm(11, mnid, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idtransaksi);
						break;
					switch (components){
						case 'calculator':
							dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
							break;
					}
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
