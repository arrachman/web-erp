			public function f_hitungTotal():void
			{
				//set total detail
				o.totaltransaksiKJ = 0; o.totaltransaksiRP1 = 0; o.totaltransaksiIP1 = 0; o.totaltransaksiAS1 = 0; o.totaltransaksiCOA1 = 0;
				//set total bawah
				o.totalAR = 0; 
				//dg1
				for(i = 0; i< dg1.dataProviderLength; i++){
					if(dg1.dataProvider[i].chk == true){
						// hitung total tiap tiap tab
						o.totaltransaksiKJ += Number(dg1.dataProvider[i].totaltransaksi);
					}
				}
				for(i = 0; i< dgLU.dataProviderLength; i++){
					if(dgLU.dataProvider[i].chk == true){
						// hitung total tiap tiap tab
						o.totaltransaksiRP1 += Number(dgLU.dataProvider[i].totaltransaksi);
					}
				}
				for(i = 0; i< dgAK.dataProviderLength; i++){
					if(dgAK.dataProvider[i].chk == true){
						// hitung total tiap tiap tab
						o.totaltransaksiIP1 += Number(dgAK.dataProvider[i].totaltransaksi);
					}
				}
				for(i = 0; i< dgLB.dataProviderLength; i++){
					if(dgLB.dataProvider[i].chk == true){
						// hitung total tiap tiap tab
						o.totaltransaksiAS1 += Number(dgLB.dataProvider[i].totaltransaksi);
					}
				}
				for(i = 0; i< dgCOA.dataProviderLength; i++){
					if((dgCOA.dataProvider[i].rekhutangpiutang != "" || dgCOA.dataProvider[i].rekhutangpiutang != null || dgCOA.dataProvider[i].rekhutangpiutang != undefined) && dgCOA.dataProvider[i].jmlbayar != undefined){
						// hitung total tiap tiap tab
						o.totaltransaksiCOA1 += Number(dgCOA.dataProvider[i].jmlbayar);
					}
				}
				
				//hitunggrandtotal
				o.totalAR = o.totaltransaksiKJ + o.totaltransaksiRP1 + o.totaltransaksiIP1 + o.totaltransaksiAS1 + o.totaltransaksiCOA1;
				
				//set label
				lbltotalAR.text = parentApplication.m.nfNominal.format(o.totalAR);
				
				o.txtjmlbayar = Number(o.txttunai) + Number(o.txtkartudebit) + Number(o.txtkartukredit);
				o.txtkembali = Number(o.txtjmlbayar) - Number(o.totalAR);
				// set label tiap tiap tab
				lbltotaltransaksiKJ.text = parentApplication.F_formatNominal(o.totaltransaksiKJ);
				lbltotaltransaksiRP1.text = parentApplication.F_formatNominal(o.totaltransaksiRP1);
				lbltotaltransaksiIP1.text = parentApplication.F_formatNominal(o.totaltransaksiIP1);
				lbltotaltransaksiAS1.text = parentApplication.F_formatNominal(o.totaltransaksiAS1);
				lbltotaltransaksiCOA1.text = parentApplication.F_formatNominal(o.totaltransaksiCOA1);
				txtjmlbayar.text = parentApplication.m.nfNominalPOS.format(o.txtjmlbayar);
				txtkembali.text = parentApplication.m.nfNominalPOS.format(o.txtkembali);
			}
			
