		  xmlns:mx="library://ns.adobe.com/flex/mx" width="630" height="326" creationComplete="module1_creationCompleteHandler(event)"> 
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			protected function module1_creationCompleteHandler(event:FlexEvent):void
			{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("^|^");
				if(filtersplit[0] != "")lblNoRegistrasi.text = filtersplit[0];
				else lblNoRegistrasi.text = "-";
				
				if(filtersplit[1] != "")lblTglRegistrasi.text = filtersplit[1];
				else lblTglRegistrasi.text = "-";
				
				if(filtersplit[2] != "")lblKodePasien.text = filtersplit[2];
				else lblKodePasien.text = "-";
				
				if(filtersplit[3] != "")lblNamaPasien.text = filtersplit[3];
				else lblNamaPasien.text = "-";
				
				if(filtersplit[4] != "")lblAlamatPasien.text = filtersplit[4];
				else lblAlamatPasien.text = "-";
				
				lblLayananUmum.text = parentApplication.m.nfNominal.format(filtersplit[5]); 
				lblApotek.text = parentApplication.m.nfNominal.format(filtersplit[7]);
				lblReturApotek.text = "("+parentApplication.m.nfNominal.format(filtersplit[6])+")";
				lblLaboratorium.text = parentApplication.m.nfNominal.format(filtersplit[8]);
				lblRekanan.text = parentApplication.m.nfNominal.format(filtersplit[9]);
				lblTotalTagihan.text = parentApplication.m.nfNominal.format(filtersplit[10]);
			}
			
		]]>
	</fx:Script>
