			protected function cmbJenisBilling_changeHandler(event:IndexChangeEvent):void
			{
				if(cmbJenisBilling.selectedIndex == 0){
					txtkunjungan.enabled = true;
					u.getItemAt(0).lucustomer = 0;
					cmbPerawatan.enabled = true;
					cmbPerawatan.selectedIndex = 0;
					lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
				}
				else{
					txtkunjungan.enabled = false;
					u.getItemAt(0).lucustomer = FlexGlobals.topLevelApplication.getSetting(11,'company','Customer');
					u.getItemAt(0).luidkj = 0;
					cmbPerawatan.enabled = false;
					cmbPerawatan.selectedIndex = 1;
					lblNamaPerawatan.text = cmbPerawatan.selectedItem.v;
				}
			}
			
