				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					pesanAlertIng = "";
					pesanAlert = "";
					o.serial = false; o.batch = false;
					for(i = 0; i<dg1.dataProviderLength; i++){
						if(dg1.dataProvider[i].bserial == 1 && acserialdetail.length <= 0){
							o.serial = true;
						}
						if(dg1.dataProvider[i].bbatch == 1 && acbatchdetail.length <= 0){
							o.batch = true;
						}
					}
					if(parentApplication.getSetting(12, 'custom', 'CustomWajib') == 1 && txtcustomarea.text.length == 0){
						FlexGlobals.topLevelApplication.msgAlert(txtcustomarea, tcustomarea.text);
					}
					if(cmbasalbarang.selectedIndex < 0 || cmbasalbarang.textInput.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(cmbasalbarang,'Asal Barang');
					if(cmbcarabayar.selectedIndex < 0 || cmbcarabayar.textInput.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(cmbcarabayar,'Cara Bayar');
					if(txtcustomer.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtcustomer,'Customer');
					if(txtsalesman.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtsalesman,'Salesman');
					if(dttanggal.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(dttanggal,'Tanggal');
					if(txtnotransaksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(txtmatauang.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(dg1.dataProvider.getItemAt(0).idsqdetail == null )FlexGlobals.topLevelApplication.msgAlert(dg1,'Detail Item');
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');
					else {
						for(var i:int=0;i<dg1.dataProvider.length;i++){
							if(dg1.dataProvider.getItemAt(i).hk == false && dg1.dataProvider.getItemAt(i).bhpp == 'I'){
								validasi = false;
								// Mencari kolom index field 'hk'
								for(var j:int=0;j<dg1.columnsLength;j++){
									if(dg1.columns.getItemAt(j).dataField == 'hk')
										break;
								}
								dg1.setFocus(); dg1.setSelectedCell(i, j);
								Alert.show(FlexGlobals.topLevelApplication.l('Hpp khusus harus tercentang'), FlexGlobals.topLevelApplication.l('Informasi'));
								break;
							}
						}
					}
				}
			}
			
			public function msgAlert(focus: Object, inggris: String, indonesia: String):void
			{ 
				if(validasi == true)focus.setFocus();
				pesanAlertIng += inggris+', ';
				pesanAlert += indonesia+', ';
				if(focus == 'clear'){
					pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
					pesanAlert += " harus diisi dengan benar";
					pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
					pesanAlertIng += " must be filled";
					Alert.show(pesanAlertIng+"  ("+pesanAlert+")"  , "Information");} 
				validasi = false; 
			}
			
			public function f_hitungTotalDetail():void
			{
				n.vtotal=0;
				n.vtotalpajak1=0;
				n.vtotalpajak2=0;
				for(var i:int=0;i<dg1.dataProvider.length;i++){
					if(dg1.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg1.dataProvider.getItemAt(i).subtotal);
					if(dg1.dataProvider.getItemAt(i).jmlpajak1 != undefined)n.vtotalpajak1 += Number(dg1.dataProvider.getItemAt(i).jmlpajak1);
					if(dg1.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg1.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = parentApplication.m.nfNominal.format(n.vtotal);
				lblpajak1.text = parentApplication.m.nfNominal.format(n.vtotalpajak1);
				lblpajak2.text = parentApplication.m.nfNominal.format(n.vtotalpajak2);
				
				o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
				txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
				o.txtbiayalainnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtbiayalainpersen);
				txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
				
				
				f_hitungTotalUtama();
			}
			
			public function f_hitungTotalUtama():void
			{
				n.vtotaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak1) + Number(n.vtotalpajak2) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai) - Number(o.txtjmlas);
				
				lbltotaltransaksi.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				parentApplication.F_acAdd(dg1);
				dg1.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
