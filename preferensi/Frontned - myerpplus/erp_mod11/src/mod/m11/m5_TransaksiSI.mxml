			public function f_matauangFungsional():void
			{
				if(txtmatauang.text == parentApplication.getSetting(0, 'accounting', 'MataUangFungsional')){ 
					txtkurs.enabled = false;
				}else{
					txtkurs.enabled = true;
				}
			}
			
			public function f_hitungGrid(): void{
				var dgrid: Object;
				for(i = 0; i<dg1.dataProviderLength; i++){
					dgrid = dg1.dataProvider[i]
					dgrid.jmldiskon = (Number(dgrid.diskon)/100) * Number(dgrid.jml) * Number(dgrid.harga); 
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
					dgrid.jmlpajak1 = (Number(dgrid.nilaipajak1)/100) * dgrid.subtotal;
					dgrid.jmlpajak2 = (Number(dgrid.nilaipajak2)/100) * dgrid.subtotal;
				}
				f_hitungTotalDetail();
				f_hitungTotalUtama();
			}
			
