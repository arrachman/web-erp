			public function f_validasi():void{
				
				//set getdata by id===============================================================================================
				var filtersplit :Array;
				filtersplit =  FlexGlobals.topLevelApplication.FormFilter.split("[]")
				var idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					//input
					f_kondisiAwal();
				}else{
					if(filtersplit[1] == 'history'){
						//history
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_SiHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						//edit
//						Alert.show(FlexGlobals.topLevelApplication.FormFilter);
						if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
							idtransaksi = parentApplication.m.ArrFilter[0];
							idtransaksi = idtransaksi.replace('p1  = "', '');
							idtransaksi = idtransaksi.replace('"', '');
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_SiGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_SiGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
				}
				//end of set getdata by id===============================================================================================
				
