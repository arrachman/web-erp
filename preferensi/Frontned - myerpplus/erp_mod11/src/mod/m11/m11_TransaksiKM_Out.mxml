								parentApplication.F_tglFormatDB(kmcustomdate13), parentApplication.F_tglFormatDB(kmcustomdate14), parentApplication.F_tglFormatDB(kmcustomdate15), parentApplication.F_tglFormatDB(kmcustomdate16), parentApplication.F_tglFormatDB(kmcustomdate17), 
