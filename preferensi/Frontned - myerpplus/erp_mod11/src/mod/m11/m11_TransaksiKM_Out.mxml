				function validasiForm():void
				{
					pesanAlert='';
					validasi = true;
					if(txtnotransaksikm.text.length == 0)parentApplication.msgAlert(txtnotransaksikm,'Kunjungan');
					if(txtkamarout.text.length == 0)parentApplication.msgAlert(txtkamarout,'Kamar');
					if(txtkasurout.text.length == 0)parentApplication.msgAlert(txtkasurout,'Kasur');
					if(txtharga.text.length == 0)parentApplication.msgAlert(txtharga,'Harga');
					if(dttanggalkeluar.text.length == 0)parentApplication.msgAlert(dttanggalkeluar,'Tanggal Keluar');
					if(nmrjam.textDisplay.text.length == 0 || nmrmenit.textDisplay.text.length == 0 || nmrdetik.textDisplay.text.length == 0)parentApplication.msgAlert(nmrjam,'Jam');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
			
			public function f_hitungTotal():void
			{
				n.vharga = o.txtharga;
				n.vhari = FlexGlobals.topLevelApplication.F_tglSelisih(dttanggalkeluar.text, vtglmasuk);
				n.vtotal = Number(o.txtharga) * Number(n.vhari);
				
				lblnilaijmlhari.text = String(n.vhari);
				lblnilaitotal.text = parentApplication.m.nfNominal.format(n.vtotal);
			}
			
			protected function formatNumber(value:Number):String
			{
				if (value < 10)
					return '0' + value;
				
				return value.toString();
			}
			
