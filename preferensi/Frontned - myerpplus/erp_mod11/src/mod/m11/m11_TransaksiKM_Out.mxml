			public function doubleDigitFormat(num:uint):String  
			{
				if(num < 10) {
					return ("0" + num);
				}
				return num.toString();
			}
			
// set persiapan form ==========================================================
			public function f_persiapan():void
			{
				parentApplication.F_TranslateLabel([tnotransaksikm, tkamar, tkasur, tharga, ttanggalkeluar, tjamkeluar, lbljmlhari, lbltotal]);
				parentApplication.F_RequiredLabel([tnotransaksikm, tkamar, tkasur, tharga, ttanggalkeluar, tjamkeluar]);
				parentApplication.F_DateFieldStandard([dttanggalkeluar]);
				parentApplication.F_txtpencarian([txtnotransaksikm, txtkamarout, txtkasurout]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtharga]);
				parentApplication.F_SetNavigasiKeyboard([txtharga, nmrjam, nmrmenit, nmrdetik]);
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				function f_mbSimpan():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(11,7,2)==true){
						f_simpan();
					}
				}
				f_kondisiAwal();
			}
			
