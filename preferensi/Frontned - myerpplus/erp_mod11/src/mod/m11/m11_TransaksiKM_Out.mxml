			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							if(FlexGlobals.topLevelApplication.apaBisaAkses(11,7,2)==true){
								f_simpan();
							}
							break;
						}
				}
			}	
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtnotransaksikm':
						paket = 'CdM11_Km';
						wsfilter = '(kmstatus = 2 OR kmstatus = 3) AND kjnotransaksi ="'+txtnotransaksikm.text.split('"').join('\\"')+'"';
						csfilter = '(kmstatus = 2 OR kmstatus = 3)';
						csfield = 2;
						sort = 'kminputtgl desc';
						break;
					case 'txtkamarout':
						paket = 'CdM1_Room';
						wsfilter = '(raktif = 1 AND risclose = 0) AND rkode ="'+txtkamarout.text.split('"').join('\\"')+'"';
						csfilter = '(raktif = 1 AND risclose = 0)';
						csfield = 2;
						sort = 'rkode asc';
						break;
					case 'txtkasurout':
						paket = 'CdM1_Bed';
						wsfilter = '(baktif = 1 AND bisclose = 0 AND bkamar = "'+txtkamarout.text+'") AND kkode ="'+txtkasurout.text.split('"').join('\\"')+'"';
						csfilter = '(baktif = 1 AND bisclose = 0 AND bkamar = "'+txtkamarout.text+'")';
						csfield = 2;
						sort = 'bkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
