			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategori':
						paket = 'CdM1_Contact_Category';
						wsfilter = "cckode = '"+ txtkategori.text +"' AND ccustomint1 = 1";
						csfilter = "ccustomint1 = 1";
						break;
					case 'itxtCabang':
						paket = 'CdM1_Branch';
						csfilter="baktif=1"
						wsfilter = "baktif=1 and bkode = '"+ itxtCabang.text +"'";
						break;
					case 'itxtlokasi':
						if(itxtCabang.text.length > 0){
							paket = 'CdM1_Location';
							csfilter = "laktif = 1 and lcabang ='"+itxtCabang.text+"'";
							wsfilter = "laktif = 1 and lcabang ='"+itxtCabang.text+"' and lkode = '"+ itxtlokasi.text +"'";
						}else{
							Alert.show('Cabang harus diisi terlebih dahulu');
							FlexGlobals.topLevelApplication.F_KosongkanText([itxtlokasi, ilbllokasi]);
						}
						break;
					case 'itxtgudang':
						if(itxtlokasi.text.length > 0){
							paket = 'CdM1_Warehouse';
							csfilter="waktif=1 and wlokasi = '"+itxtlokasi.text+"'"
							wsfilter = "waktif=1 and wlokasi = '"+itxtlokasi.text+"' and wkode = '"+ itxtgudang.text +"'";
						}else{
							Alert.show('Lokasi harus diisi terlebih dahulu');
							FlexGlobals.topLevelApplication.F_KosongkanText([itxtgudang, ilblgudang]);
						}
						break;
					case 'itxtdivisi':
						paket = 'CdM1_Division';
						csfilter="daktif=1"
						wsfilter = "daktif=1 and dkode = '"+ itxtdivisi.text +"'";
						break;
					case 'itxtsubdivisi':
						paket = 'CdM1_Subdivision';
						csfilter="sdaktif=1"
						wsfilter = "sdaktif=1 and sdkode = '"+ itxtsubdivisi.text +"'";
						break;
					case 'itxtkategoricust':
						paket = 'CdM1_Customer_Category';
						csfilter="ccaktif=1"
						wsfilter = "ccaktif=1 and cckode = '"+ itxtkategoricust.text +"'";
						break;
					case 'itxtkategorisupp':
						paket = 'CdM1_Supplier_Category';
						csfilter="scaktif=1"
						wsfilter = "scaktif=1 and sckode = '"+ itxtkategorisupp.text +"'";
						break;
					case 'itxtsalesman':
						paket = 'CdM1_Contact';
						csfilter="kkategori='M' and kaktif=1"
						wsfilter = "kkategori='M' and kaktif=1 and kkode = '"+ itxtsalesman.text +"'";
						break;
					case 'itxtkategorisale':
						paket = 'CdM1_Salesman_Category';
						csfilter="scaktif=1";
						wsfilter = "scaktif=1 and sckode = '"+ itxtkategorisale.text +"'";
						break;
					case 'itxtarea':
						paket = 'CdM1_Area';
						csfilter="aaktif=1";
						wsfilter = "aaktif=1 and akode = '"+ itxtarea.text +"'";
						break;
					case 'ttxtmatauang':
						paket = 'CdM1_Currency';
						csfilter="caktif=1";
						wsfilter = "caktif=1 and ckode = '"+ ttxtmatauang.text +"'";
						break;
					case 'tbtxttermin':
						paket = 'CdM1_Terms';
						csfilter="traktif=1";
						wsfilter = "traktif=1 and trkode = '"+ tbtxttermin.text +"'";
						break;
					case 'tjtxttermin':
						paket = 'CdM1_Terms';
						csfilter="traktif=1";
						wsfilter = "traktif=1 and trkode = '"+ tjtxttermin.text +"'";
						break;
					case 'tbtxtjenispajak':
						paket = 'CdM1_Tax';
						csfilter="taktif=1";
						wsfilter = "taktif=1 and tkode = '"+ tbtxtjenispajak.text +"'";
						break;
					case 'tjtxtjenispajak':
						paket = 'CdM1_Tax';
						csfilter="taktif=1";
						wsfilter = "taktif=1 and tkode = '"+ tjtxtjenispajak.text +"'";
						break;
					case 'tbtxtrekhutang':
						paket = 'CdM1_Coa';
						csfilter="cgd='d' and caktif=1";
						wsfilter = "cgd='d' and kaktif=1 and cnomor = '"+ tbtxtrekhutang.text +"'";
						break;
					case 'tjtxtrekpiutang':
						paket = 'CdM1_Coa';
						csfilter="cgd='d' and caktif=1";
						wsfilter = "cgd='d' and kaktif=1 and cnomor = '"+ tjtxtrekpiutang.text +"'";
						break;
					case 'tbtxtbagbeli':
						paket = 'CdM1_Contact';
						csfilter="kkategori='K' and kaktif=1";
						wsfilter = "kkategori='K' and kaktif=1 and kkode = '"+ tbtxtbagbeli.text +"'";
						break;
					case 'tjtxtbagjual':
						paket = 'CdM1_Contact';
						csfilter="kkategori='K' and kaktif=1";
						wsfilter = "kkategori='K' and kaktif=1 and kkode = '"+ tjtxtbagjual.text +"'";
						break;
					case 'tjtxtkomisi':
						paket = 'CdM1_Commission';
						csfilter = "kmaktif = 1";
						wsfilter = "kmaktif = 1 and kmkode = '"+ tjtxtkomisi.text +"'";
						break;
					case 'bkode':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bkode = "'+dgharga.dataProvider[dgharga.selectedCell.rowIndex].bkode+'"';
						csfilter = 'baktif = 1'; 
						sort = 'bkode asc';
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif=1 AND ukode = "'+dgharga.dataProvider[dgharga.selectedCell.rowIndex].bkode+'"';
						csfilter = 'baktif = 1'; 
						sort = 'ukode asc';
						break;
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
