					case 'itxtgudang':parentApplication.F_KosongkanText([itxtgudang, ilblgudang]);break;
					case 'itxtdivisi':parentApplication.F_KosongkanText([itxtdivisi, ilbldivisi]);break;
					case 'itxtsubdivisi':parentApplication.F_KosongkanText([itxtsubdivisi, ilblsubdivisi]);break;
					case 'itxtkategoricust':parentApplication.F_KosongkanText([itxtkategoricust, ilblkategoricust]); tjcmbtingkathargajual.textInput.text = ''; tingkathargajual = 0;break;
					case 'itxtkategorisupp':parentApplication.F_KosongkanText([itxtkategorisupp, ilblkategorisupp]);break;
					case 'itxtsalesman':parentApplication.F_KosongkanText([itxtsalesman, ilblsalesman]);break;
					case 'itxtkategorisale':parentApplication.F_KosongkanText([itxtkategorisale, ilblkategorisale]);break;
					case 'txtarea':parentApplication.F_KosongkanText([itxtarea, ilblarea]);break;
					case 'ttxtmatauang':parentApplication.F_KosongkanText([ttxtmatauang]);break;
					case 'tbtxttermin':parentApplication.F_KosongkanText([tbtxttermin]);break;
					case 'tjtxttermin':parentApplication.F_KosongkanText([tjtxttermin]);break;
