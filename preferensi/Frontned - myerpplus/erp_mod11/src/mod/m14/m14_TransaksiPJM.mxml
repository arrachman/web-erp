				n.vtotal += o.txtnilaipinjaman;
				n.vtotaladministrasi += o.txtadministrasi;
				n.vtotalasuransi += o.txtasuransi;
				n.vtotalresikokredit += o.txtresikokredit;
				for(var j:int=0;j<dg2.dataProviderLength;j++){
					if((dg2.dataProvider[j].kodeakun != "" || dg2.dataProvider[j].kodeakun != null || dg2.dataProvider[j].kodeakun != undefined) && dg2.dataProvider.getItemAt(j).bayar != undefined)
						n.vtotalbayar += Number(dg2.dataProvider.getItemAt(j).bayar);
				}
				lbltotalpinjamannilai.text = parentApplication.m.nfNominal.format(n.vtotal);
				lbltotaltransaksinilai.text = parentApplication.m.nfNominal.format(n.vtotal-n.vtotaladministrasi-n.vtotalasuransi-n.vtotalresikokredit);
				lbltotalbayarnilai.text = parentApplication.m.nfNominal.format(n.vtotalbayar);
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				dg2.dataProvider.removeAll();
				dg.dataProvider.removeAll();
				FlexGlobals.topLevelApplication.F_acAdd(dg);	
				FlexGlobals.topLevelApplication.F_acAdd(dg1);			// menambah 1 baris lagi
				FlexGlobals.topLevelApplication.F_acAdd(dg2);
				dg1.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
			public function HitungSimulasi():void{
				var tglawal:String="", bulantahun:Array;
				var bulantransaksi:Array = dttanggal.text.split("/");
				tglawal =  bulantransaksi[0]+"/"+bulantransaksi[1]+"/"+bulantransaksi[2]
				
				dg.dataProvider.removeAll();
				//fungsi untuk mengambil jumlah hari dalam satu bulan==========
				function AmbilJmlHari(year:int, month:int):int{
					var d:Date=new Date(year, month, 0);
					return d.getDate();
				}
				//end fungsi untuk mengambil jumlah hari dalam satu bulan======
				//hitung simulasi====================================================
				for (var i:int = 0; i < Number(txtjangkawaktu.text); i++){
					bulantahun = tglawal.split("/");
					//jika bulanan===================================================
					dg.dataProvider.addItem({
						idpjm:0,
						no:i+1, 
						ke:i+1,
						tgljt:FlexGlobals.topLevelApplication.F_tglJatuhTempo(tglawal, AmbilJmlHari(bulantahun[2], bulantahun[1])),
						nilai:Number(o.txtnilaipinjaman)/Number(txtjangkawaktu.text),
						bunga:Number(o.txtjasaperbulan)/Number(txtjangkawaktu.text),
						jumlah:(Number(o.txtnilaipinjaman)/Number(txtjangkawaktu.text))+(Number(o.txtjasaperbulan)/Number(txtjangkawaktu.text)),
						status:"Belum Lunas"
					});
					tglawal = dg.dataProvider[i].tgljt;	
				}
				//end hitung simulasi============================================
				parentApplication.F_dgRefresh(dg);
			}
			
