			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				if(dg2.selectedCell != null && parentApplication.rowIndex < dg2.dataProviderLength)objbayar = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
				switch(target){
					case 'txtkodeanggota':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkode ="'+txtkodeanggota.text.split('"').join('\\"')+'" AND kcustomint2 = 1';
						csfilter = 'kaktif = 1 AND kcustomint2 = 1';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtnorekening':
						paket = 'CdM14_Account';
						wsfilter = 'aaktif = 1 AND anorek ="'+txtnorekening.text.split('"').join('\\"')+'"';
						csfilter = 'aaktif = 1';
						sort = 'anorek asc';
						break;
					case 'txtpinjaman':
						paket = 'CdM14_Loan';
						wsfilter = 'paktif = 1 AND pkode ="'+txtpinjaman.text.split('"').join('\\"')+'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
					case 'kode':
						paket = 'CdM14_Collateral';
						wsfilter = 'aaktif = 1 AND akode ="'+obj.kode.split('"').join('\\"')+'"';
						csfilter = 'aaktif = 1';
						sort = 'akode asc';
						break;
					case 'carabayarnama':
						paket = 'CdM0_Carabayar';
						wsfilter = 'kode <> 3 AND nama = "'+objbayar.carabayarnama.split('"').join('\\"')+'"';
						csfilter = 'kode <> 3';
						sort = 'kode asc';
						break;
					case 'kodeakun':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd="D" AND cnomor = "'+objbayar.kodeakun.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 and cgd="D"';
						sort = 'cnomor asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				if (dg1.dataProvider != null && parentApplication.rowIndex < dg1.dataProviderLength)
					var ob : Object = dg1.dataProvider[parentApplication.rowIndex];
				if (dg2.dataProvider != null && parentApplication.rowIndex < dg2.dataProviderLength)
					var obbayar : Object = dg2.dataProvider[parentApplication.rowIndex];
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtkodeanggota':
							txtkodeanggota.text = obj.kkode;
							lblnamaanggota.text = obj.knama;
							u.getItemAt(0).pjmidanggota = obj.kid;
							IDANGGOTA = obj.kid;
							FlexGlobals.topLevelApplication.F_wsSearch("norekening","CdM14_Account",0,0,"akode = '"+txtkodeanggota.text+"'");
							break;
						case 'norekening':
							txtnorekening.text = obj.anorek;
							break;
						case 'txtnorekening':
							txtnorekening.text = obj.anorek;
							break;
						case 'txtpinjaman':
							IDPJM = 0;
							IDPJMdetail = 0;
							txtpinjaman.text = obj.pkode;
							lblpinjaman.text = obj.pnama;
