			// set persiapan form ==========================================================
			public function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tkodeanggota, turaian, tcatatan, ttanggal, tnotransaksi, tprogress, tkategorianggota]);
				parentApplication.F_RequiredLabel([ttanggal, tnotransaksi, tprogress]);
				parentApplication.F_DateFieldStandard([dttanggal]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtkodeanggota1, txtkodeanggota2, txtkategorianggota]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtcatatan]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
