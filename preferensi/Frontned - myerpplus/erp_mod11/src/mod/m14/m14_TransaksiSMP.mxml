			protected function f_filterdata():String{
				var f:String='';
				f = '';
				if(txtkodeanggota1.text!='' && txtkodeanggota2.text!=''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode Between "'+txtkodeanggota1.text+'" and "'+txtkodeanggota2.text+'"');
				}
				if(txtkodeanggota1.text!='' && txtkodeanggota2.text==''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode = "'+txtkodeanggota1.text+'"');
				}
				if(txtkodeanggota1.text=='' && txtkodeanggota2.text!=''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode = "'+txtkodeanggota2.text+'"');
				}
				if(txtkategorianggota.text != ''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkategori = "'+txtkategorianggota.text+'"');
				}
				f = FlexGlobals.topLevelApplication.TambahFilter(f,'kcustomint2 = 1');
				return f;
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				if(dg2.selectedCell != null && parentApplication.rowIndex < dg2.dataProviderLength)objbayar = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
				switch(target){
					case 'txtkodeanggota1':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkode ="'+txtkodeanggota1.text.split('"').join('\\"')+'" AND kcustomint2 = 1';
						csfilter = 'kaktif = 1 AND kcustomint2 = 1';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkodeanggota2':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkode ="'+txtkodeanggota2.text.split('"').join('\\"')+'" AND kcustomint2 = 1';
						csfilter = 'kaktif = 1 AND kcustomint2 = 1';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkategorianggota':
						paket = 'CdM1_Contact_Category';
						wsfilter = 'cckode ="'+txtkategorianggota.text.split('"').join('\\"')+'" AND ccustomint1 = 1';
						csfilter = 'ccustomint1 = 1';
						csfield = 2;
						sort = 'cckode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "PY"';
						sort = 'tnkode asc';
						break;
					case 'kodeanggota':
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkode ="'+obj.kodeanggota.split('"').join('\\"')+'" AND kcustomint2 = 1';
						csfilter = 'kaktif = 1 AND kcustomint2 = 1';
						sort = 'kkode asc';
						break;
					case 'norekening':
						paket = 'CdM14_Account';
						wsfilter = 'aaktif = 1 AND anorek ="'+obj.norekening.split('"').join('\\"')+'"';
						csfilter = 'aaktif = 1';
						sort = 'anorek asc';
						break;
					case 'kodesimpanan':
						paket = 'CdM14_Deposit';
						wsfilter = 'saktif = 1 AND skode ="'+obj.kodesimpanan.split('"').join('\\"')+'"';
						csfilter = 'saktif = 1';
						sort = 'skode asc';
						break;
					case 'carabayarnama':
						paket = 'CdM0_Carabayar';
						wsfilter = 'kode <> 3 AND nama = "'+objbayar.carabayarnama.split('"').join('\\"')+'"';
						csfilter = 'kode <> 3';
						sort = 'kode asc';
						break;
					case 'kodeakun':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd="D" AND cnomor = "'+objbayar.kodeakun.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 and cgd="D"';
						sort = 'cnomor asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "PY"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
