			// set persiapan form ==========================================================
			public function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tnosiswa, turaian, tcatatan, ttanggal, tnotransaksi, tprogress, ttahunajaran, tkategorisiswa]);
