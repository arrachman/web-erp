			// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'calculator':
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
							switch(dataField){
								case 'jml':
								case 'harga':
								case 'pajak1':
								case 'pajak2':
									jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
									jmltotal = Number(jml) * Number(nilaisatuan);
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									break;
								case 'diskon':
									jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									break;
								case 'jmldiskon':
									vMsg = ''; vMsgIng = '';
									dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
									if(dgrid1.jml == 0 || dgrid1.harga == 0){
										if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
										if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
										if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
										dgrid1.jmldiskon = 0;
										dgrid1.diskon= 0;
									}else{
										diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
										subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
										jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
										jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									}
									break;
							}
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
					case 'checkBoxHeader':
						for (i=0; i<dg1.dataProviderLength; i++){
							dg1.dataProvider.getItemAt(i).chk = data;
						}
						f_hitungTotal();
						break;
					case 'checkBox':
						dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).chk = data;
						f_hitungTotal();
						break;
				}
			}
			
