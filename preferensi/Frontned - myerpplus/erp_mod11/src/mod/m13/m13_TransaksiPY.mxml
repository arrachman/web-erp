			protected function f_filterdata():String{
				var f:String='';
				f = '';
				if(txtnosiswa1.text!='' && txtnosiswa2.text!=''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'a.nosiswa Between "'+txtnosiswa1.text+'" and "'+txtnosiswa2.text+'"');
				}
				if(txtnosiswa1.text!='' && txtnosiswa2.text==''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'a.nosiswa = "'+txtnosiswa1.text+'"');
				}
				if(txtnosiswa1.text=='' && txtnosiswa2.text!=''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'a.nosiswa = "'+txtnosiswa2.text+'"');
				}
				if(txtkategorisiswa.text != ''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'d.blkategorisiswa = '+idsiswa);
				}
				if(txttahunajaran.text != ''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'a.angkatan = "'+txttahunajaran.text+'"');
				}
				if(txtkategoribilling.text != ''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'b.kodebilling = "'+txtkategoribilling.text+'"');
				}
				f = FlexGlobals.topLevelApplication.TambahFilter(f,'(d.blstatus = 2 OR d.blstatus = 3) AND (b.harga-b.terbayar) > 0');
				return f;
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				if(dg2.selectedCell != null && parentApplication.rowIndex < dg2.dataProviderLength)objbayar = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
				switch(target){
					case 'txtnosiswa1':
						paket = 'CdM13_Si';
						wsfilter = 'siaktif = 1 AND sinosiswa ="'+txtnosiswa1.text.split('"').join('\\"')+'"';
						csfilter = 'siaktif = 1';
						csfield = 2;
						sort = 'sinosiswa asc';
						break;
					case 'txtnosiswa2':
						paket = 'CdM13_Si';
						wsfilter = 'siaktif = 1 AND sinosiswa ="'+txtnosiswa2.text.split('"').join('\\"')+'"';
						csfilter = 'siaktif = 1';
						csfield = 2;
						sort = 'sinosiswa asc';
						break;
					case 'txttahunajaran':
						paket = 'CdM13_School_Year';
						wsfilter = 'syaktif = 1 AND sykode ="'+txttahunajaran.text.split('"').join('\\"')+'"';
						csfilter = 'syaktif = 1';
						csfield = 2;
						sort = 'sykode asc';
						break;
					case 'txtkategorisiswa':
						paket = 'CdM13_Student_Category';
						wsfilter = 'sckode ="'+txtkategorisiswa.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'sckode asc';
						break;
					case 'txtkategoribilling':
						paket = 'CdM13_Billing_Category';
						wsfilter = 'bckode ="'+txtkategoribilling.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'bckode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "PY"';
						sort = 'tnkode asc';
						break;
					case 'nosiswa':
						var filterrr:String = '';
						if(txttahunajaran.text != "" && txtkategorisiswa.text != "")filterrr = 'sitahunajaran = "'+txttahunajaran.text+'" AND sikategori = '+idsiswa;
						else if(txttahunajaran.text != "" && txtkategorisiswa.text == "")filterrr = 'sitahunajaran = "'+txttahunajaran.text+'"';
						else if(txttahunajaran.text == "" && txtkategorisiswa.text != "")filterrr = 'sikategorisiswa = '+idsiswa;
						paket = 'CdM13_Si';
						if(filterrr != ""){
							wsfilter = 'siaktif = 1 AND sinosiswa = "'+obj.nosiswa.split('"').join('\\"')+'" AND '+filterrr;
							csfilter = 'siaktif = 1 AND '+filterrr;
						}
						else{
							wsfilter = 'siaktif = 1 AND sinosiswa = "'+obj.nosiswa.split('"').join('\\"')+'"';
							csfilter = 'siaktif = 1';
						}
						sort = 'sinosiswa asc';
						break;
					case 'carabayarnama':
						paket = 'CdM0_Carabayar';
						wsfilter = 'kode <> 3 AND nama = "'+objbayar.carabayarnama.split('"').join('\\"')+'"';
						csfilter = 'kode <> 3';
						sort = 'kode asc';
						break;
					case 'kodeakun':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd="D" AND cnomor = "'+objbayar.kodeakun.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 and cgd="D"';
						sort = 'cnomor asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "PY"';
						sort = 'tndkode asc';
						break;
