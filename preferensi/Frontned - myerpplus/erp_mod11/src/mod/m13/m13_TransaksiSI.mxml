			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String = '', kondisi:String = '';
				//if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txttahunajaran':
						paket='CdM13_School_Year';
						csfilter = 'syaktif = 1';
						wsfilter='syaktif = 1 and sykode = "'+ txttahunajaran.text +'"';
						break;
					case 'txtkategorisiswa':
						paket='CdM13_Student_Category';
						csfilter = 'scaktif = 1';
						wsfilter='scaktif = 1 and sckode = "'+ txtkategorisiswa.text +'"';
						break;
					case 'txtfakultas':
						paket='CdM13_Faculty';
						csfilter = 'faktif = 1';
						wsfilter='faktif = 1 and fkode = "'+ txtfakultas.text +'"';
						break;
					case 'txtprogramstudi':
						paket='CdM13_Study_Program';
						csfilter = 'spaktif = 1';
						wsfilter='spaktif = 1 and spkode = "'+ txtprogramstudi.text +'"';
						break;
					case 'txtkelas':
						paket='CdM13_Class';
						csfilter = 'caktif = 1';
						wsfilter='caktif = 1 and ckode = "'+ txtkelas.text +'"';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id, kondisi];
			}
			
