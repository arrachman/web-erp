			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				if(parentApplication.rowIndex < dg1.dataProviderLength)
					with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
						switch(column){
							case 'jml':
							case 'harga':
							case 'pajak1':
							case 'pajak2':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								jmltotal = Number(jml) * Number(nilaisatuan);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								break;
							case 'diskon':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								break;
							case 'jmldiskon':
								vMsg = ''; vMsgIng = '';
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
									if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
									if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								}
								break;
						}
					}
				parentApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
			protected function f_filterdata():String{
				var f:String='';
				f = '';
				f = FlexGlobals.topLevelApplication.TambahFilter(f,"siaktif = 1");
				if(txtnosiswa1.text!='' && txtnosiswa2.text!=''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sinosiswa Between "'+txtnosiswa1.text+'" and "'+txtnosiswa2.text+'"');
				}
				if(txtnosiswa1.text!='' && txtnosiswa2.text==''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sinosiswa >= "'+txtnosiswa1.text+'"');
				}
				if(txtnosiswa1.text=='' && txtnosiswa2.text!=''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sinosiswa <= "'+txtnosiswa2.text+'"');
				}
				if(txtkategorisiswa.text != ''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sikategorisiswa = '+idsiswa);
				}
				if(txttahunajaran.text != ''){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sitahunajaran = "'+txttahunajaran.text+'"');
				}
				return f;
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtnosiswa1':
						paket = 'CdM13_Si';
						wsfilter = 'siaktif = 1 AND sinosiswa ="'+txtnosiswa1.text.split('"').join('\\"')+'"';
						csfilter = 'siaktif = 1';
						csfield = 2;
						sort = 'sinosiswa asc';
						break;
					case 'txtnosiswa2':
						paket = 'CdM13_Si';
						wsfilter = 'siaktif = 1 AND sinosiswa ="'+txtnosiswa2.text.split('"').join('\\"')+'"';
						csfilter = 'siaktif = 1';
						csfield = 2;
						sort = 'sinosiswa asc';
						break;
					case 'txttahunajaran':
						paket = 'CdM13_School_Year';
						wsfilter = 'syaktif = 1 AND sykode ="'+txttahunajaran.text.split('"').join('\\"')+'"';
						csfilter = 'syaktif = 1';
						csfield = 2;
						sort = 'sykode asc';
						break;
					case 'txtkategorisiswa':
						paket = 'CdM13_Student_Category';
						wsfilter = 'sckode ="'+txtkategorisiswa.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'sckode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "BL"';
						sort = 'tnkode asc';
						break;
					case 'nosiswa':
						var filterrr:String = '';
						if(txttahunajaran.text != "" && txtkategorisiswa.text != "")filterrr = 'sitahunajaran = "'+txttahunajaran.text+'" AND sikategori = '+idsiswa;
						else if(txttahunajaran.text != "" && txtkategorisiswa.text == "")filterrr = 'sitahunajaran = "'+txttahunajaran.text+'"';
						else if(txttahunajaran.text == "" && txtkategorisiswa.text != "")filterrr = 'sikategorisiswa = '+idsiswa;
						paket = 'CdM13_Si';
						if(filterrr != ""){
							wsfilter = 'siaktif = 1 AND sinosiswa = "'+obj.nosiswa.split('"').join('\\"')+'" AND '+filterrr;
							csfilter = 'siaktif = 1 AND '+filterrr;
						}
						else{
							wsfilter = 'siaktif = 1 AND sinosiswa = "'+obj.nosiswa.split('"').join('\\"')+'"';
							csfilter = 'siaktif = 1';
						}
						sort = 'sinosiswa asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "BL"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'" AND sdkode = "'+obj.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case 'proyek':
						paket = 'CdM1_Project';
						wsfilter = 'paktif = 1 AND pkode = "'+obj.proyek.split('"').join('\\"')+'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				if (dg1.dataProvider != null && parentApplication.rowIndex < dg1.dataProviderLength)
					var ob : Object = dg1.dataProvider[parentApplication.rowIndex];
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtnosiswa1':
							txtnosiswa1.text = obj.sinosiswa;
							break;
						case 'txtnosiswa2':
							txtnosiswa2.text = obj.sinosiswa;
							break;
						case 'txtkategorisiswa':
