					blcustomtext19:'', blcustomtext20:'', blcustomint1:0, blcustomint2:0, blcustomint3:0,
					blcustomint4:0, blcustomint5:0, blcustomint6:0, blcustomint7:0, blcustomint8:0, 
					blcustomint9:0, blcustomint10:0, blcustomint11:0, blcustomint12:0, blcustomint13:0, 
					blcustomint14:0, blcustomint15:0, blcustomint16:0, blcustomint17:0, blcustomint18:0, 
					blcustomint19:0, blcustomint20:0, blcustomint21:0, blcustomint22:0, blcustomint23:0, blcustomint24:0, blcustomint25:0, blcustomdbl1:0, blcustomdbl2:0, blcustomdbl3:0,
					blcustomdbl4:0, blcustomdbl5:0, blcustomdbl6:0, blcustomdbl7:0, blcustomdbl8:0, blkategorisiswa:0,
					blcustomdbl9:0, blcustomdbl10:0, blcustomdbl11:0, blcustomdbl12:0, blcustomdbl13:0,
