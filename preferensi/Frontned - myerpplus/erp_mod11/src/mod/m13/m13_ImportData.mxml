			protected function f_simpan():void{
				validasi = true;
				pesanAlert = "";
				if(txtfile.text == "")FlexGlobals.topLevelApplication.msgAlert(txtfile,'File');
				if(cmbimport.selectedIndex == 3){
					if(txtgudang.text == "")FlexGlobals.topLevelApplication.msgAlert(txtgudang,'Gudang');
				}
				
				if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
				if(validasi == true){
					switch (cmbimport.selectedIndex){
						case 0: //Import Master Kontak
							f_SetArraySimpanKontak();
							break;
					}
				}
			}
			
			
