			public function f_keydown(e:KeyboardEvent):void{
				switch(e.keyCode){
					case Keyboard.F12:
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
						FlexGlobals.topLevelApplication.F_acAdd(dgImport);
						f_browseFile();
						break;
					case Keyboard.N:
						if(e.ctrlKey){
							FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
							FlexGlobals.topLevelApplication.F_acAdd(dgImport);
							f_browseFile();
						}
						break;
					case Keyboard.DELETE:
						o.arr = new ArrayCollection([dgImport.dataProvider[dgImport.selectedCell.rowIndex]]);
						break;
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
				}
			}
			
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBoxHeader':
						for (i=0; i<dgImport.dataProviderLength; i++){
							dgImport.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case 'checkBox':
						dgImport.dataProvider.getItemAt(dgImport.selectedCell.rowIndex).chk = data;
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgImport);
			}
			
			private function f_browseFile():void
			{
				var arr:Array = [];
				arr.push(new FileFilter("Excel File","*.xls"));
				fileReference.browse(arr);
