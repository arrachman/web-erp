			public function f_wsHasil():void
			{
				var ws:Object;
				if(FlexGlobals.topLevelApplication.wsSuccess == true){
					switch (FlexGlobals.topLevelApplication.subject){
						case 'simpan':
							berhasil ++;
							f_UlangImport();
							break;
						case 'Uploading':
							FlexGlobals.topLevelApplication.F_wsSearch('tampilFile', 'M2_FilesSearch', 1, 1, 'fsumber = "SI" AND fidtransaksi = "0"', 'finputtgl desc');
							break;
						case 'tampilFile':
							navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f13/SI/"+FlexGlobals.topLevelApplication.wsArrUtama[0].fnamafile));
							break
						
					}
				}
				else{
					if(parentApplication.F_validasiFalse(FlexGlobals.topLevelApplication.subject) == true){
						switch (FlexGlobals.topLevelApplication.subject){
							case "simpan":
								gagal ++;
								acSimpan[index].gagal = 1;
								acSimpan[index].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangImport();
								if(FlexGlobals.topLevelApplication.wsErrmessage == "Invalid Website Access Key."){
									btnlanjut.enabled = true;
								}
								break;							
							case 'Uploading':
								navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f13/SI/Data Gagal Import_"+jmlfile+".xls"));
								break;
							
						}
					}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "simpan":
						gagal ++;
						acSimpan[index].gagal = 1;
						acSimpan[index].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
						f_UlangImport();
						if(FlexGlobals.topLevelApplication.wsErrmessage == "Invalid Website Access Key."){
							btnlanjut.enabled = true;
						}
						break;					
				}
			}
			public var jmlfile : int = 0;
			public function f_writeExcel():void{				
				var excelFile:ExcelFile = new ExcelFile();
				//ambil sheet pertama
				var sheet : Sheet = new Sheet;
				var arrKode : Array = kodegagalimport.split("^|^"); 
				var arrDesk : Array = deskripsi.split("^|^");
				var fr:FileReference = new FileReference;
				
				for(var a:int = 0; a<acSimpan.length; a++){
					if(acSimpan[a].gagal == 1){
						if(cmbimport.selectedIndex == 0){
							sheet.setCell(0, 0, "No Siswa ");
							sheet.setCell(0, 1, "Deskripsi ");
							sheet.setCell(a+1,0,acSimpan[a].sinosiswa);
							sheet.setCell(a+1,1,acSimpan[a].deskripsi);
						}						
						excelFile.sheets.addItem(sheet);
						
					}
				}
				FlexGlobals.topLevelApplication.F_wsUpload('Uploading', 'UploadFile', FlexGlobals.topLevelApplication.userid, "SI", "xls", excelFile.saveToByteArray(), 0, "Data Gagal Import.xls", "", "0", FlexGlobals.topLevelApplication.DefaultTanggalforDB, 0, 0, '', '');
			}
			
			public function f_UlangImport():void{
				if(index < jmlProgress - 1){
					switch(cmbimport.selectedIndex){
						case 0: //kontak
							index ++;
							f_ImportKontak1();
							break;
					}
				}else{
					index = 0;
					jmlProgress = 0;
					f_sendProgress('Import Data Done', true);
					lblProses.text = "Import Data Done";
					lblPersen.text = "100 %";
					if(gagal>0){
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal \n Apakah anda ingin download data yang gagal?", "Informasi", 3, null, function (e:Object):void{
							
							if(e.detail == Alert.YES){
								f_writeExcel();
							}
							
							f_kondisiAwal();
							
						});
					}else{
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal.", "Informasi", 4, null, function ():void{
							
							f_kondisiAwal();
							
						});
					}
					
				}
			}
			
			protected function btnambildata_clickHandler(event:MouseEvent):void
			{
				if(txtfile.text.length > 0){
					F_SetDataExcel();
					
				}else{
					Alert.show("File harus dipilih terlebih dahulu", "Informasi")
				}
			}
			
			public function f_sendProgress(data:String, status:Boolean):void
			{
				j++;
				if(status == true){
					if(j > jmlProgress){
						close = true;
						return;
					}
					lblProses.text = data;
				}else{
					lblProses.text = parentApplication.l("Upload failed")+" "+data;
					close = true;
					return;
				}
				num += 100/jmlProgress;
				pb.setProgress(num, 100);
				lblPersen.text = String(uint(num))+" %";
			}
			public function f_cmbimport():void{
				switch(cmbimport.selectedIndex){
					case 0:
						grpmappingfield.top = 156;
						f_setVisibleGroup([grpmappingfield],[grpIB, grpAP, grpAR, grpCoA]);
						break;					
				}
			}
			public function f_setVisibleGroup(grpvisibletrue:Array, grpvisiblefalse:Array):void{
				var i:int;
				for(i = 0; i<grpvisibletrue.length; i++){
					grpvisibletrue[i].visible = true
				}
				for(i = 0; i<grpvisiblefalse.length; i++){
					grpvisiblefalse[i].visible = false;
				}
				
			}
			
