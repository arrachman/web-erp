									validasifield = false;
									namakolom = "No Siswa";
									break;
								}else if(dgimp.sinamasiswa == undefined){ //JIKA SUMBER KATEGORI KONTAK KOSONG / UNDEFINED
									validasifield = false;
									namakolom = "Nama Siswa";
									break;
								}
								//JIKA ADA FIELD YANG TIDAK WAJIB DAN KOLOM SUMBERNYA UNDEFINED, DISET KOSONG==================================
								if(validasifield == true){
									dgimp[dgmap.namafield] = ""
									
								}
								//==============================================================================================================
							}
							
						}
						
						acSimpan.addItem({siid:0, sitahunajaran:dgimp.sitahunajaran, sikategorisiswa:1, sinosiswa:dgimp.sinosiswa, 
