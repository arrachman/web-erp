			//Set Data dari excel ke dg Import=========================================================================================================================================
			public var rowindex:int = 1, columnindex : int = 0;
			public function F_SetDataExcel():void{
				//Ambil Byte Array file excel yang terpilih
				var excelFile:ExcelFile = new ExcelFile();
				excelFile.loadFromByteArray(bytearrayexcel);
				//ambil sheet pertama
				var sheet : Sheet = excelFile.sheets[cmbsheet.selectedIndex];
				//variabel jumlah baris dan jumlah kolom
				var noOfRows:int = 0, noOfColumns:int = 0;
				noOfRows = sheet.rows; //jumlah data
				noOfColumns = sheet.cols; //jumlah kolom
				
				//var nama kolom, datafield, untuk penamaan dan datafield kolom
				var namakolom:String = "";
				var datafield:String = "";
				
				//Set nama kolom dan jumlah kolom dgImport==============================================================
				//hapus kolom terlebih dahulu sebelum direplace
				for(var jmlcolumn : int = dgImport.columnsLength -1; jmlcolumn > 0; jmlcolumn --){
					dgImport.columns.removeItemAt(jmlcolumn);
				}
				
				//Set nama kolom dan datafield dalam string
				for(var column : int = 0; column < noOfColumns; column++){
					if(namakolom.length == 0) {namakolom = sheet.getCell(0,column).value}
					else{namakolom += ","+sheet.getCell(0,column).value}
					
					if(datafield.length == 0) {
						datafield = sheet.getCell(0,column).value.split(" ").join("").toLowerCase()
					}
					else{datafield += ","+sheet.getCell(0,column).value.split(" ").join("").toLowerCase()}
				}
				datafield = datafield.split("[%]").join("persen");
				datafield = datafield.split("(%)").join("persen");
				datafield = datafield.split("%").join("persen");
				ArrayNamaKolom = namakolom.split(","); //split penamaan kolom ke dalam bentuk array
				ArrayDataField = datafield.split(","); //split datafield kolom ke dalam bentuk array
				
				
				//set kolom di dgimport ==============================================================================
				for each (var field:String in ArrayNamaKolom)  
				{  
					
					var myColumn:GridColumn = new GridColumn(); 
					myColumn.width = 150;
					myColumn.editable = false;
					myColumn.headerText = field;
					field = field.split(" ").join("");
					field = field.split("[%]").join("persen");
					field = field.split("(%)").join("persen");
					field = field.split("%").join("persen");
					myColumn.dataField = field.toLowerCase();
					dgImport.columns.addItem(myColumn);
				} 
				
				gridColumns.refresh();  
				
				
				//END Set nama kolom dan jumlah kolom dgImport==============================================================
				
				
				//SET data provider dari excel ke dgImport==================================================================
				
				var LabelField:Object = new Object;
				dgImport.dataProvider.removeAll();
				
				f_setDatatoGrid(rowindex, columnindex);
				
				function f_setDatatoGrid(row:int, column:int):void{
					LabelField  = new Object;
					for(var clm : int = 0; clm < noOfColumns; clm++){
						if(sheet.getCell(row,0).value.length != ""){
							LabelField[ArrayDataField[clm]] = sheet.getCell(row,clm).value; //set data provider dgImport
						}
					}
					
					dgImport.dataProvider.addItem(LabelField) //tambah data provider dgImport
					
					if(row < noOfRows - 1){ //jika jumlah data di array kurang dari jumlah data di excel
						row ++;
						f_setDatatoGrid(row, column);
						
					}
					
				}
				//END of SET data provider dari excel ke dgImport==================================================================
				
				//Set Data Provider Combo Box Sumber dgMapping
				F_SetMapping(); 
				acKolomSumber.removeAll();
				var kolomexcelsama : Boolean;
				if(ArrayNamaKolom.length > 0){
					for(var a:int = 0; a<ArrayNamaKolom.length; a++){
						acKolomSumber.addItem({l:ArrayNamaKolom[a], v:ArrayDataField[a]});
					}
					acKolomSumber.addItem({l:"", v:""});
					for(var i:int; i<dgMapping.dataProviderLength; i++){
						for(var arrdflengtth:int = 0; arrdflengtth < ArrayDataField.length; arrdflengtth ++){
							kolomexcelsama = false;
							if(dgMapping.dataProvider[i].kolomexcel == ArrayNamaKolom[arrdflengtth]){
								f_setKolomExcel(i, ArrayDataField[arrdflengtth])
								kolomexcelsama = true;
							}
							
						}
						if(kolomexcelsama = false){
							f_setKolomExcel(i, "")
						}
						
					}
					
				}				
			}
			
