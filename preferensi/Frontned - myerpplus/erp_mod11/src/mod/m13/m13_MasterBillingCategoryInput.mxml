			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtakunpiutang':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd = "D" AND cnomor = "'+txtakunpiutang.text.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 AND cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'txtakunpendapatan':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd = "D" AND cnomor = "'+txtakunpendapatan.text.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 AND cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'txtakundenda':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd = "D" AND cnomor = "'+txtakundenda.text.split('"').join('\\"')+'"';
						csfilter = 'caktif=1 AND cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtakunpiutang':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtakunpiutang.text = o.cnomor; 
							lblakunpiutang.text = o.cnama;
							break;
						case 'txtakunpendapatan':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtakunpendapatan.text = o.cnomor; 
							lblakunpendapatan.text = o.cnama;
							break;
						case 'txtakundenda':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtakundenda.text = o.cnomor;
							lblakundenda.text = o.cnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtakunpiutang': txtakunpiutang.text = '';lblakunpiutang.text = ''; break;
							case 'txtakunpendapatan':txtakunpendapatan.text = '';lblakunpendapatan.text = '';break;
							case 'txtakundenda':txtakundenda.text = '';lblakundenda.text = '';break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtakunpiutang': parentApplication.F_KosongkanText([txtakunpiutang,lblakunpiutang]); break;
					case 'txtakunpendapatan':parentApplication.F_KosongkanText([txtakunpendapatan,lblakunpendapatan]);break;
					case 'txtakundenda':parentApplication.F_KosongkanText([txtakundenda,lblakundenda]);break;
				}
			}
			
