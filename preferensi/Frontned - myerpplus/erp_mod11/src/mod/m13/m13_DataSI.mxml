<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.TitleWindow;
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array, idkontak:int, iduser:String='', t:TitleWindow;
			private var p:Object; public var o:Object = {};
			public function f_focusOnMe():void
			{
				txttahunakademik.setFocus();
			}
			
			public function f_persiapan():void
			{
				p=parentApplication;
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(13, 3);
				FlexGlobals.topLevelApplication.F_TranslateLabel([ttahunakademik, tfakultas, tprogramstudi, tkelas, tkategorisiswa, tsupplier, ttanggal, tnotransaksi, tjenislaporan, tcatatan, tinputuser, tnamapasien,talamat]);
				// module, menu transaksi, menu, sumber, approvell
				a = [13, 3, 7, 'Si', false];
				p.F_persiapanFormData(this);
				// Daftarkan fungsi-fungsi text input
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbjenislaporan]);
				p.F_txtpencarian([txtuser, txttahunakademik, txtfakultas, txtprogramstudi, txtkelas1, txtkelas2, txtkategorisiswa]);
				p.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2, txtcatatan,txtnamapasien,txtalamat]);
				txtnotransaksi2.addEventListener(FocusEvent.FOCUS_IN, f_change);
				function f_change():void{
					if(txtnotransaksi2.text == ''){
						txtnotransaksi2.text = txtnotransaksi1.text;	
					}
				}
				
				dttgl2.addEventListener(FocusEvent.FOCUS_IN, f_changedate);
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				f_kondisiAwal();
			}
			
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				cmbstatus.selectedIndex = o.DefaultStatus;
				//p.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				p.F_KosongkanText([txtnotransaksi1,txtnotransaksi2,txtuser,txtcatatan,txtnamapasien,txtalamat,txttahunakademik,txtfakultas,txtprogramstudi,txtkelas1,txtkelas2,txtkategorisiswa]);
				o.user = txtuser.text;
				dg.dataProvider.removeAll();
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				FlexGlobals.topLevelApplication.openForm(13, 3, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).siid);
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txttahunakademik':
						paket = 'CdM13_School_Year';
						wsfilter = "sykode ='"+txttahunakademik.text+"'";
						csfilter = "syaktif = 1";
						break;
					case 'txtfakultas':
						paket = 'CdM13_Faculty';
						wsfilter = "fnama ='"+txtfakultas.text+"'";
						csfilter = "faktif = 1";
						break;
					case 'txtprogramstudi':
						paket = 'CdM13_Study_Program';
						wsfilter = "spnama ='"+txtprogramstudi.text+"'";
						csfilter = "spaktif = 1";
						break;
					case 'txtkelas1':
						paket = 'CdM13_Class';
						wsfilter = "ckode ='"+txtkelas1.text+"'";
						csfilter = "caktif = 1";
						break;
					case 'txtkelas2':
						paket = 'CdM13_Class';
						wsfilter = "ckode ='"+txtkelas2.text+"'";
						csfilter = "caktif = 1";
						break;
					case 'txtkategorisiswa':
						paket = 'CdM13_Student_Category';
						wsfilter = "sckode ='"+txtkategorisiswa.text+"'";
						csfilter = "scaktif = 1";
						break;
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = "uaktif=1";
						wsfilter = "uaktif=1 ANd ukode ='"+txtuser.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public var fakultas:String = "", programstudi:String = "", kategorisiswa:int = 0;
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(p.wsSuccess == true){
					if(p.wsArrUtama.getItemAt.length >= 0)ws = p.wsArrUtama.getItemAt(0)
					switch(s){
						case 'txtuser':
							txtuser.text = ws.ukode;
							iduser = ws.userid;
							break;
 						case 'txttahunakademik':
							txttahunakademik.text = ws.sykode;
							break; 
						case 'txtfakultas':
							fakultas = ws.fkode;
							txtfakultas.text = ws.fnama;
							break;
						case 'txtprogramstudi':
							programstudi = ws.spkode;
							txtprogramstudi.text = ws.spnama;
							break;
						case 'txtkelas1':
							txtkelas1.text = ws.ckode;
							break;
						case 'txtkelas2':
							txtkelas2.text = ws.ckode;
							break;
						case 'txtkategorisiswa':
							kategorisiswa = ws.scid;
							txtkategorisiswa.text = ws.sckode;
							break;
					}
				}else{
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtuser':p.F_KosongkanText([txtuser]);break;
					case 'txttahunakademik':p.F_KosongkanText([txttahunakademik]);break;
					case 'txtfakultas':p.F_KosongkanText([txtfakultas]);fakultas = "";break;
					case 'txtprogramstudi':p.F_KosongkanText([txtprogramstudi]);programstudi = "";break;
					case 'txtkelas1':p.F_KosongkanText([txtkelas1]);break;
					case 'txtkelas2':p.F_KosongkanText([txtkelas2]);break;
					case 'txtkategorisiswa':p.F_KosongkanText([txtkategorisiswa]);kategorisiswa = 0;break;
				}
			}
			
			public function f_filterdata():String{
				txtlokasi.text = "";
				var f:String="";
				f = FlexGlobals.topLevelApplication.F_standartFilter();
				if(txtuser.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'siinputuser = "'+iduser+'"');
				if(txtnotransaksi1.text!='' && txtnotransaksi2.text == '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sinosiswa = "'+txtnotransaksi1.text+'"');
				if(txtnotransaksi1.text=='' && txtnotransaksi2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sinosiswa = "'+txtnotransaksi2.text+'"');
				if(txtnotransaksi1.text!='' && txtnotransaksi2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sinosiswa Between "'+txtnotransaksi1.text+'" AND "'+txtnotransaksi2.text+'"');
				if(txtnamapasien.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sinamasiswa Like "%'+txtnamapasien.text+'%"');
				if(txtalamat.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sialamatsekarang Like "%'+txtalamat.text+'%"');
				if(txttahunakademik.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sitahunajaran = "'+txttahunakademik.text+'"');
				if(txtfakultas.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sifakultas = "'+fakultas+'"');
				if(txtprogramstudi.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'siprogramstudi = "'+programstudi+'"');
				if(txtkelas1.text!='' && txtkelas2.text == '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sikelas = "'+txtkelas1.text+'"');
				if(txtkelas1.text=='' && txtkelas2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sikelas = "'+txtkelas2.text+'"');
				if(txtkelas2.text!='' && txtkelas1.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sikelas Between "'+txtkelas1.text+'" AND "'+txtkelas2.text+'"');
				if(txtkategorisiswa.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sikategorisiswa = '+kategorisiswa);
				return f;
			}
			
			public function f_hitungTotal():void{}
