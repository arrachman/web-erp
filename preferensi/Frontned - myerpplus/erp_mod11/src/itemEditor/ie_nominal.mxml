<?xml version="1.0" encoding="utf-8"?>	
<s:GridItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009" 
				  xmlns:s="library://ns.adobe.com/flex/spark" 
				  xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.formatters.NumberFormatter;
			
			[Bindable] [Embed(source="assets/main/calculator.png")]  public var tbcalculator:Class;
			
			override public function set value(newValue:Object):void 
			{
				txt.text = String(newValue);
				txt.text = txt.text.split('.').join(parentApplication.m.nfNominal.decimalSeparator);
			}
			
			override public function get value():Object 
			{
				return eval(txt.text);
			}
			
			override public function setFocus():void 
			{
				txt.setFocus();
			}
			
			protected function ns_creationCompleteHandler(event:FlexEvent):void
			{
				txt.restrict = parentApplication.m.nfNominal.decimalSeparator+"0-9\\-+/*()";
				txt.maxChars = 15;
			}
			
			protected function img_clickHandler(event:MouseEvent):void
			{ 
				FlexGlobals.topLevelApplication.F_toolCalculator(txt.text, column.dataField);
			}
			
			
			protected function txt_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.F12)
					parentApplication.F_toolCalculator(txt.text, column.dataField);
			}
			
			private function eval(str:String):String
			{ 
				var s:String = ExternalInterface.call("eval", str.split(parentApplication.m.nfNominal.decimalSeparator).join('.'));
				if(Number(s))
					return s
				else 
					return '0';
			}
			
		]]>
	</fx:Script>
	
	<s:TextInput id="txt" right="25" width="100%" height="100%" creationComplete="ns_creationCompleteHandler(event)" keyDown="txt_keyDownHandler(event)" />
	<s:Image id="img" source="{tbcalculator}" top="2" right="2" useHandCursor="true" buttonMode="true" mouseChildren="false" click="img_clickHandler(event)"/>
</s:GridItemEditor>