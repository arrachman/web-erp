<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:net="flash.net.*"
		  width="602" height="372" creationComplete="f_Persiapan()"
		  keyDown="f_keydown(event)">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/add.png")]  public var tbadd:Class;
			[Bindable] [Embed(source="assets/tb/help.png")]  public var tbhelp:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
			
			public var module:String,inputuser:int,inputtgl:String,modifikasiuser:int,modifikasitgl:String
			public var o:Object = {}, no:int, i:int, jum:int, arr:ArrayCollection, urutan:int, moduleid:int;
			protected var sumber:String, idtransaksi:String, id2:String = '';
			public var validasi:Boolean, pesanAlert:String;
			public function f_Persiapan():void{
				txtbagianpenyesuaian.setFocus();

				sumber = FlexGlobals.topLevelApplication.m.ArrFilter[0];
				idtransaksi = FlexGlobals.topLevelApplication.m.ArrFilter[1];
				FlexGlobals.topLevelApplication.F_txtpencarian([txtbagianpenyesuaian, txtgudang, txtjenispenyesuaian]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttanggal]);
				dttanggal.text = FlexGlobals.topLevelApplication.DefaultTanggal;
				FlexGlobals.topLevelApplication.F_RequiredLabel([tbagpenyesuaian, tgudang, tjenispenyesuaian]);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtbagianpenyesuaian, lblbagianpenyesuaian, txtgudang, lblgudang, txtjenispenyesuaian, lbljenispenyesuaian]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txturaian, txtcatatan]);
				moduleid = FlexGlobals.topLevelApplication.m.mod[parentApplication.idmodcurr].moduleid;
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbClose);
				FlexGlobals.topLevelApplication.F_RegGrid(3, 6, [dgImport], 'transaksi');
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].namafile_d = 1;
				txturaian.text = parentApplication.getNomor("SA");
				function f_mbSimpan():void{
					f_simpan();
				}
				
//				function f_mbTambah():void{
//					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
//					if(dgImport.dataProvider[0].namafile != '')
//						FlexGlobals.topLevelApplication.F_acAdd(dgImport);
//					f_browseFile();
//				}
				
				function f_mbClose():void{
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
				}
			}
			
			protected function f_simpan():void{
				validasi = true;
				pesanAlert = "";
				if(txtbagianpenyesuaian.text == "")FlexGlobals.topLevelApplication.msgAlert(txtbagianpenyesuaian,'Kontak');
				if(txtgudang.text == "")FlexGlobals.topLevelApplication.msgAlert(txtgudang,'Gudang');
				if(txtjenispenyesuaian.text == "")FlexGlobals.topLevelApplication.msgAlert(txtjenispenyesuaian,'Jenis Penyesuaian');
				if(dttanggal.text == "")FlexGlobals.topLevelApplication.msgAlert(dttanggal,'Tanggal');
				if(dgImport.dataProvider[0].namafile == "" || dgImport.dataProvider[0].namafile == undefined)FlexGlobals.topLevelApplication.msgAlert(dgImport,'Nama File');
				
				if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
				if(validasi){
					FlexGlobals.topLevelApplication.F_wsSimpan('TruncateTablel', 'M12_TruncateTable', parentApplication.userid, false, dgImport.dataProvider[i].namafile);
				}
			}
			public var namafile:String = "";
			protected function f_simpan2():void{
				FlexGlobals.topLevelApplication.vpFocusEvent = true;
//				FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
				if(dgImport.dataProvider[0].namafile != '' || dgImport.dataProvider[0].namafile != undefined){
					jum = 0;
					arr = new ArrayCollection;
					for(i=0;i<dgImport.dataProviderLength;i++)
						if(dgImport.dataProvider[i].status == 'Belum'){
							jum++;
							arr.addItem(dgImport.dataProvider[i]);
						}
					if(jum == 0){
						//if(o.edit)
						//Alert.show(FlexGlobals.topLevelApplication.l('File sudah terupload semua'), FlexGlobals.topLevelApplication.l('Validasi'));
						return;
					}
					no = 0;
					FlexGlobals.topLevelApplication.F_wsSimpan('Download3', 'M0_ExecuteDbFile', parentApplication.userid, false, dgImport.dataProvider[i].namafile);
//						FlexGlobals.topLevelApplication.F_wsUpload('Uploading', 'importdata', FlexGlobals.topLevelApplication.userid, "importdata", arr[no].type, arr[no].file, idtransaksi, arr[no].namafile, arr[no].fcatatan, arr[no].fukuranfile, FlexGlobals.topLevelApplication.F_tglFormatDB(arr[no].ftanggal), 0, 0, '', 'finputtgl');
				}else Alert.show(FlexGlobals.topLevelApplication.l('DataGrid Kosong', FlexGlobals.topLevelApplication.l('Informasi')));
				
			} 
			public var index:int = 0;
			protected function f_import():void{
				var dataUtama:String="", a:Array;
				a = [0, "imp", 0, 0, 
					FlexGlobals.topLevelApplication.F_tglFormatDB(dttanggal.text)+"|"+kontak+"|"+txtjenispenyesuaian.text+"|"+txturaian.text+"|"+txtcatatan.text+"|"+txtgudang.text, FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal), 
					FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal), FlexGlobals.topLevelApplication.userid, "m3_sa_detail", namafile];
				dataUtama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
				
				FlexGlobals.topLevelApplication.F_wsSimpan("import", "M0_ImportdataSimpan",FlexGlobals.topLevelApplication.userid, false,dataUtama, "SA$")
					
			}
			
				
			protected function f_hapus():void{
				if(dgImport.selectedCell != null){
					no = dgImport.selectedCell.rowIndex;
					if(o.FormFilter == 'master')
						FlexGlobals.topLevelApplication.F_wsDelete('tampil', 'M'+moduleid+'_FilesDelete', FlexGlobals.topLevelApplication.userid, dgImport.dataProvider[no].fsumber+'△'+dgImport.dataProvider[no].fidtransaksi+'△'+dgImport.dataProvider[no].namafile+'△'+id2, 0, 0, '', 'finputtgl');
					else
						FlexGlobals.topLevelApplication.F_wsDelete('tampil', 'M'+moduleid+'_FilesDelete', FlexGlobals.topLevelApplication.userid, dgImport.dataProvider[no].fsumber+'△'+dgImport.dataProvider[no].fidtransaksi+'△'+dgImport.dataProvider[no].namafile, 0, 0, '', 'finputtgl');
					if(dgImport.dataProvider[no].namafile_d == 1){
						dgImport.dataProvider.removeItemAt(no)
					}
				}else Alert.show(FlexGlobals.topLevelApplication.l('Pilih data dulu', FlexGlobals.topLevelApplication.l('Informasi')));
			}
			
			public function f_keydown(e:KeyboardEvent):void{
				switch(e.keyCode){
					case Keyboard.F12:
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
						FlexGlobals.topLevelApplication.F_acAdd(dgImport);
						f_browseFile();
						break;
					case Keyboard.N:
						if(e.ctrlKey){
							FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
							FlexGlobals.topLevelApplication.F_acAdd(dgImport);
							f_browseFile();
						}
						break;
					//					case Keyboard.D:
					//						if(e.ctrlKey)
					//							f_hapus();
					//						break;
					case Keyboard.DELETE:
						o.arr = new ArrayCollection([dgImport.dataProvider[dgImport.selectedCell.rowIndex]]);
						break;
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
				}
			}
			
			public var tanggal:String = "", kontak:int = 0, jenispenyesuaian:String, uraian:String, catatan:String;
			public function f_kondisiAwal():void{
				tanggal = FlexGlobals.topLevelApplication.m.ArrFilter[0];
				kontak = FlexGlobals.topLevelApplication.m.ArrFilter[1];
				jenispenyesuaian = FlexGlobals.topLevelApplication.m.ArrFilter[2];
				uraian = FlexGlobals.topLevelApplication.m.ArrFilter[3];
				catatan = FlexGlobals.topLevelApplication.m.ArrFilter[4];
				
			}
			public function f_wsHasil():void
			{
				var ws:Object;
				if(FlexGlobals.topLevelApplication.wsSuccess){
					switch (FlexGlobals.topLevelApplication.subject){
						case "Uploading":
							
							
							namafile = FlexGlobals.topLevelApplication.vData[0];
							f_import()
							break;
						case "import":
							FlexGlobals.topLevelApplication.closeFormPopUp(1);
							Alert.show("Import Data Berhasil", "Informasi")
							break
						case "txtbagianpenyesuaian":
							ws = FlexGlobals.topLevelApplication.wsArrUtama[0];
							kontak = ws.kid;
							txtbagianpenyesuaian.text = ws.kkode;
							lblbagianpenyesuaian.text = ws.knama;
							break;
						case "txtjenispenyesuaian":
							ws = FlexGlobals.topLevelApplication.wsArrUtama[0];
							txtjenispenyesuaian.text = ws.tsakode;
							lbljenispenyesuaian.text = ws.tsanama
							break;
						case "txtgudang":
							ws = FlexGlobals.topLevelApplication.wsArrUtama[0];
							txtgudang.text = ws.wkode;
							lblgudang.text = ws.wnama;
							break;
					}
				}
				else{
					if(parentApplication.F_validasiFalse(FlexGlobals.topLevelApplication.subject)){
						switch (FlexGlobals.topLevelApplication.subject){
							case "simpan":
							case "import":
								Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, "Informasi");
								break
							case "txtbagianpenyesuaian":
								ws = FlexGlobals.topLevelApplication.wsArrUtama[0];
								kontak = ws.kid;
								txtbagianpenyesuaian.text = "";
								lblbagianpenyesuaian.text = "";
								break;
							case "txtjenispenyesuaian":
								ws = FlexGlobals.topLevelApplication.wsArrUtama[0];
								txtjenispenyesuaian.text = "";
								lbljenispenyesuaian.text = "";
								break;
							case "txtgudang":
								ws = FlexGlobals.topLevelApplication.wsArrUtama[0];
								txtgudang.text = "";
								lblgudang.text = "";
								break;
						}
					}
						
					
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "uploadfile":
							f_browseFile();
						break;
					
				}
			}
			
			private function f_browseFile():void
			{
				var arr:Array = [];
				arr.push(new FileFilter("All","*.*"));
				fileReference.browse(arr);
			}
			
			private function fileReference_select(evt:Event):void {
				if(fileReference.size > 2000000){Alert.show(FlexGlobals.topLevelApplication.l('Kapasitas File tidak boleh lebih dari 2 MB !', 1), FlexGlobals.topLevelApplication.l('Informasi'));}
				else {fileReference.load();}
			}
			
			private function fileReference_complete(evt:Event):void {
				f_hasil(fileReference.size, fileReference.name);
			}
			
			public function f_hasil(size:Number, namafile:String):void
			{
				var satuan:String; var sizefile:String;
				
				if (size >= 1000000){ size=size/1000000; satuan = 'MB';}
				else if (size >= 1000){size=size/1000; satuan = 'KB';}	
				else{ satuan = 'Byte';}
				
				sizefile = FlexGlobals.topLevelApplication.m.nfNominal.format(size)+" "+satuan;
				//Set Nilai dg
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].namafile = namafile;
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].namafile_d = 1;
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].fdownload_d = 0;
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].fukuranfile = sizefile;
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].fcatatan = '';
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].ftanggal = FlexGlobals.topLevelApplication.DefaultTanggal;
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].file =  fileReference.data;
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].type =  fileReference.type;
				dgImport.dataProvider[dgImport.selectedCell.rowIndex].status = 'Belum';
				if(o.FormFilter == 'master')
					dgImport.dataProvider[dgImport.selectedCell.rowIndex].fdefault = 0;
				dgImport.dataProvider.setItemAt(dgImport.dataProvider[dgImport.selectedCell.rowIndex], dgImport.selectedCell.rowIndex);
				
				cmbDefault.dataProvider = new ArrayCollection;
				for(i=0;i<dgImport.dataProviderLength;i++){
					if(int(dgImport.dataProvider[i].fdefault) == 1)
						cmbDefault.selectedIndex = i;
					cmbDefault.dataProvider.addItem({l:dgImport.dataProvider[i].namafile});
				}
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				o.a = column.split('|');
				if(column == 'add' || o.a[0] == 'add')
				{
					if(o.a.length > 1)
					{
						dgImport.dataProvider[o.a[1]].fdownload_d = 0;
						dgImport.dataProvider[o.a[1]].namafile_d = 1;
					}
					else
					{
						dgImport.dataProvider[dgImport.dataProviderLength-1].fdownload_d = 0;
						dgImport.dataProvider[dgImport.dataProviderLength-1].namafile_d = 1;
					}
				}
				else if(column == 'del'){
					cmbDefault.dataProvider = new ArrayCollection;
					for(i=0;i<dgImport.dataProviderLength;i++){
						if(int(dgImport.dataProvider[i].fdefault) == 1)
							cmbDefault.selectedIndex = i;
						cmbDefault.dataProvider.addItem({l:dgImport.dataProvider[i].namafile});
					}
					no = 0;
					if(o.arr[no].namafile_d != 1)
						FlexGlobals.topLevelApplication.F_wsDelete('tampil', 'M'+moduleid+'_FilesDelete', FlexGlobals.topLevelApplication.userid, o.arr[no].fsumber+'△'+o.arr[no].fidtransaksi+'△'+o.arr[no].namafile+'△'+id2, 0, 0, '', 'finputtgl');
				}else if(column == 'fcatatan' || column == 'ftanggal')
					if(dgImport.dataProvider[dgImport.selectedCell.rowIndex].namafile_d == 0){
						dgImport.dataProvider[dgImport.selectedCell.rowIndex].edit = 'ya';
					}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtbagianpenyesuaian":
						paket = 'CdM12_Contact';
						wsfilter = '(kaktif=1) AND kkode ="'+txtbagianpenyesuaian.text+'"';
						csfilter = '(kaktif=1)';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtgudang":
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode ="'+txtgudang.text+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case "txtjenispenyesuaian":
						paket = 'CdM1_Type_Sa';
						wsfilter = 'tsaaktif = 1 AND tsakode ="'+txtjenispenyesuaian+'"';
						csfilter = 'tsaaktif = 1';
						sort = 'tsakode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
				
				
			}
			
			protected function cmbDefault_changeHandler(event:IndexChangeEvent):void
			{
				for(i=0;i<dgImport.dataProviderLength;i++)
					dgImport.dataProvider[i].fdefault = 0;
				if(cmbDefault.selectedIndex >= 0)
					dgImport.dataProvider[cmbDefault.selectedIndex].fdefault = 1;
				for(i=0;i<dgImport.dataProviderLength;i++)
					dgImport.dataProvider[i].edit = 'ya';
				FlexGlobals.topLevelApplication.F_dgRefresh(dgImport);
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="xmlListColl">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan" icon="tbsave" enabled="true"/>
					<topmenu label="Batal" icon="tbclose" enabled="true"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
		<net:FileReference id="fileReference" select="fileReference_select(event)" complete="fileReference_complete(event)" />
	</fx:Declarations>
	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{xmlListColl}" iconField="@icon" labelField="@label"/>
	<s:Label id="lblDefault" x="10" y="43" text="Default" visible="false"/>
	<s:ComboBox id="cmbDefault" x="57" y="38" visible="false" change="cmbDefault_changeHandler(event)"/>
	<s:DataGrid id="dgImport" left="0" right="0" top="176" bottom="0"/>
	<s:Group left="10" top="35" height="133">
		<s:Label id="tbagpenyesuaian" left="0" top="5" text="Kontak" visible="true"/>
		<s:Label id="tgudang" left="0" top="48" text="Gudang"/>
		<s:Label id="tjenispenyesuaian" left="0" top="69" text="Jenis Penyesuaian"/>
		<s:Label id="turaian" left="0" top="91" text="Uraian"/>
		<s:TextInput id="txtbagianpenyesuaian" left="124" top="0" visible="true"/>
		<mx:DateField id="dttanggal" x="124" y="21" width="153"/>
		<s:TextInput id="txtgudang" left="124" top="43"/>
		<s:TextInput id="txtjenispenyesuaian" left="124" top="64"/>
		<s:Label id="lblbagianpenyesuaian" left="275" top="5" visible="true"/>
		<s:Label id="lblgudang" left="275" top="49"/>	
		<s:Label id="lbljenispenyesuaian" left="275" top="70"/>
		<s:TextInput id="txturaian" left="124" top="85" width="300"/>
		<s:Label id="tcatatan" left="0" top="111" text="Catatan"/>
		<s:TextInput id="txtcatatan" left="124" top="106" width="300"/>
		<s:Label id="ttanggal" left="1" top="27" text="Tanggal"/>
		
	</s:Group>
</s:Module>