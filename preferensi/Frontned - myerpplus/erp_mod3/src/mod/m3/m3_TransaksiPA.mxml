				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tnamabarang, tbagsetharga, tkodebarang, tfilter, tperubahannilai, tsetnilai, turaian, ttanggal, tnotransaksi, ttglberlaku, tuang, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref, ttipe, tkategoriharga, tkategoriharga0]);
