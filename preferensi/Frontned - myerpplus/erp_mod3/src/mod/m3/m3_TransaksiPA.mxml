			private function fileReference_complete(evt:Event):void {
				
				var excelFile:ExcelFile = new ExcelFile();
				excelFile.loadFromByteArray(fileReference.data);
				var sheet : Sheet = excelFile.sheets[0];
				F_SetDataExcel()
			}
			public var filterkontak:String = "";
			public function F_SetDataExcel():void{
				//Ambil Byte Array file excel yang terpilih
				var excelFile:ExcelFile = new ExcelFile();
				excelFile.loadFromByteArray(fileReference.data);
				//ambil sheet pertama
				var sheet : Sheet = excelFile.sheets[0];
				//variabel jumlah baris dan jumlah kolom
				var noOfRows:int = 0, noOfColumns:int = 0;
				noOfRows = sheet.rows; //jumlah data
				noOfColumns = sheet.cols; //jumlah kolom
				
				//var nama kolom, datafield, untuk penamaan dan datafield kolom
				var namakolom:String = "";
				var datafield:String = "";
				
				
				
				//var nama kolom, datafield, untuk penamaan dan datafield kolom
				
				var filterbarang:String = "";
				dg1.dataProvider.removeAll();
				for(var row:int = 1; row<=noOfRows; row++){
					if(sheet.getCell(row,1).value != ""){
						dg1.dataProvider.addItem({
							/* no : row,
							kodebarang : sheet.getCell(row,1).value,
							namabarang : sheet.getCell(row,2).value,
							hargajual1 : sheet.getCell(row,3).value,
							hargajual2 : sheet.getCell(row,4).value,
							hargajual3 : sheet.getCell(row,5).value,
							hargajual4 : sheet.getCell(row,6).value,
							hargajual5 : sheet.getCell(row,7).value,
							diskonjual1 : sheet.getCell(row,8).value,
							diskonjual2 : sheet.getCell(row,9).value,
							diskonjual3 : sheet.getCell(row,10).value,
							diskonjual4 : sheet.getCell(row,11).value,
							diskonjual5 : sheet.getCell(row,12).value,
							kontakkode : sheet.getCell(row,13).value,
							catatan : sheet.getCell(row,14).value */
							no : row,
							kodebarang : sheet.getCell(row,1).value,
							namabarang : sheet.getCell(row,2).value,
							hargajual1 : sheet.getCell(row,3).value,
							hargajual2 : sheet.getCell(row,4).value,
							hargajual3 : sheet.getCell(row,5).value,
							hargajual4 : sheet.getCell(row,6).value,
							hargajual5 : sheet.getCell(row,7).value,
							hargajual6 : sheet.getCell(row,8).value,
							hargajual7 : sheet.getCell(row,9).value,
							hargajual8 : sheet.getCell(row,10).value,
							hargajual9 : sheet.getCell(row,11).value,
							hargajual10 : sheet.getCell(row,12).value,
							diskonjual1 : sheet.getCell(row,13).value,
							diskonjual2 : sheet.getCell(row,14).value,
							diskonjual3 : sheet.getCell(row,15).value,
							diskonjual4 : sheet.getCell(row,16).value,
							diskonjual5 : sheet.getCell(row,17).value,
							diskonjual6 : sheet.getCell(row,18).value,
							diskonjual7 : sheet.getCell(row,19).value,
							diskonjual8 : sheet.getCell(row,20).value,
							diskonjual9 : sheet.getCell(row,21).value,
							diskonjual10 : sheet.getCell(row,22).value,
							kontakkode : sheet.getCell(row,23).value,
							catatan : sheet.getCell(row,24).value
						});
					}
					
					if(row == 1){
						filterbarang = "bkode = '"+sheet.getCell(row,1).value+"'";
						filterkontak = "kkode = '"+sheet.getCell(row,13).value+"'"
					}else{
						filterbarang += " OR bkode = '"+sheet.getCell(row,1).value+"'"
						filterkontak += " OR kkode = '"+sheet.getCell(row,13).value+"'"
					}
				}
					
				FlexGlobals.topLevelApplication.F_wsSearch("AmbilIDBarang", "CdM1_Item", 0, 0, filterbarang, "", "bkode asc")
//				else if(cmbtipe.selectedIndex == 1){
//					if(txtkategoripos.text.length > 0){
//						FlexGlobals.topLevelApplication.F_wsSearch('AmbilIDBarang', 'CdM12_ItemCategoryPOS', 0, 0, filterbarang, strSort,"", "", txtkategoripos.text);
//					}else{
//						Alert.show("Kategori POS harus diisi terlebih dahulu", "Informasi");
//					}
//					
//				}
				
				
				
			}
			
