			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 3, "PA");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_PaHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
							idtransaksi = parentApplication.m.ArrFilter[0];
							idtransaksi = idtransaksi.replace('p1  = "', '');
							idtransaksi = idtransaksi.replace('"', '');
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_PaGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_PaGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 3, "PA");
				filterkontak = "";
				o.txtfilterperubahannilai = 0;
				o.txtfiltersetnilai = 0;
				o.txtkurs = 0;
				isUpdate = false;
				parentApplication.F_SetNilaiText([dttanggal, dttanggalberlaku, dttanggalnoref], parentApplication.DefaultTanggal);
				parentApplication.F_SetNilaiText([txtfiltersetnilai, txtfilterperubahannilai], parentApplication.F_formatNominal(0));
				parentApplication.F_KosongkanText([txtkategoribarang, txtkategoriharga, lblkategoriharga, lblkategoribarang, txtkodebarang1, txtkodebarang2, txtfilter, txtmatauang, txtkurs, txtbagiansetharga, lblbagianbagiansetharga, lblkategoriharga, txtkontakperson, txturaian, txtcatatan, txtnoref]);
				txtnotransaksi.text = 'Auto';
				txtbagiansetharga.text = parentApplication.ukontakkode;
				lblbagianbagiansetharga.text = parentApplication.ukontaknama;
				txturaian.text = parentApplication.getNomor("PA");
				txtcatatan.text = parentApplication.getNomor("PA",1);
				txtmatauang.text = parentApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = parentApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = parentApplication.m.nfNominal.format(o.txtkurs);
				cmbprogress.enabled = true;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].enabled = false;
				mb.menuBarItems[8].enabled = false;
				mb.menuBarItems[9].visible = false;
				mb.menuBarItems[10].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				f_matauangFungsional();
				
				//set kategori
				cmbtipe.selectedIndex = 0
				FlexGlobals.topLevelApplication.F_KosongkanText([txtkategoriharga, lblkategoriharga]);
				txtkategoriharga.enabled = false;
				tkategoribintang.visible = false;
				
				u = new ArrayCollection([{paid:0, pacabang:parentApplication.ucabang, palokasi:parentApplication.ulokasi, pagudang:parentApplication.ugudang, pasumber:'PA', panotransaksi:txtnotransaksi.text, 
					patgl:dttanggal.text, patglberlakusampai:dttanggalberlaku.text, pakodepa:0, pabagianpa:parentApplication.ukontak, pabagianpakontak:txtkontakperson.text, pamatauang:txtmatauang.text, pakurs:o.txtkurs,
					pauraian:txturaian.text, pacatatan:txtcatatan.text, panoref:txtnoref.text, patglnoref:dttanggalnoref, pastatus:cmbprogress.selectedItem.v, pastatussebelumnya:0, pajmlrevisi:0, 
					pacetakanke:0, painputuser:parentApplication.userid, painputtgl:tglDB, pamodifikasiuser:0, pamodifikasitgl:tglDB, paposting:0, patutupperiode:0, 
					paisclose:0, pacustomtext1:'', pacustomtext2:'', pacustomtext3:'', pacustomtext4:'', pacustomtext5:'', pacustomint1:0, 
					pacustomint2:0, pacustomint3:0, pacustomdbl1:0, pacustomdbl2:0, pacustomdbl3:0, pacustomdate1:parentApplication.m.DateFirst, pacustomdate2:parentApplication.m.DateFirst, 
					pacustomdate3:parentApplication.m.DateFirst}]);
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
						var  jenissimpan:int = 1;
						if(isUpdate == false){
							jenissimpan = 1
						}else{
							jenissimpan = 2
						}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(3,8,jenissimpan)){
							f_simpan();
						}
						}
						break;
					case Keyboard.F:
						if(e.ctrlKey)f_tampilkan();
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				if(dg1.selectedCell != null){
					with(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex)){
						switch(column){
							case "margin":
								if(hargabeli > 0){
									hargajual1 = Number(hargabeli) + ((Number(margin) / 100) * Number(hargabeli));
								}
								break;
							case "hargajual1":
								if(hargabeli > 0){
									margin = ((Number(hargajual1) - Number(hargabeli)) / Number(hargabeli)) * 100;
								}
								break;
							
						}
					}
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				var fkategoribarang : String = "";
				if(dg1.selectedCell != null || dg1_lock.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(parentApplication.rowIndex);
				switch(target){
					case "txtkategoriharga":
						if(txtkategoriharga.enabled){
							paket = 'CdM1_Price_Category';
							wsfilter = 'pckode ="'+txtkategoriharga.text.split('"').join('\\"')+'"';
							sort = 'pckode asc';
						}
						break;
					case "txtkategoribarang":
						paket = 'CdM1_Item_Category';
						wsfilter = 'icaktif = 1 AND ickode ="'+txtkategoribarang.text+'"';
						csfilter = 'icaktif=1';
						sort = 'ickode asc';
						break;
					case "txtkodebarang1":
						if(txtkategoribarang.text.length > 0){
							fkategoribarang = 'AND bkategori = "'+txtkategoribarang.text+'"';
						}
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 '+fkategoribarang+' AND bkode ="'+txtkodebarang1.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1 '+fkategoribarang+'';
						sort = 'bkode asc';
						break;
					case "txtkodebarang2":
						if(txtkategoribarang.text.length > 0){
							fkategoribarang = 'AND bkategori = "'+txtkategoribarang.text+'"';
						}
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 '+fkategoribarang+' AND bkode ="'+txtkodebarang2.text.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1 '+fkategoribarang+'';
						sort = 'bkode asc';
						break;
					case "txtmatauang":
						paket = 'CdM1_Currency';
						wsfilter = 'caktif = 1 AND ckode ="'+txtmatauang.text.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						sort = 'ckode asc';
						break;
					case "txtcatatan":
						paket = 'CdM1_Transaction_Note';
						csfilter = "tnaktif = 1 AND tnsumber = 'PA'";
						sort = 'tnkode asc';
						break;
					case "txtbagiansetharga":
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M") AND kkode ="'+txtbagiansetharga.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).pabagianpa+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).pabagianpa+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "kodebarang":
						if(txtkategoribarang.text.length > 0){
							fkategoribarang = 'AND bkategori = "'+txtkategoribarang.text+'"';
						}
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bassembly <> 1 '+fkategoribarang+' AND bkode = "'+obj.kodebarang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1 AND bassembly <> 1 '+fkategoribarang+'';
						sort = 'bkode asc';
						break;
					case "satuan":
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif = 1 AND ukode = "'+obj.satuan.split('"').join('\\"')+'"';
						csfilter = 'uaktif = 1';
						sort = 'ukode asc';
						break;
					case "matauang":
						paket = 'CdM1_Currency';
						wsfilter = 'caktif = 1 AND ckode = "'+obj.matauang.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						sort = 'ckode asc';
						break;
					case "catatan":
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "PA"';
						sort = 'tndkode asc';
						break;
					case "costcenter":
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case "divisi":
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case "subdivisi":
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'" AND sdkode = "'+obj.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case "proyek":
						paket = 'CdM1_Project';
						wsfilter = 'paktif = 1 AND pkode = "'+obj.proyek.split('"').join('\\"')+'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
					case "cabang":
						paket = 'CdM1_Branch';
						wsfilter = 'baktif = 1 AND bkode = "'+obj.cabang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case "lokasi":
						paket = 'CdM1_Location';
						wsfilter = 'laktif = 1 AND lkode = "'+obj.lokasi.split('"').join('\\"')+'"';
						csfilter = 'laktif = 1';
						sort = 'lkode asc';
						break;
					case "gudang":
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode = "'+obj.gudang.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case "kontakkode":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkategori = "C" AND kkode = "'+obj.kontakkode.split('"').join('\\"')+'"';
						csfilter = 'kaktif = 1 AND kkategori = "C"';
						sort = 'kkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
