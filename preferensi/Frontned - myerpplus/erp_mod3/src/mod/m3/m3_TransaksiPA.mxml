								dg1.dataProvider[i].margin = ((Number(dg1.dataProvider[i].hargajual1) - Number(dg1.dataProvider[i].hargabeli)) / dg1.dataProvider[i].hargabeli) * 100;
								break;
							case 2:
								dg1.dataProvider[i].hargajual1 = Number(dg1.dataProvider[i].hargabeli) + ((Number(dg1.dataProvider[i].margin) / 100) * Number(dg1.dataProvider[i].hargabeli))
								break;
						}
//						if(cmbfieldsetnilai.selectedIndex == 2){
//							dg1.dataProvider[i].hargajual1 = Number(dg1.dataProvider[i].hargabeli) + ((Number(dg1.dataProvider[i].margin) / 100) * Number(dg1.dataProvider[i].hargabeli))
//						}
//						if(cmbfieldsetnilai.selectedIndex == 0){
