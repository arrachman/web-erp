				cmboperationperubahannilai.dataProvider = new ArrayCollection([{l:'Persen'}, {l:'Nominal'}]);
//				cmbfieldperubahannilai.dataProvider = new ArrayCollection([{l:'Harga 1', v:'hargajual1'}, {l:'Harga 2', v:'hargajual2'}, {l:'Harga 3', v:'hargajual3'}, {l:'Harga 4', v:'hargajual4'}, {l:'Harga 5', v:'hargajual5'}, {l:'Diskon 1', v:'diskonjual1'}, {l:'Diskon 2', v:'diskonjual2'}, {l:'Diskon 3', v:'diskonjual3'}, {l:'Diskon 4', v:'diskonjual4'}, {l:'Diskon 5', v:'diskonjual5'}]);
//				cmbfieldsetnilai.dataProvider = new ArrayCollection([{l:'Harga 1', v:'hargajual1'}, {l:'Harga 2', v:'hargajual2'}, {l:'Harga 3', v:'hargajual3'}, {l:'Harga 4', v:'hargajual4'}, {l:'Harga 5', v:'hargajual5'}, {l:'Diskon 1', v:'diskonjual1'}, {l:'Diskon 2', v:'diskonjual2'}, {l:'Diskon 3', v:'diskonjual3'}, {l:'Diskon 4', v:'diskonjual4'}, {l:'Diskon 5', v:'diskonjual5'}]);
				cmbfieldperubahannilai.dataProvider = new ArrayCollection([{l:'Harga Baru', v:'hargajual1'}, {l:'Diskon Baru', v:'diskonjual1'}, {l:'Margin', v:'margin'}]);
				cmbfieldsetnilai.dataProvider = new ArrayCollection([{l:'Harga Baru', v:'hargajual1'}, {l:'Diskon Baru', v:'diskonjual1'}, {l:'Margin', v:'margin'}]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalberlaku, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbfield, cmboperation, cmboperationperubahannilai, cmbfieldperubahannilai, cmbfieldsetnilai, cmbprogress, cmbtipe]);
				parentApplication.F_txtpencarian([txtkategoribarang, txtkodebarang1, txtkodebarang2, txtmatauang, txtkategoriharga]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				parentApplication.F_TextInputNumberDesimalMode([txtfiltersetnilai, txtfilterperubahannilai, txtkurs]); 
				parentApplication.F_SetNavigasiKeyboard([txtnamabarang, txtfilter, txtnotransaksi, txturaian, txtnoref]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Set Perubahan", icon:"tbsetting", enabled:"true"},
					{label:"Set Nilai", icon:"tbsetting", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
