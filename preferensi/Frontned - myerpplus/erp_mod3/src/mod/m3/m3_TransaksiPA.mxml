			public function f_tampilkan():void
			{
				strFilter = "";
				parentApplication.vpFocusEvent = true;
				if((txtkodebarang1.text == "" && txtkodebarang2.text == "") && txtkategoribarang.text == "")Alert.show(parentApplication.l('Isi Kode Barang atau Kategori Barang terlebih dahulu'), parentApplication.l('Informasi'));
				else{
					if(txtkodebarang1.text != "" && txtkodebarang2.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bkode BETWEEN "'+txtkodebarang1.text+'" AND "'+txtkodebarang2.text+'"');
						//						strFilter = 'bkode BETWEEN "'+txtkodebarang1.text+'" AND "'+txtkodebarang2.text+'"';
					}
					if(txtkategoribarang.text.length > 0){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bkategori = "'+txtkategoribarang.text+'"');
						//						strFilter += 'bkategori = "'+txtkategoribarang.text+'"';
					}
					if(txtnamabarang.text != ""){
						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"');
						//						strFilter+=' AND bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"';
					}
					if(txtfilter.text != ''){
						switch(cmboperation.selectedIndex){
							case 0:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' like "%'+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' like "%'+txtfilter.text.split('"').join('\\"')+'%"'; 
								break;
							case 1:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' = '+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' = "'+txtfilter.text.split('"').join('\\"')+'"'; 
								break;
							case 2:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' <> '+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' <> "'+txtfilter.text.split('"').join('\\"')+'"'; 
								break;
							case 3:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' < '+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' < "'+txtfilter.text.split('"').join('\\"')+'"';	
								break;
							case 4:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' > '+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' > "'+txtfilter.text.split('"').join('\\"')+'"'; 
								break;
							case 5:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' <= '+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' <= "'+txtfilter.text.split('"').join('\\"')+'"'; 
								break;
							case 6:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' >= '+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' >= "'+txtfilter.text.split('"').join('\\"')+'"'; 
								break;
							case 7:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' like '+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' like "'+txtfilter.text.split('"').join('\\"')+'%"'; 
								break;
							case 8:
								strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, ''+cmbfield.selectedItem.v+' like "%'+txtfilter.text.split('"').join('\\"')+'%"');
								//								strFilter+=' AND '+cmbfield.selectedItem.v+' like "%'+txtfilter.text.split('"').join('\\"')+'"';	
								break;
						}
					}
					parentApplication.F_wsSearch('tampilkan', 'CdM1_Item', 0, 0, strFilter+' AND bassembly <> 1', strSort);
				}
			}
			
			public function f_setPerubahan():void
			{
				if(o.txtfilterperubahannilai > 100 && cmboperationperubahannilai.selectedIndex == 0){Alert.show(parentApplication.l('Nilai perubahan melebihi 100'), parentApplication.l('Informasi'));return;}
				if(txtfilterperubahannilai.text != ''){
					for(var i:int=0;i<dg1.dataProvider.length;i++){
						switch(cmboperationperubahannilai.selectedIndex){
							case 0:dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v]  = ((parentApplication.F_unCurreny(o.txtfilterperubahannilai) /100) * Number(dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v+'lama'])) + Number(dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v+'lama']); break;
							case 1:dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v]  = Number(dg1.dataProvider.getItemAt(i)[cmbfieldperubahannilai.selectedItem.v+'lama']) + parentApplication.F_unCurreny(o.txtfilterperubahannilai); break;
						}
						switch(cmbfieldperubahannilai.selectedIndex){
							case 0:
								dg1.dataProvider[i].margin = ((Number(dg1.dataProvider[i].hargajual1) - Number(dg1.dataProvider[i].hargabeli)) / dg1.dataProvider[i].hargabeli) * 100;
								break
							case 2:
								dg1.dataProvider[i].hargajual1 = Number(dg1.dataProvider[i].hargabeli) + ((Number(dg1.dataProvider[i].margin) / 100) * Number(dg1.dataProvider[i].hargabeli));
								break
						}
					}
					
					
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
