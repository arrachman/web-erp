						if(dg1.dataProviderLength > 0 && parentApplication.apaBisaAkses(2, 94, 11))
							parentApplication.F_wsSearch(parentApplication.sptParam+'tampilFDJurnalVocher', 'M2_Transaction_Journal_VoucherSearch', 0, 0, "tnotransaksi = '"+notransaksi+"'", "tgrup, turutan");
					} */
				}
			}
			
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				parentApplication.F_KosongkanText([txtgudang1,txtgudang2,txtkodebarang1,txtkodebarang2, txtnoserial1, txtnoserial2]);
				txttotalmasuk.text = '0';
				txttotalkeluar.text = '0';
				txttotal.text = '0';
				//				parentApplication.F_SetNilaiText([txtkontak1, txtkontak2], parentApplication.ukontakkode);
				dg1.dataProvider.removeAll();
				mb.menuBarItems[0].enabled = true;
				o.statistik = false
//				cmbstatus.selectedIndex = o.DefaultStatus;
			}
			
			public function f_formDataTampil(page:int = 1):void
			{
				if(o.statistik){
					FlexGlobals.topLevelApplication.F_wsSimpan("Tampilkan", 'M2_KartuSerial', 0, false, o.filter, '', page, 20, '', '');
				}else{
					FlexGlobals.topLevelApplication.F_wsSimpan("Tampilkan", 'M2_KartuSerial', 0, false, txtgudang1.text+'▲'+txtgudang2.text+'▲'+txtkodebarang1.text+'▲'+txtkodebarang2.text+'▲'+txtnoserial1.text+'▲'+txtnoserial2.text, '', page, 20, '', '');
				}
			}
			
