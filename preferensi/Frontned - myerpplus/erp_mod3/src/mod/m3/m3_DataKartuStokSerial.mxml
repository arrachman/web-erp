			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtgudang1":
						paket = 'CdM1_Warehouse';
						csfilter = "waktif=1";
						wsfilter = "waktif=1 AND wkode ='"+ txtgudang1.text+"'";
						//csfield = 2;
						break;
					case "txtgudang2":
						paket = 'CdM1_Warehouse';
						csfilter = "waktif=1";
						wsfilter = "waktif=1 AND wkode ='"+ txtgudang2.text+"'";
						//csfield = 2;
						break;
					case "txtkodebarang1":
						paket = 'CdM1_Item';
						csfilter = "baktif=1 AND bserial=1";
						wsfilter = "baktif=1 AND bserial=1 AND bkode ='"+txtkodebarang1.text+"'";
						break;
					case "txtkodebarang2":
						paket = 'CdM1_Item';
						csfilter = "baktif=1";
						wsfilter = "baktif=1 AND bkode ='"+txtkodebarang2.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(parentApplication.wsSuccess){
					if(parentApplication.wsArrUtama.getItemAt.length >= 0)ws = parentApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case "txtgudang1":
							txtgudang1.text = ws.wkode;
							txtgudang2.text = ws.wkode;
							break;
						case "txtgudang2": 
							txtgudang2.text = ws.wkode;
							break;
						case "txtkodebarang1":
							txtkodebarang1.text = ws.bkode;
							txtkodebarang2.text = ws.bkode;
							break;
						case "txtkodebarang2":
							txtkodebarang2.text = ws.bkode;
							break;
						case "tampilFDJurnalVocher":
							ttwpopup.horizontalCenter = 0;
							ttwpopup.right = 0;
							grppopup.visible = true;
							ttwpopup.title = 'Jurnal Voucher';
							gridjv.visible = true;
							gridjv.dataProvider = parentApplication.wsArrUtama;
							gridjv.setSelectedCell(0, 0);
							gridjv.setFocus();
							break; 
						case "Tampilkan":
							dg1.dataProvider = parentApplication.wsArrUtama;
							o.txttotalmasuk = parentApplication.wsArrUtama.getItemAt(0).totalmasuk;
							o.txttotalkeluar = parentApplication.wsArrUtama.getItemAt(0).totalkeluar;
							o.txttotal = o.txttotalmasuk-o.txttotalkeluar;
							txttotalmasuk.text = parentApplication.wsArrUtama.getItemAt(0).totalmasuk;
							txttotalkeluar.text = parentApplication.wsArrUtama.getItemAt(0).totalkeluar;
							txttotal.text = o.txttotal;
							imgfirst.enabled = parentApplication.wsIsPrev;
							imgprevious.enabled = parentApplication.wsIsPrev;
							imgnext.enabled = parentApplication.wsIsNext;
							imglast.enabled = parentApplication.wsIsNext;
							txtpaging.text = parentApplication.wsCurPage;
							for(i=0;i<dg1.dataProviderLength;i++)
								dg1.dataProvider[i].no = (((parentApplication.wsCurPage-1)*20)+(i+1));
							parentApplication.F_dgRefresh(dg1);
							dg1.setFocus();
							dg1.setSelectedCell(0, 0);
							break;
					}
				}else{ 
					if(parentApplication.F_validasiFalse(s))
						switch(s){
							case "tampilFDJurnalVocher":
								Alert.show(parentApplication.wsErrmessage);
								break; 
							case "Tampilkan":
								dg1.dataProvider.removeAll();
								break;
						}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtgudang1":parentApplication.F_KosongkanText([txtgudang1]);break;
					case "txtgudang2":parentApplication.F_KosongkanText([txtgudang2]);break;
					case "txtkodebarang1":parentApplication.F_KosongkanText([txtkodebarang1]);break;
					case "txtkodebarang2":parentApplication.F_KosongkanText([txtkodebarang2]);break;
				}
			}
			
