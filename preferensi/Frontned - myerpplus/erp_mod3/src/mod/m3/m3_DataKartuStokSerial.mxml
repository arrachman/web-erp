			public function f_persiapan():void
			{
				// Config Paging
				dg1.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = '0';
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(3, 34);
				a = [3, 54, 54, 'Ib', false];
				parentApplication.F_TranslateLabel([tgudang, tkodebarang, tnoserial, tjenislaporan]);
				parentApplication.F_ComboBoxStandard([cmbjenislaporan]);
				parentApplication.F_txtpencarian([txtgudang1, txtgudang2, txtkodebarang1, txtkodebarang2]);
				parentApplication.F_SetNavigasiKeyboard([txtnoserial1, txtnoserial2]);
				
				FlexGlobals.topLevelApplication.F_setGridJson(3, 54);
				FlexGlobals.topLevelApplication.registerGrid([dg1], 'data');
				
				txtgudang2.addEventListener(FocusEvent.FOCUS_IN, f_changenorek);
				txtkodebarang2.addEventListener(FocusEvent.FOCUS_IN, f_changekontak);
				
				//				o.arr = parentApplication.m.ArrFilter;
				//				if(o.arr.length > 0)
				//					if(o.arr[0] == 'statistik')
				//					{
				//						txtnorekening1.text = o.arr[1];
				//						txtkontak2.text = o.arr[2];
				//						
				//						// statistik, cnomor1;
				//					}
				
				// fungsi menubar
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbCetak);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbExport);
				function f_mbTampilkan():void
				{
					if(mb.menuBarItems[0].enabled)
						if(int(txtpaging.text) == 0)
							f_formDataTampil();
						else
							f_formDataTampil(int(txtpaging.text));
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbCetak():void
				{
					var filter:String = '';
					if(txtgudang1.text != '' && txtgudang2.text == ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"it.gudang = '"+txtgudang1.text+"'");
					}
					if(txtgudang1.text == '' && txtgudang2.text != ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"it.gudang = '"+txtgudang2.text+"'");
					}
					if(txtgudang1.text != '' && txtgudang2.text != ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"it.gudang BETWEEN '"+txtgudang1.text+"' AND '"+txtgudang2.text+"'");
					}
					if(txtkodebarang1.text != '' && txtkodebarang2.text == ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"i.bkode = '"+txtkodebarang1.text+"'");
					}
					if(txtkodebarang1.text == '' && txtkodebarang2.text != ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"i.bkode = '"+txtkodebarang2.text+"'");
					}
					if(txtkodebarang1.text != '' && txtkodebarang2.text != ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"i.bkode BETWEEN '"+txtkodebarang1.text+"' AND '"+txtkodebarang2.text+"'");
					}
					if(txtnoserial1.text != '' && txtnoserial2.text == ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"nst.nstkode = '"+txtnoserial1.text+"'");
					}
					if(txtnoserial1.text == '' && txtnoserial2.text != ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"nst.nstkode = '"+txtnoserial2.text+"'");
					}
					if(txtnoserial1.text != '' && txtnoserial2.text != ''){
						filter = FlexGlobals.topLevelApplication.TambahFilter(filter,"nst.nstkode BETWEEN '"+txtnoserial1.text+"' AND '"+txtnoserial2.text+"'");
					}
					//var filter:String = '';
					FlexGlobals.topLevelApplication.F_openReport(3, 34, cmbjenislaporan.selectedItem.ritem, filter, '', '', 0);
				}
				function f_mbExport(e:MenuEvent):void
				{
					var filter:String = txtgudang1.text+'▲'+txtgudang2.text+'▲'+txtkodebarang1.text+'▲'+txtkodebarang2.text+'▲'+txtnoserial1.text+'▲'+txtnoserial2.text;
					//var filter:String = '';
					switch(e.label){
						case "PDF": FlexGlobals.topLevelApplication.F_openReport(3, 34, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Ms.Excel": FlexGlobals.topLevelApplication.F_openReport(3, 34, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Html": FlexGlobals.topLevelApplication.F_openReport(3, 34, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Ms.Word": FlexGlobals.topLevelApplication.F_openReport(3, 34, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Text": FlexGlobals.topLevelApplication.F_openReport(3, 34, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
						case "Image": FlexGlobals.topLevelApplication.F_openReport(3, 34, cmbjenislaporan.selectedItem.ritem, filter, '', '', e.item.data);
							break;
					}
				}
				function f_changenorek():void{
					txtgudang2.text = txtgudang1.text;	
				}
				function f_changekontak():void{
					txtkodebarang2.text = txtkodebarang1.text;
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_formDataTampil(int(txtpaging.text));
				}
				function f_firstCLICK():void
				{
					f_formDataTampil();
				}
				function f_previousCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)-1);
				}
				function f_nextCLICK():void
				{
					f_formDataTampil(int(txtpaging.text)+1);
				}
				function f_lastCLICK():void
				{
					f_formDataTampil(int(-1));
				}
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.HOME:
							if(int(txtpaging.text)>1)
								f_formDataTampil();
							break;
						case Keyboard.PAGE_UP:
							if(int(txtpaging.text)-1>0)
								f_formDataTampil(int(txtpaging.text)-1);
							break;
						case Keyboard.PAGE_DOWN:
							f_formDataTampil(int(txtpaging.text)+1);
							break;
						case Keyboard.END:
							f_formDataTampil(-1);
							break;
						case Keyboard.P:
							if(e.ctrlKey)
								f_cetak();
							break;
						case Keyboard.R:
							if(e.ctrlKey)
								f_kondisiAwal();
							break;
					}
				}
				
				if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
					mb.menuBarItems[0].enabled = false;
					o.filter = parentApplication.m.ArrFilter[0];
					o.a = o.filter.split("AND")
					o.sort = parentApplication.m.ArrFilter[1].split(" ASC")['join']("")['split'](" DESC")['join']("");
					o.filter = sp(o.a[0])+'▲'+sp(o.a[1])+'▲'+sp(o.a[2])+'▲'+sp(o.a[3])+'▲'+sp(o.a[4])+'▲'+sp(o.a[5])+'▲'+o.sort	
					o.statistik = true;
					//					if(o.arr[0] == 'statistik')
					//						parentApplication.F_SetNilaiText([txtnorekening1, txtnorekening2], parentApplication.m.ArrFilter[1]);
					//						parentApplication.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
					f_formDataTampil(1);
				}else{
					f_kondisiAwal();
				}
				
				function sp(data:String):String
				{//param1 = "value1" AND param2 = "value2"
					return data.split('"')[1];
				}
			//	dg_contextmenu();
			}
			
			protected function dg_contextmenu():void
			{
				var vCMI:ContextMenuItem, arr:Array = new Array;
				ttwpopup.addEventListener(mx.events.CloseEvent.CLOSE, f_ttwClose);
				ttwpopup.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_ttwKEY_DOWN);
				dg1.contextMenu = new ContextMenu;
				dg1.contextMenu.hideBuiltInItems();
				dg1.addEventListener(GridEvent.GRID_ROLL_OVER, f_dgROLL_OVER);
				dg1.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_MENU_SELECT);
				vCMI = new ContextMenuItem('History')      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jurnalVocher); 
				dg1.contextMenu.customItems.push(vCMI);
				
				function f_dgROLL_OVER(e:GridEvent):void
				{
					if(dg1.dataProviderLength > 0){
						arr[0] = e.rowIndex;
						arr[1] = e.columnIndex;
					}
				}
				function f_MENU_SELECT():void
				{
					arr[2] = arr[0]; //row
					arr[3] = arr[1]; //col
					dg1.setSelectedCell(arr[2], arr[3]);
				}
				function f_ttwClose():void
				{
					grppopup.visible = false;
					gridjv.visible = false;
					gridtt.visible = false;
					gridjv.dataProvider.removeAll();
					dg1.setFocus();
				}
				function f_ttwKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ESCAPE)
						f_ttwClose();
				}
