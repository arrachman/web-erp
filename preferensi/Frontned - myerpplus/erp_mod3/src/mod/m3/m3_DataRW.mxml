// persiapan persiapan ======================================================================	
			public function f_persiapan():void
			{
				p=parentApplication;
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnotransaksi, ttanggal, tbarang, turaian, tcatatan, tjenislaporan, tlokasi, tcabang, tstatus]);
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(3, 51);			//(ambil report dari database)
				a = [3, 51, 52, 'Rw', false];			
				FlexGlobals.topLevelApplication.F_txtpencarian([txtuser, txtlokasi, txtcabang]);														// module, menu transaksi, menu, sumber, approvell, Sort, Group
