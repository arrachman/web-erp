<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			[Bindable] [Embed(source="assets/main/download.png")]  public var tbdownload:Class; // Download 
			[Bindable] [Embed(source="assets/main/download_d.png")]  public var tbdownload_d:Class; // Download 
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			protected function imgCountry_clickHandler(event:MouseEvent):void
			{
				parentApplication.m[parentApplication.idmod].child.f_setProperty('download', column.dataField, null);
			}
			
			protected function img_renderHandler(event:Event):void
			{
				if(data != null){
					if(Boolean(data[column.dataField+'_d']))
						img.source = tbdownload;
					else
						img.source = tbdownload_d;
				}
			}
			
		]]>
	</fx:Script>
	<s:Image id="img" horizontalCenter="0" verticalCenter="0" scaleMode="stretch" click="imgCountry_clickHandler(event)" source="{tbdownload}" useHandCursor="true" buttonMode="true" mouseChildren="false" render="img_renderHandler(event)"/>
</s:GridItemRenderer>