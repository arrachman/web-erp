		</s:fill>
		<s:filters>
			<s:BlurFilter blurX="8" blurY="8" quality="10"/>
		</s:filters>
	</s:Rect>
	<s:Rect id="rct2" radiusX="20" radiusY="20" width="285" height="250" horizontalCenter="0" verticalCenter="0">
