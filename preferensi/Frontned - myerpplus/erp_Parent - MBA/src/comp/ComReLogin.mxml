<?xml version="1.0" encoding="utf-8"?>
<s:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009"
			   xmlns:s="library://ns.adobe.com/flex/spark"
			   xmlns:mx="library://ns.adobe.com/flex/mx"
			   width="485" height="426" fontWeight="bold" title="MyERP+ Access Fail" initialize="titlewindow1_initializeHandler(event)">
	
	<fx:Script>
		<![CDATA[ 
			import mx.controls.Alert;
			import mx.events.FlexEvent;
			[Bindable] [Embed(source="assets/main/username.png")]  public var mainusername:Class;
			[Bindable] [Embed(source="assets/main/password.png")]  public var mainpassword:Class;
			[Bindable] [Embed(source="assets/main/login.png")]  public var mainlogin:Class;
			
			protected function label1_clickHandler(event:MouseEvent):void
			{
				parentApplication.f_logout();
			}
			
			public function f_doLogin():void
			{
				parentApplication.wsValidasi = true;
				parentApplication.m.objTemp.m0_Login_user = txtUsername.text;
				parentApplication.m.objTemp.m0_Login_pass = txtPassword.text;
				parentApplication.F_wsSimpan(parentApplication.sptParam+'login2', 'M0_Login', 0, false, parentApplication.F_splitArrayToString(["3k1StR5601aDz2N74Go3", "66f755e7de426692105cb494e79d7bdc", txtUsername.text, txtPassword.text, parentApplication.m.kodeapp, 0]), '');
				txtUsername.enabled = false;
				txtPassword.enabled = false;
				BtnLogin.enabled = false;
			}
			protected function txtPassword_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode==Keyboard.ENTER)
					if(txtPassword.text!="")
						if(txtPassword.text!="")
							f_doLogin();
						else
							txtUsername.setFocus();
			}
			
			protected function titlewindow1_initializeHandler(event:FlexEvent):void
			{
				parentApplication.m.login = false;
			}
			
		]]>
	</fx:Script>
	
	<s:Rect id="backgroundRect" left="0" right="0" top="0" bottom="0"  >
