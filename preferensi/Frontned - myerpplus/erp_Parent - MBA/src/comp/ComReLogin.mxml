				<s:GradientEntry color="#81CBED" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Path top="0" bottom="0" width="25%" data="M 0 0 L 84 0 L 84 15 C 84 15 44 5 0 15 C 0 15 0 0 0 0 Z" rotation="270">
		<s:fill>
			<s:LinearGradient x="43" y="0" scaleX="20" rotation="90" >
				<s:GradientEntry color="0xffffff" ratio="0" alpha="0.55"/>
				<s:GradientEntry color="0xffffff" ratio="1" alpha="0.15"/>
			</s:LinearGradient>
		</s:fill>
	</s:Path>
	<s:Path left="0" right="0" height="210" data="M 0 0 L 84 0 L 84 15 C 84 15 44 5 0 15 C 0 15 0 0 0 0 Z">
