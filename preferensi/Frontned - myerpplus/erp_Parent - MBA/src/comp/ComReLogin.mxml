		</s:fill>
	</s:Rect>
	<s:Label id="lblPerusahaan" color="#000000" fontFamily="Arial" fontSize="24" fontWeight="bold" horizontalCenter="0" text="Relogin" verticalCenter="-96"/>
	<s:Label x="10" y="10" color="#FF0000"
			 text="You either do not have the authority or Your session has already timed out."/>
	<s:Label x="10" y="32" color="#FF0000"
			 text="Please relogin or back to the login page"/>
	<s:Label  id="lbllink" x="241" y="32" width="64" color="#009ad4" text="Click here" rollOver="lbllink.setStyle('textDecoration','underline')" rollOut="lbllink.setStyle('textDecoration','none')" useHandCursor="true" buttonMode="true" mouseChildren="false" click="label1_clickHandler(event)" />
	<s:Group width="242" height="180" horizontalCenter="0" verticalCenter="16">
		
		<s:Label id="lblUsername" left="11" top="11" fontWeight="normal" text="Username"/>
		<s:Label id="lblPassword" left="12" top="68" fontWeight="normal" text="Password"/>
		<s:TextInput id="txtUsername" left="10" right="10" top="30" height="30" borderVisible="false" enabled="false" fontSize="14" paddingLeft="30" toolTip="Other Username then back to login page"/>
		<s:TextInput id="txtPassword" left="10" right="10" top="87" height="30" borderVisible="false" displayAsPassword="true" fontSize="14" keyDown="txtPassword_keyDownHandler(event)" paddingLeft="30"/>
		<s:Button id="BtnLogin" right="10" top="127" width="94" height="30" label="Relogin"
				  click="f_doLogin()" fontFamily="Arial" fontSize="13"
				  fontWeight="normal" icon="{mainlogin}" styleName="parent"/>
		<s:Image id="imgUsername" left="17" top="37" source="{mainusername}"/>
		<s:Image id="imgPassword" left="17" top="94" source="{mainpassword}"/>
		<s:Path id="pth1" x="-21" y="-54" width="285" height="96"
				data="M 0 0 L 84 0 L 84 15 C 84 15 44 5 0 15 C 0 15 0 0 0 0 Z">
			<s:fill>
				<s:LinearGradient x="43" y="0" scaleX="20" rotation="90" >
					<s:GradientEntry color="0xffffff" ratio="0" alpha="0.55"/>
					<s:GradientEntry color="0xffffff" ratio="1" alpha="0.15"/>
				</s:LinearGradient>
			</s:fill>
		</s:Path>
	</s:Group>
</s:TitleWindow>