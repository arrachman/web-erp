<?xml version="1.0" encoding="utf-8"?>
<s:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
			   xmlns:s="library://ns.adobe.com/flex/spark" 
			   title="Default Tanggal"
			   close="PopUpManager.removePopUp(this)"
			   keyUp="f_keyuphandler(event)"
			   keyDown="titlewindow1_keyDownHandler(event)"
			   creationComplete="titlewindow1_creationCompleteHandler(event);setFocus()"
			   xmlns:mx="library://ns.adobe.com/flex/mx" width="226" height="112">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.controls.menuClasses.MenuBarItem;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.managers.PopUpManager;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/cancel.png")]  public var tbcancel:Class;
			public function mbSave(e:MouseEvent):void
			{	
				var tgl:int = DtTanggal.selectedDate.date;
				var bln:int = DtTanggal.selectedDate.month + 1;
				var yr:int = DtTanggal.selectedDate.fullYear;
				
				parentApplication.DefaultTanggal = DtTanggal.text;
//				FlexGlobals.topLevelApplication.ImgDate.toolTip = FlexGlobals.topLevelApplication.DefaultTanggal;
				parentApplication.DefaultTanggalforDB = tglFormat(DtTanggal.text);
				if(FlexGlobals.topLevelApplication.ubahasa=="in")
				{
					Alert.show("Default tanggal dirubah menjadi " + parentApplication.DefaultTanggal);	
				}
				else
				{
					Alert.show("Date Default changed to " + parentApplication.DefaultTanggal);
				}
				PopUpManager.removePopUp(this);
				//parentApplication.openFormX("Barang Detail",1,"mod/m1/m1_BarangDetail.swf",512,928,"t1");
			}
			
			protected function tglFormat(s:String):String{if(s == '')return '';else return s.slice(6,10)+"-"+s.slice(3,5)+"-"+s.slice(0,2);}

			public function mbCancel(e:MouseEvent):void
			{
				PopUpManager.removePopUp(this);
			}
			protected function SetMenuBar():void
			{
				var mb1:MenuBarItem = MyMenuBar.menuBarItems[0] as MenuBarItem;
				mb1.addEventListener(MouseEvent.CLICK, mbSave);
				var mb2:MenuBarItem = MyMenuBar.menuBarItems[1] as MenuBarItem;
				mb2.addEventListener(MouseEvent.CLICK, mbCancel);
				
			}
			
			protected function titlewindow1_creationCompleteHandler(event:FlexEvent):void
			{
				var tgl:String = parentApplication.DefaultTanggal;
				var arrTgl:Array = tgl.split("/");
				DtTanggal.selectedDate = new Date(arrTgl[2],arrTgl[1]-1,arrTgl[0]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([DtTanggal]);
				if(FlexGlobals.topLevelApplication.ubahasa!="in")
				{
					title = "Date Default";
					lblTgl.text = "Date";
//					MyMenuBar.dataProvider = xmlListCollen;
//					SetMenuBar();
				}
				else
				{
//					MyMenuBar.dataProvider = xmlListColl;
//					SetMenuBar();
				}
				
			}
			
			protected function f_keyuphandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ESCAPE)
				{
					PopUpManager.removePopUp(this);
				}
			}
			
			protected function titlewindow1_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ESCAPE)
				{
					PopUpManager.removePopUp(this);
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		<s:XMLListCollection id="xmlListColl">
			<s:source>
				<fx:XMLList xmlns="" id="inn">
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbcancel"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
		
		<s:XMLListCollection id="xmlListCollen">
			<s:source>
				<fx:XMLList xmlns="" id="enn">
					<topmenu label="Save" icon="tbsave"/>
					<topmenu label="Cancel" icon="tbcancel"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="MyMenuBar" labelField="@label" left="0" right="0" top="0" height="30" cornerRadius="0" iconField="@icon" dataProvider="{xmlListCollen}" creationComplete="SetMenuBar()"  />
	<s:Label id="lblTgl" x="16" y="49" text="Tanggal"/>
	<mx:DateField id="DtTanggal" x="68" y="42" width="141" formatString="DD/MM/YYYY" showToday="false"/>
</s:TitleWindow>
