<?xml version="1.0" encoding="utf-8"?>	
<s:GridItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009" 
				  xmlns:s="library://ns.adobe.com/flex/spark" 
				  xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true"
				  focusOut="griditemeditor2_focusOutHandler(event)"
				  creationComplete="griditemeditor2_creationCompleteHandler(event)">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.events.DropDownEvent;
			import spark.events.TextOperationEvent;
			import spark.formatters.NumberFormatter;
			
			protected var i:int;
			override public function set value(newValue:Object):void 
			{
				if(parentApplication.F_getProperty('dinamis', column.dataField, data[column.dataField + "_v"]) != "comboBox")
					txt.text = String(newValue);
			}
			
			override public function get value():Object 
			{
				if(parentApplication.F_getProperty('dinamis', column.dataField, data[column.dataField + "_v"]) == "comboBox")
				{
					parentApplication.m.focusComboBox = false;
					if(cmb.selectedItem != null)
					{
						if(cmb.selectedIndex >= 0)
						{
							return cmb.selectedItem.v;
						}
					}
				}
				else
				{
					return txt.text;
				}
				
				return '';
			}
			
			override public function setFocus():void 
			{
				if(parentApplication.F_getProperty('dinamis', column.dataField, data[column.dataField + "_v"]) == "comboBox")
				{
					cmb.setFocus();
				}
				else
				{
					txt.setFocus();	
				}
			}
			
			protected function cmb_closeHandler(event:DropDownEvent):void
			{
				data[column.dataField] = cmb.selectedItem.v;
				parentApplication.F_setProperty('dinamis', column.dataField, cmb.selectedItem.v);
			}
			
			protected function cmb_changeHandler():void
			{
				if(cmb.selectedIndex >= 0)
				{
					data[column.dataField] = cmb.selectedItem.v;
					parentApplication.F_setProperty('dinamis', column.dataField, cmb.selectedItem.v);
				}
			}	
			
			protected function txt_changeHandler(event:TextOperationEvent):void
			{
				data[column.dataField] = txt.text;
			}
			
			protected function img_clickHandler(event:MouseEvent):void
			{
				FlexGlobals.topLevelApplication.F_popUpCari(column.dataField);
			}
			
			protected function txt_keyDownHandler(event:KeyboardEvent):void
			{
				switch(parentApplication.F_getProperty('dinamis', column.dataField, data[column.dataField + "_v"]))
				{
					case "pencarian":
						if(event.keyCode == Keyboard.F12)
						{
							FlexGlobals.topLevelApplication.F_popUpCari(column.dataField);
						}
						break;
					case "multiLine":
						if(event.keyCode == Keyboard.F12)
						{
							FlexGlobals.topLevelApplication.F_showComMultiLine(txt.text, column.dataField);
						}
						break;
				}
			}
			
			protected function griditemeditor2_focusOutHandler(event:FocusEvent):void
			{
				switch(parentApplication.F_getProperty('dinamis', column.dataField, data[column.dataField + "_v"]))
				{
					case "comboBox":
						parentApplication.m.focusComboBox = true;
						break;
				}
			}
			
			protected function griditemeditor2_creationCompleteHandler(event:FlexEvent):void
			{
				switch(parentApplication.F_getProperty('dinamis', column.dataField, data[column.dataField + "_v"]))
				{
					case "comboBox":
						cmb.dataProvider = parentApplication.F_getProperty('comboBox', column.dataField, data[column.dataField + "_v"]);
						parentApplication.F_ComboBoxStandard([cmb]);
						
						if(data != null && cmb.dataProvider != null)
						{
							for(i=0;i<cmb.dataProvider.length;i++)
							{
								if(cmb.dataProvider.getItemAt(i).v == data[column.dataField])
								{
									cmb.selectedIndex = i;
									break;
								}
							}
						}
					break;
					
					case "text":
						cmb.visible = false;
						txt.visible = true;
						break;
					
					case "pencarian":
						cmb.visible = false;
						img.visible = true;
						txt.visible = true;
						txt.right = 25;
						break;
					
					case "multiLine":
						cmb.visible = false;
						imgEdit.visible = true;
						txt.visible = true;
						txt.right = 25;
						break;
				}
			}
			
			protected function imgEdit_clickHandler(event:MouseEvent):void
			{
				FlexGlobals.topLevelApplication.F_showComMultiLine(txt.text, column.dataField);
			}
			
		]]>
	</fx:Script>
	<s:ComboBox id="cmb" width="100%" height="100%"	change="cmb_changeHandler()" close="cmb_closeHandler(event)"/>
	<s:TextInput id="txt" width="100%" height="100%" visible="false" change="txt_changeHandler(event)" keyDown="txt_keyDownHandler(event)"/>
	<s:Image id="img" visible="false" source="{parentApplication.tbfind}" top="5" right="4" useHandCursor="true" buttonMode="true" mouseChildren="false" click="img_clickHandler(event)"/>
	<s:Image id="imgEdit" visible="false" source="{parentApplication.tbedit}" top="5" right="4" useHandCursor="true" buttonMode="true" mouseChildren="false" click="imgEdit_clickHandler(event)"/>
</s:GridItemEditor>