				o.menu = cmbMenu.selectedItem.m;
				o.user = 0;
				cmbMenu.setFocus();
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				//Alert.show(cmbMenu.selectedItem.v);
				if (parentApplication.F_cekKosong([{t:txtStatusNotifikasi, n:'Status Notifikasi', e:'Notification Status'}, {t:txtStatusUpdate, n:'Status Update', e:'Update Status'}, {t:txtUser, n:'User', e:'User'}, {t:txtEmailPengirim, n:'From Address', e:'Email Pengirim'}, {t:txtPasswordPengirim, n:'Password', e:'Password'}, {t:txtEmailPenerima, n:'To Address', e:'Email Penerima'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [cmbMenu.selectedItem.v,cmbMenu.selectedItem.m,cmbMenu.textInput.text,int(txtStatusNotifikasi.text),int(txtStatusUpdate.text),int(o.user),txtEmailPenerima.text,txtEmailPengirim.text,txtPasswordPengirim.text];
					utama = parentApplication.F_splitArrayToString(arr);
					FlexGlobals.topLevelApplication.F_MasterSimpan(baru, 'M0_Notifikasi_EmailSimpan', utama, 'userid')
					vUserIdEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtStatusNotifikasi':
						paket = 'CdM0_Status';
						wsfilter = 'kode = '+ int(txtStatusNotifikasi.text);
						sort = 'kode asc';
						break;
					case 'txtStatusUpdate':
						paket = 'CdM0_Status';
						wsfilter = 'kode = '+ int(txtStatusUpdate.text);
						sort = 'kode asc';
						break;
					case "txtUser":
						if(txtUser.enabled == true){
							paket = 'CdM0_User';
							csfilter = 'uaktif=1';
							wsfilter = 'uaktif=1 AND ukode ="'+txtUser.text.split('"').join('\\"')+'"';
							sort = 'ukode asc';
						}
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtStatusNotifikasi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtStatusNotifikasi.text = o.kode;
							lblNamaStatusNotifikasi.text = o.nama;
							break;
						case 'txtStatusUpdate':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtStatusUpdate.text = o.kode;
							lblStatusUpdate.text = o.nama;
							break;
						case 'txtUser':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtUser.text = o.ukode;
							lblNamaUser.text = o.unama;
							o.user = o.userid;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtStatusNotifikasi': txtStatusNotifikasi.text = ''; lblNamaStatusNotifikasi.text = ''; break;
							case 'txtStatusUpdate': txtStatusUpdate.text = ''; lblStatusUpdate.text = ''; break;							
							case 'txtUser': txtUser.text = ''; lblNamaUser.text = ''; break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtStatusNotifikasi': txtStatusNotifikasi.text = ''; lblNamaStatusNotifikasi.text = ''; break;
					case 'txtStatusUpdate': txtStatusUpdate.text = ''; lblStatusUpdate.text = ''; break;							
					case 'txtUser': txtUser.text = ''; lblNamaUser.text = ''; break;
				}
			}
			
