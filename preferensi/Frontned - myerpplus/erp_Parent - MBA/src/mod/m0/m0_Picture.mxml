<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="400" height="300" creationComplete="f_persiapan()" keyDown="module1_keyDownHandler(event)" xmlns:comp="comp.*">
	<fx:Script>
		<![CDATA[
			import flashx.textLayout.factory.TruncationOptions;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			import mx.managers.PopUpManager;
			
			[Bindable] [Embed(source="assets/tb/not_available.jpg")]  public var not_available:Class;
			[Bindable] [Embed(source="assets/tb/close1.png")]  public var close:Class;
			
			protected function f_persiapan():void
			{
				if(parentApplication.wsArrUtama.getItemAt(0).bnamafile.length > 0){
					imgpicture.source = "../files/f1/Item/"+parentApplication.wsArrUtama.getItemAt(0).bnamafile;
				}else{
					imgpicture.source = not_available;
				}
				imgclose.source = close;
			}
			
			protected function removePopUp():void
			{
				PopUpManager.removePopUp(this);
			}
			
			protected function module1_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ESCAPE)
					removePopUp();
			}
			
			protected function imgpicture_creationCompleteHandler(event:FlexEvent):void
			{
				imgpicture.addEventListener(IOErrorEvent.IO_ERROR, ie_error); 
				function ie_error():void
				{
					imgpicture.source = not_available;
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:BorderContainer left="10" right="10" top="10" bottom="10" borderColor="#FFFFFF" borderWeight="0" borderVisible="false" cornerRadius="10">
		<s:Image id="imgpicture" width="360" height="260"
				 creationComplete="imgpicture_creationCompleteHandler(event)" horizontalCenter="0"
				 verticalCenter="0"/>
	</s:BorderContainer>
	<s:Image id="imgclose" right="-4" top="-6" width="25" height="25" click="removePopUp()"/>
</s:Module>
