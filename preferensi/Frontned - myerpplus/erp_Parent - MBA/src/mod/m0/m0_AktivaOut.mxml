			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				
				
				switch(components){
					case "checkBoxHeader":
						var dg:DataGrid;
						if(tab1.selectedIndex == 0){
							dg = dgasset;
						}
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).pilih = data;
						}
						
						f_pilih();
						break;
					case "checkBox":
						f_pilih();
						break;
				}
			}
			
			protected function f_pilih():void
			{
				//jika tab yang terpilih adalah tab pertama
				//				Alert.show(dgfaktiva.dataProvider[dgfaktiva.selectedIndex].jml)
				if(tab1.selectedIndex == 0){
					j = 0;
					if(dgfaktiva.dataProviderLength > 0){
						for(i=0;i<dgasset.dataProviderLength;i++)
							//check box dicentang
							if(dgasset.dataProvider[i].pilih == 1)
								j += Number(dgasset.dataProvider[i].atjml)
						//jika jumlah sisa sama dengan jumlah pada 
						if(j == dgfaktiva.dataProvider[dgfaktiva.selectedIndex].jml){
							for(i=0;i<dgasset.dataProviderLength;i++){
								if(dgasset.dataProvider[i].pilih == 0)
									dgasset.dataProvider[i].pilih_enabled = 0;
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgasset);
							//break;
						}
							//jika jumlah barang yg dipilih lebih besar dari yg di grid detail, cekboxnya di-disable dan muncul peringatan
						else if(j > dgfaktiva.dataProvider[dgfaktiva.selectedIndex].jml){
							for(i=0;i<dgasset.dataProviderLength;i++){
								if(dgasset.dataProvider[i].pilih == 0)
									dgasset.dataProvider[i].pilih_enabled = 0;	
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgasset);
							//						Alert.show("Quantity of aktiva item shouldn't be more than (Jumlah barang aktiva tidak boleh lebih dari) : "+dgfaktiva.dataProvider[dgfaktiva.selectedIndex].jml+"",'Information');
						}
						
						//jika jumlah barang yg dipilih lebih kecil dari yg di grid detail, cekboxnya di-enabled
						if(j < dgfaktiva.dataProvider[dgfaktiva.selectedIndex].jml){
							for(i=0;i<dgasset.dataProviderLength;i++)
								dgasset.dataProvider[i].pilih_enabled = 1;
							FlexGlobals.topLevelApplication.F_dgRefresh(dgasset);
						}
						//menghitung jumlah yang harus dipilih
						dgfaktiva.dataProvider[dgfaktiva.selectedIndex].n = Number(dgfaktiva.dataProvider[dgfaktiva.selectedIndex].jml) - j;
						dgfaktiva.validateNow();
						dgfaktiva.dataProvider[dgfaktiva.selectedIndex].terpilih = j;
						//lblbarangb.text = "Barang : " + dgfaktiva.dataProvider[dgfaktiva.selectedIndex].kodebarang + " ( Pilih : "+dgfaktiva.dataProvider[dgfaktiva.selectedIndex].n+" ) ";
						lblbarang.text = "Barang : " + dgfaktiva.dataProvider[dgfaktiva.selectedIndex].kodebarang + "";
						lbljumlah.text = "Jumlah : "+ dgfaktiva.dataProvider[dgfaktiva.selectedIndex].jml+"";
						lblterpilih.text = "Terpilih : "+dgfaktiva.dataProvider[dgfaktiva.selectedIndex].terpilih+"";
					}
					
				}
								
			}
			
