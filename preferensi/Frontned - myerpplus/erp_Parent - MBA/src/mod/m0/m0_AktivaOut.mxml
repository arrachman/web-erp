			public function filter():void{
				(dgasset.dataProvider as ArrayCollection).filterFunction = filterMyArrayCollection;
				(dgasset.dataProvider as ArrayCollection).refresh();
			}
			
			private function filterMyArrayCollection(item:Object):Boolean {
				var searchString:String = dgfaktiva.dataProvider[dgfaktiva.selectedIndex].idbarang;
				var itemName:String = (item.atidbarang as String);
				
				if(itemName == null){
					return false;
				}
				
				return itemName.indexOf(searchString)>-1;
			}
			//END OF SERIAL
			
			protected function dgaktiva_keyDownHandler(event:KeyboardEvent):void
			{
				if(dgasset.columns.getItemAt(dgasset.selectedCell.columnIndex).dataField == 'pilih' && event.keyCode == Keyboard.SPACE)
					if(dgasset.dataProvider[dgasset.selectedCell.rowIndex].pilih_enabled == 1){
						if(dgasset.dataProvider[dgasset.selectedCell.rowIndex].pilih == 0)
							dgasset.dataProvider[dgasset.selectedCell.rowIndex].pilih = 1;
						else
							dgasset.dataProvider[dgasset.selectedCell.rowIndex].pilih = 0;
						f_pilih();
						FlexGlobals.topLevelApplication.F_dgColumnFirst(dgasset, dgasset.selectedCell.rowIndex);
					}
				
			}
			
			public function filterdataaktiva():String{
				var f:String = "("+obj.p.faktiva+")";
				if(txtfilters.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'akode LIKE "%'+txtfilters.text+'%"'); 
				}
				for(i=0; i<dgasset.dataProviderLength; i++){
					if(dgasset.dataProvider[i].pilih == 1){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'akode <>"'+dgasset.dataProvider[i].atkode+'"'); 
					}
				}
				return f;
			}
			
			protected function btntampilkan_clickHandler(event:MouseEvent):void
			{
				var subject:String ='';
				if(tab1.selectedIndex == 0)subject = "TampilAktiva";
				FlexGlobals.topLevelApplication.F_wsSearch(subject, 'M7_AssetSearch', 0, 0,filterdataaktiva(), "aid ASC, akode ASC");
			}
			
