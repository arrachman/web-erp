			private var filteraktiva:String='a';
			private function f_cekaktiva():void{
				filteraktiva='a';
				//if()
				var bs:int
				dgfaktiva.dataProvider.removeAll();
				
				for (var i:int=0;i< obj.p[obj.p.o.idgrid].dataProviderLength;i++){
					with(obj.p[obj.p.o.idgrid].dataProvider.getItemAt(i)){
						if(obj.p.o.moduleid == 3 && obj.p.o.mnid == 6){
							jmlbarangsb = jmlkeluar;
						}else if(obj.p.o.moduleid == 5 && obj.p.o.mnid == 8){
							if(obj.p.o.jenismutasi == 1){
								jmlbarangsb = jmlbarangkembali;
							}else{
								jmlbarangsb = jmlbarang;
							}
						}else{
							jmlbarangsb = jmlbarang;
						}
						
						if(basset == 1 && jmlbarangsb > 0){
							obj.aktivaada = false;
							for (bs=0; bs<dgfaktiva.dataProviderLength; bs++)
								if (idbarang == dgfaktiva.dataProvider.getItemAt(bs).idbarang){
									dgfaktiva.dataProvider.setItemAt({idbarang:idbarang,kodebarang:kodebarang,jml:Number(Number(dgfaktiva.dataProvider.getItemAt(bs).jml)+Number(jmlbarangsb)), terpilih:0},bs);
									obj.aktivaada=true;
									break;
								}
							if (obj.aktivaada==false){
								dgfaktiva.dataProvider.addItem({idbarang:idbarang,kodebarang:kodebarang,jml:jmlbarangsb, terpilih:0});
								filteraktiva = obj.p.faktiva;
								
							}
						}
					}
				}
				filteraktiva=filteraktiva;
			}
			
			protected function f_persiapan():void
			{
				obj.p = FlexGlobals.topLevelApplication.m[parentApplication.idmodcurr].child;
				p=parentApplication;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab1);
				FlexGlobals.topLevelApplication.F_RegGrid(0,7,[dgfaktiva]);
				FlexGlobals.topLevelApplication.F_RegGrid(0,9,[dgasset], 'transaksi');
				dgfaktiva.dataProvider = p.m[p.idmodcurr].child.acaktiva;
				
				obj.aktiva = false;
				for (var i:int=0;i< obj.p[obj.p.o.idgrid].dataProviderLength;i++){
					if(obj.p[obj.p.o.idgrid].dataProvider[i].basset == 1){
						obj.aktiva = true;
					}
					
				}
				
				if(obj.aktiva ){
					f_cekaktiva();
				}else{
					dgfaktiva.dataProvider.removeAll();
				}
								
				if(dgfaktiva.dataProviderLength > 0)dgfaktiva.selectedIndex = 0;				
				
				if(obj.p.o.aaktiva.length > 0){
					var s:String, b:String;
					if(obj.p.o.aaktiva.length > 0){
						//untuk filter aktiva yang sudah ada ketika edit
						for(i=0;i<obj.p.o.aaktiva.length;i++){
							if(i==0){
								s = 'aid <> '+obj.p.o.aaktiva[i].atasetid+'';
							}else{
								s+= ' and aid <>'+obj.p.o.aaktiva[i].atasetid+'';
							}
						}
						s = "("+s+")";
						filteraktiva = "("+filteraktiva+") AND "+s; 
					}					
				}	
				
				if(obj.p.o.moduleid == 5 && obj.p.o.mnid == 8){
					if(obj.p.o.aaktivalawan.length > 0){
						//untuk filter serial yang sudah ada ketika edit
						var sl:String='';
						for(i=0;i<obj.p.o.aaktivalawan.length;i++){
							if(i==0){
								sl = 'aid <> '+obj.p.o.aaktivalawan[i].atasetid+'';
							}else{
								sl+= ' and aid <>'+obj.p.o.aaktivalawan[i].atasetid+'';
							}
						}
						sl = "("+sl+")";
						filteraktiva = filteraktiva+" AND "+sl; 
					}
				} 
				
				if(obj.p.o.moduleid == 5 && obj.p.o.mnid == 10){
					Alert.show("Test "+obj.p.o.aaktiva.length);
					if(obj.p.o.aaktiva.length > 0){
						//untuk filter serial yang sudah ada ketika edit
						var sll:String='';
						for(i=0;i<obj.p.o.aaktiva.length;i++){
							if(i==0){
								sll = 'aid = '+obj.p.o.aaktiva[i].atasetid+'';
							}else{
								sll+= ' or aid = '+obj.p.o.aaktiva[i].atasetid+'';
							}
						}
						sll = "("+sll+")";
						filteraktiva = filteraktiva+" OR "+sll; 
					}
				} 	
				
				//FlexGlobals.topLevelApplication.F_wsSearch('tampil', 'CdM1_No_BatchSerial_In', 0, 0, filteraktiva, "nbiidbarang ASC, nbikode ASC"+parentApplication.sptRow+"nsiidbarang ASC, nsikode ASC");
				FlexGlobals.topLevelApplication.F_wsSearch('tampil', 'M7_AssetSearch', 0, 0, filteraktiva, "aid ASC, akode ASC");
