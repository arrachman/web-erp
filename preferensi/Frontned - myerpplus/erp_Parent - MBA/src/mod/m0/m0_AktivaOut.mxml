				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_simpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_close);
				function f_simpan():void{
					f_simpanaktiva();
					if(dgasset.dataProviderLength > 0){
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgasset);
					}
					if(obj.simpanaktiva ){
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
					}else{
						Alert.show("Jumlah Asset yang dipilih harus sama dengan jumlah transaksi !", "Information");						
					}
				}
				function f_close():void{
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
				}
			}
			
