<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()" keyDown="f_KEY_DOWN(event)">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.MenuEvent;
			
			import spark.events.GridEvent;
			import spark.events.GridSelectionEvent;
			import spark.events.GridSortEvent;
			public var saveas:Boolean=false;
			public var o:Object = {}, vUserId:int= FlexGlobals.topLevelApplication.uid, isUpdate:Boolean = true;
			public function f_grid_change():void{
				//arr[9] = ["Area", dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).anama, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).akode];
			}
			
			public function f_focusOnMe():void
			{
				cmbbulan.setFocus();
			}
			
			protected function f_persiapan():void
			{
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkode, tnama]);
				FlexGlobals.topLevelApplication.F_filterEnter([cmbbulan,cmbtahun]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbbulan,cmbttpperiode, cmbtahun]);
				F_persiapanFormMaster();
				cmbbulan.dataProvider = new ArrayCollection([{l:'Semua', v:0},{l:'Januari', v:1}, {l:'Februari', v:2}, {l:'Maret', v:3}, {l:'April', v:4}, {l:'Mei', v:5}, {l:'Juni', v:6}, {l:'Juli', v:7}, {l:'Agustus', v:8}, {l:'September', v:9}, {l:'Oktober', v:10}, {l:'Nopember', v:11}, {l:'Desember', v:12}]);
				cmbtahun.dataProvider = new ArrayCollection([{l:'2004', v:2004}, {l:'2005', v:2005}, {l:'2006', v:2006}, {l:'2007', v:2007}, {l:'2008', v:2008}, {l:'2009', v:2009}, {l:'2010', v:2010}, {l:'2011', v:2011}, {l:'2012', v:2012}, {l:'2013', v:2013}, {l:'2014', v:2014}, {l:'2015', v:2015}, {l:'2016', v:2016}, {l:'2017', v:2017}, {l:'2018', v:2018},{l:'2019', v:2019}, {l:'2020', v:2020}, {l:'2021', v:2021}, {l:'2022', v:2022}, {l:'2023', v:2023}, {l:'2024', v:2024}]);
				cmbttpperiode.dataProvider = new ArrayCollection([{l:'Open', v:0}, {l:'Closed', v:1}]);
				FlexGlobals.topLevelApplication.F_RegGrid(0, 17, [dg], 'data');
				// Daftarkan fungsi-fungsi text input
				
				f_kondisiAwal();
			}
			public var vfileextention:int=0;
			
			public function f_kondisiAwal():void
			{
				mb.menuBarItems[3].visible = false;
				f_focusOnMe();
				var spt:Array = FlexGlobals.topLevelApplication.DefaultTanggal.split("/");
				cmbtahun.selectedIndex = 10;
			}
			
			public function f_cekterpilih():Boolean{if(dg.selectedCell == null){return false}else{return true}}
			
			public function f_KEY_DOWN(e:KeyboardEvent):void
			{
				var e:KeyboardEvent;
				switch(e.keyCode){
					case Keyboard.HOME:
						if(int(txtpaging.text)>1)
							f_formMasterTampil();
						break;
					case Keyboard.PAGE_UP:
						if(int(txtpaging.text)-1>0)
							f_formMasterTampil(int(txtpaging.text)-1);
						break;
					case Keyboard.PAGE_DOWN:
						f_formMasterTampil(int(txtpaging.text)+1);
						break;
					case Keyboard.END:
						f_formMasterTampil(-1);
						break;
					
				}
			}
			
			public function F_persiapanFormMaster():void
			{
				var vSort:Boolean = true, vPosisi:int = 0, vCMI:ContextMenuItem;
				// Config Paging
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = "0";
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				
				
				
				function f_firstCLICK():void
				{
					if(int(txtpaging.text)>1)
						f_formMasterTampil();
				}
				
				function f_previousCLICK():void
				{
					if(int(txtpaging.text)-1>0)
						f_formMasterTampil(int(txtpaging.text)-1);
				}
				
				function f_nextCLICK():void
				{
					f_formMasterTampil(int(txtpaging.text)+1);
				}
				
				function f_lastCLICK():void
				{
					f_formMasterTampil(int(-1));
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_formMasterTampil(int(txtpaging.text));
				}
				// Config Grid
				dg.dataProvider = new ArrayCollection();
				dg.addEventListener(GridSortEvent.SORT_CHANGING, f_dgSort_changing);
				dg.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_dgKEY_DOWN);
				dg.addEventListener(GridEvent.GRID_ROLL_OVER, f_GRID_ROLL_OVER);
				dg.addEventListener(GridSelectionEvent.SELECTION_CHANGE, f_GRID_CHANGE);
				dg.selectionMode = "singleCell";
				dg.contextMenu = new ContextMenu;
				dg.contextMenu.hideBuiltInItems();
//				dg.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_dgMENU_SELECT);
				vCMI = new ContextMenuItem('Tutup/Buka Periode')
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_tutupperiod); 
				dg.contextMenu.customItems.push(vCMI);    
				
				function f_tutupperiod():void{
					var arr:Array, utama:String;
						//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					if(dg.dataProvider[dg.selectedCell.rowIndex].aptutupperiode == 0){
						arr = [dg.dataProvider[dg.selectedCell.rowIndex].apkode, dg.dataProvider[dg.selectedCell.rowIndex].aptahun, 
							dg.dataProvider[dg.selectedCell.rowIndex].apbulan, 1, 1];
						utama = parentApplication.F_splitArrayToString(arr);
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_Accounting_PeriodSimpan", vUserId, isUpdate, utama,'', 1, 20, f_filterdata(),"apkode");
					}else if(dg.dataProvider[dg.selectedCell.rowIndex].aptutupperiode == 1){
						arr = [dg.dataProvider[dg.selectedCell.rowIndex].apkode, dg.dataProvider[dg.selectedCell.rowIndex].aptahun, 
							dg.dataProvider[dg.selectedCell.rowIndex].apbulan, 1, 0];
						utama = parentApplication.F_splitArrayToString(arr);
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_Accounting_PeriodSimpan", vUserId, isUpdate, utama,'', 1, 20, f_filterdata(),"apkode");
					}
						
				}
				function f_GRID_ROLL_OVER(e:GridEvent):void
				{
					FlexGlobals.topLevelApplication.vgMyRow = e.rowIndex;
					FlexGlobals.topLevelApplication.vgMyCol = e.columnIndex;
				}
				
				function  f_GRID_CHANGE(e:GridSelectionEvent):void{
					
					f_grid_change();
				}
				
				function f_dgMENU_SELECT():void
				{
					dg.setSelectedCell(FlexGlobals.topLevelApplication.vgMyRow, FlexGlobals.topLevelApplication.vgMyCol);
				}
				
				function f_dgKEY_DOWN(e:KeyboardEvent):void
				{
					
				}
				
				// Config Menu Bar
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_tampilkan); // tampil
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_reset); // reset
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_tambah); // tambah
				function f_dgSort_changing(e:GridSortEvent):void
				{
					var om:Object = dg.columns.getItemAt(int(e.columnIndices)).dataField;
					if(om != "no")
						if(vSort ){ 
							vSort = false;
							f_formMasterTampil(1, String(om));
						}else if(vPosisi != int(e.columnIndices)){
							vSort = false;
							f_formMasterTampil(1, String(om));
						}else{
							vSort = true;dg.dataProvider.removeAll();
							f_formMasterTampil(1, om+' DESC');
						}
				}
				
				
				
				function f_tampilkan():void
				{
					if(int(txtpaging.text) == 0)
						f_formMasterTampil();
					else
						f_formMasterTampil(int(txtpaging.text));
				}
				
				
				
				function f_reset():void
				{
					f_kondisiAwal();
				}
				
				function f_tambah():void
				{
					
					FlexGlobals.topLevelApplication.openFormX(FlexGlobals.topLevelApplication.l("Tutup Periode"), 1, "mod/m0/m0_AccountingPeriodTambah.swf", 175, 300)
				}
				
				
				
			}
			
			public function f_filterdata():String{
				var f:String='';
				if(cmbbulan.selectedIndex > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f, "apbulan = "+cmbbulan.selectedItem.v+"");
				}
				if(cmbtahun.textInput.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f, "aptahun = "+cmbtahun.textInput.text+"");
				}
				if(cmbttpperiode.selectedIndex >= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f, "aptutupperiode = "+cmbttpperiode.selectedItem.v+"");
				}
				return f;
			}
			protected var vMasterSort:String;
			public function f_formMasterTampil(page:int = 1, sort:String = ''):void
			{
				if(sort == '')sort = "apkode asc";
				vMasterSort = sort;
				FlexGlobals.topLevelApplication.F_wsSearch("★tampilForm", "M2_Accounting_PeriodSearch", page, 20, f_filterdata(), sort);
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess ){
					switch(s){	
						case "simpan":
							dg.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
							break;
					}
				}
			}
			[Bindable] [Embed(source="assets/tb/preview.png")]  public var tbpreview:Class;
			[Bindable] [Embed(source="assets/tb/reset.png")]  public var tbreset:Class;
			[Bindable] [Embed(source="assets/tb/add.png")]  public var tbadd:Class;
			[Bindable] [Embed(source="assets/tb/edit.png")]  public var tbedit:Class;
			[Bindable] [Embed(source="assets/tb/delete.png")]  public var tbdelete:Class;
			[Bindable] [Embed(source="assets/tb/print.png")]  public var tbprint:Class;
			[Bindable] [Embed(source="assets/tb/pdf.png")]  public var tbpdf:Class;
			[Bindable] [Embed(source="assets/tb/excel.png")]  public var tbexcel:Class;
			[Bindable] [Embed(source="assets/tb/html.png")]  public var tbhtml:Class;
			[Bindable] [Embed(source="assets/tb/txt.png")]  public var tbtxt:Class;
			[Bindable] [Embed(source="assets/tb/tif.png")]  public var tbtif:Class;
			[Bindable] [Embed(source="assets/tb/word.png")]  public var tbword:Class;
			[Bindable] [Embed(source="assets/tb/upload.png")]  public var tbattachment:Class;
			[Bindable] [Embed(source="assets/tb/help.png")]  public var tbhelp:Class;
			[Bindable] [Embed(source="assets/tb/note.png")]  public var tbnote:Class;
			[Bindable] [Embed(source="assets/nav/f.png")]  public var navf:Class; //First
			[Bindable] [Embed(source="assets/nav/p.png")]  public var navp:Class; //Previous
			[Bindable] [Embed(source="assets/nav/n.png")]  public var navn:Class; //Next
			[Bindable] [Embed(source="assets/nav/l.png")]  public var navl:Class; //Last
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="list">
			<s:source>
				<fx:XMLList xmlns="list">
					<topmenu label="Tampilkan" icon="tbpreview"/>
					<topmenu label="Reset" icon="tbreset"/>
					<topmenu label="Tambah" icon="tbadd"/>
					<topmenu label="Bantuan" icon="tbhelp"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection> 
	</fx:Declarations>
	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{list}" iconField="@icon" labelField="@label"/>
	<s:Group right="5" top="5">
		<s:Image id="imgfirst" left="1" bottom="3" source="{navf}"/>
		<s:Image id="imgprevious" left="18" bottom="3" source="{navp}"/>
		<s:TextInput id="txtpaging" left="35" bottom="0" width="42"/>
		<s:Image id="imgnext" left="78" bottom="3" source="{navn}"/>
		<s:Image id="imglast" left="96" bottom="3" source="{navl}"/>
		
	</s:Group>
	<mx:DividedBox top="30" width="100%" height="100%">
		<mx:Canvas width="100%" height="104" minHeight="145" maxHeight="145">
			<s:Group left="10" top="10" width="443" height="67">
				<s:Label id="tkode" left="0" top="7" text="Bulan"/>
				<s:Label id="tnama" left="0" top="28" text="Tahun"/>
				<s:Label id="tnama0" left="0" top="51" text="Tutup Periode"/>
				<s:ComboBox id="cmbbulan" left="91" top="0" width="128"/>
				<s:ComboBox id="cmbtahun" left="91" top="21" width="128"/>
				<s:ComboBox id="cmbttpperiode" left="91" top="43" width="128"/>
			</s:Group>
		</mx:Canvas>
		<mx:Canvas width="100%" height="95%">
			<s:DataGrid id="dg" left="10" right="10" top="0" bottom="10"/>
		</mx:Canvas>
	</mx:DividedBox>
</s:Module>