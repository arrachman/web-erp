<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	
	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import flashx.textLayout.elements.TCYElement;
			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.CheckBox;
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String, pesanAlertIng:String, c:CheckBox, img:Image, i:int, isUpdate:Boolean, UFungsional:String;
			public var o:Object = {},no:int;
			[Bindable] public var ac2:ArrayCollection = new ArrayCollection();
			public var vIdkontak:int, arrColumn:Array = new Array;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction, getNotransaksi:String;
			public function f_focusOnMe():void
			{
				txtuser.setFocus();
			}
			
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "checkBoxHeader":
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case "checkBox":
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				
			}
			protected function f_persiapan():void
			{
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnogiro, ttanggaljt])
				cmbprogress.dataProvider = new ArrayCollection([
					{l:'Semua', v:-1}, 
					{l:'Draft', v:0}, 
					{l:'Need Approval', v:1},
					{l:'Approved', v:2},
					{l:'Inprogress', v:3},
					{l:'Complete', v:4},
					{l:'Revision', v:5},
					{l:'Reject', v:6},
					{l:'Close', v:7},
					{l:'Approve 1', v:8},
					{l:'Approve 2', v:9},
					{l:'Approve 3', v:10},
					{l:'Approve 4', v:11},
					{l:'Delete', v:12},
					{l:'Insert', v:13},
					{l:'Update', v:14},
					{l:'Error', v:15},
					{l:'Print', v:16},
					{l:'Unclose', v:17}]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress]);
				arrMenuBar = new ArrayCollection([
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				//				<s:XMLListCollection id="xmlListColl">
				//					<s:source>
				//						<fx:XMLList xmlns="">
				
				//						</fx:XMLList>
				//					</s:source>
				//				</s:XMLListCollection>
				//					
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttgl2]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtuser]);
				
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
				}
				
				function f_mbTampilkan():void{
					
						f_wsTampil();
					
				}
				
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					
					switch(e.keyCode){
						case Keyboard.HOME:
							if(int(txtpaging.text)>1)
								f_wsTampil();
							break;
						case Keyboard.PAGE_UP:
							if(int(txtpaging.text)-1>0)
								f_wsTampil(int(txtpaging.text)-1);
							break;
						case Keyboard.PAGE_DOWN:
							f_wsTampil(int(txtpaging.text)+1);
							break;
						case Keyboard.END:
							f_wsTampil(-1);
							break;
						
					}
				}
				
				
				function f_firstCLICK():void
				{
					
					if(int(txtpaging.text)>1)
						f_wsTampil();
				}
				
				function f_previousCLICK():void
				{
					
					if(int(txtpaging.text)-1>0)
						f_wsTampil(int(txtpaging.text)-1);
				}
				
				function f_nextCLICK():void
				{
					
					f_wsTampil(int(txtpaging.text)+1);
				}
				
				function f_lastCLICK():void
				{
					
					f_wsTampil(int(-1));
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_wsTampil(int(txtpaging.text));
				}
				
				
				FlexGlobals.topLevelApplication.F_RegGrid(0,21,[dg],'data');
				
				f_kondisiAwal()
			}
			public function f_validasi():void{
				
			}
			protected function f_kondisiAwal():void
			{
				
				parentApplication.F_SetNilaiText([dttgl, dttgl2], parentApplication.DefaultTanggal);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtuser]);
				cmbprogress.selectedIndex = 0;
				FlexGlobals.topLevelApplication.FormFilter = "";
			}
			
			
			protected function f_wsTampil(page:int = 1, sort:String = 'ultgl desc'):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("UserLog", "CdM0_Userlog", page, 20, f_filterdata(), sort);
			}
			public function f_filterdata():String{
				var f:String="";
				
				if(dttgl.text.length > 0 && dttgl2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'ultgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text.split('"').join('\\"'))+' 00:00:00" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text.split('"').join('\\"'))+' 23:59:59"');
				}else if(dttgl.text.length > 0 && dttgl2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'ultgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text.split('"').join('\\"'))+' 00:00:00"');
				}else if(dttgl.text.length <= 0 && dttgl2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'ultgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text.split('"').join('\\"'))+' 23:59:59"');
				}
				
				if(txtuser.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'ukode = "'+txtuser.text.split('"').join('\\"')+'"');
				}
				if(cmbprogress.selectedItem.v >= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'uljenisaktivitas = '+cmbprogress.selectedItem.v+'');
				}
				
				return f;
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(2,9,jenissimpan)==true){
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case "chk":
						break;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					
					case "txtuser":
						paket = 'CdM0_User';
						wsfilter = 'ukode = "'+txtuser.text+'"';
						sort = 'ukode asc';
						break
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess ){
					switch(s){	
						
						case "txtuser":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtuser.text = ws.ukode;
							lbluser.text = ws.unama;
							break
						
						case "UserLog":
							dg.dataProvider.removeAll();
							ws = FlexGlobals.topLevelApplication.wsArrUtama;
							imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							imglast.enabled =FlexGlobals.topLevelApplication. wsIsNext;
							txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							
							for(i=0;i<ws.length;i++){
								dg.dataProvider.addItem({ultgl:ws[i].ultgl,
									unama:ws[i].unama,
									nama:ws[i].nama,
									mnname:ws[i].mnname,
									ulaktivitas:ws[i].ulaktivitas}); 
							}
							
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) )
						switch(s){
							
							case "UserLog":
								FlexGlobals.topLevelApplication.F_defaultGridItem(dg)
								break;
							case "txtuser":
								txtuser.text = "";
								lbluser.text = "";
								break
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "UserLog":
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg)
						break;
					case "txtuser":
						txtuser.text = "";
						lbluser.text = "";
						break
					
				}
			}
			
			
			[Bindable] [Embed(source="assets/tb/preview.png")] public var tbpreview:Class;
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/reset.png")] public var tbreset:Class;
			[Bindable] [Embed(source="assets/tb/template.png")] public var tbtemplate:Class;
			[Bindable] [Embed(source="assets/tb/word.png")]  public var tbword:Class;
			[Bindable] [Embed(source="assets/tb/others.png")] public var tbothers:Class; 
			[Bindable] [Embed(source="assets/tb/help.png")] public var tbhelp:Class;
			[Bindable] [Embed(source="assets/tb/find.png")] public var tbfind:Class;
			[Bindable] [Embed(source="assets/tb/upload.png")]  public var tbattachment:Class;
			[Bindable] [Embed(source="assets/tb/note.png")]  public var tbnote:Class;
			[Bindable] [Embed(source="assets/tb/draft.png")] public var tbdraft:Class;
			[Bindable] [Embed(source="assets/tb/link.png")]  public var tblink:Class;
			[Bindable] [Embed(source="assets/tb/bukatransaksi.png")]  public var tbbuka:Class;
			// set import icon paging
			[Bindable] [Embed(source="assets/nav/f.png")] public var navf:Class;
			[Bindable] [Embed(source="assets/nav/p.png")] public var navp:Class;
			[Bindable] [Embed(source="assets/nav/n.png")] public var navn:Class;
			[Bindable] [Embed(source="assets/nav/l.png")] public var navl:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<!--<net:FileReference id="fileReference"  select="fileReference_select(event);" complete="fileReference_complete(event);" />-->
	</fx:Declarations>	
	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0"/>
	<s:Group left="10" top="40" width="454" height="92">
		<s:Label left="220" top="27" width="32" text="s/d"/>
		<s:Label id="tnogiro" left="1" top="4" width="80" text="User"/>
		<s:Label id="lbluser" left="228" top="2" width="259"/>
		
		<s:TextInput id="txtuser" left="66" top="0"/>
