		<mx:DateField id="dttgl2" left="241" top="21" width="153"/>
		<s:Label id="ttanggaljt" left="1" top="27" width="78" text="Tanggal"/>
		<s:Label id="ttanggaljt0" left="1" top="48" width="78" text="Aktivitas"/>
