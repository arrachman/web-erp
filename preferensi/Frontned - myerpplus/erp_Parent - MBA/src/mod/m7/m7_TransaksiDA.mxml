			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).bsbagianperbandingan+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).bsbagianperbandingan+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "DA"';
						sort = 'tnkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "DA"';
						sort = 'tndkode asc';
						break;
					case 'txtmetode':
						paket = 'CdM7_Depreciation_Category';
						wsfilter = 'aktif = 1 AND kode <> 0 AND kode = "'+txtmetode.text+'"';
						csfilter = 'aktif = 1 AND kode <> 0';
						csfield = 2;
						sort = 'kode asc';
						break;
					case 'txtkategori':
						paket = 'CdM7_Asset_Category';
						wsfilter = 'ackode = "'+txtkategori.text+'" ';
						csfilter = '';
						sort = 'ackode asc';
						break;
//					case 'txtkode1':
//						paket = 'M7_AssetSearch';
//						wsfilter = 'astatus <> 2 AND ametode <> 0 AND kode = "'+txtkode1.text+'" ';
//						csfilter = 'astatus <> 2 AND ametode <> 0 ';
//						sort = 'akode asc';
//						break;
//					case 'txtkode2':
//						paket = 'CdM7_Asset';
//						wsfilter = 'astatus <> 2 AND ametode <> 0 AND kode = "'+txtkode2.text+'" ';
//						csfilter = 'astatus <> 2 AND ametode <> 0 ';
//						sort = 'akode asc';
//						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ob : Object, s:String = parentApplication.subject, b:Boolean, j:int, n:int = -1, nm:String = '';
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtkategori':
							txtkategori.text = obj.ackode;
							break;
						case 'txtmetode':
							txtmetode.text = obj.kode
							break;
//						case 'txtkode1':
//							txtkode1.text = obj.akode;
//							txtkode2.text = obj.akode;
//							break;
//						case 'txtkode2':
//							txtkode2.text = obj.akode;
//							break;
						case 'txtkontakperson':
							txtkontakperson.text = obj.kakodekontak;
							break;
						case 'txtcatatan':
							txtcatatan.text = obj.tndcatatan;
							break;
						case 'tampilkan':
							dg1.dataProvider.removeAll();
							obj = parentApplication.wsArrUtama;
							for(i=0;i<obj.length;i++){
								with(obj.getItemAt(i)){
									dg1.dataProvider.addItem({
										no : i+1,
										chk : false,
										kode : akode,
										nama : anama,
										tglbeli : atglbeli,
										umur : aumurekonomis,
										hargabeli : ahargabeli,
										bebanperbulan : anilaipenyusutan,
										nilaibuku : anilaibuku,
										keterangan : '',
										metode : ametodenama,
										status : astatusnama,
										iddadetail : 0,
										idda : 0,
										idaset : aid,
										penyusutanke : apenyusutanke,
										matauang : amatauang,
										kurs : akurs,
										nilaipenyusutan : anilaipenyusutan,
										nilaibukusebelumnya : anilaibuku,
										costcenter : '',
										divisi : adivisi,
										subdivisi : asubdivisi,
										proyek : '',
										catatan : acatatan,
										urutan : 0,
										isclose : 0,
										customtext1 : '',
										customtext2 : '',
										customtext3 : '',
										customdbl1 : 0,
										customdbl2 : 0,
										customdbl3 : 0,
										customdate1 : parentApplication.m.DateFirst,
										customdate2 : parentApplication.m.DateFirst,
										customdate3 : parentApplication.m.DateFirst
										});
								}
								dg1.setSelectedCell(0, 1);
							}
							break;
						case 'tampil':
							f_focusOnMe();
							isUpdate = true;
							mb.menuBarItems[3].enabled = true;
							mb.menuBarItems[4].enabled = true;
							mb.menuBarItems[5].enabled = true;
							mb.menuBarItems[6].visible = false;
							mb.menuBarItems[7].visible = false;
//							if(parentApplication.wsArrUtama.length < 0)return;
							with(parentApplication.wsArrUtama.getItemAt(0)){
								parentApplication.vpVarCurrent = '@';
								txturaian.text = dauraian;
								dttanggal.text = datgl;
								getNotransaksi = danotransaksi;
								txtnotransaksi.text = getNotransaksi;
								if(int(dastatus) == 0){
									cmbprogress.selectedIndex = 0;
								}else{
									cmbprogress.dataProvider = new  ArrayCollection([{l : 'Approved', v : 2},{l : 'Inprogress', v : 3}, {l : 'Complete', v : 4},{l : 'Close', v : 7}]);
									if(dastatus == 2){cmbprogress.selectedIndex = 0}
									else  if(dastatus == 3){cmbprogress.selectedIndex = 1}
									else  if(dastatus == 4){cmbprogress.selectedIndex = 2}
									else  if(dastatus == 7){cmbprogress.selectedIndex = 3}
									cmbprogress.enabled = false;
								}
								txtkontakperson.text = dabagiandakontak;
								txtcatatan.text = dacatatan;
								txtnoref.text = danoref;
								dtnoref.text = datglnoref;
								chkauto.selected = Boolean(int(daautonotransaksi));
								f_chkAuto();
								
								u = new ArrayCollection([{daid:daid, dacabang:dacabang, dalokasi:dalokasi, dagudang:dagudang, dasumber:dasumber, daautonotransaksi:daautonotransaksi, danotransaksi:danotransaksi, 
									datgl:datgl, dakodepa:dakodepa, damatauang:damatauang, dakurs:dakurs, dabagianda:dabagianda, dabagiandakontak:dabagiandakontak, dauraian:dauraian, 
									dacatatan:dacatatan, danoref:danoref, datglnoref:datglnoref, dastatus:dastatus, dastatussebelumnya:dastatussebelumnya, dajmlrevisi:dajmlrevisi, dacetakanke:dacetakanke, 
									dainputuser:dainputuser, dainputtgl:dainputtgl, damodifikasiuser:damodifikasiuser, damodifikasitgl:damodifikasitgl, daposting:daposting, dapostingtgl:dapostingtgl, datutupperiode:datutupperiode, 
									daisclose:daisclose, dacustomtext1:dacustomtext1, dacustomtext2:dacustomtext2, dacustomtext3:dacustomtext3, dacustomtext4:dacustomtext4, dacustomtext5:dacustomtext5, dacustomint1:dacustomint1, 
									dacustomint2:dacustomint2, dacustomint3:dacustomint3, dacustomdbl1:dacustomdbl1, dacustomdbl2:dacustomdbl2, dacustomdbl3:dacustomdbl3, dacustomdate1:dacustomdate1, dacustomdate2:dacustomdate2, 
									dacustomdate3:dacustomdate3, dacabangnama:dacabangnama, dalokasinama:dalokasinama, dagudangnama:dagudangnama, dabagiandakode:dabagiandakode, dabagiandanama:dabagiandanama, dastatusnama:dastatusnama, 
									dastatussebelumnyanama:dastatussebelumnyanama, dainputusernama:dainputusernama, damodifikasiusernama:damodifikasiusernama}]);
							}
							settingNotransaksi.F_ClickCheckboxAuto(txtnotransaksi, chkauto, txtnotransaksi.text);
							dg1.dataProvider.removeAll();
							
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								obj = parentApplication.wsArrDetail.getItemAt(i);
								dg1.dataProvider.addItem({
									chk : true,
									no:i+1,
									kode : obj.asetkode,
									nama : obj.asetnama,
									tglbeli : obj.asettglbeli,
									umur : obj.asetumurekonomis,
									hargabeli : obj.asethargabeli,
									bebanperbulan : obj.asetbebanperbln,
									nilaibuku : obj.asetnilaibuku,
									keterangan : obj.catatan,
									metode : obj.asetmetodenama,
									status : obj.asetstatusnama,
									iddadetail : obj.iddadetail,
									idda : obj.idda,
									idaset : obj.idaset,
									penyusutanke : obj.penyusutanke,
									matauang : obj.matauang,
									kurs : obj.kurs,
									nilaipenyusutan : obj.nilaipenyusutan,
									nilaibukusebelumnya : obj.nilaibukusebelumnya,
									costcenter : obj.costcenter,
									divisi : obj.divisi,
									subdivisi : obj.subdivisi,
									proyek : obj.proyek,
									catatan : obj.catatan,
									isclose : obj.isclose,
									urutan : obj.urutan,
									customtext1 : obj.customtext1,
									customtext2 : obj.customtext1,
									customtext3 : obj.customtext1,
									customdbl1 : obj.customdbl1,
									customdbl2 : obj.customdbl1,
									customdbl3 : obj.customdbl1,
									customdate1 : obj.customdate1,
									customdate2 : obj.customdate1,
									customdate3 : obj.customdate1
								});
							}
							dg1.setSelectedCell(0, 1);
							break;
						case 'simpan':
							FlexGlobals.topLevelApplication.FormFilter = '';
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_alertCetak(7, 12, 'DA', parentApplication.wsIdtransaksi, parentApplication.wsErrmessage);
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'tampil':
							case 'simpan':
								Alert.show(parentApplication.wsErrmessage, 'Information');
								break;
							case 'tampilkan':
								FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
					case 'tampilkan':
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
						break;
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String = '', tgl:String, n:int = 0;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){
						u.refresh();
						// Set Utama
						with(u.getItemAt(0))
							a = [daid, dacabang, dalokasi, dagudang, dasumber, int(chkauto.selected), getNotransaksi, 
								parentApplication.F_tglFormatDB(dttanggal.text), dakodepa, damatauang, dakurs, dabagianda, txtkontakperson.text, txturaian.text, 
								txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dtnoref.text), cmbprogress.selectedItem.v, dastatussebelumnya, dajmlrevisi, dacetakanke, 
								dainputuser, parentApplication.F_tglFormatDB(dainputtgl), damodifikasiuser, parentApplication.F_tglFormatDB(damodifikasitgl), daposting, parentApplication.F_tglFormatDB(dapostingtgl), datutupperiode, 
								daisclose, dacustomtext1, dacustomtext2, dacustomtext3, dacustomtext4, dacustomtext5, dacustomint1, 
								dacustomint2, dacustomint3, dacustomdbl1, dacustomdbl2, dacustomdbl3, parentApplication.F_tglFormatDB(dacustomdate1), parentApplication.F_tglFormatDB(dacustomdate2), 
								parentApplication.F_tglFormatDB(dacustomdate3)];
						utama = parentApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++)
							with(dg1.dataProvider.getItemAt(i)){
								if(chk == 1){
									a = [iddadetail, idda, idaset, penyusutanke, matauang, kurs, nilaipenyusutan, 
										nilaibukusebelumnya, costcenter, divisi, subdivisi, proyek, keterangan, i+1, 
										isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
									if(detail == '')detail = parentApplication.F_splitArrayToString(a);
									else detail += "▲"+parentApplication.F_splitArrayToString(a);
								}
							}
						parentApplication.F_wsSimpan('simpan', 'M7_DaSimpan', parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					vMsgIng = "";
					vMsg = "";
					if(dttanggal.text.length == 0)msgAlert(dttanggal,'Date','Tanggal');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)msgAlert(cmbprogress,'Progress','Progress');
					if(vMsg != '')msgAlert('clear', '', '');
					
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi == true)focus.setFocus();
						vMsgIng += inggris+', ';
						vMsg += indonesia+', ';
						if(focus == 'clear'){
							vMsg = vMsg.substr(0, vMsg.length-4);
							vMsg += " harus diisi dengan benar";
							vMsgIng = vMsgIng.substr(0, vMsgIng.length-4);
							vMsgIng += " must be filled";
							Alert.show(vMsgIng+"  ("+vMsg+")" , "Information");}	
						validasi = false; 
					}
				}
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
			public function f_tampilkan():void
			{
				strFilter = 'astatus <> 2 AND ametode <> 0';
				parentApplication.vpFocusEvent = true;
				if(txtkategori.text.length > 0){
					strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'akategori = "'+txtkategori.text+'"');
				}
				if(txtmetode.text.length > 0){
					strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'ametode = "'+txtmetode.text+'"');
				}
				if(txtnama.text.length > 0){
					strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'anama like "%'+txtnama.text+'%"');
				}
				if(txtkode1.text.length > 0 && txtkode2.text.length > 0){
					strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'akode BETWEEN "'+txtkode1.text+'" AND "'+txtkode2.text+'"');
				}else if(txtkode1.text.length > 0) 
					strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'akode >= "'+txtkode1.text+'"'); 
				else if(txtkode2.text.length > 0)
					strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'akode <= "'+txtkode2.text+'"'); 
				
				parentApplication.F_wsSearch('tampilkan', 'M7_AssetSearch', 0, 0, strFilter, 'akode asc');
			}
			
