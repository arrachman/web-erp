			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				with(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex)){
					switch(dataField){
						case 'calculator':
							break;
					}
				}
				switch (components){
					case 'checkBoxHeader':
						for (i=0; i<dg1.dataProviderLength; i++){
							dg1.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case 'checkBox':
						dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).chk = data;
						break;
				}
				
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_focusOnMe():void
