			protected function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([turaian, turaian, ttanggal, tnotransaksi, tkontakperson, tcatatan]);
				parentApplication.F_RequiredLabel([ttanggal, tnotransaksi]);
				
				parentApplication.F_DateFieldStandard([dttanggal, dtnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtkategori, txtmetode])
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian,txtnoref, txtnama, txtkode1, txtkode2]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				
//				// untuk ambil setting dari Json
				parentApplication.F_RegGrid(7, 12, [dg1], 'transaksi');
				if(parentApplication.FormFilter != ''){
					f_kondisiAwal();
					parentApplication.F_wsGetDataById('tampil', 'M7_DaGetdataById', parentApplication.FormFilter, 0, 0, '', 'urutan ASC', 'dd/MM/yyyy', 'dd/MM/yyyy');
				}else{
					f_kondisiAwal();
				}
				
				// fungsi menubar
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				function f_mbSimpan():void
				{
					f_simpan();
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbTampilkan():void
				{
					f_tampilkan();
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[3].enabled == true)
						parentApplication.F_OpenUploadFile('DA', u.getItemAt(0).daid, txtnotransaksi.text);
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[4].enabled == true)
						parentApplication.F_OpenNotes('DA', u.getItemAt(0).daid, txtnotransaksi.text);
				}
				function f_mbLinks():void
				{
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(mb.menuBarItems[0].enabled == true)
							if(e.ctrlKey)f_simpan();
						break;
				}
			}	
			
			protected function f_kondisiAwal():void
			{
				isUpdate = false;
				//cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				parentApplication.F_SetNilaiText([dttanggal, dtnoref], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtnotransaksi, txtkontakperson, txturaian, txtcatatan, txtkategori, txtkode1, txtkode2, txtnama, txtmetode]);
				cmbprogress.enabled = true;
				//cmbprogress.selectedIndex = 1;
				
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 7, "DA");
				
				txturaian.text = parentApplication.getNomor("DA");
				txtcatatan.text = parentApplication.getNomor("DA");
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
				f_chkAuto();
				f_focusOnMe();
				
				u = new ArrayCollection([{
					daid:0, dacabang:parentApplication.ucabang, dalokasi:parentApplication.ulokasi, dagudang:parentApplication.ugudang, dasumber:'DA', daautonotransaksi:int(chkauto.selected), danotransaksi:getNotransaksi, 
					datgl:dttanggal.text, dakodepa:0, damatauang:parentApplication.getSetting(0, 'accounting', 'MataUangFungsional'), dakurs:parentApplication.getSetting(0, 'accounting', 'Kurs'), dabagianda:parentApplication.userid, dabagiandakontak:txtkontakperson.text, dauraian:txturaian.text, 
					dacatatan:txtcatatan.text, danoref:txtnoref.text, datglnoref:dtnoref.text, dastatus:cmbprogress.selectedItem.v, dastatussebelumnya:0, dajmlrevisi:0, dacetakanke:0, 
					dainputuser:parentApplication.userid, dainputtgl:tglDB, damodifikasiuser:0, damodifikasitgl:tglDB, daposting:0, dapostingtgl:tglDB, datutupperiode:0, 
					daisclose:0, dacustomtext1:'', dacustomtext2:'', dacustomtext3:'', dacustomtext4:'', dacustomtext5:'', dacustomint1:0, 
					dacustomint2:0, dacustomint3:0, dacustomdbl1:0, dacustomdbl2:0, dacustomdbl3:0, dacustomdate1:parentApplication.m.DateFirst, dacustomdate2:parentApplication.m.DateFirst, 
					dacustomdate3:parentApplication.m.DateFirst
				}]);
				
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
