			public function f_kondisi_awal():void
			{
				o.txthargabeli = 0;
				o.txtnilairesidu = 0;
				o.txtumurekonomis = 0;
				o.txtbebanperbulan = 0;
				o.txtakumulasibeban = 0;
				o.txtnilairesidu = 0;
				idaset = 0;
				isUpdate = false;
				parentApplication.F_KosongkanText([txtkode,txtnama,txtkelompok,txtketerangan,txtnomor,txtdivisi,txtsubdivisi,txtlokasi,txtpenyusutan,txtrekaktiva,txtrekakumulasi,txtrekdepresiasi]);
				parentApplication.F_SetNilaiText([txthargabeli, txtnilairesidu, txtbebanperbulan, txtakumulasibeban, txtnilaibuku], parentApplication.F_formatNominal(0));
				parentApplication.F_SetNilaiText([txtumurekonomis], 0);
				dttanggalbeli.text = FlexGlobals.topLevelApplication.DefaultTanggal;
				dttanggalpakai.text = FlexGlobals.topLevelApplication.DefaultTanggal;
				dttanggalpensiun.text = FlexGlobals.topLevelApplication.DefaultTanggal;
				matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				kurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				//chkaktif.selected = true;
			}
			
			private function hitungbeban():void
			{
				o.txtbebanperbulan = (o.txthargabeli - o.txtnilairesidu) / o.txtumurekonomis;
				if(o.txtumurekonomis == 0){
					txtbebanperbulan.text = FlexGlobals.topLevelApplication.F_formatNominal(o.txtumurekonomis);
				}else{
					txtbebanperbulan.text = numberFormatter.format(o.txtbebanperbulan);
				}
				hitungnilaibuku();
			}
			private function hitungnilaibuku():void
			{
				o.txtnilaibuku = o.txthargabeli - o.txtnilairesidu - o.txtakumulasibeban;
				txtnilaibuku.text = numberFormatter.format(o.txtnilaibuku);
			}
			private var tgl:int  =0;
			private var bulan:int = 0;
			private var tahun:int = 0;
			private var pensiun:int=0;
			
			private function getfirst():void
			{
				var tglpakai:Array = dttanggalpakai.text.split("/");
				tgl=tglpakai[0];
				bulan= tglpakai[1];
				tahun= tglpakai[2];
				pensiun=0;
			}
			private function getmaxmount(year:int,month:int):int
			{
				var date:Date = new Date(year, month, 0);
				var lastDayInFeb:Number = date.getDate();
				return lastDayInFeb;
			}
			private function setpensiun():void
			{
				var i:int=0;
				var selisih:int=0;
				var selisihstring:String='';
				var bulanstring:String='';
				getfirst();
				pensiun = int(txtumurekonomis.text) + tgl; //tanggal di tambah umur ekonomis
				for (i=0;i=100;i++)
				{
					selisih = pensiun - getmaxmount(tahun,bulan);
					if (selisih> 0){
						if (bulan < 12){
							bulan += 1;
						}else{
							tahun += 1;
							bulan = 1;
						}
						pensiun = selisih;
					}else{
						if (Math.abs(selisih) == getmaxmount(tahun,bulan)){selisih = getmaxmount(tahun,bulan)}
						else{selisih = pensiun;}
						selisihstring = selisih.toString();
						bulanstring = bulan.toString();
						if (selisihstring.length == 1 ){selisihstring = "0" + selisihstring;}
						if (bulanstring.length == 1 ){ bulanstring = "0" + bulanstring;}
						dttanggalpensiun.text = selisihstring +"/"+bulanstring+"/"+tahun;
						return;
					}
				}
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if(FlexGlobals.topLevelApplication.FormFilter == "tambah"){
					p.m[p.idmodcurr].child.acmaster.addItem({aid:0, akode:txtkode.text, anama:txtnama.text, akategori:txtkelompok.text,
