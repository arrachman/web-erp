						asubdivisi:txtsubdivisi.text, acatatan:txtketerangan.text, anomor:txtnomor.text, atglbeli:dttanggalbeli.text, 
						atglpakai:dttanggalpakai.text, amatauang:matauang, akurs:kurs, 
						ahargabeli:o.txthargabeli, anilairesidu:o.txtnilairesidu, aumurekonomis:o.txtumurekonomis, abebanperbln:o.txtbebanperbulan, 
						aakumulasibeban:o.txtakumulasibeban, anilaibuku:o.txtnilaibuku, ametode:kodepenyusutan, 
						atabelpenyusutan:"", aintangible:0, afiskal:int(chkaktivatetapfiskal.selected), aatastengahbulan:int(chkpembelian.selected), 
						arekasset:txtrekaktiva.text, arekakumdepresiasi:txtrekakumulasi.text, arekdepresiasi:txtrekdepresiasi.text, 
						arekpenghapusan:'', aprodusen:0, atglpensiun:dttanggalpensiun.text, apenyusutanke:0, anilaimenurun:0, adispose:0, apembelian:0, 
						apenjualan:0, alocked:0, astatus:0, astatussebelumnya:0, aisclose:0, ainputuser:vUserId, ainputtgl:FlexGlobals.topLevelApplication.DefaultTanggal,
						amodifikasiuser:0, amodifikasitgl:FlexGlobals.topLevelApplication.DefaultTanggal, 
						acustomtext1:'', acustomtext2:'', acustomtext3:'', acustomtext4:'', acustomtext5:'',
						acustomint1:0, acustomint2:0, acustomint3:0, acustomdbl1:0, acustomdbl2:0, acustomdbl3:0, 
						acustomdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
						acustomdate2:FlexGlobals.topLevelApplication.DefaultTanggal, 
						acustomdate3:FlexGlobals.topLevelApplication.DefaultTanggal, asatuan:txtsatuan.text, aharga:o.txthargabeli});
					var dgrid :Object;
					p.m[p.idmodcurr].child.f_setDetail();
					dgrid = dg.dataProvider[dg.selectedCell.rowIndex];
					dgrid.kodeasset = txtkode.text;
					dgrid.namaasset = txtnama.text;
					dgrid.harga = o.txthargabeli;
					dgrid.divisi = txtdivisi.text;
					dgrid.subdivisi = txtsubdivisi.text;
					dgrid.rekasset = txtrekaktiva.text;
					dgrid.subtotal = dgrid.jml * dgrid.harga;
					dgrid.satuan = txtsatuan.text;
					p.m[p.idmodcurr].child.f_hitungTotal();
					
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkelompok':
						paket = 'CdM7_Asset_Category';
						wsfilter = 'ackode ="'+txtkelompok.text.split('"').join('\\"')+'"';
						sort = 'ackode asc';
						break;
					case 'txtrekaktiva':
						paket = 'CdM1_Coa';
						wsfilter = "caktif = 1 AND cgd = 'D' AND cnomor = '"+txtrekaktiva.text+"'";
						csfilter = "caktif = 1 AND cgd = 'D'";
						break;
					case 'txtrekdepresiasi':
						paket = 'CdM1_Coa';
						wsfilter = "caktif = 1 AND cgd = 'D' AND cnomor = '"+txtrekdepresiasi.text+"'";
						csfilter = "caktif = 1 AND cgd = 'D'";
						break;
					case 'txtrekakumulasi':
						paket = 'CdM1_Coa';
						wsfilter = "caktif = 1 AND cgd = 'D' AND cnomor = '"+txtrekakumulasi.text+"'";
						csfilter = "caktif = 1 AND  cgd = 'D'";
						break;
					case 'txtdivisi':
						paket = 'CdM1_Division';
						wsfilter = "daktif = 1 AND dkode = '"+txtdivisi.text+"'";
						csfilter = "daktif = 1";
						break;
					case 'txtsubdivisi':
						paket = 'CdM1_Subdivision';
						wsfilter = "sdaktif = 1 AND sddivisi = '"+txtdivisi.text+"' AND sdkode = '"+txtsubdivisi.text+"'";
						csfilter = "sdaktif = 1 AND sddivisi = '"+txtdivisi.text+"'";
						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						wsfilter = "laktif = 1 AND lkode = '"+txtlokasi.text+"'";
						csfilter = "laktif = 1";
						break;
					case 'txtpenyusutan':
						paket = 'CdM7_Depreciation_Category';
						wsfilter = 'aktif=1 AND nama ="'+txtpenyusutan.text.split('"').join('\\"')+'"';
						csfilter = 'aktif=1';
						sort = 'kode asc';
						break;
					case "txtsatuan":
						paket = "CdM1_Unit";
						wsfilter = 'uaktif=1 AND ukode ="'+txtsatuan.text+'"';
						csfilter = 'uaktif=1';
						csfield = 2;
						sort = 'ukode asc';
						break
					case "txtcostcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+txtcostcenter.text+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "txtproyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+txtproyek.text+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var obj:Object, s:String = parentApplication.subject;
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){
						case 'txtkelompok':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtkelompok.text = obj.ackode;
							FlexGlobals.topLevelApplication.F_wsSearch('AmbilKategori', 'M7_Asset_CategorySearch', 0, 0, 'ackode = "'+txtkelompok.text+'"', '', '', '');
							break;
						case 'AmbilKategori':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							o.txtumurekonomis = obj.ackategoripajakumur;
							txtumurekonomis.text = o.txtumurekonomis;
							txtpenyusutan.text = obj.ackategoripajakmetodenama;
							kodepenyusutan = obj.ackategoripajakmetode;
							txtrekaktiva.text = obj.acrekasset;
							txtrekdepresiasi.text = obj.acrekdepresiasi;
							txtrekakumulasi.text = obj.acrekakumdepresiasi;
							lblrekaktiva.text = obj.acrekassetnama;
							lblrekdepresiasi.text = obj.acrekdepresiasinama;
							lblrekakumulasi.text = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0).acrekakumdepresiasinama;
							break;
						case 'txtrekaktiva':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtrekaktiva.text = obj.cnomor;
							break;
						case 'txtrekdepresiasi':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtrekdepresiasi.text = obj.cnomor;
							break;
						case 'txtrekakumulasi':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtrekakumulasi.text = obj.cnomor;
							break;
						case 'txtlokasi':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtlokasi.text = obj.lkode;
							break;
						case 'txtdivisi':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtdivisi.text = obj.dkode;
							break;
						case 'txtsubdivisi':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtsubdivisi.text = obj.sdkode;
							break;
						case 'txtpenyusutan':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtpenyusutan.text = obj.nama;
							kodepenyusutan = obj.kode;
							break;
						case 'txtsatuan':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtsatuan.text = obj.ukode;
							break;
						case 'txtcostcenter': // Cost Center
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtcostcenter.text = obj.cckode;
							break;
						case 'txtproyek': // proyek
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtproyek.text = obj.pkode;
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'txtkelompok':break;
							case 'txtrekaktiva':break;
							case 'txtrekdepresiasi':break;
							case 'txtrekakumulasi':break;
							case 'txtlokasi':break;
							case 'txtsatuan': break;
							case 'txtcostcenter': break;
							case 'txtproyek': break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkelompok':parentApplication.F_KosongkanText([txtkelompok]);break;
					case 'txtrekaktiva':parentApplication.F_KosongkanText([txtrekaktiva]);break;
					case 'txtrekdepresiasi':parentApplication.F_KosongkanText([txtrekdepresiasi]);break;
					case 'txtrekakumulasi':parentApplication.F_KosongkanText([txtrekakumulasi]);break;
					case 'txtpenyusutan':txtpenyusutan.text=''; kodepenyusutan = ''; break;
					case 'txtsatuan': txtsatuan.text = "";break;
					case 'txtcostcenter': txtcostcenter.text = ""; break;
					case 'txtproyek': txtproyek.text=""; break;
				}
			}
			
