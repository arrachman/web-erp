							}
							
							f_hitungTotal();
							break;
						case 'simpan':
							FlexGlobals.topLevelApplication.FormFilter='';
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_alertCetak(7, 3, 'AR', FlexGlobals.topLevelApplication.wsIdtransaksi, FlexGlobals.topLevelApplication.wsErrmessage, o.tanggal+" s.d "+o.tanggal);
							break;
						case 'print':
