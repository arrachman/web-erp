				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.artotal = 0;
				o.artotalpajak1detail = 0;
				o.artotalpajak2detail = 0;
				o.artotaltransaksi = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).subtotal != undefined)o.artotal += Number(dg.dataProvider.getItemAt(i).subtotal);
					if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.artotalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.artotalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.artotal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.artotalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.artotalpajak2detail);
				
				o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.artotal, o.txtdiskonpersen);
				txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal.toString());
				o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.artotal, o.txtbiayalainpersen);
				txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal.toString());
				f_hitungTotalUtama();
				//				o.prtotaltransaksi= (Number(o.prtotal) + Number(o.prtotalpajak1detail) + Number(o.prtotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prtotaltransaksi);
			}
			
			public function f_hitungTotalUtama():void
			{
				o.artotaltransaksi= (Number(o.artotal) + Number(o.artotalpajak1detail) + Number(o.artotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.artotaltransaksi);
			}
			public function f_hitungGrid():void{
				var dgrid:Object;
				for(i = 0; i<dg.dataProviderLength; i++){
					dgrid = dg.dataProvider[i]
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
					dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
					dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
				}
				
				f_hitungTotal();
			}
			
