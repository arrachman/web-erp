				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				tab.selectedIndex=0;
				cmbprogress.selectedIndex=1;
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				f_focusOnMe(); 
				isUpdate = false;
				txtkurs.enabled = false;
				cmbasalbarang.selectedIndex=0;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalpajak1,lbltotalpajak2,lbltotaltransaksi,txtbiayalainnominal,txtbiayalainpersen,txtdiskonnominal,txtdiskonpersen],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				//FlexGlobals.topLevelApplication.F_SetNilaiText([txtdiskonpersen],0);
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("AR");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("AR",1);
				parentApplication.F_SetNilaiText([dttgl,dttglbutuh,dttglnoref], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtdimintaoleh, lbldimintaoleh, txtmintake, lblmintake,txtkontakperson,txttermin,txtnoref]);
				
				o.arid=0; o.arcabang=FlexGlobals.topLevelApplication.ucabang; o.arlokasi=FlexGlobals.topLevelApplication.ulokasi; 
				o.arsumber = "AR"; 
				o.arkodepa = 0; o.ardimintaoleh = 0; o.armintake = 0;  o.artgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal;
				o.artglpenutupan = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.arhargatermasukpajak = 0; o.artotal = 0; o.ardiskonpersen = 0; o.arjmldiskon = 0; o.artotalpajak1detail = 0; 
				o.artotalpajak2detail = 0; o.arbiayalainpersen = 0; 
				o.arbiayalain = 0; o.artotaltransaksi = 0; o.arstatusaq = 0; o.arstatusao = 0; o.arstatusae = 0; 
				o.arstatusai = 0; o.arstatusrealisasi = 0; 
				o.arstatussebelumnya = 0; o.arjmlrevisi = 0; o.arcetakanke = 0; o.arinputuser = FlexGlobals.topLevelApplication.userid; 
				o.arinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.armodifikasiuser = 0; 
				o.armodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.arposting = 0; 
				o.arpostingtgl = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.arisclose = 0; o.arcustomtext1 = ''; o.arcustomtext2 = ''; o.arcustomtext3 = ''; 
				o.arcustomtext4 = ''; o.arcustomtext5 = ''; 
				o.arcustomint1 = 0; o.arcustomint2 = 0; o.arcustomint3 = 0; o.arcustomdbl1 = 0; o.arcustomdbl2 = 0; 
				o.arcustomdbl3 = 0; o.arcustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.arcustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.arcustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							f_simpan();
						}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid1:Object;
				switch (components){
					case  'calculator':
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						switch (dataField){
							case 'jml':
							case 'harga':
							case 'diskon':
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml;
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							case 'jmldiskon':
								dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0){
										Alert.show("Item Amount can't be 0 (Jumlah tidak boleh 0)", 'Information');
									}else if(dgrid1.harga == 0){
										Alert.show("Price can't be 0 (Harga tidak boleh 0)", "Information");
									}else if(dgrid1.jml == 0 && dgrid1.harga == 0){
										Alert.show("Item Amount and Price can't be 0 (Jumlah dan Harga tidak boleh 0)", "Information");
									}
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
								}
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							
						}
						break;
				}
				f_hitungTotal();
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array, dgrid1:Object;
				switch(column){ 
					case 'namaasset':
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
						dgrid1.idardetail = 0; 
						dgrid1.idar = 0; 
						dgrid1.idasset = 0; 
						dgrid1.jml = 0; 
						dgrid1.satuan = "";
						dgrid1.matauang = ''; 
						dgrid1.kurs = 0; 
						dgrid1.harga = 0; 
						dgrid1.diskon = 0; 
						dgrid1.jmldiskon = 0; 
						dgrid1.pajak1 = ""; 
						dgrid1.jmlpajak1 = 0; 
						dgrid1.pajak2 = ""; 
						dgrid1.jmlpajak2 = 0; 
						dgrid1.pajak1nilai = 0;
						dgrid1.pajak2nilai = 0;
						dgrid1.cabang = FlexGlobals.topLevelApplication.ucabang; 
						dgrid1.lokasi = FlexGlobals.topLevelApplication.ulokasi; 
						dgrid1.costcenter = ''; 
						dgrid1.divisi = ''; 
						dgrid1.subdivisi = ''; 
						dgrid1.proyek = ''; 
						dgrid1.catatan = ''; 
						dgrid1.urutan = 0; 
						dgrid1.jmlaq = 0; 
						dgrid1.statusaq = 0; 
						dgrid1.jmlao = 0; 
						dgrid1.statusao = 0; 
						dgrid1.jmlae = 0; 
						dgrid1.statusae = 0; 
						dgrid1.jmlai = 0; 
						dgrid1.statusai = 0; 
						dgrid1.jmlrealisasi = 0; 
						dgrid1.statusrealisasi = 0; 
						dgrid1.isclose = 0; 
						dgrid1.customtext1 = ""; 
						dgrid1.customtext2 = ""; 
						dgrid1.customtext3 = ""; 
						dgrid1.customdbl1 = 0; 
						dgrid1.customdbl2 = 0; 
						dgrid1.customdbl3 = 0; 
						dgrid1.customdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
						dgrid1.customdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
						dgrid1.customdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
						dgrid1.satuan = "";

						break
					case 'jml':
					case 'harga':
					case 'diskon':
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
						dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml, 
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'jmldiskon':
						vMsg = ''; vMsgIng = '';
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
						if(dgrid1.jml == 0 || dgrid1.harga == 0){
							if(dgrid1.jml == 0)msgAlert(dg,'Jumlah', 'Quantity');
							if(dgrid1.harga == 0)msgAlert(dg,"Harga", "Price");
							if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
							dgrid1.jmldiskon = 0;
							dgrid1.diskon= 0;
						}else{
							dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
							
						}
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'pajak1':
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'pajak2':
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
				}
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String = '';
				switch(target){
					case "txtdimintaoleh":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif="1" and kkategori="K" and kkode ="'+txtdimintaoleh.text+'"';
						csfilter = 'kaktif="1" and kkategori="K"';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.prdimintaoleh+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.prdimintaoleh+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtmintake":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif="1" and kkategori="K" and kkode ="'+txtmintake.text+'"';
						csfilter = 'kaktif="1" and kkategori="K"';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break;
					case "txttermin":
						paket = "CdM1_Terms";
						wsfilter = 'traktif=1 AND trkode = "'+txttermin.text+'"';
						csfilter = 'traktif=1';
						sort = 'trkode asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif=1 AND tnsumber="PR"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					//grid detail
					case "kodebarang":
						paket = "CdM1_Item";
						wsfilter = 'baktif=1 AND baktif=1 and bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
						csfilter = 'baktif=1 AND baktif=1';
						csfield = 2;
						sort = 'bkode asc';
						break;
					case "satuan":
						paket = "CdM1_Unit";
						wsfilter = 'uaktif=1 AND ukode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).satuan+'"';
						csfilter = 'uaktif=1';
						csfield = 2;
						sort = 'ukode asc';
						break
					case "pajak1":
						paket = "CdM1_Tax";
						wsfilter = 'taktif=1 AND tkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pajak1+'"';
						csfilter = 'taktif=1';
						csfield = 2;
						sort = 'tkode asc';
						break;
					case "pajak2":
						paket = "CdM1_Tax";
						wsfilter = 'taktif=1 AND tkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pajak2+'"';
						csfilter = 'taktif=1';
						csfield = 2;
						sort = 'tkode asc';
						break;
					case "gudang":
						paket = "CdM1_Warehouse";
