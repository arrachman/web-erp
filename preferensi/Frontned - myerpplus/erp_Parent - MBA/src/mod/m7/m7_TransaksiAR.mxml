									cmbprogress.dataProvider = new ArrayCollection([{l : 'Approved', v : 2},{l : 'Inprogress', v : 3}, {l : 'Complete', v : 4},{l : 'Close', v : 7}]);
									cmbprogress.enabled = false;
									mb.menuBarItems[0].enabled = false;
									if(prstatus == 2){cmbprogress.selectedIndex = 0}
									else if(prstatus == 3){cmbprogress.selectedIndex = 1}
									else if(prstatus == 4){cmbprogress.selectedIndex = 2}
									else if(prstatus == 7){cmbprogress.selectedIndex = 3}
								}else{
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									cmbprogress.selectedIndex = 0;
									cmbprogress.enabled = true;
									mb.menuBarItems[0].enabled = true;
								}
								
								o.prid=prid; o.prcabang=prcabang; o.prlokasi=prlokasi; o.prasalbarang=prasalbarang; o.prjenispembelian=prjenispembelian; 
								o.prtgljatuhtempo = prtgljatuhtempo; o.prjenispembeliankategori=prjenispembeliankategori; o.prsumber=prsumber; o.prkodepa=prkodepa; 
								o.prdimintaoleh=prdimintaoleh; o.prmintake=prmintake; o.prtglpenutupan=prtglpenutupan; o.prhargatermasukpajak=prhargatermasukpajak; 
								o.prtotal=prtotal; o.prdiskonpersen=prdiskonpersen; o.prjmldiskon=prjmldiskon; o.prtotalpajak1detail=prtotalpajak1detail; 
								o.prtotalpajak2detail=prtotalpajak2detail; o.prbiayalainpersen=prbiayalainpersen; o.prbiayalain=prbiayalain; 
								o.prtotaltransaksi=prtotaltransaksi; o.pridsq=pridsq; o.prstatuscs=prstatuscs; o.prstatusrq=prstatusrq; o.prstatuspo=prstatuspo; 
