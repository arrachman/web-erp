<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				if(parentApplication.m[parentApplication.idmodcurr].child.hasOwnProperty('dg'))
					dg = parentApplication.m[parentApplication.idmodcurr].child.dg;
				else
					dg = parentApplication.m[parentApplication.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M12_Area_CategoryCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				
				if(parentApplication.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ackode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].acnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].accatatan;
					vUserIdEdit = parentApplication.userid;
					o.accustomtext1 = dg.dataProvider[dg.selectedCell.rowIndex].accustomtext1; 
					o.accustomtext2 = dg.dataProvider[dg.selectedCell.rowIndex].accustomtext2;
					o.accustomtext3 = dg.dataProvider[dg.selectedCell.rowIndex].accustomtext3;
					o.accustomtext4 = dg.dataProvider[dg.selectedCell.rowIndex].accustomtext4;
					o.accustomtext5 = dg.dataProvider[dg.selectedCell.rowIndex].accustomtext5;
					o.accustomint1 = dg.dataProvider[dg.selectedCell.rowIndex].accustomint1;
					o.accustomint2 = dg.dataProvider[dg.selectedCell.rowIndex].accustomint2;
					o.accustomint3 = dg.dataProvider[dg.selectedCell.rowIndex].accustomint3;
					o.accustomdbl1 = dg.dataProvider[dg.selectedCell.rowIndex].accustomdbl1;
					o.accustomdbl2 = dg.dataProvider[dg.selectedCell.rowIndex].accustomdbl2;
					o.accustomdbl3 = dg.dataProvider[dg.selectedCell.rowIndex].accustomdbl3;
					o.accustomdate1 = dg.dataProvider[dg.selectedCell.rowIndex].accustomdate1;
					o.accustomdate2 = dg.dataProvider[dg.selectedCell.rowIndex].accustomdate2;
					o.accustomdate3 = dg.dataProvider[dg.selectedCell.rowIndex].accustomdate3;
					if (dg.dataProvider[dg.selectedCell.rowIndex].acaktif=="0")
					{
						chkaktif.selected = false;
					}else{
						chkaktif.selected = true;
					}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama, txtcatatan]);
				o.accustomtext1 = ''; o.accustomtext2 = ''; o.accustomtext3 = ''; o.accustomtext4 = ''; o.accustomtext5 = '';
				o.accustomint1 = 0; o.accustomint2 = 0; o.accustomint3 = 0;
				o.accustomdbl1 = 0; o.accustomdbl2 = 0; o.accustomdbl3 = 0; 
				o.accustomdate1 = parentApplication.m.DateFirst; o.accustomdate2 = parentApplication.m.DateFirst; o.accustomdate3 = parentApplication.m.DateFirst;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					arr = [txtkode.text, txtnama.text, txtcatatan.text, int(chkaktif.selected), vUserId, vDefDt, vUserIdEdit, vDefDt,
							String(o.accustomtext1), String(o.accustomtext2), String(o.accustomtext3), String(o.accustomtext4), String(o.accustomtext5),
							int(o.accustomint1), int(o.accustomint2), int(o.accustomint3), 
							Number(o.accustomdbl1), Number(o.accustomdbl2), Number(o.accustomdbl3),
							parentApplication.F_tglFormatDB(o.accustomdate1), parentApplication.F_tglFormatDB(o.accustomdate2), parentApplication.F_tglFormatDB(o.accustomdate3)];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M12_Area_CategorySimpan', utama, 'ackode')
					vUserIdEdit = 0;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtprovinsi':
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtprovinsi':
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtprovinsi': 
								break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtprovinsi':
						break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" right="1" top="-1" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="64" text="Nama"/>
	<s:Label id="tcatatan" left="9" top="85" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="70" width="272" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58" height="22" maxChars="100"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="79" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="346" y="38" label="Aktif" selected="true"/>
</s:Module>
