<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	
	<fx:Script> 
		<![CDATA[			
			import flashx.textLayout.elements.TCYElement;
			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.CheckBox;
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			[Bindable] public var ac2:ArrayCollection = new ArrayCollection();
			[Bindable] protected var arrMenuBar:ArrayCollection;
			protected var i:int, isUpdate:Boolean, UFungsional:String;
			public var o:Object = {}, no:int, vIdkontak:int, arrColumn:Array = new Array, validasi:Boolean, pesanAlert:String, pesanAlertIng:String;
			
			public function f_focusOnMe():void
			{
				txtkontakkategori.setFocus();
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBoxHeader':
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case 'checkBox':
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
			protected function f_persiapan():void
			{
				tab.focusEnabled = false;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RequiredLabel([ttanggal, tnotransaksi, tprogress]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkategorikontak, tkontak, turaian, ttanggal, tnotransaksi, tprogress, tcatatan]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}
				]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtkontak, txtkontak2, txtkontakkategori]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi, chkauto]);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLink);
				
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(12,25,jenissimpan)==true){
							f_simpan();
						}
					}
				}
				
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Cpa");
				}
				
				function f_mbReset():void{
					mb.menuBarItems[4].enabled = false;
					mb.menuBarItems[5].enabled = false;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
				}
				
				function f_mbTampilkan():void{
					if(int(txtpaging.text)<=0){
						f_wsTampil(1);
					}else{
						f_wsTampil(int(txtpaging.text));
					}
				}
				
				function f_mbCatatan():void{
					if(mb.menuBarItems[4].enabled==true){
						FlexGlobals.topLevelApplication.F_OpenNotes(o.cpasumber,o.cpaid,txtnotransaksi.text);
					}
				}
				
				function f_mbUpload():void {
					if(mb.menuBarItems[5].enabled==true){
						FlexGlobals.topLevelApplication.F_OpenUploadFile('CPA', o.cpaid,txtnotransaksi.text);
					}
				}
				
				function f_mbLink():void {
					if(mb.menuBarItems[6].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(12,'Cpa');
				}
				
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
				}
				
				// Config Paging
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = "0";
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				function f_firstCLICK():void{
					f_wsTampil(1);
				}
				function f_previousCLICK():void{
					f_wsTampil(int(txtpaging.text) - 1);
					txtpaging.text = String(int(txtpaging.text) - 1)
				}
				function f_nextCLICK():void{
					f_wsTampil(int(txtpaging.text) + 1)
					txtpaging.text = String(int(txtpaging.text) + 1)
				}
				function f_lastCLICK():void{
					f_wsTampil(int(- 1))
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_wsTampil(int(txtpaging.text));
				}
				
				FlexGlobals.topLevelApplication.F_RegGrid(12,25,[dg],'transaksi');
				f_validasi();
			}
			
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M12_CpaHistoryGetdataById', idtransaksi, 1, 20, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M12_CpaGetdataById', idtransaksi, 1, 20, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled=true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				FlexGlobals.topLevelApplication.FormFilter = '';
				cmbprogress.selectedIndex = 1;
				txtnotransaksi.text = 'Auto';
				isUpdate = false;
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("CPA");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("CPA",1);
				parentApplication.F_SetNilaiText([dttgl], parentApplication.DefaultTanggal);
				txtkontakkategori.text = "C";
				lblkontakkategori.text = "Customer";
				FlexGlobals.topLevelApplication.F_KosongkanText([txtkontak, txtkontak2, txtkontakperson]);
				
				o.cpaid = 0; o.cpacabang = parentApplication.ucabang; o.cpalokasi = parentApplication.ulokasi; o.cpasumber = 'CPA'; o.cpaautonotransaksi = int(chkauto.selected); o.cpanotransaksi = txtnotransaksi.text; o.cpatgl = dttgl.text; 
				o.cpakodepa = '0'; o.cpakontak = parentApplication.ukontak; o.cpakontakperson = txtkontakperson.text; o.cpauraian = txturaian.text; o.cpacatatan = txtcatatan.text; o.cpastatus = cmbprogress.selectedItem.v; o.cpastatussebelumnya = 0;
				o.cpajmlrevisi = 0; o.cpacetakanke = 0; o.cpaisclose = 0; o.cpainputuser = parentApplication.userid; o.cpainputtgl = parentApplication.DefaultTanggal; o.cpamodifikasiuser = parentApplication.userid; o.cpamodifikasitgl = parentApplication.DefaultTanggal;
				o.cpaposting = 0; o.cpapostingtgl = parentApplication.DefaultTanggal; o.cpacustomtext1 = ''; o.cpacustomtext2 = ''; o.cpacustomtext3 = ''; o.cpacustomtext4 = ''; o.cpacustomtext5 = '';
				o.cpacustomint1 = 0; o.cpacustomint2 = 0; o.cpacustomint3 = 0; o.cpacustomdbl1 = 0; o.cpacustomdbl2 = 0; o.cpacustomdbl3 = 0; o.cpacustomdate1 = parentApplication.DefaultTanggal; 
				o.cpacustomdate2 = parentApplication.DefaultTanggal; o.cpacustomdate3 = parentApplication.DefaultTanggal;
			}
			
			protected function f_wsTampil(page:int = 0, sort:String = 'kkode asc'):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("tampilKontak", "CdM1_Contact", page, 20, f_filterdata(), sort);
			}
			
			public function f_filterdata():String{
				var f:String="kaktif=1";
				if(txtkontakkategori.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f, "kkategori = '"+txtkontakkategori.text+"'");
				}
				if(txtkontak.text.length > 0 && txtkontak2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode Between "'+txtkontak.text.split('"').join('\\"')+'" and "'+txtkontak2.text.split('"').join('\\"')+'"');
				}else if(txtkontak.text.length > 0 && txtkontak2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode >= "'+txtkontak.text.split('"').join('\\"')+'"');
				}else if(txtkontak.text.length <= 0 && txtkontak2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode <= "'+txtkontak2.text.split('"').join('\\"')+'"');
				}
				for(i=0; i<dg.dataProviderLength; i++){
					if(dg.dataProvider[i].chk == 1){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode <>"'+dg.dataProvider.getItemAt(i).kodekontak.split('"').join('\\"')+'"'); 
					}
				}
				return f;
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(12,25,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case 'chk':
						break;
					case 'poinmasuk':
					case 'poinkeluar':
						var dgrid:Object;
						dgrid = dg.dataProvider[dg.selectedCell.rowIndex];
						dgrid.poinbaru = Number(dgrid.poinlama) + Number(dgrid.poinmasuk) - Number(dgrid.poinkeluar)
						break;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'noakun':
						paket = 'CdM1_Coa';
						wsfilter = 'cgd ="D" AND caktif = 1 AND ctipe = 1 AND cnomor = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).noakun+'"';
						csfilter = 'cgd ="D" AND caktif = 1 AND ctipe = 1';
						sort = 'cnomor asc';
						break;
					case 'bank':
						paket = 'CdM1_Bank';
						wsfilter = 'baktif=1 AND bkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).bank+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber="CPA"';
						sort = 'tndcatatan asc';
						break;
					case 'txtkontakkategori':
						paket = 'CdM1_Contact_Category';
						wsfilter = 'cckode = "'+txtkontakkategori.text+'"';
						csfilter = '';
						sort = 'cckode asc';
						break
					case 'txtkontak':
						paket = 'CdM1_Contact';
						var kkategori:String = ""
						if(txtkontakkategori.text.length > 0){
							kkategori = ' and kkategori = "'+txtkontakkategori.text+'"'
						}
						wsfilter = 'kaktif=1 AND kkode = "'+txtkontak.text+'"'+kkategori;
						csfilter = 'kaktif=1'+kkategori;
						sort = 'kkode asc';
						break; 
					case 'txtkontak2':
						paket = 'CdM1_Contact';
						var kkategori2:String = ""
						if(txtkontakkategori.text.length > 0){
							kkategori2 = ' and kkategori = "'+txtkontakkategori.text+'"'
						}
						wsfilter = 'kaktif=1 AND kkode = "'+txtkontak2.text+'"'+kkategori2;
						csfilter = 'kaktif=1'+kkategori2;
						sort = 'kkode asc';
						break; 
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "CPA"';
						sort = 'tnkode asc';
						break;
					}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'txtkontakkategori':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkontakkategori.text = ws.cckode;
							lblkontakkategori.text = ws.ccnama
							break
						case 'txtkontak':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkontak.text = ws.kkode;
							txtkontak2.text = ws.kkode;
							break; 
						case 'txtkontak2':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkontak2.text = ws.kkode;
							break; 
						case 'txtkontakperson':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkontakperson.text = ws.kakodekontak;
							break;
						case 'txtcatatan':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcatatan.text = ws.tncatatan;
							break;
						case 'tampil':
							imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							imglast.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							
							f_focusOnMe();
							mb.menuBarItems[4].enabled = true;
							mb.menuBarItems[5].enabled = true;
							mb.menuBarItems[6].enabled = true;
							mb.menuBarItems[7].visible = false;
							isUpdate = true;
							txtkontakkategori.text = "C";
							FlexGlobals.topLevelApplication.vpVarCurrent = txtkontakkategori.text;
							lblkontakkategori.text = "Customer";
							with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)){
								txturaian.text = cpauraian;
								txtkontakperson.text = cpakontakperson;
								txtcatatan.text = cpacatatan;
								dttgl.text = cpatgl;
								txtnotransaksi.text= cpanotransaksi;
								if (cpaautonotransaksi ==1){
									chkauto.selected = true; txtnotransaksi.enabled=false;
								}else if (cpaautonotransaksi==0){
									chkauto.selected = false; txtnotransaksi.enabled=true;
								}
								if(cpastatus != 7){
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									if(cpastatus ==0){
										cmbprogress.selectedIndex=0;
										mb.menuBarItems[0].enabled=true;
									}else if(cpastatus ==2){
										cmbprogress.selectedIndex=1;
										mb.menuBarItems[0].enabled=false;
									}
								}else{
									cmbprogress.dataProvider = new ArrayCollection([{l:'Close', v:7}]);
									cmbprogress.selectedIndex=0;
									mb.menuBarItems[0].enabled=false;
									cmbprogress.enabled = false;
								}
								o.cpaid = cpaid; o.cpacabang = cpacabang; o.cpalokasi = cpalokasi; o.cpasumber = cpasumber; o.cpaautonotransaksi = cpaautonotransaksi; o.cpanotransaksi = cpanotransaksi; o.cpatgl = cpatgl;
								o.cpakodepa = cpakodepa; o.cpakontak = cpakontak; o.cpakontakperson = cpakontakperson; o.cpauraian = cpauraian; o.cpacatatan = cpacatatan; o.cpastatus = cpastatus; o.cpastatussebelumnya = cpastatussebelumnya;
								o.cpajmlrevisi = cpajmlrevisi; o.cpacetakanke = cpacetakanke; o.cpaisclose = cpaisclose; o.cpainputuser = cpainputuser; o.cpainputtgl = cpainputtgl; o.cpamodifikasiuser = cpamodifikasiuser; o.cpamodifikasitgl = cpamodifikasitgl;
								o.cpaposting = cpaposting; o.cpapostingtgl = cpapostingtgl; o.cpacustomtext1 = cpacustomtext1; o.cpacustomtext2 = cpacustomtext2; o.cpacustomtext3 = cpacustomtext3; o.cpacustomtext4 = cpacustomtext4; o.cpacustomtext5 = cpacustomtext5;
								o.cpacustomint1 = cpacustomint1; o.cpacustomint2 = cpacustomint2; o.cpacustomint3 = cpacustomint3; o.cpacustomdbl1 = cpacustomdbl1; o.cpacustomdbl2 = cpacustomdbl2; o.cpacustomdbl3 = cpacustomdbl3; o.cpacustomdate1 = cpacustomdate1;
								o.cpacustomdate2 = cpacustomdate2; o.cpacustomdate3 = cpacustomdate3; o.cpacabangnama = cpacabangnama; o.cpalokasinama = cpalokasinama; o.cpakontakkode = cpakontakkode; o.cpakontaknama = cpakontaknama; o.cpastatusnama = cpastatusnama;
								o.cpastatussebelumnyanama = cpastatussebelumnyanama; o.cpainputusernama = cpainputusernama; o.cpamodifikasiusernama = cpamodifikasiusernama;
							}
							dg.dataProvider.removeAll();
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								ws=FlexGlobals.topLevelApplication.wsArrDetail.getItemAt(i)
								dg.dataProvider.addItem({chk:1,
									no:i+1,
									idcpadetail:ws.idcpadetail,
									idcpa: ws.idcpa,
									kontak: ws.kontak,
									kodekontak: ws.kontakkode,
									namakontak:ws.kontaknama,
									poinlama:ws.poinlama,
									poinmasuk:ws.poinmasuk,
									poinkeluar:ws.poinkeluar,
									poinbaru: ws.poinbaru,
									catatan:ws.catatan,
									urutan:0, 
									isclose:ws.isclose, 
									customtext1:ws.customtext1, 
									customtext2:ws.customtext2, 
									customtext3:ws.customtext3, 
									customdbl1:ws.customdbl1, 
									customdbl2:ws.customdbl2, 
									customdbl3:ws.customdbl3, 
									customdate1:ws.customdate1, 
									customdate2:ws.customdate2, 
									customdate3:ws.customdate3});
							}
							break;
						case 'tampilHistory':
							f_focusOnMe();
							mb.menuBarItems[0].visible = false;
							mb.menuBarItems[1].visible = false;
							mb.menuBarItems[2].visible = false;
							mb.menuBarItems[3].visible = false;
							mb.menuBarItems[4].visible = false;
							mb.menuBarItems[5].visible = false;
							mb.menuBarItems[6].visible = false;
							isUpdate = true;
							with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)){
								txturaian.text = cpauraian;
								txtcatatan.text = cpacatatan;
								dttgl.text = cpatgl;
								txtnotransaksi.text= rgnotransaksi;
								if (rgautonotransaksi ==1){
									chkauto.selected = true; txtnotransaksi.enabled=false;
								}else if (rgautonotransaksi==0){chkauto.selected = false; txtnotransaksi.enabled=true;}
								chkposting.selected = Boolean(rgposting)
								txtmatauang.text=rgmatauang;
								o.txtkurs = rgkurs;
								txtkurs.text=FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
								if (rgmatauang != UFungsional){
									txtkurs.enabled=true;
								}else{
									txtkurs.enabled=false;
								}
								if(rgstatus!=7){
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									if(rgstatus ==0){
										cmbprogress.selectedIndex=0;
										mb.menuBarItems[0].enabled=true;
									}else if(rgstatus ==2){
										cmbprogress.selectedIndex=1;
										mb.menuBarItems[0].enabled=false;
									}
								}
								else {
									cmbprogress.dataProvider = new ArrayCollection([{l:'Close', v:7}]);
									cmbprogress.selectedIndex=0;
									mb.menuBarItems[0].enabled=false;
									cmbprogress.enabled = false;
								}
								o.rgid=rgid; o.rgcabang=rgcabang; o.rglokasi=rglokasi; 
								o.rgsumber=rgsumber;o.rgkodepa=rgkodepa; o.rgkontak=rgkontak; o.rgkontakperson=rgkontakperson; 
								o.rgjumlah=rgjumlah; o.rgjumlahvalas=rgjumlahvalas; o.rgstatusrgc=rgstatusrgc; o.rgstatussebelumnya=rgstatussebelumnya; o.rgjmlrevisi=rgjmlrevisi; o.rgcetakanke=rgcetakanke; 
								o.rgisclose=rgisclose; o.rginputuser=rginputuser; o.rginputtgl=rginputtgl; 
								o.rgmodifikasiuser=FlexGlobals.topLevelApplication.userid; o.rgmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal; o.rgcustomtext1=rgcustomtext1; 
								o.rgcustomtext2=rgcustomtext2; o.rgcustomtext3=rgcustomtext3; o.rgcustomtext4=rgcustomtext4;o. rgcustomtext5=rgcustomtext5; 
								o.rgcustomint1=rgcustomint1; o.rgcustomint2=rgcustomint2; o.rgcustomint3=rgcustomint3; 
								o.rgcustomdbl1=rgcustomdbl1; o.rgcustomdbl2=rgcustomdbl2; o.rgcustomdbl3=rgcustomdbl3; o.rgcustomdate1=FlexGlobals.topLevelApplication.m.DateFirst; 
								o.rgcustomdate2= FlexGlobals.topLevelApplication.m.DateFirst; o.rgcustomdate3=FlexGlobals.topLevelApplication.m.DateFirst;
							}
							dg.dataProvider.removeAll();
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								ws=FlexGlobals.topLevelApplication.wsArrDetail.getItemAt(i)
								dg.dataProvider.addItem({chk:1,
									no:i+1,
									idcpadetail:ws.idcpadetail,
									idcpa: ws.idcpa,
									kontak: ws.kontak,
									kodekontak: ws.kontakkode,
									namakontak:ws.kontaknama,
									poinlama:ws.poinlama,
									poinmasuk:ws.poinbaru,
									poinkeluar:ws.poinkeluar,
									poinbaru: ws.poinbaru, // poinlama + poinmasuk - poinkeluar
									catatan:ws.catatan,
									urutan:0, isclose:ws.isclose, customtext1:ws.customtext1, 
									customtext2:ws.customtext2, customtext3:ws.customtext3, customdbl1:ws.customdbl1, customdbl2:ws.customdbl2, customdbl3:ws.customdbl3, 
									customdate1:ws.customdate1, 
									customdate2:ws.customdate2, 
									customdate3:ws.customdate3});
							}
							break;
						
						case 'tampilKontak':
							imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							imglast.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							
							for(i = dg.dataProviderLength - 1; i>=0; i--){
								if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
									dg.dataProvider.removeItemAt(i);
								}
							}
							ws = FlexGlobals.topLevelApplication.wsArrUtama;
							for(i=0;i<ws.length;i++){
								dg.dataProvider.addItem({chk:0,
									no:dg.dataProviderLength+1,
									idcpadetail:0,
									idcpa:0,
									kontak:ws.getItemAt(i).kid,
									kodekontak:ws.getItemAt(i).kkode,
									namakontak:ws.getItemAt(i).knama,
									poinlama:ws.getItemAt(i).cppoin,
									poinmasuk:0,
									poinkeluar:0,
									poinbaru: ws.getItemAt(i).kkomisipenjualan, // poinlama + poinmasuk - poinkeluar
									catatan:"",
									urutan:0, isclose:0, customtext1:'', 
									customtext2:'', customtext3:'', customdbl1:0, customdbl2:0, customdbl3:0, 
									customdate1:FlexGlobals.topLevelApplication.m.DateFirst, 
									customdate2:FlexGlobals.topLevelApplication.m.DateFirst, 
									customdate3:FlexGlobals.topLevelApplication.m.DateFirst}); 
							}
							
							break;
						case 'simpan':
							FlexGlobals.topLevelApplication.FormFilter='';
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_alertCetak(12,25,'CPA', FlexGlobals.topLevelApplication.wsIdtransaksi, FlexGlobals.topLevelApplication.wsErrmessage, o.tanggal+" s.d "+o.tanggal);
							
							break;
						case 'print':
							FlexGlobals.topLevelApplication.F_openReportDefault(12,25,"cpaid = "+FlexGlobals.topLevelApplication.wsIdtransaksi+"");
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'noakun':
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).noakun = '';
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).namaakun = '';
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							case 'bank':
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = '';
								parentApplication.F_dgRefresh(dg);
								break;
							case 'catatan':
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).catatan = '';
								parentApplication.F_dgRefresh(dg);
								break;
							case 'tampilkontak':
								for(i=dg.dataProviderLength-1;i>=0;i--){
									if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
										dg.dataProvider.removeItemAt(i);
									}
								}
								break;
							case 'tampil':
							case 'simpan':
								Alert.show(FlexGlobals.topLevelApplication.l(FlexGlobals.topLevelApplication.wsErrmessage), FlexGlobals.topLevelApplication.l('Informasi'));
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'tampilGiro':
						for(i=dg.dataProviderLength-1;i>=0;i--){
							if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
								dg.dataProvider.removeItemAt(i);
							}
						}
						break;
					case 'txtkontakkategori':parentApplication.F_KosongkanText([txtkontakkategori, lblkontakkategori]);break;
					case 'txtkontak':parentApplication.F_KosongkanText([txtkontak]);break;
					case 'txtkontak2':parentApplication.F_KosongkanText([txtkontak2]);break;
				}
			}
			
			public function centang():void{
				ac2.removeAll();
				for (var i:int = 0; i < dg.dataProviderLength; i++) 
					if(dg.dataProvider[i].kodekontak.length > 0){
						if(dg.dataProvider.getItemAt(i).chk==1){
							with(dg.dataProvider.getItemAt(i))
								ac2.addItem({No:i+1, idcpadetail:idcpadetail, idcpa:idcpa, kontak:kontak, poinlama:poinlama, poinmasuk:poinmasuk, poinkeluar:poinkeluar, poinbaru:poinbaru, 
									catatan:catatan, urutan:urutan, isclose:isclose, customtext1:customtext1, customtext2:customtext2, customtext3:customtext3, customdbl1:customdbl1, 
									customdbl2:customdbl2, customdbl3:customdbl3, customdate1:customdate1, customdate2:customdate2, customdate3:customdate3});
						}
					}
			}
			
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, tgl:String;
				centang();
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
						// Set Utama
						with(o){
							a = [cpaid, cpacabang, cpalokasi, cpasumber, int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttgl.text), 
								cpakodepa, cpakontak, txtkontakperson.text, txturaian.text, txtcatatan.text, cmbprogress.selectedItem.v, cpastatussebelumnya, 
								cpajmlrevisi, cpacetakanke, cpaisclose, cpainputuser, cpainputtgl, cpamodifikasiuser, cpamodifikasitgl, 
								cpaposting, cpapostingtgl, cpacustomtext1, cpacustomtext2, cpacustomtext3, cpacustomtext4, cpacustomtext5, 
								cpacustomint1, cpacustomint2, cpacustomint3, cpacustomdbl1, cpacustomdbl2, cpacustomdbl3, parentApplication.F_tglFormatDB(cpacustomdate1), 
								parentApplication.F_tglFormatDB(cpacustomdate2), parentApplication.F_tglFormatDB(cpacustomdate3)];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
						
						if(ac2.length > 0){
							for(i=0;i<ac2.length;i++)
								with(ac2.getItemAt(i)){
									a = [idcpadetail, idcpa, kontak, poinlama, poinmasuk, poinkeluar, poinbaru, 
										catatan, i+1, isclose, customtext1, customtext2, customtext3, customdbl1, 
										customdbl2, customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detail =  FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+ FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
						}
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_CpaSimpan", parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(txtnotransaksi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(ac2.length <= 0){
						FlexGlobals.topLevelApplication.msgAlert(dg,'Data')
					}else{
						if(dg.dataProvider.getItemAt(0).kodekontak == '' || dg.dataProvider.getItemAt(0).kodekontak == null){
							FlexGlobals.topLevelApplication.msgAlert(dg,'Data')
						}
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
				}
			}
			
