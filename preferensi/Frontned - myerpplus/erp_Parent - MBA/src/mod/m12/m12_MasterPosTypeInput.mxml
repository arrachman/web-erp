<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBoxHeader':
						for (var i:int =0; i<dgclass.dataProviderLength; i++){
							dgclass.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case 'checkBox':
						dgclass.dataProvider.getItemAt(dgclass.selectedCell.rowIndex).chk = data;
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgclass);
			}
			private function f_persiapan():void{
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_Class_ProductCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				FlexGlobals.topLevelApplication.F_RegGrid(12, 52, [dgclass], "transaksi");
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ptkode;
					FlexGlobals.topLevelApplication.F_wsGetDataById("Tampil", "M12_Pos_TypeGetdataById", txtkode.text, 0, 0, "","", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
						FlexGlobals.topLevelApplication.F_wsGetDataById("TampilHistory", "M12_Pos_TypeGetdataById", parentApplication.m.ArrFilter[1], 0, 0, "","", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan]);
				chkaktif.selected = true;
				o.ptcustomtext1=""; o.ptcustomtext2=""; o.ptcustomtext3=""; o.ptcustomtext4=""; o.ptcustomtext5=""; o.ptcustomint1=0; 
				o.ptcustomint2=0; o.ptcustomint3=0; o.ptcustomdbl1=0; o.ptcustomdbl2=0; o.ptcustomdbl3=0; o.ptcustomdate1=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.ptcustomdate2=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.ptcustomdate3=FlexGlobals.topLevelApplication.DefaultTanggal;
				FlexGlobals.topLevelApplication.F_wsSearch("ClassProduct", "CdM1_Class_Product", 0, 0, "cpaktif = 1", "cpkode asc");
				
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String, detail:String = "";
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt,
						o.ptcustomtext1, o.ptcustomtext2, o.ptcustomtext3, o.ptcustomtext4, o.ptcustomtext5, o.ptcustomint1, 
						o.ptcustomint2, o.ptcustomint3, o.ptcustomdbl1, o.ptcustomdbl2, o.ptcustomdbl3, 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ptcustomdate1), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ptcustomdate2), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ptcustomdate3)];
					utama = parentApplication.F_splitArrayToString(arr);
					
					for(var a:int = 0; a<dgclass.dataProviderLength; a++){
						with(dgclass.dataProvider[a]){
							if(chk == 1){
								arr = [txtkode.text, kelasproduk];
								if(detail == ""){detail = parentApplication.F_splitArrayToString(arr);}
								else{detail += "▲"+ parentApplication.F_splitArrayToString(arr);}
							}
						}
					}
					parentApplication.F_MasterSimpan(baru, 'M12_Pos_TypeSimpan', utama+"△"+detail, 'ptkode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
				if(FlexGlobals.topLevelApplication.subject == "ClassProduct"){
					if(FlexGlobals.topLevelApplication.wsSuccess == true){
						dgclass.dataProvider.removeAll();
						for(var i:int = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
							dgclass.dataProvider.addItem({chk:0, 
								kelasproduk:FlexGlobals.topLevelApplication.wsArrUtama[i].cpkode, 
								kelasproduknama:FlexGlobals.topLevelApplication.wsArrUtama[i].cpnama})
						}
					}else{
						Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, "Informasi");
					}
				}
				
				if(FlexGlobals.topLevelApplication.subject == "Tampil"){
					if(FlexGlobals.topLevelApplication.wsSuccess == true){
						with(FlexGlobals.topLevelApplication.wsArrUtama[0]){
							txtnama.text = ptnama;
							txtcatatan.text = ptcatatan;
							o.ptcustomtext1=ptcustomtext1; 
							o.ptcustomtext2=ptcustomtext2; 
							o.ptcustomtext3=ptcustomtext3;
							o.ptcustomtext4=ptcustomtext4; 
							o.ptcustomtext5=ptcustomtext5; 
							o.ptcustomint1=ptcustomint1; 
							o.ptcustomint2=ptcustomint2; 
							o.ptcustomint3=ptcustomint3; 
							o.ptcustomdbl1=ptcustomdbl1; 
							o.ptcustomdbl2=ptcustomdbl2; 
							o.ptcustomdbl3=ptcustomdbl3; 
							o.ptcustomdate1=ptcustomdate1; 
							o.ptcustomdate2=ptcustomdate2; 
							o.ptcustomdate3=ptcustomdate3;
							vUserIdEdit = parentApplication.userid;
							if(ptaktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
						}
						dgclass.dataProvider = FlexGlobals.topLevelApplication.wsArrDetail;
						
						for(var m:int = 0; m<dgclass.dataProviderLength; m++){
							if(dgclass.dataProvider[m].tipepos != ""){
								dgclass.dataProvider[m].chk = 1;
							}else{
								dgclass.dataProvider[m].chk = 0;
							}
						}
						FlexGlobals.topLevelApplication.F_dgRefresh(dgclass);
					}else{
						Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, "Informasi");
					}
				}
				
				if(FlexGlobals.topLevelApplication.subject == "TampilHistory"){
					if(FlexGlobals.topLevelApplication.wsSuccess == true){
						with(FlexGlobals.topLevelApplication.wsArrUtama[0]){
							txtnama.text = ptnama;
							txtcatatan.text = ptcatatan;
							o.ptcustomtext1=ptcustomtext1; 
							o.ptcustomtext2=ptcustomtext2; 
							o.ptcustomtext3=ptcustomtext3;
							o.ptcustomtext4=ptcustomtext4; 
							o.ptcustomtext5=ptcustomtext5; 
							o.ptcustomint1=ptcustomint1; 
							o.ptcustomint2=ptcustomint2; 
							o.ptcustomint3=ptcustomint3; 
							o.ptcustomdbl1=ptcustomdbl1; 
							o.ptcustomdbl2=ptcustomdbl2; 
							o.ptcustomdbl3=ptcustomdbl3; 
							o.ptcustomdate1=ptcustomdate1; 
							o.ptcustomdate2=ptcustomdate2; 
							o.ptcustomdate3=ptcustomdate3;
							vUserIdEdit = parentApplication.userid;
							if(ptaktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
						}
						dgclass.dataProvider = FlexGlobals.topLevelApplication.wsArrDetail;
						
						for(var n:int = 0; n<dgclass.dataProviderLength; n++){
							if(dgclass.dataProvider[n].tipepos != ""){
								dgclass.dataProvider[n].chk = 1;
							}else{
								dgclass.dataProvider[n].chk = 0;
							}
						}
						FlexGlobals.topLevelApplication.F_dgRefresh(dgclass);
					}else{
						Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, "Informasi");
					}
				}
				
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<mx:TabNavigator left="10" right="10" bottom="10" top="30" id="tab">
		<s:NavigatorContent width="100%" height="100%" label="Utama">
			<s:Label id="tkode" left="10" top="9" text="Kode"/>
			<s:Label id="tnama" left="10" top="32" text="Nama"/>
			<s:Label id="tcatatan" left="10" top="53" text="Catatan"/>
			<s:TextInput id="txtkode" y="4" left="70" width="270"/>
			<s:TextInput id="txtnama" left="70" right="10" top="25" maxChars="50" />
			<s:TextArea id="txtcatatan" left="70" right="10" top="46" bottom="43" maxChars="250"/>
			
			<s:CheckBox id="chkaktif" x="344" y="5" label="Aktif" selected="true"/>
		</s:NavigatorContent>
		<s:NavigatorContent width="100%" height="100%" label="Kelas Produk">
			<s:DataGrid left="0" right="0" bottom="0" top="0" id="dgclass">
				
			</s:DataGrid>
		</s:NavigatorContent>
	</mx:TabNavigator>
</s:Module>
