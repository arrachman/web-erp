			[Bindable] public var u:ArrayCollection;
			public var dg_tambah_ac:ArrayCollection = new ArrayCollection;
			[Bindable] public var arr:ArrayCollection = new ArrayCollection;
			public var validasi:Boolean, pesanAlert:String, cb:CheckBox, t:TitleWindow, p:Object, tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal;
			public var vID:String = '', o:Object = {}, n:Object = {}, obj:Object = {};
			protected var arrMenuBar:ArrayCollection;
			
			public var strFilter:String = "";
			public var strSort:String = "bkode asc";
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
			// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				
			}
			
			// set fokus ketika pertama kali form diload ===================================
			public function f_focusOnMe():void
			{
				txtkategoripos.setFocus();
			}
			
			// set persiapan form ==========================================================
			protected function f_persiapan():void
			{
				p = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child;
				
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				parentApplication.F_txtpencarian([txtkategoripos]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkategoripos]);
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Batal", icon:"tbreset", enabled:"true"}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(12,13,jenissimpan)==true){
						f_simpan();
					}
				}
				
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				
				
			
				f_kondisiAwal();
			}
			
			public function f_validasi():void
			{
				
			}
			
			protected function f_kondisiAwal():void
			{
				o.txtfilterperubahannilai = 0;
				o.txtfiltersetnilai = 0;
				o.txtkurs = 0;
				isUpdate = false;
				
				o.txtkurs = parentApplication.getSetting(0, 'accounting', 'Kurs');
				mb.menuBarItems[0].enabled = true;
				FlexGlobals.topLevelApplication.F_KosongkanText([txtkategoripos]);
				f_focusOnMe();
				
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(12,13,jenissimpan)==true){
								f_simpan();
							}
						}
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						break;
					
				}
			}	
			
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				
				switch(target){
					case 'txtkategoripos':
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'" AND (pctipepos = "'+  FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.tipepos +'" AND pckode <>  "'+  p.txtkategoripos.text +'")';
						csfilter = 'pcaktif=1 AND (pctipepos = "'+  FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.tipepos +'" AND pckode <>  "'+  p.txtkategoripos.text +'")';
						sort = 'pckode asc';
						break;
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtkategoripos':
							obj = parentApplication.wsArrUtama.getItemAt(0);
							txtkategoripos.text = obj.pckode;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
							lblkategoripos.text = obj.pcnama
							FlexGlobals.topLevelApplication.F_wsSearch("getdatabarang", "M12_Pos_ItemSearch",1,13,"pikategori = '"+txtkategoripos.text+"'","bkode asc", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'))
							break;
						
						case 'simpan':
							FlexGlobals.topLevelApplication.FormFilter = '';
							//							f_kondisiAwal();
							p.dg1.setFocus();
							p.imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							p.imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							p.imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							p.imglast.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							p.txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							p.dg1.dataProvider.removeAll()
							for(i = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama[i]){
									p.dg1.dataProvider.addItem({chk:1, pikategori: p.txtkategoripos.text, piidbarang:piidbarang, 
										pistokminimal:pistokminimal, pistokmaksimal:pistokmaksimal, pistokreorder:pistokreorder, 
										pistokminorder: pistokminorder, pihargajual1:pihargajual1, 
										pihargajual2:pihargajual2, pihargajual3:pihargajual3, pihargajual4:pihargajual4, 
										pihargajual5:pihargajual5, pidiskonjual1:pidiskonjual1, pidiskonjual2:pidiskonjual2, pidiskonjual3:pidiskonjual3, 
										pidiskonjual4:pidiskonjual4, 
										pidiskonjual5:pidiskonjual5, picustomtext1:"", picustomtext2:"", picustomtext3:"", picustomtext4:"", picustomtext5:"", 
										picustomint1:0, 
										picustomint2:0, picustomint3:0, picustomdbl1:0, picustomdbl2:0, picustomdbl3:0, 
										picustomdate1:parentApplication.m.DateFirst, picustomdate2:parentApplication.m.DateFirst, 
										picustomdate3:parentApplication.m.DateFirst, piaksi:1, kodebarang:bkode, namabarang:bnama, satuan:bsatuan,
										pistokminimallama:pistokminimal, pistokmaksimallama:pistokmaksimal, pistokreorderlama:pistokreorder, pihargajual1lama:pihargajual1,
										pihargajual2lama:pihargajual2, pihargajual3lama:pihargajual3, pihargajual4lama:pihargajual4, pihargajual5lama:pihargajual5,
										pidiskon1juallama : pidiskonjual1, pidiskonjual2lama:pidiskonjual2, pidiskonjual3lama:pidiskonjual3, pidiskonjual4lama:pidiskonjual4,
										pidiskonjual5lama:pidiskonjual5, pistatusubah :0, pistatusgetdata:1,
										pistokminorderlama: pistokminorder});
								}
							}
							FlexGlobals.topLevelApplication.closeFormPopUp(1);
							//							Alert.show("Data berhasil disimpan", "Informasi")
							
							Alert.show(FlexGlobals.topLevelApplication.l('Data berhasil disimpan, silahkan login ulang !'), FlexGlobals.topLevelApplication.l('Informasi'), 0, null, function(e:Object):void{		
								if(e.detail == Alert.OK){
									FlexGlobals.topLevelApplication.f_getReloginForm();
								}
							});
							break;
						case 'hapus':
							FlexGlobals.topLevelApplication.FormFilter = '';
							f_kondisiAwal();
							Alert.show("Data berhasil dihapus", "Informasi")
							break;
						
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
							case 'simpan':
								Alert.show(parentApplication.wsErrmessage, parentApplication.l('Informasi'));
								break;
							case 'hapus':
								Alert.show(parentApplication.wsErrmessage, parentApplication.l('Informasi'));
								break;
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					
					case "txtkategoripos":
						txtkategoripos.text = "";
						lblkategoripos.text = "";
						break
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String="", valsimpan:Boolean = false;
				parentApplication.vpFocusEvent = true;
				
				if(mb.menuBarItems[0].enabled == true){
					if(txtkategoripos.text.length <= 0){
						Alert.show("Kategori POS lain harus dipilih terlebih dahulu");
						validasi = false;
					}else{
						validasi = true;
					}
					if(validasi == true){
						// Set Detail
						valsimpan = true;
						a = [p.txtkategoripos.text, txtkategoripos.text];
						if(detail == "" )detail = parentApplication.F_splitArrayToString(a);
						else detail += "▲"+parentApplication.F_splitArrayToString(a);
						FlexGlobals.topLevelApplication.F_wsSimpan('simpan', "M12_Pos_ItemSimpanLokasiLain", parentApplication.userid, isUpdate, detail, "", 1, 13, p.f_filterdata(), "bkode asc");
					}
				}
				
				function validasiForm():void
				{
					
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
			
			public function f_hitungTotal():void
			{
			}
			
			
			
