			// SET KONDISI AWAL =================================================
			public var data:String, ar:Array, p:Object;
			public function f_kondisiAwal():void
			{
				data = parentApplication.m.POS_;
				
				if(data.length > 0)
				{
					ar = data.split(parentApplication.sptField);
					u = new ArrayCollection([{
						phcomputermac:ar[0], phcomputerip:ar[1], phprinter:ar[2], phprinterport:ar[3], phidreport:ar[4], phcetak:ar[5], phcetakbarang:ar[6], 
						phfeed:ar[7], phcashdrawer:ar[8], phcashdrawerprinter:ar[9], phcashdrawerport:ar[10], phpolenama:ar[11], phpoleport:ar[12], phpoledisplay:ar[13], 
						phpolebaudrate:ar[14], phpoleparity:ar[15], phpoledatabit:ar[16], phpolestopbit:ar[17], phescheader:ar[18], phescbody:ar[19], phescfooter:ar[20], 
						phesccashdrawer:ar[21], phcustomtext1:ar[22], phcustomtext2:ar[23], phcustomtext3:ar[24], phcustomtext4:ar[25], phcustomtext5:ar[26], phcustomint1:ar[27], 
						phcustomint2:ar[28], phcustomint3:ar[29], phcustomdbl1:ar[30], phcustomdbl2:ar[31], phcustomdbl3:ar[32], phcustomdate1:ar[33], phcustomdate2:ar[34], 
						phcustomdate3:ar[35], phuserid:ar[36]
					}]);
					
					p = u[0];
					
					// Connect to
					txtiphardware.text = p.phcomputerip;
					txtport.text = p.phprinterport;
					
					// Printer
					cmbprinter.dataProvider = new ArrayCollection([{l:p.phprinter}]);
					cmbprinter.selectedIndex = 0;
					cmbjenisstruk.selectedIndex = int(p.phidreport)-1;
					txtfeed.text = p.phfeed;
					
					// Cash Drawer
					
					// Pole Display
					
					// ESC Code
				}
				else
				{
					
					
					u = new ArrayCollection([{
						phcomputermac:"NULL", phcomputerip:"127.0.0.1", phprinter:"Printer 1", phprinterport:8484, phidreport:1, 
						phcetak:1, phcetakbarang:0, phfeed:0, phcashdrawer:1, phcashdrawerprinter:cmbprinter.textInput.text, 
						phcashdrawerport:cmbcashdrawer.textInput.text, phpolenama:cmbcashdrawer.textInput.text, phpoleport:cmbport2.textInput.text, phpoledisplay:cmbdisplay.selectedItem.v, phpolebaudrate:txtbaudrate.text, 
						phpoleparity:cmbparity.selectedItem.v, phpoledatabit:txtdatabit.text, phpolestopbit:txtstopbit.text, phescheader:txtheader.text, phescbody:txtbody.text, 
						phescfooter:txtfooter.text, phesccashdrawer:txtcashdrawer.text, phcustomtext1:'', phcustomtext2:'', phcustomtext3:'', 
						phcustomtext4:'', phcustomtext5:'', phcustomint1:0, phcustomint2:0, phcustomint3:0, 
						phcustomdbl1:0, phcustomdbl2:0, phcustomdbl3:0, phcustomdate1:parentApplication.m.DateFirst, phcustomdate2:parentApplication.m.DateFirst, 
						phcustomdate3:parentApplication.m.DateFirst, phuserid:parentApplication.userid
					}]);
					
					p = u[0];
					
					// Connect to
					txtiphardware.text = p.phcomputerip;
					txtport.text = p.phprinterport;
					
					// Printer
					cmbprinter.dataProvider = new ArrayCollection([{l:p.phprinter}]);
					cmbjenisstruk.selectedIndex = int(p.phidreport)-1;
					txtfeed.text = p.phfeed;
					
					// Cash Drawer
					
					// Pole Display
					
					// ESC Code
				}
				
				
