			// SET SHOUTCUT KEYBOARD ================================================
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							f_simpan();
						}
						break;
				}
			}
			// END OF SET SHOUTCUT KEYBOARD ==========================================
			
			
			
			
			// SET KONDISI FILTER UNTUK PENCARIAN ====================================
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					/*case 'txtprovinsi':
					paket = 'CdM1_Province';
					csfilter = 'paktif = 1';
					wsfilter = 'paktif = 1 and pkode = "'+txtprovinsi.text.split('"').join('\\"')+'"';
					sort = 'pkode asc';
					break;*/
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			// END OF SET KONDISI FILTER UNTUK PENCARIAN =============================
			
			
			
			// SET HASIL DARI WEB SERVICE ============================================
			public function f_wsHasil():void
			{
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'simpan':
							var i:int, d:String, a:Array, m:Object;
							m = parentApplication.m;
							with(u.getItemAt(0))
							{
								a = [phcomputermac, phcomputerip, phprinter, phprinterport, phidreport, phcetak, phcetakbarang, 
									phfeed, phcashdrawer, phcashdrawerprinter, phcashdrawerport, phpolenama, phpoleport, phpoledisplay, 
									phpolebaudrate, phpoleparity, phpoledatabit, phpolestopbit, phescheader, phescbody, phescfooter, 
									phesccashdrawer, phcustomtext1, phcustomtext2, phcustomtext3, phcustomtext4, phcustomtext5, phcustomint1, 
									phcustomint2, phcustomint3, phcustomdbl1, phcustomdbl2, phcustomdbl3, phcustomdate1, phcustomdate2, 
									phcustomdate3, phuserid];
							}
							m.wsData = parentApplication.F_splitArrayToString(a);
							m.POS_ = m.wsData;
							m.wsData = parentApplication.F_splitArrayToString(a);
							m.wsData = m.wsData.split(parentApplication.sptField);
							m.POS_computerIP = m.wsData[1];
							m.POS_port = m.wsData[3];
							m.POS_print = m.wsData[2];
							m.POS_struk = m.wsData[4];
							m.POS_jarak = m.wsData[7];
							 
							FlexGlobals.topLevelApplication.FormFilter = '';
							
							f_kondisiAwal();
//							FlexGlobals.topLevelApplication.F_alertCetak(12, 8, 'HD', parentApplication.wsIdtransaksi, parentApplication.wsErrmessage);
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'tampil':
							case 'tampilHistory':
							case 'simpan':
								Alert.show(parentApplication.wsErrmessage, parentApplication.l('Informasi'));
								break;
						}
				}
			}
			// END OF SET HASIL DARI WEB SERVICE ======================================
			
			
			
