			// FUNGSI UNTUK SIMPAN ==================================================
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String, tgl:String, p:Object;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled)
				{
					validasiForm();
					if(validasi)
					{
						
						p = u.getItemAt(0);
						
						// Connect to
						p.phcomputerip = txtiphardware.text;
						p.phprinterport = txtport.text;
						
						// Printer
						p.phprinter = cmbprinter.selectedItem.l;
						p.phidreport = cmbjenisstruk.selectedItem.v;
						p.phfeed = txtfeed.text;
						
						with(u.getItemAt(0))
						{
							a = [phcomputermac, phcomputerip, phprinter, phprinterport, phidreport, phcetak, phcetakbarang, 
								phfeed, phcashdrawer, phcashdrawerprinter, phcashdrawerport, phpolenama, phpoleport, phpoledisplay, 
								phpolebaudrate, phpoleparity, phpoledatabit, phpolestopbit, phescheader, phescbody, phescfooter, 
								phesccashdrawer, phcustomtext1, phcustomtext2, phcustomtext3, phcustomtext4, phcustomtext5, phcustomint1, 
								phcustomint2, phcustomint3, phcustomdbl1, phcustomdbl2, phcustomdbl3, phcustomdate1, phcustomdate2, 
								phcustomdate3, phuserid];
						}
						utama = parentApplication.F_splitArrayToString(a);
						parentApplication.F_wsSimpan('simpan', "M12_Pos_HardwareSimpan", parentApplication.userid, isUpdate, utama);
					}
				}
				
				function validasiForm():void
				{
					pesanAlert='';
					validasi = true;
					if(cmbcashdrawer.selectedIndex < 0 || cmbcashdrawer.textInput.text.length == 0)parentApplication.msgAlert(cmbcashdrawer,'Cash Drawer');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
			// END OF FUNGSI UNTUK SIMPAN ============================================
			
			
			
			//melakukan set pada textinput agar menjadi numberonly input tapi ketika fokusout / fokusin tidak terset 0
			public function f_TextInputNumberWithoutFormatMode(arTextInput:Array):void
			{
				FlexGlobals.topLevelApplication.f_refreshIDmodule(arTextInput[0]);
				for (var i:int=0; i<arTextInput.length; i++)
				{
					arTextInput[i].restrict = "0-9";
					arTextInput[i].setStyle("textAlign","right");
				}
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard(arTextInput);
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			
			protected function btntest_clickHandler(event:MouseEvent):void
			{
				if(btntest.enabled)
				{
					if(txtiphardware.text.length == 0)
					{
						txtiphardware.setFocus();
						Alert.show("Isi IP Address dulu", "Informasi");
						return;
					}
					
					if(txtport.text.length == 0)
					{
						txtport.setFocus();
						Alert.show("Isi IP Address dulu", "Informasi");
						return;
					}
					
					btntest.enabled = false;
					txtiphardware.editable = false;
					txtport.editable = false;
					MyHardware = new getInfoHardware(txtiphardware.text, int(txtport.text));
				}
			}
			
		]]>
