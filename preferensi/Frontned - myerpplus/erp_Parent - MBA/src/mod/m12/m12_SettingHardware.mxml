				cmbpoledisplay.dataProvider = new ArrayCollection([{l:'Tidak Pakai', v:0}, {l:'EMAX', v:1}, {l:'Logic Control', v:2}, {l:'Epson', v:3}, {l:'Posiflex', v:4}]);
				cmbport2.dataProvider = new ArrayCollection([{l:'COM1', v:0}, {l:'COM2', v:1}, {l:'COM3', v:2}, {l:'COM4', v:2}, {l:'COM5', v:2}, {l:'COM6', v:2}]);
				cmbdisplay.dataProvider = new ArrayCollection([{l:'1 Baris', v:0}, {l:'2 Baris', v:1}]);
				cmbparity.dataProvider = new ArrayCollection([{l:'n', v:0}, {l:'o', v:1}]);
				
				parentApplication.F_TranslateLabel([tprinterr, tcashdrawerr, tcashdrawer, tprinter, tport1, tpoledisplayy, tpoledisplay, tport2, tdisplay, tbaudrate, tparity, tdatabit, tstopbit, tesccode, theader, tbody, tfooter, tcashdrawerrr]);
				parentApplication.F_RequiredLabel([]);
				parentApplication.F_ComboBoxStandard([cmbjenisstruk, cmbcashdrawer, cmbprinter, cmbport1, cmbpoledisplay, cmbport2, cmbdisplay, cmbparity]);
				FlexGlobals.topLevelApplication.F_TextInputNumberOnlyMode([txtbaudrate, txtdatabit, txtstopbit]);
				f_TextInputNumberWithoutFormatMode([txtheader, txtbody, txtfooter, txtcashdrawer]);
				
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false)
					{
						jenissimpan = 1
					}
					else
					{
						jenissimpan = 2
					}
					
					if(FlexGlobals.topLevelApplication.apaBisaAkses(3, 3, jenissimpan))
					{
						f_simpan();
					}
				}
				
				cmbcashdrawer.addEventListener(Event.CHANGE, f_changecashdrawer);
				
				function f_changecashdrawer():void
				{
					if(cmbcashdrawer.selectedIndex == 0){
//						cmbprinter.enabled = false;
						cmbport1.enabled = false;
					}else if(cmbcashdrawer.selectedIndex == 1){
//						cmbprinter.enabled = false;
						cmbport1.enabled = true;
					}else if(cmbcashdrawer.selectedIndex == 2){
						cmbprinter.enabled = true;
						cmbport1.enabled = false;
					}
				}
				
				cmbpoledisplay.addEventListener(Event.CHANGE, f_changepoledisplay);
				function f_changepoledisplay():void
				{
					if(cmbpoledisplay.selectedIndex == 0){
						cmbport2.enabled = false;
						cmbdisplay.enabled = false;
						txtbaudrate.enabled = false;
						cmbparity.enabled = false;
						txtdatabit.enabled = false;
						txtstopbit.enabled = false;
					}else{
						cmbport2.enabled = true;
						cmbdisplay.enabled = true;
						txtbaudrate.enabled = true;
						cmbparity.enabled = true;
						txtdatabit.enabled = true;
						txtstopbit.enabled = true;
					}
				}
				
				f_kondisiAwal();
			}
