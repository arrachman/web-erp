			// SET KETIKA CREATION COMPLETE PADA DATA GRID ========================
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == "printer"){
							return arrListPrinter;
						}else if(dataField == "jenisstruk"){
							return arrListStruk;
						}else if(dataField == "cetakbarang"){
							return arrCetakBarang;
						}
						break;
				}
				return new ArrayCollection([]);
			}
			// END OF SET KETIKA CREATION COMPLETE PADA DATA GRID =================
			
			
			
			// SET KETIKA CHANGE PADA DATA GRID  ===================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'listPrinter':
						for (var i:int = 0; i < data.length; i++)
						{
							arrListPrinter.addItem({l:data[i], v:data[i]});
						}
						
						Alert.show(arrListPrinter.length+' '+arrCetakBarang);
						break;
					case 'listStruk':
						arrListStruk = new ArrayCollection;
						for (var j:int = 0; j<data.length; j++)
						{
							arrListStruk.addItem({l:data[j], v:data[j]});
						}
						break;
					case 'myMACaddress':
						MacAddress = data.toString();
						break;
					case 'getInfo':
						var arr:Array;
						btntest.enabled = true;
						txtiphardware.editable = true;
						txtport.editable = true;
						if(data.toString() == "notConnect")
						{
							Alert.show("Connection Failed: Can't connect to\nMyHardware on '"+txtiphardware.text+"' port '"+txtport.text+"'", "Informasi");
						}
						else
						{
							arr = data.toString().split("@p2@");
							cmbprinter.dataProvider.removeAll();
							for(i=0;i<arr.length;i++)
							{
								cmbprinter.dataProvider.addItem({l:arr[i], v:i});
							}
							cmbprinter.selectedIndex = 0;
						}
						break;
				}
			}
			// END OF SET KETIKA CHANGE PADA DATA GRID  =============================
			
			
			
