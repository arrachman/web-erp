<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()" initialize="p = parentApplication">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.MenuEvent;
			
			import spark.events.IndexChangeEvent;
			import spark.events.TextOperationEvent;
			
			public var a:Array = new Array;
			public var arr:Array, arrColumn:Array;
			public var p :Object;
			public var o:Object = {};
			public var i:int
			public var sumber:String
			
			// fokus ke no txtnotransaksi saat form pertama dibuka ======================================
			public function f_focusOnMe():void
			{
				txtnotransaksi1.setFocus();
			}
			
			// persiapan persiapan ======================================================================	
			public function f_persiapan():void
			{
				p=parentApplication;
				
				var vCMI:ContextMenuItem;
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnotransaksi, ttanggal, tcustomer,  tjenislaporan, tsalesman, tuser, tstatus]);
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.getReportItem(5, 10);			//(ambil report dari database)
				
				a = [12, 8, 10, 'Si', false];
				FlexGlobals.topLevelApplication.F_persiapanFormData(this);
				
				// Config Grid
				dg.dataProvider = new ArrayCollection();
				dg.selectionMode = "singleCell";
				dg.contextMenu = new ContextMenu;
				dg.contextMenu.hideBuiltInItems();
//				dg.contextMenu.addEventListener(ContextMenuEvent.MENU_SELECT, f_MENU_SELECT);
				vCMI = new ContextMenuItem(FlexGlobals.topLevelApplication.l('Cetak Transaksi ini'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_cetakDetail);
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(FlexGlobals.topLevelApplication.l('Transaksi Terkait'))
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_transaksiTerkait); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(FlexGlobals.topLevelApplication.l('Jurnal Voucher'))      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jurnalVocher); 
				dg.contextMenu.customItems.push(vCMI);
				vCMI = new ContextMenuItem(FlexGlobals.topLevelApplication.l('Jadikan Draft'))      
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jadikanDraft);  
				dg.contextMenu.customItems.push(vCMI);   
				vCMI = new ContextMenuItem(FlexGlobals.topLevelApplication.l('Jadikan Close / Unclose'))     
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_jadikanCloseUnclose);  
				dg.contextMenu.customItems.push(vCMI); 
				
				vCMI = new ContextMenuItem(FlexGlobals.topLevelApplication.l('History Transaksi'))     
				vCMI.addEventListener(ContextMenuEvent.MENU_ITEM_SELECT, f_history);  
				dg.contextMenu.customItems.push(vCMI); 
				
				var arrMenuBar:ArrayCollection = new ArrayCollection([
					{label:"Tampilkan", icon:"tbpreview"},
					{label:"Reset", icon:"tbreset"},
					{label:"Tambah", icon:"tbadd"},
					{label:"Cetak", icon:"tbprint"},
					{label:"Export", icon:"tbexport", children:[
						{label:"Ms.Excel", icon:"tbexcel", data:"1"},
						{label:"Html", icon:"tbhtml", data:"2"},
						{label:"Ms.Word", icon:"tbword", data:"3"},
						{label:"Text", icon:"tbtxt", data:"4"},
						{label:"Image", icon:"tbtif", data:"5"}]
					},
					{label:"Lain-lain", icon:"tbothers", children:[
						//			{label:"Bantuan", icon:"tbhelp"},
						{label:"Edit", icon:"tbedit"},
						{label:"Hapus", icon:"tbdelete"},
						{label:"Cetak Detail", icon:"tbprint"},
						{label:"Transaksi Terkait", icon:"tbrelated"},
						{label:"Jurnal Voucher", icon:"tbjurnal"},
						{label:"Jadikan Draft", icon:"tbdraft"},
						{label:"Jadikan Close/Unclose", icon:"tbclose_unclose"},
						{label:"Histori Transaksi", icon:"tbhistory"}]
					}, 
					{label:"Upload", icon:"tbupload"}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);

				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_tampilkan); // tampil
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_reset); // reset
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_tambah); // tambah
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_cetak); // cetak
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbItemClick); 
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_upload);
				if(FlexGlobals.topLevelApplication.getSetting(0, "company", "IsServer") == 0){
					mb.menuBarItems[6].visible = true;
					grpstausupload.visible = true;
				}else{
					mb.menuBarItems[6].visible = false;
					grpstausupload.visible = false;
				}
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_upload);
				function f_tampilkan():void
				{
					
					if(int(txtpaging.text) == 0)
						FlexGlobals.topLevelApplication.f_formDataTampil(1);
					else
						FlexGlobals.topLevelApplication.f_formDataTampil(int(txtpaging.text));
				}
				
				
				function f_hapus():void
				{
					
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 3) == true){
						sumber = a[3].toLowerCase();
						var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"status"];
						var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
						if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 3) == true)
							if(status == 0 || status == 5 || status == 6)
								Alert.show(FlexGlobals.topLevelApplication.l("Apakah Anda yakin akan menghapus No. Transaksi ini ?", 1), FlexGlobals.topLevelApplication.l("Informasi"), 3, null, function(e:Object):void{	
									if(e.detail == Alert.YES)
										FlexGlobals.topLevelApplication.F_wsDelete(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M'+a[0]+'_'+a[3]+'Delete', FlexGlobals.topLevelApplication.userid, id.toString(), int(txtpaging.text), 20, f_filterdata(), FlexGlobals.topLevelApplication.m.sort[FlexGlobals.topLevelApplication.module]);
								});
							else Alert.show(FlexGlobals.topLevelApplication.l('Status Draft, Revisi dan Reject yang bisa di hapus'), FlexGlobals.topLevelApplication.l("Informasi"));
					}
				}
				
				function f_reset():void
				{
					sumber = a[3].toLowerCase();
					f_kondisiAwal();
				}
				
				function f_tambah():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 1) == true){
						for(i=0;i<FlexGlobals.topLevelApplication.m.ArrUserMenu.length;i++)
							if(parseInt(FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i).mnmoduleid) == a[0] && parseInt(FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i).mnid) == a[1]){
								FlexGlobals.topLevelApplication.m.o = FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i);
								break;
							}
						FlexGlobals.topLevelApplication.openFormX(FlexGlobals.topLevelApplication.m.o.mnname, 0, FlexGlobals.topLevelApplication.m.o.mnurl, 0, 0, "t2");
					}
				}
				
				function f_edit():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 2) == true){
						if(dg.selectedCell != null){
							sumber = a[3].toLowerCase();
							var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
							if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 4) == true){
								for(i=0;i<FlexGlobals.topLevelApplication.m.ArrUserMenu.length;i++)
									if(parseInt(FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i).mnmoduleid) == a[0] && parseInt(FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i).mnid) == a[1]){
										FlexGlobals.topLevelApplication.m.o = FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i);
										break;
									}
								FlexGlobals.topLevelApplication.openFormX(FlexGlobals.topLevelApplication.m.o.mnname, 0, FlexGlobals.topLevelApplication.m.o.mnurl, 0, 0, "t2", String(id));
							}
						} 
					}
				}
				
				function f_history():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 12) == true){
						if(dg.selectedCell != null){
							var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
							if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 4) == true){
								for(i=0;i<FlexGlobals.topLevelApplication.m.ArrUserMenu.length;i++)
									if(parseInt(FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i).mnmoduleid) == a[0] && parseInt(FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i).mnid) == a[1]){
										FlexGlobals.topLevelApplication.m.o = FlexGlobals.topLevelApplication.m.ArrUserMenu.getItemAt(i);
										break;
									}
								FlexGlobals.topLevelApplication.openFormX ("History "+FlexGlobals.topLevelApplication.m.o.mnname, 0, "mod/m0/m0_HistoryTransaksi.swf", 0, 0, "t3", String(id),[a[3], a[0], a[2]]);
							}
						} 
					}
				}
				
				function f_cetak():void
				{
					sumber = a[3].toUpperCase();
					//					FlexGlobals.topLevelApplication.m.p = FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text);
					if(cmbjenislaporan.selectedIndex >= 0){
						FlexGlobals.topLevelApplication.m.wmk = "";
						if(cmbstatus.selectedIndex >= 0)
							if(cmbstatus.selectedItem.v == 0)
								FlexGlobals.topLevelApplication.m.wmk = "Draft";
						FlexGlobals.topLevelApplication.F_openReport(5, 10, cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', 0, FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text), sumber, 0);
					}else{
						cmbjenislaporan.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Pilih Jenis Laporan dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}	}
				
				function f_bantuan():void
				{
					FlexGlobals.topLevelApplication.F_help(a[0], a[1]);
				}
				
				function f_cetakDetail():void
				{ 
					sumber = a[3].toLowerCase();
					if(cmbjenislaporan.selectedIndex >= 0){
						FlexGlobals.topLevelApplication.m.s = f_filterdata();
						if(FlexGlobals.topLevelApplication.m.s.length == 0)
							FlexGlobals.topLevelApplication.m.s = (sumber+"notransaksi = '"+dg.dataProvider[dg.selectedCell.rowIndex][sumber+"notransaksi"]+"'");
						else
							FlexGlobals.topLevelApplication.m.s = FlexGlobals.topLevelApplication.m.s + "AND ("+sumber+"notransaksi = '"+dg.dataProvider[dg.selectedCell.rowIndex][sumber+"notransaksi"]+"'"+")";
						//						m.p = F_paramDate(m.o.dttgl1.text, m.o.dttgl2.text);
						FlexGlobals.topLevelApplication.m.wm = "";
						
						if(dg.dataProvider[dg.selectedCell.rowIndex][sumber+"status"] == 0)FlexGlobals.topLevelApplication.m.wm = "Draft";
						FlexGlobals.topLevelApplication.F_openReport(5, 10, cmbjenislaporan.selectedItem.ritem, FlexGlobals.topLevelApplication.m.s, "", '', 0, FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text), sumber.toUpperCase(), dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"], FlexGlobals.topLevelApplication.m.wm);
					}else{
						cmbjenislaporan.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Pilih Jenis Laporan dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}
				}
				
				function f_transaksiTerkait():void
				{
					sumber = a[3].toLowerCase();
					if(dg.dataProviderLength > 0)
						FlexGlobals.topLevelApplication.F_wsGetDataById(FlexGlobals.topLevelApplication.sptParam+'tampilFDTransaksiTerkait', 'M'+a[0]+'_'+a[3]+'Terkait', dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"]); 
				}
				
				function f_jurnalVocher():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 11) == true){
						sumber = a[3].toLowerCase();
						if(dg.selectedCell == null){
							Alert.show(FlexGlobals.topLevelApplication.l("Pilih data dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							return;
						} 
						var notransaksi:String = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"notransaksi"];
						if(notransaksi == null){
							Alert.show(FlexGlobals.topLevelApplication.l("Pilih No Transaksi dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							return;
						}
						if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 11) == true)
							FlexGlobals.topLevelApplication.F_wsSearch(FlexGlobals.topLevelApplication.sptParam+'tampilFDJurnalVocher', 'M2_Transaction_Journal_VoucherSearch', 0, 0, "tnotransaksi = '"+notransaksi+"'", "tgrup, turutan");
					}
				}
				
				function f_jadikanDraft():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 2) == true){
						sumber = a[3].toLowerCase();
						var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"status"];
						var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
						if(dg.dataProviderLength > 0)
							if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 2) == true)
								if(status == 2)
									FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M'+a[0]+'_'+a[3]+'UpdateStatus', FlexGlobals.topLevelApplication.userid, id, '0', false, int(txtpaging.text), 20, f_filterdata(), FlexGlobals.topLevelApplication.m.sort[FlexGlobals.topLevelApplication.module]);
								else Alert.show(FlexGlobals.topLevelApplication.l('Hanya status approved yang bisa di jadikan Draft'), FlexGlobals.topLevelApplication.l('Informasi'));
					}
				}
				
				function f_jadikanCloseUnclose():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 10) == true){
						sumber = a[3].toLowerCase();
						var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"status"];
						var id:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
						if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 10) == true)
							if(status == 7)
								FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M'+a[0]+'_'+a[3]+'UpdateStatus', FlexGlobals.topLevelApplication.userid, id, 'unclose', false, int(txtpaging.text), 20,f_filterdata(), FlexGlobals.topLevelApplication.m.sort[FlexGlobals.topLevelApplication.module]);
							else if(status == 2 || status == 3 || status == 4)
								FlexGlobals.topLevelApplication.F_wsUpdateStatus(FlexGlobals.topLevelApplication.sptParam+'updateStatus', 'M'+a[0]+'_'+a[3]+'UpdateStatus', FlexGlobals.topLevelApplication.userid, id, '7', false, int(txtpaging.text), 20, f_filterdata(), FlexGlobals.topLevelApplication.m.sort[FlexGlobals.topLevelApplication.module]);
							else Alert.show(FlexGlobals.topLevelApplication.l('Status Approved, Inprogress dan Complete yang bisa di Close'), FlexGlobals.topLevelApplication.l('Informasi'));	
					}
				}
				
				function f_historiTransaksi():void
				{
					if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 12) == true){
						if(dg.dataProviderLength > 0 && FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 12) == true)
							Alert.show(FlexGlobals.topLevelApplication.l('Form Histori Transaksi belum ada'), FlexGlobals.topLevelApplication.l('Informasi'));
					}
				}
				
				function f_mbItemClick(e:MenuEvent):void
				{
					
					switch(e.label){
						case 'Bantuan':f_bantuan()
							break;
						case 'Edit':f_edit();
							break;
						case 'Hapus':f_hapus();
							break;
						case 'Cetak Detail':f_cetakDetail();
							break;
						case 'Transaksi Terkait':f_transaksiTerkait();
							break;
						case 'Jurnal Voucher':f_jurnalVocher();
							break;
						case 'Jadikan Draft':f_jadikanDraft();
							break;
						case 'Jadikan Close/Unclose':f_jadikanCloseUnclose();
							break;
						case 'Histori Transaksi':f_history();
							break;
						case "Ms.Excel":case "HTML": case "Ms.Word":case "Text":case "Image":
							sumber = a[3].toUpperCase();
							FlexGlobals.topLevelApplication.m.p = FlexGlobals.topLevelApplication.F_paramDate(dttgl1.text, dttgl2.text);
							if(cmbjenislaporan.selectedIndex >= 0){
								FlexGlobals.topLevelApplication.m.wmk = "";
								if(cmbstatus.selectedIndex >= 0)
									if(cmbstatus.selectedItem.v == 0)
										FlexGlobals.topLevelApplication.m.wmk = "Draft";	
								FlexGlobals.topLevelApplication.F_openReport(a[0], a[1], cmbjenislaporan.selectedItem.ritem, f_filterdata(), '', '', e.item.data, FlexGlobals.topLevelApplication.m.p, sumber, 0);
							}else{
								cmbjenislaporan.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Pilih Jenis Laporan dulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}
					}
				}
				
				function f_upload():void{
					FlexGlobals.topLevelApplication.openFormX("Upload Data", 1, "mod/m12/m12_UploadData.swf", 266, 472)
				}
				p.F_DateFieldStandard([dttgl1, dttgl2]);														// daftarkan fungsi-fungsi datefield
				p.F_ComboBoxStandard([cmbjenislaporan,  cmbstatus,cmbstatusupload]);											// daftarkan fungsi-fungsi combobox
				p.F_txtpencarian([txtcustomer1, txtuser, txtlokasi, txtcabang]);		// daftarkan fungsi-fungsi text input yang pencarian
				p.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2]);				// daftarkan fungsi-fungsi text input
				//				txtnotransaksi1.addEventListener(spark.events.TextOperationEvent.CHANGE, f_change);				// digunakan untuk pengisian text input lain ketika fokus out
				//				dttgl1.addEventListener(spark.events.TextOperationEvent.CHANGE, f_changedate);					// digunakan untuk pengisian datefield lain ketika fokus out
				function f_change():void{
					txtnotransaksi2.text = txtnotransaksi1.text;
				}
				function f_changedate():void{
					dttgl2.text = dttgl1.text;
				}
				gridtt.addEventListener(KeyboardEvent.KEY_DOWN, f_GRID_KEY_DOWN);
				function f_GRID_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.C:
							flash.system.System.setClipboard(gridtt.dataProvider.getItemAt(gridtt.selectedCell.rowIndex)[gridtt.columns.getItemAt(gridtt.selectedCell.columnIndex).dataField]);
							break;
					}
				}
				FlexGlobals.topLevelApplication.F_RegGrid(12,10,[dg], "data")
				f_kondisiAwal();
			}
			
			// set kondisi awal ketika form dibuka ======================================
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				cmbstatus.selectedIndex = o.DefaultStatus;
				cmbstatusupload.selectedIndex = 1;
				cmbstatusupload.validateNow();
				txtuser.text = p.userid;
				p.F_SetNilaiText([dttgl1, dttgl2], p.DefaultTanggal);
				txtcabang.text = FlexGlobals.topLevelApplication.ucabang;
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				p.F_KosongkanText([txtnotransaksi1, txtnotransaksi2, txtcustomer1, txtsalesman, txtuser]);
				dg.dataProvider.removeAll();
				cmbstatusupload.dataProvider = new ArrayCollection([{l:'Semua', v:-1}, {l:'Belum Upload', v:0}, {l:'Sudah Upload', v:1}]);
				cmbstatusupload.selectedIndex = 1;
			}
			
			// digunakan untuk duka form transaksi ======================================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				if(parentApplication.apaBisaAkses(a[0], a[1], 4) == true)
					FlexGlobals.topLevelApplication.openForm(12, 8, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[a[3].toLowerCase()+'id']);
			}
			
			// set kondisi untuk filter =============================================
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtcustomer1':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+txtcustomer1.text.split('"').join('\\"')+'"';			// dipakai ketika validasi dari textinput
						csfilter = '(kaktif=1 AND kkategori="C")';																	// dipakai ketika buka form komponen pencarian
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtcustomer2':
						paket = 'CdM1_Contact';
						//						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+txtcustomer2.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="C")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = 'laktif=1';
						wsfilter = 'laktif=1 AND lkode ="'+txtlokasi.text.split('"').join('\\"')+'"';
						sort = 'lkode asc';
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = 'baktif=1';
						wsfilter = 'baktif=1 AND bkode ="'+txtcabang.text+'"';
						sort = 'bkode asc';
						break;
					case 'txtsalesman':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="M") AND kkode ="'+txtsalesman.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					
					case 'txtuser':
						paket = 'CdM0_User';
						csfilter = 'uaktif=1';
						wsfilter = 'uaktif=1 AND ukode ="'+txtuser.text.split('"').join('\\"')+'"';
						sort = 'ukode asc';
						break;
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			// set kondisi saat set ketika selesai pencarian ==================================
			// set ketika benar ====================================
			public var customer1:String, customer2:String, salesman:String, inputuser:String;
			public function f_wsHasil():void
			{
				var o:Object, s:String = p.subject, i:int;
				if(p.wsSuccess == true){
					if(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt.length >= 0)o = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case 'tampilForm':
							for(i=0;i<FlexGlobals.topLevelApplication.wsArrUtama.length;i++) 
								if(FlexGlobals.topLevelApplication.wsArrUtama[i].simodifikasiusernama == "")
									FlexGlobals.topLevelApplication.wsArrUtama[i].simodifikasitgl = ""
							dg.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama; 
							for(var n:int; n<dg.dataProviderLength; n++){
								if(dg.dataProvider[n].siuploaded == 0){
									dg.dataProvider[n].siuploadednama = "Belum Upload";
								}else{
									dg.dataProvider[n].siuploadednama = "Sudah Upload";
								}
							}
							dg.setSelectedCell(0,0);
							FlexGlobals.topLevelApplication.rowIndex = 0;
							imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							imglast.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							for(i=0;i<dg.dataProviderLength;i++)
								dg.dataProvider[i].no = (((FlexGlobals.topLevelApplication.wsCurPage-1)*20)+(i+1));
							FlexGlobals.topLevelApplication.F_dgRefresh(dg);
							dg.setFocus();
							dg.setSelectedCell(0,0);
							//							if(o.hasOwnProperty('f_grid_change'))o.f_grid_change();
							//							}else m[idmod].child.dg.dataProvider.removeAll();
							break; 
						case 'txtcustomer1':
							txtcustomer1.text = o.kkode;
							customer1 = o.kid;
							lblcustomer.text = o.knama;
						case 'txtcustomer2':
							//							txtcustomer2.text = o.kkode;
							customer2 = o.kid;
							break;
						
						case 'txtuser':
							txtuser.text = o.ukode;
							inputuser = o.userid;
							break;
						case 'txtsalesman':
							txtsalesman.text = o.kkode;
							salesman = o.kid;
							break;
						
					}
				}else{			
					// set ketika salah ====================================		
					if(p.F_validasiFalse(s) == true)
						switch(s){
							case 'txtcustomer1':txtcustomer1.text = ""; customer1 = "0"; break;
							case 'txtuser':txtuser.text = ""; inputuser = "0"; break;
							case 'txtsalesman':txtsalesman.text = ""; salesman = "0"; break;
							case 'tampilForm': dg.dataProvider.removeAll(); break;
						}
				}
			}
			
			// pengosongan textinput ketika pencarian tidak ditemukan ================================
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcustomer1':p.F_KosongkanText([txtcustomer1]);customer1 = '';break;
					//					case 'txtcustomer2':p.F_KosongkanText([txtcustomer2]);customer2 = '';break;
					case 'txtuser':p.F_KosongkanText([txtuser]);inputuser = '';break;
					case 'txtsalesman':p.F_KosongkanText([txtsalesman]);salesman = '';break;
				}
			}
			
			// pengisian filter untuk report =========================================================
			public function f_filterdata():String{
				var f:String="";
				f = FlexGlobals.topLevelApplication.F_standartFilter();
				f = p.TambahFilter(f,'sisaldoawal = 0');
				if(txtcustomer1.text!='')
					f = p.TambahFilter(f,'sicustomer ='+customer1+'');
				if(txtsalesman.text!='')
					f = p.TambahFilter(f,'sibagianpenjualan ='+salesman);
				if(txtuser.text!='')
					f = p.TambahFilter(f,'siinputuser ='+inputuser);
				if(FlexGlobals.topLevelApplication.getSetting(0, "company", "IsServer") == 0){
					if(cmbstatusupload.selectedItem.v > -1)
						f = p.TambahFilter(f,'siuploaded ="'+cmbstatusupload.selectedItem.v+'"');
				}
				
				
				return f;
			}
			//Tampilkan data
			public function f_formDataTampil(page:int = 1, sort:String = ''):void
			{
				if(FlexGlobals.topLevelApplication.apaBisaAkses(a[0], a[1], 4) == true){
					if(sort == '')sort = a[3]+"inputtgl desc";
					FlexGlobals.topLevelApplication.F_wsSearch("tampilForm", 'M'+a[0]+'_'+a[3]+'Search', page, 20, o.f_filterdata(), sort);
				}
			}
			
