				tab.addEventListener(IndexChangedEvent.CHANGE, function ():void{
					F_persiapanFormMaster();
					
				});
				
				f_kondisiAwal();
			}
			
			public function f_formMasterTampil(page:int = 1, sort:String = ''):void
			{
				if(FlexGlobals.topLevelApplication.apaBisaAkses(arr[8][0], arr[8][1], 4) == true){
					
					if(sort == '')sort = arr[1];
					FlexGlobals.topLevelApplication.F_wsSearch("tampilForm", arr[0], page, 20, f_filterdata(), sort);
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
				
					case 'txtkategoripos': //kategoripos
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
						csfilter = 'pcaktif=1';
						sort = 'pckode asc';
						break;
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'tampilForm':
							if(tab.selectedIndex == 0){
								if(FlexGlobals.topLevelApplication.wsArrUtama[i].pimodifikasiusernama == "")
									FlexGlobals.topLevelApplication.wsArrUtama[i].pimodifikasitgl = ""
								dg.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama; 
								dg.setSelectedCell(0,0);
								FlexGlobals.topLevelApplication.rowIndex = 0;
								imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
								imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
								imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
								imglast.enabled =FlexGlobals.topLevelApplication. wsIsNext;
								txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
								for(i=0;i<dg.dataProviderLength;i++)
									dg.dataProvider[i].no = (((FlexGlobals.topLevelApplication.wsCurPage-1)*20)+(i+1));
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								dg.setFocus();
								dg.setSelectedCell(0,0);
							}else{
								if(FlexGlobals.topLevelApplication.wsArrUtama[i].ptmodifikasiusernama == "")
									FlexGlobals.topLevelApplication.wsArrUtama[i].ptmodifikasitgl = ""
								dg2.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama; 
								dg2.setSelectedCell(0,0);
								FlexGlobals.topLevelApplication.rowIndex = 0;
								imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
								imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
								imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
								imglast.enabled =FlexGlobals.topLevelApplication. wsIsNext;
								txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
								for(i=0;i<dg2.dataProviderLength;i++)
									dg2.dataProvider[i].no = (((FlexGlobals.topLevelApplication.wsCurPage-1)*20)+(i+1));
								FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
								dg2.setFocus();
								dg2.setSelectedCell(0,0);
							}
							
							break;
						case 'terkaitFormMaster':
							if(tab.selectedIndex == 0){
								dg.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
								dg.setSelectedCell(0,0);
								FlexGlobals.topLevelApplication.rowIndex = 0;
								txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							}else{
								dg2.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
								dg2.setSelectedCell(0,0);
								FlexGlobals.topLevelApplication.rowIndex = 0;
								txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							}
							break;
						case 'txtkategoripos':
							txtkategoripos.text = parentApplication.wsArrUtama.getItemAt(0).pckode;
							lblkategoripos.text = parentApplication.wsArrUtama.getItemAt(0).pcnama;
							FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
							FlexGlobals.topLevelApplication.F_wsGetDataById('jenispoin', 'M12_Pos_Category_SettingGetdataById', txtkategoripos.text, 0, 0, 'smodule = 0 and sgrup = "app" AND skode="Point"', 'surutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							break;
						case 'jenispoin':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							njenispoin = ws.pcsnilai;
							if(dg.dataProvider != null){dg.dataProvider.removeAll()}
							if(dg2.dataProvider != null){dg2.dataProvider.removeAll()}
							switch(njenispoin){
								case 0: // tidak ada poin
									tabbarang.enabled = false;
									tabtotal.enabled = false;
									txtjenispoin.text = "No Point";
									break;
								case 1: // berdasarkan barang
									tabbarang.enabled = true;
									tabtotal.enabled = false;
									tab.selectedIndex = 0;
									txtjenispoin.text = "Item Based";
									arr[0] = 'M12_Pos_Point_ItemSearch'; 					//ws Tampil
									arr[1] = 'bkode asc, pioperator asc, pijml1 asc';
									arr[6] = 'M12_Pos_Point_ItemDelete'; 
									break;
								case 2:
									tabbarang.enabled = false;
									tabtotal.enabled = true;
									tab.selectedIndex = 1;
									txtjenispoin.text = "Nominal Based";
									arr[0] = 'M12_Pos_Point_TransactionSearch'; 					//ws Tampil
									arr[1] = 'ptoperator asc, ptjml1 asc';
									arr[6] = 'M12_Pos_Point_TransactionDelete'; 
									break;
							}
							
//							if(tab.selectedIndex == 0){
//								F_persiapanFormMaster(dg);
//							}else{
//								F_persiapanFormMaster(dg2);
//							}
							f_formMasterTampil();
							break;
						
						
					}
				}else{					
					if(FlexGlobals.topLevelApplication.F_validasiFalse(s) == true)
						switch(s){
							case "tampilForm":
								if(tab.selectedIndex == 0){
									if(dg.dataProvider != null){
										dg.dataProvider.removeAll()
									}
								}else if(tab.selectedIndex == 1){
									if(dg2.dataProvider != null){
										dg2.dataProvider.removeAll()
									}
								}
								break;
							case 'terkaitFormMaster':
								Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, FlexGlobals.topLevelApplication.l('Infromasi'));
								break;
							
							case "txtkategoripos":txtkategoripos.text=''; lblkategoripos.text = ""; break;
							
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					
					case "txtkategoripos":txtkategoripos.text=''; lblkategoripos.text = ""; break;
					case "tampilForm":
						if(tab.selectedIndex == 0){
							if(dg.dataProvider != null){
								dg.dataProvider.removeAll()
							}
						}else if(tab.selectedIndex == 1){
							if(dg2.dataProvider != null){
								dg2.dataProvider.removeAll()
							}
						}
						break;
					case 'terkaitFormMaster':
						Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, FlexGlobals.topLevelApplication.l('Infromasi'));
						break;
				}
			}
			public function f_kondisiAwal():void
			{
				f_focusOnMe();
				var isfound:Boolean = false;
				var arrayhakakses:Object;
				parentApplication.F_KosongkanText([txtkategoripos, lblkategoripos, txtjenispoin]);
				cmboperator.selectedIndex = 0;
				tabbarang.enabled = false;
				tabtotal.enabled = false;
				if(dg.dataProvider != null){
					dg.dataProvider.removeAll();
				}
				
			}
			
			public var vfileextention:int=0;
			
			public function f_cekterpilih():Boolean{if(dg.selectedCell == null){return false}else{return true}}
			public function f_paramDelete():String{
				//ptkategori(0) As String, ptoperator(1) As String, ptjml1(2) As Double, ptjml2(3) As Double
				//pikategori(0) As String, piidbarang(1) As Double, pioperator(2) As String, pijml1(3) As Double, pijml2(4) As Double
				if(tab.selectedIndex == 0){
					return dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pikategori+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).piidbarang+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pioperator+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pijml1+"△"+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pijml2
				}else{
					return dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).ptkategori+"△"+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).ptoperator+"△"+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).ptjml1+"△"+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).ptjml2;
				}
				
			}
			public function f_filterdata():String{
				var f:String = '';
				var sumber :String = "";
				if(tab.selectedIndex == 0){
					sumber = "pi";
				}else if(tab.selectedIndex == 1){
					sumber = "pt";
				}
				if(cmboperator.selectedIndex > 0)
					f = parentApplication.TambahFilter(f, sumber+'operator = "'+cmboperator.selectedItem.v+'"');
				
				if(txtkategoripos.text != '')
					f = parentApplication.TambahFilter(f, sumber+'kategori = "'+txtkategoripos.text.split('"').join('\\"')+'"');
				
				return f;
			}
			
			
