				FlexGlobals.topLevelApplication.F_txtpencarian([txtkategoripos]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkategoripos]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtjenispoin])
				FlexGlobals.topLevelApplication.F_setGridJson(12, 19);
