			// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'calculator':
						dg_tambah.dataProvider[dg_tambah.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg_tambah, dg_tambah.selectedCell.rowIndex);
						break;
					case 'checkBoxHeader':
						for (i=0; i<dg_tambah.dataProviderLength; i++){
							dg_tambah.dataProvider.getItemAt(i).chk = data;
							dg_tambah.dataProvider.getItemAt(i).piaksi = 1;
						}
						break;
					case 'checkBox':
						dg_tambah.dataProvider.getItemAt(dg_tambah.selectedCell.rowIndex).chk = data;
						dg_tambah.dataProvider.getItemAt(dg_tambah.selectedCell.rowIndex).piaksi = 1;
						
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg_tambah);
			}
			
