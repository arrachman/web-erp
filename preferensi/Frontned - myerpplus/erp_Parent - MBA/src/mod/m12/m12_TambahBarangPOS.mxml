			// set persiapan form ==========================================================
			protected function f_persiapan():void
			{
				p = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child;
				
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				parentApplication.F_txtpencarian([txtkodebarang1, txtkodebarang2, txtkategoribarang]);
				parentApplication.F_SetNavigasiKeyboard([txtnamabarang, txtfilter]);
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				function f_mbSimpan():void
				{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(12,13,jenissimpan)==true){
						f_simpan();
					}
				}
				
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbTampilkan():void
				{
					f_tampilkan();
				}
				
				// Config Paging
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = "0";
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				function f_firstCLICK():void{
					f_tampilkan(1);
				}
				function f_previousCLICK():void{
					f_tampilkan(int(txtpaging.text) - 1);
					txtpaging.text = String(int(txtpaging.text) - 1)
				}
				function f_nextCLICK():void{
					f_tampilkan(int(txtpaging.text) + 1)
					txtpaging.text = String(int(txtpaging.text) + 1)
				}
				function f_lastCLICK():void{
					f_tampilkan(int(- 1))
					
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_tampilkan(int(txtpaging.text));
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(12, 13, [dg_tambah], 'TransaksiBarang');
				f_validasi();
				f_kondisiAwal();
			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_PaHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					else  {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_PaGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				o.txtfilterperubahannilai = 0;
				o.txtfiltersetnilai = 0;
				o.txtkurs = 0;
				isUpdate = false;
				
				o.txtkurs = parentApplication.getSetting(0, 'accounting', 'Kurs');
				mb.menuBarItems[0].enabled = true;
				imgfirst.enabled = false;
				imgprevious.enabled = false;
				imgnext.enabled = false;
				imglast.enabled = false;
				FlexGlobals.topLevelApplication.F_KosongkanText([txtfilter, txtkategoribarang, txtkodebarang1, txtkodebarang2, txtnamabarang, lblbagianbagiansetharga]);
				f_focusOnMe();
				f_defaultGrid();
				f_tampilkan(1);
				
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(12,13,jenissimpan)==true){
								f_simpan();
							}
						}
						break;
					case Keyboard.F:
						if(e.ctrlKey)f_tampilkan();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						break;
					case Keyboard.PAGE_DOWN:
						f_tampilkan(int(txtpaging.text) + 1)
						txtpaging.text = String(int(txtpaging.text) + 1)
						break;
					case Keyboard.PAGE_UP:
						f_tampilkan(int(txtpaging.text) - 1);
						txtpaging.text = String(int(txtpaging.text) - 1)
						break;
					case Keyboard.HOME:
						f_tampilkan(1);
						break;
					case Keyboard.END:
						f_tampilkan(int(- 1))
						break;
				}
			}	
			
