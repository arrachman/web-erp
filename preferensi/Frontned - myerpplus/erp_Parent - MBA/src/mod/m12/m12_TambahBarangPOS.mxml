							case "txtkodebarang2":
								txtkodebarang2.text = "";
								break;
						}
				}
				parentApplication.F_dgRefresh(dg_tambah);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					
					case 'tampilkan':
						for(var a:int = dg_tambah.dataProviderLength - 1; a>=0; a--){
							if(dg_tambah.dataProvider[a].chk == 0){
								dg_tambah.dataProvider.removeItemAt(a);
							}
						}
						if(dg_tambah.dataProviderLength == 0){
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg_tambah);
						}
						break;
					case 'getdatabarang':
						dg_tambah.dataProvider.removeAll();
						parentApplication.F_acAdd(dg_tambah);
						dg_tambah.setSelectedCell(0, 1);
						dg_tambah.dataProvider[0].pistatusgetdata = 0;
						dg_tambah.dataProvider[0].pistatusubah = 0;
						break;
					case "txtkategoribarang":
						txtkategoribarang.text = "";
						break;
					case "txtkodebarang1":
						txtkodebarang1.text = "";
						break;
					case "txtkodebarang2":
						txtkodebarang2.text = "";
						break;
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String="", valsimpan:Boolean = false;
				parentApplication.vpFocusEvent = true;
				
				if(mb.menuBarItems[0].enabled == true){
					for(i = 0; i<dg_tambah.dataProviderLength; i++){
						if(dg_tambah.dataProvider[i].kodebarang == ""){
							Alert.show("Data harus dipilih terlebih dahulu", "Informasi");
							validasi = false;
						}else{
							validasi = true;
						}
					}
					if(validasi == true){
						// Set Detail
						for(i=0;i<dg_tambah.dataProviderLength;i++)
							with(dg_tambah.dataProvider.getItemAt(i)){
								if(chk == 1){
									valsimpan = true;
									a = [pikategori, piidbarang, pistokminimal, pistokmaksimal, pistokreorder, pihargajual1, pihargajual2, 
										pihargajual3, pihargajual4, pihargajual5, pidiskonjual1, pidiskonjual2, pidiskonjual3, pidiskonjual4, 
										pidiskonjual5, picustomtext1, picustomtext2, picustomtext3, picustomtext4, picustomtext5, picustomint1, 
										picustomint2, picustomint3, picustomdbl1, picustomdbl2, picustomdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(picustomdate3), piaksi, pistokminorder, 0];
									if(detail == "" )detail = parentApplication.F_splitArrayToString(a);
									else detail += "▲"+parentApplication.F_splitArrayToString(a);
								}
								
							}
						FlexGlobals.topLevelApplication.F_wsSimpan('simpan', "M12_Pos_ItemSimpan", parentApplication.userid, isUpdate, detail, "", 1, 13, p.f_filterdata(), "bkode asc");
					}
				}
				
				function validasiForm():void
				{
					pesanAlert='';
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg_tambah);
					
					
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
			
