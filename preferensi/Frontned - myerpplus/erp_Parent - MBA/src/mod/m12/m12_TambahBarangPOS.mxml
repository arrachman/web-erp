			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg_tambah.dataProvider.removeAll();
				parentApplication.F_acAdd(dg_tambah);
				dg_tambah.setSelectedCell(0, 1);
				dg_tambah.setSelectedCell(0, 0);
				f_focusOnMe();
			}
			
			
			
			public function f_tampilkan(halaman:int = 1):void
			{
				strFilter = "";
				
				if(txtkategoribarang.text.length > 0){
					strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter,'bkategori = "'+txtkategoribarang.text+'"');
				}
				if(txtkodebarang1.text != "" && txtkodebarang2.text != "")strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter, 'bkode BETWEEN "'+txtkodebarang1.text+'" AND "'+txtkodebarang2.text+'"');
				if(txtnamabarang.text != "")strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter,'bnama like "%'+txtnamabarang.text.split('"').join('\\"')+'%"');
//				for(i=0; i<dg_tambah.dataProviderLength; i++){
//					if(dg_tambah.dataProvider[i].chk == 1){
//						strFilter = FlexGlobals.topLevelApplication.TambahFilter(strFilter,'bid <>"'+dg_tambah.dataProvider.getItemAt(i).piidbarang.split('"').join('\\"')+'"'); 
//					}
//					
//				}
				FlexGlobals.topLevelApplication.F_wsSearch("tampilkan", "CdM12_ItemAddCategoryPOS",halaman,12,strFilter,"bkode asc", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), p.txtkategoripos.text)
				
			}
			
