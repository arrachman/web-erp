			public var validasi:Boolean,b:Button,tt:TitleWindow, pesanAlert:String, pesanAlertIng:String,UFungsional:String, img:Image, i:int, isUpdate:Boolean, hf:Object;
			public var o:Object = {},no:int;
			public var vIdbarang:int, arrColumn:Array = new Array, matauang:String, kurs:Number, dg:DataGrid, p:Object;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			
			public function f_focusOnMe():void
			{
				txtkategoripos.setFocus();
			}
			
			protected function f_persiapan():void
			{
				
				p = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child;
				//mb.dataProvider = new ArrayCollection([{label:'Simpan', icon:tbsave}]);
				parentApplication.F_txtpencarian([txtkategoripos, txtkategoribarang]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkategoribarang, tkategoripos]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkategoripos, tkategoribarang]);
				
				
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Batal", icon:"tbclose", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
						var jenissimpan:int = 1;
						f_simpan();
					}
				}
				function f_mbbuka():void{
					if(mb.menuBarItems[1].enabled ==true)FlexGlobals.topLevelApplication.f_bukaTransaksi('Cr');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
				}
				
				function f_mbCatatan():void{
					
				}
				function f_mbUpload():void {
					
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(2,'Cr');
				}
				
				
				FlexGlobals.topLevelApplication.F_RegGrid(12,18,[dginput],'transaksi');
				f_validasi();
				
			}
			public function f_validasi():void{
				f_focusOnMe();
				if(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.hasOwnProperty('dg'))
					dg = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.dg;
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					txtkategoripos.text = dg.dataProvider[dg.selectedCell.rowIndex].dcikategori;
					FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
					lblkategoripos.text = dg.dataProvider[dg.selectedCell.rowIndex].pcnama;
					txtkategoribarang.text = dg.dataProvider[dg.selectedCell.rowIndex].dcikategoribarang;
					o.kbarang = txtkategoribarang.text;
					lblkategoribarang.text = dg.dataProvider[dg.selectedCell.rowIndex].icnama;
					isUpdate = true;
					FlexGlobals.topLevelApplication.F_wsSearch("tampil","M12_Pos_Discount_Category_ItemSearch",0,0,"dcikategori = '"+txtkategoripos.text+"' AND dcikategoribarang = '"+txtkategoribarang.text+"'","dcikategori asc, dcioperator asc, dcijml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
				}
			}
			protected function f_kondisiAwal():void
			{
				
				isUpdate = false;
				txtkategoripos.setFocus();
				txtkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.txtkategoripos.text;
				FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
				lblkategoripos.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmodcurr].child.lblkategoripos.text;
				o.kbarang = "";
				//set utama
				f_setdefaultdata();
				
				
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
					case Keyboard.ESCAPE:
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
						break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid:Object
				switch (components){
					case  'calculator':
						dginput.dataProvider[dginput.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dginput, dginput.selectedCell.rowIndex);
						if(Number(data) > 0){
							
						}
						break;
					case 'comboBox':
						if(dataField == "dcioperator"){
							if(data !=0){
								dginput.dataProvider[dginput.selectedCell.rowIndex].dcijml2 = 0;
							}
							
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'dcikriteria'){
							return new ArrayCollection([{l:'Discount Percent', v:1}, {l:'Discount Nominal', v:2}]);
						}
						if(dataField == 'dcioperator'){
							return new ArrayCollection([{l:'Antara', v:0}, {l:'>=', v:1}, {l:'Kelipatan', v:2}]);
						}
				}
				return new ArrayCollection([]);
			}
			public function f_setdefaultdata():void{
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcioperator = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcijml1 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcijml2 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcikriteria = 1; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcinilai = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcitgl1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcitgl2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcijam1 = "00:00:00"; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcijam2 = "00:00:00"; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomtext1 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomtext2 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomtext3 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomtext4 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomtext5 = ""; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomint1 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomint2 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomint3 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomdbl1 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomdbl2 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomdbl3 = 0; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
				dginput.dataProvider.getItemAt(dginput.dataProviderLength-1).dcicustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
			}
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if(column == 'add' || o.a[0] == 'add'){
					f_setdefaultdata();
				}
				switch(column){
					
					case 'dcijml2':
						with(dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex)){
							if(dcioperator != 0){
								dcijml2 = 0;
							}
						}
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dginput);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos': //kategoripos
						paket = 'CdM12_Pos_Category';
						wsfilter = 'pcaktif=1 and pckode ="'+txtkategoripos.text+'"';
						csfilter = 'pcaktif=1';
						sort = 'pckode asc';
						break;
					case 'txtkategoribarang': //kode barang
						paket = 'CdM1_Item_Category';
						wsfilter = 'icaktif=1 and ickode ="'+txtkategoribarang.text+'"';
						csfilter = 'icaktif=1';
						sort = 'ickode asc';
						break;
					case 'kategoribarang': //kode barang detail
						paket = 'CdM1_Item';
						wsfilter = 'baktif=1 and bkode ="'+dginput.dataProvider.getItemAt(parentApplication.rowIndex).kategoribarang+'"';
						csfilter = 'baktif=1';
						sort = 'bkode asc';
						break;
					case "satuan": //satuan
						paket = "CdM1_Unit";
						wsfilter = 'uaktif=1 AND ukode ="'+dginput.dataProvider.getItemAt(dginput.selectedCell.rowIndex).satuan+'"';
						csfilter = 'uaktif=1';
						csfield = 2;
						sort = 'ukode asc';
						break
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				FlexGlobals.topLevelApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'txtkategoripos':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							
							if(o.kategorikode != ws.pckode && txtkategoripos.text.length > 0 && (txtkategoribarang.text.length > 0  || dginput.dataProvider[0].dcijml1 > 0)){
								Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{ 
									if(e.detail == Alert.YES){
										txtkategoripos.text = ws.pckode;
										FlexGlobals.topLevelApplication.vpVarCurrent = txtkategoripos.text;
										lblkategoripos.text = ws.pcnama;
										o.kategorikode = ws.pckode;
										FlexGlobals.topLevelApplication.F_KosongkanText([txtkategoribarang, lblkategoribarang]);
										FlexGlobals.topLevelApplication.F_defaultGridItem(dginput);
									}else{
										txtkategoripos.text = o.kategorikode;
										parentApplication.vpVarCurrent = txtkategoripos.text;
										lblkategoripos.text = o.kategorinama;
									}
								});
							}else{
								txtkategoripos.text = ws.pckode;
								lblkategoripos.text = ws.pcnama;
								o.kategorikode = ws.pckode;
								o.kategorinama = ws.pcnama;
							}
							break;
						case 'txtkategoribarang': //kode barang
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkategoribarang.text = ws.ickode;
							lblkategoribarang.text = ws.icnama;
							//o.diidbarang = ws.bid;
//							if(o.kbarang != ''){
//								Alert.show('Data akan dihapus, lanjutkan?', 'Confirmation', 3, null, function(e:Object):void{	
//									if(e.detail == Alert.YES){
//										FlexGlobals.topLevelApplication.F_wsSearch("tampil","M12_Pos_Discount_Category_ItemSearch",0,0,"dcikategori = '"+txtkategoripos.text+"' AND dcikategoribarang = '"+txtkategoribarang.text+"'","",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
//									}
//								});
//							}
							FlexGlobals.topLevelApplication.F_wsSearch("tampil","M12_Pos_Discount_Category_ItemSearch",0,0,"dcikategori = '"+txtkategoripos.text+"' AND dcikategoribarang = '"+txtkategoribarang.text+"'","dcikategori asc, dcioperator asc, dcijml1 asc",FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							o.kbarang = txtkategoribarang.text;
							break;
						
						case 'tampil':
							
							dginput.dataProvider.removeAll();
							for(i = 0; i<FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(i)){
									dginput.dataProvider.addItem({no:i+1,
										dcikategori:dcikategori, dcikategoribarang:dcikategoribarang, dcioperator:dcioperator, 
										dcijml1:dcijml1, dcijml2:dcijml2, dcikriteria:dcikriteria, 
										dcinilai:dcinilai, dcitgl1:dcitgl1, dcitgl2:dcitgl2, dcijam1:dcijam1, dcijam2:dcijam2, dcicustomtext1:dcicustomtext1, 
										dcicustomtext2:dcicustomtext2, dcicustomtext3:dcicustomtext3, 
										dcicustomtext4:dcicustomtext4, dcicustomtext5:dcicustomtext5, dcicustomint1:dcicustomint1, 
										dcicustomint2:dcicustomint2, dcicustomint3:dcicustomint3, dcicustomdbl1:dcicustomdbl1, dcicustomdbl2:dcicustomdbl2, 
										dcicustomdbl3:dcicustomdbl3, dcicustomdate1:dcicustomdate1, dcicustomdate2:dcicustomdate2, 
										dcicustomdate3:dcicustomdate3});
								}
							}
							
							break;
						
						
						
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							
							case 'tampil':
								FlexGlobals.topLevelApplication.F_defaultGridItem(dginput)
								break;
							
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkategoripos':parentApplication.F_KosongkanText([txtkategoripos, lblkategoripos]);break;
					case 'txtkategoribarang':
						parentApplication.F_KosongkanText([txtkategoribarang, lblkategoribarang]);
						o.kbarang = txtkategoribarang.text;
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
						break;
					case 'tampil':
						FlexGlobals.topLevelApplication.F_defaultGridItem(dginput)
						break;
				}
			}
			
			protected function f_simpan():void
			{
				//				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, 
				var	a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi == true){
						// Set Utama
						// Set Detail
						for(i=0;i<dginput.dataProviderLength;i++)
							with(dginput.dataProvider.getItemAt(i)){
								a = [txtkategoripos.text, txtkategoribarang.text, dcioperator, dcijml1, dcijml2, dcikriteria, dcinilai, 
									dcitgl1, dcitgl2, dcijam1, dcijam2, dcicustomtext1, dcicustomtext2, dcicustomtext3, 
									dcicustomtext4, dcicustomtext5, dcicustomint1, dcicustomint2, dcicustomint3, dcicustomdbl1, dcicustomdbl2, 
									dcicustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(dcicustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(dcicustomdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(dcicustomdate3)];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M12_Pos_Discount_Category_ItemSimpan", parentApplication.userid, isUpdate, detail, "",1,20,p.f_filterdata(),p.arr[1]);
						
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = ""; 
					pesanAlertIng = '';
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dginput);
					if(txtkategoripos.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkategoripos, 'Kategori POS');
					if(txtkategoribarang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkategoribarang,'Kategori Barang');
					for(i=0; i<dginput.dataProviderLength; i++){
						if(dginput.dataProvider.getItemAt(i).dijml1 == 0)FlexGlobals.topLevelApplication.msgAlert(dginput,'Jml 1');
					}
					
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
					f_hitungTotal();
					
					
				}
			}
			
			public function f_hitungvalas():void{
				
			}
