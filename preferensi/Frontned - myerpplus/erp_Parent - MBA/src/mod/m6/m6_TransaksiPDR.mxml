				public function f_validasi():void
				{
					var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
					var  idtransaksi : String = filtersplit[0];
					if(FlexGlobals.topLevelApplication.FormFilter == ''){
						f_kondisiAwal();
					}else{
						if(filtersplit.length > 1){
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M6_PdrHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M6_PdrGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
				}
				
