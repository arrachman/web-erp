				public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
				{
					var grid:Object;
					if(tab.selectedIndex < 3){
						if(tab.selectedIndex ==0 ){grid = dg1}
						else if(tab.selectedIndex == 1){grid = dg2}
					}
					switch (components){
						case 'calculator':
							grid.dataProvider[grid.selectedCell.rowIndex][dataField] = data
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(grid, grid.selectedCell.rowIndex);
							with(grid.dataProvider.getItemAt(grid.selectedCell.rowIndex)){
								switch(dataField){
									case 'jml':
										if(tab.selectedIndex == 0){ harga = (Number(hpppersen/100) * Number(n.vtotalbahan)) / Number(jml); }
										jmlbarang = Number(jml) * Number(nilaisatuan);break;
									case 'hpppersen':
										harga = (Number(hpppersen/100) * Number(n.vtotalbahan)) / Number(jml); break;
									case 'harga':
										vMsg = ''; vMsgIng = '';
										dgrid1 = dg1.dataProvider.getItemAt(dg.selectedCell.rowIndex);
										if(dgrid1.jml == 0 || dgrid1.hpppersen == 0){
											if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
											if(dgrid1.hpppersen == 0)msgAlert(dg, "Price [%]", "Harga [%]");
											if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
											dgrid1.jmldiskon = 0;
											dgrid1.diskon= 0;
										}else{
											hpppersen = ((Number(jml) * Number(harga)) / Number(n.vtotalbahan)) * 100; 
										}break;
									case 'subtotal':
										hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
										break;
								}
								subtotal = Number(grid.dataProvider.getItemAt(grid.selectedCell.rowIndex).jml) * Number(grid.dataProvider.getItemAt(grid.selectedCell.rowIndex).harga);
							}
							f_hitungTotalUtama();
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(grid, grid.selectedCell.rowIndex);
							break;
					}
				}
				
