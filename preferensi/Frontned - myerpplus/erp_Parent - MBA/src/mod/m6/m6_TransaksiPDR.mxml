									ob.subdivisi = ''; ob.proyek = ''; ob.idpdrin = 0; ob.idpdrout = 0; ob.idpdr = 0; ob.idbarang = 0; ob.nilaisatuan = 0;
									ob.jmlbarang = Number(ob.jml)*Number(ob.nilaisatuan); ob.satuanbarang = 0; ob.matauang = ''; ob.kurs = o.txtkurs;
									ob.hpp = 0; ob.idhppkhususmasuk = 0; ob.idhppfifomasuk = 0; ob.rekpersediaan = ''; ob.cabang = ''; ob.lokasi = ''; ob.gudangasal = '';
									ob.gudangproduksi = ''; ob.gudangtujuan = ''; ob.urutan = 0; ob.idbomin = 0; ob.idbomout = 0; ob.jmlwo = 0; ob.statuswo = 0;
									ob.jmlmrs = 0; ob.statusmrs = 0; ob.jmlmrn = 0; ob.statusmrn = 0; ob.jmlpd = 0; ob.statuspd = 0; ob.isclose = 0; ob.customtext1 = '';
									ob.customtext2 = ''; ob.customtext3 = ''; ob.customdbl1 = 0; ob.customdbl2 = 0; ob.customdbl3 = 0; ob.customdate1 = parentApplication.m.DateFirst;
									ob.customdate2 = parentApplication.m.DateFirst; ob.customdate3 = parentApplication.m.DateFirst;
									break;
								case 'satuan':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.satuan = ''; break;
								case 'catatan':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.catatan = ''; break;
								case 'costcenter':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.costcenter = ''; break;
								case 'divisi':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.divisi = ''; break;
								case 'subdivisi':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.subdivisi = ''; break;
								case 'proyek':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.proyek = ''; break;
								case 'rekpersediaan':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.rekpersediaan = ''; break;
								case 'matauang':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.matauang = ''; break;
								case 'cabang':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.cabang = ''; break;
								case 'lokasi':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.lokasi = ''; break;
								case 'gudangasal':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.gudangasal = ''; break;
								case 'gudangproduksi':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.gudangproduksi = ''; break;
								case 'gudangtujuan':
									ob = dg.dataProvider[parentApplication.rowIndex]; ob.gudangtujuan = ''; break;
								case 'tampil':
								case 'tampilHistory':
								case 'SetBOM':
								case 'simpan':
									Alert.show(parentApplication.l(FlexGlobals.topLevelApplication.wsErrmessage), parentApplication.l('Informasi'));
									break;
							}
					}
					parentApplication.F_dgRefresh(dg1);
					parentApplication.F_dgRefresh(dg2);
				}
				
				public function f_kosongkanText(target:String):void
				{
					switch(target){
						case 'txtestimasi':parentApplication.F_KosongkanText([txtestimasi]);break;
						case 'txtdimintaoleh':parentApplication.F_KosongkanText([txtdimintaoleh, lbldimintaoleh]);break;
						case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
						case 'txtmintake':parentApplication.F_KosongkanText([txtmintake, lbldimintake]);break;
						case 'txtcatatan':parentApplication.F_KosongkanText([txtcatatan]);break;
					}
				}

				protected function f_simpan():void
				{
					var a:Array, utama:String, detailhasil:String, detailbahan:String, tgl:String, dbatch:String, dserial:String;
					n.dttanggal = dttanggal.text;
					parentApplication.vpFocusEvent = true;
					if(mb.menuBarItems[0].enabled == true){
						validasiForm();
						if(validasi == true){
							u.refresh(); 
							// Set Utama
							with(u.getItemAt(0)){
								a=[pdrid, pdrcabang, pdrlokasi, pdrgudangasal, pdrgudangproduksi, pdrgudangtujuan, pdrsumber, 
									txtjenisproduksi.text, int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), pdrkodepa, pdrdimintaoleh, txtkontakperson.text, 
									pdrmintake, parentApplication.F_tglFormatDB(dttanggaldibutuhkan.text), txtestimasi.text, pdrmatauang, o.txtkurs, n.vtotalhasil, n.vtotalbahan, 
									pdrtotalhppin, pdrtotalhppout, txturaian.text, txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), pdridbom, 
									pdrstatuswoin, pdrstatuswoout, pdrstatusmrsin, pdrstatusmrsout, pdrstatusmrnin, pdrstatusmrnout, pdrstatuspdin, 
									pdrstatuspdout, cmbprogress.selectedItem.v, pdrstatussebelumnya, pdrjmlrevisi, pdrcetakanke, pdrinputuser, parentApplication.F_tglFormatDB(pdrinputtgl), 
									pdrmodifikasiuser, parentApplication.F_tglFormatDB(pdrmodifikasitgl), pdrisclose, pdrcustomtext1, pdrcustomtext2, pdrcustomtext3, pdrcustomtext4, 
									pdrcustomtext5, pdrcustomint1, pdrcustomint2, pdrcustomint3, pdrcustomdbl1, pdrcustomdbl2, pdrcustomdbl3, 
									parentApplication.F_tglFormatDB(pdrcustomdate1), parentApplication.F_tglFormatDB(pdrcustomdate2), parentApplication.F_tglFormatDB(pdrcustomdate3)];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								
								// Set Detail 'hasil
								for(i=0;i<dg1.dataProviderLength;i++)
									with(dg1.dataProvider.getItemAt(i)){
										a = [idpdrin, idpdr, idbarang, namabarang, tipebarang, jml, satuan, 
											nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(kurs), harga, hpppersen, 
											hpp, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, gudangtujuan, 
											costcenter, divisi, subdivisi, proyek, catatan, (i+1), idbomin, 
											jmlwo, statuswo, jmlmrs, statusmrs, jmlmrn, statusmrn, jmlpd, 
											statuspd, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
											customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), 
											parentApplication.F_tglFormatDB(customdate3)];
										if(i == 0)detailhasil = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
										else detailhasil += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									}
								
								for(i=0;i<dg2.dataProviderLength;i++)
									with(dg2.dataProvider.getItemAt(i)){
										a = [idpdrout, idpdr, idbarang, namabarang, tipebarang, jml, satuan, 
											nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(kurs), harga, hpp, 
											idhppkhususmasuk, idhppfifomasuk, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, 
											gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, (i+1), 
											idbomout, jmlwo, statuswo, jmlmrs, statusmrs, jmlmrn, statusmrn, 
											jmlpd, statuspd, isclose, customtext1, customtext2, customtext3, customdbl1, 
											customdbl2, customdbl3, parentApplication.F_tglFormatDB(customdate1), 
											parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
										if(i == 0)detailbahan = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
										else detailbahan += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									}
								if(dg2.dataProvider.getItemAt(0).idbarang != 0){
									parentApplication.F_wsSimpan('simpan', "M6_PdrSimpan", parentApplication.userid, isUpdate, utama, detailhasil+"△"+detailbahan);
								}else{
									parentApplication.F_wsSimpan('simpan', "M6_PdrSimpan", parentApplication.userid, isUpdate, utama, detailhasil+"△");
								}
							}
						}
						
						function validasiForm():void
						{
							validasi = true;
							pesanAlert = '';
							FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
							FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg2);
							if(txtjenisproduksi.text.length == 0)parentApplication.msgAlert(txtjenisproduksi,'Jenis Produksi');
							if(dttanggal.text.length == 0)parentApplication.msgAlert(dttanggal,'Tanggal');
							if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
							if(dttanggaldibutuhkan.text.length == 0)parentApplication.msgAlert(dttanggaldibutuhkan,'Tanggal Dibutuhkan');
							if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)parentApplication.msgAlert(cmbprogress,'Progress');
							if(dg1.dataProvider.getItemAt(0).idpdrin == null)parentApplication.msgAlert(dg1,'Detail Item');
							if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');		
						}
					}
				}
				public function f_hitungTotalUtama():void
				{
					n.vtotalbahan=0;
					n.vtotalhasil=0;
					n.vtotalpersen=0;
					for(var j:int=0;j<dg1.dataProvider.length;j++){
						if(dg1.dataProvider.getItemAt(j).subtotal != undefined)n.vtotalhasil += Number(dg1.dataProvider.getItemAt(j).subtotal);n.vtotalpersen += Number(dg1.dataProvider.getItemAt(j).hpppersen);
					}
					for(var i:int=0;i<dg2.dataProvider.length;i++){
						if(dg2.dataProvider.getItemAt(i).subtotal != undefined)n.vtotalbahan += Number(dg2.dataProvider.getItemAt(i).subtotal);
					}
					lbltotalbahan.text = parentApplication.m.nfNominal.format(n.vtotalbahan);
					lbltotalhasil.text = parentApplication.m.nfNominal.format(n.vtotalhasil);
				}
				
				public function f_defaultGrid():void
				{
					parentApplication.rowIndex = 0;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
					dg1.setSelectedCell(0, 1);
					dg2.setSelectedCell(0, 1);
					f_focusOnMe();
				}
				
				public function f_hitungHasil():void
				{
					var ob:Object={};
					for(i=0; i<dg1.dataProviderLength; i++){
						ob = dg1.dataProvider.getItemAt(i);
						ob.harga = (Number(ob.hpppersen/100) * Number(n.vtotalbahan)) / Number(ob.jml);
						ob.subtotal = Number(ob.jml) * Number(ob.harga);
					}
					parentApplication.F_dgRefresh(dg1);
					f_hitungTotalUtama();
				}
				
