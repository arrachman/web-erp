				public function f_grid(dg:DataGrid, column:String):void
				{ 
					o.a = column.split('|');
					if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 3){
						if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
						else o.d = dg.dataProvider.getItemAt(o.a[1]);
						o.o.nilaisatuan = 0;
						if(dg.id == 'dg2'){
						o.o.idpdrout = 0; o.o.idpdr = 0; o.o.idbarang = 0; o.o.kodebarang = ''; o.o.tipebarang = ''; o.o.namabarang = ''; o.o.jml = 0; o.o.satuan = 0;
						o.o.hpppersen = 0; o.o.harga = 0; o.o.subtotal = 0; o.o.bomnotransaksi = ''; o.o.catatan = ''; o.o.costcenter = ''; o.o.divisi = '';
						o.o.subdivisi = ''; o.o.proyek = ''; o.o.idpdrin = 0; o.o.idpdrout = 0; o.o.idpdr = 0; o.o.idbarang = 0; o.o.nilaisatuan = 0; o.o.jmlbarang = 0;
						o.o.satuanbarang = 0; o.o.matauang = ''; o.o.kurs = 0; o.o.hpp = 0; o.o.idhppkhususmasuk = 0; o.o.idhppfifomasuk = 0; o.o.rekpersediaan = '';
						o.o.cabang = ''; o.o.lokasi = ''; o.o.gudangasal = ''; o.o.gudangproduksi = ''; o.o.gudangtujuan = ''; o.o.urutan = 0; o.o.idbomin = 0;
						o.o.idbomout = 0; o.o.jmlwo = 0; o.o.statuswo = 0; o.o.jmlmrs = 0; o.o.statusmrs = 0; o.o.jmlmrn = 0; o.o.statusmrn = 0; o.o.jmlpd = 0;
						o.o.statuspd = 0; o.o.isclose = 0; o.o.customtext1 = ''; o.o.customtext2 = ''; o.o.customtext3 = ''; o.o.customdbl1 = 0; o.o.customdbl2 = 0;
						o.o.customdbl3 = 0; o.o.customdate1 = parentApplication.m.DateFirst; o.o.customdate2 = parentApplication.m.DateFirst; o.o.customdate3 = parentApplication.m.DateFirst;
						}
						return
					}
					if(tab.selectedIndex ==0 ){dg = dg1}
					else if(tab.selectedIndex == 1){dg = dg2}
					if(column == 'add'){
					}else if(column == 'del'){
					}else{
						with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
							switch(column){
								case 'jml':
//									if(tab.selectedIndex == 0){ 
//										dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).harga = (Number(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hpppersen/100) * Number(n.vtotalbahan)) / Number(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).jml); 
//									}
									jmlbarang = Number(jml) * Number(nilaisatuan);break;
								case 'hpppersen':
									harga = (Number(hpppersen/100) * Number(n.vtotalbahan)) / Number(jml); break;
								case 'harga':
									vMsg = ''; vMsgIng = '';
									dgrid1 = dg1.dataProvider.getItemAt(dg.selectedCell.rowIndex);
									if(dgrid1.jml == 0 || dgrid1.hpppersen == 0){
										if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
										if(dgrid1.hpppersen == 0)msgAlert(dg, "Price [%]", "Harga [%]");
										if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
										dgrid1.jmldiskon = 0;
										dgrid1.diskon= 0;
									}else{
										hpppersen = ((Number(jml) * Number(harga)) / Number(n.vtotalbahan)) * 100; 
									}break;
								case 'subtotal':
									hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
									break;
							}
							subtotal = Number(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).jml) * Number(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).harga);
						}
					}
					f_hitungTotalUtama();
					f_hitungHasil();
					parentApplication.F_dgRefresh(dg);
				}
				
				public function f_filter(target:String):Array
				{
					var dg:DataGrid, paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
					if(dg1.selectedCell != null)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
					if(tab.selectedIndex < 3){
						if(tab.selectedIndex ==0 ){dg = dg1}
						else if(tab.selectedIndex == 1){dg = dg2}
					}
					switch(target){
						case 'txtjenisproduksi':
							paket = 'CdM1_Production_Category';
							wsfilter = 'pcaktif=1 AND pckode ="'+txtjenisproduksi.text.split('"').join('\\"')+'"';
							csfilter = 'pcaktif=1';
							sort = 'pckode asc';
							break;
//						case 'txtgudangasal':
//							paket = 'CdM1_Warehouse';
//							wsfilter = 'wkode ="'+txtgudangasal.text.split('"').join('\\"')+'"';
//							sort = 'wkode asc';
//							break;
//						case 'txtgudangproduksi':
//							paket = 'CdM1_Warehouse';
//							wsfilter = 'wkode ="'+txtgudangproduksi.text.split('"').join('\\"')+'"';
//							sort = 'wkode asc';
//							break;
//						case 'txtgudangtujuan':
//							paket = 'CdM1_Warehouse';
//							wsfilter = 'wkode ="'+txtgudangtujuan.text.split('"').join('\\"')+'"';
//							sort = 'wkode asc';
//							break;
						case 'txtestimasi':
							paket = 'CdM1_Working_Estimate';
							wsfilter = 'weaktif=1 AND wekode = "'+ txtestimasi.text.split('"').join('\\"') +'"';
							csfilter = 'weaktif=1';
							sort = 'wekode asc';
							break;
						case 'txtdimintaoleh':
							paket = 'CdM1_Contact';
							wsfilter = '(kaktif=1 AND kkategori="K") kkode ="'+txtdimintaoleh.text.split('"').join('\\"')+'"';
							csfilter = '(kaktif=1 AND kkategori="K")';
							csfield = 2;
							sort = 'kkode asc';
							break;
						case 'txtkontakperson':
							paket = 'CdM1_Contact_Attention';
							wsfilter = 'kaidkontak ='+u.getItemAt(0).pdrdimintaoleh+' AND kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
							csfilter = 'kaidkontak ='+u.getItemAt(0).pdrdimintaoleh+'';
							csfield = 2;
							sort = 'kakodekontak asc';
							break;
						case 'txtmintake':
