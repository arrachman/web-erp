				public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
				{
					switch (components){
						case 'checkBox':
							// jika fokus di centang HK
							if(dataField == 'hk'){
								if(data == true && dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).bhpp == 'I'){
									parentApplication.F_popUpCari('hk');
									
								}
								
							}
							break;
						case  'calculator':
							dg2.dataProvider[dg2.selectedCell.rowIndex][dataField] = data
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg2, dg2.selectedCell.rowIndex);
							switch (dataField){
								case 'jml':
								case 'harga':
									f_hitungTotal();
									break;
								case 'subtotal':
									hargaDariSubtotal.hitungHargaDariSubtotal(dg2, false);
									break;
							}
							break;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
					f_hitungTotal();
					
				}
				
				public function f_comPencarianBatal():void
				{
					if(parentApplication.subject == "hk"){
						dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).hk = false;
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg2, dg2.selectedCell.rowIndex);
					}
				}
				
				public function msgAlert(focus: Object, indonesia: String, inggris: String):void
				{		
					if(validasi == true)focus.setFocus();
					pesanAlertIng += inggris+', ';
					pesanAlert += indonesia+', ';
					if(focus == 'clear'){
						pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
						pesanAlert += " "+l("harus diisi dengan benar", 1);
						
						pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
						pesanAlertIng += " must be filled";
						Alert.show(pesanAlertIng+"  ("+pesanAlert+") !" , l("Infomrasi"));}	
					//\n
					validasi = false;						
				}
				
				public function f_filtersb():void{
					fserial = 's'; fbatch = 'b';
					for(i=0; i<dg2.dataProviderLength; i++){
						if(dg2.dataProvider[i].bserial ==	1){
							if(fserial == 's'){
								fserial = '(nsiidbarang = ' + dg2.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg2.dataProvider[i].gudangasal+'")';
							}else{
								fserial += ' or (nsiidbarang = ' + dg2.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg2.dataProvider[i].gudangasal+'")';
							}
						}
						
						if(dg2.dataProvider[i].bbatch ==	1){
							if(fbatch == 'b'){
								fbatch = '(nbiidbarang = ' + dg2.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg2.dataProvider[i].gudangasal+'")';
							}else{
								fbatch += ' or (nbiidbarang = ' + dg2.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg2.dataProvider[i].gudangasal+'")';
							}
						}
					}
				}
				
