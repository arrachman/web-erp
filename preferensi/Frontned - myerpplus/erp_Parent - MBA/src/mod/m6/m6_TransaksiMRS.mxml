				//Persiapan awal ketika module di load
				protected function f_persiapan():void
				{
					p = parentApplication;
					p.F_tabvalidatenow(tab);
					p.F_DateFieldStandard([dttgl,dttanggalnoref,dttgldibutuhkan]);
					FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress])
					p.F_TextInputNumberDesimalMode([txtkurs]);
					p.F_txtPencarianKhusus([txtkontakperson,txtcatatan]);
					p.F_txtpencarian([txtjenis,txtmatauang,txtbagpengeluaran,txtgudangasal,txtgudangproduksi,txtestimasi, txtnowo, txtaktivitas]);
					p.F_SetNavigasiKeyboard([txtnotransaksi,txtkurs,txturaian,txtnoref]);
					tab.tabFocusEnabled = false;
					
					//setting editable tanggal
					if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
					else dttgl.enabled = false;
					FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
					
					//set default
					vUang = p.getSetting(0, 'accounting', 'MataUangFungsional');//Ambil dari m0_setting 'kode currency'
					vKurs= p.getSetting(0, 'accounting', 'Kurs');//Ambil dari m0_setting 'kurs currency'
					txtgudangproduksi.text=p.ugudang;
					
					arrMenuBar = new ArrayCollection([
						{label:"Simpan", icon:"tbsave", enabled:"true"},
						{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
						{label:"Reset", icon:"tbreset", enabled:"true"},
						{label:"No.Serial/Batch Out", icon:"tbserialout", enabled:"true"},
						{label:"Catatan", icon:"tbnote", enabled:"false"},
						{label:"File", icon:"tbattachment", enabled:"false"},
						{label:"Links", icon:"tblink", enabled:"false"},
						{label:"History", icon:"tbhistory", enabled:"true"},
						{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
					FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
					
					mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
					mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
					mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
					mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbSerial);
					mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
					mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
					mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLinks);
					function f_mbSimpan():void
					{
						if(mb.menuBarItems[0].enabled == true){
							f_simpan(); 
						}
					}
					function f_mbBuka():void
					{
						FlexGlobals.topLevelApplication.f_bukaTransaksi("Mrs");
					}
					function f_mbSerial():void{
						if(mb.menuBarItems[3].enabled==true){
							o.ceks = true; o.cekb = true;
							o.sumber = 'MRS';
							o.moduleid = 6;
							o.mnid = 6;
							o.idgrid = dg2.id;
							o.gudang = txtgudangasal.text;
							f_filtersb();
							o.aserial = acserialdetail;
							o.abatch = acbatchdetail;
							FlexGlobals.topLevelApplication.openFormX("No. Serial/Batch",1,'mod/m0/m0_SerialOut.swf',426,602,'t1');
						}
					}
					function f_mbReset():void{
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
						acserialdetail.removeAll();
						acbatchdetail.removeAll();
						f_kondisiAwal(); 
						mb.menuBarItems[4].enabled=false;
						mb.menuBarItems[5].enabled=false;
						mb.menuBarItems[6].enabled=false;
					}
					
					function f_mbCatatan():void{
						if (mb.menuBarItems[4].enabled==true){parentApplication.F_OpenNotes(o.mrssumber,o.mrsid,txtnotransaksi.text);}
					}
					function f_mbUpload():void {
						if(mb.menuBarItems[5].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('MRS', o.mrsid,txtnotransaksi.text);
					}
					function f_mbLinks():void
					{
						if(mb.menuBarItems[6].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(6,'Mrs');
					}
					this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
					function f_KEY_DOWN(e:KeyboardEvent):void
					{
						switch(e.keyCode){
							case Keyboard.S:if(e.ctrlKey)f_simpan();break;
						}
					}
					//untuk ambil setting dari Json
					FlexGlobals.topLevelApplication.F_RegGrid(6,6,[dg2],'TransaksiBarang');
					f_validasi();
				}
				public function f_validasi():void{
					//set getdata by id===============================================================================================
					var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
					var idtransaksi : String = filtersplit[0];
					if(FlexGlobals.topLevelApplication.FormFilter == ''){
						//input
						f_kondisiAwal();
					}else{
						if(filtersplit.length > 1){
							//history
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M6_MrsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else {
							//edit
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M6_MrsGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
					//end of set getdata by id===============================================================================================
					
				}
				//kondisi pertama kali modul di load
