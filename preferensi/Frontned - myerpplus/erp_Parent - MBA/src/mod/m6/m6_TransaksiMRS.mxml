					function f_splitArrayToString(a:Array):String
					{
						var s:String, j:int;
						for(j=0;j<a.length;j++){
							if(j==0)s = a[j];
							else s += "▼"+a[j];
						}
						return s;
					}
				}
				
				public function f_hitungTotal():void
				{
					
					o.mrstotalhargaout=0; o.mrstotalhppout = 0;
					for(var ih:int=0;ih<dg2.dataProviderLength;ih++){
						dg2.dataProvider.getItemAt(ih).subtotal= Number(dg2.dataProvider.getItemAt(ih).jml * dg2.dataProvider.getItemAt(ih).harga);
						o.mrstotalhargaout += Number(dg2.dataProvider.getItemAt(ih).subtotal);
						o.mrstotalhppout +=Number(dg2.dataProvider.getItemAt(ih).hpp);
					}
					
					lbltotalbahan.text = parentApplication.m.nfNominal.format(o.mrstotalhargaout);
