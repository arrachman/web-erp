					mb.menuBarItems[7].visible=false;
					mb.menuBarItems[8].visible=false;
					isUpdate = false;
					cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
					cmbprogress.selectedIndex = 1;
					txturaian.text= p.getNomor('MRS');//ambil dari m0_nomor
					txtcatatan.text= p.getNomor('MRS',1);
					txtmatauang.text = vUang;
					o.txtkurs = vKurs;
					txtkurs.text = parentApplication.m.nfNominal.format(o.txtkurs);
					o.idpa = 0;
					f_focusOnMe();
					txtgudangasal.text = FlexGlobals.topLevelApplication.ugudang;
					lblgasal.text = FlexGlobals.topLevelApplication.ugudangnama;
					txtgudangproduksi.text = FlexGlobals.topLevelApplication.getSetting(3,'defaultgudang','GudangProduksi');
					lblgprod.text = FlexGlobals.topLevelApplication.getSetting(3,'defaultgudang','GudangProduksiNama');
//					txtnotransaksi.text = 'Auto';		
					
					txtbagpengeluaran.text = FlexGlobals.topLevelApplication.ukontakkode;
					lblbagianpengeluaran.text = FlexGlobals.topLevelApplication.ukontaknama;
					p.F_SetNilaiText([dttgl,dttanggalnoref,dttgldibutuhkan], p.DefaultTanggal);
					FlexGlobals.topLevelApplication.F_KosongkanText([txtjenis, lbljenis,txtestimasi, txtkontakperson, txtnoref, txtnowo, txtaktivitas, lblaktivitas]);
					FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotalbahan],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
					txtbagpengeluaran.text = FlexGlobals.topLevelApplication.ukontakkode;
					lblbagianpengeluaran.text = FlexGlobals.topLevelApplication.ukontaknama;
					//Set Nilai Mapping
						o.mrsid = 0; o.mrscabang = FlexGlobals.topLevelApplication.ucabang; o.mrslokasi = FlexGlobals.topLevelApplication.ulokasi; 
						o.mrssumber = "MRS"; 
						o.mrskodepa = 0; o.mrsbagianmrs = FlexGlobals.topLevelApplication.ukontak;
						o.mrstotalhargain = 0; o.mrstotalhargaout = 0; o.mrstotalhppin = 0; 
						o.mrstotalhppout = 0; o.mrsidbom = 0; o.mrsidpdr = 0; o.mrsidwo = 0; o.mrsstatusmrnin = 0; o.mrsstatusmrnout = 0; 
						o.mrsstatuspdin = 0; o.mrsstatuspdout = 0; o.mrsstatus = 0; o.mrsstatussebelumnya = 0; 
						o.mrsjmlrevisi = 0; o.mrscetakanke = 0; o.mrsinputuser = FlexGlobals.topLevelApplication.userid; 
						o.mrsinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.mrsmodifikasiuser = 0;
						o.mrsmodifikasitgl = FlexGlobals.topLevelApplication.m.DateFirst; o.mrsisclose = 0; o.mrscustomtext1 = ''; 
						o.mrscustomtext2 = ''; o.mrscustomtext3 = ''; o.mrscustomtext4 = ''; o.mrscustomtext5 = ''; o.mrscustomint1 = 0; o.mrscustomint2 = 0; 
						o.mrscustomint3 = 0; o.mrscustomdbl1 = 0; o.mrscustomdbl2 = 0; o.mrscustomdbl3 = 0; 
						o.mrscustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
						o.mrscustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
						o.mrscustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst; o.mrsaktivitas = 0;
					
					//--------------------------------------------------------------------------------------------------
						for(i=0; i<dg2.dataProviderLength; i++){
							dg2.dataProvider.getItemAt(i).kodebarang=''; 
						}
						settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
						//--------------------------------------------------------------------------------------------------
				}
				
				//operasi grid
				public function f_grid(dg:DataGrid, column:String):void
				{
					//--------------------------------------------------------------------------------------------------//
					var i:int, n:Number, a:Array, dgrid1:Object;
					switch(column){ 
						case 'add':
							return;
							break;
						case 'del':
						case 'jml':
						case 'harga':
							dgrid1 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
							dgrid1.subtotal = dgrid1.harga * dgrid1.jml;
							dgrid1.jmlbarang = dgrid1.jml * dgrid1.nilaisatuan;
							break;
						case 'pre_del':
							hapusserial();
							hapusbatch();
							break;
						case 'subtotal':
							hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
							break;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
					f_hitungTotal();
					//--------------------------------------------------------------------------------------------------
				}
				
				//hapus serial jika barangnya tidak ada
				public function hapusserial():void{
					var s:int;
					if(acserialdetail.length > 0){
						for(s=acserialdetail.length-1; s>=0; s--){
							if(acserialdetail[s].nstidbarang == dg2.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
								acserialdetail.removeItemAt(s);
							}
						}
					}
				}
				
				public function hapusbatch():void{
					var b:int;
					if(acbatchdetail.length > 0){
						for(b=acbatchdetail.length-1; b>=0; b--){
							if(acbatchdetail[b].nbtidbarang == dg2.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
								acbatchdetail.removeItemAt(b);
							}
						}
					}
				}
				
				public function f_filter(target:String):Array
				{
					var paket:String='',dgrid: Object, wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
					try{
						dgrid = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex)
					} 
					catch(error:Error){}
					switch(target){
						case "txtnowo": 
							pesanAlert = ''; pesanAlertIng = '';
							if(txtjenis.text != ''){
								if(o.pcwajibwo == 1){
									paket = "CdM6_Wo";
									wsfilter = '(wostatus = 2 or wostatus = 3) and wojenis = "'+txtjenis.text+'" and wostatusrealisasiout <>2 and wonotransaksi = "'+txtnowo.text+'"';
									csfilter = '(wostatus = 2 or wostatus = 3) and wojenis = "'+txtjenis.text+'" and wostatusrealisasiout <>2';
									sort = "wonotransaksi desc";
								}
								else if(o.pcwajibwo == 2){
									paket = "CdM6_Wo";
									wsfilter = '(wostatus = 2 or wostatus = 3) and wojenis = "'+txtjenis.text+'" and wonotransaksi = "'+txtnowo.text+'"';
									csfilter = '(wostatus = 2 or wostatus = 3) and wojenis = "'+txtjenis.text+'"';
									sort = "wonotransaksi desc";
								}
							}else{
								if(txtjenis.text == '')FlexGlobals.topLevelApplication.msgAlert(txtjenis, 'Jenis Produksi');
								if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');	
							}
						
							//checkbox = true;c
							break;
						case "txtjenis":
							paket = "CdM1_Production_Category";
							wsfilter = 'pcaktif=1 AND (pcwajibwo = 1 OR pcwajibwo = 2) and pckode ="'+txtjenis.text+'"';
							csfilter = 'pcaktif=1 AND (pcwajibwo = 1 OR pcwajibwo = 2)'
							sort = 'pckode asc';
							break;
						case "txtaktivitas":
							paket = "CdM1_Production_Activity";
							wsfilter = 'paaktif = 1 AND and pakode ="'+txtaktivitas.text+'"';
							csfilter = 'paaktif = 1';
							sort = 'pakode asc';
							break;
						case "txtestimasi":
							paket = "CdM1_Working_Estimate";
							wsfilter = 'weaktif=1 AND wekode ="'+txtestimasi.text+'"';
							csfilter = 'weaktif=1';
							sort = 'wekode asc';
							break;
						case "txtgudangasal":
							paket = "CdM1_Warehouse";
							wsfilter = 'waktif=1 AND wkode ="'+txtgudangasal.text+'"';
							csfilter = 'waktif=1';
							sort = 'wkode asc';
							break;
						case "txtgudangproduksi":
							paket = "CdM1_Warehouse";
							wsfilter = 'waktif=1 AND wkode ="'+txtgudangproduksi.text+'"';
							csfilter = 'waktif=1';
							sort = 'wkode asc';
							break;
						case "hk":
							paket = "CdM1_Cogs_Special_In";
							csfilter ='isclose = 0 AND idbarang ='+dgrid.idbarang+' and sisa > 0';
							wsfilter = "isclose = 0";
							break;
						case "txtkontakperson":
							paket = "CdM1_Contact_Attention";
							wsfilter = 'kaidkontak ="'+o.mrsbagianmrs+'" AND kakodekontak ="'+txtkontakperson.text+'"';
							csfilter = 'kaidkontak ="'+o.mrsbagianmrs+ '"';
							sort = "kakodekontak asc";
							break;
						case "txtmatauang":
							paket = "CdM1_Currency";
							wsfilter = 'caktif=1 AND ckode = "'+ txtmatauang.text +'"';
							csfilter = 'caktif=1';
							sort = 'ckode asc';
							break;
						case "txtcatatan":
							paket = "CdM1_Transaction_Note";
							csfilter = 'tnaktif=1 AND tnsumber = "MRS"';
							break;
						case "txtbagpengeluaran":
							paket = "CdM1_Contact";
							wsfilter = '(kaktif=1 AND kkategori="K") AND kkode ="'+txtbagpengeluaran.text+'"';
							csfilter = '(kaktif=1 AND kkategori="K")';
							csfield = 4;
							sort = 'kkode asc';
							break;
						case 'kodebarang':
							paket = 'CdM1_Item';
							wsfilter = '(baktif=1 AND bassembly <> 1 AND bhpp="'+FlexGlobals.topLevelApplication.getSetting(0,'company','HppGlobal')+'" or bhpp = "I") and bkode = "'+dgrid.kodebarang+'"';
							wsfilter = '(baktif=1 AND bassembly <> 1 AND bhpp="'+FlexGlobals.topLevelApplication.getSetting(0,'company','HppGlobal')+'" or bhpp = "I")';
							sort = "bkode asc";
							break;
						case "satuan":
							paket = "CdM1_Unit";
							wsfilter = 'uaktif=1 AND ukode = "'+dgrid.satuan+'"';
							csfilter = 'uaktif=1';
							sort = 'ukode asc';
							break;
						case "pajak1":
							paket = "CdM1_Tax";
							wsfilter = 'taktif=1 AND tkode = "'+ dgrid.pajak1 +'"';
							csfilter = 'taktif=1';
							sort = 'pckode asc';
							break;
						case "pajak2":
							paket = "CdM1_Tax";
							wsfilter = 'taktif=1 AND tkode = "'+ dgrid.pajak2 +'"';
							csfilter = 'taktif=1';
							break;
						case 'catatan':
							paket = 'CdM1_Transaction_Note_Detail';
							csfilter = 'tndaktif=1 AND tndsumber = "MRS"';
							sort = 'tndkode asc';
							break;
						case "gudangasal":
							paket = "CdM1_Warehouse";
							wsfilter = 'waktif=1 AND wkode = "'+ dgrid.gudangasal +'"';
							csfilter = 'waktif=1';
							sort = "wkode asc";
							break;
						case "gudangproduksi":
							paket = "CdM1_Warehouse";
							wsfilter = 'waktif=1 AND wkode = "'+ dgrid.gudangproduksi +'"';
							csfilter = 'waktif=1';
