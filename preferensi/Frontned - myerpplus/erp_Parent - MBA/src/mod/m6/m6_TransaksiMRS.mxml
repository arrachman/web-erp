							if(dg2.dataProvider.getItemAt(i).jml < 1)FlexGlobals.topLevelApplication.msgAlert(dg2,'Jumlah');
							if(dg2.dataProvider.getItemAt(i).satuan== '')FlexGlobals.topLevelApplication.msgAlert(dg2,'Satuan');
						}
						
						if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert','');
						
						
					
						f_hitungTotal();
						
