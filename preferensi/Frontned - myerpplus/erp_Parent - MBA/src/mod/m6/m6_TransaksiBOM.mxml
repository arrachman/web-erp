						public function f_grid(dg:DataGrid, column:String):void
						{ 
							o.a = column.split('|');
							if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 2){
								if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
								else o.d = dg.dataProvider.getItemAt(o.a[1]);
								o.o.nilaisatuan = 0;
								return
							}
							if(column == 'add'){
							}else if(column == 'del'){
							}else{
								with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
									switch(column){
										case 'jml':
											jmlbarang = Number(jml) * Number(nilaisatuan);break;
										case 'hpppersen':
											harga = (Number(hpppersen/100) * Number(n.vtotalbahan)) / Number(jml); break;
										case 'harga':
											hpppersen = ((Number(jml) * Number(harga)) / Number(n.vtotalbahan)) * 100; break;
										case 'subtotal':
											hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
											break;
									}
									subtotal = Number(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).jml) * Number(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).harga);
								}
							}
							f_hitungTotalUtama();
							parentApplication.F_dgRefresh(dg);
						}
				
				public function f_filter(target:String):Array
				{
					var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
					switch(target){
						case 'txtjenisproduksi':
							paket = 'CdM1_Production_Category';
							wsfilter = 'pcaktif=1 AND pckode ="'+txtjenisproduksi.text.split('"').join('\\"')+'"';
							csfilter = 'pcaktif=1';
							sort = 'pckode asc';
							break;
						case 'txtkodebarang':
							paket = 'CdM1_Item';
							wsfilter = '(baktif = 1 AND bassembly <> 1) AND (bhpp = "'+hppGlobal+'" OR bhpp = "I") AND bkode ="'+txtkodebarang.text.split('"').join('\\"')+'"';
							csfilter = '(baktif = 1 AND bassembly <> 1) AND (bhpp = "'+hppGlobal+'" OR bhpp = "I")';
							sort = 'bkode asc';
							break;
						case 'txtsatuanbarang':
							paket = 'CdM1_Unit';
							wsfilter = 'uaktif=1 AND ukode ="'+txtsatuanbarang.text.split('"').join('\\"')+'"';
							csfilter = 'uaktif=1';
							sort = 'ukode asc';
							break;
						case 'txtestimasi':
							paket = 'CdM1_Working_Estimate';
							wsfilter = 'weaktif=1 AND wekode ="'+ txtestimasi.text.split('"').join('\\"') +'"';
							csfilter = 'weaktif=1';
							sort = 'wekode asc';
							break;
						case 'txtpembuatformula':
							paket = 'CdM1_Contact';
							wsfilter = '(kaktif=1 AND kkategori="K") AND kkode ="'+txtpembuatformula.text.split('"').join('\\"')+'"';
							csfilter = '(kaktif=1 AND kkategori="K")';
							csfield = 2;
							sort = 'kkode asc';
							break;
						case 'txtkontakperson':
							paket = 'CdM1_Contact_Attention';
							wsfilter = 'kaidkontak ='+u.getItemAt(0).bompembuat+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
							csfilter = 'kaidkontak ='+u.getItemAt(0).bompembuat+'';
							csfield = 2;
							sort = 'kakodekontak asc';
							break;
						case 'txtcatatan':
							paket = 'CdM1_Transaction_Note';
							csfilter = 'tnaktif=1 AND tnsumber = "BOM"';
							sort = 'tnkode asc';
							break;
						case 'kodebarang':
							paket = 'CdM1_Item';
							wsfilter = '(baktif = 1 AND bassembly <> 1) AND (bhpp = "'+hppGlobal+'" OR bhpp = "I") AND bkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kodebarang.split('"').join('\\"')+'"';
							csfilter = '(baktif = 1 AND bassembly <> 1) AND (bhpp = "'+hppGlobal+'" OR bhpp = "I")';
							sort = 'bkode asc';
							break;
						case 'satuan':
							paket = 'CdM1_Unit';
							wsfilter = 'uaktif=1 AND ukode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).satuan.split('"').join('\\"')+'"';
							csfilter = 'uaktif=1';
							sort = 'ukode asc';
							break;
						case 'catatan':
							paket = 'CdM1_Transaction_Note_Detail';
							csfilter = 'tndaktif=1 AND tndsumber = "BOM"';
							sort = 'tndkode asc';
							break;
						case 'costcenter':
							paket = 'CdM1_Cost_Center';
							wsfilter = 'ccaktif=1 AND cckode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).costcenter.split('"').join('\\"')+'"';
							csfilter = 'ccaktif=1';
							sort = 'cckode asc';
							break;
						case 'divisi':
							paket = 'CdM1_Division';
							wsfilter = 'daktif=1 AND dkode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).divisi.split('"').join('\\"')+'"';
							csfilter = 'daktif=1';
							sort = 'dkode asc';
							break;
						case 'subdivisi':
							paket = 'CdM1_Subdivision';
							wsfilter = 'sdaktif=1 AND sddivisi = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).divisi.split('"').join('\\"')+'" AND sdkode = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).subdivisi.split('"').join('\\"')+'"';
							csfilter = 'sdaktif=1 AND sddivisi = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).divisi.split('"').join('\\"')+'"';
							sort = 'sdkode asc';
							break;
						case 'proyek':
							paket = 'CdM1_Project';
							wsfilter = 'paktif=1 AND pkode = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).proyek.split('"').join('\\"')+'"';
							csfilter = 'paktif=1';
							sort = 'pkode asc';
							break;
						case 'rekpersediaan':
							paket = 'CdM1_Coa';
							wsfilter = 'caktif=1 AND cgd = "D" AND cnomor ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).rekpersediaan.split('"').join('\\"')+'"';
							csfilter = 'caktif=1 AND cgd = "D"';
							csfield = 2;
							sort = 'cnomor asc';
							break;
						case 'matauang':
							paket = 'CdM1_Currency';
							wsfilter = 'caktif=1 AND ckode = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).matauang.split('"').join('\\"')+'"';
							csfilter = 'caktif=1';
							sort = 'ckode asc';
							break;
						case 'cabang':
							paket = 'CdM1_Branch';
							wsfilter = 'baktif=1 AND bkode = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).cabang.split('"').join('\\"')+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
							break;
						case 'lokasi':
							paket = 'CdM1_Location';
							wsfilter = 'laktif=1 AND lkode = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).lokasi.split('"').join('\\"')+'"';
							csfilter = 'laktif=1';
							sort = 'lkode asc';
