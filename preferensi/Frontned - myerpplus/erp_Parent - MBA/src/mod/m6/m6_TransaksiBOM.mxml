					u = new ArrayCollection([{
						bomid:0, bomcabang:parentApplication.ucabang, bomlokasi:parentApplication.ulokasi, bomgudangasal:parentApplication.ugudang, bomgudangproduksi:parentApplication.getSetting(3, 'defaultgudang', 'GudangProduksi'), bomgudangtujuan:parentApplication.ugudang, bomsumber:'BOM', 
						bomjenis:txtjenisproduksi.text, bomautonotransaksi:int(chkauto.selected), bomnotransaksi:txtnotransaksi.text, bomtgl:dttanggal.text, bomkodepa:0, bompembuat:parentApplication.ukontak, bompembuatkontak:txtkontakperson.text, 
