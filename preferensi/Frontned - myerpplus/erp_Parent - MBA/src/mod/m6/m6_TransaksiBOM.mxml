											costcenter:costcenter, divisi:divisi, subdivisi:subdivisi, proyek:proyek, catatan:catatan, urutan:urutan, customtext1:customtext1, 
											customtext2:customtext2, customtext3:customtext3, customdbl1:customdbl1, customdbl2:customdbl2, customdbl3:customdbl3, customdate1:customdate1, customdate2:customdate2, 
											customdate3:customdate3}]);
									}
								}
								parentApplication.wsArrDetail = parentApplication.f_SplitData(parentApplication.vNamaKolom[2], parentApplication.vData[2]);
								for(i=0;i<parentApplication.wsArrDetail.length;i++){
									if(i==0)dg2.dataProvider.removeAll();
									obj = parentApplication.wsArrDetail.getItemAt(i);
									dg2.dataProvider.addItem({
										no : dg2.dataProviderLength+1, kodebarang : obj.kodebarang, tipebarang : obj.tipebarang, namabarang : obj.namabarang, jml : obj.jml,
										satuan : obj.satuan, hpppersen : obj.hpppersen, harga : obj.harga, subtotal : Number(obj.jml) * Number(obj.harga),
										catatan : obj.catatan, costcenter : obj.costcenter, divisi : obj.divisi, subdivisi : obj.subdivisi, proyek : obj.proyek,
										idbomout : obj.idbomout, idbom : obj.idbom, idbarang : obj.idbarang, nilaisatuan : obj.nilaisatuan, jmlbarang : obj.jmlbarang,
										satuanbarang : obj.satuanbarang, matauang : obj.matauang, kurs : obj.kurs, hpp : obj.hpp, idhppkhususmasuk : 0,
										idhppfifomasuk : 0, rekpersediaan : obj.rekpersediaan, cabang : obj.cabang, lokasi : obj.lokasi, gudangasal : obj.gudangasal,
										gudangproduksi : obj.gudangproduksi, gudangtujuan : obj.gudangtujuan, customtext1 : obj.customtext1, customtext2 : obj.customtext2,
										customtext3 : obj.customtext3, customdbl1 : obj.customdbl1, customdbl2 : obj.customdbl2, customdbl3 : obj.customdbl3,
										customdate1 : obj.customdate1, customdate2 : obj.customdate2, customdate3 : obj.customdate3
									});
								}
								dg2.setSelectedCell(0, 1);
								f_hitungTotalUtama();
								break;
							case 'simpan':
								FlexGlobals.topLevelApplication.FormFilter = '';
								f_kondisiAwal();
								f_defaultGrid();
								FlexGlobals.topLevelApplication.F_alertCetak(6, 3, 'BOM', parentApplication.wsIdtransaksi, parentApplication.wsErrmessage, n.dttanggal+" s.d "+n.dttanggal);
//								Alert.show("Print transaction (Cetak transaksi) : "+parentApplication.wsErrmessage+" ?", 'Confirmation', 3, null, function(e:Object):void{	
//									if(e.detail == Alert.YES)
//										FlexGlobals.topLevelApplication.F_wsDelete('print','M6_Print',parentApplication.userid, 'BOM'+parentApplication.sptField+parentApplication.wsIdtransaksi+parentApplication.sptField+parentApplication.wsErrmessage);
//								});
								break;
							case 'print':
								FlexGlobals.topLevelApplication.F_openReportDefault(6,3,"bomid = "+FlexGlobals.topLevelApplication.wsIdtransaksi+"");
								break;
						}
					}else{					
						if(parentApplication.F_validasiFalse(s) == true)
							ob = dg2.dataProvider[parentApplication.rowIndex];
							switch(s){
								// 9.2.1 Result untuk WS False apa saja
								case 'kodebarang': ob.kodebarang = ''; ob.kodebarang = ''; ob.tipebarang = ''; ob.namabarang = ''; ob.jml = 0; ob.satuan = '';
									ob.hpppersen = 0; ob.harga = 0; ob.subtotal = Number(ob.jml) * Number(ob.harga); ob.catatan = ''; ob.costcenter = ''; ob.divisi = '';
									ob.subdivisi = ''; ob.proyek = ''; ob.idbomin = 0; ob.idbomout = 0; ob.idbom = 0; ob.idbarang = 0; ob.nilaisatuan = 0;
									ob.jmlbarang = Number(ob.jml)*Number(ob.nilaisatuan); ob.satuanbarang = ''; ob.matauang = ''; ob.kurs = 0; ob.hpp = 0;
									ob.idhppkhususmasuk = 0; ob.idhppfifomasuk = 0; ob.rekpersediaan = ''; ob.cabang = ''; ob.lokasi = ''; ob.gudangasal = '';
									ob.gudangproduksi = ''; ob.gudangtujuan = ''; ob.customtext1 = ''; ob.customtext2 = ''; ob.customtext3 = ''; ob.customdbl1 = 0;
									ob.customdbl2 = 0; ob.customdbl3 = 0; ob.customdate1 = parentApplication.m.DateFirst; ob.customdate2 = parentApplication.m.DateFirst;
									ob.customdate3 = parentApplication.m.DateFirst;
									break;
								case 'satuan': ob.satuan = ''; break;
								case 'catatan': ob.catatan = ''; break;
								case 'costcenter': ob.costcenter = ''; break;
								case 'divisi': ob.divisi = ''; break;
								case 'subdivisi': ob.subdivisi = ''; break;
								case 'proyek': ob.proyek = ''; break;
								case 'rekpersediaan': ob.rekpersediaan = ''; break;
								case 'matauang': ob.matauang = ''; break;
								case 'cabang': ob.cabang = ''; break;
								case 'lokasi': ob.lokasi = ''; break;
								case 'gudangasal': ob.gudangasal = ''; break;
								case 'gudangproduksi': ob.gudangproduksi = ''; break;
								case 'gudangtujuan': ob.gudangtujuan = ''; break;
								case 'tampil':
								case 'tampilHistory':
								case 'simpan':
									Alert.show(parentApplication.l(parentApplication.wsErrmessage), parentApplication.l('Informasi'));
									break;
							}
					}
					parentApplication.F_dgRefresh(dg2);
				}
				
				public function f_kosongkanText(target:String):void
				{
					switch(target){
						case 'txtkodebarang':parentApplication.F_KosongkanText([txtkodebarang, lblkodebarang]);break;
						case 'txtsatuanbarang':parentApplication.F_KosongkanText([txtsatuanbarang]);break;
						case 'txtestimasi':parentApplication.F_KosongkanText([txtestimasi]);break;
						case 'txtpembuatformula':parentApplication.F_KosongkanText([txtpembuatformula, lblpfor]);break;
						case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson, lblkontakper]);break;
						case 'txtcatatan':parentApplication.F_KosongkanText([txtcatatan]);break;
						case "txtlokasi":parentApplication.F_KosongkanText([txtlokasi]);break;
					}
				}
				
				protected function f_simpan():void
				{
					var a:Array, utama:String, detailhasil:String, detailbahan:String, tgl:String, dbatch:String, dserial:String;
					n.dttanggal = dttanggal.text;
					parentApplication.vpFocusEvent = true;
					if(mb.menuBarItems[0].enabled == true){
						validasiForm();
						if(validasi == true){
							u.refresh(); 
							// Set Utama
							with(u.getItemAt(0))
								a=[bomid, bomcabang, txtlokasi.text, bomgudangasal, bomgudangproduksi, bomgudangtujuan, 'BOM', 
									txtjenisproduksi.text, int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), bomkodepa, bompembuat, txtkontakperson.text, 
									txtestimasi.text, bommatauang, o.txtkurs, n.vtotalhasil, n.vtotalbahan, bomtotalhppin, bomtotalhppout, 
									txturaian.text, txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), cmbprogress.selectedItem.v, bomstatussebelumnya, bomjmlrevisi, 
									bomcetakanke, bominputuser, parentApplication.F_tglFormatDB(bominputtgl), bommodifikasiuser, parentApplication.F_tglFormatDB(bommodifikasitgl), bomcustomtext1, bomcustomtext2, 
									bomcustomtext3, bomcustomtext4, bomcustomtext5, bomcustomint1, bomcustomint2, bomcustomint3, bomcustomdbl1, 
									bomcustomdbl2, bomcustomdbl3, parentApplication.F_tglFormatDB(bomcustomdate1), parentApplication.F_tglFormatDB(bomcustomdate2), parentApplication.F_tglFormatDB(bomcustomdate3)];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							// Set Detail 'hasil
							with(hasil.getItemAt(0)){
								a = [idbomin, idbom, idbarang, lblkodebarang.text, tipebarang, o.txtjmlbarang, txtsatuanbarang.text, 
									nilaisatuan, parentApplication.F_hapusFormatCurrency(jmlbarang), satuanbarang, matauang, kurs, o.txthargabarang, hpppersen, 
									hpp, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, gudangtujuan, 
									costcenter, divisi, subdivisi, proyek, catatan, urutan, customtext1, 
									customtext2, customtext3, customdbl1, customdbl2, customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), 
									parentApplication.F_tglFormatDB(customdate3)];
							detailhasil = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
							
							for(i=0;i<dg2.dataProviderLength;i++)
								with(dg2.dataProvider.getItemAt(i)){
									a = [idbomout, idbom, idbarang, namabarang, tipebarang, jml, satuan, 
										nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(kurs), harga, hpp, 
										idhppkhususmasuk, idhppfifomasuk, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, 
										gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, (i+1), 
										customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, parentApplication.F_tglFormatDB(customdate1), 
										parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detailbahan = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detailbahan += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							parentApplication.F_wsSimpan('simpan', "M6_BomSimpan", parentApplication.userid, isUpdate, utama, detailhasil+"△"+detailbahan);
						}
					}
					
					function validasiForm():void
					{
						validasi = true;
						pesanAlert = '';
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg2);
						if(txtlokasi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtlokasi,'Lokasi');
						if(txtjenisproduksi.text.length == 0)parentApplication.msgAlert(txtjenisproduksi,'Jenis Produksi');
						if(txtkodebarang.text.length == 0)parentApplication.msgAlert(txtkodebarang,'Barang Jadi');
						if(txtjmlbarang.text.length == 0)parentApplication.msgAlert(txtjmlbarang,'Jml Jadi');
						if(txtsatuanbarang.text.length == 0)parentApplication.msgAlert(txtsatuanbarang,'Satuan');
						if(txthargabarang.text.length == 0)parentApplication.msgAlert(txthargabarang,'Harga');
						if(dttanggal.text.length == 0)parentApplication.msgAlert(dttanggal,'Tanggal');
						if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'Notransaksi');
						if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)parentApplication.msgAlert(cmbprogress,'Progress');
						if(dg2.dataProvider.getItemAt(0).idbomout == null)parentApplication.msgAlert(dg2,'Detail Item');
						if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
					}
				}
				
				public function f_hitungTotalUtama():void
				{
					n.vtotalbahan=0;
					n.vtotalhasil=0;

					for(var i:int=0;i<dg2.dataProvider.length;i++){
						if(dg2.dataProvider.getItemAt(i).subtotal != undefined)n.vtotalbahan += Number(dg2.dataProvider.getItemAt(i).subtotal);
					}
					
					o.txthargabarang = (Number(hasil.getItemAt(0).hpppersen/100) * Number(n.vtotalbahan)) / o.txtjmlbarang;
					txthargabarang.text = parentApplication.m['nfNominal' + o.sumber].format(o.txthargabarang);
					n.vtotalhasil= o.txtjmlbarang * o.txthargabarang;
					
					lbltotalbahan.text = parentApplication.m['nfNominal' + o.sumber].format(n.vtotalbahan);
					lbltotalhasil.text = parentApplication.m['nfNominal' + o.sumber].format(n.vtotalhasil);
				}
				
				public function f_defaultGrid():void
				{
					parentApplication.rowIndex = 0;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
					dg2.setSelectedCell(0, 1);
					f_focusOnMe();
				}
				
