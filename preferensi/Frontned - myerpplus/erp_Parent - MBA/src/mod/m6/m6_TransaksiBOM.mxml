						bomuraian:txturaian.text, bomcatatan:txtcatatan.text, bomnoref:txtnoref.text, bomtglnoref:dttanggalnoref.text, bomstatus:0, bomstatussebelumnya:0, bomjmlrevisi:0, 
						bomcetakanke:0, bominputuser:parentApplication.userid, bominputtgl:tglDB, bommodifikasiuser:0, bommodifikasitgl:tglDB, bomcustomtext1:'', bomcustomtext2:'', 
						bomcustomtext3:'', bomcustomtext4:'', bomcustomtext5:'', bomcustomint1:0, bomcustomint2:0, bomcustomint3:0, bomcustomdbl1:0, 
						bomcustomdbl2:0, bomcustomdbl3:0, bomcustomdate1:parentApplication.m.DateFirst, bomcustomdate2:parentApplication.m.DateFirst, bomcustomdate3:parentApplication.m.DateFirst}]);
					hasil = new ArrayCollection([{
						idbomin:0, idbom:0, idbarang:0, namabarang:lblkodebarang.text, tipebarang:'', jml:txtjmlbarang.text, satuan:txtsatuanbarang.text, 
						nilaisatuan:1, jmlbarang:parentApplication.m['nfNominal' + o.sumber].format(txtjmlbarang.text)*1, satuanbarang:'', matauang:parentApplication.getSetting(0, 'accounting', 'MataUangFungsional'), kurs:o.txtkurs, harga:txthargabarang.text, hpppersen:100, 
						hpp:0, rekpersediaan:parentApplication.getSetting(0, 'akun', 'Persediaan'), cabang:parentApplication.ucabang, lokasi:parentApplication.ulokasi, gudangasal:parentApplication.ugudang, gudangproduksi:parentApplication.getSetting(3, 'defaultgudang', 'GudangProduksi'), gudangtujuan:'', 
						costcenter:'', divisi:'', subdivisi:'', proyek:'', catatan:'', urutan:1, customtext1:'', 
						customtext2:'', customtext3:'', customdbl1:0, customdbl2:0, customdbl3:0, customdate1:parentApplication.m.DateFirst, customdate2:parentApplication.m.DateFirst, 
						customdate3:parentApplication.m.DateFirst}]);
					
					settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
