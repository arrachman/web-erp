				public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
				{
					switch (components){
						case 'calculator':
							dg2.dataProvider[dg2.selectedCell.rowIndex][dataField] = data
							parentApplication.F_dgColumnRefresh(dg2, dg2.selectedCell.rowIndex);
							with(dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex)){
								switch(dataField){
									case 'jml':
										if(tab.selectedIndex == 0){ harga = (Number(hpppersen/100) * Number(n.vtotalbahan)) / Number(jml); }
										jmlbarang = Number(jml) * Number(nilaisatuan);
										break;
									case 'harga':
										hpppersen = ((Number(jml) * Number(harga)) / Number(n.vtotalbahan)) * 100; 
										break;
									case 'subtotal':
										hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
										break;
								}
								subtotal = Number(dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).jml) * Number(dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).harga);
							}
							f_hitungTotalUtama();
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg2, dg2.selectedCell.rowIndex);
							break;
					}
				}
				
