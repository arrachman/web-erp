			public var validasi:Boolean,t:TitleWindow,pesanAlert:String, pesanAlertIng:String, img:Image, i:int, vUang:String, vTgl:String, vNotransaksi:String, vDefNotransaksi:String, vPosting:String, nreklawan:String, getNotransaksi:String;
			[Bindable] public var u:ArrayCollection;
			public var tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal;
			public var o:Object = {}, n:Object = {};
			public var obj:Object = {};
			[Bindable]public var ac_Serial:ArrayCollection = new ArrayCollection();
			[Bindable]public var ac_Batch:ArrayCollection = new ArrayCollection();
			[Bindable]public var ac_Aktiva:ArrayCollection = new ArrayCollection();
			[Bindable]public var acserial:ArrayCollection = new ArrayCollection();
			[Bindable]public var acbatch:ArrayCollection = new ArrayCollection();
			[Bindable]public var acaktiva:ArrayCollection = new ArrayCollection();
			[Bindable]public var acserialdetail:ArrayCollection= new ArrayCollection();
			[Bindable]public var acbatchdetail:ArrayCollection= new ArrayCollection();
			[Bindable]public var acaktivadetail:ArrayCollection= new ArrayCollection();
			[Bindable]public var ws_Serial:ArrayCollection = new ArrayCollection();
			[Bindable]public var ws_Batch:ArrayCollection = new ArrayCollection();
			[Bindable]public var ws_Aktiva:ArrayCollection = new ArrayCollection();
			
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var isUpdate:Boolean;
			public var fserial : String = 's';
			public var fbatch : String = 'b';
			public var faktiva : String = 'a';
			public var sumber : String = "SA";
			
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction(3, "Sa");
			private var flts:String='a',fltb:String='a',flta:String='a';
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
// mengeset ketika change pada grid =========================================			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components)
				{
					case "checkBox":																				// mengeset untuk checobox
						if(data && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == 'I')		// melakukan pencarian ketika klik checkbox maka melakukan pencarian barang HPP khusus
						{
							parentApplication.F_popUpCari('chk_HK');
						}
						break;
					case "calculator":
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data;
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
						switch(dataField){
							case "nilaisatuan":
									jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan;
										jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan
								break;
							case "jmlmasuk":
									jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan;
										jmlkeluar = 0;
										jmlbarangkeluar = 0
								if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == "I" && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).jmlkeluar > 0){
									dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 1;
								}else{
									dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 0;
								}
								break;
							case "jmlkeluar":
									jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan,
										jmlmasuk = 0,
										jmlbarangmasuk = 0
								if(dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).bhpp == "I" && dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).jmlkeluar > 0){
									dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 1;
								}else{
									dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hk_enabled = 0;
								}
								break;
							
							
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
			
			
			public function f_filtersb():void{
				fserial = 's'; fbatch = 'b'; faktiva = 'a';
				for(i=0; i<dg1.dataProviderLength; i++){
					if(dg1.dataProvider[i].bserial == 1){
						if(fserial == 's'){
							fserial = '(nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudang+'")';
						}else{
							fserial += ' or (nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudang+'")';
						}
					}
					
					if(dg1.dataProvider[i].bbatch == 1){
						if(fbatch == 'b'){
							fbatch = '(nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudang+'")';
						}else{
							fbatch += ' or (nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudang+'")';
						}
					}
					
					if(dg1.dataProvider[i].basset == 1){
						if(faktiva == 'a'){
							faktiva = '(aidbarang = ' + dg1.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg1.dataProvider[i].gudang+'")';
						}else{
							faktiva += ' or (aidbarang = ' + dg1.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg1.dataProvider[i].gudang+'")';
						}
					}
				}
			}
			
// set fokus ketika pertama kali form diload ===================================
			public function f_focusOnMe():void
			{
				txtbagianpenyesuaian.setFocus();
			}

// set persiapan form ==========================================================
			protected function f_persiapan():void
			{
				if(FlexGlobals.topLevelApplication.getSetting(3, 'options', 'LokasiSA') == 1)
				{
					tlokasi.text = FlexGlobals.topLevelApplication.getSetting(3, 'options', 'LabelLokasiSA');
					FlexGlobals.topLevelApplication.F_RequiredLabel([tlokasi]);
					FlexGlobals.topLevelApplication.F_txtpencarian([txtlokasi]);
					tlokasi.visible = true;
					txtlokasi.visible = true;
				}
				else
				{
					tlokasi.visible = false;
					txtlokasi.visible = false;
				}
				
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tbagpenyesuaian, tgudang, tjenispenyesuaian, turaian, ttanggal, tnotransaksi, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref]);
				parentApplication.F_RequiredLabel([tbagpenyesuaian, tgudang, tjenispenyesuaian, ttanggal, tnotransaksi, tprogress]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress, cmbJenis]);
				parentApplication.F_txtpencarian([txtbagianpenyesuaian, txtgudang, txtjenispenyesuaian]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan,txtalamat]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref,txtportofloading,txtdestination,txttermofdelivery]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				vPosting = parentApplication.getSetting(0, 'accounting', 'AutoPosting');
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Ambil SP", icon:"tbtake", enabled:"true", children:[
						{label:"Per No Transaksi", icon:"tbtake", enabled:"true"},
						{label:"Per Detail", icon:"tbtake", enabled:"true"}]},
					{label:"Ambil SO", icon:"tbtake", enabled:"true"},
					{label:"Ambil SP + Penjualan", icon:"tbtake", enabled:"true"},
					{label:"No.Serial/Batch", icon:"tbserialin", enabled:"true", children:[
						{label:"No.Serial/Batch In", icon:"tbserialin", enabled:"true"},
						{label:"No.Serial/Batch Out", icon:"tbserialout", enabled:"true"}]},
					{label:"Aktiva", icon:"tbaktivain", enabled:"true", children:[
						{label:"Aktiva In", icon:"tbaktivain", enabled:"true"},
						{label:"Aktiva Out", icon:"tbaktivaout", enabled:"true"}]},
					{label:"Import Data", icon:"tbexcel", enabled:"true"},
					{label:"Lain-Lain", icon:"tbothers", enabled:"false", children:[
						{label:"Catatan", icon:"tbnote", enabled:"true"},
						{label:"File", icon:"tbattachment", enabled:"true"},
						{label:"Links", icon:"tblink", enabled:"true"}]}]);
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbAmbilSO);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbAmbilSPPenjualan);
				mb.menuBarItems[8].addEventListener(MouseEvent.CLICK, f_mbImportData);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbItemClick);
				
				
				function f_mbSimpan():void
				{
					f_simpan();
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Sa");
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
					acserialdetail.removeAll();
					acbatchdetail.removeAll();
					acaktivadetail.removeAll();
					ac_Serial.removeAll();
					ac_Batch.removeAll();
					ac_Aktiva.removeAll();
				}
				function f_mbAmbilSP():void
				{
					
				}
				function f_mbItemClick(e:MenuEvent):void
				{
					if(mb.selectedIndex == 3){
						switch(e.index){
							case 0:
								parentApplication.F_popUpCari("ambilSP2");
								break;
							
							case 1:
								parentApplication.F_popUpCari("ambilSP");
								break;
							
						}
					}
					else if(mb.selectedIndex == 6){
						switch(e.index){
							case 0:
								f_mbSerialIn();
								break;
							
							case 1:
								f_mbSerialOut();
								break;
							
						}
					}
					else if(mb.selectedIndex == 7){
						switch(e.index){
							case 0:
								f_mbAktivaIn();
								break;
							
							case 1:
								f_mbAktivaOut();
								break;
							
						}
					}
					else if(mb.selectedIndex == 9){
						switch(e.index){
							case 0:
								f_mbCatatan();
								break;
							
							case 1:
								f_mbUpload();
								break;
							
							case 2:
								f_mbLinks();
								break;
						}
					}
				}
				
				function f_mbAmbilSO():void
				{
					if(mb.menuBarItems[4].enabled)FlexGlobals.topLevelApplication.F_popUpCari("ambilSO");
				}
				function f_mbAmbilSPPenjualan():void
				{
					if(mb.menuBarItems[5].enabled)parentApplication.F_popUpCari("ambilSPPenjualan");
				}
				function f_mbSerialIn():void {
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					if(mb.menuBarItems[6].enabled){
						o.moduleid = 3; o.mnid = 6; o.said = u[0].said; o.sumber = 'SA'; o.idgrid = dg1.id;
						o.gudang = txtgudang.text;
						FlexGlobals.topLevelApplication.openFormX( "Serial / Batch Number",1,'mod/m0/m0_SerialBatchIn.swf',350,650,'t1');
					}
				}
				function f_mbSerialOut():void {
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					if(mb.menuBarItems[6].enabled){
						o.sumber = 'SA';
						o.moduleid = 3;
						o.mnid = 6;
						o.idgrid = dg1.id;
						o.gudang = txtgudang.text;
						f_filtersb();
						o.aserial = acserialdetail;
						o.abatch = acbatchdetail;
						FlexGlobals.topLevelApplication.openFormX( "Serial / Batch Number",1,'mod/m0/m0_SerialOut.swf',372,602,'t1')
					}
				}
				function f_mbAktivaIn():void {
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					if(mb.menuBarItems[7].enabled){
						o.moduleid = 3; o.mnid = 6; o.said = u[0].said; o.sumber = 'SA'; o.idgrid = dg1.id;
						o.gudang = txtgudang.text;
						o.tglbeli = dttanggal.text;
						o.tglpakai = dttanggal.text;
						o.harga = dg1.dataProvider.getItemAt(0).hpp; 
						o.satuan = dg1.dataProvider.getItemAt(0).satuanbarang;
						o.nama = dg1.dataProvider.getItemAt(0).namabarang;
						FlexGlobals.topLevelApplication.openFormX( "Asset In",1,'mod/m0/m0_AktivaIn.swf',600,970,'t1');
					}
				}
				function f_mbAktivaOut():void {
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					if(mb.menuBarItems[7].enabled){
						o.sumber = 'SA';
						o.moduleid = 3;
						o.mnid = 6;
						o.idgrid = dg1.id;
						o.gudang = txtgudang.text;
						f_filtersb();
						o.aaktiva = acaktivadetail;
						FlexGlobals.topLevelApplication.openFormX( "Asset Out",1,'mod/m0/m0_AktivaOut.swf',426,602,'t1');
					}
				}
				function f_mbImportData():void{
					FlexGlobals.topLevelApplication.openFormX( "Import Data",1,'mod/m3/m3_ImportDataSA.swf',372,602,'t1',"",[dttanggal.text, u.getItemAt(0).sabagiansa, txtjenispenyesuaian.text, txturaian.text, txtcatatan.text])
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[9].enabled){
						parentApplication.F_OpenNotes('SA', u.getItemAt(0).said, txtnotransaksi.text);
					}
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[9].enabled){
						parentApplication.F_OpenUploadFile('SA', u.getItemAt(0).said, txtnotransaksi.text);
					}
				}
				
				function f_mbLinks():void
				{
					if(mb.menuBarItems[9].enabled)FlexGlobals.topLevelApplication.f_mbLinks(3,'Sa');
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(3, 6, [dg1], 'TransaksiBarang');
				
				// Hak akses custom show hide
				for(i=0;i<dg1.columnsLength;i++)
				{
					switch(dg1.columns.getItemAt(i).dataField)
					{
						case "hpplama": // hpp lama
							dg1.columns.getItemAt(i).visible = parentApplication.getHakAksesCustom(3, 1);
							break;
						case "hpp": // hpp update
							dg1.columns.getItemAt(i).visible = parentApplication.getHakAksesCustom(3, 2);
							break;
					}
				}
				
				f_validasi();
			}
			public function f_validasi():void{
				
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 3, "SA");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_SaHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_SaGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			protected function f_kondisiAwal():void
			{
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				o.salokasi=FlexGlobals.topLevelApplication.ulokasi;
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 3, "SA");
				isUpdate = false;
				cmbJenis.dataProvider = new ArrayCollection([{l:'Stock', v:0}, {l:'Cogs', v:1}]);
				parentApplication.F_SetNilaiText([dttanggal, dttanggalnoref], parentApplication.DefaultTanggal);
				parentApplication.F_SetNilaiText([], 0);
				parentApplication.F_KosongkanText([txtbagianpenyesuaian, lblbagianpenyesuaian, txtkontakperson, txtgudang, lblgudang, txtjenispenyesuaian, lbljenispenyesuaian, txturaian, txtcatatan, txtnoref,txtalamat]);
				parentApplication.F_KosongkanText([txtportofloading, txtdestination, txttermofdelivery]);
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("SA");
				txtcatatan.text = parentApplication.getNomor("SA",1);
				txtgudang.text = parentApplication.ugudang;
				lblgudang.text = parentApplication.ugudangnama;
				cmbprogress.enabled = true;
				cmbJenis.selectedIndex = 0;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = true;
				mb.menuBarItems[4].enabled = true;
				mb.menuBarItems[5].enabled = true;
				mb.menuBarItems[6].enabled = true;
				mb.menuBarItems[7].enabled = true;
				dg1.enabled = true;
				/* mb.menuBarItems[10].visible = false;
				mb.menuBarItems[11].visible = false; */
				FlexGlobals.topLevelApplication.sumber = "SA";
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				if (vPosting == '1'){
					chkposting.selected = true;
				}else{
					chkposting.selected = false;
				}

				u = new ArrayCollection([{said:0, sacabang:parentApplication.ucabang, salokasi:parentApplication.ulokasi, sagudang:parentApplication.ugudang, sasumber:'SA', sajenis:'', saautonotransaksi:0,
					sanotransaksi:txtnotransaksi.text, satgl:dttanggal.text, sakodepa:0, sabagiansa:0, sabagiansakontak:txtkontakperson.text, sauraian:txturaian.text, sacatatan:txtcatatan.text,
					sanoref:txtnoref.text, satglnoref:dttanggalnoref.text, saidsp:0, sastatus:cmbprogress.selectedItem.v, sastatussebelumnya:0, sajmlrevisi:0, sacetakanke:0, 
					sainputuser:parentApplication.userid, sainputtgl:tglDB, samodifikasiuser:0, samodifikasitgl:tglDB, saposting:0, satutupperiode:0, saisclose:0, 
					sacustomtext1:'', sacustomtext2:'', sacustomtext3:'', sacustomtext4:'', sacustomtext5:txtalamat.text, sacustomint1:0, sacustomint2:0, 
					sacustomint3:0, sacustomdbl1:0, sacustomdbl2:0, sacustomdbl3:0, sacustomdate1:parentApplication.m.DateFirst, sacustomdate2:parentApplication.m.DateFirst, sacustomdate3:parentApplication.m.DateFirst}]);
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)f_simpan();
						break;
					case Keyboard.LEFT:
						if(dg1.selectedCell.columnIndex == 0 && dg1.selectedCell.rowIndex > 0){
							
							dg1.setSelectedCell(dg1.selectedCell.rowIndex - 1, 5);
						}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				if(cmbJenis.selectedIndex == 0){
					mb.menuBarItems[5].enabled = true;
					mb.menuBarItems[6].enabled = true;
					mb.menuBarItems[8].enabled = true;	
				}		
				switch(column){
					case "nilaisatuan":
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
							jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan,
							jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan
						break;
					case "jmlmasuk":
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex))
							jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan,
							jmlkeluar = 0,
							jmlbarangkeluar = 0
