			protected function cmbJenis_changeHandler(event:IndexChangeEvent):void
			{
				if(cmbJenis.selectedIndex == 1){
					mb.menuBarItems[3].enabled = false;
					mb.menuBarItems[4].enabled = false;
					mb.menuBarItems[5].enabled = false;
					mb.menuBarItems[6].enabled = false;
					mb.menuBarItems[7].enabled = false;
					for(var a:int=0;a<dg1.dataProviderLength;a++){
						dg1.dataProvider.getItemAt(a).jmlkeluar = 0;
						dg1.dataProvider.getItemAt(a).jmlmasuk = 0;							
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
					dg1.columns.getItemAt(7).editable = false;
					dg1.columns.getItemAt(5).editable = false;
				}
				else{
					mb.menuBarItems[3].enabled = true;
					mb.menuBarItems[4].enabled = true;
					mb.menuBarItems[5].enabled = true;
					mb.menuBarItems[6].enabled = true;
					mb.menuBarItems[7].enabled = true;
					dg1.columns.getItemAt(7).editable = true;
					dg1.columns.getItemAt(5).editable = true;
					//dg1.enabled = true;
				}
			}
			
