						sort = 'kakodekontak asc';
						break;
					case "ambilSP":
						paket = 'CdM3_Sp_Detail';
						csfilter='(spstatus=2 OR spstatus=3) AND spgudang = "'+txtgudang.text.split('"').join('\\"')+'" and selisih <> 0';
						sort = 'spnotransaksi desc, urutan asc';
						checkbox = true;
						id = 'idspdetail';
						break;
					case "ambilSP2":
						paket = 'CdM3_Sp';
						csfilter='(spstatus=2 OR spstatus=3) AND spgudang = "'+txtgudang.text.split('"').join('\\"')+'" and selisih <> 0';
						sort = 'spnotransaksi desc';
						break;
					case "ambilSO":
