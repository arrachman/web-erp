			//hapus serial jika barangnya tidak ada
			public function hapusserial():void{
				var s:int, arrayserial:ArrayCollection = new ArrayCollection;
				if(dg1.dataProvider[dg1.selectedCell.rowIndex].jmlkeluar > 0){
					arrayserial = acserialdetail;
				}else if(dg1.dataProvider[dg1.selectedCell.rowIndex].jmlmasuk > 0){
					arrayserial = ac_Serial;
				}
				if(arrayserial.length > 0){
					for(s=arrayserial.length-1; s>=0; s--){
						if(arrayserial[s].nstidbarang == dg1.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							arrayserial.removeItemAt(s);
						}
					}
				}
			}
			
			public function hapusbatch():void{
