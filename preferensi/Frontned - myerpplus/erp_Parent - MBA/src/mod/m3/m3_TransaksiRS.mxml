// mengeset ketika change pada grid =========================================
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "calculator":
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data
						with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
							switch(dataField){
								case "jml":
									jmlbarang = Number(jml) * Number(nilaisatuan);
									break;
							}
						}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						break;
				}
			}
			
			public function f_filtersb():void{
				fserial = 's'; fbatch = 'b'; faktiva = 'a';
				for(i=0; i<dg1.dataProviderLength; i++){
					if(dg1.dataProvider[i].bserial ==	1){
						if(fserial == 's'){
							fserial = '(nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangtransit+'")';
						}else{
							fserial += ' or (nsiidbarang = ' + dg1.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg1.dataProvider[i].gudangtransit+'")';
						}
					}
					
					if(dg1.dataProvider[i].bbatch ==	1){
						if(fbatch == 'b'){
							fbatch = '(nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangtransit+'")';
						}else{
							fbatch += ' or (nbiidbarang = ' + dg1.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg1.dataProvider[i].gudangtransit+'")';
						}
					}
					
					if(dg1.dataProvider[i].basset ==	1){
						if(faktiva == 'a'){
							faktiva = '(aidbarang = ' + dg1.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg1.dataProvider[i].gudangtransit+'")';
						}else{
							faktiva += ' or (aidbarang = ' + dg1.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg1.dataProvider[i].gudangtransit+'")';
						}
					}
				}
			}
			
// set fokus ketika pertama kali form diload ===================================
			public function f_focusOnMe():void
			{
				txtgudangasal.setFocus();
			}

// set persiapan form ==========================================================
			protected function f_persiapan():void
			{
				if(FlexGlobals.topLevelApplication.getSetting(3, 'options', 'LokasiRS') == 1)
				{
					tlokasi.text = FlexGlobals.topLevelApplication.getSetting(3, 'options', 'LabelLokasiRS');
					FlexGlobals.topLevelApplication.F_RequiredLabel([tlokasi]);
					FlexGlobals.topLevelApplication.F_txtpencarian([txtlokasi]);
					tlokasi.visible = true;
					txtlokasi.visible = true;
				}
				else
				{
					tlokasi.visible = false;
					txtlokasi.visible = false;
				}
				
				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tbagterima, tgudangasal, tgudangtransit, tgudangtujuan, turaian, ttanggal, tnotransaksi, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref]);
				parentApplication.F_RequiredLabel([tgudangasal, tgudangtransit, tgudangtujuan, ttanggal, tnotransaksi, tprogress]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtbagianterima, txtgudangasal, txtgudangtujuan]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;

				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
//					{label:"Ambil TS", icon:"tbtake", enabled:"true"},
					{label:"Ambil TS", icon:"tbtake", enabled:"true", children:[
						{label:"Per Detail", icon:"tbtake", enabled:"true"},
						{label:"Per No Transaksi", icon:"tbtake", enabled:"true"}]},
					{label:"No.Serial/Batch Out", icon:"tbserialout", enabled:"true"},
					{label:"Aktiva In", icon:"tbaktivaout", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
//				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbAmbilTS);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_SerialBatch);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_Aktiva);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[8].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[9].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[10].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbItemClick); 
				function f_mbItemClick(e:MenuEvent):void
				{
					
					switch(e.index){
						case 0:
							if(txtgudangasal.text.length <= 0 && txtgudangtujuan.text.length <= 0){
								txtgudangasal.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal dan Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}else if(txtgudangasal.text.length <= 0){
								txtgudangasal.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}else if(txtgudangtujuan.text.length <= 0){
								txtgudangtujuan.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}else{
								parentApplication.F_popUpCari("ambilTS");
							}
							break;
						
						case 1:
							if(txtgudangasal.text.length <= 0 && txtgudangtujuan.text.length <= 0){
								txtgudangasal.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal dan Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}else if(txtgudangasal.text.length <= 0){
								txtgudangasal.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}else if(txtgudangtujuan.text.length <= 0){
								txtgudangtujuan.setFocus();
								Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
							}else{
								parentApplication.F_popUpCari("ambilTS2");
							}
							break;
						
					}
				}
				
				function f_mbSimpan():void
				{
					if(mb.menuBarItems[0].enabled){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(3,5,jenissimpan)){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Rs");
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
					acserialdetail.removeAll();
					acbatchdetail.removeAll();
					acaktivadetail.removeAll();
				}
				function f_mbAmbilTS():void
				{
					if(txtgudangasal.text.length <= 0 && txtgudangtujuan.text.length <= 0){
						txtgudangasal.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal dan Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}else if(txtgudangasal.text.length <= 0){
						txtgudangasal.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Asal terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}else if(txtgudangtujuan.text.length <= 0){
						txtgudangtujuan.setFocus();
						Alert.show(FlexGlobals.topLevelApplication.l("Isi Gudang Tujuan terlebih dahulu"), FlexGlobals.topLevelApplication.l("Informasi"));
					}else{
						parentApplication.F_popUpCari("ambilTS");
					}
				}
				
				function f_SerialBatch():void{
					if(mb.menuBarItems[4].enabled){
						o.ceks = true; o.cekb = true;
						o.sumber = 'RS';
						o.moduleid = 3;
						o.mnid = 5;
						o.idgrid = dg1.id;
						o.gudang = txtgudangtransit.text;
						f_filtersb()
						o.aserial = acserialdetail;
						o.abatch = acbatchdetail;
						FlexGlobals.topLevelApplication.openFormX("No. Serial/Batch",1,'mod/m0/m0_SerialOut.swf',426,602,'t1');
					}
					
				}
				
				function f_Aktiva():void{
					if(mb.menuBarItems[5].enabled){
						o.ceka = true;
						o.sumber = 'RS';
						o.moduleid = 3;
						o.mnid = 5;
						o.idgrid = dg1.id;
						o.gudang = txtgudangtransit.text;
						f_filtersb()
						o.aaktiva = acaktivadetail;
						FlexGlobals.topLevelApplication.openFormX("Asset",1,'mod/m0/m0_AktivaOut.swf',426,602,'t1');
					}
					
				}
				
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[6].enabled){
						parentApplication.F_OpenNotes('Rs', u.getItemAt(0).rsid, txtnotransaksi.text);
					}
				}
				
				function f_mbUpload():void
				{
					if(mb.menuBarItems[7].enabled){
						parentApplication.F_OpenUploadFile('RS', u.getItemAt(0).rsid, txtnotransaksi.text);
					}
				}
				
				function f_mbLinks():void
				{
					if(mb.menuBarItems[8].enabled)FlexGlobals.topLevelApplication.f_mbLinks(3,'Rs');
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(3, 5, [dg1], 'TransaksiBarang');
				f_validasi();
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 3, "RS");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_RsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M3_RsGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			protected function f_kondisiAwal():void
			{
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				o.rslokasi=FlexGlobals.topLevelApplication.ulokasi;
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 3, "RS");
				isUpdate = false;
				parentApplication.F_SetNilaiText([dttanggal, dttanggalnoref], parentApplication.DefaultTanggal);
				parentApplication.F_SetNilaiText([], 0);
				parentApplication.F_KosongkanText([txtbagianterima, lblbagianterima, txtkontakperson, txtgudangasal, lblgudangasal, txtgudangtransit, lblgudangtransit, txtgudangtujuan, lblgudangtujuan, txtcatatan, txtnoref]);
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("RS");
				txtcatatan.text = parentApplication.getNomor("RS",1);
				txtgudangtujuan.text = parentApplication.ugudang;
				lblgudangtujuan.text = parentApplication.ugudangnama;
				txtgudangtransit.text = parentApplication.getSetting(3, 'defaultgudang', 'GudangTransit');
				lblgudangtransit.text = parentApplication.getSetting(3, 'defaultgudang', 'GudangTransitNama');
				cmbprogress.enabled = true;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].enabled = false;
				mb.menuBarItems[8].enabled = false;
				mb.menuBarItems[9].visible = false;
				mb.menuBarItems[10].visible = false;
				if (vTgl == '0'){
					dttanggal.enabled = false;
				}else{
					dttanggal.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				u = new ArrayCollection([{rsid:0, rscabang:parentApplication.ucabang, rslokasi:parentApplication.ulokasi, rsgudangasal:'', rsgudangtransit:'', rsgudangtujuan:'', rssumber:'RS', 
					rsautonotransaksi:0, rsnotransaksi:txtnotransaksi.text, rstgl:dttanggal.text, rskodepa:0, rsbagianterima:parentApplication.ukontak, rsbagianterimakontak:txtkontakperson.text, rsuraian:txturaian.text, 
					rscatatan:txtcatatan.text, rsnoref:txtnoref.text, rstglnoref:dttanggalnoref.text, rsidmr:0, rsidts:0, rsstatusrs:0, rsstatus:cmbprogress.selectedItem.v, rsstatussebelumnya:0, 
					rsjmlrevisi:0, rscetakanke:0, rsinputuser:parentApplication.userid, rsinputtgl:tglDB, rsmodifikasiuser:0, rsmodifikasitgl:tglDB, rsisclose:0, 
					rscustomtext1:'', rscustomtext2:'', rscustomtext3:'', rscustomtext4:'', rscustomtext5:'', rscustomint1:0, rscustomint2:0, 
					rscustomint3:0, rscustomdbl1:0, rscustomdbl2:0, rscustomdbl3:0, rscustomdate1:parentApplication.m.DateFirst, rscustomdate2:parentApplication.m.DateFirst, rscustomdate3:parentApplication.m.DateFirst}]);
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(3,5,jenissimpan)){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				if(parentApplication.rowIndex < dg1.dataProviderLength)
				with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
					switch(column){
//						case "jml":
//							customdbl1 = Number(jml) / Number(nilaisatuanlapangan);
//							jmlbarang = Number(jml) * Number(nilaisatuan);
//							break;
//						case "customdbl1":
//							jml = Number(customdbl1) * Number(nilaisatuanlapangan);
//							jmlbarang = Number(jml) * Number(nilaisatuan);
//							break;
						case "jml":
							customdbl1 = (Number(jml) *  Number(nilaisatuan))/ Number(nilaisatuanlapangan);
							jmlbarang = Number(jml) * Number(nilaisatuan);
							//							customdbl1 = Number(jml) / Number(nilaisatuanlapangan);
							break;
						case "customdbl1":
							jml = (Number(nilaisatuanlapangan) / Number(nilaisatuan)) * Number(customdbl1)
							jmlbarang = Number(jml) * Number(nilaisatuan);
							//							jml = Number(customdbl1) * Number(nilaisatuanlapangan);
							//							jmlbarang = Number(jml) * Number(nilaisatuan);
							break;
						case "pre_del":
							hapusserial();
							hapusbatch();
							hapusaktiva();
							break;
						
					}
				}
				parentApplication.F_dgRefresh(dg);
			}
			
			//hapus serial jika barangnya tidak ada
			public function hapusserial():void{
				var s:int;
				if(acserialdetail.length > 0){
					for(s=acserialdetail.length-1; s>=0; s--){
						if(acserialdetail[s].nstidbarang == dg1.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							acserialdetail.removeItemAt(s);
						}
					}
				}
			}
			
			public function hapusbatch():void{
				var b:int;
				if(acbatchdetail.length > 0){
					for(b=acbatchdetail.length-1; b>=0; b--){
						if(acbatchdetail[b].nbtidbarang == dg1.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							acbatchdetail.removeItemAt(b);
						}
					}
				}
			}
			
			public function hapusaktiva():void{
				var a:int;
				if(acaktivadetail.length > 0){
					for(a=acaktivadetail.length-1; a>=0; a--){
						if(acaktivadetail[a].atidbarang == dg1.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							acaktivadetail.removeItemAt(a);
						}
					}
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String='';
				if(dg1.selectedCell != null && parentApplication.rowIndex < dg1.dataProviderLength)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case "txtlokasi":
						paket = "CdM1_Location";
						wsfilter = 'laktif=1 AND lkode="'+txtlokasi.text+'"';
						csfilter = 'laktif=1';
						//csfield = 2;
						sort = 'lkode asc';
						break;
					case "txtbagianterima":
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M") AND kkode = "'+txtbagianterima.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
