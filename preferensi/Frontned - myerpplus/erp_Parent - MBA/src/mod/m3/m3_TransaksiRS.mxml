			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String, tgl:String, batch:String = '', serial:String='', aktiva:String='';
				parentApplication.vpFocusEvent = true;
				n.dttanggal = dttanggal.text;
				if(mb.menuBarItems[0].enabled){
					validasiForm();
					if(validasi){
						u.refresh();
						// Set Utama
						
						with(u.getItemAt(0))
							a = [rsid, rscabang, txtlokasi.text, txtgudangasal.text, txtgudangtransit.text, txtgudangtujuan.text, rssumber, 
								int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), rskodepa, rsbagianterima, txtkontakperson.text, txturaian.text, 
								txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), rsidmr, rsidts, cmbprogress.selectedItem.v, rsstatussebelumnya, 
								rsjmlrevisi, rscetakanke, rsinputuser, parentApplication.F_tglFormatDB(rsinputtgl), rsmodifikasiuser, parentApplication.F_tglFormatDB(rsmodifikasitgl), rsisclose, 
								rscustomtext1, rscustomtext2, rscustomtext3, rscustomtext4, rscustomtext5, rscustomint1, rscustomint2, 
								rscustomint3, rscustomdbl1, rscustomdbl2, rscustomdbl3, parentApplication.F_tglFormatDB(rscustomdate1), parentApplication.F_tglFormatDB(rscustomdate2), parentApplication.F_tglFormatDB(rscustomdate3)];
						utama = parentApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++){
							with(dg1.dataProvider.getItemAt(i)){
								a = [idrsdetail, idrs, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, cabang, lokasi, gudangasal, gudangtransit, 
									gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, (i+1), 
									idmrdetail, idtsdetail, isclose, customtext1, customtext2, customtext3, customdbl1, 
									customdbl2, customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = parentApplication.F_splitArrayToString(a);
								else detail += "▲"+parentApplication.F_splitArrayToString(a);
							}
						}
							
						
							//set serial
						for(var ib:int=0;ib < acserialdetail.length;ib++){
							with(acserialdetail.getItemAt(ib)){
								a = [nstid, nstjenismutasi, nstidbarang, nstkode, nstsumber, nstidtransaksi, nstsatuan, 
									1, nstcustomtext1, nstcustomtext2, nstcustomtext3, nstcustomdbl1, nstcustomdbl2, nstcustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate3),
									txtgudangasal.text, nstidserialin];
								if(serial == '')serial =FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else serial += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						// Set batch
						for(var ibb:int=0; ibb < acbatchdetail.length; ibb++){
							with(acbatchdetail.getItemAt(ibb)){
								a = [nbtid, nbtjenismutasi, nbtidbarang, nbtkode, nbtsumber, nbtidtransaksi, nbtsatuan, 
									nbtjml, nbtcustomtext1, nbtcustomtext2, nbtcustomtext3, nbtcustomdbl1, nbtcustomdbl2, nbtcustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate3),
									txtgudangasal.text, nbtidbatchin];
								if(ibb == 0)batch =FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else batch += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						// Set aktiva
						for(var ibbb:int=0; ibbb < acaktivadetail.length; ibbb++){
							with(acaktivadetail.getItemAt(ibbb)){
								a = [atid, atasetid, atjenismutasi, atsumber, atidutama, atidbarang, atkode, 
									atnama, atkategori, atcabang, atlokasi, atgudang, atdivisi, atsubdivisi, 
									atcostcenter, atproyek, atcatatan, atnomor, FlexGlobals.topLevelApplication.F_tglFormatDB(attglbeli), FlexGlobals.topLevelApplication.F_tglFormatDB(attglpakai), atjml, 
									atsatuan, atmatauang, atkurs, atharga, atdiskon, atjmldiskon, atpajak1, 
									atjmlpajak1, atpajak2, atjmlpajak2, athargabeli, atnilairesidu, atumurekonomis, atbebanperbln, 
									atakumulasibeban, atnilaibuku, atmetode, attabelpenyusutan, atintangible, atfiskal, atatastengahbulan, 
									atrekasset, atrekakumdepresiasi, atrekdepresiasi, atrekpenghapusan, atprodusen, FlexGlobals.topLevelApplication.F_tglFormatDB(attglpensiun), atpenyusutanke, 
									atnilaimenurun, atdispose, atpembelian, atpenjualan, atlocked, atstatus, atstatussebelumnya, 
									atisclose, atinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(atinputtgl), atmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(atmodifikasitgl), atcustomtext1, atcustomtext2, 
									atcustomtext3, atcustomtext4, atcustomtext5, atcustomint1, atcustomint2, atcustomint3, atcustomint4, 
									atcustomint5, atcustomdbl1, atcustomdbl2, atcustomdbl3, atcustomdbl4, atcustomdbl5, FlexGlobals.topLevelApplication.F_tglFormatDB(atcustomdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(atcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(atcustomdate3), FlexGlobals.topLevelApplication.F_tglFormatDB(atcustomdate4), FlexGlobals.topLevelApplication.F_tglFormatDB(atcustomdate5)];
								if(ibbb == 0)aktiva =FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else aktiva += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
							
						parentApplication.F_wsSimpan("simpan", "M3_RsSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+batch+"△"+serial+"△"+aktiva);
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					pesanAlertIng = "";
					pesanAlert = "";
//					if(txtbagianterima.text.length == 0)msgAlert(txtbagianterima,'Recieve Section','Bagian Terima');
					if(txtgudangasal.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtgudangasal,'Gudang Asal');
					if(txtgudangtransit.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtgudangtransit,'Gudang Transit');
					if(txtgudangtujuan.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtgudangtujuan,'Gudang Tujuan');
					if(dttanggal.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(dttanggal,'Tanggal');
					if(txtlokasi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtlokasi,'Lokasi');
					if(txtnotransaksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(dg1.dataProvider.getItemAt(0).idrsdetail == null)FlexGlobals.topLevelApplication.msgAlert(dg1,'Detail Item');
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlertIng+"  ("+pesanAlert+")" , "Information");}	 
						validasi = false; 
					}
				}
			}
			
