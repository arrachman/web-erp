			public function f_kondisiAwal():void
			{
				dgImport.dataProvider.removeAll();
				cmbsheet.dataProvider.removeAll();
				grpimport.visible = true;
//				cmbstatus.selectedIndex = o.DefaultStatus;
				for(i=dgImport.columnsLength -1; i>0; i--)
				{
					dgImport.columns.removeItemAt(i);
				}
				for(i=0; i<dgMapping.dataProviderLength; i++)
				{
					dgMapping.dataProvider.getItemAt(i)['kolomsumber'] = "";
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgMapping);
				txtpaging.text = "0";
				lblnamafile.text = "";
				lblpleasewait.visible = false;
				ttwpopup.visible = true;
				f_focusOnMe();
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var n:int;
				switch (components)
				{
					case "checkBoxHeader":
						for (i=0; i<dgImport.dataProviderLength; i++)
						{
							sheet.values.getItemAt(dgImport.dataProvider.getItemAt(i).rowexcel).chk = data;
							dgImport.dataProvider.getItemAt(i).chk = data;
						} 
						break;
					case "checkBox":
						sheet.values.getItemAt(dgImport.dataProvider.getItemAt(dgImport.selectedCell.rowIndex).rowexcel).chk = data;
						dgImport.dataProvider.getItemAt(dgImport.selectedCell.rowIndex).chk = data;
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgImport);
			}
			
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				var sumberkosong:Boolean;
				switch(components)
				{
					case "comboBox":
						sumberkosong = false;
						if(dataField == 'kolomsumber')
						{
							return acKolomSumber;
						}
				}
				return new ArrayCollection([]);
			}
			
