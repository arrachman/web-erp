			public function F_persiapanFormData(obj:Object):void
			{
				parentApplication.f_refreshIDmodule(obj);
				var m:Object = parentApplication.m;
				var module:String = parentApplication.module;
				var idmod:String = parentApplication.idmod;
				var vSort:Boolean = true, vPosisi:int = 0, vCMI:ContextMenuItem, dg:DataGrid, mb:MenuBar, arr:Array = new Array, sumber:String, i:int;
				FlexGlobals.topLevelApplication.F_RegGrid(parentApplication.m[module].child.a[0], parentApplication.m[module].child.a[2], [dgImport, dgMapping], 'transaksi');
				o = m[module].child;
				dg = m[module].child.dgImport;
				m.sort[module] = "";
				m.a = [];
				m.a[0] = m[module].child.a[0];
				m.a[1] = m[module].child.a[1];
				m.s = m[module].child.a[3];
				sumber = m[module].child.a[3].toLowerCase();
				mb = m[module].child.mb;
				o.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				// Config Paging
				o.txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				o.txtpaging.restrict = "0-9";
				o.txtpaging.setStyle("textAlign","center");
				o.txtpaging.text = 0;
				o.txtpaging.maxChars = 4;
				o.imgfirst.enabled = false;
				o.imgprevious.enabled = false;
				o.imgnext.enabled = false;
				o.imglast.enabled = false;
				o.imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				o.imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				o.imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				o.imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				function f_KEY_DOWN(e:KeyboardEvent):void
				{ 
					var id:int
					if(e.ctrlKey)
					{
						switch(e.keyCode)
						{
							case Keyboard.N: // Form Baru
								if(parentApplication.apaBisaAkses(m[idmod].child.a[0], m[idmod].child.a[1], 1)){
									parentApplication.f_refreshIDmodule(obj);
									for(i=0;i<m.ArrUserMenu.length;i++)
									{
										if(parseInt(m.ArrUserMenu.getItemAt(i).mnmoduleid) == m[module].child.a[0] && parseInt(m.ArrUserMenu.getItemAt(i).mnid) == m[module].child.a[1])
										{
											m.o = m.ArrUserMenu.getItemAt(i);
											break;
										}
									}
									parentApplication.openFormX(m.o.mnname, 0, m.o.mnurl, 0, 0, "t2");
								}
								break;
							case Keyboard.E: // Edit Form
								if(parentApplication.apaBisaAkses(m[idmod].child.a[0], m[idmod].child.a[1], 2))
								{
									if(dg.selectedCell != null)
									{
										id = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
										parentApplication.f_refreshIDmodule(dg);
										if(parentApplication.apaBisaAkses(m[module].child.a[0], m[module].child.a[1], 2))
										{
											parentApplication.openForm(m[module].child.a[0], m[module].child.a[1], String(id));
										}
									}
								}
								break;
							case Keyboard.D: // Delete Transaksi
								if(parentApplication.apaBisaAkses(m[idmod].child.a[0], m[idmod].child.a[1], 3))
								{
									parentApplication.f_refreshIDmodule(dg);
									var status:int = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"status"];
									id = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)[sumber+"id"];
									
									if(dg.dataProviderLength > 0 && parentApplication.apaBisaAkses(m[module].child.a[0], m[module].child.a[1], 3))
										if(status == 0 || status == 5 || status == 6)
										{
											Alert.show(l("Apakah Anda yakin akan menghapus No. Transaksi ini ?", 1), l("Informasi"), 3, null, function(e:Object):void
											{	
												if(e.detail == Alert.YES)
													parentApplication.F_wsDelete(parentApplication.sptParam+'updateStatus', 'M'+m[module].child.a[0]+'_'+m[module].child.a[3]+'Delete', parentApplication.userid, id.toString(), int(o.txtpaging.text), 20, o.f_filterdata(), m.sort[module]);
											});
										}
										else Alert.show(l('Status Draft, Revisi dan Reject yang bisa di hapus', 1), l("Informasi"));
								}
								break;
							case Keyboard.P: // Cetak Form
								parentApplication.f_refreshIDmodule(dg);
								if(m[module].child.cmbjenislaporan.selectedIndex >= 0)
									parentApplication.F_openReport(m[module].child.a[0], m[module].child.a[1], m[module].child.cmbjenislaporan.selectedItem.ritem, m[module].child.f_filterdata());
								break;
							case Keyboard.R: // Reset Form
								o.f_kondisiAwal();
								break;
						}
					}
					else
					{
						switch(e.keyCode)
						{
							case Keyboard.HOME:
								if(int(o.txtpaging.text)>1)
									parentApplication.f_formDataTampil();
								break;
							case Keyboard.PAGE_UP:
								if(int(o.txtpaging.text)-1>0)
									parentApplication.f_formDataTampil(int(o.txtpaging.text)-1);
								break;
							case Keyboard.PAGE_DOWN:
								parentApplication.f_formDataTampil(int(o.txtpaging.text)+1);
								break;
							case Keyboard.END:
								parentApplication.f_formDataTampil(-1);
								break;
							case Keyboard.F5:
								parentApplication.f_refreshIDmodule(dg);
								if(int(m[module].child.txtpaging.text) == 0)
									parentApplication.f_formDataTampil(1);
								else
									parentApplication.f_formDataTampil(int(m[module].child.txtpaging.text)); 
								break;
						}
					}
				}
				
				function f_firstCLICK():void
				{
					if(imgfirst.enabled)
					{
						f_setData(1);
					}
				}
				
				function f_previousCLICK():void
				{
					if(imgprevious.enabled)
					{
						f_setData(int(txtpaging.text) - 1);
					}
				}
				
				function f_nextCLICK():void
				{
					if(imgnext.enabled)
					{
						f_setData(int(txtpaging.text) + 1);
					}
				}
				
				function f_lastCLICK():void
				{
					if(imglast.enabled)
					{
						f_setData(-1);
					}
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
					{
						if(int(txtpaging.text) > 0)
						{
							f_setData(int(txtpaging.text));
						}
					}
				}
				
				// Config Menu Bar
				var arrMenuBar:ArrayCollection = new ArrayCollection([
					{label:"Simpan", icon:"tbsave"},
					{label:"Reset", icon:"tbreset"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_MBsimpan); // tampil
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_reset); // reset
				
				var arrMenuBar2:ArrayCollection = new ArrayCollection([
					{label:"Ambil File", icon:"tbexcel"},
					{label:"Pilih Sheet", icon:"tbexcel"}]);
				parentApplication.F_settingmb(mbpopup, arrMenuBar2);
				mbpopup.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_ambilfile); // tampil
				mbpopup.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_pilihsheet); // tampil
				
				function f_MBsimpan():void
				{
					f_simpan();
				}
				
				function f_ambilfile():void
				{
					lblpleasewait.visible = true;
					ttwpopup.visible = false;
					var arr:Array = [];
					arr.push(new FileFilter("Excel File", "*.xls"));
					fileReference.browse(arr);
				}
				
				function f_reset():void
				{
					parentApplication.f_refreshIDmodule(dg);
					sumber = m[module].child.a[3].toLowerCase();
					m[module].child.f_kondisiAwal();
				}
				
				function f_pilihsheet():void
				{ 
					if(cmbsheet.textInput.text.length > 0)
					{ 
						lblpleasewait.visible = true;
						ttwpopup.visible = false;
						callLater(F_SetDataExcel);
					} 
					else
					{
						Alert.show("Ambil file dulu", "Informasi");
					}
				}
			}
			
			public var tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal;
			public function f_simpan():void
			{
				var utama:String;
				ulang = 0;
				u = new ArrayCollection();
				
				for(i=1;i<sheet.values.length;i++)
				{
					if(sheet.values.getItemAt(i).chk || cbxsemuadata.selected)
					{
						u.addItem({rwid:0, rwcabang:parentApplication.ucabang, rwlokasi:parentApplication.ulokasi, rwsumber:"RW", 
							rwkodepa:0, rwsopir:0, rwstatussebelumnya:0, rwjmlrevisi:0, rwharga:0, rwcetakanke:0, rwinputuser:parentApplication.userid, 
							rwmodifikasiuser:0, rwmodifikasitgl:tglDB, rwposting:0, rwpostingtgl:tglDB, rwisclose:0, rwcustomtext1:'', rwcustomtext2:'', 
							rwcustomtext3:'', rwcustomtext4:'', rwcustomtext5:'', rwcustomint1:0, rwcustomint2:0, rwcustomint3:0, rwcustomdbl1:0, 
							rwinputtgl:tglDB,
							rwcustomdbl2:0, rwcustomdbl3:0, rwcustomdate1:parentApplication.m.DateFirst, rwcustomdate2:parentApplication.m.DateFirst, rwcustomdate3:parentApplication.m.DateFirst,
							rwnoref:imp(i, "No Ref"),
							rwtglnoref:imp(i, "Tgl No Ref"),
							rwnopol:imp(i, "No Pol"),
							rwkodebarang:imp(i, "Kode Barang"),
							rwkodecustomer:imp(i, "Kode Customer"),
							rwkodesopir:imp(i, "Kode Sopir"),
							rwbruto:imp(i, "Bruto"),
							rwtanggalbruto:imp(i, "Tanggal Bruto"),
							rwtara:imp(i, "Tara"),
							rwtanggaltara:imp(i, "Tanggal Tara"),
							rwneto:imp(i, "Neto"),
							rwcatatan:imp(i, "Catatan")}); 
					}
				}
				
				if(u.length == 0)
				{
					Alert.show("Tidak ada data yang di pilih untuk di simpan", "Informasi");
					return;
				}
				
				for(i=0;i<u.length;i++)
				{
					u.getItemAt(i).pesan = "Total (" + (i+1) + "-" + u.length + ") : No Ref " + u.getItemAt(i).rwnoref;
				}
				
				with(u.getItemAt(ulang))
				{
					a = [rwid, rwcabang, rwlokasi, rwsumber, 1, "Auto", 
						parentApplication.F_tglFormatDB(tglDB), 
						1, rwnopol, rwkodebarang, rwkodecustomer, rwtanggalbruto, rwbruto, rwtanggaltara, 
						rwtara, rwtara, rwharga, rwkodesopir, uraian, rwcatatan, 
						rwnoref, rwtglnoref, 2, rwstatussebelumnya, 
						rwjmlrevisi, rwcetakanke, rwinputuser, rwinputtgl, 
						rwmodifikasiuser, rwmodifikasitgl, rwposting,
						rwpostingtgl,
						rwisclose, rwcustomtext1, rwcustomtext2, 
						rwcustomtext3, rwcustomtext4, rwcustomtext5, rwcustomint1, rwcustomint2, rwcustomint3, rwcustomdbl1, 
						rwcustomdbl2, rwcustomdbl3, parentApplication.F_tglFormatDB(rwcustomdate1), parentApplication.F_tglFormatDB(rwcustomdate2),
						parentApplication.F_tglFormatDB(rwcustomdate3)];
				}
				
				FlexGlobals.topLevelApplication.F_openProgressUpload(u.length, "RW Import", true);
				FlexGlobals.topLevelApplication.F_sendProgress(u[ulang].pesan, true);
				utama = parentApplication.F_splitArrayToString(a);
				parentApplication.F_wsSimpan("simpan", "M3_RwSimpan", parentApplication.userid, 0, utama);
				
				function imp(idx:int, data:String):String
				{
					return sheet.getCell(idx, f_nomap(data)).value;
//					return sheet.values.getItemAt(idx)[f_map(data)];
				}
				
				function f_map(data:String = ""):String
				{
					var n:int;
					for(n=0;n<dgMapping.dataProviderLength;n++)
					{
						if(dgMapping.dataProvider.getItemAt(n).namakolom  == data)
						{
							return dgMapping.dataProvider.getItemAt(n).kolomsumber;
						}
					}
					
					return "";
				}
				
				function f_nomap(data:String = ""):int
				{
					var n:int;
					for(n=0;n<dgMapping.dataProviderLength;n++)
					{
						if(dgMapping.dataProvider.getItemAt(n).namakolom  == data)
						{
							return dgMapping.dataProvider.getItemAt(n).nosumber;
						}
					}
					
					return -1;
				}
			}
			
