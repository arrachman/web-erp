			public function fileReference_complete(evt:Event):void 
			{
				var excelFile:ExcelFile = new ExcelFile();
				var sheet:Sheet;
				frname = fileReference.name;
				bytearrayexcel = fileReference.data;
				
				excelFile.loadFromByteArray(bytearrayexcel);
				sheet = excelFile.sheets[0];
				cmbsheet.dataProvider.removeAll();
				
				for(i=0;i<excelFile.sheets.length; i++)
				{
					sheet = excelFile.sheets[i];
					cmbsheet.dataProvider.addItem({l:sheet.name})
				}
				
				cmbsheet.selectedIndex = 0;
				lblnamafile.text = frname;
				
				lblpleasewait.visible = false;
				ttwpopup.visible = true;
			}
						
			public var LabelField:Object = new Object;
			public var kolomexcelsama:Boolean;
			public var arrdflengtth:int;
			public var namakolom:String = "";
			public var datafield:String = "";
			public var excelFile:ExcelFile = new ExcelFile();
			public var sheet:Sheet;
			public var myColumn:GridColumn; 
			
			public function F_SetDataExcel():void
			{
				grpimport.visible = false;
				//Ambil Byte Array file excel yang terpilih
				excelFile.loadFromByteArray(bytearrayexcel);
				
				//ambil sheet pertama
				sheet = excelFile.sheets[cmbsheet.selectedIndex];
				
				//variabel jumlah baris dan jumlah kolom
				
				//Set nama kolom dan jumlah kolom dgImport==============================================================
				//hapus kolom terlebih dahulu sebelum direplace
				for(i=dgImport.columnsLength -1; i>0; i--)
				{
					dgImport.columns.removeItemAt(i);
				}
				
				//Set nama kolom dan datafield dalam string
				for(i=0; i < sheet.cols; i++)
				{
					if(namakolom.length == 0)
					{
						namakolom = sheet.getCell(0,i).value;
					}
					else
					{
						namakolom += "," + sheet.getCell(0, i).value;
					}
					
					if(datafield.length == 0) 
					{
						datafield = sheet.getCell(0, i).value.toString().split(" ").join("").toString().toLowerCase();
					}
					else
					{
						datafield += "," + sheet.getCell(0,i).value.toString().split(" ").join("").toString().toLowerCase();
					}
				}
				
				datafield = datafield.split("[%]").join("persen");
				datafield = datafield.split("(%)").join("persen");
				datafield = datafield.split("%").join("persen");

				ArrayNamaKolom = namakolom.split(","); //split penamaan kolom ke dalam bentuk array
				ArrayDataField = datafield.split(","); //split datafield kolom ke dalam bentuk array
				
				//set kolom di dgImport ==============================================================================
				for each (var field:String in ArrayNamaKolom)  
				{  
					myColumn = new GridColumn(); 
					myColumn.width = 150;
					myColumn.editable = false;
					myColumn.headerText = field;
					field = field.split(" ").join("");
					field = field.split("[%]").join("persen");
					field = field.split("(%)").join("persen");
					field = field.split("%").join("persen");
					myColumn.dataField = field.toLowerCase();
					dgImport.columns.addItem(myColumn);
				} 
				gridColumns.refresh();  
				
				makspaging = int(sheet.rows/jmlpaging);
				
				dgImport.dataProvider.removeAll();
				f_setData(1);
				acKolomSumber.removeAll();
				
				if(ArrayNamaKolom.length > 0)
				{
					for(i=0;i<ArrayNamaKolom.length;i++)
					{
						acKolomSumber.addItem({l:ArrayNamaKolom[i], v:ArrayDataField[i], n:i});
					}
					
					acKolomSumber.addItem({l:"", v:"", n:-1});
					
					for(i=0;i<dgMapping.dataProviderLength;i++)
					{
						for(arrdflengtth=0;arrdflengtth < ArrayDataField.length;arrdflengtth ++)
						{
							kolomexcelsama = false;
							if(dgMapping.dataProvider[i].kolomexcel == ArrayNamaKolom[arrdflengtth])
							{
								dgMapping.dataProvider[i].kolomsumber = ArrayDataField[arrdflengtth];
								dgMapping.dataProvider[i].nosumber = arrdflengtth;
								kolomexcelsama = true;
								break;
							}
						}
						
						if(!kolomexcelsama)
						{
							dgMapping.dataProvider[i].kolomsumber = "";
						}
					}
					
					FlexGlobals.topLevelApplication.F_dgRefresh(dgMapping);
				}
				
				function f_setDatatoGrid(row:int, column:int):void
				{
					LabelField = new Object;
					if(sheet.rows == 0)
					{ 
						return;
					}
					
					if(sheet.getCell(row,0).value.length == 0)
					{
						return;
					}
					
					for(i=0;i<sheet.cols;i++)
					{
						LabelField[ArrayDataField[i]] = sheet.getCell(row, i).value;
					}
					
					dgImport.dataProvider.addItem(LabelField);
					
					if(row == 20)
					{
						if(row < (sheet.rows - 1))
						{
							txtpaging.text = "1";
							imgnext.enabled = true;
							imglast.enabled = true;
						}
						return;
					}
						
					if(row < (sheet.rows - 1))
					{
						row ++;
						f_setDatatoGrid(row, column);
					}
				}
			}
			
			public function f_setData(pagingData:int):void
			{
				var row:int = 0, n:int = 0;
				var barisperulangan:int = 0, jlmperulangan:int = 0;
				txtpaging.text = String(pagingData);
				
				if(sheet.rows == 0)
				{ 
					return;
				}
				
				if(sheet.getCell(rowindex, 0).value.length == 0)
				{
					return;
				}
				
				if(pagingData < 0)
				{
					txtpaging.text = String(makspaging);
					pagingData = makspaging;
					imgfirst.enabled = true;
					imgprevious.enabled = true;
					imgnext.enabled = false;
					imglast.enabled = false;
					dgImport.dataProvider.removeAll();
					
					pagingData = pagingData - 1;
					barisperulangan = (pagingData*jmlpaging)+1;
					jlmperulangan = ((pagingData*jmlpaging)+jmlpaging);
					for(row = barisperulangan; row <= jlmperulangan ; row++)
					{
						LabelField = new Object;
						for(i=0;i<sheet.cols;i++)
						{
							LabelField[ArrayDataField[i]] = sheet.getCell(row, i).value;
						}
						
						LabelField["rowexcel"] = row;
						
						if(cbxsemuadata.selected)
						{
							LabelField["chk"] = true;
						}
						else
						{
							LabelField["chk"] = sheet.values.getItemAt(row).chk;
						}
						dgImport.dataProvider.addItem(LabelField);
					}
				}
				else if(pagingData <= makspaging)
				{
					if(pagingData == 1)
					{
						imgfirst.enabled = false;
						imgprevious.enabled = false;
					}
					
					if(pagingData > 1)
					{
						imgfirst.enabled = true;
						imgprevious.enabled = true;
					}
					
					if(pagingData < makspaging)
					{
						imgnext.enabled = true;
						imglast.enabled = true;
					}
					
					if(pagingData == makspaging)
					{
						imgnext.enabled = false;
						imglast.enabled = false;
					}
					
					dgImport.dataProvider.removeAll();
					if(pagingData == 1)
					{
						barisperulangan = 1;
						jlmperulangan = jmlpaging;
					}
					else
					{
						pagingData = pagingData - 1;
						barisperulangan = (pagingData*jmlpaging)+1;
						jlmperulangan = ((pagingData*jmlpaging)+jmlpaging);
					}
					
					for(row = barisperulangan; row <= jlmperulangan ; row++)
					{
						LabelField = new Object;
						for(i=0;i<sheet.cols;i++)
						{
							LabelField[ArrayDataField[i]] = sheet.getCell(row, i).value;
						}
						
						LabelField["rowexcel"] = row;
						
						if(cbxsemuadata.selected)
						{
							LabelField["chk"] = true;
						}
						else
						{
							LabelField["chk"] = sheet.values.getItemAt(row).chk;;
						}
						
						dgImport.dataProvider.addItem(LabelField);
					}
				}
				else
				{
					imgfirst.enabled = true;
					imgprevious.enabled = true;
					imgnext.enabled = false;
					imglast.enabled = false;
					dgImport.dataProvider.removeAll();
				}
			}
			
			protected function cbxsemuadata_clickHandler(event:MouseEvent):void
			{
				if(!cbxsemuadata.selected)
				{
					for(i=0; i<sheet.values.length; i++)
					{
						sheet.values.getItemAt(i).chk = false;
					}
				}
				
				for(i=0; i<dgImport.dataProviderLength; i++)
				{
					dgImport.dataProvider.getItemAt(i).chk = cbxsemuadata.selected;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgImport);
			}
			
