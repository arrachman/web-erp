<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	<fx:Script>
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String,pesanAlertIng:String, img:Image,UFungsional:String, 
			i:int,isUpdate:Boolean, hf:Object;
			[Bindable] public var o:Object={},no:int;
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number, getNotransaksi:String, vSelisih:Number = 0, vSelisihValas:Number = 0;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction(2, "Jm");
			[Bindable]protected var arrMenuBar:ArrayCollection;
			
			public function f_focusOnMe():void
			{
				txturaian.setFocus();
			}
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "calculator":
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						if(Number(data) > 0){
							if(txtmatauang.text == UFungsional){
								if(dataField == 'debitvalas'){
									Alert.show(FlexGlobals.topLevelApplication.l('Debit Valas harus 0 karena mata uang fungsional'), FlexGlobals.topLevelApplication.l('Informasi'));
									dg.dataProvider[dg.selectedCell.rowIndex].debitvalas = 0;
								}
								if(dataField == 'kreditvalas'){
									Alert.show(FlexGlobals.topLevelApplication.l('Kredit Valas harus 0 karena mata uang fungsional'), FlexGlobals.topLevelApplication.l('Informasi'));
									dg.dataProvider[dg.selectedCell.rowIndex].kreditvalas = 0;
								}
							}else{
								if(dataField == 'debitvalas'){
									dg.dataProvider[dg.selectedCell.rowIndex].debitvalas = data;
									dg.dataProvider[dg.selectedCell.rowIndex].debit = dg.dataProvider[dg.selectedCell.rowIndex].debitvalas * o.txtkurs;
									dg.dataProvider[dg.selectedCell.rowIndex].kredit = 0;
									dg.dataProvider[dg.selectedCell.rowIndex].kreditvalas = 0;
									
								}
								if(dataField == 'debit'){
									dg.dataProvider[dg.selectedCell.rowIndex].debit = data;
									dg.dataProvider[dg.selectedCell.rowIndex].debitvalas = dg.dataProvider[dg.selectedCell.rowIndex].debit / o.txtkurs;
									dg.dataProvider[dg.selectedCell.rowIndex].kredit = 0;
									dg.dataProvider[dg.selectedCell.rowIndex].kreditvalas = 0;
									
								}
								if(dataField == 'kreditvalas'){
									dg.dataProvider[dg.selectedCell.rowIndex].kreditvalas = data;
									dg.dataProvider[dg.selectedCell.rowIndex].kredit = dg.dataProvider[dg.selectedCell.rowIndex].debitvalas * o.txtkurs;
									dg.dataProvider[dg.selectedCell.rowIndex].debit = 0;
									dg.dataProvider[dg.selectedCell.rowIndex].debitvalas = 0;
								}
								if(dataField == 'kredit'){
									dg.dataProvider[dg.selectedCell.rowIndex].kredit = data;
									dg.dataProvider[dg.selectedCell.rowIndex].kreditvalas = dg.dataProvider[dg.selectedCell.rowIndex].kredit / o.txtkurs;
									dg.dataProvider[dg.selectedCell.rowIndex].debit = 0;
									dg.dataProvider[dg.selectedCell.rowIndex].debitvalas = 0;
									
								}
							}
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
			}
			protected function f_persiapan():void
			{
				tab.focusEnabled = false ; 
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RequiredLabel([ttanggal, tnotransaksi, tmatauang, tprogress, tkurs]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([ttanggal, tnotransaksi, tmatauang, tprogress, turaian, tkontakperson, tcatatan]);
				
				UFungsional= FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				
				if(FlexGlobals.topLevelApplication.getSetting(2, 'options', 'LokasiJM') == 1)
				{
					tlokasi.text = FlexGlobals.topLevelApplication.getSetting(2, 'options', 'LabelLokasiJM');
					FlexGlobals.topLevelApplication.F_RequiredLabel([tlokasi]);
					FlexGlobals.topLevelApplication.F_txtpencarian([txtlokasi]);
					tlokasi.visible = true;
					txtlokasi.visible = true;
					lbllokasi.visible = true;
				}
				else
				{
					tlokasi.visible = false;
					txtlokasi.visible = false;
					lbllokasi.visible = false;
				}
				
				hf = FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				parentApplication.F_DateFieldStandard([dttgl]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtmatauang]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,chkauto,chkposting]);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLink);
				
				function f_mbSimpan():void{
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(mb.menuBarItems[0].enabled){
						if(FlexGlobals.topLevelApplication.apaBisaAkses(2,138,jenissimpan)){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Jm")
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal();
					mb.menuBarItems[3].enabled=false;
					mb.menuBarItems[4].enabled=false;
				}
				
				function f_mbCatatan():void{
					if(mb.menuBarItems[3].enabled)FlexGlobals.topLevelApplication.F_OpenNotes(o.jmsumber,o.jmid,txtnotransaksi.text);
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled)FlexGlobals.topLevelApplication.F_OpenUploadFile('Jm', o.jmid,txtnotransaksi.text);
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled)FlexGlobals.topLevelApplication.f_mbLinks(2,'Jm');
				}
				
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
					if(event.keyCode == Keyboard.ENTER){
						dg.setFocus();
						dg.setSelectedCell(0,1);
					}
				}
				);
				
				FlexGlobals.topLevelApplication.F_RegGrid(2,138,[dg],'transaksi');
				f_validasi();
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "JM");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M2_JmHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
							FlexGlobals.topLevelApplication.F_wsGetDataById('copyTransaksi', 'M2_JmGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M2_JmGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
					
				}
			}
			
			protected function f_kondisiAwal():void
			{
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				lbllokasi.text = FlexGlobals.topLevelApplication.ulokasinama;
				o.jmlokasi=FlexGlobals.topLevelApplication.ulokasi;
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "JM");
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				cmbprogress.enabled = true;
				txtnotransaksi.text = 'Auto';
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotaldebit,lbltotaldebitvalas,lbltotalkredit,lbltotalkreditvalas],FlexGlobals.topLevelApplication.m.nfNominal.format('0'));
				isUpdate = false;
				txturaian.setFocus();
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("JM");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("JM",1);
				parentApplication.F_SetNilaiText([dttgl], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtkontakperson]);
				
				o.jmid=0; o.jmcabang=parentApplication.ucabang; o.jmlokasi=parentApplication.ulokasi; o.jmsumber='JM'; o.jmkodepa=0;
				o.jmdebit=0; o.jmkredit=0; o.jmdebitvalas; o.jmkreditvalas; o.jmjumlahbayar=0; o.jmjumlahbayarvalas=0; o.jmstatusbayar=0; o.jmtgllunas=FlexGlobals.topLevelApplication.m.DateFirst; o.jmstatussebelumnya=0;
				o.jmjmlrevisi=0; o.jmcetakanke=0; 
				o.jmisclose=0; o.jminputuser=FlexGlobals.topLevelApplication.userid; o.jminputtgl=FlexGlobals.topLevelApplication.DefaultTanggal; o.jmmodifikasiuser=0; 
				o.jmmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal;
				o.jmcustomtext1 = ''; o.jmcustomtext2 = ''; o.jmcustomtext3 = ''; o.jmcustomtext4 = ''; o.jmcustomtext5 = '';
				o.jmcustomint1= 0; o.jmcustomint2= 0; o.jmcustomint3= 0; o.jmcustomdbl1= 0; o.jmcustomdbl2= 0; o.jmcustomdbl3= 0;
				o.jmcustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; o.jmcustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst;
				o.jmcustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				
				
				for(i=0; i<dg.dataProviderLength; i++){
					dg.dataProvider.getItemAt(i).noakun=''; 
					dg.dataProvider.getItemAt(i).debit=0;
					dg.dataProvider.getItemAt(i).kredit=0;
				}
				
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(2,138,jenissimpan)){
								f_simpan();
							}
						}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case "debit":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								debitvalas = Number(debit) /o.txtkurs;
								kredit = 0;
								kreditvalas = 0;
							}else{
								debitvalas = 0;
								kredit = 0;
								kreditvalas = 0;
							}
						}
						break;
					case "debitvalas":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								debit = Number(debitvalas) * o.txtkurs;
								kredit = 0;
								kreditvalas = 0;
							}else{
								debitvalas = 0;
								kredit = 0;
								kreditvalas = 0;
							}
						}
						break;
					case "kredit":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								kreditvalas = Number(kredit) /o.txtkurs;
								debit = 0;
								debitvalas = 0;
							}else{
								kreditvalas = 0;
								debit = 0;
								debitvalas = 0;
							}
						}
						break;
					case "kreditvalas":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								kredit = Number(kreditvalas) * o.txtkurs;
								debit = 0;
								debitvalas = 0;
							}else{
								kreditvalas = 0;
								debit = 0;
								debitvalas = 0;
							}
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode ="'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case "txtlokasi":
						paket = "CdM1_Location";
						wsfilter = 'laktif=1 AND lkode="'+txtlokasi.text+'"';
						csfilter = 'laktif=1';
						//csfield = 2;
						sort = 'lkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kakodekontak ="'+txtkontakperson.text+'"';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif=1 AND tnsumber="JM"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case "kontakkode":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif=1 and kkode ="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).kontakkode+'"';
						csfilter = 'kaktif=1';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "noakun": //no rek
						paket = "CdM1_Coa";
						wsfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).noakun+'"';
						csfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						sort = 'cnomor asc';
						break;
					case "catatan":
						paket = "CdM1_Transaction_Note_Detail";
						csfilter = 'tndaktif=1 AND tndsumber="JM"';
						sort = 'tndsumber asc';
						break;
					case "costcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi": // Divisi
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi": //sub divisi
						paket = "CdM1_Subdivision";
						wsfilter = 'sdkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'" AND sdaktif=1';
						csfilter = 'sdaktif=1 AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						sort = 'sdkode asc';
						break;
					case "proyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess){
					switch(s){	
						case "txtlokasi":
							ws = parentApplication.wsArrUtama.getItemAt(0)
							txtlokasi.text = ws.lkode;
							o.jmlokasi = ws.lkode;
							lbllokasi.text = ws.lnama;
							break;
						case "txtkontakperson":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkontakperson.text = parentApplication.wsArrUtama.getItemAt(0).kakodekontak;
							break;
						case "txtcatatan":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcatatan.text = ws.tncatatan;
							break;
						case "txtmatauang":
							txtkurs.text = "          ";
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtmatauang.text = ws.ckode;
							o.txtkurs = ws.ckurs;
							txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
							if(txtmatauang.text != UFungsional){
								txtkurs.enabled = true;
								for(i=0;i<dg.dataProvider.length;i++){
									dg.dataProvider.getItemAt(i).debitvalas = dg.dataProvider.getItemAt(i).debit/o.txtkurs;
									dg.dataProvider.getItemAt(i).kreditvalas = dg.dataProvider.getItemAt(i).kredit/o.txtkurs;
								}
							}else{
								txtkurs.enabled = false;
								for(i=0;i<dg.dataProvider.length;i++){
									dg.dataProvider.getItemAt(i).debitvalas = FlexGlobals.topLevelApplication.m.nfNominal.format(0);
									dg.dataProvider.getItemAt(i).kreditvalas = FlexGlobals.topLevelApplication.m.nfNominal.format(0);
								}
							}
							for (i=0; i<dg.dataProvider.length; i++) {
								dg.dataProvider.getItemAt(i).matauang = txtmatauang.text;
								dg.dataProvider.getItemAt(i).kurs = o.txtkurs;
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dg);
							break;
						case "kontakkode":
							ws = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0);
							dg.dataProvider.getItemAt(parentApplication.rowIndex).kontakkode = ws.kkode;
							dg.dataProvider.getItemAt(parentApplication.rowIndex).kontaknama = ws.knama;
							dg.dataProvider.getItemAt(parentApplication.rowIndex).kontak = ws.kid;
							FlexGlobals.topLevelApplication.F_dgRefresh(dg)
							break;
						case "noakun":
							ws = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0);
							dg.dataProvider.getItemAt(parentApplication.rowIndex).noakun = ws.cnomor;
							dg.dataProvider.getItemAt(parentApplication.rowIndex).namaakun = ws.cnama;
							//dg.dataProvider.getItemAt(parentApplication.rowIndex).debit = 0;
							//dg.dataProvider.getItemAt(parentApplication.rowIndex).kredit = 0;
							//dg.dataProvider.getItemAt(parentApplication.rowIndex).debitvalas = 0;
							//dg.dataProvider.getItemAt(parentApplication.rowIndex).kreditvalas = 0;
							
							if (vSelisih > 0){
								dg.dataProvider.getItemAt(parentApplication.rowIndex).debit = 0;
								dg.dataProvider.getItemAt(parentApplication.rowIndex).kredit = vSelisih;
								dg.dataProvider.getItemAt(parentApplication.rowIndex).debitvalas = 0;
								dg.dataProvider.getItemAt(parentApplication.rowIndex).kreditvalas = vSelisihValas;
							}else{
								dg.dataProvider.getItemAt(parentApplication.rowIndex).debit = vSelisih * -1;
								dg.dataProvider.getItemAt(parentApplication.rowIndex).kredit = 0;
								dg.dataProvider.getItemAt(parentApplication.rowIndex).debitvalas = vSelisihValas * -1;
