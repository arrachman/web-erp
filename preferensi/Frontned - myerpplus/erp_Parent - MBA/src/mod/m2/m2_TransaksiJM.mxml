					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					
					if(txtlokasi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtlokasi,'Lokasi');
					if(txtnotransaksi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(txtmatauang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0 || o.txtkurs == 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					
					for(i = 0; i< dg.dataProviderLength; i++){
						if(dg.dataProvider[i].noakun.length <= 0){FlexGlobals.topLevelApplication.msgAlert(dg,'No Akun')};
						if(dg.dataProvider[i].debit == 0 && dg.dataProvider[i].kredit == 0){FlexGlobals.topLevelApplication.msgAlert(dg,'Jumlah Debit Kredit')};
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					
					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						validasi = false;						
					}
					f_hitungTotal();
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).debitvalas = dg.dataProvider.getItemAt(i).debit/o.txtkurs;
						dg.dataProvider.getItemAt(i).kreditvalas = dg.dataProvider.getItemAt(i).kredit/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).debitvalas = 0;
						dg.dataProvider.getItemAt(i).kreditvalas = 0;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}
			}
			public var vtotal:Number;
			public function f_hitungTotal():void
			{
				o.jmdebit = 0; o.jmdebitvalas = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).debit != undefined)o.jmdebit += Number(dg.dataProvider.getItemAt(i).debit);
					if(dg.dataProvider.getItemAt(i).debitvalas != undefined)o.jmdebitvalas += Number(dg.dataProvider.getItemAt(i).debitvalas)
				}
				
				lbltotaldebit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.jmdebit);
				lbltotaldebitvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.jmdebitvalas)
				
				
				o.jmkredit = 0; o.jmkreditvalas = 0; 
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).kredit != undefined)o.jmkredit += Number(dg.dataProvider.getItemAt(i).kredit);
					if(dg.dataProvider.getItemAt(i).kreditvalas != undefined)o.jmkreditvalas += Number(dg.dataProvider.getItemAt(i).kreditvalas);
				}
				lbltotalkredit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.jmkredit);
				lbltotalkreditvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.jmkreditvalas)
				
				vSelisih = o.jmdebit - o.jmkredit;
				vSelisihValas = o.jmdebitvalas - o.jmkreditvalas;
				
			}
			
