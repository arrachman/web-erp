			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi){
						// Set Utama 
						with(o){
							a = [jmid, jmcabang, txtlokasi.text, jmsumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
								jmkodepa, txtkontakperson.text, txturaian.text, txtcatatan.text, txtmatauang.text, o.txtkurs, 
								jmdebit, jmdebitvalas, jmkredit, jmkreditvalas, jmjumlahbayar, jmjumlahbayarvalas, jmstatusbayar, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(jmtgllunas), cmbprogress.selectedItem.v, jmstatussebelumnya, 
								jmjmlrevisi, jmcetakanke, jmisclose, jminputuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(jminputtgl), jmmodifikasiuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(jmmodifikasitgl), int(chkposting.selected), jmcustomtext1, jmcustomtext2, jmcustomtext3, 
								jmcustomtext4, jmcustomtext5, jmcustomint1, jmcustomint2, jmcustomint3, jmcustomdbl1, jmcustomdbl2, 
								jmcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(jmcustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(jmcustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(jmcustomdate3)];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
						// Set Detail
						for(i=0;i<dg.dataProviderLength;i++)
							with(dg.dataProvider.getItemAt(i)){
								a = [idjmdetail, idjm, kontak, noakun, txtmatauang.text, o.txtkurs, debit, debitvalas, 
									kredit, kreditvalas, catatan, costcenter, divisi, subdivisi, proyek, 
									i+1, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
									customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_JmSimpan", parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
