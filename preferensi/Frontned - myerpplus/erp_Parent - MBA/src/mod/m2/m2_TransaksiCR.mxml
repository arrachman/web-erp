			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtterimadari":parentApplication.F_KosongkanText([txtterimadari, lblterimadari]);break;
					case "txtakunkas":parentApplication.F_KosongkanText([txtakunkas, lblakunkas]);break;
					case "txtmatauang":parentApplication.F_KosongkanText([txtmatauang]);break;
					case "txtlokasi":parentApplication.F_KosongkanText([txtlokasi, lbllokasi]);break;
				}
			}
			
			protected function f_simpan():void
			{
				var	a:Array, utama:String, detail:String, tgl:String;
				o.tanggal = dttgl.text;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi){
							// Set Utama
							with(o){
								a = [crid, crcabang, txtlokasi.text, crsumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
									crkodepa, crkontak, txtkontakperson.text, txtakunkas.text, txturaian.text, txtcatatan.text, txtmatauang.text, 
									o.txtkurs, crjumlah, crjumlahvalas, crjumlahbayar, crjumlahbayarvalas, crstatusbayar, FlexGlobals.topLevelApplication.F_tglFormatDB(crtgllunas), 
									cmbprogress.selectedItem.v, crstatussebelumnya, crjmlrevisi, crcetakanke, crisclose, crinputuser, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(crinputtgl), 
									crmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(crmodifikasitgl), 
									int(chkposting.selected), crcustomtext1, crcustomtext2, crcustomtext3, crcustomtext4, 
									crcustomtext5, crcustomint1, crcustomint2, crcustomint3, crcustomdbl1, crcustomdbl2, crcustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(crcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(crcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(crcustomdate3)];
								utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
							// Set Detail
							for(i=0;i<dg.dataProviderLength;i++)
								with(dg.dataProvider.getItemAt(i)){
									a = [idcrdetail , idcr, noakun, txtmatauang.text, o.txtkurs, jumlah, jumlahvalas, 
										catatan, costcenter, divisi, subdivisi, proyek, i+1, isclose, 
										customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							
								FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_CrSimpan", parentApplication.userid, isUpdate, utama, detail);
							
						}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = ""; 
					pesanAlertIng = '';
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					f_hitungTotal();
					
					if(txtlokasi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtlokasi,'Lokasi');
					if(txtnotransaksi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi, 'No Transaksi');
					if(txtterimadari.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtterimadari,'Terima Dari');
					for(i=0; i<dg.dataProviderLength; i++){
						if(dg.dataProvider.getItemAt(i).noakun.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dg,'No Akun');
//						if(dg.dataProvider.getItemAt(i).jumlah <= 0)FlexGlobals.topLevelApplication.msgAlert(dg,'Jumlah');
					}
					if(txtakunkas.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtakunkas,'Akun Kas [D]');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(txtmatauang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang, 'Mata Uang');
					if(txtkurs.text.length <= 0 || o.txtkurs == 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs, 'Kurs');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					
					
				}
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = dg.dataProvider.getItemAt(i).jumlah/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = 0;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}
			}
			public var vtotal:Number;
			public function f_hitungTotal():void
			{
				o.crjumlah = 0;
				o.crjumlahvalas = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).jumlah > 0)o.crjumlah += Number(dg.dataProvider.getItemAt(i).jumlah);
					if(dg.dataProvider.getItemAt(i).jumlahvalas > 0)o.crjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas);
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.crjumlah);
				lbltotalvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.crjumlahvalas);
			}
			
