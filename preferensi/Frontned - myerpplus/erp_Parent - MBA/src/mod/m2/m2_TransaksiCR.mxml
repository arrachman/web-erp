		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Button;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,b:Button,tt:TitleWindow, pesanAlert:String, pesanAlertIng:String, ftAkunSetting:String, UFungsional:String, img:Image, i:int, isUpdate:Boolean, hf:Object;
			public var o:Object = {},no:int;
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction(2, "Cr"), getNotransaksi:String;
			public function f_focusOnMe():void
			{
				txtterimadari.setFocus();
			}
			
			protected function f_persiapan():void
			{
				ftAkunSetting = FlexGlobals.topLevelApplication.getSetting(2, 'options', 'CRAkunTambahan');
				
				//mb.dataProvider = new ArrayCollection([{label:'Simpan', icon:tbsave}]);
				mb.dataProvider = new Array([{label:"simpan"}])
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				if(FlexGlobals.topLevelApplication.getSetting(2, 'options', 'LokasiCR') == 1)
				{
					tlokasi.text = FlexGlobals.topLevelApplication.getSetting(2, 'options', 'LabelLokasiCR');
					FlexGlobals.topLevelApplication.F_RequiredLabel([tlokasi]);
					FlexGlobals.topLevelApplication.F_txtpencarian([txtlokasi]);
					tlokasi.visible = true;
					txtlokasi.visible = true;
					lbllokasi.visible = true;
				}
				else
				{
					tlokasi.visible = false;
					txtlokasi.visible = false;
					lbllokasi.visible = false;
				}
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				parentApplication.F_DateFieldStandard([dttgl]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtterimadari, txtakunkas, txtmatauang]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,chkauto]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([takunkas, tterimadari, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tterimadari, takunkas, ttanggal, tnotransaksi, tmatauang, tprogress, turaian, tkontakperson, tcatatan]);
				tab.focusEnabled = false;

				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
//				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbbuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLink);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(2,3,jenissimpan)){
							f_simpan();
						}
					}
				}
				function f_mbbuka():void{
					if(mb.menuBarItems[1].enabled)FlexGlobals.topLevelApplication.f_bukaTransaksi('Cr');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
					mb.menuBarItems[3].enabled=false;
					mb.menuBarItems[4].enabled=false;
				}
				
				function f_mbCatatan():void{
					if(mb.menuBarItems[3].enabled)FlexGlobals.topLevelApplication.F_OpenNotes(o.crsumber,o.crid,txtnotransaksi.text);
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled)FlexGlobals.topLevelApplication.F_OpenUploadFile('CR', o.crid,txtnotransaksi.text);
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled)FlexGlobals.topLevelApplication.f_mbLinks(2,'Cr');
				}
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
					if(event.keyCode == Keyboard.ENTER){
						dg.setFocus();
						dg.setSelectedCell(0,1);
					}
				}
				);
				
				
				FlexGlobals.topLevelApplication.F_RegGrid(2,3,[dg],'transaksi');
				f_validasi();
				
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "CR");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M2_CrHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilkandata', 'M2_CrGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			protected function f_kondisiAwal():void
			{
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				lbllokasi.text = FlexGlobals.topLevelApplication.ulokasinama;
				o.crlokasi=FlexGlobals.topLevelApplication.ulokasi;
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "CR");
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				cmbprogress.enabled = true;
				txtnotransaksi.text = 'Auto';
				matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				kurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalvalas],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				txtakunkas.text = FlexGlobals.topLevelApplication.getSetting(0,'akun','Kas');
				lblakunkas.text = FlexGlobals.topLevelApplication.getSetting(0,'akunnama','Kas');
				isUpdate = false;
				txtterimadari.setFocus();
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("CR");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("CR",1);
				parentApplication.F_SetNilaiText([dttgl], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtterimadari, lblterimadari,txtkontakperson]);
				//set utama
				FlexGlobals.topLevelApplication.DefaultTanggal
				o.crid=0;o.crcabang=parentApplication.ucabang; o.crlokasi=parentApplication.ulokasi; o.crsumber='CR'; o.crkodepa=0; 
				o.crkontak=0; o.crjumlah=0; o.crjumlahvalas=0; o.crkurs=1;o.crjumlahbayar=0; o.crjumlahbayarvalas = 0; o.crstatusbayar=0;
				o.crtgllunas=FlexGlobals.topLevelApplication.m.DateFirst; o.crstatussebelumnya=0; o.crjmlrevisi=0; o.crcetakanke=0; 
				o.crisclose=0; o.crinputuser=FlexGlobals.topLevelApplication.userid; o.crinputtgl=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.crmodifikasiuser=0; o.crmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal;o.crcustomtext1=''; o.crcustomtext2=''; o.crcustomtext3=''; 
				o.crcustomtext4=''; o.crcustomtext5=''; o.crcustomint1=0; o.crcustomint2=0; o.crcustomint3=0; o.crcustomdbl1=0; o.crcustomdbl2=0;o.crcustomdbl3=0; 
				o.crcustomdate1=FlexGlobals.topLevelApplication.m.DateFirst; o.crcustomdate2=FlexGlobals.topLevelApplication.m.DateFirst; 
				o.crcustomdate3=FlexGlobals.topLevelApplication.m.DateFirst;
			
				
				for(i=0; i<dg.dataProviderLength; i++){
					dg.dataProvider.getItemAt(i).noakun=''; 
					dg.dataProvider.getItemAt(i).jumlah=0; 
				}
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(2,3,jenissimpan)){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "calculator":
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						if(Number(data) > 0){
							if(txtmatauang.text == UFungsional){
								if(dataField == 'jumlahvalas'){
									Alert.show(FlexGlobals.topLevelApplication.l('Jumlah Valas harus 0 karena mata uang fungsional'), FlexGlobals.topLevelApplication.l('Informasi'));
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = 0;
								}
								
							}else{
								if(dataField == 'jumlahvalas'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas * o.txtkurs;
									
								}
								if(dataField == 'jumlah'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = dg.dataProvider[dg.selectedCell.rowIndex].jumlah / o.txtkurs;
								}
							}
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case "jumlah":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
								if (txtmatauang.text != UFungsional){
									jumlahvalas = Number(jumlah) /o.txtkurs;
									
								}else{
									jumlahvalas = 0;
									
								}
						}
						
						break;
					case "jumlahvalas":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
								
							}else{
								jumlahvalas = 0;
								
							}
						}
						break
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtterimadari":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif=1 and kkode ="'+txtterimadari.text+'"';
						csfilter = 'kaktif=1';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtlokasi":
						paket = "CdM1_Location";
						wsfilter = 'laktif=1 AND lkode="'+txtlokasi.text+'"';
						csfilter = 'laktif=1';
						//csfield = 2;
						sort = 'lkode asc';
						break;
					case "txtkontakperson":
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+o.crkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.crkontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtmatauang":
						paket = 'CdM1_Currency';
						wsfilter = 'caktif=1 AND ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break
					case "txtcatatan":
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif=1 AND tnsumber="CR"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case "txtakunkas": // akun kas
						paket = 'CdM1_Coa';
						wsfilter = '(cgd = "D" and caktif = 1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor ="'+txtakunkas.text+'"' + " " + ftAkunSetting;
						csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")' + " " + ftAkunSetting;
						csfield = 0;
						sort = 'cnomor asc';
						break;
					case "noakun": //no rek
						paket = "CdM1_Coa";
						wsfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).noakun+'"';
						csfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						sort = 'cnomor asc';
						break;
					case "catatan":
						paket = "CdM1_Transaction_Note_Detail";
						csfilter = 'tndaktif=1 AND tndsumber="CR"';
						sort = 'tndcatatan asc';
						break;
					case "costcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi": // Divisi
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi": //sub divisi
						paket = "CdM1_Subdivision";
						wsfilter = 'sdkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'" AND sdaktif=1';
						csfilter = 'sdaktif=1 AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						sort = 'sddivisi asc';
						break;
					case "proyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess){
					switch(s){	
						case "txtlokasi":
							ws = parentApplication.wsArrUtama.getItemAt(0)
							txtlokasi.text = ws.lkode;
							o.crlokasi = ws.lkode;
							lbllokasi.text = ws.lnama;
							break;
						case "txtterimadari":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtterimadari.text = ws.kkode;
							lblterimadari.text = ws.knama;
							o.crkontak = ws.kid;
							break;
						case "txtkontakperson":
							txtkontakperson.text = parentApplication.wsArrUtama.getItemAt(0).kakodekontak;
							break;
						case "txtmatauang":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtkurs.text = "          ";
							txtmatauang.text = ws.ckode;
							o.txtkurs = ws.ckurs;
							txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
							if(txtmatauang.text != UFungsional){
								txtkurs.enabled = true;
								for(i=0;i<dg.dataProvider.length;i++){
									dg.dataProvider.getItemAt(i).jumlahvalas = dg.dataProvider.getItemAt(i).jumlah/o.txtkurs;
								}
							}else{
								txtkurs.enabled = false;
								for(i=0;i<dg.dataProvider.length;i++){
									dg.dataProvider.getItemAt(i).jumlahvalas = FlexGlobals.topLevelApplication.m.nfNominal.format(0);
								}
							}
							for (i=0; i<dg.dataProvider.length; i++) {
								dg.dataProvider.getItemAt(i).matauang = txtmatauang.text;
								dg.dataProvider.getItemAt(i).kurs = o.txtkurs;
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dg);
							break;
						case "txtakunkas":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtakunkas.text = ws.cnomor;
							lblakunkas.text = ws.cnama;
							f_hitungvalas();
							f_hitungTotal();
							break;
						case "txtcatatan":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcatatan.text = ws.tncatatan;
							break;
						case "noakun":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							var arr:Object = dg.dataProvider.getItemAt(parentApplication.rowIndex)
							
							arr.idno = ws.cid;
							arr.noakun = ws.cnomor;
							arr.namaakun = ws.cnama;
							arr.jumlah = FlexGlobals.topLevelApplication.m.nfNominal.format('0');
							arr.jumlahvalas = FlexGlobals.topLevelApplication.m.nfNominal.format('0');
							arr.matauang = txtmatauang.text;
							arr.kurs = o.txtkurs;
							arr.catatan = '';
							arr.costcenter ='';
							arr.divisi ='';
							arr.subdivisi ='';
							arr.proyek ='';
							arr.customtext1 = '';
							arr.customtext2= '';
							arr.customtext3= '';
							arr.customdbl1 = 0;
							arr.customdbl2 = 0;
							arr.customdbl3 = 0;
							arr.customdate1 = FlexGlobals.topLevelApplication.m.DateFirst;
							arr.customdate2 = FlexGlobals.topLevelApplication.m.DateFirst;
							arr.customdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
							arr.idcrdetail= 0;
							arr.idcr= 0;
							arr.isclose= 0;
							FlexGlobals.topLevelApplication.F_dgRefresh(dg);
							break;
						case "costcenter":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter = ws.cckode;
							parentApplication.F_dgRefresh(dg);
							break;
						
						case "divisi":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi = ws.dkode;
							parentApplication.F_dgRefresh(dg);
							break;
						case "subdivisi":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi = ws.sdkode;
