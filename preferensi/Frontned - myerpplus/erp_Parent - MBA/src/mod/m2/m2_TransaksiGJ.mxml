				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).debitvalas = dg.dataProvider.getItemAt(i).debit/o.txtkurs;
						dg.dataProvider.getItemAt(i).kreditvalas = dg.dataProvider.getItemAt(i).kredit/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).debitvalas = 0;
						dg.dataProvider.getItemAt(i).kreditvalas = 0;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}
			}
			public var vtotal:Number;
			public function f_hitungTotal():void
			{
					o.gjdebit = 0; o.gjdebitvalas = 0;
					for(i=0;i<dg.dataProviderLength;i++){
						if(dg.dataProvider.getItemAt(i).debit != undefined)o.gjdebit += Number(dg.dataProvider.getItemAt(i).debit);
						if(dg.dataProvider.getItemAt(i).debitvalas != undefined)o.gjdebitvalas += Number(dg.dataProvider.getItemAt(i).debitvalas)
					}
					
					lbltotaldebit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.gjdebit);
					lbltotaldebitvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.gjdebitvalas)
					
				
					o.gjkredit = 0; o.gjkreditvalas = 0; 
					for(i=0;i<dg.dataProviderLength;i++){
						if(dg.dataProvider.getItemAt(i).kredit != undefined)o.gjkredit += Number(dg.dataProvider.getItemAt(i).kredit);
						if(dg.dataProvider.getItemAt(i).kreditvalas != undefined)o.gjkreditvalas += Number(dg.dataProvider.getItemAt(i).kreditvalas);
					}
					lbltotalkredit.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.gjkredit);
					lbltotalkreditvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.gjkreditvalas)
					
					vSelisih = o.gjdebit - o.gjkredit;
					vSelisihValas = o.gjdebitvalas - o.gjkreditvalas;
						
			}
			
