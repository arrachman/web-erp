					o.rmjumlah = 0; o.rmjumlahvalas=0;
					for(i=0;i<dg1.dataProviderLength;i++){
						if(dg1.dataProvider.getItemAt(i).jumlah > 0)o.rmjumlah += Number(dg1.dataProvider.getItemAt(i).jumlah);
						if(dg1.dataProvider.getItemAt(i).jumlahvalas > 0)o.rmjumlahvalas += Number(dg1.dataProvider.getItemAt(i).jumlahvalas);
