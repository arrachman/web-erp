									dg1.dataProvider.getItemAt(parentApplication.rowIndex).proyek = '';
									parentApplication.F_dgRefresh(dg1);
								}
								break;
							case "tampil":
							case "simpan":
								Alert.show(FlexGlobals.topLevelApplication.l(parentApplication.wsErrmessage), FlexGlobals.topLevelApplication.l('Informasi'));
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtterimadari":parentApplication.F_KosongkanText([txtterimadari, lblterimadari]);break;
					case "txtakunbank":parentApplication.F_KosongkanText([txtakunbank, lblakunkas]);break;
					case "txtmatauang":parentApplication.F_KosongkanText([txtmatauang]);break;
					case "txtlokasi":parentApplication.F_KosongkanText([txtlokasi, lbllokasi]);break;
				}
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg1.dataProviderLength; i++){
						dg1.dataProvider.getItemAt(i).jumlahvalas = dg1.dataProvider.getItemAt(i).jumlah/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
					for (i=0; i<dg2.dataProviderLength; i++){
						dg2.dataProvider.getItemAt(i).jumlahvalas = dg2.dataProvider.getItemAt(i).jumlah/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg1.dataProviderLength; i++){
						dg1.dataProvider.getItemAt(i).jumlahvalas = 0;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
					for (i=0; i<dg2.dataProviderLength; i++){
						dg2.dataProvider.getItemAt(i).jumlahvalas = 0;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
				}
			}
			
			protected function f_simpan():void
			{
				var aj:Number;
				o.tanggal = dttgl.text;
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, giro:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled){
						validasiForm();
						if(validasi){
							
							//							Set Utama
							with(o){
								a = [rmid, rmcabang, txtlokasi.text, rmsumber, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
									rmkodepa, cmbcarabayar.selectedItem.v, rmkontak, txtkontakperson.text, txtakunbank.text, txturaian.text, txtcatatan.text, 
									txtmatauang.text, o.txtkurs, rmjumlah, rmjumlahvalas, rmjumlahbayar, rmjumlahbayarvalas, rmstatusbayar, 
									rmtgllunas, cmbprogress.selectedItem.v, rmstatussebelumnya, rmjmlrevisi, rmcetakanke, rmisclose, rminputuser, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(rminputtgl), rmmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(rmmodifikasitgl), int(chkposting.selected), customtext1, customtext2, customtext3, 
									customtext4, customtext5, customint1, customint2, customint3, customdbl1, customdbl2, 
									customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
							// Set Detail
							for(i=0;i<dg1.dataProviderLength;i++){
								with(dg1.dataProvider.getItemAt(i)){
									a = [idrmdetail, idrm, noakun, txtmatauang.text, o.txtkurs, jumlah, jumlahvalas, 
										catatan, costcenter, divisi, subdivisi, proyek, i+1, isclose, 
										customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detail =f_splitArrayToString(a);
									else detail += "▲"+f_splitArrayToString(a);
								}
							}
							
							// Set Giro
							if(cmbcarabayar.selectedIndex+1 !=2)giro='';
							else
								for (aj=0; aj<dg2.dataProviderLength; aj++){
									with (dg2.dataProvider.getItemAt(aj)){
										a= [idrmcarabayar, idrm, cmbcarabayar.selectedItem.v, txtmatauang.text, o.txtkurs, jumlah, jumlahvalas, 
											nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, norek, noakun, 
											FlexGlobals.topLevelApplication.getSetting(0,'akun','GiroMasuk'), txtcatatan.text, aj+1];
										
										if(aj == 0){
											giro = f_splitArrayToString(a);
										}
										else {
											giro += "▲"+f_splitArrayToString(a);
										}
									}
								}
							
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M2_RmSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+giro);
					
					}
				}
				
