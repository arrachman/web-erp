<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:net="flash.net.*"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()"
		  keyDown="f_keyDownModule(event)">
	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import itemEditor.ie_date;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.Image;
			import spark.components.TitleWindow;
			import spark.events.IndexChangeEvent;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String,pesanAlertIng:String, img:Image, ftAkunSetting:String,UFungsional:String, 
			i:int, isUpdate:Boolean, hf:Object;
			public var o:Object = {};
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction(2, "Rm"), getNotransaksi:String;
			
			public function f_focusOnMe():void
			{
				cmbcarabayar.setFocus();
			}
			
			protected function f_persiapan():void
			{
				ftAkunSetting = FlexGlobals.topLevelApplication.getSetting(2, 'options', 'RMAkunTambahan');
				
				if(FlexGlobals.topLevelApplication.getSetting(2, 'options', 'LokasiRM') == 1)
				{
					tlokasi.text = FlexGlobals.topLevelApplication.getSetting(2, 'options', 'LabelLokasiRM');
					FlexGlobals.topLevelApplication.F_RequiredLabel([tlokasi]);
					FlexGlobals.topLevelApplication.F_txtpencarian([txtlokasi]);
					tlokasi.visible = true;
					txtlokasi.visible = true;
					lbllokasi.visible = true;
				}
				else
				{
					tlokasi.visible = false;
					txtlokasi.visible = false;
					lbllokasi.visible = false;
				}
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RequiredLabel([takunbank, tterimadari, ttanggal, tnotransaksi, tmatauang, tprogress, tcarabayar, tkurs]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tcarabayar, tterimadari, takunbank, ttanggal, tnotransaksi, tmatauang, tprogress, turaian, tkontakperson, tcatatan]);
				
				tab.focusEnabled = false;
				
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
//				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional')
				cmbcarabayar.dataProvider = new ArrayCollection([{l:'TRANSFER', v:1}, {l:'CHECK / GIRO', v: 2}])
				parentApplication.F_DateFieldStandard([dttgl]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson]);
				parentApplication.F_ComboBoxStandard([cmbprogress,cmbcarabayar]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtterimadari, txtakunbank,txtmatauang]);
				parentApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,chkauto]);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLink);
				
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(2,5,jenissimpan)){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Rm");
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
					f_kondisiAwal(); 
					mb.menuBarItems[3].enabled = false;
					mb.menuBarItems[4].enabled = false;
				}
				
				function f_mbCatatan():void{
					if(mb.menuBarItems[3].enabled)FlexGlobals.topLevelApplication.F_OpenNotes(o.rmsumber,o.rmid,txtnotransaksi.text);
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled)FlexGlobals.topLevelApplication.F_OpenUploadFile('RM', o.rmid,txtnotransaksi.text);
				}
				function f_mbLink():void {
					if(mb.menuBarItems[5].enabled)FlexGlobals.topLevelApplication.f_mbLinks(2,'Rm');
				}
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
					if(event.keyCode == Keyboard.ENTER){
						dg1.setFocus();
						dg1.setSelectedCell(0,1);
					}
				}
				);
				
				cmbcarabayar.addEventListener(IndexChangeEvent.CHANGE,change);
				function change():void{
					if(cmbcarabayar.selectedIndex==1){
						tabGiro.enabled=true;
						txtakunbank.text = FlexGlobals.topLevelApplication.getSetting(0,'akun','GiroMasuk');
						lblakunkas.text = FlexGlobals.topLevelApplication.getSetting(0,'akunnama','GiroMasuk');
						lblcaptiontotal.visible = true;
						lbltotalgiro.visible = true;
						txtakunbank.enabled=false;
						lbltotalgirovalas.visible= true;
						lblcaptiongirovalas.visible = true;
						
					}else{
						tabGiro.enabled=false;
						txtakunbank.text = FlexGlobals.topLevelApplication.getSetting(0,'akun','Bank');
						lblakunkas.text = FlexGlobals.topLevelApplication.getSetting(0,'akunnama','Bank');
						lblcaptiontotal.visible = false;
						lbltotalgiro.visible = false;
						txtakunbank.enabled=true;
						lbltotalgirovalas.visible= false;
						lblcaptiongirovalas.visible = false;
					}
				}
				
				FlexGlobals.topLevelApplication.F_RegGrid(2,5,[dg1,dg2],'transaksi');
				f_validasi();
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "RM");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M2_RmHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M2_RmGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			
			protected function f_kondisiAwal():void
			{
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				lbllokasi.text = FlexGlobals.topLevelApplication.ulokasinama;
				o.rmlokasi=FlexGlobals.topLevelApplication.ulokasi;
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 2, "RM");
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				cmbprogress.enabled = true
				tab.selectedIndex=0;
				txtnotransaksi.text = 'Auto';
				lblcaptiontotal.visible = false;
				lbltotalgiro.visible = false;
				lbltotalgirovalas.visible= false;
				lblcaptiongirovalas.visible = false;
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				kurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				f_focusOnMe(); 
				txtakunbank.text = FlexGlobals.topLevelApplication.getSetting(0,'akun','Bank');
				lblakunkas.text = FlexGlobals.topLevelApplication.getSetting(0,'akunnama','Bank');
				cmbcarabayar.selectedIndex=0;
				tabGiro.enabled=false;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalgiro,lbltotalvalas,lbltotalgirovalas],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				isUpdate = false;
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("RM");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("RM",1);
				parentApplication.F_SetNilaiText([dttgl], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtterimadari, lblterimadari,txtkontakperson]);
				o.rmid=0; o.rmcabang=parentApplication.ucabang; o.rmlokasi=parentApplication.ulokasi; o.rmsumber='RM'; o.rmkodepa=0; o.rmkontak=0; o.rmjumlah=0;  o.rmjumlahvalas=0; o.jumlahgiro=0; o.jumlahgirovalas=0;
				o.rmjumlahbayar=0; o.rmjumlahbayarvalas=0;; o.rmstatusbayar=0; o.rmtgllunas=FlexGlobals.topLevelApplication.m.DateFirst; o.rmstatussebelumnya=0; o.rmjmlrevisi=0; o.rmcetakanke=0; 
				o.rmisclose=0; o.rminputuser=FlexGlobals.topLevelApplication.userid; o.rminputtgl=FlexGlobals.topLevelApplication.DefaultTanggal; o.rmmodifikasiuser=0, o.rmmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal;
				o.customtext1 = ''; o.customtext2 = ''; o.customtext3 = ''; o.customtext4 = ''; o.customtext5 = '';
				o.customint1 = 0; o.customint2 = 0; o.customint3 = 0;
				o.customdbl1 = 0; o.customdbl2 = 0; o.customdbl3 = 0;
				o.customdate1 = FlexGlobals.topLevelApplication.m.DateFirst; o.customdate2 = FlexGlobals.topLevelApplication.m.DateFirst; o.customdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				
				
				for(i=0; i<dg1.dataProviderLength; i++){
					dg1.dataProvider.getItemAt(i).noakun=''; 
					dg1.dataProvider.getItemAt(i).jumlah=0; 
				}
				for(i=0; i<dg2.dataProviderLength; i++){
					dg2.dataProvider.getItemAt(i).noakun='';
					dg2.dataProvider.getItemAt(i).jumlah=0;
					dg2.dataProvider.getItemAt(i).norek='';
					dg2.dataProvider.getItemAt(i).bank=''; 
					dg2.dataProvider.getItemAt(i).nogiro='';
					dg2.dataProvider.getItemAt(i).tgljt='';
				}
				
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var jenissimpan:int = 1;
							if(cmbcarabayar.selectedIndex==1){
								if(o.rmjumlah != o.jumlahgiro){
									Alert.show(FlexGlobals.topLevelApplication.l('Total Detail dan Total Giro harus seimbang !'),FlexGlobals.topLevelApplication.l('Informasi'));
								}else{
									if(mb.menuBarItems[0].enabled){
										if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
										if(FlexGlobals.topLevelApplication.apaBisaAkses(2,5,jenissimpan)){
											f_simpan();
										}
									}
								}
							}else{
								if(mb.menuBarItems[0].enabled){
									if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
									if(FlexGlobals.topLevelApplication.apaBisaAkses(2,5,jenissimpan)){
										f_simpan();
									}
								}
							}
							
						}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dg:DataGrid;
				if(tab.selectedIndex == 0){
					dg = dg1;
				}else{
					dg = dg2;
				}
				switch (components){
					case "calculator":
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						if(Number(data) > 0){
							if(txtmatauang.text == UFungsional){
								if(dataField == 'jumlahvalas'){
									Alert.show(FlexGlobals.topLevelApplication.l('Jumlah Valas harus 0 karena mata uang fungsional'), FlexGlobals.topLevelApplication.l('Informasi'));
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = 0;
								}
								
							}else{
								if(dataField == 'jumlahvalas'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas * o.txtkurs;
									
								}
								if(dataField == 'jumlah'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = dg.dataProvider[dg.selectedCell.rowIndex].jumlah / o.txtkurs;
								}
							}
						}
						break;
				}
				
				f_hitungvalas();
				f_hitungTotal();
			}
			
			public var jumlahgiro:Number;
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				var datagrid:DataGrid
				if(tab.selectedIndex ==0)datagrid = dg1;
				else datagrid = dg2;
				switch(column){
					case "jumlah":
						with(datagrid.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) / o.txtkurs;
								
							}else{
								jumlahvalas = 0;
								
							}
						}
						
						break;
					case "jumlahvalas":
						with(datagrid.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
								
							}else{
								jumlahvalas = 0;
								
							}
						}
						break
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String="", wsfilter:String="", sort:String="", wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtterimadari":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif=1 and kkode ="'+txtterimadari.text+'"';
						csfilter = 'kaktif=1';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtlokasi":
						paket = "CdM1_Location";
						wsfilter = 'laktif=1 AND lkode="'+txtlokasi.text+'"';
						csfilter = 'laktif=1';
						//csfield = 2;
						sort = 'lkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.rmkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.rmkontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif=1 AND tnsumber="RM"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break
					case "txtakunbank": // akun kas
						if(cmbcarabayar.selectedIndex==0){
							paket = 'CdM1_Coa';
							wsfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor ="'+txtakunbank.text+'"' + " " + ftAkunSetting;
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")' + " " + ftAkunSetting;
							csfield = 0;
							sort = 'cnomor asc';
						}
						break;
					//grid detail
					case "noakun": //no rek
						if(tab.selectedIndex==0){
							paket = "CdM1_Coa";
							wsfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") AND cnomor = "'+dg1.dataProvider.getItemAt(parentApplication.rowIndex).noakun+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
							sort = 'cnomor asc';
						}
						if(tab.selectedIndex==1){
							paket = "CdM1_Coa";
							wsfilter = 'cgd ="D" AND caktif = 1 and (ctipe = 1) AND cnomor = "'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).noakun+'"';
							csfilter = 'cgd ="D" AND caktif = 1 and (ctipe = 1)' ;
							sort = 'cnomor asc';
						}
						break;
					case "catatan":
						if(tab.selectedIndex==0){
							paket = "CdM1_Transaction_Note_Detail";
							csfilter = 'tndaktif=1 AND tndsumber="RM"';
							sort = 'tndcatatan asc';
						}
						break;
					case "costcenter": // Cost Center
						if(tab.selectedIndex==0){
							paket = "CdM1_Cost_Center";
							wsfilter = 'ccaktif=1 AND cckode = "'+dg1.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
							csfilter = 'ccaktif=1';
							sort = 'cckode asc';
						}	
						break;
					case "bank":
						if(tab.selectedIndex==1){
							paket = "CdM1_Bank";
							wsfilter = 'baktif=1 AND bkode = "'+dg2.dataProvider.getItemAt(parentApplication.rowIndex).bank+'"';
							csfilter = 'baktif=1';
							sort = 'bkode';
						}
						break;
					case "divisi": // Divisi
						if(tab.selectedIndex==0){
							paket = "CdM1_Division";
							wsfilter = 'daktif=1 AND dkode = "'+dg1.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
							csfilter = 'daktif=1';
							sort = 'dkode asc';
						}
						break;
					case "subdivisi": //sub divisi
						if(tab.selectedIndex==0){
							paket = "CdM1_Subdivision";
							wsfilter = 'sdkode = "'+dg1.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dg1.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'" sdaktif=1';
							csfilter = 'sdaktif=1 AND sddivisi="'+dg1.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
							sort = 'sdkode asc';
						}
						break;
					case "proyek": // proyek
						if(tab.selectedIndex==0){
							paket = "CdM1_Project";
							wsfilter = 'paktif=1 AND pkode = "'+dg1.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
							csfilter = 'paktif=1';
							sort = 'pkode asc';
						}
						break;
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, dg:Object;
				if(parentApplication.wsSuccess){
					switch(s){	
						case "txtlokasi":
							ws = parentApplication.wsArrUtama.getItemAt(0)
							txtlokasi.text = ws.lkode;
							o.rmlokasi = ws.lkode;
							lbllokasi.text = ws.lnama;
