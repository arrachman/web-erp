<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tsumber,tkode,tcatatan]);
				parentApplication.F_txtInOut(txtkode,"ada",'M1_Transaction_NoteCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_RequiredLabel([tsumber, tkode]);
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					cmbsumber.enabled=false;
					for (var i:int=0;i<parentApplication.m.ArrNomor.length;i++){
						if (parentApplication.m.ArrNomor.getItemAt(i).kodetabel==dg.dataProvider[dg.selectedCell.rowIndex].tnsumber){
							cmbsumber.selectedIndex=i;break;
						}
					}
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].tnkode;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].tncatatan;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].tnaktif));
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else {f_kondisi_awal();cmbsumber.selectedIndex=0}
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtcatatan]);
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [cmbsumber.selectedItem.kodetabel,txtkode.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_Transaction_NoteSimpan', utama, 'tnkode');
					cmbsumber.enabled = true;
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tsumber" left="10" top="45" text="Sumber"/>
	<s:Label id="tkode" left="10" top="66" text="Kode"/>
	<s:Label id="tcatatan" left="10" top="87" text="Catatan"/>
	<s:ComboBox id="cmbsumber" x="70" y="39" width="269" height="23" dataProvider="{parentApplication.m.ArrNomor}" labelField="uraian"/>
	<s:TextInput id="txtkode" left="70" right="10" top="61" change="parentApplication.vfplus=cmbsumber.selectedItem.kodetabel+'△'+txtkode.text"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="82" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="347" y="39" label="Aktif" selected="true"/>
</s:Module>
