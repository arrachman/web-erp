<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtmargin]);
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_Index_PriceCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ipkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].ipnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].ipcatatan;
					o.txtmargin = dg.dataProvider[dg.selectedCell.rowIndex].ipmargin;
					txtmargin.text = parentApplication.m.nfNominal.format(o.txtmargin)
					o.ipcustomtext1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext1; 
					o.ipcustomtext2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext2; 
					o.ipcustomtext3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext3;
					o.ipcustomtext4=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext4; 
					o.ipcustomtext5=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomtext5; 
					o.ipcustomint1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomint1; 
					o.ipcustomint2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomint2; 
					o.ipcustomint3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomint3;
					o.ipcustomdbl1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdbl1; 
					o.ipcustomdbl2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdbl2; 
					o.ipcustomdbl3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdbl3; 
					o.ipcustomdate1=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdate1; 
					o.ipcustomdate2=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdate2; 
					o.ipcustomdate3=dg.dataProvider[dg.selectedCell.rowIndex].ipcustomdate3;
					chkaktif.selected=Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].ipaktif));
					vUserIdEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan]);
				parentApplication.F_SetNilaiText([txtmargin], parentApplication.F_formatNominal('0'));
				chkaktif.selected = true;
				o.ipcustomtext1=""; o.ipcustomtext2=""; o.ipcustomtext3=""; o.ipcustomtext4=""; o.ipcustomtext5=""; o.ipcustomint1=0; 
				o.ipcustomint2=0; o.ipcustomint3=0; o.ipcustomdbl1=0; o.ipcustomdbl2=0; o.ipcustomdbl3=0; o.ipcustomdate1=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.ipcustomdate2=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.ipcustomdate3=FlexGlobals.topLevelApplication.DefaultTanggal;
				
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					//					ipkode, ipnama, ipcatatan, ipaktif, ipinputuser, ipinputtgl, ipmodifikasiuser, 
					//					ipmodifikasitgl, 
					//					ipcustomtext1, ipcustomtext2, ipcustomtext3, ipcustomtext4, ipcustomtext5, ipcustomint1, 
					//					ipcustomint2, ipcustomint3, ipcustomdbl1, ipcustomdbl2, ipcustomdbl3, ipcustomdate1, ipcustomdate2, 
					//					ipcustomdate3
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt,
						o.ipcustomtext1, o.ipcustomtext2, o.ipcustomtext3, o.ipcustomtext4, o.ipcustomtext5, o.ipcustomint1, 
						o.ipcustomint2, o.ipcustomint3, o.ipcustomdbl1, o.ipcustomdbl2, o.ipcustomdbl3, 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ipcustomdate1), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ipcustomdate2), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.ipcustomdate3), o.txtmargin];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_Index_PriceSimpan', utama, 'ipkode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="65" text="Nama"/>
	<s:Label id="tmargin" left="10" top="86" text="Margin"/>
	<s:Label id="tmargin0" left="346" top="84" text="%"/>
	
	<s:Label id="tcatatan" left="10" top="107" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="70" width="270"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58"/>
	<s:TextInput id="txtmargin" y="79" left="70" width="270"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="100" bottom="19" maxChars="250"/>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:CheckBox id="chkaktif" x="344" y="38" label="Aktif" selected="true"/>
</s:Module>
