<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			import spark.events.TextOperationEvent;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode,tnama,tnilai,takun,takun2, tcatatan]);
				parentApplication.F_txtpencarian([txtakun, txtakun2]);
				parentApplication.F_txtInOut(txtkode,'','M1_TaxCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtakun, txtakun2, txtcatatan]);
				F_TextInputMinusDesimal([txtkurs]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode, tnama, takun, takun2]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].tkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].tnama;
					o.txtkurs = dg.dataProvider[dg.selectedCell.rowIndex].tnilai;
					txtkurs.text = parentApplication.m.nfNominal.format(o.txtkurs);
					txtakun.text = dg.dataProvider[dg.selectedCell.rowIndex].takunbeli;
					lbldivisi.text = dg.dataProvider[dg.selectedCell.rowIndex].takunbelinama;
					txtakun2.text = dg.dataProvider[dg.selectedCell.rowIndex].takunjual;
					lbldivisi2.text = dg.dataProvider[dg.selectedCell.rowIndex].takunjualnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].tcatatan;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].taktif));
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			public var i:int;
			public function F_TextInputMinusDesimal(arTextInput:Array):void
			{
				for (i=0;i<arTextInput.length;i++)
				{
//					arTextInput[i].restrict = FlexGlobals.topLevelApplication.m.nfNominal.decimalSeparator+"-/0123456789";
					arTextInput[i].addEventListener(FocusEvent.FOCUS_IN, TextfocusInHandler);
					arTextInput[i].addEventListener(spark.events.TextOperationEvent.CHANGE, TextChangeHandler);
					arTextInput[i].addEventListener(FocusEvent.FOCUS_OUT, TextfocusOutHandler);
					arTextInput[i].setStyle("textAlign","right");
					arTextInput[i].text = FlexGlobals.topLevelApplication.m.nfNominal.format("0");
					arTextInput[i].maxChars = 15;
					FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.module].child.o[arTextInput[i].id] = 0;
				}
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard(arTextInput);
				function TextfocusInHandler(event:FocusEvent):void
				{
					event.currentTarget.text = FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.o[event.currentTarget.id];
				}
				
				function TextChangeHandler(event:TextOperationEvent):void
				{
					FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.o[event.currentTarget.id] = event.currentTarget.text.split(FlexGlobals.topLevelApplication.m.nfNominal.decimalSeparator).join('.');
				}
				
				function TextfocusOutHandler(event:FocusEvent):void
				{
					event.currentTarget.text = FlexGlobals.topLevelApplication.m.nfNominal.format(FlexGlobals.topLevelApplication.m[FlexGlobals.topLevelApplication.idmod].child.o[event.currentTarget.id]);
				}
			}
			public function f_kondisi_awal():void
			{
				o.txtkurs = 0;
				parentApplication.F_KosongkanText([txtkode,txtnama,txtkurs,txtakun,txtakun2, txtcatatan]);
				txtkurs.text = parentApplication.m.nfNominal.format(o.txtkurs);
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}, {t:txtakun, n:'Akun Pembelian'}, {t:txtakun2, n:'Akun Penjualan'}]) == true){
					arr = [txtkode.text,txtnama.text,o.txtkurs,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt,txtakun.text,txtakun2.text];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_TaxSimpan', utama, 'tkode')
					userEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtakun':
						paket = 'CdM1_Coa';
						csfilter = "cgd='D' and caktif=1";
						wsfilter = "cgd='D' and caktif=1 and cnomor = '"+ txtakun.text +"'";
						break;
					case 'txtakun2':
						paket = 'CdM1_Coa';
						csfilter = "cgd='D' and caktif=1";
						wsfilter = "cgd='D' and caktif=1 and cnomor = '"+ txtakun2.text +"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtakun':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtakun.text = o.cnomor;
							lbldivisi.text = o.cnama;
							break;
						case 'txtakun2':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtakun2.text = o.cnomor;
							lbldivisi2.text = o.cnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtakun': break;
							case 'txtakun2': break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtakun':parentApplication.F_KosongkanText([txtakun, lbldivisi]);break;
					case 'txtakun2':parentApplication.F_KosongkanText([txtakun2, lbldivisi2]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="tnilai" left="10" top="87" text="Nilai"/>
	<s:Label id="tcatatan" left="9" top="150" text="Catatan"/>
	<s:TextInput id="txtkode" y="40" left="111" width="229" maxChars="25"/>
	<s:TextInput id="txtnama" left="111" right="10" top="61" maxChars="100" />
	<s:TextInput id="txtkurs" left="111" top="82" width="141" maxChars="10"/>
	<s:TextInput id="txtakun" top="103" left="111" width="141" />
	<s:TextInput id="txtakun2" top="124" left="111" width="141" />
	<s:TextArea id="txtcatatan" left="111" right="10" top="145" bottom="10" maxChars="250"/>
	<s:Label id="takun" left="10" top="109" text="Akun Pembelian"/>
	<s:Label id="lbldivisi" left="273" top="108"/>
	<s:CheckBox id="chkaktif" x="350" y="40" label="Aktif" selected="true"/>
	<s:Label id="takun2" left="10" top="129" text="Akun Penjualan"/>
	<s:Label id="lbldivisi2" left="273" top="129"/>
</s:Module>
