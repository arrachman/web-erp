<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode,tnama,talamat,tkota,ttelp,tfax,temail,tkontakperson,tcatatan]);
				parentApplication.F_txtInOut(txtkode,'','M1_ExpeditionCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama,txtalamat,txtkota,txtnotelp,txtnofax, txtcatatan,txtkontakperson,txtemail]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].ekode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].enama;
					txtalamat.text= dg.dataProvider[dg.selectedCell.rowIndex].ealamat;
					txtkota.text= dg.dataProvider[dg.selectedCell.rowIndex].ekota;
					txtnotelp.text= dg.dataProvider[dg.selectedCell.rowIndex].etelp;
					txtnofax.text= dg.dataProvider[dg.selectedCell.rowIndex].efax;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].ecatatan;
					txtkontakperson.text= dg.dataProvider[dg.selectedCell.rowIndex].ekontakperson;
					txtemail.text= dg.dataProvider[dg.selectedCell.rowIndex].eemail;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].eaktif));
					userEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama,txtalamat,txtkota,txtnotelp,txtnofax, txtcatatan,txtkontakperson,txtemail]);
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					//akode, anama, acatatan, aaktif, ainputuser, ainputtgl, amodifikasiuser, amodifikasitgl
					arr = [txtkode.text, txtnama.text,txtalamat.text,txtkota.text,txtnotelp.text,txtnofax.text, txtcatatan.text,txtkontakperson.text,txtemail.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_ExpeditionSimpan', utama, 'ekode')
					userEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="talamat" left="10" top="87" text="Alamat"/>
	<s:Label id="tkota" left="10" top="157" text="Kota"/>
	<s:Label id="ttelp" left="10" top="178" text="Telp"/>
	<s:Label id="tfax" left="10" top="199" text="Fax"/>
	<s:Label id="temail" left="10" top="220" text="Email"/>
	<s:Label id="tkontakperson" left="10" top="241" text="Kontak Person"/>
	<s:Label id="tcatatan" left="10" top="262" text="Catatan"/>
	<s:TextInput id="txtkode" y="40" left="100" width="240" maxChars="50"/>
	<s:TextInput id="txtnama" left="100" right="10" top="61" maxChars="100" />
	<s:TextArea id="txtalamat" left="100" right="10" top="82" height="71" maxChars="250"/>
	<s:TextInput id="txtkota" left="100" right="10" top="152" maxChars="50" />
	<s:TextInput id="txtnotelp" left="100" right="10" top="173" maxChars="50" />
	<s:TextInput id="txtnofax" left="100" right="10" top="194" maxChars="50" />
	<s:TextInput id="txtemail" left="100" right="10" top="215" maxChars="50" />
	<s:TextInput id="txtkontakperson" left="100" right="10" top="236" maxChars="100" />
	<s:TextArea id="txtcatatan" left="100" right="10" top="257" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" left="350" top="41" label="Aktif" selected="true"/>
</s:Module>
