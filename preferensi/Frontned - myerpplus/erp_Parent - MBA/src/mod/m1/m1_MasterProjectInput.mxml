<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="687" height="398" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var v_kid:int,v_kidpim:int, vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkode, tnama, tkontak, tkontakperson, tpimpinanproyek, tdivisi, tnokotrak, tnilaikontrak, ttglkontrak, ttglmulairencana, ttglselesairencana, ttglmulairealisasi, ttglselesairealisasi, tcatatan]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode, tnama]);
				if(parentApplication.m[parentApplication.idmodcurr].child.hasOwnProperty('dg'))
					dg = parentApplication.m[parentApplication.idmodcurr].child.dg;
				else
					dg = parentApplication.m[parentApplication.idmodcurr].child.dghistory;
//				dtkontrak.selectedDate = new Date(); dtmrealisasi.selectedDate = new Date(); dtmrencana.selectedDate = new Date(); dtsrealisasi.selectedDate = new Date(); dtsrencana.selectedDate = new Date();
				parentApplication.F_DateFieldStandard([dtkontrak,dtmrealisasi,dtmrencana,dtsrealisasi,dtsrencana])
				parentApplication.F_TextInputNumberDesimalMode([txtnilaikontrak]);
				parentApplication.F_txtpencarian([txtkontak,txtpimpinamproyek,txtdivisi]);
				parentApplication.F_txtInOut(txtkode,'','M1_ProjectCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama ,txtkontakperson,txtnokontrak, txtcatatan]);
				
				if(parentApplication.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false; 
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].pkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].pnama;
					txtdivisi.text =dg.dataProvider[dg.selectedCell.rowIndex].pdivisi;		lbldivisi.text=dg.dataProvider[dg.selectedCell.rowIndex].pdivisinama;
					txtkontak.text =dg.dataProvider[dg.selectedCell.rowIndex].pkontakkode;	v_kid=int(dg.dataProvider[dg.selectedCell.rowIndex].pkontak);			lblkontak.text=dg.dataProvider[dg.selectedCell.rowIndex].pkontaknama;
					txtkontakperson.text=dg.dataProvider[dg.selectedCell.rowIndex].pkontakperson;
					o.txtnilaikontrak = dg.dataProvider[dg.selectedCell.rowIndex].pnilaikontrak;
					txtnilaikontrak.text = parentApplication.m.nfNominal.format(o.txtnilaikontrak);
					txtnokontrak.text = dg.dataProvider[dg.selectedCell.rowIndex].pnokontrak;
					txtpimpinamproyek.text = dg.dataProvider[dg.selectedCell.rowIndex].ppimpinanproyekkode;v_kidpim=int(dg.dataProvider[dg.selectedCell.rowIndex].ppimpinanproyek);lblpim.text=dg.dataProvider[dg.selectedCell.rowIndex].ppimpinanproyeknama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].pketerangan;
					dtkontrak.text = dg.dataProvider[dg.selectedCell.rowIndex].ptglkontrak;
					dtmrealisasi.text = dg.dataProvider[dg.selectedCell.rowIndex].ptglmulairealisasi;
					dtmrencana.text = dg.dataProvider[dg.selectedCell.rowIndex].ptglmulairencana;
					dtsrealisasi.text = dg.dataProvider[dg.selectedCell.rowIndex].ptglselesairealisasi;
					dtsrencana.text = dg.dataProvider[dg.selectedCell.rowIndex].ptglselesairencana;
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].paktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				o.txtnilaikontrak = 0;
				parentApplication.F_KosongkanText([txtkode,txtnama,txtkontak,lblkontak,txtkontakperson,txtpimpinamproyek,lblpim,txtdivisi,lbldivisi,txtnokontrak,txtnilaikontrak,dtkontrak,dtmrencana,dtmrealisasi,dtsrencana,dtsrealisasi,txtcatatan]);
				parentApplication.F_SetNilaiText([dtkontrak,dtmrealisasi,dtmrencana,dtsrealisasi,dtsrencana], parentApplication.DefaultTanggal);
				chkaktif.selected = true;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					arr = [txtkode.text,txtnama.text,"K",int(chkaktif.selected),parentApplication.F_tglFormatDB(dtkontrak.text),parentApplication.F_tglFormatDB(dtmrencana.text),
						parentApplication.F_tglFormatDB(dtmrealisasi.text),parentApplication.F_tglFormatDB(dtsrencana.text),parentApplication.F_tglFormatDB(dtsrealisasi.text),
						1,0,v_kid,txtkontakperson.text,v_kidpim,txtdivisi.text,txtcatatan.text,parentApplication.F_tglFormatDB(dtkontrak.text),
						txtnokontrak.text,o.txtnilaikontrak,0,0,0,"","","","","",vUserId,vDefDt,vUserIdEdit,vDefDt,"1","1"];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_ProjectSimpan', utama, 'pkode')
					vUserIdEdit = 0;
				}
//				if(mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, FlexGlobals.topLevelApplication.closeFormPopUp(1);));
			}
			public function f_wsHasil():void{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){
						case 'txtdivisi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtdivisi.text = o.dkode; lbldivisi.text=o.dnama;
							break;
						case 'txtkontak':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtkontak.text = o.kkode; lblkontak.text=o.knama; v_kid=o.kid;
							break;
						case 'txtpimpinamproyek':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtpimpinamproyek.text = o.kkode; lblpim.text=o.knama; v_kidpim=o.kid;
							break;
					}
				}else{
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtdivisi':
								txtdivisi.text=''; lbldivisi.text=''; break;
							case 'txtkontak':
								txtkontak.text=''; lblkontak.text=''; v_kid=0; break;
							case 'txtpimpinamproyek':
								txtpimpinamproyek.text=''; lblpim.text = ''; v_kidpim=0; break;
						}
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtdivisi':
						paket='CdM1_Division';
						csfilter = "daktif = 1";
						wsfilter='daktif = 1 and dkode = "'+ txtdivisi.text.split('"').join('\\"') +'"';
						sort = 'dkode asc';
						break;
					case 'txtkontak':
						paket='CdM1_Contact';
						csfilter = "kaktif = 1";
						wsfilter='kaktif = 1 and kkode = "'+ txtkontak.text.split('"').join('\\"') +'"';
						sort = 'kkode asc';
						break;
					case 'txtpimpinamproyek':
						paket='CdM1_Contact';
						csfilter = "kaktif = 1";
						wsfilter='kaktif = 1 and kkode = "'+ txtpimpinamproyek.text.split('"').join('\\"') +'"';
						sort = 'kkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtdivisi":txtdivisi.text=''; lbldivisi.text=''; break;
					case "txtkontak":txtkontak.text=''; lblkontak.text=''; v_kid=0; break;
					case "txtpimpinamproyek":txtpimpinamproyek.text=''; lblpim.text = ''; v_kidpim=0; break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
