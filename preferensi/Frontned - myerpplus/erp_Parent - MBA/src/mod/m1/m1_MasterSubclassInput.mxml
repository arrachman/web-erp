<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				parentApplication.F_txtpencarian([txtkelas]);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tnama0, tcatatan, tnama1]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_SubclassCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtbarcode, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].sckode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].scnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].sccatatan;
					o.sccustomtext1=dg.dataProvider[dg.selectedCell.rowIndex].sccustomtext1; 
					o.sccustomtext2=dg.dataProvider[dg.selectedCell.rowIndex].sccustomtext2; 
					o.sccustomtext3=dg.dataProvider[dg.selectedCell.rowIndex].sccustomtext3;
					o.sccustomtext4=dg.dataProvider[dg.selectedCell.rowIndex].sccustomtext4; 
					o.sccustomtext5=dg.dataProvider[dg.selectedCell.rowIndex].sccustomtext5; 
					o.sccustomint1=dg.dataProvider[dg.selectedCell.rowIndex].sccustomint1; 
					o.sccustomint2=dg.dataProvider[dg.selectedCell.rowIndex].sccustomint2; 
					o.sccustomint3=dg.dataProvider[dg.selectedCell.rowIndex].sccustomint3; 
					o.sccustomdbl1=dg.dataProvider[dg.selectedCell.rowIndex].sccustomdbl1; 
					o.sccustomdbl2=dg.dataProvider[dg.selectedCell.rowIndex].sccustomdbl2; 
					o.sccustomdbl3=dg.dataProvider[dg.selectedCell.rowIndex].sccustomdbl3; 
					o.sccustomdate1=dg.dataProvider[dg.selectedCell.rowIndex].sccustomdate1; 
					o.sccustomdate2=dg.dataProvider[dg.selectedCell.rowIndex].sccustomdate2; 
					o.sccustomdate3=dg.dataProvider[dg.selectedCell.rowIndex].sccustomdate3;
					txtbarcode.text = dg.dataProvider[dg.selectedCell.rowIndex].scindexbarcode;
					txtkelas.text = dg.dataProvider[dg.selectedCell.rowIndex].sckelas;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].scaktif));
					vUserIdEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtbarcode,txtkelas,txtcatatan]);
				chkaktif.selected = true;
				o.sccustomtext1=""; o.sccustomtext2=""; o.sccustomtext3=""; o.sccustomtext4=""; o.sccustomtext5=""; o.sccustomint1=0; 
				o.sccustomint2=0; o.sccustomint3=0; o.sccustomdbl1=0; o.sccustomdbl2=0; o.sccustomdbl3=0; o.sccustomdate1=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.sccustomdate2=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.sccustomdate3=FlexGlobals.topLevelApplication.DefaultTanggal;o.scindexbarcode="";o.sckelas="";
				
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
					//					mkode, mnama, mcatatan, maktif, minputuser, minputtgl, mmodifikasiuser, 
					//					mmodifikasitgl, 
					//					mcustomtext1, mcustomtext2, mcustomtext3, mcustomtext4, mcustomtext5, mcustomint1, 
					//					mcustomint2, mcustomint3, mcustomdbl1, mcustomdbl2, mcustomdbl3, mcustomdate1, mcustomdate2, 
					//					mcustomdate3
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt,
						o.sccustomtext1, o.sccustomtext2, o.sccustomtext3, o.sccustomtext4, o.sccustomtext5, o.sccustomint1, 
						o.sccustomint2, o.sccustomint3, o.sccustomdbl1, o.sccustomdbl2, o.sccustomdbl3, 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.sccustomdate1), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.sccustomdate2), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.sccustomdate3), txtbarcode.text, txtkelas.text];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_SubclassSimpan', utama, 'sckode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkelas':
						paket = 'CdM1_Class';
						csfilter = "caktif = 1"
						wsfilter = 'caktif = 1 and ckode = "'+ txtkelas.text.split('"').join('\\"') +'"';
						sort = 'ckode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtkelas':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtkelas.text = o.ckode;
							//lbldivisi.text = o.dnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtkelas': txtkelas.text = ''; /* lbldivisi.text = ''; */ break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtkelas':parentApplication.F_KosongkanText([txtkelas/* , lbldivisi */]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="65" text="Nama"/>
	<s:Label id="tcatatan" left="10" top="127" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="70" width="270"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58"/>
	<s:TextInput id="txtbarcode" left="70" right="10" top="79"/>
	<s:TextInput id="txtkelas" left="70" top="100" width="270"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="121" bottom="10" maxChars="250"/>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:CheckBox id="chkaktif" x="344" y="38" label="Aktif" selected="true"/>
	<s:Label id="tnama0" left="10" top="86" text="Barcode"/>
	<s:Label id="tnama1" left="10" top="107" text="Kelas"/>
</s:Module>
