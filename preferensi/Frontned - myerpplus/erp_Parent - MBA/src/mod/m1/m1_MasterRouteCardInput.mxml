			public function msgAlert(focus: Object, indonesia: String, inggris: String):void
			{		
				if(validasi == true)focus.setFocus();
				pesanAlertIng += inggris+', ';
				pesanAlert += indonesia+', ';
				if(focus == 'clear'){
					pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
					pesanAlert += " harus diisi dengan benar";
					
					pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
					pesanAlertIng += " must be filled";
					Alert.show(pesanAlertIng+"  ("+pesanAlert+") !" , "Information");}	
				//\n
				validasi = false;						
			}
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						var dgrid:DataGrid;
						if(tab.selectedIndex == 0){dgrid = dghasil;}
						dgrid.dataProvider[dgrid.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dgrid, dgrid.selectedCell.rowIndex);
						switch (dataField){
							case 'jml':
							case 'harga':
								f_hitungTotal();
								f_calc();
								break;
							case 'subtotal':
								hargaDariSubtotal.hitungHargaDariSubtotal(dghasil, false);
								break;
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dghasil);
				f_hitungTotal();
				
			}
			
			protected function f_persiapan():void
