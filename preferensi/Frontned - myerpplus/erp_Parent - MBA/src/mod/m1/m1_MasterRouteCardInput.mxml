			public function f_delundefined():void{
				for (var i:int=0;i<dghasil.dataProviderLength;i++){
					with (dghasil.dataProvider.getItemAt(i)){
						if (dghasil.dataProvider.getItemAt(i)['divisi']==undefined){dghasil.dataProvider.getItemAt(i)['divisi']=''}
						if (dghasil.dataProvider.getItemAt(i)['subdivisi']==undefined){dghasil.dataProvider.getItemAt(i)['subdivisi']=''}
						if (dghasil.dataProvider.getItemAt(i)['proyek']==undefined){dghasil.dataProvider.getItemAt(i)['proyek']=''}
						if (dghasil.dataProvider.getItemAt(i)['catatan']==undefined){dghasil.dataProvider.getItemAt(i)['catatan']=''}
					}
				}
			}
			
			public function f_simpan(baru:Boolean):void
			{
				var a:Array, utama:String, detailhasil:String = '';
				parentApplication.vpFocusEvent = true;
				//if(mb.menuBarItems[0].enabled == true){
				validasiForm();
				if(validasi == true){
					//Set Utama
					with(o){
						a = [prid, txtkode.text, txtNama.text, txtCatatan.text, praktif,
							vUserId, vDefDt, userEdit, vDefDt, 
							prcustomtext1, prcustomtext2, prcustomtext3, prcustomtext4, prcustomtext5, prcustomint1, prcustomint2, 
							prcustomint3, prcustomdbl1, prcustomdbl2, prcustomdbl3, 
							FlexGlobals.topLevelApplication.F_tglFormatDB(prcustomdate1), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(prcustomdate2), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(prcustomdate3)];
						utama = f_splitArrayToString(a);
					}
					//Set Detail
					for(i=0;i<dghasil.dataProviderLength;i++){
						with(dghasil.dataProvider.getItemAt(i)){
							a = [idprdetail, idpr, idpa, namaaktivitas, kodemesin,
								costcenter, divisi, subdivisi, proyek, catatan, i+1, customtext1, customtext2, 
								customtext3, customdbl1, customdbl2, customdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
							
							if(detailhasil == '')detailhasil =f_splitArrayToString(a);
							else detailhasil += "▲"+f_splitArrayToString(a);
						}
					}
					FlexGlobals.topLevelApplication.vg_master = detailhasil;					
					FlexGlobals.topLevelApplication.F_MasterSimpan(baru, "M1_Production_RouteSimpan", utama, "prkode");
					
				}
				//}
				
