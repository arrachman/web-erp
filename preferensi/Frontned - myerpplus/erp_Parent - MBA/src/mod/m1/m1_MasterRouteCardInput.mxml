					}else{
						FlexGlobals.topLevelApplication.F_wsGetDataById("getbyid", 'M1_Production_RouteGetdataById', dg.dataProvider[dg.selectedCell.rowIndex].prid, 0, 0, '', '');
					}
				}else f_kondisi_awal();
			}
			
