			public function f_filter(target:String):Array
			{
				var paket:String='',dgrid: Object, wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String = '';
				try{
					if(tab.selectedIndex == 0){
						dgrid = dghasil.dataProvider.getItemAt(dghasil.selectedCell.rowIndex)
					}
				} 
				catch(error:Error){}
				switch(target){
					case 'kodeaktivitas':
						paket = 'CdM1_Production_Activity';
						wsfilter = 'paaktif=1 AND pakode = "'+dgrid.kodeaktivitas+'"';
						csfilter = 'paaktif=1';
						sort = "pakode asc";
						break;
					case "kodemesin":
						if(dgrid.kodeaktivitas == ""){
							Alert.show("Silahkan isi kode aktivitas terlebih dahulu");
						}
						else{
							paket = "CdM1_Machine";
							wsfilter = 'maktif=1 AND mkode = "'+dgrid.kodemesin+'" AND maktivitasproduksi = '+dgrid.idpa;
							csfilter = 'maktif=1 AND maktivitasproduksi = '+dgrid.idpa;
							sort = "mkode asc";
						}						
						break;
					case "costcenter":
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+ dgrid.costcenter +'"';
						csfilter = 'ccaktif=1';
						sort = "cckode asc";
						break;
					case "divisi":
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+ dgrid.divisi +'"';
						csfilter = 'daktif=1';
						sort = "dkode asc";
						break;
					case "subdivisi":
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif=1 AND sddivisi = "'+dgrid.divisi.split('"').join('\\"')+'" AND sdkode = "'+dgrid.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif=1 AND sddivisi = "'+dgrid.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case "proyek":
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+ dgrid.proyek +'"';
						csfilter = 'paktif=1';
						sort = "pkode asc";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
			}
			
			
			
