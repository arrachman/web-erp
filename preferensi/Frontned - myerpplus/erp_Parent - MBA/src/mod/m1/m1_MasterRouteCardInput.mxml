					if(txtNama.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtNama,'Nama');
					/* var persen:Number = 0;
					for (i = 0; i<dghasil.dataProviderLength; i++){
					persen += Number(dghasil.dataProvider[i].hpppersen)
					}
					if(persen != 100)FlexGlobals.topLevelApplication.msgAlert(dghasil, 'Total persentase harga detail hasil'); */
					
					for(i=0; i< dghasil.dataProviderLength; i++){
						if(dghasil.dataProvider.getItemAt(i).kodeaktivitas.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dghasil,'Kode Aktivitas');
						if(dghasil.dataProvider.getItemAt(i).kodemesin.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dghasil,'Kode Mesin');
					}
					
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');
					else {
						
					}				
					
					f_hitungTotal();
					
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
