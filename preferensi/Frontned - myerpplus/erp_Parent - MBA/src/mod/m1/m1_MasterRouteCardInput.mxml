				parentApplication.F_SetNavigasiKeyboard([txtkode, txtNama, txtCatatan]);
				FlexGlobals.topLevelApplication.F_configMasterInput();
				//untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(1,122,[dghasil],'transaksi');
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].prkode;
					txtNama.text = dg.dataProvider[dg.selectedCell.rowIndex].prnama;
					txtCatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].prcatatan;
					if(parentApplication.m.ArrFilter != null){
