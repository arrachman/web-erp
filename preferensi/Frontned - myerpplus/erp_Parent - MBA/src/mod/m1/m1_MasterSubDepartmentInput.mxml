<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			public var o:Object = {};
			public var vUserId:int, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String, userEdit:Number=0;
			public var vKeyOut:Boolean = true, p:Object, dg:DataGrid;
			public var divisi:String, subdivisi:String;
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode,tnama,tdepartment,tcatatan]);
				parentApplication.F_txtpencarian([txtdepartment]);
				parentApplication.F_txtInOut(txtkode,'','M1_SubdepartmentCekId');
				parentApplication.F_RequiredLabel([tkode, tnama, tdepartment]);
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtbarcode, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].sdpkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].sdpnama;
					txtdepartment.text = dg.dataProvider[dg.selectedCell.rowIndex].sdpdepartemen;
					lbldepartment.text = dg.dataProvider[dg.selectedCell.rowIndex].sdpdepartemennama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].sdpcatatan;
					txtbarcode.text = dg.dataProvider[dg.selectedCell.rowIndex].sdpindexbarcode;
					divisi = dg.dataProvider[dg.selectedCell.rowIndex].sdpdivisi;
					subdivisi = dg.dataProvider[dg.selectedCell.rowIndex].sdpsubdivisi;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].sdpaktif));
					userEdit = parentApplication.userid;
					o.sdpcustomtext1 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomtext1;
					o.sdpcustomtext2 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomtext2; 
					o.sdpcustomtext3 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomtext3; 
					o.sdpcustomtext4 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomtext4; 
					o.sdpcustomtext5 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomtext5; 
					o.sdpcustomint1 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomint1; 
					o.sdpcustomint2 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomint2; 
					o.sdpcustomint3 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomint3; 
					o.sdpcustomdbl1 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomdbl1; 
					o.sdpcustomdbl2 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomdbl2; 
					o.sdpcustomdbl3 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomdbl3; 
					o.sdpcustomdate1 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomdate1; 
					o.sdpcustomdate2 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomdate2; 
					o.sdpcustomdate3 = dg.dataProvider[dg.selectedCell.rowIndex].sdpcustomdate3;
					
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan,txtdepartment,lbldepartment]);
				chkaktif.selected = true;
				o.sdpcustomtext1 = "";
				o.sdpcustomtext2 = ""; 
				o.sdpcustomtext3 = ""; 
				o.sdpcustomtext4 = ""; 
				o.sdpcustomtext5 = ""; 
				o.sdpcustomint1 = 0; 
				o.sdpcustomint2 = 0; 
				o.sdpcustomint3 = 0; 
				o.sdpcustomdbl1 = 0; 
				o.sdpcustomdbl2 = 0; 
				o.sdpcustomdbl3 = 0; 
				o.sdpcustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.sdpcustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.sdpcustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				//				sdpkode, sdpnama, sdpdepartment, sdpsubdepartment, sdpcatatan, sdpaktif, sdpinputuser, 
				//				sdpinputtgl, sdpmodifikasiuser, sdpmodifikasitgl, sdpcustomtext1, sdpcustomtext2, sdpcustomtext3, sdpcustomtext4, 
				//				sdpcustomtext5, sdpcustomint1, sdpcustomint2, sdpcustomint3, sdpcustomdbl1, sdpcustomdbl2, sdpcustomdbl3, 
				//				sdpcustomdate1, sdpcustomdate2, sdpcustomdate3
				
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode'}, {t:txtnama, n:'Nama'}]) == true){
					arr = [txtkode.text,txtnama.text, txtdepartment.text, divisi, subdivisi, txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,userEdit,vDefDt,
						o.sdpcustomtext1, o.sdpcustomtext2, o.sdpcustomtext3, o.sdpcustomtext4, 
						o.sdpcustomtext5, o.sdpcustomint1, o.sdpcustomint2, o.sdpcustomint3, o.sdpcustomdbl1, o.sdpcustomdbl2, o.sdpcustomdbl3, 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.sdpcustomdate1), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.sdpcustomdate2), 
						FlexGlobals.topLevelApplication.F_tglFormatDB(o.sdpcustomdate3), txtbarcode.text];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_SubdepartmentSimpan', utama, 'sdpkode')
					userEdit = 0;
				}
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtdepartment':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtdepartment.text = o.dpkode;
							lbldepartment.text = o.dpnama;
							divisi = o.dpdivisi;
							subdivisi = o.dpsubdivisi;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtdepartment': break;
							case 'txtsubdepartment': break;
						}
				}
			}
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtdepartment':
						parentApplication.F_KosongkanText([txtdepartment, lbldepartment]);
						divisi = "";
						subdivisi = "";
						break;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtdepartment':
						paket = 'CdM1_Department';
						csfilter = "dpaktif = 1";
						wsfilter = "dpaktif = 1 and dpkode = '"+ txtdepartment.text +"'";
						break;
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/savenew.png")] public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>
	<s:Label id="tkode" left="10" top="45" text="Kode"/>
	<s:Label id="tnama" left="10" top="66" text="Nama"/>
	<s:Label id="tnama0" left="10" top="108" text="Barcode"/>
	<s:Label id="tdepartment" left="10" top="87" text="Department"/>
	<s:Label id="tcatatan" left="10" top="138" text="Catatan"/>
	<s:Label id="lbldepartment" left="222" top="87"/>
	<s:TextInput id="txtkode" y="40" left="94" width="246" maxChars="25"/>
	<s:TextInput id="txtnama" left="94" right="10" top="61" maxChars="100" />
	<s:TextInput id="txtdepartment" top="82" left="94" width="100" />
	<s:TextInput id="txtbarcode" left="94" right="10" top="103"/>
	<s:TextArea id="txtcatatan" left="94" right="10" top="124" bottom="14" maxChars="250"/>	
	<s:CheckBox id="chkaktif" x="350" y="41" label="Aktif" selected="true"/>
</s:Module>
