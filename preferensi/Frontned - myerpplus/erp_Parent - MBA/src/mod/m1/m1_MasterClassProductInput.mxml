<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" 
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama]);
				parentApplication.F_txtInOut(txtkode,'','M1_Class_ProductCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama, txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].cpkode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].cpnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].cpcatatan;
					o.cpcustomtext1=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomtext1; 
					o.cpcustomtext2=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomtext2; 
					o.cpcustomtext3=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomtext3;
					o.cpcustomtext4=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomtext4; 
					o.cpcustomtext5=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomtext5; 
					o.cpcustomint1=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomint1; 
					o.cpcustomint2=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomint2; 
					o.cpcustomint3=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomint3; 
					o.cpcustomdbl1=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomdbl1; 
					o.cpcustomdbl2=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomdbl2; 
					o.cpcustomdbl3=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomdbl3; 
					o.cpcustomdate1=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomdate1; 
					o.cpcustomdate2=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomdate2; 
					o.cpcustomdate3=dg.dataProvider[dg.selectedCell.rowIndex].cpcustomdate3;
					chkaktif.selected = Boolean(int(dg.dataProvider[dg.selectedCell.rowIndex].cpaktif));
					vUserIdEdit = parentApplication.userid;
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode,txtnama,txtcatatan]);
				chkaktif.selected = true;
				o.cpcustomtext1=""; o.cpcustomtext2=""; o.cpcustomtext3=""; o.cpcustomtext4=""; o.cpcustomtext5=""; o.cpcustomint1=0; 
				o.cpcustomint2=0; o.cpcustomint3=0; o.cpcustomdbl1=0; o.cpcustomdbl2=0; o.cpcustomdbl3=0; o.cpcustomdate1=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.cpcustomdate2=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.cpcustomdate3=FlexGlobals.topLevelApplication.DefaultTanggal;
				
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}]) == true){
//					cpkode, cpnama, cpcatatan, cpaktif, cpinputuser, cpinputtgl, cpmodifikasiuser, 
//					cpmodifikasitgl, 
//					cpcustomtext1, cpcustomtext2, cpcustomtext3, cpcustomtext4, cpcustomtext5, cpcustomint1, 
//					cpcustomint2, cpcustomint3, cpcustomdbl1, cpcustomdbl2, cpcustomdbl3, cpcustomdate1, cpcustomdate2, 
//					cpcustomdate3
					arr = [txtkode.text,txtnama.text,txtcatatan.text,int(chkaktif.selected),vUserId,vDefDt,vUserIdEdit,vDefDt,
							o.cpcustomtext1, o.cpcustomtext2, o.cpcustomtext3, o.cpcustomtext4, o.cpcustomtext5, o.cpcustomint1, 
							o.cpcustomint2, o.cpcustomint3, o.cpcustomdbl1, o.cpcustomdbl2, o.cpcustomdbl3, 
							FlexGlobals.topLevelApplication.F_tglFormatDB(o.cpcustomdate1), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(o.cpcustomdate2), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(o.cpcustomdate3)];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_Class_ProductSimpan', utama, 'cpkode')
					vUserIdEdit = 0;
				}
			}
			
			public function f_wsHasil():void
			{
				parentApplication.F_configMasterInputHasil();
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="65" text="Nama"/>
	<s:Label id="tcatatan" left="10" top="86" text="Catatan"/>
	<s:TextInput id="txtkode" y="37" left="70" width="270"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58"/>
	<s:TextArea id="txtcatatan" left="70" right="10" top="79" bottom="10" maxChars="250"/>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:CheckBox id="chkaktif" x="344" y="38" label="Aktif" selected="true"/>
</s:Module>
