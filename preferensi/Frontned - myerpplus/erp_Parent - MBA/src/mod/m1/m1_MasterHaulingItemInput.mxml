							o.bcustomint3 = obj.bcustomint3; o.bcustomint4 = obj.bcustomint4; o.bcustomint5 = obj.bcustomint5; o.bcustomdbl1 = obj.bcustomdbl1;
							o.bcustomdbl2 = obj.bcustomdbl2; o.bcustomdbl3 = obj.bcustomdbl3; o.bcustomdbl4 = obj.bcustomdbl4; o.bcustomdbl5 = obj.bcustomdbl5;
							o.bcustomdate1 = obj.bcustomdate1; o.bcustomdate2 = obj.bcustomdate2; o.bcustomdate3 = obj.bcustomdate3; o.bcustomdate4 = obj.bcustomdate4;
							o.bcustomdate5 = obj.bcustomdate5;
							break;
						case 'txttipe':
							obj = p.wsArrUtama.getItemAt(0);
							txttipe.text = obj.itkode;
							break;
						case 'txtSatuan':
							obj = p.wsArrUtama.getItemAt(0);
							txtSatuan.text = obj.ukode;
							LblSatuan.text = obj.unama;
							nsatuan = obj.unilai;
							break;
						case 'txtSatuandefault':
							obj = p.wsArrUtama.getItemAt(0);
							txtSatuandefault.text = obj.ukode;
							LblSatuandefault.text = obj.unama;
							nsatuandef = obj.unilai;
							break;
						case 'txtcabang':
							obj = p.wsArrUtama.getItemAt(0);
							txtcabang.text = obj.bkode;
							Lblcabang.text = obj.bnama;
							break;
