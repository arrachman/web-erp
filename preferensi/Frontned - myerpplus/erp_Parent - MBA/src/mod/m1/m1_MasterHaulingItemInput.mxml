							txtgudang.text = obj.wkode;
							Lblgudang.text = obj.wnama;
							break;
						case 'txtproyek':
							obj = p.wsArrUtama.getItemAt(0);
							txtproyek.text = obj.pkode;
							Lblproyek.text = obj.pnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txttipe': break;
							case 'txtKategori':break;
							case 'txtSatuan':break;
							case 'txtSatuandefault': break;
