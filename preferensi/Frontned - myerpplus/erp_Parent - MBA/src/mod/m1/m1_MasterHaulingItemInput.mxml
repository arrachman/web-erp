			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txttipe':
						paket = 'CdM1_Item_Type';
						csfilter = 'itaktif = 1';
						wsfilter = 'itaktif = 1 and itkode = "'+ txttipe.text.split('"').join('\\"') +'"';
						break;
					case 'txtSatuan':
						if(txtSatuan.enabled == true){
							paket = 'CdM1_Unit';
							csfilter = 'uaktif = 1 and unilai = 1';
							wsfilter = 'uaktif = 1 and unilai = 1 and ukode = "'+ txtSatuan.text.split('"').join('\\"') +'"';
						}
						break;
					case 'txtSatuandefault':
						paket = 'CdM1_Unit';
						csfilter = 'uaktif = 1';
						wsfilter = 'uaktif = 1 and ukode = "'+ txtSatuandefault.text.split('"').join('\\"') +'"';
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = 'baktif = 1';
						wsfilter = 'baktif = 1 and bkode = "'+ txtcabang.text.split('"').join('\\"') +'"';
						break;
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = 'laktif = 1';
						wsfilter = 'laktif = 1 and lkode = "'+ txtlokasi.text.split('"').join('\\"') +'"';
						break;
					case 'txtdivisi':
						paket = 'CdM1_Division';
						csfilter = 'daktif = 1';
						wsfilter = 'daktif = 1 and dkode = "'+ txtdivisi.text.split('"').join('\\"') +'"';
						break;
					case 'txtsubdivisi':
						paket = 'CdM1_Subdivision';
						csfilter = 'sdaktif = 1';
						wsfilter = 'sdaktif = 1 and sdkode = "'+ txtsubdivisi.text.split('"').join('\\"') +'"';
						break;
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						csfilter = 'waktif = 1';
						wsfilter = 'waktif = 1 and wkode = "'+ txtgudang.text.split('"').join('\\"') +'"';
						break;
					case 'txtproyek':
						paket = 'CdM1_Project';
						csfilter = 'paktif = 1';
						wsfilter = 'paktif = 1 and pkode = "'+ txtproyek.text.split('"').join('\\"') +'"';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
