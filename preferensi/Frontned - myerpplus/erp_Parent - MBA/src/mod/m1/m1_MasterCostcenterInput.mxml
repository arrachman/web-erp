<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			import org.hamcrest.collection.array;
			
			import spark.components.DataGrid;
			
			public var vUserId:int, vUserIdEdit:int=0, vDefDt:String, isUpdate:Boolean=false,vcekId:Boolean=false, arr:Array, vCurr:String;
			public var vKeyOut:Boolean = true, p:Object, o:Object = {}, dg:DataGrid;
			
			private function f_persiapan():void{
				p = parentApplication;
				if(p.m[p.idmodcurr].child.hasOwnProperty('dg'))
					dg = p.m[p.idmodcurr].child.dg;
				else
					dg = p.m[p.idmodcurr].child.dghistory;
				parentApplication.F_txtpencarian([txtdivisi,txtakun]);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				parentApplication.F_TranslateLabel([tkode, tnama, tdivisi, takun, tcatatan]);
				parentApplication.F_RequiredLabel([tkode, tnama, tdivisi]);
				parentApplication.F_txtInOut(txtkode,'','M1_Cost_CenterCekId');
				parentApplication.F_configMasterInput();
				parentApplication.F_SetNavigasiKeyboard([txtkode, txtnama,txtcatatan]);
				if(p.FormFilter != ''){
					isUpdate = true;
					txtkode.enabled = false;
					txtkode.text = dg.dataProvider[dg.selectedCell.rowIndex].cckode;
					txtnama.text = dg.dataProvider[dg.selectedCell.rowIndex].ccnama;
					txtdivisi.text = dg.dataProvider[dg.selectedCell.rowIndex].ccdivisi;
					lbldivisi.text= dg.dataProvider[dg.selectedCell.rowIndex].ccdivisinama;
					txtakun.text=dg.dataProvider[dg.selectedCell.rowIndex].ccakun;
					lblakun.text=dg.dataProvider[dg.selectedCell.rowIndex].ccakunnama;
					txtcatatan.text = dg.dataProvider[dg.selectedCell.rowIndex].cccatatan;
					vUserIdEdit = parentApplication.userid;
					if (dg.dataProvider[dg.selectedCell.rowIndex].ccaktif=="0"){chkaktif.selected = false;}else {chkaktif.selected = true;}
					if(parentApplication.m.ArrFilter != null){
						mb.menuBarItems[0].enabled = false;
						mb.menuBarItems[1].enabled = false;
					}
				}else f_kondisi_awal();
			}
			
			public function f_kondisi_awal():void
			{
				parentApplication.F_KosongkanText([txtkode, txtnama, txtdivisi, txtakun, txtcatatan, lbldivisi, lblakun]);
			}
			
			public function f_simpan(baru:Boolean):void{
				var arr:Array, utama:String;
				if (parentApplication.F_cekKosong([{t:txtkode, n:'Kode', e:'Code'}, {t:txtnama, n:'Nama', e:'Name'}, {t:txtdivisi, n:'Divisi', e:'Division'}]) == true){
					//cckode, ccnama, cccatatan, ccinputuser, ccinputtgl, ccmodifikasiuser, ccmodifikasitgl
					arr = [txtkode.text,txtnama.text,txtdivisi.text,txtakun.text,int(chkaktif.selected),txtcatatan.text,vUserId,vDefDt,vUserIdEdit,vDefDt];
					utama = parentApplication.F_splitArrayToString(arr);
					parentApplication.F_MasterSimpan(baru, 'M1_Cost_CenterSimpan', utama,'cckode')
					vUserIdEdit = 0;
				}
			}
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtdivisi':
						paket = 'CdM1_Division';
						csfilter = "daktif = 1"
						wsfilter = 'daktif = 1 and dkode = "'+ txtdivisi.text.split('"').join('\\"') +'"';
						sort = 'dkode asc';
						break;
					case 'txtakun':
						paket = 'CdM1_Coa';
						csfilter = "cgd='D' and caktif = 1"
						wsfilter = 'cgd="D" and caktif = 1 and cnomor = "'+ txtakun.text.split('"').join('\\"') +'"';
						sort = 'cnomor asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			public function f_wsHasil():void
			{
				var o:Object, s:String = parentApplication.subject;
				parentApplication.F_configMasterInputHasil();
				if(parentApplication.wsSuccess == true){
					switch(s){				
						case 'txtdivisi':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtdivisi.text = o.dkode;
							lbldivisi.text = o.dnama;
							break;
						case 'txtakun':
							o = parentApplication.wsArrUtama.getItemAt(0);
							txtakun.text = o.cnomor;
							lblakun.text = o.cnama;
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'txtdivisi': txtdivisi.text = ''; lbldivisi.text = ''; break;
							case 'txtakun': txtakun.text = ''; lblakun.text = ''; break;
						}
				}
			}

			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtdivisi':parentApplication.F_KosongkanText([txtdivisi, lbldivisi]);break;
					case 'txtakun':parentApplication.F_KosongkanText([txtakun, lblakun]);break;
				}
			}
			
			[Bindable] [Embed(source="assets/tb/savenew.png")]  public var tbsavenew:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="tombol">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan Baru" icon="tbsavenew"/>
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbclose"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="-1" top="-1" right="1" width="100%" height="30" cornerRadius="0" dataProvider="{tombol}" iconField="@icon" labelField="@label"/>	
	<s:Label id="tkode" left="10" top="43" text="Kode"/>
	<s:Label id="tnama" left="10" top="64" text="Nama"/>
	<s:Label id="tdivisi" left="10" top="86" text="Divisi"/>
	<s:Label id="takun" left="11" top="107" text="Akun"/>
	<s:Label id="tcatatan" left="10" top="128" text="Catatan"/>
	<s:Label id="lbldivisi" left="199" top="85"/>
	<s:Label id="lblakun" left="199" top="106"/>
	<s:TextInput id="txtkode" y="37" left="70" width="270" maxChars="25"/>
	<s:TextInput id="txtnama" left="70" right="10" top="58" maxChars="50" />
	<s:TextInput id="txtdivisi" top="79" left="70" width="100" />
	<s:TextInput id="txtakun" top="100" left="70" width="100" />
	<s:TextArea id="txtcatatan" left="70" right="10" top="121" bottom="10" maxChars="250"/>
	<s:CheckBox id="chkaktif" x="344" y="38" label="Aktif" selected="true"/>
</s:Module>
