	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import flashx.textLayout.elements.TCYElement;
			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.CheckBox;
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String, pesanAlertIng:String, c:CheckBox, img:Image, i:int, isUpdate:Boolean, UFungsional:String;
			public var o:Object = {},no:int;
			[Bindable] public var ac2:ArrayCollection = new ArrayCollection();
			public var vIdkontak:int, arrColumn:Array = new Array;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction, getNotransaksi:String;
			[Bindable]protected var acEdit:ArrayCollection = new ArrayCollection();
			public function f_focusOnMe():void
			{
				txtnopr.setFocus();
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "checkBoxHeader":
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
							f_EditData();
						}
						break;
					case "checkBox":
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						f_EditData();
						
						break;
					
					case "link":
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
			public function f_EditData():void{
				var iAC:int;
				for(var m:int = 0; m<dg.dataProviderLength; m++){
					
					with(dg.dataProvider[m]){
						acEdit.addItem({
							chk:chk,
							idrfqdetail : idrfqdetail, 
							idrfq : idrfq, 
							sumber : sumber, 
							kkode: kkode, 
							knama: knama,
							idkontak: idkontak,
							catatan :catatan, 
							urutan : urutan, 
							isclose : isclose, 
							customtext1 : customtext1, 
							customtext2 : customtext2, 
							customtext3 : customtext3, 
							customdbl1 : customdbl1, 
							customdbl2 : customdbl2, 
							customdbl3 : customdbl3, 
							customdate1 : customdate1, 
							customdate2 : customdate2, 
							customdate3 : customdate3});
					}
				}
				
				
				
			}
			public var ada:Boolean;
			public var statusedit:Boolean;
			public function f_SetDatatoArray(Index:int):void{
				ada = false;
				acEdit.refresh();
				for(var i:int = 0; i<acEdit.length; i++){
					if(dg.dataProvider[Index].idkontak == acEdit[i].idkontak){
						acEdit[i].chk= dg.dataProvider[Index].chk; 
						acEdit[i].idrfqdetail= dg.dataProvider[Index].idrfqdetail; 
						acEdit[i].idrfq= dg.dataProvider[Index].idrfq; 
						acEdit[i].kkode= dg.dataProvider[Index].kkode; 
						acEdit[i].knama= dg.dataProvider[Index].knama; 
						acEdit[i].sumber= dg.dataProvider[Index].sumber; 
						acEdit[i].idkontak= dg.dataProvider[Index].idkontak; 
						acEdit[i].catatan= dg.dataProvider[Index].catatan; 
						acEdit[i].urutan= dg.dataProvider[Index].urutan; 
						acEdit[i].isclose= dg.dataProvider[Index].isclose; 
						acEdit[i].customtext1= dg.dataProvider[Index].customtext1; 
						acEdit[i].customtext2= dg.dataProvider[Index].customtext2; 
						acEdit[i].customtext3= dg.dataProvider[Index].customtext3; 
						acEdit[i].customdbl1= dg.dataProvider[Index].customdbl1; 
						acEdit[i].customdbl2= dg.dataProvider[Index].customdbl2; 
						acEdit[i].customdbl3= dg.dataProvider[Index].customdbl3; 
						acEdit[i].customdate1= dg.dataProvider[Index].customdate1; 
						acEdit[i].customdate2= dg.dataProvider[Index].customdate2; 
						acEdit[i].customdate3= dg.dataProvider[Index].customdate3; 
						
						ada = true;
					}
					
					
				}
				if(ada == false){
					acEdit.addItem({chk: dg.dataProvider[Index].chk, 
						idrfqdetail : dg.dataProvider[Index].idrfqdetail, 
						kkode : dg.dataProvider[Index].kkode, 
						knama : dg.dataProvider[Index].knama, 
						idrfq : dg.dataProvider[Index].idrfq, 
						sumber : dg.dataProvider[Index].sumber, 
						sumber: dg.dataProvider[Index].sumber, 
						idkontak: dg.dataProvider[Index].idkontak,
						catatan : dg.dataProvider[Index].catatan, 
						urutan : dg.dataProvider[Index].urutan, 
						isclose : dg.dataProvider[Index].isclose, 
						customtext1 : dg.dataProvider[Index].customtext1, 
						customtext2 : dg.dataProvider[Index].customtext2, 
						customtext3 : dg.dataProvider[Index].customtext3, 
						customdbl1 : dg.dataProvider[Index].customdbl1, 
						customdbl2 : dg.dataProvider[Index].customdbl2, 
						customdbl3 : dg.dataProvider[Index].customdbl3, 
						customdate1 : dg.dataProvider[Index].customdate1, 
						customdate2 : dg.dataProvider[Index].customdate2, 
						customdate3 : dg.dataProvider[Index].customdate3
					});
				}
			}
			
			protected function f_persiapan():void
			{
				tab.focusEnabled = false;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tnopr, ttanggal, tnotransaksi, tprogress]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([turaian, ttanggal, tnotransaksi, tprogress, tcatatan])
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl, dttglnoref]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan, txtnopr]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtsupplier1, txtsupplier2]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,chkauto,txtnoref]);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLink);
				
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(4,59,jenissimpan)){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void{FlexGlobals.topLevelApplication.f_bukaTransaksi("Rfq");}
				function f_mbReset():void{
					mb.menuBarItems[4].enabled = false;
					mb.menuBarItems[5].enabled = false;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
				}
				
				function f_mbTampilkan():void{
					f_wsTampil();
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[4].enabled){
						FlexGlobals.topLevelApplication.F_OpenNotes(o.rfqsumber,o.rfqid,txtnotransaksi.text);
					}
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[5].enabled){
						FlexGlobals.topLevelApplication.F_OpenUploadFile('RFQ', o.rfqid,txtnotransaksi.text);
					}
					
				}
				function f_mbLink():void {
					if(mb.menuBarItems[6].enabled)FlexGlobals.topLevelApplication.f_mbLinks(4,'Rfq');
				}
				
				// Config Paging
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = "0";
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				function f_firstCLICK():void{
					txtpaging.text = String(1)
					f_wsTampil(1);
				}
				function f_previousCLICK():void{
					f_wsTampil(int(txtpaging.text) - 1);
					txtpaging.text = String(int(txtpaging.text) - 1)
				}
				function f_nextCLICK():void{
					f_wsTampil(int(txtpaging.text) + 1)
					txtpaging.text = String(int(txtpaging.text) + 1)
				}
				function f_lastCLICK():void{
					f_wsTampil(int(- 1))
					
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_wsTampil(int(txtpaging.text));
				}
				
				txtsupplier1.addEventListener(FocusEvent.FOCUS_IN, function setdate():void{
					txtsupplier2.text = txtsupplier1.text;
				});
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				
				FlexGlobals.topLevelApplication.F_RegGrid(4,59,[dg],'transaksi');
				
				f_validasi();
			}
			
			public function f_validasi():void
			{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				f_kondisiAwal();
				var idtransaksi :String = filtersplit[0];
				if(idtransaksi.length > 0)
				{
					if(filtersplit.length > 1)
					{
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M2_RgHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					else 
					{
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_RfqGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled=true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				FlexGlobals.topLevelApplication.FormFilter = '';
				cmbprogress.selectedIndex = 1;
				txtnotransaksi.text = 'Auto';
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				isUpdate = false;
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("Rfq");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("Rfq",1);
				parentApplication.F_SetNilaiText([dttgl, dttglnoref], parentApplication.DefaultTanggal);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtnopr, txtsupplier1, txtsupplier2]);
				
				
				o.rfqid = 0; o.rfqcabang = FlexGlobals.topLevelApplication.ucabang; o.rfqlokasi = FlexGlobals.topLevelApplication.ulokasi; 
				o.rfqsumber = "Rfq";
				o.rfqkodepa = 0;  
				o.rfqkontakperson = ""; o.rfq1alamat1 = ""; 
				o.rfq1alamat2 = ""; o.rfq1alamat3 = ""; o.rfq2alamat1 = ""; 
				o.rfq2alamat2 = ""; o.rfq2alamat3 = ""; 
				o.rfqstatussebelumnya = 0; o.rfqjmlrevisi = 0; o.rfqcetakanke = 0; 
				o.rfqinputuser = FlexGlobals.topLevelApplication.userid; 
				o.rfqinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.rfqmodifikasiuser = 0; o.rfqmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.rfqposting = 0; o.rfqpostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.rfqisclose = 0; o.rfqcustomtext1 = ""; 
				o.rfqcustomtext2 = ""; o.rfqcustomtext3 = ""; o.rfqcustomtext4 = ""; 
				o.rfqcustomtext5 = ""; o.rfqcustomint1 = 0; o.rfqcustomint2 = 0; 
				o.rfqcustomint3 = 0; o.rfqcustomdbl1 = 0; o.rfqcustomdbl2 = 0; o.rfqcustomdbl3 = 0; 
				o.rfqcustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.rfqcustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.rfqcustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				
				f_focusOnMe();
				
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			
			protected function f_wsTampil(page:int = 1, sort:String = 'kkode'):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("TakeData", "CdM1_Contact", page, 20, f_filterdata(), sort);
			}
			
			public function f_filterdata():String
			{
				var f:String='kaktif="1" and kkategori="S"';
				if(txtsupplier1.text.length > 0 && txtsupplier2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode Between "'+txtsupplier1.text.split('"').join('\\"')+'" and "'+txtsupplier2.text.split('"').join('\\"')+'"');
				}else if(txtsupplier1.text.length > 0 && txtsupplier2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode >= "'+txtsupplier1.text.split('"').join('\\"')+'"');
				}else if(txtsupplier1.text.length <= 0 && txtsupplier2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'kkode <= "'+txtsupplier2.text.split('"').join('\\"')+'"');
				}
				
				return f;
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(4,59,jenissimpan)){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case "chk":
						break;
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target)
				{
					case "txtnopr":
						paket = "CdM4_Pr";
						csfilter = "(prstatus = 2 or prstatus = 3) ";
						wsfilter = csfilter + " AND prnotransaksi = '" + txtnopr.text + "'";
						sort = "prid DESC"; 
						break;
					case "txtsupplier1":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif=1 AND kkategori = "S" AND kkode = "'+txtsupplier1.text+'"';
						csfilter = 'kaktif=1 AND kkategori = "S"';
						sort = 'kkode asc';
						break
					case "txtsupplier2":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif=1 AND kkategori = "S" AND kkode = "'+txtsupplier2.text+'"';
						csfilter = 'kaktif=1 AND kkategori = "S"';
						sort = 'kkode asc';
						break
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess)
				{
					switch(s)
					{
						case "txtnopr":
							txtnopr.text = parentApplication.wsArrUtama.getItemAt(0).prnotransaksi;
							o.rfqidpr = parentApplication.wsArrUtama.getItemAt(0).prid;
							break;
						case "txtsupplier1":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtsupplier1.text = ws.kkode;
							txtsupplier2.text = ws.kkode;
							break;
						case "txtsupplier2":
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtsupplier2.text = ws.kkode;
							break;
						case "tampil":
							f_focusOnMe();
							mb.menuBarItems[4].enabled = true;
							mb.menuBarItems[5].enabled = true;
							mb.menuBarItems[6].enabled = true;
							mb.menuBarItems[7].visible = false;
							isUpdate = true;
							with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0))
							{
								txturaian.text = rfquraian;
								txtcatatan.text = rfqcatatan;
								dttgl.text = rfqtgl;
								txtnotransaksi.text= rfqnotransaksi;
								dttglnoref.text = rfqtglnoref;
								txtnoref.text = rfqnoref;
								txtnopr.text = rfqnotransaksipr;
								if (rfqautonotransaksi ==1){
									chkauto.selected = true; txtnotransaksi.enabled=false;
								}else if (rfqautonotransaksi==0){chkauto.selected = false; txtnotransaksi.enabled=true;}
								
								if(rfqstatus!=7){
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									if(rfqstatus ==0){
										cmbprogress.selectedIndex=0;
										mb.menuBarItems[0].enabled=true;
									}else if(rfqstatus ==2){
										cmbprogress.selectedIndex=1;
										mb.menuBarItems[0].enabled=false;
									}
								}
								else {
									cmbprogress.dataProvider = new ArrayCollection([{l:'Close', v:7}]);
									cmbprogress.selectedIndex=0;
									mb.menuBarItems[0].enabled=false;
									cmbprogress.enabled = false;
								}
								o.rfqidpr = rfqidpr;o.rfqid = rfqid; o.rfqcabang = rfqcabang; o.rfqlokasi = rfqlokasi; o.rfqsumber = rfqsumber; 
								o.rfqautonotransaksi = rfqautonotransaksi; o.rfqnotransaksi = rfqnotransaksi; 
								o.rfqtgl = rfqtgl; 
								o.rfqkodepa = rfqkodepa; o.rfqkontakperson = rfqkontakperson;
								o.rfq1alamat1 = rfq1alamat1; o.rfq1alamat2 = rfq1alamat2; o.rfq1alamat3 = rfq1alamat3; 
								o.rfq2alamat1 = rfq2alamat1; 
								o.rfq2alamat2 = rfq2alamat2; o.rfq2alamat3 = rfq2alamat3; o.rfquraian = rfquraian; 
								o.rfqcatatan = rfqcatatan; o.rfqnoref = rfqnoref; o.rfqtglnoref = rfqtglnoref; o.rfqstatus = rfqstatus; 
								o.rfqstatussebelumnya = rfqstatussebelumnya; o.rfqjmlrevisi = rfqjmlrevisi; o.rfqcetakanke = rfqcetakanke; 
								o.rfqinputuser = rfqinputuser; o.rfqinputtgl = rfqinputtgl; 
								o.rfqmodifikasiuser = rfqmodifikasiuser; o.rfqmodifikasitgl = rfqmodifikasitgl; 
								o.rfqposting = rfqposting; o.rfqpostingtgl = rfqpostingtgl; 
								o.rfqisclose = rfqisclose; o.rfqcustomtext1 = rfqcustomtext1; o.rfqcustomtext2 = rfqcustomtext2; 
								o.rfqcustomtext3 = rfqcustomtext3; o.rfqcustomtext4 = rfqcustomtext4; 
								o.rfqcustomtext5 = rfqcustomtext5; o.rfqcustomint1 = rfqcustomint1; o.rfqcustomint2 = rfqcustomint2; 
								o.rfqcustomint3 = rfqcustomint3; o.rfqcustomdbl1 = rfqcustomdbl1; o.rfqcustomdbl2 = rfqcustomdbl2; 
								o.rfqcustomdbl3 = rfqcustomdbl3; 
								o.rfqcustomdate1 = rfqcustomdate1; o.rfqcustomdate2 = rfqcustomdate2; 
								o.rfqcustomdate3 = rfqcustomdate3;
							}
							dg.dataProvider.removeAll();
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								ws=FlexGlobals.topLevelApplication.wsArrDetail.getItemAt(i)
								dg.dataProvider.addItem({chk:1,
									no:i+1,
									idrfqdetail : ws.idrfqdetail, 
									idrfq : ws.idrfq, 
									sumber : ws.sumber, 
									catatan : ws.catatan, 
									idkontak : ws.idkontak, 
									kkode : ws.kodekontak, 
									knama : ws.namakontak, 
									urutan : ws.urutan, 
									isclose : ws.isclose, 
									customtext1 : ws.customtext1, 
									customtext2 : ws.customtext2, 
									customtext3 : ws.customtext3, 
									customdbl1 : ws.customdbl1, 
									customdbl2 : ws.customdbl2, 
									customdbl3 : ws.customdbl3, 
									customdate1 : ws.customdate1, 
									customdate2 : ws.customdate2, 
									customdate3 : ws.customdate3});
							}
							break;
						case "tampilHistory":
							f_focusOnMe();
							mb.menuBarItems[0].visible = false;
							mb.menuBarItems[1].visible = false;
							mb.menuBarItems[2].visible = false;
							mb.menuBarItems[3].visible = false;
							mb.menuBarItems[4].visible = false;
							mb.menuBarItems[5].visible = false;
							mb.menuBarItems[6].visible = false;
							isUpdate = true;
							with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0)){
								txturaian.text = rguraian;
								txtcatatan.text = rgcatatan;
								dttgl.text = rgtgl;
								txtnotransaksi.text= rgnotransaksi;
								if (rgautonotransaksi ==1){
									chkauto.selected = true; txtnotransaksi.enabled=false;
								}else if (rgautonotransaksi==0){chkauto.selected = false; txtnotransaksi.enabled=true;}
								txtmatauang.text=rgmatauang;
								o.txtkurs = rgkurs;
								txtkurs.text=FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
								if (rgmatauang != UFungsional){
									txtkurs.enabled=true;
								}else{
									txtkurs.enabled=false;
								}
								if(rgstatus!=7){
									cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
									if(rgstatus ==0){
										cmbprogress.selectedIndex=0;
										mb.menuBarItems[0].enabled=true;
									}else if(rgstatus ==2){
										cmbprogress.selectedIndex=1;
										mb.menuBarItems[0].enabled=false;
									}
								}
								else {
									cmbprogress.dataProvider = new ArrayCollection([{l:'Close', v:7}]);
									cmbprogress.selectedIndex=0;
									mb.menuBarItems[0].enabled=false;
									cmbprogress.enabled = false;
								}
								o.rgid=rgid; o.rgcabang=rgcabang; o.rglokasi=rglokasi; 
								o.rgsumber=rgsumber;o.rgkodepa=rgkodepa; o.rgkontak=rgkontak; o.rgkontakperson=rgkontakperson; 
								o.rgjumlah=rgjumlah; o.rgjumlahvalas=rgjumlahvalas; o.rgstatusrgc=rgstatusrgc; o.rgstatussebelumnya=rgstatussebelumnya; o.rgjmlrevisi=rgjmlrevisi; o.rgcetakanke=rgcetakanke; 
								o.rgisclose=rgisclose; o.rginputuser=rginputuser; o.rginputtgl=rginputtgl; 
								o.rgmodifikasiuser=FlexGlobals.topLevelApplication.userid; o.rgmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal; o.rgcustomtext1=rgcustomtext1; 
								o.rgcustomtext2=rgcustomtext2; o.rgcustomtext3=rgcustomtext3; o.rgcustomtext4=rgcustomtext4;o. rgcustomtext5=rgcustomtext5; 
								o.rgcustomint1=rgcustomint1; o.rgcustomint2=rgcustomint2; o.rgcustomint3=rgcustomint3; 
								o.rgcustomdbl1=rgcustomdbl1; o.rgcustomdbl2=rgcustomdbl2; o.rgcustomdbl3=rgcustomdbl3; o.rgcustomdate1=FlexGlobals.topLevelApplication.m.DateFirst; 
								o.rgcustomdate2= FlexGlobals.topLevelApplication.m.DateFirst; o.rgcustomdate3=FlexGlobals.topLevelApplication.m.DateFirst;
							}
							dg.dataProvider.removeAll();
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								ws=FlexGlobals.topLevelApplication.wsArrDetail.getItemAt(i)
								dg.dataProvider.addItem({chk:1,
									no:i+1,
									noakun:ws.rekbank,
									namaakun:ws.rekbanknama,
									bank:ws.bank,
									nogiro:ws.nogiro,
									matauang:ws.matauang,
									kurs:ws.kurs,
									jumlah:ws.jumlah,
									jumlahvalas:ws.jumlahvalas,
									tgljt:ws.tgljatuhtempo,
									noacbank:ws.noacbank,
									kontak:ws.kontaknama,
									status:ws.statusgironama,
									catatan:ws.catatan,
									idrgdetail:ws.idrgdetail, idrg:ws.idrg, rekgiro:ws.rekgiro,
									statusrgc:ws.statusrgc, isclose:ws.isclose, customtext1:ws.customtext1, 
									customtext2:ws.customtext2, customtext3:ws.customtext3, 
									customdbl1:ws.customdbl1, customdbl2:ws.customdbl2, customdbl3:ws.customdbl3, 
									customdate1:ws.customdate1, 
									customdate2:ws.customdate2, 
									customdate3:ws.customdate3,
									kontakid:ws.kontak, statusgiro:ws.statusgiro});
							}
							FlexGlobals.topLevelApplication.F_wsSearch('status',"CdM0_Status_Giro",0,0,'kode <> 1');
							break;
						case "TakeData":
							imgfirst.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgprevious.enabled = FlexGlobals.topLevelApplication.wsIsPrev;
							imgnext.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							imglast.enabled = FlexGlobals.topLevelApplication.wsIsNext;
							txtpaging.text = FlexGlobals.topLevelApplication.wsCurPage;
							
							dg.dataProvider.removeAll();
							ws = FlexGlobals.topLevelApplication.wsArrUtama;
							for(i=0;i<ws.length;i++)
							{
								dg.dataProvider.addItem({chk:0,
									idrfqdetail:0,
									idrfq:0,
									sumber : "", 
									kkode: ws.getItemAt(i).kkode,
									knama: ws.getItemAt(i).knama,
									idkontak: ws.getItemAt(i).kid,
									catatan :"", 
									urutan : (i+1), 
									isclose : 0, 
							        customtext1 : "", 
									customtext2 : "", 
									customtext3 : "", 
									customdbl1 : 0, 
									customdbl2 : 0, 
									customdbl3 : 0, 
									customdate1 : FlexGlobals.topLevelApplication.DefaultTanggal, 
							        customdate2 : FlexGlobals.topLevelApplication.DefaultTanggal, 
									customdate3 : FlexGlobals.topLevelApplication.DefaultTanggal});
									
							}
							var iDG:int, iAC:int;
							for(iDG = 0; iDG < dg.dataProviderLength; iDG++){
								for(iAC = 0; iAC < acEdit.length; iAC++){
									if(dg.dataProvider[iDG].idkontak == acEdit[iAC].idkontak){
										dg.dataProvider[iDG].chk= acEdit[iAC].chk; 
										dg.dataProvider[iDG].idrfqdetail= acEdit[iAC].idrfqdetail; 
										dg.dataProvider[iDG].idrfq= acEdit[iAC].idrfq; 
										dg.dataProvider[iDG].kkode= acEdit[iAC].kkode; 
										dg.dataProvider[iDG].knama= acEdit[iAC].knama; 
										dg.dataProvider[iDG].idkontak= acEdit[iAC].idkontak; 
										dg.dataProvider[iDG].sumber= acEdit[iAC].sumber; 
										dg.dataProvider[iDG].catatan= acEdit[iAC].catatan; 
										dg.dataProvider[iDG].urutan= acEdit[iAC].urutan; 
										dg.dataProvider[iDG].isclose= acEdit[iAC].isclose; 
										dg.dataProvider[iDG].customtext1= acEdit[iAC].customtext1; 
										dg.dataProvider[iDG].customtext2= acEdit[iAC].customtext2; 
										dg.dataProvider[iDG].customtext3= acEdit[iAC].customtext3; 
										dg.dataProvider[iDG].customdbl1= acEdit[iAC].customdbl1; 
										dg.dataProvider[iDG].customdbl2= acEdit[iAC].customdbl2; 
										dg.dataProvider[iDG].customdbl3= acEdit[iAC].customdbl3; 
										dg.dataProvider[iDG].customdate1= acEdit[iAC].customdate1; 
										dg.dataProvider[iDG].customdate2= acEdit[iAC].customdate2; 
										dg.dataProvider[iDG].customdate3= acEdit[iAC].customdate3; 
									}
								}
							}
							break;
						case "simpan":
							FlexGlobals.topLevelApplication.FormFilter='';
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_alertCetak(4,59,'Rfq', FlexGlobals.topLevelApplication.wsIdtransaksi, FlexGlobals.topLevelApplication.wsErrmessage, o.tanggal+" s.d "+o.tanggal);
							
							break;
						case "print":
							FlexGlobals.topLevelApplication.F_openReportDefault(4,59,"rfqid = "+FlexGlobals.topLevelApplication.wsIdtransaksi+"");
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s))
						switch(s){
							case "noakun":
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).noakun = '';
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).namaakun = '';
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							case "bank":
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = '';
								parentApplication.F_dgRefresh(dg);
								break;
							case "catatan":
								dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).catatan = '';
								parentApplication.F_dgRefresh(dg);
								break;
							case "tampilGiro":
								for(i=dg.dataProviderLength-1;i>=0;i--){
									if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
										dg.dataProvider.removeItemAt(i);
									}
								}
								break;
							case "tampil":
							case "simpan":
								Alert.show(FlexGlobals.topLevelApplication.l(FlexGlobals.topLevelApplication.wsErrmessage), FlexGlobals.topLevelApplication.l('Informasi'));
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "TakeData":
						for(i=dg.dataProviderLength-1;i>=0;i--){
							if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
								dg.dataProvider.removeItemAt(i);
							}
						}
						break;
				}
			}
			public function centang():void{
				ac2.removeAll();
				for (var i:int = 0; i < dg.dataProviderLength; i++) 
					if(dg.dataProvider.getItemAt(i).chk==1){
						with(dg.dataProvider.getItemAt(i))
							ac2.addItem({No:i+1, idrfqdetail : 0, idrfq : 0, sumber : sumber, idkontak:idkontak, 
								catatan : catatan, urutan : i+1, isclose : 0, 
								customtext1 : "", customtext2 : "", customtext3 : "", 
								customdbl1 : 0, customdbl2 : 0, customdbl3 : 0, 
								customdate1 : FlexGlobals.topLevelApplication.DefaultTanggal, 
								customdate2 : FlexGlobals.topLevelApplication.DefaultTanggal, 
								customdate3 : FlexGlobals.topLevelApplication.DefaultTanggal});
					}
			}
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				centang();
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if(validasi)
					{
						// Set Utama
//						rfqid, rfqcabang, rfqlokasi, rfqsumber, rfqautonotransaksi, rfqnotransaksi, rfqtgl, 
//						'rfqkodepa, rfqidpr, rfqkontakperson, rfq1alamat1, rfq1alamat2, rfq1alamat3, rfq2alamat1, 
//						'rfq2alamat2, rfq2alamat3, rfquraian, rfqcatatan, rfqnoref, rfqtglnoref, rfqstatus, 
//						'rfqstatussebelumnya, rfqjmlrevisi, rfqcetakanke, rfqinputuser, rfqinputtgl, rfqmodifikasiuser, rfqmodifikasitgl, 
//						'rfqposting, rfqpostingtgl, rfqisclose, rfqcustomtext1, rfqcustomtext2, rfqcustomtext3, rfqcustomtext4, 
//						'rfqcustomtext5, rfqcustomint1, rfqcustomint2, rfqcustomint3, rfqcustomdbl1, rfqcustomdbl2, rfqcustomdbl3, 
//						'rfqcustomdate1, rfqcustomdate2, rfqcustomdate3
						with(o){
							a = [rfqid, rfqcabang, rfqlokasi, rfqsumber, int(chkauto.selected), txtnotransaksi.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
								rfqkodepa, rfqidpr, rfqkontakperson, rfq1alamat1, rfq1alamat2, rfq1alamat3, rfq2alamat1, 
								rfq2alamat2, rfq2alamat3, txturaian.text, txtcatatan.text, txtnoref.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttglnoref.text), cmbprogress.selectedItem.v, 
								rfqstatussebelumnya, rfqjmlrevisi, rfqcetakanke, rfqinputuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rfqinputtgl), rfqmodifikasiuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rfqmodifikasitgl), 
								rfqposting, FlexGlobals.topLevelApplication.F_tglFormatDB(rfqpostingtgl), 
								rfqisclose, rfqcustomtext1, rfqcustomtext2, rfqcustomtext3, rfqcustomtext4, 
								rfqcustomtext5, rfqcustomint1, rfqcustomint2, rfqcustomint3, rfqcustomdbl1, rfqcustomdbl2, rfqcustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rfqcustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rfqcustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rfqcustomdate3)];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}

//						idrfqdetail, idrfq, sumber, idkontak, catatan, urutan, isclose, 
//						'customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, customdate1, 
//						'customdate2, customdate3
						if(ac2.length > 0){
							for(i=0;i<ac2.length;i++)
								with(ac2.getItemAt(i)){
									a = [idrfqdetail, idrfq, sumber, idkontak, catatan, i+1, isclose, 
										customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detail =  FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detail += "▲"+ FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
						}
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M4_RfqSimpan", parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(txtnopr.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtnopr,'No Pr');
					if(txtnotransaksi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					if(ac2.length <= 0){
						FlexGlobals.topLevelApplication.msgAlert(dg,'Data')
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					
					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						//return myalert;
						//\n
						validasi = false;						
					}
					
					//					if(ac2.length <= 0){
					//						ac2.addItem({No:0, noakun:'', idrgdetail:0, idrg:0, nogiro:'',matauang:txtmatauang.text, kurs:o.txtkurs, jumlah:0,jumlahvalas:0,catatan:'',  statusrgc:0, isclose:0, customtext1:'', customtext2:'', customtext3:'', customdbl1:0, customdbl2:0,
					//							customdbl3:0,customdate1:FlexGlobals.topLevelApplication.m.DateFirst,customdate2:FlexGlobals.topLevelApplication.m.DateFirst,customdate3:FlexGlobals.topLevelApplication.m.DateFirst,rekgiro:'',statusgiro:0, noacbank:'',
					//							tgljt:FlexGlobals.topLevelApplication.m.DateFirst, kontakid:0, bank:''});
					//					}
				}
				
				
			}
			
