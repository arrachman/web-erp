				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(txttermin.text.length == 0){
						o.dnrtgljatuhtempo = dttgl.text;
					}
					if(txtsupplier.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtsupplier,'Supplier');
					if(txtgudang.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtgudang,'Gudang');
					if(txtmatauang.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(txtlokasi.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtlokasi,'Lokasi');
					if(txtnotransaksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
				
					for(i=0; i< dg.dataProviderLength; i++)
					{
						if(dg.dataProvider.getItemAt(i).kodebarang == '')FlexGlobals.topLevelApplication.msgAlert(dg,'Kode Barang');
						if(dg.dataProvider.getItemAt(i).jml <= 0)FlexGlobals.topLevelApplication.msgAlert(dg,'Jumlah');
						if(dg.dataProvider.getItemAt(i).satuan == '')FlexGlobals.topLevelApplication.msgAlert(dg,'Satuan');
					}
					
					if(pesanAlert != '')
					{
						FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');
					}
					
					f_hitungTotal();
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.dnrtotal = 0;
				o.dnrtotalpajak1detail = 0;
				o.dnrtotalpajak2detail = 0;
				o.dnrtotaltransaksi = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).subtotal != undefined)o.dnrtotal += Number(dg.dataProvider.getItemAt(i).subtotal);
					if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.dnrtotalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.dnrtotalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
				
				o.dnrtotaltransaksi= (Number(o.dnrtotal) + Number(o.dnrtotalpajak1detail) + Number(o.dnrtotalpajak2detail) + Number(o.dnrbiayalain)) - Number(o.dnrjmldiskon);
				o.dnrsisatransaksi= (Number(o.dnrtotal) + Number(o.dnrtotalpajak1detail) + Number(o.dnrtotalpajak2detail) + Number(o.dnrbiayalain)) - Number(o.dnrjmldiskon);
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.dnrtotal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.dnrtotalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.dnrtotalpajak2detail);
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.dnrtotaltransaksi);
				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.dnrsisatransaksi);
			}
			
