			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array, dgrid1:Object;
				switch(column){ 
					case "jml":
						dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
//						dgrid1.customdbl1 = Number(dgrid1.jml) / Number(dgrid1.nilaisatuanlapangan);
						dgrid1.customdbl1 = (Number(dgrid1.jml) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
						dgrid1.jmlbarang = dgrid1.jml * dgrid1.nilaisatuan;
					case "harga":
					case "diskon":
						dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
						dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						FlexGlobals.topLevelApplication.F_hargaTotal(dg);
						break;
					case "customdbl1":
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
//						dgrid1.jml = Number(dgrid1.customdbl1) * Number(dgrid1.nilaisatuanlapangan);
//						dgrid1.jmlbarang = Number(dgrid1.jml) * Number(dgrid1.nilaisatuan);
						dgrid1.jml = (Number(dgrid1.nilaisatuanlapangan) / Number(dgrid1.nilaisatuan)) * Number(dgrid1.customdbl1)
						dgrid1.jmlbarang = Number(dgrid1.jml) * Number(dgrid1.nilaisatuan);
						break;
					case "jmldiskon":
						dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
						dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						break;
					case "pajak1":
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case "pajak2":
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case "pre_del":
						hapusserial();
						hapusbatch();
						hapusaktiva();
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
			//hapus serial jika barangnya tidak ada
			public function hapusserial():void{
				var s:int;
				if(acserialdetail.length > 0){
					for(s=acserialdetail.length-1; s>=0; s--){
						if(acserialdetail[s].nstidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							acserialdetail.removeItemAt(s);
						}
					}
				}
			}
			
			public function hapusbatch():void{
				var b:int;
				if(acbatchdetail.length > 0){
					for(b=acbatchdetail.length-1; b>=0; b--){
						if(acbatchdetail[b].nbtidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							acbatchdetail.removeItemAt(b);
						}
					}
				}
			}
			
			public function hapusaktiva():void
			{
				var a:int;
				if(acaktivadetail.length > 0)
				{
					for(a=acaktivadetail.length-1; a>=0; a--)
					{
						if(acaktivadetail[a].atidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang)
						{
							acaktivadetail.removeItemAt(a);
						}
					}
				}
			}
			
