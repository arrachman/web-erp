			public function msgAlert(focus: Object, indonesia: String, inggris: String):void
			{		
				if(validasi)focus.setFocus();
				pesanAlertIng += inggris+', ';
				pesanAlert += indonesia+', ';
				if(focus == 'clear'){
					pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
					pesanAlert += " harus diisi dengan benar terlebih dahulu";
					
					pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
					pesanAlertIng += " must be filled in correctly first";
					Alert.show(pesanAlert+" !" , "Information");}	
				validasi = false;						
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid1:Object;
				switch (components)
				{
					case "checkBox":
						if(dataField == 'hargafix')
						{
							dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hargafix = data;
						}
						if(dataField == 'hk')
						{
							if(data == true && dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bhpp == 'I')
							{
								parentApplication.F_popUpCari('hk');
							}
								
						}
						break;
					case "calculator":
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						switch (dataField){
							case "jml":
							case "harga":
							case "diskon":
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.customdbl1 = Number(dgrid1.jml) / Number(dgrid1.nilaisatuanlapangan);
								dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml; 
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								FlexGlobals.topLevelApplication.F_hargaTotal(dg);
								break;
							case "jmldiskon":
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
			
			public function f_comPencarianBatal():void
			{
				if(parentApplication.subject == "hk")
				{
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hk = false;
					FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
				}
			}
			
			public function f_filtersb():void
			{
				fserial = 's'; fbatch = 'b'; faktiva = 'a';
				for(i=0; i<dg.dataProviderLength; i++)
				{
					if(dg.dataProvider[i].bserial == 1)
					{
						if(fserial == 's')
						{
							fserial = '(nsiidbarang = ' + dg.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg.dataProvider[i].gudangasal+'")';
						}
						else
						{
							fserial += ' or (nsiidbarang = ' + dg.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg.dataProvider[i].gudangasal+'")';
						}
					}
					
					if(dg.dataProvider[i].bbatch ==	1)
					{
						if(fbatch == 'b')
						{
							fbatch = '(nbiidbarang = ' + dg.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg.dataProvider[i].gudangasal+'")';
						}
						else
						{
							fbatch += ' or (nbiidbarang = ' + dg.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg.dataProvider[i].gudangasal+'")';
						}
					}
					
					if(dg.dataProvider[i].basset ==	1)
					{
						if(faktiva == 'a')
						{
							faktiva = '(aidbarang = ' + dg.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg.dataProvider[i].gudangasal+'")';
						}
						else
						{
							faktiva += ' or (aidbarang = ' + dg.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg.dataProvider[i].gudangasal+'")';
						}
					}
				}
			}
			
			
