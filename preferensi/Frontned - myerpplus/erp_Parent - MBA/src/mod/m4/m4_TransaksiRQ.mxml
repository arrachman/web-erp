			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				f_kondisiAwal();
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_RqHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						if(FlexGlobals.topLevelApplication.FormFilter != 'JadikanRQbaru'){
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_RqGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else if (FlexGlobals.topLevelApplication.FormFilter == 'JadikanRQbaru'){
							FlexGlobals.topLevelApplication.F_wsGetDataById('RQbaru', 'M4_RqGetdataById', parentApplication.m.ArrFilter[0], 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
				}
				//end ofset getdata by id===============================================================================================

			}
			protected function f_kondisiAwal():void
			{
				var i:int, splitsetting:Array;
				if(getsettingstatus.length > 0)
				{
					// spit setting status
					// 0|1|8|2~8
					splitsetting = getsettingstatus.split("~");
					defaultstatus = int(splitsetting[1]);
					splitsetting = splitsetting[0].toString().split("|");
					cmbprogress.dataProvider = new ArrayCollection();
					for(i=0;i<splitsetting.length;i++)
					{
						switch(int(splitsetting[i]))
						{
							case 0:cmbprogress.dataProvider.addItem({l:'Draft', v:0});break;
							case 1:cmbprogress.dataProvider.addItem({l:'Need Approve', v:1});break;
							case 2:cmbprogress.dataProvider.addItem({l:'Approved', v:2});break;
							case 8:cmbprogress.dataProvider.addItem({l:'Approve 1', v:8});break;
						}
					}
					
					for(i=0;i<cmbprogress.dataProvider.length;i++)
					{
						if(cmbprogress.dataProvider.getItemAt(i).v == defaultstatus)
						{
							defaultstatus = i;
							break;
						}
					}
				}
				else
				{
					cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
					defaultstatus = 1;
				}
				cmbprogress.selectedIndex = defaultstatus;
				cmbstatuslelang.dataProvider = new ArrayCollection([{l:'SQ', v:0}, {l:'Proses', v:1}, {l:'Menang', v:2}, {l:'Kalah', v:3}, {l:'Batal', v:4}]);
				cmbstatuslelang.selectedIndex = 0;
				o.txtdiskonnominal = 0;
				o.txtbiayalainnominal = 0;
				o.txtdiskonpersen = 0;
				o.txtbiayalainpersen = 0;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				cmbprogress.enabled = true;
				chkhargapajak.selected = false
				tab.selectedIndex=0;
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				f_focusOnMe(); 
				txtgudang.text = FlexGlobals.topLevelApplication.ugudang;
				lblgudang.text = FlexGlobals.topLevelApplication.ugudangnama;
				
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalpajak1,lbltotalpajak2,lbltotaltransaksi,txtbiayalainnominal,txtbiayalainpersen,txtdiskonnominal, txtdiskonpersen],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				//FlexGlobals.topLevelApplication.F_SetNilaiText([txtdiskonpersen],0);
				isUpdate = false;
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("RQ");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("RQ",1);
				parentApplication.F_SetNilaiText([dttgl,dttgldipenuhi,dttglnoref, dttgljt], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtsupplier, txtnopr, lblsupplier,txtkontakperson,txttermin,txaalamatkontakperson,txaalamatsupplier,txtnoref]);
				
				o.rqid = 0; o.rqcabang = FlexGlobals.topLevelApplication.ucabang; o.rqlokasi = FlexGlobals.topLevelApplication.ulokasi; 
				o.rqasalbarang = ''; o.rqjenispembelian = ''; o.rqjenispembeliankategori = 0; o.rqsumber = 'RQ'; o.rqkodepa = 0; o.rqsupplier = 0; 
				o.rq1alamat1=txaalamatsupplier.text; o.rq1alamat2=''; o.rq1alamat3=''; 
				o.rq2alamat1=txaalamatkontakperson.text; o.rq2alamat2=''; o.rq2alamat3=''; o.rqbagianpembelian=FlexGlobals.topLevelApplication.ukontak; 
				o.rqtgljatuhtempo= dttgl.text; o.rqtglpenutupan = FlexGlobals.topLevelApplication.m.DateFirst;
				o.rqhargatermasukpajak = 0; o.rqtotal=0; o.rqdiskonpersen=0; o.rqdiskon=0; o.rqtotalpajak1detail=0; o.rqtotalpajak2detail=0; o.rqbiayalainpersen=0; 
				o.rqbiayalain=0; o.rqtotaltransaksi=0; o.rqidpr=0; o.rqidcs=0; o.rqstatuspo=0; o.rqstatusipc=0; o.rqstatusgrn=0; 
				o.rqstatusri=0; o.rqstatusdnr=0; o.rqstatusprt=0; o.rqstatussebelumnya=0; o.rqjmlrevisi=0; o.rqcetakanke=0; 
				o.rqinputuser=FlexGlobals.topLevelApplication.userid; o.rqinputtgl=FlexGlobals.topLevelApplication.DefaultTanggal; o.rqmodifikasiuser=0; o.rqmodifikasitgl=FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.rqisclose=0; o.rqcustomtext1=''; o.rqcustomtext2=''; o.rqasalbarangkategori = 0; o.rqcarabayar = 0;
				o.rqcustomtext3=''; o.rqcustomtext4=''; o.rqcustomtext5=''; o.rqcustomint2=0; o.rqcustomint3=0; o.rqcustomdbl1=0; 
				o.rqcustomdbl2=0; o.rqcustomdbl3=0; o.rqcustomdate1=FlexGlobals.topLevelApplication.m.DateFirst; 
				o.rqcustomdate2=FlexGlobals.topLevelApplication.m.DateFirst; o.rqcustomdate3=FlexGlobals.topLevelApplication.m.DateFirst;
				
				
				for(i=0; i<dg.dataProviderLength; i++){
					dg.dataProvider.getItemAt(i).kodebarang=''; 
					dg.dataProvider.getItemAt(i).pajak1nilai=0; 
					dg.dataProvider.getItemAt(i).subtotal=0; 
					dg.dataProvider.getItemAt(i).pajak1nilai=0; 
					dg.dataProvider.getItemAt(i).pajak2nilai=0; 
					//					dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai
				}
				
				chkautogrup.selected = true;
				txtnogrup.text = 'Auto';	
				txtnogrup.enabled = false;
				
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							if(mb.menuBarItems[0].enabled){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(4,5,jenissimpan)){
									f_simpan();
								}
							}
						}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid1:Object;
				switch (components){
					case "calculator":
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						switch (dataField){
							case "jml":
							case "harga":
							case "diskon":
								dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
								dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
//								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
//								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								
								dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml;
								
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								FlexGlobals.topLevelApplication.F_hargaTotal(dg);
								break;
							case "jmldiskon":
								dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0){
										Alert.show(FlexGlobals.topLevelApplication.l("Jumlah barang tidak boleh 0"), FlexGlobals.topLevelApplication.l('Informasi'));
									}else if(dgrid1.harga == 0){
										Alert.show(FlexGlobals.topLevelApplication.l("Harga tidak boleh 0"), FlexGlobals.topLevelApplication.l("Informasi"));
									}else if(dgrid1.jml == 0 && dgrid1.harga == 0){
										Alert.show(FlexGlobals.topLevelApplication.l("Jumlah barang dan Harga tidak boleh 0"), FlexGlobals.topLevelApplication.l("Informasi"));
									}
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
									
								}
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
//								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
//								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								
								dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							case "subtotal":
								hargaDariSubtotal.hitungHargaDariSubtotal(dg);
								break;
						}
						break;
				}
				f_hitungTotal();
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array, dgrid1:Object;
				switch(column){ 
					case "jml":
					case "harga":
					case "diskon":
						dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
						dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
//						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
//						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml; 
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						parentApplication.F_hargaTotal(dg);
						break;
					case "jmldiskon":
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
						if(dgrid1.jml == 0 || dgrid1.harga == 0){
							if(dgrid1.jml == 0){
								Alert.show(FlexGlobals.topLevelApplication.l("Jumlah barang tidak boleh 0"), FlexGlobals.topLevelApplication.l('Informasi'));
							}else if(dgrid1.harga == 0){
								Alert.show(FlexGlobals.topLevelApplication.l("Harga tidak boleh 0"), FlexGlobals.topLevelApplication.l("Informasi"));
							}else if(dgrid1.jml == 0 && dgrid1.harga == 0){
								Alert.show(FlexGlobals.topLevelApplication.l("Jumlah barang dan Harga tidak boleh 0"), FlexGlobals.topLevelApplication.l("Informasi"));
							}
							dgrid1.jmldiskon = 0;
							dgrid1.diskon= 0;
						}else{
							dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
							
						}
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
//						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
//						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case "pajak1":
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case "pajak2":
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case "subtotal":
						hargaDariSubtotal.hitungHargaDariSubtotal(dg);
						break;
				}
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, id:String = '', csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target)
				{
					case "txtnopr":
						paket = "CdM4_Pr";
						csfilter = "(prstatus = 2 or prstatus = 3) ";
						
						if(txtmatauang.text.length > 0)
						{
							csfilter += " AND prmatauang = '" + txtmatauang.text + "'";
						}
						
						wsfilter = csfilter + " AND prnotransaksi = '" + txtnopr.text + "'";
						sort = "prid DESC"
						break;
					case "txtsupplier":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif="1" and kkategori="S" and kkode ="'+txtsupplier.text+'"';
						csfilter = 'kaktif="1" and kkategori="S"';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.rqsupplier+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.rqsupplier+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtgudang":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode="'+txtgudang.text+'"';
						csfilter = 'waktif=1';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break;
					case "txttermin":
						paket = "CdM1_Terms";
						wsfilter = 'traktif=1 AND trkode = "'+txttermin.text+'"';
						csfilter = 'traktif=1';
						sort = 'trkode asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif="1" AND tnsumber="RQ"';
						csfield = 2;
						sort = 'tnsumber asc';
						break;
					case "txtnogrup":
						if(txtnogrup.enabled){
							paket = "CdM4_Rq_Nogrup";
							wsfilter = 'rqnogrup ="'+txtnogrup.text+'"';
							csfilter = '';
							sort = 'rqnogrup desc';
						}
						break;
					case "kodebarang":
						paket = "CdM1_Item";
						wsfilter = 'baktif=1 AND bassembly <> 1 AND bkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).kodebarang+'"';
						csfilter = 'baktif=1 AND bassembly <> 1';
						csfield = 2;
						sort = 'bkode asc';
						break;
					case "satuan":
						paket = "CdM1_Unit";
						wsfilter = 'uaktif="1" AND ukode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).satuan+'"';
						csfilter = "uaktif=1";
						csfield = 2;
						sort = 'ukode asc';
						break
					case "pajak1":
						paket = "CdM1_Tax";
						wsfilter = 'taktif=1 AND tkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pajak1+'"';
						csfilter = "taktif=1";
						csfield = 2;
						sort = 'tkode asc';
						break;
					case "pajak2":
						paket = "CdM1_Tax";
						wsfilter = 'taktif=1 AND tkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).pajak2+'"';
						csfilter = "taktif=1";
						csfield = 2;
						sort = 'tkode asc';
						break;
					case "gudang":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode ="'+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).gudang+'"';
						csfilter = "waktif=1";
						csfield = 2;
						sort = 'wkode asc';
						break
					case "catatan":
						paket = "CdM1_Transaction_Note_Detail";
						csfilter = 'tndaktif=1 AND tndsumber="RQ"';
						sort = 'tndkode asc';
						break;
					case "costcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi": // Divisi
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi": //sub divisi
						paket = "CdM1_Subdivision";
						wsfilter = 'sdaktif=1 AND sdkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'sdaktif=1 AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						sort = 'sdkode asc';
						break;
					case "proyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
					case "AmbilPR":
						var filtersupplier:String = '';
						if(txtsupplier.text.length > 0 && txtsupplier.text != "null")
						{
							filtersupplier = '(supplier = 0 or supplier = '+o.rqsupplier+')';
						}
						else
						{
							filtersupplier = '(supplier = 0)';
						}
						paket = "CdM4_Pr_Detail";
						csfilter = '(prstatus = 2 or prstatus = 3) AND (isidkontak = '+o.rqsupplier+' OR isidkontak is null)  AND isclose=0 and prmatauang = "'+txtmatauang.text+'"';
						sort = 'prnotransaksi desc, urutan asc'; 
						checkbox = true;
						id = 'idprdetail';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
			}
			
			public function format (textinput:Object, param:String):void{
				var b:Object = {}
				param = String(param).split(FlexGlobals.topLevelApplication.m.nfNominal.decimalSeparator).join('.');
				b.temp = param.split('+');
				if(b.temp.length > 1){
					b.s = FlexGlobals.topLevelApplication.m.nfNominal.format(b.temp[0]);
					for(i=1;i<b.temp.length;i++)
						b.s += "+"+FlexGlobals.topLevelApplication.m.nfNominal.format(b.temp[i]);
					textinput.text = b.s;
				}else {
					textinput.text = FlexGlobals.topLevelApplication.m.nfNominal.format(param);
				}
			}
			public function f_wsHasil():void
