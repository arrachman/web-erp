				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.pototal = 0;
				o.pototalpajak1detail = 0;
				o.pototalpajak2detail = 0;
				o.pototaltransaksi = 0;
				for(i=0;i<dg.dataProviderLength;i++){
					o.pototal += Number(dg.dataProvider.getItemAt(i).subtotal);
					o.pototalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					o.pototalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
			}
			
