			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							if(mb.menuBarItems[0].enabled){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(4,10,jenissimpan)){
									f_simpan();
								}
							}
						}
						break;
				}
			}	
			
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array, dgrid1:Object;
				switch(column){ 
					case "jml":
						dgrid1 = dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex];
						dgrid1.customdbl1 = (Number(dgrid1.jml) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
						dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml; 
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						FlexGlobals.topLevelApplication.F_hargaTotal(dg);
						break;
					case "customdbl1":
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
//						dgrid1.jml = Number(dgrid1.customdbl1) * Number(dgrid1.nilaisatuanlapangan);
//						dgrid1.jmlbarang = Number(dgrid1.jml) * Number(dgrid1.nilaisatuan);
						dgrid1.jml = (Number(dgrid1.nilaisatuanlapangan) / Number(dgrid1.nilaisatuan)) * Number(dgrid1.customdbl1)
						dgrid1.jmlbarang = Number(dgrid1.jml) * Number(dgrid1.nilaisatuan);
						//							
						break;
					case "pre_del":
						hapusserial();
						hapusbatch();
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgbiaya);
				f_hitungTotal();
			}
			//hapus serial jika barangnya tidak ada
			public function hapusserial():void{
				var s:int;
				if(ac_Serial.length > 0){
					for(s=ac_Serial.length-1; s>=0; s--){
						if(ac_Serial[s].nstidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							ac_Serial.removeItemAt(s);
						}
					}
				}
			}
			
			public function hapusbatch():void{
				var b:int;
				if(ac_Batch.length > 0){
					for(b=ac_Batch.length-1; b>=0; b--){
						if(ac_Batch[b].nbtidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							ac_Batch.removeItemAt(b);
						}
					}
				}
			}
			
			public function hapusaktiva():void{
				var a:int;
				if(ac_Aktiva.length > 0){
					for(a=ac_Aktiva.length-1; a>=0; a--){
						if(ac_Aktiva[a].atidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							ac_Aktiva.removeItemAt(a);
						}
					}
				}
			}
			
