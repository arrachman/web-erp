			public function f_hitungTotal():void
			{
//				hapusserial();
//				hapusbatch();
				o.prttotal = 0;
				o.prttotalpajak1detail = 0;
				o.prttotalpajak2detail = 0;
				o.prttotaltransaksi = 0;
				
				
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).subtotal != undefined)o.prttotal += Number(dg.dataProvider.getItemAt(i).subtotal);
					if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.prttotalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.prttotalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prttotal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prttotalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prttotalpajak2detail);

				o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.prttotal, o.txtdiskonpersen);
				txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal);
				o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.prttotal, o.txtbiayalainpersen);
				txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal);
				f_hitungTotalUtama();
//				o.prttotaltransaksi= (Number(o.prttotal) + Number(o.prttotalpajak1detail) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
//				o.prtsisatransaksi= (Number(o.prttotal) + Number(o.prttotalpajak1detail) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prttotaltransaksi);
//				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prtsisatransaksi);
			}
			
			public function f_hitungTotalUtama():void
			{
				if(chkhargapajak.selected == false){
					o.prttotaltransaksi= (Number(o.prttotal) + Number(o.prttotalpajak1detail) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
					o.prtsisatransaksi= (Number(o.prttotal) + Number(o.prttotalpajak1detail) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				}else{
					o.prttotaltransaksi= (Number(o.prttotal) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
					o.prtsisatransaksi= (Number(o.prttotal) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				}
				
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prttotaltransaksi);
				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prtsisatransaksi);
				
//				o.prttotaltransaksi= (Number(o.prttotal) + Number(o.prttotalpajak1detail) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
//				o.prtsisatransaksi= (Number(o.prttotal) + Number(o.prttotalpajak1detail) + Number(o.prttotalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prttotaltransaksi);
//				lblsisa.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.prtsisatransaksi);
			}
			
			public function f_hitungGrid():void{
				var dgrid:Object;
				for(i = 0; i<dg.dataProviderLength; i++){
					dgrid = dg.dataProvider[i]
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
//					dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
//					dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
					dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.pajak1nilai, dgrid.subtotal, dgrid.pajak1nilai, dgrid.pajak2nilai);
					dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.pajak2nilai, dgrid.subtotal, dgrid.pajak1nilai, dgrid.pajak2nilai);
				}
				
				f_hitungTotal();
			}
			
			public var indexjenis :int
			protected function cmbjenis_changeHandler(event:IndexChangeEvent):void
			{
				// TODO Auto-generated method stub
				if(cmbjenis.selectedIndex == 0){
					tbintang.visible = false;
					txtmatauang.enabled = true;
					mb.menuBarItems[4].enabled = true;
				}else{
					tbintang.visible = true;
					txtmatauang.enabled = false;
					mb.menuBarItems[4].enabled = false;
				}
				
				
			}
			
			protected function cmbjenis_closeHandler(event:DropDownEvent):void
			{
				// TODO Auto-generated method stub
				if(dg.dataProviderLength >= 1 && dg.dataProvider[0].kodebarang != ""){
					Alert.show(FlexGlobals.topLevelApplication.l('Data akan dihapus, lanjutkan ?'), FlexGlobals.topLevelApplication.l('Konfirmasi'), 3, null, function(e:Object):void{	
						if(e.detail == Alert.YES){
							
							// TODO Auto-generated method stub
							if(cmbjenis.selectedIndex == 0){
								tbintang.visible = false;
								txtmatauang.enabled = true;
								mb.menuBarItems[4].enabled = true;
							}else{
								tbintang.visible = true;
								txtmatauang.enabled = false;
								mb.menuBarItems[4].enabled = false;
							}
							
							o.prtidri = 0;
							FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
							o.txtdiskonpersen = 0;
							o.txtbiayalainpersen = 0;
							txtdiskonpersen.text = parentApplication.m.nfNominal.format(o.txtdiskonpersen.toString());
							txtbiayalainpersen.text = parentApplication.m.nfNominal.format(o.txtbiayalainpersen.toString());
							
							f_hitungGrid();
							
							o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.prttotal, o.txtdiskonpersen);
							txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal.toString());
							
							o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.prttotal, o.txtbiayalainpersen);
							txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal.toString());
							
							txtnoRI.text = "";
							f_hitungTotalUtama();
						}else{
							cmbjenis.selectedIndex = indexjenis;
							// TODO Auto-generated method stub
							if(cmbjenis.selectedIndex == 0){
								tbintang.visible = false;
								txtmatauang.enabled = true;
								mb.menuBarItems[4].enabled = true;
							}else{
								tbintang.visible = true;
								txtmatauang.enabled = false;
								mb.menuBarItems[4].enabled = false;
							}
						}
					});
				}
			}
			
			protected function chkhargapajak_changeHandler(event:Event):void
			{
				// TODO Auto-generated method stub
				for(var Index:int = 0; Index<dg.dataProviderLength; Index++){
					var dgrid1:Object;
					dgrid1 = dg.dataProvider[Index];
					if(chkhargapajak.selected){
						dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(true, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(true, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
					}else{
						dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(false, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
						dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(false, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
					}
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
			
