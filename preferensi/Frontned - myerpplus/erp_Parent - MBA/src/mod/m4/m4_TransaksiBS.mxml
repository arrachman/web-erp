								bsidrq1statuspo, bsidrq2statuspo, bsidrq3statuspo, bsidrq4statuspo, bsidrq5statuspo, cmbprogress.selectedItem.v, bsstatussebelumnya, 
								bsjmlrevisi, bscetakanke, bsinputuser, parentApplication.F_tglFormatDB(bsinputtgl), bsmodifikasiuser, parentApplication.F_tglFormatDB(bsmodifikasitgl), bsisclose, 
								bscustomtext1, bscustomtext2, bscustomtext3, bscustomtext4, bscustomtext5, bscustomint1, bscustomint2, 
								bscustomint3, bscustomdbl1, bscustomdbl2, bscustomdbl3, parentApplication.F_tglFormatDB(bscustomdate1), parentApplication.F_tglFormatDB(bscustomdate2), parentApplication.F_tglFormatDB(bscustomdate3)];
						utama = parentApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++)
							with(dg1.dataProvider.getItemAt(i)){
								if(idrqdetail1 != 0){
									a = [idbsdetail1, idbs, idrqdetail1, int(chk1), 1, catatan, ++n];
									if(detail == '')detail = parentApplication.F_splitArrayToString(a);
									else detail += "▲"+parentApplication.F_splitArrayToString(a);
								}
								if(idrqdetail2 != 0){
									a = [idbsdetail2, idbs, idrqdetail2, int(chk2), 2, catatan, ++n];
									if(detail == '')detail = parentApplication.F_splitArrayToString(a);
									else detail += "▲"+parentApplication.F_splitArrayToString(a);
								}
								if(idrqdetail3 != 0){
									a = [idbsdetail3, idbs, idrqdetail3, int(chk3), 3, catatan, ++n];
									if(detail == '')detail = parentApplication.F_splitArrayToString(a);
									else detail += "▲"+parentApplication.F_splitArrayToString(a);
								}
							}
						parentApplication.F_wsSimpan('simpan2', "M4_BsSimpan", parentApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					pesanAlertIng = "";
					pesanAlert = "";
					if(cmbasalbarang.selectedIndex < 0 || cmbasalbarang.textInput.text.length == 0)msgAlert(cmbasalbarang,'Item Origin','Asal Barang');
					if(cmbcarabayar.selectedIndex < 0 || cmbcarabayar.textInput.text.length == 0)msgAlert(cmbcarabayar,'Pay By','Cara Bayar');
					if(dttanggal.text.length == 0)msgAlert(dttanggal,'Date','Tanggal');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(txtmatauang.text.length == 0)msgAlert(txtmatauang,'Currency','Mata Uang');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)msgAlert(cmbprogress,'Progress','Progress');
					if(dg1.dataProvider.getItemAt(0).idrqdetail1 == undefined && dg1.dataProvider.getItemAt(0).idrqdetail2 == undefined && dg1.dataProvider.getItemAt(0).idrqdetail3 == undefined)msgAlert(dg1,'Detail Item','Detail Barang');
					if(pesanAlert != '')msgAlert('clear', '', '');
					
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlertIng+"  ("+pesanAlert+")" , "Information");}	
						validasi = false; 
					}
				}
			}
			
			public function f_defaultGrid():void
			{
				dg1.dataProvider.removeAll();
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
			protected function bandingkan():void{
				for(var i:int=0;i<dg1.dataProvider.length;i++){
					var rowIndex:int = i, hrg1:Number, hrg2:Number, hrg3:Number;
					with(dg1.dataProvider.getItemAt(rowIndex)){
						chk1 = false; chk2 = false; chk3 = false;
						hrg1 = harga1/nilaisatuan1; hrg2 = harga2/nilaisatuan2; hrg3 = harga3/nilaisatuan3;
						switch(hargatermin(Number(hrg1), Number(hrg2), Number(hrg3))){
							case 1:chk1 = true;break;
							case 2:chk2 = true;break;
							case 3:chk3 = true;break;
						}
					}
				}
				for(i=0;i<dg1.dataProviderLength;i++)
					dg1.dataProvider[i].no = (i+1);
				parentApplication.F_dgRefresh(dg1);
			}
			
			protected function hargatermin(harga1:Number = 0, harga2:Number = 0, harga3:Number = 0):Number{
				var h1:Number = harga1, h2:Number = harga2, h3:Number = harga3, h:Number;
				if(h1 > 0 && h2 > 0 && h3 > 0){
					if(h1 == h2 && h2 == h3){
//						h = ptermin(termin1, termin2, termin3);
						h = 1;
					}else if(h1 < h2 && h1 < h3){
						h = 1;
					}else if(h2 < h1 && h2 < h3){
						h = 2;
					}else if(h3 < h2 && h3 < h1){
						h = 3;
					}else if(h1 == h2){
//						h = ptermin(termin1, termin2, -1);
						h = 1;
					}else if(h2 == h3){
//						h = ptermin(-1, termin2, termin3);
						h = 2;
					}else if(h1 == h3){
//						h = ptermin(termin1, -1, termin3);
						h = 1;
					}
				}else if(h1 > 0 && h2 > 0){
//					if(h1 == h2) h = ptermin(termin1, termin2, -1);
					if(h1 == h2) h = 1;
					else if(h1 < h2)h = 1;
					else h = 2;
				}else if(h2 > 0 && h3 > 0){
//					if(h2 == h3) h = ptermin(-1, termin2, termin3);
					if(h2 == h3) h = 2;
					else if(h2 < h3)h = 2;
					else h = 3;
				}else if(h1 > 0 && h3 > 0){
//					if(h1 == h3) h = ptermin(termin1, -1, termin3);
					if(h1 == h3) h = 1;
					else if(h1 < h3)h = 1;
					else h = 3;
				}else if(h1 > 0){
					h = 1;
				}else if(h2 > 0){
					h = 2;
				}else if(h3 > 0){
					h = 3;
				}
				return h;
			}
			
			protected function ptermin(termin1:int = 0, termin2:int = 0, termin3:int = 0):int{
				var t1:int = termin1, t2:int = termin2, t3:int = termin3, t:int;
				if(t1 == t2 && t2 == t3){
					t = 1;
				}else if(t1 > t2 && t1 > t3){ 
					t = 1;
				}else if(t2 > t1 && t2 > t3){ 
					t = 2;
				}else if(t3 > t2 && t3 > t1){ 
					t = 3;
				}else if(t1 == t2){
					t = 1;
				}else if(t2 == t3){
					t = 2;
				}else if(t1 == t3){
					t = 1;
				}else if(t1 > 0 && t2 > 0){
					if(t1 > t2)t = 1;
					else t = 2;
				}else if(t2 > 0 && t3 > 0){
					if(t2 > t3)t = 2;
					else t = 3;
				}else if(t1 > 0 && t3 > 0){
					if(t1 > t3)t = 1;
					else t = 3;
				}
				return t;			
			}

