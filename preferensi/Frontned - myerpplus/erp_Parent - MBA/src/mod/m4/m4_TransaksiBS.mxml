				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					pesanAlertIng = "";
					pesanAlert = "";
					if(cmbasalbarang.selectedIndex < 0 || cmbasalbarang.textInput.text.length == 0)msgAlert(cmbasalbarang,'Item Origin','Asal Barang');
					if(cmbcarabayar.selectedIndex < 0 || cmbcarabayar.textInput.text.length == 0)msgAlert(cmbcarabayar,'Pay By','Cara Bayar');
					if(dttanggal.text.length == 0)msgAlert(dttanggal,'Date','Tanggal');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(txtmatauang.text.length == 0)msgAlert(txtmatauang,'Currency','Mata Uang');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)msgAlert(cmbprogress,'Progress','Progress');
					if(pesanAlert != '')msgAlert('clear', '', '');
					
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlertIng+"  ("+pesanAlert+")" , "Information");}	
						validasi = false; 
					}
				}
			}

