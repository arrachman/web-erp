			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case "txtnogrup":
						paket = 'CdM4_Rq_Nogrup';
						wsfilter = 'rqnogrup ="'+txtnogrup.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'rqnogrup desc';
						break;
					case "txtnorq1":
						paket = 'CdM4_Rq';
						if(txtnogrup.text != ''){
							wsfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnogrup ="'+txtnogrup.text.split('"').join('\\"')+'" AND rqnotransaksi ="'+txtnorq1.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
							csfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnogrup ="'+txtnogrup.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
						}else{
							wsfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnotransaksi ="'+txtnorq1.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
							csfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
						}
						csfield = 2;
						sort = 'rqnotransaksi desc';
						break;
					case "txtnorq2":
						paket = 'CdM4_Rq';
						if(txtnogrup.text != ''){
							wsfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnogrup ="'+txtnogrup.text.split('"').join('\\"')+'" AND rqnotransaksi ="'+txtnorq2.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
							csfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnogrup ="'+txtnogrup.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
						}else{
							wsfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnotransaksi ="'+txtnorq2.text.split('"').join('\\"')+' and (rqstatus IN(2,3))"';
							csfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
						}
						csfield = 2;
						sort = 'rqnotransaksi desc';
						break;
					case "txtnorq3":
						paket = 'CdM4_Rq';
						if(txtnogrup.text != ''){
							wsfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnogrup ="'+txtnogrup.text.split('"').join('\\"')+'" AND rqnotransaksi ="'+txtnorq3.text.split('"').join('\\"')+' and (rqstatus IN(2,3))"';
							csfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnogrup ="'+txtnogrup.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
						}else{
							wsfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" AND rqnotransaksi ="'+txtnorq3.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
							csfilter = 'rqmatauang ="'+txtmatauang.text.split('"').join('\\"')+'" and (rqstatus IN(2,3))';
						}
						csfield = 2;
						sort = 'rqnotransaksi desc';
						break;
					case "txtmatauang":
						paket = 'CdM1_Currency';
						wsfilter = 'caktif = 1 AND ckode = "'+txtmatauang.text.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case "txtbagperbandingan":
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="K") AND kkode ="'+txtbagperbandingan.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="K")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).bsbagianperbandingan+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).bsbagianperbandingan+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtcatatan":
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "BS"';
						sort = 'tnkode asc';
						break;
					case "kodebarang":
//						paket = 'CdM1_Item';
//						wsfilter = 'baktif = 1 AND bkode = "'+obj.kodebarang.split('"').join('\\"')+'"';
//						csfilter = 'baktif = 1';
//						sort = 'bkode asc';
						break;
					case "catatan":
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "BS"';
						sort = 'tndkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ob : Object, s:String = parentApplication.subject, b:Boolean, j:int, n:int = -1, nm:String = '', ws:Object;
				if(parentApplication.wsSuccess){
					obj = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case "txtnogrup":
							txtnogrup.text = obj.rqnogrup;
							IdRQ = obj.rqid;
							break;
						case "txtnorq1":
							txtnorq1.text = obj.rqnotransaksi;
							lblsupplier1.text = obj.rqsuppliernama;
							lbljttermin1.text = obj.rqtermin;
							u.getItemAt(0).bsidrq1 = obj.rqid;
							FlexGlobals.topLevelApplication.F_wsGetDataById('RQgetdata1', 'M4_RqGetdataById', obj.rqid);
							break;	
						case "RQgetdata1":
							termin1 = parentApplication.wsArrUtama.getItemAt(0).rqtermin;
							for(i=dg1.dataProviderLength-1;i>=0;i--)
								with(dg1.dataProvider.getItemAt(i))
									if(vharga1)
										if(vharga2 == false && vharga3 == false)
											dg1.dataProvider.removeItemAt(i);
										else{
											vharga1=false; harga1=0;
											chk1_enabled = false;
											idrqdetail1 = 0;
										}
							
							for(i=0;i<parentApplication.wsArrDetail.length;i++){
								b = true;
								o = parentApplication.wsArrDetail.getItemAt(i);
								for(j=0;j<dg1.dataProviderLength;j++)
									with(dg1.dataProvider.getItemAt(j)){
										if(idbarang == o.idbarang && namabarang == o.namabarang){
											harga1 = o.harga;
											idrqdetail1 = o.idrqdetail;
											vharga1 = true;
											chk1_enabled = true;
											b = false;
											satuan1 = o.satuan;
											nilaisatuan1 = o.nilaisatuan;
											break;
										}
									}
								
								if(b)
									dg1.dataProvider.addItem({no : dg1.dataProviderLength+1,
										kodebarang : o.kodebarang,
										tipebarang : o.tipebarang,
										namabarang : o.namabarang,
										chk1 : true,
										chk1_enabled : true,
										harga1 : o.harga,
