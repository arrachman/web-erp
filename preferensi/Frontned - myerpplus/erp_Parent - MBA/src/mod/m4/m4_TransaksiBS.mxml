				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 4, "BS");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
					dg1.dataProvider.removeAll();
				}else{
					if(filtersplit[1] == 'history'){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_BsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
