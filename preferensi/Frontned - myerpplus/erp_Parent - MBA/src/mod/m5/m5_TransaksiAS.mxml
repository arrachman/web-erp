	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.FlexEvent;
			
			import spark.components.Image;
			import spark.components.NumericStepper;
			import spark.components.RadioButton;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean, pesanAlert:String, t:TitleWindow, img:Image, UFungsional:String, i:int,fu:Object, isUpdate:Boolean, hf:Object, ft:Object;
			public  var o:Object={};
			public var vIdkontak:int, arrColumn:Array = new Array, matauang:String, kurs:Number, getNotransaksi:String;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction(5, "As");
			protected var arrMenuBar:ArrayCollection;
			public var terminharijatuhtempo:Number = 0;
			//public var dg:DataGrid;
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "calculator":
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						if(Number(data) > 0){
							if(txtmatauang.text == UFungsional){
								if(dataField == 'jumlahvalas'){
									Alert.show(parentApplication.l('Jumlah Valas harus 0 karena mata uang fungsional'), parentApplication.l('Informasi'));
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = 0;
								}
								
							}else{
								if(dataField == 'jumlahvalas'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas * o.txtkurs;
									
								}
								if(dataField == 'jumlah'){
									dg.dataProvider[dg.selectedCell.rowIndex].jumlah = data;
									dg.dataProvider[dg.selectedCell.rowIndex].jumlahvalas = dg.dataProvider[dg.selectedCell.rowIndex].jumlah / o.txtkurs;
								}
							}
						}
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			public function f_focusOnMe():void
			{
				cmbjenis.setFocus();
			}
			
			protected function f_persiapan():void
			{
				ft= FlexGlobals.topLevelApplication.F_tglFormatDB;
				hf=FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				tab.focusEnabled = false;
				fu=FlexGlobals.topLevelApplication.m.nfNominal.format;
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				FlexGlobals.topLevelApplication.F_RequiredLabel([tjenis, tcustomer, takun, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tjenis, tcustomer, takun, tnoso, tnoip, ttanggal, tnotransaksi, tmatauang, tkurs, tprogress,
					tkontakperson, ttermin, tbagianterima, talamatsupplier, talamatkontakperson, tcostcenter, tdivisi, tsubdivisi, tproyek]);
				
				cmbjenis.selectedIndex=0;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				cmbjenis.dataProvider = new ArrayCollection([{l:'UM Penjualan',v:0},{l:'Titipan',v:1}]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttanggalnoref,dttgljt]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress,cmbjenis]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson, txaalamatkontakperson, txaalamatsupplier]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtcustomer,txtnoIP, txtnoso,txtakun,txtmatauang,txttermin,txtbagianterima,txtcostcenter,txtdivisi,txtsubdivisi,txtproyek]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txtnotransaksi,txturaian,txtnoref,chkauto,chkposting]);
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"Files", icon:"tbattachment", enabled:"false"},
					{label:"Links", icon:"tblink", enabled:"true"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
				function f_mbSimpan():void{
					f_delundefined(dg);
					var  jenissimpan:int = 1;
					if(isUpdate == false){
						jenissimpan = 1
					}else{
						jenissimpan = 2
					}
					if(FlexGlobals.topLevelApplication.apaBisaAkses(5,5,jenissimpan)){
						f_simpan();
					}
				}
				function f_mbBuka():void{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('As');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
				}
				function f_mbCatatan():void{
					if (mb.menuBarItems[3].enabled){FlexGlobals.topLevelApplication.F_OpenNotes(o.assumber,o.asid,txtnotransaksi.text);}
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled)FlexGlobals.topLevelApplication.F_OpenUploadFile('AS', o.asid,txtnotransaksi.text);
				}
				function f_mbLinks():void
				{
					FlexGlobals.topLevelApplication.f_mbLinks(5, 'As');
				}
				
				// untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(5,5,[dg],'transaksi');
				f_validasi();
				
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.S:if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(5,5,jenissimpan)){
								f_simpan();
							}
						}
							break;
					}
				}
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN, function keydown(e:KeyboardEvent):void{
					if(e.keyCode == Keyboard.ENTER || e.keyCode == Keyboard.DOWN){
						dg.setSelectedCell(0,1)
					}
				});
				
			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 5, "AS");
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
				else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_AsHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_AsGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 5, "AS");
				cmbprogress.enabled = true;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				mb.menuBarItems[7].visible = false;
				tab.selectedIndex=0;
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				kurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = fu(o.txtkurs);
				txtkurs.enabled = false;
				f_focusOnMe(); 
				isUpdate = false;
				txtakun.text= FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'UMPenjualan');//Ambil dari m0_setting 'kode coa'
				lblakun.text= FlexGlobals.topLevelApplication.getSetting(0, 'akunnama', 'UMPenjualan');//Ambil dari m0_setting 'nama coa'
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("AS");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("AS",1);
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalvalas],fu(0));
				parentApplication.F_SetNilaiText([dttgl,dttanggalnoref,dttgljt], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtcustomer, txtnoso, txtnoIP, lblcustomer,txtkontakperson,txtnoref,txaalamatkontakperson,txaalamatsupplier,txtcostcenter,txtdivisi,txtsubdivisi,txttermin,txtproyek]);
				txtbagianterima.text = FlexGlobals.topLevelApplication.ukontakkode;
				lblbagpenjualan.text = FlexGlobals.topLevelApplication.ukontaknama;
				
				o.idascarabayar = 0; o.asid = 0; o.ascabang = FlexGlobals.topLevelApplication.ucabang; o.aslokasi = FlexGlobals.topLevelApplication.ulokasi; o.assumber="AS"; 
				o.askodepa = 0; o.askontak = 0; o.as1alamat1 = txaalamatsupplier.text; o.as1alamat2 = ''; o.as1alamat3 = ''; 
				o.as2alamat1 = txaalamatkontakperson.text; o.as2alamat2 = ''; o.as2alamat3 = ''; o.astgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal; o.asidso = 0; o.asidip = 0;
				o.asjumlah = 0; o.asjumlahvalas = 0; o.asjumlahbayar = 0; o.asjumlahbayarvalas = 0; o.asstatusbayar = 0; o.astgllunas = parentApplication.m.DateFirst; 
				o.asstatussebelumnya = 0; o.asjmlrevisi = 0; o.ascetakanke = 0; 
				o.asinputuser = FlexGlobals.topLevelApplication.userid; o.asinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.asmodifikasiuser = 0; o.asmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.asisclose = 0; o.ascustomtext1 = ''; 
				o.ascustomtext2 = ''; o.ascustomtext3 = ''; o.ascustomtext4 = ''; o.ascustomtext5  = '';
				o.ascustomint1 = 0; o.ascustomint2 = 0; o.ascustomint3 = 0; 
				o.ascustomdbl1 = 0; o.ascustomdbl2 = 0; o.ascustomdbl3 = 0; 
				o.ascustomdate1 = parentApplication.m.DateFirst; o.ascustomdate2 = parentApplication.m.DateFirst; 
				o.ascustomdate3 = parentApplication.m.DateFirst;
				o.asbagianterima = FlexGlobals.topLevelApplication.ukontak;
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				switch(column){
					case "jumlah":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) / o.txtkurs;
								
							}else{
								jumlahvalas = 0;
							}
						}
						
						break;
					case "jumlahvalas":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
						}
						break;
					case "bank":
					case "nogiro":
					case "noacbank":
						editable();
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungvalas()
				f_hitungTotal()
				
			}
			
			public function editable():void{
				if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==0 || dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==3){
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).noacbank = '';
				}
					
				else {
					if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar == 1){
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
						
					}
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, dgrid:Object;
				if(dg.selectedCell != null)dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
				switch(target){
					case "txtnoso":
						if(txtnoso.enabled){
							if(txtcustomer.text.length > 0){
								paket = "CdM5_So";
								wsfilter = '((sostatus= 2 OR sostatus=3) AND socustomer = '+o.askontak+' AND soisclose=0 and somatauang = "'+txtmatauang.text+'") and sonotransaksi="'+ txtnoso.text +'"';
								csfilter = '((sostatus= 2 OR sostatus=3) AND socustomer = '+o.askontak+' AND soisclose=0 and somatauang = "'+txtmatauang.text+'") ';
								sort = "sonotransaksi desc";
							}else{
								Alert.show(parentApplication.l('Customer harus diisi terlebih dahulu'), parentApplication.l('Informasi'));
							}
							
						}
						
						break;
					case "txtnoIP":
						//filter = (ipkontak = kontaksetting or ipkontak = sing ndk filter) and (ipstatus = 2 or ipstatus = 3)
						if(txtcustomer.text.length > 0){
							paket = "CdM5_Ip";
							wsfilter = '(ipkontak = '+FlexGlobals.topLevelApplication.getSetting(0,'company', 'Kontak')+' or ipkontak = '+o.askontak+') and (ipstatus = 2 or ipstatus = 3) and ipmatauang = "'+txtmatauang.text+'" and ipnotransaksi="'+ txtnoIP.text +'"';
							csfilter = '(ipkontak = '+FlexGlobals.topLevelApplication.getSetting(0,'company', 'Kontak')+' or ipkontak = '+o.askontak+') and (ipstatus = 2 or ipstatus = 3) and ipmatauang = "'+txtmatauang.text+'"';
							sort = "ipnotransaksi desc";
						}else{
							Alert.show(parentApplication.l('Customer harus diisi terlebih dahulu'), parentApplication.l('Informasi'));
						}
						break;
					case "txtcustomer":
						paket = "CdM1_Contact";
						wsfilter = '(kaktif = 1 AND kkategori="C") AND kkode ="'+txtcustomer.text+'"';
						csfilter = '(kaktif = 1 AND kkategori="C")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.askontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.askontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txaalamatkontakperson":
						paket = "CdM1_Contact_Attention";
						/* wsfilter = 'kaidkontak ='+o.askontak+' AND kakodekontak ="'+txtkontakperson.text+'"';*/
						csfilter = 'kaidkontak ='+o.askontak+''; 
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txaalamatsupplier":
						paket = "CdM1_Contact_Attention";
						/* wsfilter = 'kaidkontak ='+o.askontak+' AND kakodekontak ="'+txtkontakperson.text+'"';*/
						csfilter = 'kaidkontak ='+o.askontak+''; 
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtakun":
						paket = "CdM1_Coa";
						csfilter='caktif=1 and cgd="D"';
						wsfilter = 'caktif=1 AND cgd="D" AND cnomor ="'+txtakun.text+'"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif = 1 AND ckode = "'+ txtmatauang.text +'"';
						csfilter = 'caktif = 1';
						sort = 'ckode asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif = 1 AND tnsumber = "AS"';
						sort = 'tnkode asc';
						break;
					case "txttermin":
						paket = "CdM1_Terms";
						wsfilter = 'traktif = 1 AND trkode = "'+ txttermin.text +'"';
						csfilter = 'traktif = 1';
						sort = 'trkode asc';
						break;
					case "txtbagianterima":
						paket = "CdM1_Contact";
						wsfilter = '(kaktif = 1 AND kkategori="K") AND kkode ="'+txtbagianterima.text+'"';
						csfilter = '(kaktif = 1 AND kkategori="K")';
						csfield = 4;
						sort = 'kkode asc';
						break;
					case "txtcostcenter":
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif = 1 AND cckode = "'+ txtcostcenter.text +'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case "txtdivisi":
						paket = "CdM1_Division";
						wsfilter = 'daktif = 1 AND dkode = "'+ txtdivisi.text +'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case "txtsubdivisi":
						paket = "CdM1_Subdivision";
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+txtdivisi.text+'" AND sdkode = "'+ txtsubdivisi.text +'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+txtdivisi.text+'"';
						sort = 'sdkode asc';
						break;
					case "txtproyek":
						paket = "CdM1_Project";
						wsfilter = 'paktif = 1 AND pkode = "'+ txtproyek.text +'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
					case "carabayarnama":
						paket = "CdM0_Carabayar";
						wsfilter = 'nama = "'+dgrid.carabayarnama+'"';
						break;
					case "rekbank":
						paket = "CdM1_Coa";
						if (dgrid.carabayar=="0"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="1"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="2"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="3"){
							wsfilter = '(cgd="D" and caktif=1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="" || dgrid.carabayar== undefined){
							wsfilter = 'AA';
							csfilter = 'AA';
						}
						sort = 'cnomor asc';
						break;
					case "bank":
						if(dgrid.carabayar == 1 || dgrid.carabayar == 2){
							paket = "CdM1_Bank";
							wsfilter = 'baktif = 1 AND bkode = "'+dgrid.bank+'"';
							csfilter = 'baktif = 1';
							sort = 'bkode asc';
						}
						break;
					case "catatan":
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber = "AS"';
						sort = 'tndkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
