				//hitung selisih kurs
				if(txtmatauang.text != UFungsional){
					o.vppselisihkurs = o.vpptotalap - o.vpptotalar - o.vppdiskontermin - ((o.vpptotalapvalas - o.vpptotalarvalas - o.vppdiskonterminvalas) * hf(txtkurs.text));
				}
				//hitungbayar
				o.vppbayar = o.vpptotalap - o.vpptotalar - o.vppdiskontermin -  o.vppselisihkurs;
				o.vppbayarvalas = o.vpptotalapvalas - o.vpptotalarvalas - o.vppdiskonterminvalas;
				//set label
				lbltotalAP.text = parentApplication.m.nfNominal.format(o.vpptotalap); lbltotalAPvalas.text = parentApplication.m.nfNominal.format(o.vpptotalapvalas);
				lbltotalAR.text = parentApplication.m.nfNominal.format(o.vpptotalar); lbltotalARvalas.text = parentApplication.m.nfNominal.format(o.vpptotalarvalas);
				lbldiskontermin.text = parentApplication.m.nfNominal.format(o.vppdiskontermin); lbldiskonterminvalas.text = parentApplication.m.nfNominal.format(o.vppdiskonterminvalas);
				lblselisihkurs.text = parentApplication.m.nfNominal.format(o.vppselisihkurs);
				lblbayar.text = parentApplication.m.nfNominal.format(o.vppbayar); lblbayarvalas.text = parentApplication.m.nfNominal.format(o.vppbayarvalas);
				lblselisihARAP.text = parentApplication.m.nfNominal.format(o.vpptotalar - o.vpptotalap - o.vppdiskontermin + o.vppselisihkurs);
				// set label tiap tiap tab
				lbltotaltransaksiSI1.text = parentApplication.F_formatNominal(o.totaltransaksiRI); lbltotaltransaksiRP1.text = parentApplication.F_formatNominal(o.totaltransaksiRP); lbltotaltransaksiIP1.text = parentApplication.F_formatNominal(o.totaltransaksiIP); lbltotaltransaksiAS1.text = parentApplication.F_formatNominal(o.totaltransaksiAP); lbltotaltransaksiPRT1.text = parentApplication.F_formatNominal(o.totaltransaksiPRT);
				lblterbayarSI1.text = parentApplication.F_formatNominal(o.terbayarRI); lblterbayarRP1.text = parentApplication.F_formatNominal(o.terbayarRP); lblterbayarIP1.text = parentApplication.F_formatNominal(o.terbayarIP); lblterbayarAS1.text = parentApplication.F_formatNominal(o.terbayarAP); lblterbayarPRT1.text = parentApplication.F_formatNominal(o.terbayarPRT);
				lblsisaSI1.text = parentApplication.F_formatNominal(o.sisaRI); lblsisaRP1.text = parentApplication.F_formatNominal(o.sisaRP); lblsisaIP1.text = parentApplication.F_formatNominal(o.sisaIP); lblsisaAS1.text = parentApplication.F_formatNominal(o.sisaAP); lblsisaPRT1.text = parentApplication.F_formatNominal(o.sisaPRT);
				lbltotaltransaksiCOA1.text = parentApplication.F_formatNominal(o.totaltransaksiCOA);
			}
			
