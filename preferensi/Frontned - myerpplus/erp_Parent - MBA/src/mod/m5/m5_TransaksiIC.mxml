					FlexGlobals.topLevelApplication.F_wsSearch('Ic_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dg5.dataProvider.length > 0 && dg5.dataProvider[0].notransaksi != '' && loop == 2){
					FlexGlobals.topLevelApplication.F_wsSearch('Ic_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dg2.dataProvider.length > 0 && dg2.dataProvider[0].notransaksi != '' && loop == 3){
					FlexGlobals.topLevelApplication.F_wsSearch('Ic_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(dg3.dataProvider.length > 0 && dg3.dataProvider[0].notransaksi != '' && loop == 4){
					FlexGlobals.topLevelApplication.F_wsSearch('Ic_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
				}else if(loop < 5)f_uangRefreshGrid();
				if(loop > 4){ cekfilter = false; }
			}
			
