			public var loop:int = -1;
			public function f_uangRefreshGrid():void
			{
				loop++;
				if(dg1.dataProvider.length > 0 && dg1.dataProvider[0].notransaksi != '' && loop == 0){
					FlexGlobals.topLevelApplication.F_wsSearch('Ic_TakeData', 'M5_IcTakedataSearch', 0, 0, f_filterdatamatauang());
