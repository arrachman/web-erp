			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var mnid:int, dg:DataGrid;
				if(tab.selectedIndex == 0){mnid = 10; dg = dg1}
				else if(tab.selectedIndex == 1){mnid = 41; dg = dg4}
				else if(tab.selectedIndex ==2){mnid = 44; dg = dg5}
				else if(tab.selectedIndex ==3){mnid = 5; dg = dg2}
				else if(tab.selectedIndex ==4){mnid = 12; dg = dg3}
				
				switch (components){
					case "checkBoxHeader":
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case "checkBox":
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						break;
					case "link":
						FlexGlobals.topLevelApplication.openForm(5, mnid, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idtransaksi);
						break;
					switch (components){
						case "calculator":
							dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
							break;
					}
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
