				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtdiskonnilai, lblpajak1, lblpajak2, txtbiayalainnilai, txtalamatcustomer, txtalamatkirim]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref]);
				parentApplication.F_TextInputDiskonbertingkat([txtdiskonpersen, txtbiayalainpersen]);
//				parentApplication.F_TextInputNumberOnlyMode([txtdiskonpersen, txtbiayalainpersen]);
