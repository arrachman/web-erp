//					o.txtdiskonpersen = txtdiskonpersen.text;
					o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
					txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
					f_hitungTotalUtama();
				});
				
				txtbiayalainnilai.addEventListener(spark.events.TextOperationEvent.CHANGE,function  ():void{
					o.txtbiayalainpersen = (o.txtbiayalainnilai / n.vtotal) * 100;
					txtbiayalainpersen.text = parentApplication.m.nfNominal.format(o.txtbiayalainpersen.toString());
					f_hitungTotalUtama();
				});
				txtbiayalainpersen.addEventListener(spark.events.TextOperationEvent.CHANGE,function  ():void{
//					o.txtbiayalainnilai = (o.txtbiayalainpersen/100) * n.vtotal;
					o.txtbiayalainnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtbiayalainpersen);
					txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
					f_hitungTotalUtama();
				});
				
				
				tmrHardware.addEventListener(TimerEvent.TIMER, function(event:TimerEvent):void{
					myhardware.connect();
				});	
			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var  idtransaksi : String = filtersplit[0];
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 5, "SO");
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit[1] == 'history'){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_SoHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
							if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
								idtransaksi = parentApplication.m.ArrFilter[0];
								idtransaksi = idtransaksi.replace('p1  = "', '');
								idtransaksi = idtransaksi.replace('"', '');
								FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_SoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}else{
								FlexGlobals.topLevelApplication.F_wsGetDataById('copyTransaksi', 'M5_SoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_SoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
				}
			}
			
