				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tcustomer, tsalesman, turaian, ttanggal, tnotransaksi, tuang, tkurs, tprogress, tkontakperson, ttermin, tcatatan, talamatcustomer, talamatkirim, tekspedisi, ttglkirim, tnoref, ttglnoref, ttotal, tdiskon, tpajak1, tpajak2, tbiayalain, ttotaltransaksi]);
				parentApplication.F_RequiredLabel([tcustomer, tsalesman, ttanggal, tnotransaksi, tuang, tkurs, tprogress]);
				cmbasalbarang.dataProvider = new ArrayCollection([{l:'Lokal', v:'0'}, {l:'Import', v:'1'}]);
				cmbcarabayar.dataProvider = new ArrayCollection([{l:'Tunai', v:'0'}, {l:'Kredit', v:'1'}]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalkirim, dttanggalnoref, dttgljt]);
				parentApplication.F_ComboBoxStandard([cmbprogress, cmbasalbarang, cmbcarabayar]);
