				vPosting = parentApplication.getSetting(0, 'accounting', 'AutoPosting');
				
				txtdiskonnilai.addEventListener(KeyboardEvent.KEY_DOWN, removeSkip);
				txtbiayalainnilai.addEventListener(KeyboardEvent.KEY_DOWN, removeSkip);
				function removeSkip(event:KeyboardEvent):void
				{
					if((event.keyCode==Keyboard.DOWN)||(event.keyCode==Keyboard.ENTER))
						parentApplication.focusMgr(true);
					else if(event.keyCode==Keyboard.UP)
						parentApplication.focusMgr(false);
				}
				
				f_validasi();
				
				// fungsi menubar
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				function f_mbSimpan():void
				{
					if(mb.menuBarItems[0].enabled)
						f_simpan();
				}
				function f_mbBuka():void
				{
					if(txtsumber.text == "SI"){
						FlexGlobals.topLevelApplication.f_bukaTransaksi("Si","sisaldoawal = 1");
					}else if(txtsumber.text == "SR"){
						FlexGlobals.topLevelApplication.f_bukaTransaksi("Sr","srsaldoawal = 1");
					}else{
						Alert.show(FlexGlobals.topLevelApplication.l('Sumber harus diisi "SI" atau "SR" !'), FlexGlobals.topLevelApplication.l("Informasi"));
					}
					
				}
				
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[3].enabled)
						if(txtsumber.text == 'SI'){
							parentApplication.F_OpenNotes('SI', o.siid, txtnotransaksi.text);
						}else if(txtsumber.text == 'SR'){
							parentApplication.F_OpenNotes('SR', o.srid, txtnotransaksi.text);
						}else{
							Alert.show(FlexGlobals.topLevelApplication.l('Sumber harus diisi "SI" atau "SR" !'), FlexGlobals.topLevelApplication.l("Informasi"));
						}
					
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[4].enabled)
						if(txtsumber.text == 'SI'){
							parentApplication.F_OpenUploadFile('SI', o.siid, txtnotransaksi.text);
						}else if(txtsumber.text == 'SR'){
							parentApplication.F_OpenUploadFile('SR', o.srid, txtnotransaksi.text);
						}else{
							Alert.show(FlexGlobals.topLevelApplication.l('Sumber harus diisi "SI" atau "SR" !'), FlexGlobals.topLevelApplication.l("Informasi"));
						}
						
				}
				
				function f_mbLinks():void
				{
					if(mb.menuBarItems[5].enabled){
						if(txtsumber.text == "SI"){
							FlexGlobals.topLevelApplication.f_mbLinks(5,'Si');
						}else if(txtsumber.text == "SR"){
