			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(mb.menuBarItems[0].enabled)
							if(e.ctrlKey)f_simpan();
						break;
				}
			}	
			
			public function f_focusOnMe():void
			{
				txtsumber.setFocus();
			}
			
			protected function f_persiapan():void
			{
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tcustomer, tsalesman, tnoas, tgudang, turaian, ttanggal, tnotransaksi, tuang, tkurs, tprogress, tkontakperson, ttermin, tcatatan, talamatcustomer, talamatkirim, tekspedisi, ttglkirim, tnoref, ttglnoref, tnofakturpajak, ttotal, tdiskon, tpajak1, tpajak2, tbiayalain, ttotaltransaksi]);
				parentApplication.F_RequiredLabel([tsumber, tcustomer, tsalesman, ttanggal, tnotransaksi, tuang, tkurs, tprogress]);
				cmbasalbarang.dataProvider = new ArrayCollection([{l:'Lokal', v:'0'}, {l:'Import', v:'1'}]);
				cmbcarabayar.dataProvider = new ArrayCollection([{l:'Tunai', v:'0'}, {l:'Kredit', v:'1'}]);
				parentApplication.F_DateFieldStandard([dttanggal, dttanggalkirim, dttanggalnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress, cmbasalbarang, cmbcarabayar]);
				parentApplication.F_txtpencarian([txtsumber, txtnoas, txtcustomer, txtsalesman, txtgudang, txtmatauang, txttermin, txtekspedisi]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan, txtdiskonnilai, txttotalpajak1, txttotalpajak2, txtbiayalainnilai]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref, txtnofakturpajak]);
				parentApplication.F_TextInputDiskonbertingkat([txtdiskonpersen, txtbiayalainpersen]);
