			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				
				if(FlexGlobals.topLevelApplication.FormFilter== ''){
					f_kondisiAwal();
				}else{
					var sumber:String = "";
					if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
						sumber = FlexGlobals.topLevelApplication.m.ArrFilter[0];
					}else{
						sumber = txtsumber.text;
					}
					if(filtersplit[1] == "history"){
						if(sumber == 'Si'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilHistorySI', 'M5_Si_HistorySearch',1,1, 'siidhistory = "'+idtransaksi+'"','', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else if(sumber == 'Si'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilHistorySR', 'M5_Sr_HistorySearch',1,1, 'sridhistory = "'+idtransaksi+'"','', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}else {
						if(sumber == 'SI'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilSI', 'M5_SiBSearch',1,1,'siid = "'+idtransaksi+'"','',FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else if(sumber == 'SR'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilSR', 'M5_SrBSearch',1,1,'srid = "'+idtransaksi+'"','',FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
						
					}
				}
				//end of set getdata by id===============================================================================================
			}
