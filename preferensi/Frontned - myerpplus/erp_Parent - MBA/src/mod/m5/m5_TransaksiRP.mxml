			{
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 5, "RP");
				cmbprogress.enabled = true;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].visible = false;
				mb.menuBarItems[7].visible = false;
				tab.selectedIndex=0;
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				matauang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				kurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');
				txtkurs.text = fu(o.txtkurs);
				txtkurs.enabled = false;
				f_focusOnMe(); 
				isUpdate = false;
				txtakun.text= FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'PiutangOngkosKirim');//Ambil dari m0_setting 'kode coa'
				lblakun.text= FlexGlobals.topLevelApplication.getSetting(0, 'akunnama', 'PiutangOngkosKirim');//Ambil dari m0_setting 'nama coa'
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("RP");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("RP",1);
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalvalas],fu(0));
				parentApplication.F_SetNilaiText([dttgl,dttanggalnoref,dttgljt], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtcustomer, txtnosi, lblcustomer,txtkontakperson,txtnoref,txaalamatkontakperson,txaalamatsupplier,txtcostcenter,txtdivisi,txtsubdivisi,txttermin,txtproyek]);
				txtbagpembayaran.text = FlexGlobals.topLevelApplication.ukontakkode;
				lblbagpembelian.text = FlexGlobals.topLevelApplication.ukontaknama;
				
				o.idrpcarabayar = 0; o.rpid = 0; o.rpcabang = FlexGlobals.topLevelApplication.ucabang; o.rpjenis = 0; o.rplokasi = FlexGlobals.topLevelApplication.ulokasi; o.rpsumber="RP"; 
				o.rpkodepa = 0; o.rpkontak = 0; o.rp1alamat1 = txaalamatsupplier.text; o.rp1alamat2 = ''; o.rp1alamat3 = ''; 
				o.rp2alamat1 = txaalamatkontakperson.text; o.rp2alamat2 = ''; o.rp2alamat3 = ''; o.rptgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal; o.rpidsi = 0; 
				o.rpjumlah = 0; o.rpjumlahvalas = 0; o.rpjumlahbayar = 0; o.rpjumlahbayarvalas = 0; o.rpstatusbayar = 0; o.rptgllunas = parentApplication.m.DateFirst; 
				o.rpstatussebelumnya = 0; o.rpjmlrevisi = 0; o.rpcetakanke = 0; 
				o.rpinputuser = FlexGlobals.topLevelApplication.userid; o.rpinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.rpmodifikasiuser = 0; o.rpmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.rpisclose = 0; o.rpcustomtext1 = ''; 
				o.rpcustomtext2 = ''; o.rpcustomtext3 = ''; o.rpcustomtext4 = ''; o.rpcustomtext5  = '';
				o.rpcustomint1 = 0; o.rpcustomint2 = 0; o.rpcustomint3 = 0; 
				o.rpcustomdbl1 = 0; o.rpcustomdbl2 = 0; o.rpcustomdbl3 = 0; 
				o.rpcustomdate1 = parentApplication.m.DateFirst; o.rpcustomdate2 = parentApplication.m.DateFirst; 
				o.rpcustomdate3 = parentApplication.m.DateFirst;
				o.rpbagianterima = FlexGlobals.topLevelApplication.ukontak;
				
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				//dg.setSelectedCell(0,0);
				switch(column){
					case "jumlah":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) / o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
						}
						
						break;
					case "jumlahvalas":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
						}
						break;
					case "bank":
					case "nogiro":
					case "noacbank":
						editable();
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal()
				f_hitungvalas();
			}
			public function editable():void{
				if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==0 || dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar ==3){
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bank = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
					dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).noacbank = '';
				}
					
				else {
					if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).carabayar == 1){
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).nogiro = '';
						
					}
				}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, dgrid:Object;
				if(dg.selectedCell != null)dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
				switch(target){
					case "txtnosi":
						paket = 'CdM5_Si';
						wsfilter = '((sistatus= 2 OR sistatus=3) AND sicustomer ='+o.rpkontak+' AND siisclose=0) and sinotransaksi="'+ txtnosi.text +'"';
						csfilter = '((sistatus= 2 OR sistatus=3) AND sicustomer ='+o.rpkontak+' AND siisclose=0)';
						sort = 'sinotransaksi desc';
						break;
					case "txtcustomer":
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+txtcustomer.text+'"';
						csfilter = '(kaktif=1 AND kkategori="C")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.rpkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = "kaidkontak ="+o.rpkontak+"";
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txaalamatkontakperson":
						paket = "CdM1_Contact_Attention";
						/* wsfilter = 'kaidkontak ='+o.rpkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';*/
						csfilter = "kaidkontak ="+o.rpkontak+""; 
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txaalamatsupplier":
						paket = "CdM1_Contact_Attention";
						/* wsfilter = 'kaidkontak ='+o.rpkontak+' AND kakodekontak ="'+txtkontakperson.text+'"';*/
						csfilter = "kaidkontak ="+o.rpkontak+""; 
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtakun":
						paket = "CdM1_Coa";
						csfilter='caktif=1 and cgd="D"'
						wsfilter = 'caktif=1 and cgd="D" and cnomor ="'+txtakun.text+'"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode = "'+ txtmatauang.text +'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif=1 AND tnsumber = "RP"';
						sort = 'tnkode asc';
						break;
					case "txttermin":
						paket = "CdM1_Terms";
						wsfilter = 'traktif=1 AND trkode = "'+ txttermin.text +'"';
						csfilter = 'traktif=1';
						sort = 'trkode asc';
						break;
					case "txtbagpembayaran":
						paket = "CdM1_Contact";
						wsfilter = '(kaktif=1 AND kkategori="K") AND kkode ="'+txtbagpembayaran.text+'"';
						csfilter = '(kaktif=1 AND kkategori="K")';
						csfield = 4;
						sort = 'kkode asc';
						break;
					case "txtcostcenter":
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+ txtcostcenter.text +'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "txtdivisi":
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+ txtdivisi.text +'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "txtsubdivisi":
						paket = "CdM1_Subdivision";
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+txtdivisi.text+'" AND sdkode = "'+ txtsubdivisi.text +'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+txtdivisi.text+'"';
						sort = 'sdkode asc';
						break;
					case "txtproyek":
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+ txtproyek.text +'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
					case "carabayarnama":
						paket = "CdM0_Carabayar";
						wsfilter = 'nama = "'+dgrid.carabayarnama+'"';
						break;
					case "rekbank":
						paket = "CdM1_Coa";
						if (dgrid.carabayar=="0"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 0) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="1"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="2"){
							wsfilter = '(cgd="D" and caktif=1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (ctipe = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="3"){
							wsfilter = '(cgd="D" and caktif=1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'") and cnomor = "'+dgrid.rekbank+'"';
							csfilter = '(cgd = "D" and caktif = 1) and (cmatauang = "'+txtmatauang.text+'" or cmatauang = "'+UFungsional+'")';
						}else if (dgrid.carabayar=="" || dgrid.carabayar== undefined){
							wsfilter = 'AA';
							csfilter = 'AA';
						}
						sort = 'cnomor asc';
						break;
					case "bank":
						if(dgrid.carabayar == 1 || dgrid.carabayar == 2){
							paket = "CdM1_Bank";
							wsfilter = 'baktif=1 AND bkode = "'+dgrid.bank+'"';
							csfilter = 'baktif=1';
							sort = 'bkode asc';
						}
						break;
					case "catatan":
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber = "RP"';
						sort = 'tndkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				var ob : Object;
				if(FlexGlobals.topLevelApplication.wsSuccess){
					ws = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case "txtcatatan":
							txtcatatan.text = ws.tnkode;
							break;
						case "txtkontakperson":
							ws = parentApplication.wsArrUtama.getItemAt(0)
							txtkontakperson.text = ws.kakodekontak;
							txaalamatkontakperson.text = ws.kaalamat;
							break;
						case "txaalamatkontakperson":
							ws = parentApplication.wsArrUtama.getItemAt(0)
							txaalamatkontakperson.text = ws.kaalamat;
							break;
						case "txaalamatsupplier":
							ws = parentApplication.wsArrUtama.getItemAt(0)
							txaalamatsupplier.text = ws.kaalamat;
							break;
						case "txtmatauang":
							ws = parentApplication.wsArrUtama.getItemAt(0);
