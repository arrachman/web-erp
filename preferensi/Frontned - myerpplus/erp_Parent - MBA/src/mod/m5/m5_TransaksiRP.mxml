			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtcustomer":FlexGlobals.topLevelApplication.F_KosongkanText([txtcustomer, lblcustomer]);break;
					case "txtcatatan":FlexGlobals.topLevelApplication.F_KosongkanText([txtcatatan]);break;
					case "txtakun":FlexGlobals.topLevelApplication.F_KosongkanText([txtakun,lblakun]);break;
					case "txtmatauang":FlexGlobals.topLevelApplication.F_KosongkanText([txtmatauang, txtkurs]);break;
					case "txtnosi":FlexGlobals.topLevelApplication.F_KosongkanText([txtnosi]);break;
					case "txtbagpembayaran":FlexGlobals.topLevelApplication.F_KosongkanText([txtbagpembayaran,lblbagpembelian]);break;
					case "txttermin":FlexGlobals.topLevelApplication.F_KosongkanText([txttermin]);dttgljt.text = dttgl.text;break;
					case "txtcostcenter":FlexGlobals.topLevelApplication.F_KosongkanText([txtcostcenter]);break;
					case "txtdivisi":FlexGlobals.topLevelApplication.F_KosongkanText([txtdivisi]);break;
					case "txtsubdivisi":FlexGlobals.topLevelApplication.F_KosongkanText([txtsubdivisi]);break;
					case "txtproyek":FlexGlobals.topLevelApplication.F_KosongkanText([txtproyek]);break;
				}
			}
			public function f_delundefined(v_dg:DataGrid):void{
				for (var i:int=0;i<v_dg.dataProviderLength;i++){
					with (v_dg.dataProvider.getItemAt(i)){
						if (dg.dataProvider.getItemAt(i)['catatan']==undefined){dg.dataProvider.getItemAt(i)['catatan']=''}
						if (dg.dataProvider.getItemAt(i)['bank']==undefined){dg.dataProvider.getItemAt(i)['bank']=''}
						if (dg.dataProvider.getItemAt(i)['rekgiro']==undefined){dg.dataProvider.getItemAt(i)['rekgiro']=''}
						if (dg.dataProvider.getItemAt(i)['noacbank']==undefined){dg.dataProvider.getItemAt(i)['noacbank']=''}
						if (dg.dataProvider.getItemAt(i)['rekbanknama']==undefined){dg.dataProvider.getItemAt(i)['rekbanknama']=''}
					}
				}
			}

			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var a:Array, utama:String, detail:String = '', tgl:String;
				FlexGlobals.topLevelApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled){
					validasiForm();
					if(validasi){
						//u.refresh();
						// Set Utama
						with(o){
							a = [rpid, rpcabang, rplokasi, rpjenis, rpsumber,  int(chkauto.selected), txtnotransaksi.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), rpkodepa, rpkontak, txtkontakperson.text, txaalamatsupplier.text, 
								rp1alamat2, rp1alamat3, 
								txaalamatkontakperson.text, rp2alamat2, rp2alamat3, rpbagianterima, txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgljt.text), rpidsi, 
								txtakun.text, txturaian.text, txtcatatan.text, txtnoref.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttanggalnoref.text), 
								txtmatauang.text, o.txtkurs, 
								rpjumlah, rpjumlahvalas, rpjumlahbayar, rpjumlahbayarvalas, rpstatusbayar, FlexGlobals.topLevelApplication.F_tglFormatDB(rptgllunas), 
								txtcostcenter.text, txtdivisi.text, txtsubdivisi.text, txtproyek.text, cmbprogress.selectedItem.v, rpstatussebelumnya, rpjmlrevisi, rpcetakanke, 
								rpinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(rpinputtgl), rpmodifikasiuser, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rpmodifikasitgl), int(chkposting.selected), rpisclose, rpcustomtext1, 
								rpcustomtext2, rpcustomtext3, rpcustomtext4, rpcustomtext5, rpcustomint1, rpcustomint2, rpcustomint3, 
								rpcustomdbl1, rpcustomdbl2, rpcustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rpcustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rpcustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(rpcustomdate3)];
							utama = f_splitArrayToString(a);
						}
						// Set Detail
						for(var c:int=0; c<dg.dataProviderLength; c++){
							with(dg.dataProvider.getItemAt(c)){
								a = [idrpcarabayar, idrp, carabayar, matauang, parentApplication.F_hapusFormatCurrency(txtkurs.text), jumlah, jumlahvalas, 
									nogiro, FlexGlobals.topLevelApplication.F_tglFormatDB(tgljt), bank, noacbank, rekbank, rekgiro, catatan, 
									c+1, isclose];
								if(detail == '')detail =f_splitArrayToString(a);
								else detail += "▲"+f_splitArrayToString(a);
							}
						}
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M5_RpSimpan", FlexGlobals.topLevelApplication.userid, isUpdate, utama, detail);
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = '';
					parentApplication.F_hapusBarisKosongGrid(dg);
					if(txtcustomer.text.length <= 0)parentApplication.msgAlert(txtcustomer,'Supplier');
					if(txtakun.text.length <= 0)parentApplication.msgAlert(txtakun,'Akun');
					if(txtmatauang.text.length <= 0)parentApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)parentApplication.msgAlert(txtkurs,'Kurs');
					if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(dttgl.text.length <= 0)parentApplication.msgAlert(dttgl,'Tanggal');
					if(cmbprogress.selectedIndex < 0)parentApplication.msgAlert(cmbprogress,'Progress');
					if(dg.dataProvider.getItemAt(0).rekbank == null || dg.dataProvider.getItemAt(0).rekbank == '')parentApplication.msgAlert(dg,'Detail Item');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
					if(txttermin.text.length == 0){
						o.rptgljatuhtempo = dttgl.text;
					}
					f_hitungTotal();
					f_hitungvalas();
				}
				
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			private var vtotal:Number=0,vvalas:Number=0;
			public function f_hitungTotal():void
			{
				o.rpjumlah=0;  o.rpjumlahvalas=0;
				for(var i:int=0;i<dg.dataProvider.length;i++){
					o.rpjumlah += Number(dg.dataProvider.getItemAt(i).jumlah)
					o.rpjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas)
				}
				lbltotal.text = fu(o.rpjumlah);
				lbltotalvalas.text = fu(o.rpjumlahvalas);
			}
			
			public function f_hitungvalas():void{
				if(txtmatauang.text != UFungsional){
					txtkurs.enabled=true;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = dg.dataProvider.getItemAt(i).jumlah/o.txtkurs;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}else{
					txtkurs.enabled=false;
					for(i=0; i<dg.dataProviderLength; i++){
						dg.dataProvider.getItemAt(i).jumlahvalas = 0;
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				}
			}
			
			protected function dttgl_changeHandler(event:CalendarLayoutChangeEvent):void
			{
				// TODO Auto-generated method stub
				dttgljt.text = FlexGlobals.topLevelApplication.F_tglJatuhTempo(dttgl.text,terminharijatuhtempo);
			}
			
