				<s:TextInput id="txtuser" left="96" top="42"/>
				<s:ComboBox id="cmbstatus" left="96" top="63"/>
				<s:TextInput id="txtcustomer1" left="96" top="85"/>
				<s:TextInput id="txtbagpenagihan" left="96" top="106" visible="false"/>
				<s:TextInput id="txtuang" left="96" top="106"/>
			</s:Group>
		</mx:Canvas>
		<mx:Canvas width="100%" height="300">
			<s:DataGrid id="dg" left="0" right="0" top="0" bottom="0" alternatingRowColors="[#FFFFFF, #EFF3FA]"/>
		</mx:Canvas>
	</mx:DividedBox>
</s:Module>