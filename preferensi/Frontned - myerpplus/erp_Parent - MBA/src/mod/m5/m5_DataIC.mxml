				<s:Label id="tjenislaporan" left="0" top="93" width="80" text="Jenis Laporan"/>
				<s:TextInput id="txtnotransaksi1" left="91" top="0"/>
				<s:TextInput id="txtnotransaksi2" left="271" top="0" focusIn="txtnotransaksi2.text = txtnotransaksi1.text"/>
