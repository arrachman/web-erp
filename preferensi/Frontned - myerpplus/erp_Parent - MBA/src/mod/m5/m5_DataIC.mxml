				<s:Label id="tlokasi" left="0" top="26" width="78" text="Lokasi"/>
				<s:Label id="tuser" left="0" top="47" width="78" text="User"/>
				<s:Label id="tstatus" left="0" top="69" width="78" text="Status"/>
				<s:Label id="tcustomer" left="0" top="92" width="78" text="Customer"/>
				<s:Label id="tbagpenagihan" left="0" top="112" text="Bag Penagihan" visible="false"/>
