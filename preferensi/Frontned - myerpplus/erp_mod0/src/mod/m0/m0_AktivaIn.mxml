			protected function btnok_clickHandler(event:MouseEvent):void
			{
				acaktiva.filterFunction = null;
				obj.p.ac_Aktiva = acaktiva;
				obj.p.ac_Aktiva.refresh();
				if(acaktiva.length > 0){
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgaktiva);
				}
				//				FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgaktiva);
				
				obj.cek = true;
				obj.btl= true;
				if(obj.cek ){
					for(i= 0; i< acaktiva.length; i++){
						if(acaktiva[i].atkode ==''){
							obj.cek = false;
							//Alert.show('Nomor Serial tidak boleh kosong !','Information');
							//filter();
							break;
						}
					}
				}
				
				
				if(obj.cek == false){
					Alert.show('Kode Aktiva tidak boleh kosong', 'Information');
				}
				
				
				if(obj.cek == true && obj.btl ){
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
				}
				//FlexGlobals.topLevelApplication.closeFormPopUp(1);
				
			}
			
			
			protected function dgfaktiva_selectionChangeHandler(event:GridSelectionEvent):void
