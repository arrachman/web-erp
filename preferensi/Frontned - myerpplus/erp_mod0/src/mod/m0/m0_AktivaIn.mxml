			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:Number=0, wsitemlimit:Number=0, csfilter:String="", csfield:Number=0, checkbox:Boolean = false;
				switch(target){
					case "txtkelompok":
						paket = 'CdM7_Asset_Category';
						wsfilter = 'ackode ="'+txtkelompok.text.split('"').join('\\"')+'"';
						sort = 'ackode asc';
						break;
					case "txtrekaktiva":
						paket = 'CdM1_Coa';
						wsfilter = "caktif = 1 AND cgd = 'D' AND cnomor = '"+txtrekaktiva.text+"'";
						csfilter = "caktif = 1 AND cgd = 'D'";
						break;
					case "txtrekdepresiasi":
						paket = 'CdM1_Coa';
						wsfilter = "caktif = 1 AND cgd = 'D' AND cnomor = '"+txtrekdepresiasi.text+"'";
						csfilter = "caktif = 1 AND cgd = 'D'";
						break;
					case "txtrekakumulasi":
						paket = 'CdM1_Coa';
						wsfilter = "caktif = 1 AND cgd = 'D' AND cnomor = '"+txtrekakumulasi.text+"'";
						csfilter = "caktif = 1 AND  cgd = 'D'";
						break;
					case "txtdivisi":
						paket = 'CdM1_Division';
						wsfilter = "daktif = 1 AND dkode = '"+txtdivisi.text+"'";
						csfilter = "daktif = 1";
						break;
					case "txtsubdivisi":
						paket = 'CdM1_Subdivision';
						wsfilter = "sdaktif = 1 AND sddivisi = '"+txtdivisi.text+"' AND sdkode = '"+txtsubdivisi.text+"'";
						csfilter = "sdaktif = 1 AND sddivisi = '"+txtdivisi.text+"'";
						break;
					case "txtlokasi":
						paket = 'CdM1_Location';
						wsfilter = "laktif = 1 AND lkode = '"+txtlokasi.text+"'";
						csfilter = "laktif = 1";
						break;
					case "txtpenyusutan":
						paket = 'CdM7_Depreciation_Category';
						wsfilter = 'aktif=1 AND nama ="'+txtpenyusutan.text.split('"').join('\\"')+'"';
						csfilter = 'aktif=1';
						sort = 'kode asc';
						break;
					case "txtsatuan":
						paket = "CdM1_Unit";
						wsfilter = 'uaktif=1 AND ukode ="'+txtsatuan.text+'"';
						csfilter = 'uaktif=1';
						csfield = 2;
						sort = 'ukode asc';
						break
					case "txtcostcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+txtcostcenter.text+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "txtproyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+txtproyek.text+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			private function filterr():void {
				acaktiva.filterFunction = filterMyArrayCollection;
				acaktiva.refresh();
			}
			
			private function filterMyArrayCollection(item:Object):Boolean{
				var searchString:String;
				var itemName:String;
				if(tab.selectedIndex ==0){
					searchString = dgfaktiva.dataProvider.getItemAt(dgfaktiva.selectedCell.rowIndex).kodebarang;
					itemName = (item.kodebarang as String);
				}
				if(itemName == null){
					return true;
				}
				return itemName.indexOf(searchString) > -1;
			}
			
