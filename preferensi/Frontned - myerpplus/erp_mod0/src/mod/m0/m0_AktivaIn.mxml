			public function setSerial():void{
				dgfaktiva.dataProvider.removeAll();
				//set filterserial
				for(i=0;i<obj.p[obj.p.o.idgrid].dataProviderLength;i++){
					var jmlbarang:Number;
					obj.dg = obj.p[obj.p.o.idgrid].dataProvider[i];
					if( obj.p.o.moduleid == 5 && obj.p.o.mnid == 8){
						jmlbarang = int(obj.dg.jmlbarangkembali);
					}
					else if( obj.p.o.moduleid == 3 && obj.p.o.mnid == 6){
						jmlbarang = int(obj.dg.jmlmasuk);
					}
					else{
						jmlbarang = int(obj.dg.jmlbarang);
					}
					obj.utama = obj.p.o;
					if(obj.dg.basset == 1 && jmlbarang > 0){
						obj.bol = true;
						for(var j:int=0;j<dgfaktiva.dataProvider.length;j++)
							if(dgfaktiva.dataProvider[j].kodebarang == obj.dg.kodebarang){
								obj.bol = false;
								dgfaktiva.dataProvider.getItemAt(j).jml = int(dgfaktiva.dataProvider[j].jml)+jmlbarang;
								dgfaktiva.dataProvider.setItemAt(dgfaktiva.dataProvider[j], j);
								break;
							}
						if(obj.bol ){
							//Alert.show("TRUE "+jmlbarang);
							dgfaktiva.dataProvider.addItem({kodebarang:obj.dg.kodebarang, namabarang:obj.dg.namabarang, idtransaksi: obj.utama[obj.p.o.sumber+"id"] , sumber: obj.p.o.sumber.toUpperCase(), satuan:obj.dg.satuanbarang, jml:jmlbarang, idbarang:obj.dg.idbarang});
						}
						//Alert.show(dgfaktiva.dataProviderLength+"  "+dgfaktiva.dataProvider.getItemAt(0).kodebarang);
					}
				}
				
				//set dg serial
				acaktiva.removeAll();
				if(obj.p.ac_Aktiva.length > 0){
					acaktiva = obj.p.ac_Aktiva;
				}
				//Alert.show(acaktiva.length.toString());
				var t:int = 0; var r:Object = {};
				// menacari nomer terakhir dari barang ini dg cara menjumlah barangnya.
				for(t=0;t<acaktiva.length;t++){
					if(r[acaktiva[t].atidbarang] == undefined)
						r[acaktiva[t].atidbarang] = 1;
					else r[acaktiva[t].atidbarang]++;
				}
				
				r.no = {}; r.a = 0;
				//Alert.show(dgfaktiva.dataProviderLength.toString());
				for(i=0;i<dgfaktiva.dataProvider.length;i++){
					r.a += dgfaktiva.dataProvider[i].jml;
										
					if(r.a > acaktiva.length){
						if(r[dgfaktiva.dataProvider[i].idbarang] == undefined)r[dgfaktiva.dataProvider[i].idbarang] = 0;
						for(j=r[dgfaktiva.dataProvider[i].idbarang]; j<int(dgfaktiva.dataProvider[i].jml); j++){
							if(r.no[dgfaktiva.dataProvider[i].idbarang] == undefined){
								r.no[dgfaktiva.dataProvider[i].idbarang] = (r[dgfaktiva.dataProvider[i].idbarang]+1);
							}
							if(dgfaktiva.dataProvider[i].idtransaksi == undefined)
								dgfaktiva.dataProvider[i].idtransaksi = 0;
							
							acaktiva.addItem({no:r.no[dgfaktiva.dataProvider[i].idbarang]++, atid:0, atasetid:0, atjenismutasi:1, atsumber:dgfaktiva.dataProvider[i].sumber, atidutama:0, 
								atidbarang:dgfaktiva.dataProvider[i].idbarang, atkode:'', atnama:dgfaktiva.dataProvider[i].namabarang, atkategori:'',
								atcabang:parentApplication.ucabang, atlokasi:txtlokasi.text, atgudang:obj.p.o.gudang, atdivisi:txtdivisi.text, 
								atsubdivisi:txtsubdivisi.text, atcostcenter:txtcostcenter.text, atproyek:txtproyek.text, atcatatan:txtketerangan.text, atnomor:txtnomor.text, attglbeli:dttanggalbeli.text, 
								attglpakai:dttanggalpakai.text, atjml:1, atsatuan:dgfaktiva.dataProvider[i].satuan, atmatauang:matauang, atkurs:kurs, 
								atharga:o.txthargabeli, atdiskon:0, atjmldiskon:0, atpajak1:0, atjmlpajak1:0, atpajak2:0, atjmlpajak2:0,
								athargabeli:o.txthargabeli, atnilairesidu:o.txtnilairesidu, atumurekonomis:o.txtumurekonomis, atbebanperbln:o.txtbebanperbulan, 
								atakumulasibeban:o.txtakumulasibeban, atnilaibuku:o.txtnilaibuku, atmetode:kodepenyusutan, 
								attabelpenyusutan:"", atintangible:0, atfiskal:0, atatastengahbulan:0, 
								atrekasset:txtrekaktiva.text, atrekakumdepresiasi:txtrekakumulasi.text, atrekdepresiasi:txtrekdepresiasi.text, 
								atrekpenghapusan:'', atprodusen:0, attglpensiun:dttanggalpensiun.text, atpenyusutanke:0, atnilaimenurun:0, atdispose:0, atpembelian:0, 
								atpenjualan:0, atlocked:0, atstatus:0, atstatussebelumnya:0, atisclose:0, atinputuser:FlexGlobals.topLevelApplication.userid, atinputtgl:FlexGlobals.topLevelApplication.DefaultTanggal,
								atmodifikasiuser:0, atmodifikasitgl:FlexGlobals.topLevelApplication.DefaultTanggal, 
								atcustomtext1:'', atcustomtext2:'', atcustomtext3:'', atcustomtext4:'', atcustomtext5:'',
								atcustomint1:0, atcustomint2:0, atcustomint3:0, atcustomint4:0, atcustomint5:0, atcustomdbl1:0, atcustomdbl2:0, atcustomdbl3:0,  atcustomdbl4:0, atcustomdbl5:0, 
								atcustomdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
								atcustomdate2:FlexGlobals.topLevelApplication.DefaultTanggal, 
								atcustomdate3:FlexGlobals.topLevelApplication.DefaultTanggal,
								atcustomdate4:FlexGlobals.topLevelApplication.DefaultTanggal, 
								atcustomdate5:FlexGlobals.topLevelApplication.DefaultTanggal,
								kodebarang:dgfaktiva.dataProvider[i].kodebarang});
						}
					}
				}
				dgaktiva.dataProvider = acaktiva;
				dgaktiva.validateNow();
				dgfaktiva.setSelectedCell(0,0);
				dgfaktiva.validateNow();
				filterr();
				if(dgaktiva.dataProviderLength > 0){
					lblbarang.text = "Barang : " + dgfaktiva.dataProvider[dgfaktiva.selectedCell.rowIndex].kodebarang + "";
					lbljumlah.text = "Jumlah : "+ dgfaktiva.dataProvider[dgfaktiva.selectedCell.rowIndex].jml+" "+dgfaktiva.dataProvider[dgfaktiva.selectedCell.rowIndex].satuan+"";
				}
				
			}
							
