				parentApplication.F_SetNilaiText([txtnilairesidu, txtbebanperbulan, txtakumulasibeban, txtnilaibuku], parentApplication.F_formatNominal(0));
				parentApplication.F_SetNilaiText([txtumurekonomis], 0);
				obj.dg = obj.p[obj.p.o.idgrid].dataProvider[dgfaktiva.selectedCell.rowIndex];
				if(obj.p.o.moduleid == 3 && (obj.p.o.mnid == 23 || obj.p.o.mnid == 6)){
					o.txthargabeli = obj.dg.hpp;
					txthargabeli.text = FlexGlobals.topLevelApplication.F_formatNominal(o.txthargabeli);
					txtsatuan.text = obj.dg.satuanbarang;
					txtnama.text = obj.dg.namabarang;
				}
				else{
					o.txthargabeli = obj.dg.harga;
					txthargabeli.text = FlexGlobals.topLevelApplication.F_formatNominal(o.txthargabeli);
					txtsatuan.text = obj.dg.satuanbarang;
					txtnama.text = obj.dg.namabarang;
				}
				
				filterr();
				lblbarang.text = "Barang : " + dgfaktiva.dataProvider[dgfaktiva.selectedCell.rowIndex].kodebarang + "";
				lbljumlah.text = "Jumlah : "+ dgfaktiva.dataProvider[dgfaktiva.selectedCell.rowIndex].jml+" "+dgfaktiva.dataProvider[dgfaktiva.selectedCell.rowIndex].satuan+"";
