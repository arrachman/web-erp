			//SET ARRAY PO
			protected function f_SetArraySimpanPO():void
			{
				var dgmap:Object, dgimp:Object;
				var validasifield : Boolean;
				var namakolom : String = "";
				
				acSimpan.removeAll();
				for(var i:int = 0; i < dgImport.dataProviderLength; i++)
				{
					dgimp = dgImport.dataProvider[i];
					
					// JIKA DATA DICENTANG
					if(dgimp.chk == 1)
					{
						f_setDatatoArraySimpan(i, dgimp.poid)
						validasifield = true;
						
					}
				}
				
				function f_setDatatoArraySimpan(row:int, data:String):void
				{
					dgimp = dgImport.dataProvider[row];
					acSimpan.addItem({
						poid : dgimp.poid,
						ponotransaksi : dgimp.ponotransaksi
					});
				}
				
				if(acSimpan.length > 0)
				{
					if(validasifield) // JIKA DI MAPPING FIELD SUDAH DIISI KOLOM SUMBERNYA, DAN DI ARRAY SIMPAN SUDAH OK
					{ 
						f_ImportPO1();
					}
					else if(!validasifield) // JIKA DI MAPPING FIELD ADA YANG BELUM DIISI KOLOM SUMBERNYA
					{
						Alert.show("Mapping Field '"+namakolom +"' harus diisi dengan benar", "Informasi");
					}
				}
				else
				{
					Alert.show("Data harus dipilih terlebih dahulu", "Informasi");
				}
			}
			
