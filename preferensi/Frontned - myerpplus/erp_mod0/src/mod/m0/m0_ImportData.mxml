							costcenter:"", divisi:"", subdivisi:"", 
							proyek:"", catatan:"", isclose:0, 
							customtext1:"", customtext2:"", customtext3:"", 
							customdbl1:0, customdbl2:0, customdbl3:0, 
							customdate1:FlexGlobals.topLevelApplication.DefaultTanggal, 
							customdate2:FlexGlobals.topLevelApplication.DefaultTanggal, 
							customdate3:FlexGlobals.topLevelApplication.DefaultTanggal});
						
					};
				}
				
				if(acSimpan.length > 0){
					if(validasifield ){ //JIKA DI MAPPING FIELD SUDAH DIISI KOLOM SUMBERNYA, DAN DI ARRAY SIMPAN SUDAH OK
						f_ImportIB();
					}else if(validasifield == false){ //JIKA DI MAPPING FIELD ADA YANG BELUM DIISI KOLOM SUMBERNYA
						Alert.show("Mapping Field '"+namakolom +"' harus diisi dengan benar", "Informasi");
					}
				}else{
					Alert.show("Data harus dipilih terlebih dahulu", "Informasi");
				}
				
				
			}
			
