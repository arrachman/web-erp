			//IMPORT KATEGORI BARANG
			//SIMPAN DATA YANG DICENTANG KE ARRAY
			protected function f_SetArraySimpanKatBarang():void
			{
				var dgmap : Object, dgimp:Object;
				var validasifield : Boolean;
				var namakolom : String = "";
				acSimpan.removeAll();
				for(var iimp:int = 0; iimp < dgImport.dataProviderLength; iimp++)
				{
					dgimp = dgImport.dataProvider[iimp]
					if(dgimp.chk == 1){ //JIKA DATA DICENTANG
						validasifield = true;
						for(var imap : int = 0; imap<dgMapping.dataProviderLength; imap ++)
						{
							dgmap = dgMapping.dataProvider[imap];
							dgimp[dgmap.namafield] = dgimp[dgmap.kolomsumber];
							
							if(dgimp[dgmap.namafield] == undefined)
							{ //JIKA KOLOM SUMBER KOSONG / UNDEFINED
								//								validasifield = false;
								//								namakolom = dgmap.namafield;
								
								if(dgimp.ickode == undefined)
								{ //JIKA SUMBER KODE KONTAK KOSONG / UNDEFINED
									validasifield = false;
									namakolom = "Kode";
									break;
								}
								else if(dgimp.icnama == undefined)
								{ //JIKA SUMBER NAMA KONTAK KOSONG / UNDEFINED
									validasifield = false;
									namakolom = "Nama";
									break;
								}
								//JIKA ADA FIELD YANG TIDAK WAJIB DAN KOLOM SUMBERNYA UNDEFINED, DISET KOSONG==================================
								if(validasifield)
								{
									dgimp[dgmap.namafield] = "";
								}
								//==============================================================================================================
							}
						}
						
						acSimpan.addItem({ickode:dgimp.ickode, icnama:dgimp.icnama, icrekpersediaan:dgimp.icrekpersediaan, 
							icrekhargapokok:dgimp.icrekpersediaan, icrekpenjualan:dgimp.icrekpersediaan, iccatatan:dgimp.icrekpersediaan, icaktif : 1, 
							icinputuser : FlexGlobals.topLevelApplication.userid, icinputtgl:FlexGlobals.topLevelApplication.DefaultTanggal, 
							icmodifikasiuser:0, icmodifikasitgl:FlexGlobals.topLevelApplication.DefaultTanggal,
							icdivisi:"", icsubdivisi:"", icdepartemen:"", icsubdepartemen:dgimp.icsubdepartemen,
							icindexbarcode:dgimp.icindexbarcode});
					}
				}
				
				if(acSimpan.length > 0)
				{
					if(validasifield)
					{ //JIKA DI MAPPING FIELD SUDAH DIISI KOLOM SUMBERNYA, DAN DI ARRAY SIMPAN SUDAH OK
						f_ImportKatBarang1();
					}
					else if(validasifield == false)
					{ //JIKA DI MAPPING FIELD ADA YANG BELUM DIISI KOLOM SUMBERNYA
						Alert.show("Mapping Field '"+namakolom +"' harus diisi dengan benar", "Informasi");
					}
				}
				else
				{
					Alert.show("Data harus dipilih terlebih dahulu", "Informasi");
				}
			} 
			
