				cmbsumberAP.dataProvider = new ArrayCollection([{l:'Invoice Pembelian', v:"RI"}, {l:'Retur Pembelian', v:"PRT"}]);
				cmbsumberAR.dataProvider = new ArrayCollection([{l:'Invoice Penjualan', v:"SI"}, {l:'Retur Penjualan', v:"SR"}]);
				
				//set default
				vUang = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');//Ambil dari m0_setting 'kode currency'
				vKurs= FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs');//Ambil dari m0_setting 'kurs currency'
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBatal);
				FlexGlobals.topLevelApplication.F_RegGrid(0, 20, [dgMapping], 'transaksi');
				
				f_kondisiAwal();
				
				function f_mbSimpan():void
				{
					f_simpan();
				}
				
				function f_mbBatal():void
				{
					f_kondisiAwal()
				}
			}
			
			public function f_kondisiAwal():void
			{
				o.kontak = 0;
				cmbimport.selectedIndex = 10;
				cmbsumberAR.selectedIndex = 0;
				cmbsumberAP.selectedIndex = 0;
				cmbsheet.dataProvider.removeAll();
				grppopup.visible = false;
				berhasil = 0;
				gagal = 0;
				index = 0;
				jmlProgress = 0;
				num = 0;
				j = 0;
				bytearrayexcel = null;
				txtfile.text = "";
				acKolomSumber.removeAll();
				lblProses.text = "";
				lblPersen.text = "0 %";
				FlexGlobals.topLevelApplication.F_RegGrid(0, 20, [dgImport], 'transaksi');
				FlexGlobals.topLevelApplication.F_KosongkanText([txtgudang,lblgudang, txtkontak, lblkontak])
				dgMapping.dataProvider.removeAll();
				txturaian.text = parentApplication.getNomor("IB");
				txturaianCoA.text = parentApplication.getNomor("CB");
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				FlexGlobals.topLevelApplication.F_SetNilaiText([dttgl, dttglCoA],FlexGlobals.topLevelApplication.DefaultTanggal);
				acImportGagal.removeAll();
				f_cmbimport();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target)
				{
					case "txtgudang":
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode ="'+txtgudang.text.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case "txtkontak":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif = 1 AND kkode ="'+txtkontak.text.split('"').join('\\"')+'"';
						csfilter = 'kaktif = 1';
						sort = 'kkode asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 AND ckode ="'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						csfield = 2;
						sort = 'ckode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_keydown(e:KeyboardEvent):void
			{
				switch(e.keyCode)
				{
					case Keyboard.F12:
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
						FlexGlobals.topLevelApplication.F_acAdd(dgImport);
						f_browseFile();
						break;
					case Keyboard.N:
						if(e.ctrlKey)
						{
							FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgImport);
							FlexGlobals.topLevelApplication.F_acAdd(dgImport);
							f_browseFile();
						}
						break;
					case Keyboard.DELETE:
						o.arr = new ArrayCollection([dgImport.dataProvider[dgImport.selectedCell.rowIndex]]);
						break;
					case Keyboard.S:
						if(e.ctrlKey)
							f_simpan();
						break;
				}
			}
			
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components)
				{
					case "checkBoxHeader":
						for (i=0; i<dgImport.dataProviderLength; i++)
						{
							dgImport.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case "checkBox":
						dgImport.dataProvider.getItemAt(dgImport.selectedCell.rowIndex).chk = data;
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgImport);
			}
			
			private function f_browseFile():void
			{
				var arr:Array = [];
				arr.push(new FileFilter("Excel File","*.xls"));
//				arr.push(new FileFilter("Excel File","*.xlsx"));
				fileReference.browse(arr);
			}
			
			private function fileReference_select(evt:Event):void {
				fileReference.load();
			}
			
			private function fileReference_complete(evt:Event):void {
				
				txtfile.text = fileReference.name;
				bytearrayexcel = fileReference.data
				var excelFile:ExcelFile = new ExcelFile();
				excelFile.loadFromByteArray(bytearrayexcel);
				var sheet : Sheet = excelFile.sheets[0];
				cmbsheet.dataProvider.removeAll();
				for(var i:int = 0; i<excelFile.sheets.length; i++)
				{
					sheet = excelFile.sheets[i];
					cmbsheet.dataProvider.addItem({l:sheet.name})
				}
				
				cmbsheet.selectedIndex = 0;
				for(i=0;i<cmbsheet.dataProvider.length;i++)
				{
					if(cmbimport.textInput.text == cmbsheet.dataProvider.getItemAt(i).l)
					{
						cmbsheet.selectedIndex = i;
						break;
					}
				}
			}
			
