			public function f_UlangImport():void
			{
				if(index < jmlProgress - 1)
				{
					switch(cmbimport.selectedIndex)
					{
						case 0: //kontak
							index ++;
							f_ImportKontak1();
							break;
						case 1: //barang
							index ++;
							f_importBarang1();
							break;
						case 4: //saldo awal hutang
							index ++;
							f_ImportAP1();
							break;
						case 5: //saldo awal piutang
							index ++;
							f_ImportAR1();
							break;
						case 5: //master kategori barang
							index ++;
							f_ImportAR1();
							break;
						case 6: //master kategori barang
							index ++;
							f_ImportKatBarang1();
							break;
						case 7: //Import Penjualan
							index ++;
							f_ImportPenjualan1();
							break;
						case 8: //Import Retur
							index ++;
							f_ImportAR1();
							break;
						case 9: //Import Data Jurnal
							index ++;
							f_ImportGJ();
							break;
						case 10: //Import Produksi
							index ++;
							f_ImportProduksi1();
							break;
						case 11: //Import PO
							index ++;
							f_ImportPO1();
							break;
						case 12: //Import RI
							index ++;
							f_ImportRI1();
							break;
					}
				}
				else
				{
					index = 0;
					jmlProgress = 0;
					f_sendProgress('Import Data Done', true);
					lblProses.text = "Import Data Done";
					lblPersen.text = "100 %";
					//					f_writeExcel();
					if(gagal>0)
					{
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal \n Apakah anda ingin download data yang gagal?", "Informasi", 3, null, function (e:Object):void
						{
							if(e.detail == Alert.YES)
							{
								f_writeExcel();
							}
							f_kondisiAwal();
						});
					}
					else
					{
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal.", "Informasi", 4, null, function ():void
						{
							f_kondisiAwal();
						});
					}
				}
			}
			
