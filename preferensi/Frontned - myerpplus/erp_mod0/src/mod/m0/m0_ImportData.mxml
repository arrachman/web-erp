					ibcustomdate3:parentApplication.m.DateFirst}]);
				
				var dgmap : Object, dgimp:Object;
				var validasifield : Boolean;
				var namakolom : String = "";
				acSimpan.removeAll();
				for(var iimp:int = 0; iimp < dgImport.dataProviderLength; iimp++){
					dgimp = dgImport.dataProvider[iimp]
					if(dgimp.chk == 1){ //JIKA DATA DICENTANG
						validasifield = true;
						for(var imap : int = 0; imap<dgMapping.dataProviderLength; imap ++){
							dgmap = dgMapping.dataProvider[imap];
							dgimp[dgmap.namafield] = dgimp[dgmap.kolomsumber];
							
							if(dgimp[dgmap.namafield] == undefined){ //JIKA KOLOM SUMBER KOSONG / UNDEFINED
								
								if(dgimp.kodebarang == undefined){ //JIKA SUMBER KODE KONTAK KOSONG / UNDEFINED
									validasifield = false;
									namakolom = "Kode Barang";
									break;
								}else if(dgimp.jml == undefined){ //JIKA SUMBER NAMA KONTAK KOSONG / UNDEFINED
									validasifield = false;
									namakolom = "Jumlah";
