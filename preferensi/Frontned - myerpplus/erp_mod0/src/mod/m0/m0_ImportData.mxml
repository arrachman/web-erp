			{
				var dgmap:Object, dgimp:Object;
				var validasifield : Boolean;
				var namakolom : String = "";
				
				// Perulangan untuk validasi data yang dari excel
				for(i=0; i<dgImport.dataProviderLength; i++)
				{
					dgimp = dgImport.dataProvider[i];
					
					// JIKA DATA DICENTANG
					if(dgimp.chk)
					{
						validasifield = true;
						for(x=0; x<dgMapping.dataProviderLength; x ++)
						{
							dgmap = dgMapping.dataProvider[x];
							dgimp[dgmap.namafield] = dgimp[dgmap.kolomsumber];
							
							if(dgimp[dgmap.namafield] == undefined) // JIKA KOLOM SUMBER KOSONG / UNDEFINED
							{
								if(dgimp.noref == undefined || dgimp.noref.length == 0)
								{
									Alert.show("No. ref ada yang kosong"); return;
								}
								
								if(dgimp.kodecustomer == undefined || dgimp.kodecustomer.length == 0)
								{
									Alert.show("Kode Customer ada yang kosong"); return;
								}
								
								if(dgimp.kodesalesman == undefined || dgimp.kodesalesman.length == 0)
								{
									Alert.show("Kode Salesman ada yang kosong"); return;
								}
								
								if(dgimp.tanggal == undefined || dgimp.tanggal.length == 0)
								{
