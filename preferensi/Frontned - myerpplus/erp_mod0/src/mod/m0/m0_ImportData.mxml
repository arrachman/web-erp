								if(validasifield ){
									dgimp[dgmap.namafield] = ""
									
								}
							}
							//==============================================================================================================
						}
						
						acSimpan.addItem({
							idibdetail:0, idib:0, idbarang:dgimp.idbarang, kodebarang:dgimp.kodebarang, namabarang:dgimp.namabarang, tipebarang:"", jml:dgimp.jml, satuan:dgimp.satuan, 
