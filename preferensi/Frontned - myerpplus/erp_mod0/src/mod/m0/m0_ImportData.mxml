			public function fGJ():void
			{
				var x:int, i:int, ob:Object = {};
				acSimpan.removeAll(); 
				obj = {};
				for(i=2; i<dgImport.dataProviderLength; i++) 
				{
//					Alert.show(dgImport.dataProvider[i].tanggal);
					ob = dgImport.dataProvider[i];
					
					if(ob.chk)
					{
//						Alert.show(ob.tanggal);
						for(x=0; x<dgImport.columns.length ; x++)
						{
							if(!isNaN(Number(ob[dgImport.columns.getItemAt(x).headerText.toLowerCase()])))
							{
								if(dgImport.columns.getItemAt(x).headerText.indexOf("DEBIT") > -1)
								{ 
									if(obj.hasOwnProperty(ob.notransaksi))
									{
//										obj[ob.notransaksi].kredit = 0;   
										obj[ob.notransaksi].debit += Number(ob[dgImport.columns.getItemAt(x).headerText.toLowerCase()]);
									}
									else
									{
										obj[ob.notransaksi] = {};
										obj[ob.notransaksi].debit = Number(ob[dgImport.columns.getItemAt(x).headerText.toLowerCase()]);
										obj[ob.notransaksi].kredit = 0;
										obj[ob.notransaksi].arr = new ArrayCollection;
										acSimpan.addItem({gjkontak: ob.gjkontak, notransaksi:ob.notransaksi, gjtgl:ob.tanggal, gjuraian:ob.uraian, gjcatatan: ob.notransaksi, lokasi : ob.lokasi});
									}
								}
								else if(dgImport.columns.getItemAt(x).headerText.indexOf("KREDIT") > -1)
								{
									if(obj.hasOwnProperty(ob.notransaksi))
									{  
//										obj[ob.notransaksi].debit = 0;
										obj[ob.notransaksi].kredit += Number(ob[dgImport.columns.getItemAt(x).headerText.toLowerCase()]);
									}
									else
									{				 					
										obj[ob.notransaksi] = {};  
										obj[ob.notransaksi].debit = 0;
										obj[ob.notransaksi].kredit = Number(ob[dgImport.columns.getItemAt(x).headerText.toLowerCase()]);
										obj[ob.notransaksi].arr = new ArrayCollection;
										acSimpan.addItem({gjkontak: ob.gjkontak, notransaksi:ob.notransaksi, gjuraian:ob.uraian, gjcatatan: ob.notransaksi, lokasi : ob.lokasi});
									}
