			public function f_keydown(e:KeyboardEvent):void{
				switch(e.keyCode){
					case Keyboard.F12:
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgExport);
						FlexGlobals.topLevelApplication.F_acAdd(dgExport);
						f_browseFile();
						break;
					case Keyboard.N:
						if(e.ctrlKey){
							FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgExport);
							FlexGlobals.topLevelApplication.F_acAdd(dgExport);
							f_browseFile();
						}
						break;
					//					case Keyboard.D:
					//						if(e.ctrlKey)
					//							f_hapus();
					//						break;
					case Keyboard.DELETE:
						o.arr = new ArrayCollection([dgExport.dataProvider[dgExport.selectedCell.rowIndex]]);
						break;
					case Keyboard.S:
						if(e.ctrlKey)
						break;
				}
			}
			
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "checkBoxHeader":
						
						for (i=0; i<dgExport.dataProviderLength; i++){
							dgExport.dataProvider.getItemAt(i).chk = data;
						}
						break;
					case "checkBox":
						dgExport.dataProvider.getItemAt(dgExport.selectedCell.rowIndex).chk = data;
						break;
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgExport);
			}
			
			private function f_browseFile():void
			{
				var arr:Array = [];
				arr.push(new FileFilter("Excel File","*.xls"));
				fileReference.browse(arr);
			}
			
			private function fileReference_select(evt:Event):void {
				fileReference.load();
			}
			
			private function fileReference_complete(evt:Event):void {
				
				
				bytearrayexcel = fileReference.data
				var excelFile:ExcelFile = new ExcelFile();
				excelFile.loadFromByteArray(bytearrayexcel);
				var sheet : Sheet = excelFile.sheets[0];
				for(var i:int = 0; i<excelFile.sheets.length; i++){
					sheet = excelFile.sheets[i];
				}
			}
			
