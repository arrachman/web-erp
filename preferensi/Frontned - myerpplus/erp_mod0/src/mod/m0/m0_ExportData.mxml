			public function f_wsHasil():void
			{
				var ws:Object;
				if(FlexGlobals.topLevelApplication.wsSuccess ){
					switch (FlexGlobals.topLevelApplication.subject){
						
						case "tampil":
							txtheader = FlexGlobals.topLevelApplication.vArrResult[3]
							headergrid = txtheader.split(""+FlexGlobals.topLevelApplication.sptField+"");
							for each (var field:String in headergrid)  
							{  
//								Alert.show(field)
								var myColumn:GridColumn = new GridColumn(); 
								myColumn.width = 150;
								myColumn.editable = false;
								myColumn.headerText = field;
								field = field.split(" ").join("");
								myColumn.dataField = field.toLowerCase();
								dgExport.columns.addItem(myColumn);
							} 
							dgExport.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
							break;
						
						case "Uploading":
							FlexGlobals.topLevelApplication.F_wsSearch('tampilFile', 'M2_FilesSearch', 1, 1, 'fsumber = "CR" AND fidtransaksi = "0"', 'finputtgl desc');
							break;
						case "tampilFile":
							navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f2/CR/"+FlexGlobals.topLevelApplication.wsArrUtama[0].fnamafile));
							break
						
					}
				}
				else{
					if(parentApplication.F_validasiFalse(FlexGlobals.topLevelApplication.subject) ){
						switch (FlexGlobals.topLevelApplication.subject){
							case "simpan":
								
								break;
							
							case "Uploading":
								navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f2/CR/Data Gagal Import_"+jmlfile+".xls"));
								break;
							
						}
					}
				}
			}
