				if(parentApplication.wsSuccess )
				{
					if(parentApplication.wsArrUtama.getItemAt.length >= 0)
						m = parentApplication.wsArrUtama.getItemAt(0);
					for(i=0;i<Where.length;i++)
					{
						if(('item'+[i]) == s)
						{
							o['item'+[i]].text = m[Where[i].p.split(sptField)[2]];
							o['item'+[i]].selectRange(0, o['item'+[i]].text.length);
							if(o.hasOwnProperty('item2'+[i]))
								o['item2'+[i]].text = m[Where[i].p.split(sptField)[2]];
