			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				var a:Array;
				for(i=0;i<Where.length;i++)
				{
					if(('item'+[i]) == target)
					{
						a = Where[i].p.split(sptField);
						paket = a[1];
						if(String(a[3]).length > 0)
							wsfilter = a[3]+" AND ";
						wsfilter += a[2]+" = '"+o['item'+[i]].text+"'";
						csfilter = a[3];
						if(a.length > 4)
							sort = a[4];
						if(sort == "0")
							sort = "";
						break; 
					}else if('item2'+[i] == target)
					{
						a = Where[i].p.split(sptField);
						paket = a[1];
						if(String(a[3]).length > 0)
							wsfilter = a[3]+" AND ";
						wsfilter += a[2]+" = '"+o['item2'+[i]].text+"'";
						csfilter = a[3];
						if(a.length > 4)
							sort = a[4];
						if(sort == "0")
							sort = "";
						break;
					}
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
