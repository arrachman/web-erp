			public function f_focusOnMe():void
			{
				txtkode.setFocus();
			}
			protected function f_persiapan():void
			{
				p.F_txtpencarian([txtkontak, txtlokasi, txtcabang, txtgudang, txtbahasa, txtaktivitasproduksi]);
				p.F_SetNavigasiKeyboard([txtkode, txtnama, txtkota, txtpassword]);
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				p.F_DateFieldStandard([dtexpired]);
				parentApplication.F_ComboBoxStandard([cmblevel]);
				FlexGlobals.topLevelApplication.F_RegGrid(0, 4, [dgrole, dgcabang, dglokasi, dggudang, dgakun], 'transaksi');
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkode, tnama, tpassword, tkontak, tcabang, tlokasi, tgudang, tkota, tbahasa, tberakhir, taktivitasproduksi]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode, tnama, tkontak, tcabang, tlokasi, tgudang, tkota, tbahasa, tberakhir]);
				chkaktif.label = p.l(chkaktif.label);
				cmblevel.dataProvider = new ArrayCollection([
					{l:'POS', v:'0'}, 
					{l:'Pusat', v:'1'}, 
					{l:'POS & Pusat', v:'2'}, 
					{l:'BI', v:'3'}, 
					{l:'BI & Pusat', v:'4'}]);
				var arrMenuBar:ArrayCollection = new ArrayCollection([
					{label:"Simpan", icon:tbsave}, 
					{label:"Batal", icon:tbcancel}, 
					{label:"Ganti Password", icon:mainpassword}, 
					{label:"Photo", icon:tbphoto, children:[
						{label:"Browse File", icon:tbaddphoto},
						{label:"Via Web Camera", icon:tbwebcam}]
					}]);
				parentApplication.F_settingmb(mb, arrMenuBar);
				if(p.FormFilter == '@'){
					FlexGlobals.topLevelApplication.F_RequiredLabel([tpassword], 'blue')
					o = p.m[p.idmodcurr].child.dg.dataProvider.getItemAt(p.m[p.idmodcurr].child.dg.selectedIndex);
					FlexGlobals.topLevelApplication.F_wsGetDataById('getData', 'M0_UserGetdataById', o.userid);
				}else if(p.FormFilter == 'parent'){
					FlexGlobals.topLevelApplication.F_RequiredLabel([tpassword], 'blue');
					ncrole.enabled = false;
					dgcabang.enabled = false;
					dglokasi.enabled = false;
					dggudang.enabled = false;
					txtcabang.enabled = false;
					txtlokasi.enabled = false;
					txtgudang.enabled = false;
					dtexpired.enabled = false;
					chkaktif.enabled = false;
					FlexGlobals.topLevelApplication.F_wsGetDataById('getData', 'M0_UserGetdataById', parentApplication.userid);
				}else{
					FlexGlobals.topLevelApplication.F_RequiredLabel([tpassword])
					f_kondisiAwal();
				}
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbsimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_batal);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_gantiPassword);
				mb.addEventListener(mx.events.MenuEvent.ITEM_CLICK, f_mbItemClick); 
				mb.menuBarItems[2].enabled = false;
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_keydown);
				chkaktif.label = FlexGlobals.topLevelApplication.l(chkaktif.label);
				function f_mbItemClick(e:MenuEvent):void
				{
					switch(e.label){
						case "Browse File":
							f_browseFile();
							break;
						case "Via Web Camera":
							p.f_takePhoto();
							break;
					}
				}
				
				function f_keydown(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ESCAPE)
						p.closeFormPopUp();
				}
				
				function f_mbsimpan():void
				{
					f_simpan();
				}
				
				function f_batal():void
				{
					p.closeFormPopUp();
				}
				
				function f_gantiPassword():void
				{
					if(isUpdate )
						FlexGlobals.topLevelApplication.openFormX("Ganti Password", 1, "mod/m0/m0_AdministrasiUserGantiPassword.swf", 115, 285, "t1", u.getItemAt(0).userid, null, 2);
				}
			}
			
