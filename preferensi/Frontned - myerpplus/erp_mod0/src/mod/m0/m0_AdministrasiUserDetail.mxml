				lblkontak.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'KontakNama');
				txtcabang.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'Cabang');
				lblcabang.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'CabangNama');
				txtlokasi.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'Lokasi');
				lbllokasi.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'LokasiNama');
				txtgudang.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'Gudang');
				lblgudang.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'GudangNama');
				txtkota.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'Kota');
				txtbahasa.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'Bahasa');
				lblbahasa.text = FlexGlobals.topLevelApplication. getSetting(0, 'company', 'BahasaNama');
				txtaktivitasproduksi.text = "";
				lblaktivitasproduksi.text = "";
				//dg cabang
//				dgcabang.dataProvider[0].bkode = txtcabang.text;
//				dgcabang.dataProvider[0].bnama = lblcabang.text;
//				dgcabang.dataProvider[0].cabanglama = txtcabang.text;
//				//dg lokasi
//				dglokasi.dataProvider[0].lkode = txtlokasi.text;
//				dglokasi.dataProvider[0].lnama = lbllokasi.text;
//				dglokasi.dataProvider[0].lcabang = txtcabang.text;
//				dglokasi.dataProvider[0].lokasilama = txtlokasi.text;
//				//dg gudang
//				dggudang.dataProvider[0].wkode = txtgudang.text;
//				dggudang.dataProvider[0].wnama = lblgudang.text;
//				dggudang.dataProvider[0].wlokasi = txtlokasi.text;
				//==========================================
				chkaktif.selected = true;
				dtt.date += 30;
				dtexpired.text = dtf.format(dtt);
				f_focusOnMe();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtkontak":						
						paket = 'CdM1_Contact';
						wsfilter = "kkode ='"+txtkontak.text+"'";
						break;
					case "txtcabang":
						if(txtcabang.enabled ){
							paket = 'CdM1_BranchAll';
							wsfilter = "bkode ='"+txtcabang.text+"'";
						}
						break;
					case "txtlokasi":
						if(txtlokasi.enabled ){
							if(txtcabang.text.length > 0){
								paket = 'CdM1_LocationAll';
								wsfilter = "lkode ='"+txtlokasi.text+"' AND lcabang = '"+txtcabang.text+"'";
								csfilter = "lcabang = '"+txtcabang.text+"'"
							}else{
								txtcabang.setFocus();
								Alert.show("Cabang harus diisi terlebih dahulu", "Informasi");
							}
						}
						break;
					case "txtgudang":
						if(txtgudang.enabled ){
							if(txtlokasi.text.length > 0){
								paket = 'CdM1_WarehouseAll';
								wsfilter = "wkode ='"+txtgudang.text+"' AND wlokasi ='"+txtlokasi.text+"'";
								csfilter = "wlokasi ='"+txtlokasi.text+"'"
							}else{
								txtlokasi.setFocus();
								Alert.show("Lokasi harus diisi terlebih dahulu", "Informasi");
							}
						}
						break;
					
					case "bkode":
						paket = 'CdM1_BranchAll';
						wsfilter = "bkode ='"+dgcabang.dataProvider[dgcabang.selectedCell.rowIndex].bkode+"'";
						break;
					
					case "lkode":
						var vcabang:String = "";
						var f:String="";
						for(var m:int = 0; m<dgcabang.dataProviderLength; m++){
							if(dgcabang.dataProvider[m].bkode != ""){
								vcabang = FlexGlobals.topLevelApplication.TambahFilter(vcabang, "lcabang ='"+dgcabang.dataProvider[m].bkode+"'");
							}
							
						}
						f = vcabang.split("AND").join("OR");
						if(f.length > 0){
							f = "( "+f+" OR (lcabang = '') )";
							paket = 'CdM1_LocationAll';
							wsfilter = "lkode ='"+dglokasi.dataProvider[dglokasi.selectedCell.rowIndex].lkode+"' AND "+f;
							csfilter = f;
						}else{
							tab.selectedIndex = 2;
							dgcabang.setFocus();
							Alert.show("Cabang harus diisi terlebih dahulu", "Informasi");
						}
						break;
					case "wkode":
						var vlokasi:String = "";
						var fg:String="";
						for(var n:int = 0; n<dglokasi.dataProviderLength; n++){
							if(dglokasi.dataProvider[n].lkode != ""){
								vlokasi = FlexGlobals.topLevelApplication.TambahFilter(vlokasi, "wlokasi ='"+dglokasi.dataProvider[n].lkode+"'");
							}
							
						}
						fg = vlokasi.split("AND").join("OR");
						if(fg.length > 0){
							fg = "( "+fg+" OR (wlokasi = '') )";
							paket = 'CdM1_WarehouseAll';
							wsfilter = "wkode ='"+dggudang.dataProvider[dggudang.selectedCell.rowIndex].wkode+"' AND "+fg;
							csfilter = fg;
						}else{
							tab.selectedIndex = 3;
							dglokasi.setFocus();
							Alert.show("Lokasi harus diisi terlebih dahulu", "Informasi");
						}
						break;
					case "norek":
						paket = 'CdM1_Coa';
						wsfilter = "cgd = 'D' AND caktif = 1 AND cnomor ='"+dgakun.dataProvider[dgakun.selectedCell.rowIndex].norek+"'";
						csfilter = "cgd = 'D' AND caktif = 1";
						break;
					case "txtbahasa":
						paket = 'M0_LanguageSearch';
						wsfilter = "lkode ='"+txtbahasa.text+"'";
						break;
					case "rkode":
						paket = 'M0_RoleSearch';
						wsfilter = "rkode ='"+dgrole.dataProvider.getItemAt(dgrole.selectedCell.rowIndex).rkode+"'";
						break;
					case "txtaktivitasproduksi":						
						paket = 'CdM1_Production_Activity';
						wsfilter = "pakode ='"+txtaktivitasproduksi.text+"' AND paaktif = 1";
						csfilter = "paaktif = 1";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				if(p.wsSuccess ){
					o = p.wsArrUtama.getItemAt(0);
					switch(p.subject){
						case "txtkontak":
							u.getItemAt(0).ukontak = o.kid;
							txtkontak.text = o.kkode;
							lblkontak.text = o.knama;
							break;
						case "txtcabang":
							txtcabang.text = o.bkode;
							lblcabang.text = o.bnama;
							FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi, lbllokasi, txtgudang, lblgudang]);
//							FlexGlobals.topLevelApplication.F_defaultGrid([dgcabang, dglokasi, dggudang]);
							//dg cabang
							dgcabang.dataProvider[0].bkode = txtcabang.text;
							dgcabang.dataProvider[0].bnama = o.bnama;
							dgcabang.dataProvider[0].cabanglama = txtcabang.text;
							FlexGlobals.topLevelApplication.F_dgRefresh(dgcabang);
							//dg lokasi
//							dglokasi.dataProvider[0].lkode = txtlokasi.text;
//							dglokasi.dataProvider[0].lnama = lbllokasi.text;
//							dglokasi.dataProvider[0].lcabang = txtcabang.text;
//							dglokasi.dataProvider[0].lokasilama = txtlokasi.text;
//							FlexGlobals.topLevelApplication.F_dgRefresh(dglokasi);
//							//dg gudang
//							dggudang.dataProvider[0].wkode = txtgudang.text;
//							dggudang.dataProvider[0].wnama = lblgudang.text;
//							dggudang.dataProvider[0].wlokasi = txtlokasi.text;
//							FlexGlobals.topLevelApplication.F_dgRefresh(dggudang);
							break;
						case "txtlokasi":
							txtlokasi.text = o.lkode;
							lbllokasi.text = o.lnama;
							FlexGlobals.topLevelApplication.F_KosongkanText([txtgudang, lblgudang]);
//							FlexGlobals.topLevelApplication.F_defaultGrid([dglokasi, dggudang]);
							//dg lokasi
//							dglokasi.dataProvider[0].lkode = txtlokasi.text;
//							dglokasi.dataProvider[0].lnama = lbllokasi.text;
//							dglokasi.dataProvider[0].lcabang = o.lcabang;
//							dglokasi.dataProvider[0].lokasilama = txtlokasi.text;
//							FlexGlobals.topLevelApplication.F_dgRefresh(dglokasi);
//							//dg gudang
//							dggudang.dataProvider[0].wkode = txtgudang.text;
//							dggudang.dataProvider[0].wnama = lblgudang.text;
//							dggudang.dataProvider[0].wlokasi = txtlokasi.text;
//							FlexGlobals.topLevelApplication.F_dgRefresh(dggudang);
							break;
						case "txtgudang":
							txtgudang.text = o.wkode;
							lblgudang.text = o.wnama;
//							FlexGlobals.topLevelApplication.F_defaultGrid([dggudang]);
							//dg gudang
//							dggudang.dataProvider[0].wkode = txtgudang.text;
//							dggudang.dataProvider[0].wnama = lblgudang.text; 
//							dggudang.dataProvider[0].wlokasi = o.wlokasi;
//							FlexGlobals.topLevelApplication.F_dgRefresh(dggudang);
							break;
						case "txtbahasa":
							txtbahasa.text = o.lkode;
							lblbahasa.text = o.lnama;
							break;
						case "txtaktivitasproduksi":
							u.getItemAt(0).uaktivitasproduksi = o.paid;
							txtaktivitasproduksi.text = o.pakode;
							lblaktivitasproduksi.text = o.panama;
							break;
						case "rkode":
							dgrole.dataProvider.getItemAt(p.rowIndex).rkode = o.rkode;
							dgrole.dataProvider.getItemAt(p.rowIndex).rnama = o.rnama;
							dgrole.dataProvider.setItemAt(dgrole.dataProvider.getItemAt(p.rowIndex), p.rowIndex); 
							break;
						
						case "bkode":
							dgcabang.dataProvider.getItemAt(p.rowIndex).bkode = o.bkode;
							dgcabang.dataProvider.getItemAt(p.rowIndex).bnama = o.bnama;
							
							if(o.bkode != dgcabang.dataProvider.getItemAt(p.rowIndex).cabanglama){
								for(var a:int = dglokasi.dataProviderLength - 1; a>= 0; a--){
									if(dgcabang.dataProvider.getItemAt(p.rowIndex).cabanglama == dglokasi.dataProvider.getItemAt(a).lcabang){
										dglokasi.dataProvider.removeItemAt(a);
									}
								}
								if(dglokasi.dataProviderLength == 0){
									FlexGlobals.topLevelApplication.F_defaultGridItem(dglokasi);
								}
								dgcabang.dataProvider.getItemAt(p.rowIndex).cabanglama = o.bkode;
							}else{
								dgcabang.dataProvider.getItemAt(p.rowIndex).bkode = o.bkode;
								dgcabang.dataProvider.getItemAt(p.rowIndex).bnama = o.bnama;
								dgcabang.dataProvider.getItemAt(p.rowIndex).cabanglama = dgcabang.dataProvider.getItemAt(p.rowIndex).bkode;
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgcabang);
							break;
						
						case "lkode":
							dglokasi.dataProvider.getItemAt(p.rowIndex).lkode = o.lkode;
							dglokasi.dataProvider.getItemAt(p.rowIndex).lnama = o.lnama;
							dglokasi.dataProvider.getItemAt(p.rowIndex).lcabang = o.lcabang;
							
							if(o.lkode != dglokasi.dataProvider.getItemAt(p.rowIndex).lokasilama){ 
								for(var b:int = dggudang.dataProviderLength - 1; b>= 0; b--){
									
									if(dglokasi.dataProvider.getItemAt(p.rowIndex).lokasilama == dggudang.dataProvider.getItemAt(a).wlokasi){
										dggudang.dataProvider.removeItemAt(a);
									}
								}
								if(dggudang.dataProviderLength == 0){
									FlexGlobals.topLevelApplication.F_defaultGridItem(dggudang);
								}
								
								dglokasi.dataProvider.getItemAt(p.rowIndex).lokasilama = o.lkode;
							}else{
								dglokasi.dataProvider.getItemAt(p.rowIndex).lkode = o.lkode;
								dglokasi.dataProvider.getItemAt(p.rowIndex).lnama = o.lnama;
								dglokasi.dataProvider.getItemAt(p.rowIndex).lcabang = o.lcabang;
								dglokasi.dataProvider.getItemAt(p.rowIndex).lokasilama = dglokasi.dataProvider.getItemAt(p.rowIndex).bkode;
							}
							
							FlexGlobals.topLevelApplication.F_dgRefresh(dglokasi);
//							FlexGlobals.topLevelApplication.F_defaultGridItem(dggudang);
							break;
						case "wkode":
							dggudang.dataProvider.getItemAt(p.rowIndex).wkode = o.wkode;
							dggudang.dataProvider.getItemAt(p.rowIndex).wnama = o.wnama;
							dggudang.dataProvider.getItemAt(p.rowIndex).wlokasi = o.wlokasi;
							FlexGlobals.topLevelApplication.F_dgRefresh(dggudang);
							break;
						case "norek":
							dgakun.dataProvider.getItemAt(p.rowIndex).norek = o.cnomor;
							dgakun.dataProvider.getItemAt(p.rowIndex).namaakun = o.cnama;
							FlexGlobals.topLevelApplication.F_dgRefresh(dgakun);
							break;
						case "getData":
							u = new ArrayCollection([{userid:o.userid, upassword:o.upassword, ugambar:o.ugambar, ukontak:o.ukontak, ulevel:o.ulevel, udefaultview:o.udefaultview, uaktivitasproduksi:o.uaktivitasproduksi}]);
							cmblevel.selectedIndex = o.ulevel
							txtkode.enabled = false;
							txtkode.text = o.ukode;
							txtnama.text = o.unama;
							txtpassword.text = '';
							txtkontak.text = o.ukontakkode;
							lblkontak.text = o.ukontaknama;
							txtcabang.text = o.ucabang;
							lblcabang.text = o.ucabangnama;
							txtlokasi.text = o.ulokasi;
							lbllokasi.text = o.ulokasinama;
							txtgudang.text = o.ugudang;
							lblgudang.text = o.ugudangnama;
							txtkota.text = o.ukota;
							txtbahasa.text = o.ubahasa;
							lblbahasa.text = o.ubahasanama;
							dtexpired.text = o.utglexpired;
							txtaktivitasproduksi.text = o.uaktivitasproduksikode;
							lblaktivitasproduksi.text = o.uaktivitasproduksinama;
							txtpassword.enabled = false;
							isUpdate = true;
							chkaktif.selected = Boolean(o.uaktif);
							mb.menuBarItems[2].enabled = true;
							if(o.ugambar != '')
								if(o.ugambar == 'm0_user-0.jpg')imgUser.source = "../../files/f0/user/m0_user-"+o.userid+".jpg";
								else imgUser.source = "../../files/f0/user/"+o.ugambar;
							o = p.wsArrDetail;
							for(i=0;i<o.length;i++){
								if(i==0)dgrole.dataProvider.removeAll();
								dgrole.dataProvider.addItem({no:(i+1), rkode:o.getItemAt(i).role, rnama:o.getItemAt(i).rolenama});
							}
							
							p.wsArrDetail = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[2], FlexGlobals.topLevelApplication.vData[2]);
							o = p.wsArrDetail;
							for(i=0;i<o.length;i++){
								if(i==0)dgcabang.dataProvider.removeAll();
								dgcabang.dataProvider.addItem({no:(i+1),bkode:o.getItemAt(i).cabang, bnama:o.getItemAt(i).bnama, cabanglama:o.getItemAt(i).cabang});
							}
							
							p.wsArrDetail = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[3], FlexGlobals.topLevelApplication.vData[3]);
							o = p.wsArrDetail;
							for(i=0;i<o.length;i++){
								if(i==0)dglokasi.dataProvider.removeAll();
								dglokasi.dataProvider.addItem({no:(i+1),lkode:o.getItemAt(i).lokasi, lnama:o.getItemAt(i).lnama, lcabang:o.getItemAt(i).lcabang, lokasilama:o.getItemAt(i).lokasi});
							}
							
							p.wsArrDetail = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[4], FlexGlobals.topLevelApplication.vData[4]);
							o = p.wsArrDetail;
							for(i=0;i<o.length;i++){
								if(i==0)dggudang.dataProvider.removeAll();
								dggudang.dataProvider.addItem({no:(i+1),wkode:o.getItemAt(i).gudang, wnama:o.getItemAt(i).wnama, wlokasi:o.getItemAt(i).wlokasi});
							}
							
							p.wsArrDetail = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[5], FlexGlobals.topLevelApplication.vData[5]);
							o = p.wsArrDetail;
							for(i=0;i<o.length;i++){
								if(i==0)dgakun.dataProvider.removeAll();
								dgakun.dataProvider.addItem({no:(i+1),norek:o.getItemAt(i).norek, namaakun:o.getItemAt(i).cnama});
							}
							break;
						case "setUpload":
							p.closeFormPopUp();
							break;
						case "getPhoto":
							imgUser.source = p.wsFile;
							break;
						case "simpan":
							if(p.FormFilter != 'parent')
							{
								p.subject = 'tampil';
								p.m[p.idmodcurr].child.f_wsHasil();
							}
							
							if(isUpload )
							{
								if(isUpdate == false)
									for(i=0;i<p.wsArrUtama.length;i++)
										if(txtkode.text == p.wsArrUtama.getItemAt(i).ukode)
										{
											u.getItemAt(0).userid = p.wsArrUtama.getItemAt(i).userid;
											break;
										}
								FlexGlobals.topLevelApplication.F_wsUpload('setUpload', 'uploadFile', u.getItemAt(0).userid, 'm0_user', 'jpg', imgUser.source, 0, '@', '', '@', FlexGlobals.topLevelApplication.DefaultTanggalforDB);
							}
							else
								p.closeFormPopUp();
							break;
					}
				}else{
					if(p.F_validasiFalse(p.subject) )
						switch(p.subject){
							case "rkode":
								dgrole.dataProvider.getItemAt(p.rowIndex).rkode = '';
								dgrole.dataProvider.getItemAt(p.rowIndex).rnama = '';
								dgrole.dataProvider.setItemAt(dgrole.dataProvider.getItemAt(p.rowIndex), p.rowIndex);
								break;
							case "txtkontak":
								u.getItemAt(0).ukontak = 0;
								lblkontak.text = '';
								break;
							case "txtbahasa":
								lblbahasa.text = ''; 
								break;
							case "txtaktivitasproduksi":
								u.getItemAt(0).uaktivitasproduksi = 0;
								txtaktivitasproduksi.text = '';
								lblaktivitasproduksi.text = '';
								break;
							case "txtcabang": 
								FlexGlobals.topLevelApplication.F_KosongkanText([txtcabang, lblcabang, txtlokasi, lbllokasi, txtgudang, lblgudang]);
								FlexGlobals.topLevelApplication.F_defaultGrid([dgcabang, dglokasi, dggudang]);
								break;
							case "txtlokasi":
								FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi, lbllokasi, txtgudang, lblgudang]);
								FlexGlobals.topLevelApplication.F_defaultGrid([dglokasi, dggudang]);
								break;
							case "txtgudang":
								FlexGlobals.topLevelApplication.F_KosongkanText([txtgudang, lblgudang]);
								FlexGlobals.topLevelApplication.F_defaultGrid([dggudang]);
								break;
							case "simpan":
								Alert.show(p.wsErrmessage);
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "txtkontak":p.F_KosongkanText([txtkontak, lblkontak]);break;
					case "txtbahasa":p.F_KosongkanText([txtbahasa, lblbahasa]);break;
					case "txtcabang":
			 			FlexGlobals.topLevelApplication.F_KosongkanText([txtcabang, lblcabang, txtlokasi, lbllokasi, txtgudang, lblgudang]);
						FlexGlobals.topLevelApplication.F_defaultGrid([dgcabang, dglokasi, dggudang]);
						break;
					case "txtlokasi":
						FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi, lbllokasi, txtgudang, lblgudang]);
						FlexGlobals.topLevelApplication.F_defaultGrid([dglokasi, dggudang]);
						break;
					case "txtgudang":
						FlexGlobals.topLevelApplication.F_KosongkanText([txtgudang, lblgudang]);
						FlexGlobals.topLevelApplication.F_defaultGrid([dggudang]);
						break;
					case "txtaktivitasproduksi":p.F_KosongkanText([txtaktivitasproduksi, lblaktivitasproduksi]);break;
				}
			}
			
			public function f_gantiGambar(ba:ByteArray):void
			{
				isUpload = true;
				imgUser.source = ba;
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String = '', cabang:String="", lokasi:String="", gudang:String="", akun:String="";
				p.vpFocusEvent = true;
				validasiForm();
				if(validasi ){ 
					u.getItemAt(0).upassword = txtpassword.text
					if(isUpdate )u.getItemAt(0).upassword = "auto";
					if(isUpload )u.getItemAt(0).ugambar = 'm0_user-'+u.getItemAt(0).userid+'.jpg';
					with(u.getItemAt(0))
					a = [userid, txtkode.text, txtnama.text, upassword, ukontak, txtcabang.text, txtlokasi.text, 
					txtgudang.text, txtkota.text, ugambar, int(chkaktif.selected), p.F_tglFormatDB(dtexpired.text), cmblevel.selectedIndex, '0', 
					txtbahasa.text, udefaultview, uaktivitasproduksi];
					utama = p.F_splitArrayToString(a);
					for(i=0;i<dgrole.dataProviderLength;i++){
						if(dgrole.dataProvider.getItemAt(i).rkode != '' && dgrole.dataProvider.getItemAt(i).rkode != undefined){
							a = [u.getItemAt(0).userid, dgrole.dataProvider.getItemAt(i).rkode];
							if(i>0)detail += "▲";
							detail += p.F_splitArrayToString(a);
						}
					}
					for(i=0;i<dgcabang.dataProviderLength;i++){
						if(dgcabang.dataProvider.getItemAt(i).bkode != '' && dgcabang.dataProvider.getItemAt(i).bkode != undefined){
							a = [u.getItemAt(0).userid, dgcabang.dataProvider.getItemAt(i).bkode];
							if(i>0)cabang += "▲";
							cabang += FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						}
					}
					for(i=0;i<dglokasi.dataProviderLength;i++){
						if(dglokasi.dataProvider.getItemAt(i).lkode != '' && dglokasi.dataProvider.getItemAt(i).lkode != undefined){
							a = [u.getItemAt(0).userid, dglokasi.dataProvider.getItemAt(i).lkode];
							if(i>0)lokasi += "▲";
							lokasi += p.F_splitArrayToString(a);
						}
					}
					for(i=0;i<dggudang.dataProviderLength;i++){
						if(dggudang.dataProvider.getItemAt(i).wkode != '' && dggudang.dataProvider.getItemAt(i).wkode != undefined){
							a = [u.getItemAt(0).userid, dggudang.dataProvider.getItemAt(i).wkode];
							if(i>0)gudang += "▲";
							gudang += p.F_splitArrayToString(a);
						}
					}
					for(i=0;i<dgakun.dataProviderLength;i++){
						if(dgakun.dataProvider.getItemAt(i).norek != '' && dgakun.dataProvider.getItemAt(i).norek != undefined){
							a = [u.getItemAt(0).userid, dgakun.dataProvider.getItemAt(i).norek];
							if(i>0)akun += "▲";
							akun += p.F_splitArrayToString(a);
						}
					}
						
					p.F_wsSimpan('simpan', 'M0_UserSimpan', p.userid, isUpdate, utama+"△"+detail+"△"+cabang+"△"+lokasi+"△"+gudang+"△"+akun, '');
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					vMsg = "";
					if(txtkode.text == "")msgAlert(txtkode, 'Kode');
					if(txtnama.text == "")msgAlert(txtnama, 'Nama');
					if(txtpassword.text == "" && isUpdate == false)msgAlert(txtpassword, 'Password');
					if(txtkontak.text == "")msgAlert(txtkontak, 'Kontak');
					if(txtcabang.text == "")msgAlert(txtcabang, 'Cabang');
					if(txtlokasi.text == "")msgAlert(txtlokasi, 'Lokasi');
					if(txtgudang.text == "")msgAlert(txtgudang, 'Gudang');
					if(txtkota.text == "")msgAlert(txtkota, 'Kota');
					if(txtbahasa.text == "")msgAlert(txtbahasa, 'Bahasa');
					if(dtexpired.text == "")msgAlert(dtexpired, 'Tgl Expired');
					if(vMsg != '')msgAlert('clear', '');		
					else{
						if(txtpassword.text.length < 6 && isUpdate == false){
							txtpassword.setFocus();
							Alert.show("Panjang Password Minim 6 digit", "Informasi");
							validasi = false;
						}else if(dgrole.dataProvider.getItemAt(0).rkode == '' || dgrole.dataProvider.getItemAt(0).rkode == undefined){
							Alert.show(parentApplication.l('Role Kosong !'), parentApplication.l('Informasi'));
							validasi = false;
						}
					}
					function msgAlert(focus:Object, pesan:String):void
					{		
						if(validasi )focus.setFocus();
						vMsg += pesan+', ';
						if(focus == 'clear'){
							vMsg = vMsg.substr(0, vMsg.length-4);
							vMsg += " Harus di isi dengan benar";
							Alert.show(vMsg, "Informasi");}	
						validasi = false;						
					}
				}
			}
			
			public function f_hitungTotal():void
			{
				
			}
			
			// Upload Foto
			private function f_browseFile():void {
				var arr:Array = [];
				arr.push(new FileFilter("Images", ".gif;*.jpeg;*.jpg;*.png"));
				fileReference.browse(arr);
			}
			
			private function fileReference_select(evt:Event):void {
				fileReference.load();
			}
			
			private function fileReference_complete(evt:Event):void {
				f_gantiGambar(fileReference.data);
			}
			
			protected function l(s:String):String
			{
				return FlexGlobals.topLevelApplication.l(s);
			}
			
			protected function module1_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.ctrlKey == Keyboard.S)
					f_simpan();
			}
			
		]]>
	</fx:Script>
