<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx" 
		  width="100%" height="100%" keyDown="module1_keyDownHandler(event)"
		  creationComplete="f_persiapan()" initialize="p=parentApplication">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.rpc.xml.SimpleXMLDecoder;
			import mx.utils.ArrayUtil;
			
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			
			protected var p:Object, validasi:Boolean,	vMsg:String, u:ArrayCollection, isUpdate:Boolean = false, i:int, ob:Object;
			public var dgmenu_ac:ArrayCollection = new  ArrayCollection, o:Object = {};
			
			public function f_focusOnMe():void
			{
				txtkode.setFocus();
			}
			
			protected function l(data:String):String
			{
				return p.F_language(data);
			}
			
			protected function f_persiapan():void
			{
				FlexGlobals.topLevelApplication.F_TranslateLabel([tkode, tnama]);
				FlexGlobals.topLevelApplication.F_RequiredLabel([tkode, tnama]);
				grpBusy.visible = true;
				p.F_tabvalidatenow(tab);
				with(dgmenu){
					editable = true;
					sortableColumns = false;
					resizableColumns = true;
					selectionMode = "singleCell";
				}
				with(dgreport){
					editable = true;
					sortableColumns = false;
					resizableColumns = true;
					selectionMode = "singleCell";
				}
				with(dgcustom){
					editable = true;
					sortableColumns = false;
					resizableColumns = true;
					selectionMode = "singleCell";
				}
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan)
				FlexGlobals.topLevelApplication.F_RegGrid(0, 5, [dgmenu], 'data2', 2);
				FlexGlobals.topLevelApplication.F_RegGrid(0, 5, [dgreport, dgcustom, dghome]);
				FlexGlobals.topLevelApplication.F_RegGrid(0, 5, [dgkategoribarang], 'TransaksiBarang');
				FlexGlobals.topLevelApplication.F_wsSearch('tampil', 'M0_RoleGetSetting', 0, 0, p.ubahasa);
				
				function f_mbSimpan():void
				{
					var data1:String = '', data2:String = '', data3:String = '', data4:String = '';
					validasiForm();
					if(validasi == false)
						return;
					for(i=0;i<dgmenu_ac.length;i++){
						if(!dgmenu_ac.getItemAt(i).hasOwnProperty("f"))
						{
							dgmenu_ac.getItemAt(i).f = false;
						}
						with(dgmenu_ac.getItemAt(i))
							if(c1 != false || c2 != false || c3 != false || c4 != false || c5 != false || c6 != false || c7 != false || c8 != false || c9 != false || c10 != false || c11 != false || c12 != false || c13 != false){
								if(data1 != '')data1 += "▲";
								if(f == undefined)f = 0;
								data1 += mnmoduleid+"▼"+mnid+"▼"+rmrole+"▼"+int(c1)+""+int(c2)+""+int(c3)+""+int(c4)+""+int(c5)+""+int(c6)+""+int(c7)+""+int(c8)+""+int(c9)+""+int(c10)+""+int(c11)+""+int(c12)+""+int(c13)+"▼"+int(f);
							}
					}
					for(i=0;i<dgreport.dataProviderLength;i++){
						with(dgreport.dataProvider.getItemAt(i)) 
							if(c ){
								if(data2 != '')data2 += "▲";
								data2 += mid+"▼"+mnid+"▼"+ritem+"▼"+rrrole+"▼"+int(c);
							}
					}
					for(i=0;i<dgcustom.dataProviderLength;i++){
						with(dgcustom.dataProvider.getItemAt(i))
							if(c ){
								if(data3 != '')data3 += "▲";
								data3 += pcmodule+"▼"+pcid+"▼"+rcrole+"▼"+int(c);
							}
					}
					
					parentApplication.F_hapusBarisKosongGrid(dgkategoribarang);
					for(i=0;i<dgkategoribarang.dataProviderLength;i++)
					{
						if(dgkategoribarang.dataProvider.getItemAt(i).rickategoribarang.length > 0)
						{
							if(data4 != '')data4 += "▲";
							data4 += txtkode.text+"▼"+dgkategoribarang.dataProvider.getItemAt(i).rickategoribarang;
						}
					}
					if(data1 == '' && data2 == '' && data3 == '' && data4 == ''){
						Alert.show(l('Data Kosong'), l('Validasi'));
						return;
					}
					data1 = data1+"△"+data2+"△"+data3+"△"+data4;
					p.F_wsSimpan('simpan', 'M0_RoleSimpan', p.userid, isUpdate, txtkode.text+"▼"+txtnama.text, data1);
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					vMsg = "";
					if(txtkode.text == "")msgAlert(txtkode, 'Kode');
					if(txtnama.text == "")msgAlert(txtnama, 'Nama');
					if(vMsg != '')msgAlert('clear', '');		
					
					function msgAlert(focus:Object, pesan:String):void
					{		
						if(validasi )focus.setFocus();
						vMsg += pesan+', ';
						if(focus == 'clear'){
							vMsg = vMsg.substr(0, vMsg.length-4);
							vMsg += " Harus di isi dengan benar";
							Alert.show(vMsg, "Validasi");}	
						validasi = false;						
					}
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var ob:Object, j:int, variabelvalidasi:Boolean;
				switch(components){
					case "checkBox":
						// Menu
						if(tab.selectedIndex == 0)
						{
							ob = dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex);
							if(dataField == 'c')
							{
								if(ob.mnlevel == 0)
									for(i=dgmenu.selectedCell.rowIndex;i<dgmenu_ac.length;i++){
										o = dgmenu_ac.getItemAt(i)
										if(o.mnlevel == 0 && i!=dgmenu.selectedCell.rowIndex)break;
										o[Object(dataField)] = int(data);
										for(j = 1; j<=13;j++)
											o[Object(dataField+j)] = int(data);
										dgmenu_ac.setItemAt(o, i);
									}
								else if(ob.mnlevel == 1)
									for(i=dgmenu.selectedCell.rowIndex;i<dgmenu_ac.length;i++)
									{
										o = dgmenu_ac.getItemAt(i)
										if(o.mnlevel != 2 && i!=dgmenu.selectedCell.rowIndex)
										{
											break;
										}
										
										o[Object(dataField)] = int(data);
										for(j = 1; j<=13;j++)
										{
											o[Object(dataField+j)] = int(data);
										}
										dgmenu_ac.setItemAt(o, i);
									}
								else if(ob.mnlevel == 2)
								{
									o = dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex)
									for(j = 1; j<=13;j++)
									{
										o[Object(dataField+j)] = int(data);
									}
									dgmenu_ac.setItemAt(o, dgmenu.selectedCell.rowIndex);
									
									// Select parent mnlevel 1
									if(int(data))
									{
										for(i=0;i<dgmenu.selectedCell.rowIndex;i++)
										{
											if(dgmenu_ac.getItemAt(i).mnmoduleid == int(dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex).mnparent.toString().split('-')[0]) && dgmenu_ac.getItemAt(i).mnid == int(dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex).mnparent.toString().split('-')[1]))
											{
												dgmenu_ac.getItemAt(i).c = true;
												o = dgmenu_ac.getItemAt(i);
												for(j = 1; j<=13;j++)
												{
													o[Object(dataField+j)] = int(data);
												}
												dgmenu_ac.setItemAt(o, i);
												break;
											}
										}
									}
									else
									{
										variabelvalidasi = true;
										for(i=0;i<dgmenu_ac.length;i++)
										{
											if(dgmenu_ac.getItemAt(i).mnparent == dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex).mnparent && int(dgmenu_ac.getItemAt(i).c))
											{
												variabelvalidasi = false;
											}
										}
										
										if(variabelvalidasi)
										{
											for(i=0;i<dgmenu.selectedCell.rowIndex;i++)
											{
												if(dgmenu_ac.getItemAt(i).mnmoduleid == int(dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex).mnparent.toString().split('-')[0]) && dgmenu_ac.getItemAt(i).mnid == int(dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex).mnparent.toString().split('-')[1]))
												{
													dgmenu_ac.getItemAt(i).c = false;
													o = dgmenu_ac.getItemAt(i);
													for(j = 1; j<=13;j++)
													{
														o[Object(dataField+j)] = int(data);
													}
													dgmenu_ac.setItemAt(o, i);
													break;
												}
											}
										}
									}
								}
							}
							else
							{
								if(ob.mnlevel == 0)
									for(i=dgmenu.selectedCell.rowIndex+1;i<dgmenu_ac.length;i++){
										o = dgmenu_ac.getItemAt(i)
										if(o.mnlevel == 0)break;
										o[Object(dataField)] = int(data);
										dgmenu_ac.setItemAt(o, i);
									}
								else if(ob.mnlevel == 1)
									for(i=dgmenu.selectedCell.rowIndex+1;i<dgmenu_ac.length;i++){
										o = dgmenu_ac.getItemAt(i)
										if(o.mnlevel != 2)break;
										o[Object(dataField)] = int(data);
										dgmenu_ac.setItemAt(o, i);
									}
								else if(ob.mnlevel == 2 && dataField != "f"){
									if(dgmenu_ac.getItemAt(dgmenu.selectedCell.rowIndex)[dataField] == 0){
										var bol:Boolean, idx:int;
										// get index level 1
										for(i=dgmenu.selectedCell.rowIndex;i>=0;i--){
											o = dgmenu_ac.getItemAt(i);
											if(o.mnlevel == 1 && o.mnmoduleid == dgmenu.dataProvider[dgmenu.selectedCell.rowIndex].mnmoduleid){
												idx = i;
												break;
											}
										}
										bol = true;
										// check checkbox level 2 masih ada yg tercentang atau tidak
										for(i=(i+1);i<dgmenu_ac.length;i++){
											o = dgmenu_ac.getItemAt(i);
											// hentikan looping dan set var kondisi jadi false ketika ketemu yg tercentang bernilai 1
											if(o[dataField] == 1){
												bol = false;
												break;
											}
											// hentikan looping ketika berada di level selain 2
											if(o.mnlevel != 2)break;
										}
										// jika tidak ada yg tercentang maka checkbox level 1 tidak tercentan otomatis
										if(bol){
											dgmenu_ac[idx][dataField] = 0;
											o = dgmenu_ac.getItemAt(idx);
											for(j = 1; j<=13;j++)
												if(o["c"+j] == 1){
													bol = false;
													break;
												}
											if(bol)
												o.c = 0;
										}
									}else
										for(i=dgmenu.selectedCell.rowIndex;i>=0;i--){
											o = dgmenu_ac.getItemAt(i);
											if(o.mnlevel == 1 && o.mnmoduleid == dgmenu.dataProvider[dgmenu.selectedCell.rowIndex].mnmoduleid){
												o[dataField] = 1;
												dgmenu_ac.setItemAt(o, i);
												break;
											}
										}
								}
							}
						}
						// Report
						else if(tab.selectedIndex == 1)
						{
							ob = dgreport.dataProvider.getItemAt(dgreport.selectedCell.rowIndex);
							if(ob.mnlevel == 0)
								for(i=dgreport.selectedCell.rowIndex+1;i<dgreport.dataProviderLength;i++){
									o = dgreport.dataProvider.getItemAt(i)
									if(o.mnlevel == 0)break;
									o.c = int(data);
									dgreport.dataProvider.setItemAt(o, i);
								}
							if(ob.mnlevel == 2)
								for(i=dgreport.selectedCell.rowIndex+1;i<dgreport.dataProviderLength;i++){
									o = dgreport.dataProvider.getItemAt(i)
									if(o.mnlevel != 3)break;
									o.c = int(data);
									dgreport.dataProvider.setItemAt(o, i);
								}
						}
						break;
				}
			}
			
			public function f_wsHasil():void
			{
				var j:int, r:Object = {};
				if(p.wsSuccess)
					switch(p.subject)
					{
						case "rickategoribarang":
							dgkategoribarang.dataProvider[dgkategoribarang.selectedCell.rowIndex].rickategoribarang = parentApplication.wsArrUtama.getItemAt(0).ickode;
							dgkategoribarang.dataProvider[dgkategoribarang.selectedCell.rowIndex].icnama = parentApplication.wsArrUtama.getItemAt(0).icnama;
							break;
						case "tampil": 
							r.content = p.vArrResult[2].split('Θ');
							r.nama = p.vArrResult[3].split('Θ');
							p.wsArrUtama = p.f_SplitData(r.nama[0], r.content[0]);
							for(i=0;i<p.wsArrUtama.length;i++)
								with(p.wsArrUtama.getItemAt(i))
								{
									if(mnlevel == 1)
										dgmenu_ac.addItem({mnparent:mnparent, mnmoduleid:mnmoduleid, f_visible:1, c1_visible:1, c2_visible:1, c3_visible:1, c4_visible:1, c5_visible:1, c6_visible:1, c7_visible:1, c8_visible:1, c9_visible:1, c10_visible:1, c11_visible:1, c12_visible:1, c13_visible:1, mnid:mnid, mnlevel:mnlevel, mnname:"     "+mnname});
									else if(mnlevel == 2)
										dgmenu_ac.addItem({mnparent:mnparent, mnmoduleid:mnmoduleid, f_visible:1, c1_visible:1, c2_visible:1, c3_visible:1, c4_visible:1, c5_visible:1, c6_visible:1, c7_visible:1, c8_visible:1, c9_visible:1, c10_visible:1, c11_visible:1, c12_visible:1, c13_visible:1, mnid:mnid, mnlevel:mnlevel, mnname:"          "+mnname});
									else
										dgmenu_ac.addItem({mnparent:mnparent, mnmoduleid:mnmoduleid, f_visible:0, c1_visible:0, c2_visible:0, c3_visible:0, c4_visible:0, c5_visible:0, c6_visible:0, c7_visible:0, c8_visible:0, c9_visible:0, c10_visible:0, c11_visible:0, c12_visible:0, c13_visible:0,  mnid:mnid, mnlevel:mnlevel, mnname:mnname});
								}

							p.wsArrUtama = p.f_SplitData(r.nama[1], r.content[1]);
							dgreport.dataProvider = p.wsArrUtama;
							for(i=0;i<dgreport.dataProviderLength;i++){
								with(dgreport.dataProvider.getItemAt(i))
									if(mnlevel == 2)
										rreportname = "     "+rreportname;
									else if(mnlevel == 3)
										rreportname = "          "+rreportname;
								dgreport.dataProvider[i].c = 0;
							}
						
							p.wsArrUtama = p.f_SplitData(r.nama[2], r.content[2]);
							dgcustom.dataProvider = p.wsArrUtama;
							f_refreshForm();
							break;
						case "simpan":
							p.subject = 'tampil';
							p.m[p.idmodcurr].child.f_wsHasil();
							FlexGlobals.topLevelApplication.closeFormPopUp();
							break;
						case "getdata":
							txtkode.text = p.wsArrUtama.getItemAt(0).rkode;
							txtnama.text = p.wsArrUtama.getItemAt(0).rnama;
							
							// Get Data Menu
							p.wsArrUtama = p.f_SplitData(p.vNamaKolom[1], p.vData[1]);
							j = 0;
							for(i=0;i<p.wsArrUtama.length;i++){
								o = p.wsArrUtama.getItemAt(i);
								for(j=0;j<dgmenu_ac.length;j++){
									ob = dgmenu_ac.getItemAt(j);
									if(o.rmmoduleid == ob.mnmoduleid && o.rmmenuid == ob.mnid){
										ob.rmrole = o.rmrole;
										ob.f = int(o.rmfavourite);
										o = o.rmakses;
										ob.c1 = int(o.slice(0, 1));
										ob.c2 = int(o.slice(1, 2));
										ob.c3 = int(o.slice(2, 3));
										ob.c4 = int(o.slice(3, 4));
										ob.c5 = int(o.slice(4, 5));
										ob.c6 = int(o.slice(5, 6));
										ob.c7 = int(o.slice(6, 7));
										ob.c8 = int(o.slice(7, 8));
										ob.c9 = int(o.slice(8, 9));
										ob.c10 = int(o.slice(9, 10));
										ob.c11 = int(o.slice(10, 11));
										ob.c12 = int(o.slice(11, 12));
										ob.c13 = int(o.slice(12, 13));
										dgmenu_ac.setItemAt(dgmenu_ac.getItemAt(j), j);
										break;
									}
								}
							}
							
							// Get Data Report
							p.wsArrUtama = p.f_SplitData(p.vNamaKolom[2], p.vData[2]);
							j = 0;
							for(i=0;i<p.wsArrUtama.length;i++){
								o = p.wsArrUtama.getItemAt(i);
								for(j=0;j<dgreport.dataProviderLength;j++){
									with(dgreport.dataProvider.getItemAt(j))
										if(int(mnlevel) > 2 && int(o.rrmoduleid) == int(mid) && int(o.rrmenuid) == int(mnid) && int(o.rritem) == int(ritem)){
											rmrole = o.rrrole;
											c = int(o.rrakses); 
											dgreport.dataProvider.setItemAt(dgreport.dataProvider.getItemAt(j), j);
											break;
										}
								}
							}
							
							// Get Data Custom
							p.wsArrUtama = p.f_SplitData(p.vNamaKolom[3], p.vData[3]);
							j = 0;
							for(i=0;i<p.wsArrUtama.length;i++){
								o = p.wsArrUtama.getItemAt(i);
								for(j=0;j<dgcustom.dataProviderLength;j++)
									with(dgcustom.dataProvider.getItemAt(j))
										if(o.rcmoduleid == pcmodule && o.rcidpc == pcid){
											rmrole = o.rcrole;
											c = int(o.rcakses);
											dgcustom.dataProvider.setItemAt(dgcustom.dataProvider.getItemAt(j), j);
											break;
										}
							}
							
							// Get Data Kategori Barang
							dgkategoribarang.dataProvider = p.f_SplitData(p.vNamaKolom[4], p.vData[4]);
							
							if(dgkategoribarang.dataProviderLength == 0)
							{
								parentApplication.F_acAdd(dgkategoribarang);
								dgkategoribarang.setSelectedCell(0, 0);
							}
							
							isUpdate = true;
							txtkode.enabled = false;
							grpBusy.visible = false;
							break;
					}
				else
					switch(p.subject){
						case "tampil":
							dgmenu_ac.removeAll();
							Alert.show(p.wsErrmessage);
							break;
						case "tampilreport":
							dgreport.dataProvider.removeAll();
							Alert.show(p.wsErrmessage);
							break;
						case "tampilcustom":
							dgcustom.dataProvider.removeAll();
							Alert.show(p.wsErrmessage);
							break;
						case "simpan":
							Alert.show(p.wsErrmessage);
							break;
						case "getdata":
							Alert.show(p.wsErrmessage);
							break;
					}
			}
			
			protected function f_kondisiAwal():void
			{
				txtkode.setFocus();
				for(i=0;i<dgmenu_ac.length;i++)
					with(dgmenu_ac.getItemAt(i)){
						rmrole = 0; c1 = false; c2 = false; c3 = false; c4 = false; c5 = false; c6 = false; c7 = false; c8 = false; c9 = false; c10 = false; c11 = false; c12 = false; c13 = false;
					}
				for(i=0;i<dgreport.dataProviderLength;i++)
					with(dgreport.dataProvider.getItemAt(i)){
						rrrole = 0; c = false; 
					}
				for(i=0;i<dgcustom.dataProviderLength;i++)
					with(dgcustom.dataProvider.getItemAt(i)){
						rcrole = 0; c = false;
					}
				dgmenu_ac.refresh();
				p.F_dgRefresh(dgreport);
				p.F_dgRefresh(dgcustom);
				if(p.FormFilter == '@'){
					o = p.m[p.idmodcurr].child;
					FlexGlobals.topLevelApplication.F_wsGetDataById('getdata', 'M0_RoleGetdataById', o.dg.dataProvider.getItemAt(o.dg.selectedIndex).rkode);
				}else
					grpBusy.visible = false;
				dgmenu.setFocus();
				dgmenu_lock.setSelectedCell(0, 0);
				dgmenu.setSelectedCell(0, 0);
				dgreport.setSelectedCell(0, 0);
				dgcustom.setSelectedCell(0, 0);
			}
			
			public function f_property(dataField:String, data:Boolean, info:String = ''):void
			{
			}
			
			public function f_refreshForm():void
			{
				var tmr:Timer, tmr2:Timer, tmr3:Timer, max:int = dgmenu.scroller.verticalScrollBar.maximum, max2:int = dgreport.scroller.verticalScrollBar.maximum, max3:int = dgcustom.scroller.verticalScrollBar.maximum;
				tmr = new Timer(1, (max/400)+3);
				tmr.addEventListener(TimerEvent.TIMER, function(event:TimerEvent):void{
					dgmenu_lock.scroller.verticalScrollBar.value = event.target.currentCount*400;
					dgmenu_lock.scroller.verticalScrollBar.validateNow();
					dgmenu.scroller.verticalScrollBar.value = event.target.currentCount*400;
					dgmenu.scroller.verticalScrollBar.validateNow();
				});	
				tmr.addEventListener(TimerEvent.TIMER_COMPLETE, function(event:TimerEvent):void{
					dgmenu_lock.scroller.verticalScrollBar.value = dgmenu_lock.scroller.verticalScrollBar.maximum;
					dgmenu_lock.scroller.verticalScrollBar.validateNow();
					dgmenu.scroller.verticalScrollBar.value = 0;
					dgmenu.scroller.verticalScrollBar.validateNow();
					dgmenu_lock.scroller.verticalScrollBar.value = 0;
					dgmenu_lock.scroller.verticalScrollBar.validateNow();
					tmr2.start(); 
				});
				tmr2 = new Timer(1, (max2/400)+3);
				tmr2.addEventListener(TimerEvent.TIMER, function(event:TimerEvent):void{
					dgreport.scroller.verticalScrollBar.value = event.target.currentCount*400;
					dgreport.scroller.verticalScrollBar.validateNow();
				});	
				tmr2.addEventListener(TimerEvent.TIMER_COMPLETE, function(event:TimerEvent):void{
					dgreport.scroller.verticalScrollBar.value = 0;
					dgreport.scroller.verticalScrollBar.validateNow();
					tmr3.start();
				});
				tmr3 = new Timer(1, (max3/400)+3);
				tmr3.addEventListener(TimerEvent.TIMER, function(event:TimerEvent):void{
					dgcustom.scroller.verticalScrollBar.value = event.target.currentCount*400;
					dgcustom.scroller.verticalScrollBar.validateNow();
				});	
				tmr3.addEventListener(TimerEvent.TIMER_COMPLETE, function(event:TimerEvent):void{
					dgcustom.scroller.verticalScrollBar.value = 0;
					f_kondisiAwal();
				});
				tmr.start();
			}
			
