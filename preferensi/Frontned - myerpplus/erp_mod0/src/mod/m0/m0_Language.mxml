<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%"
		  creationComplete="f_persiapan();">
	<fx:Script>
		<![CDATA[
			import itemRenderer.ir_country;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.ListEvent;
			import mx.events.MenuEvent;
			
			import spark.components.Button;
			import spark.components.CheckBox;
			import spark.components.ComboBox;
			import spark.components.Image;
			import spark.components.supportClasses.ItemRenderer;
			import spark.events.GridEvent;
			import spark.events.GridItemEditorEvent;
			import spark.events.IndexChangeEvent;
			
			[Bindable] [Embed(source="assets/tb/preview.png")]  public var tbpreview:Class;
			[Bindable] [Embed(source="assets/tb/add.png")]  public var tbadd:Class;
			[Bindable] [Embed(source="assets/tb/edit.png")]  public var tbedit:Class;
			[Bindable] [Embed(source="assets/tb/delete.png")]  public var tbdelete:Class;
			[Bindable] [Embed(source="assets/tb/save.png")]  public var tbsave:Class;
			[Bindable] [Embed(source="assets/main/translate.png")]  public var tbtranslate:Class; //Translate
			
			protected var o:Object, i:int, img:Image;
			
			protected function f_persiapan():void
			{
				dg.dataProvider = new ArrayCollection;
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbTambah);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_edit);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_hapus);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbConfig);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbConfigGlobal);
				FlexGlobals.topLevelApplication.F_RegGrid(0, 6, [dg]);

				function f_mbTampilkan():void
				{
					if(parentApplication.apaBisaAkses(0, 6, 4))
						parentApplication.F_wsSearch('tampil', 'M0_LanguageSearch', 0, 0, '', 'lnama');
				}
				
				function f_mbTambah():void
				{
					if(parentApplication.apaBisaAkses(0, 6, 1))
						parentApplication.openFormX(parentApplication.l('Tambah Bahasa'), 1, 'mod/m0/m0_LanguageAdd.swf', 110, 200, 't4');				
				}
				
				function f_mbConfig():void
				{
					if(parentApplication.apaBisaAkses(0, 6, 2))
						if(dg.selectedIndex >= 0)
							FlexGlobals.topLevelApplication.openFormX(parentApplication.l('Terjemah berdasarkan Negara')+' ('+dg.dataProvider.getItemAt(dg.selectedIndex).lnama+')', 1, 'mod/m0/m0_LanguageConfig.swf', 600, 500, 't4', dg.dataProvider.getItemAt(dg.selectedIndex).lnama);	
						else
							Alert.show(parentApplication.l('Pilih data dahulu !'), parentApplication.l('Validasi'));
				}
				
				function f_mbConfigGlobal():void
				{
					if(parentApplication.apaBisaAkses(0, 6, 2))
						parentApplication.openFormX(parentApplication.l('Terjemah berdasarkan Subject'), 1, 'mod/m0/m0_LanguageConfigGlobal.swf', 600, 800, 't4');	
				}
				
				function f_edit():void
				{
					if(parentApplication.apaBisaAkses(0, 6, 2))
						if(dg.selectedIndex >= 0)
							parentApplication.openFormX(parentApplication.l('Edit Bahasa'), 1, 'mod/m0/m0_LanguageAdd.swf', 110, 230, 't4', '@');	
						else
							Alert.show(parentApplication.l('Pilih data dahulu !'), parentApplication.l('Validasi'));
				}
				function f_hapus():void
				{			
					if(FlexGlobals.topLevelApplication.apaBisaAkses(0, 6, 3))
						if(dg.selectedIndex >= 0)
							parentApplication.F_wsDelete('tampil', 'M0_LanguageDelete', parentApplication.userid, dg.dataProvider.getItemAt(dg.selectedIndex).lkode);
						else
							Alert.show(parentApplication.l('Pilih data dahulu !'), parentApplication.l('Validasi'));
				}
			}
			
			public function f_wsHasil():void
			{
				if(parentApplication.subject == 'tampil'){
					dg.dataProvider.removeAll();
					if(parentApplication.wsSuccess )
						for(i=0;i<parentApplication.wsArrUtama.length;i++){
							o = parentApplication.wsArrUtama.getItemAt(i);
							if(o.lgambar != '')
								dg.dataProvider.addItem({lkode:o.lkode, lnama:o.lnama, lkode_source:parentApplication.m.url+'/files/f0/language/'+o.lgambar, laktif:o.laktif});
							else
								dg.dataProvider.addItem({lkode:o.lkode, lnama:o.lnama, lkode_source:'', laktif:o.laktif});
						}
					parentApplication.F_dgRefresh(dg);
				}else if(parentApplication.subject == 'generate'){
					if(FlexGlobals.topLevelApplication.wsSuccess == false)
						Alert.show(FlexGlobals.topLevelApplication.wsErrmessage, parentApplication.l('Validasi'));
				}
			}
			
			protected function dg_doubleClickHandler(event:MouseEvent):void
			{
				if(parentApplication.apaBisaAkses(0, 6, 2))
					if(dg.selectedIndex >= 0)
						parentApplication.openFormX('Edit Bahasa', 1, 'mod/m0/m0_LanguageAdd.swf', 110, 230, 't4', '@');		
					else
						Alert.show(parentApplication.l('Pilih data dahulu !'), parentApplication.l('Validasi'));
			} 
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="xmlListColl">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Tampilkan" icon="tbpreview"/>
					<topmenu label="Tambah" icon="tbadd"/>
					<topmenu label="Edit" icon="tbedit"/>
					<topmenu label="Hapus" icon="tbdelete"/>
					<topmenu label="Terjemah berdasarkan Negara" icon="tbtranslate"/>
					<topmenu label="Terjemah berdasarkan Subject" icon="tbtranslate"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{xmlListColl}" iconField="@icon" labelField="@label"/>
	<s:DataGrid id="dg" top="40" left="10" bottom="10" right="10" doubleClickEnabled="true" doubleClick="dg_doubleClickHandler(event)"/>
</s:Module>