<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" 
		  width="100%" height="100%" creationComplete="f_kondisiAwal()"
		  resize="module1_resizeHandler(event)" 
		  xmlns:comp="comp.*" xmlns:script="script.*">
	
	<fx:Style>
		@namespace s "library://ns.adobe.com/flex/spark";
		@namespace mx "library://ns.adobe.com/flex/mx";
		.myStyle
		{
			fontWeight:bold;
		}
		
		.justify
		{
			justificationRule:auto;
			justificationStyle:auto;
			textJustify:interWord;
		}
		
	</fx:Style>
	
	<fx:Script>
		<![CDATA[
			import comp.LoadImage;
			
			import flash.net.navigateToURL;
			
			import flashx.textLayout.formats.BackgroundColor;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.events.ResizeEvent;
			import mx.rpc.events.FaultEvent;
			import mx.rpc.events.ResultEvent;
			import mx.utils.StringUtil; 
			[Bindable] public var lblW:String = "Warehouse & Inventory";
			
			public function f_kondisiAwal():void
			{				
				var i:int = 0, data:String;
//				this.setStyle("backgroundColor", parentApplication.m.tema.Forms.Form.BackColor);
				a();
				lblTitle.text = FlexGlobals.topLevelApplication.getSetting(0, "company", "Sentence1");
				lblContent.text = FlexGlobals.topLevelApplication.getSetting(0, "company", "Sentence2");
				
				function run(img:LoadImage, id:String):void
				{
					data = FlexGlobals.topLevelApplication.getSetting(0,'company', id);
					if(data.indexOf("http") >= 0)
					{
						img.source = data; 
					}
					else
					{
						img.source =  FlexGlobals.topLevelApplication.getSetting(0,'company', id);
					}
					img.validateNow();
				}
				
				function a():void
				{
					if(i == 0)
					{
						run(img1, 'Picture1'); 
					}
					else if(i == 1)
					{
						run(imgF, 'Picture3');
					}
					else return;
					i++;
					a();
				}
			}
			
			protected function module1_resizeHandler(event:ResizeEvent):void
			{
				lblContent.width = this.width-220;
				lblContent2.width = this.width-220;
			}
			
			protected function lbltour_clickHandler(event:MouseEvent):void
			{
				var urlRequest:URLRequest = new URLRequest(parentApplication.m.url+"/bi");
				navigateToURL(urlRequest);
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
	</fx:Declarations>
	<s:BorderContainer id="bcleft" left="0" right="190" height="100%" borderColor="#FFFFFF">
		<comp:LoadImage id="img1" x="0" y="0" width="100%" height="260"/>
		<mx:VBox id="vbx" left="10" right="10" top="320" horizontalGap="2" verticalAlign="middle" >
			<s:Label id="lblContent" left="0" right="0" top="0" color="#686464"
					 fontFamily="Verdana" fontSize="12" fontWeight="normal" textAlign="left"
					 verticalAlign="top"/>
			<s:Label />
			<s:Label id="lblContent2" left="0" right="0" top="0" color="#686464"
					 fontFamily="Verdana" fontSize="12" fontWeight="normal" 
					 textAlign="left" verticalAlign="top"/>
		</mx:VBox>
		<s:Label id="lblTitle" left="10" top="270" width="100%" height="42" color="#2B92F1"
				 fontFamily="Verdana" fontSize="25" textAlign="left" textDecoration="underline"
				 verticalAlign="middle"/>
		<s:Label id="lbltour" left="10" bottom="76" width="210" height="40" backgroundAlpha="1.0"
				 backgroundColor="#FEA43A" click="lbltour_clickHandler(event)" color="#FFFFFF"
				 fontSize="20" fontWeight="normal" paddingLeft="0" styleName="myStyle"
				 text="Business Intelligence" textAlign="center" verticalAlign="middle"
				 buttonMode="true" useHandCursor="true"/>
	</s:BorderContainer>
	<s:BorderContainer id="bcright" y="0" right="0" width="190" borderColor="#FFFFFF">
		<comp:LoadImage id="imgF" left="2" right="2" top="2" bottom="2"/>
	</s:BorderContainer>
</s:Module>