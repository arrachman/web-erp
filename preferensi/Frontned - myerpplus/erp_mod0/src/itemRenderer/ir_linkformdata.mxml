<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.events.FlexEvent;
			override public function prepare(hasBeenRecycled:Boolean):void {
				if(data != null)
					lblData.text = data[column.dataField];
			}
			
			protected function lblData_clickHandler(event:MouseEvent):void
			{
				var o:Object = parentApplication[parentApplication.idmod].child;
				var id:int = o.dg.dataProvider.getItemAt(o.dg.selectedCell.rowIndex)[Object(o.arr[6].toLowerCase()+"id")];
				if(o.arr[8] == 2 || o.arr[8] == 3)id = o.f_var('paramFormTransaksi');
				if(parentApplication.apaBisaAkses(o.arr[8], o.arr[9], 4) )
					parentApplication.openFormX(o.arr[2], 0, o.arr[3], 100, 100, "t2", id, null, 1);
			}
			
		]]>
	</fx:Script>
	<s:Label id="lblData" top="9" left="7" color='#009ad4' rollOver="setStyle('textDecoration','underline')" rollOut="setStyle('textDecoration','none')" useHandCursor="true" buttonMode="true" mouseChildren="false" click="lblData_clickHandler(event)"/>
</s:GridItemRenderer>