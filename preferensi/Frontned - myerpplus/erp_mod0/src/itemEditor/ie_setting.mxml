<?xml version="1.0" encoding="utf-8"?>	
<s:GridItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.formatters.NumberFormatter;
			
			override public function set value(newValue:Object):void 
			{
				ns.text = newValue as String;
				ns.text = ns.text.split(".").join("");
				if(data.sjenisinputan=="c")
				{
					ns.visible=false;
					var arrD:ArrayCollection = new ArrayCollection;
					var ss:String = data.scombodata;
					var sss:String;
					var arSS:Array = ss.split("|");
					var arSSs:Array;
					var i:int;
					var x:int=arSS.length;
					for(i=0;i<x;i++)
					{
						sss = arSS[i];
						arSSs = sss.split(";");
						arrD.addItem({nilai:arSSs[1]});
					}
					cns.dataProvider = arrD;
					cns.selectedIndex = 0;
//					Alert.show(arSS.length.toString());
				}
				else if(data.sjenisinputan=="t")
				{
					cns.visible=false;
				}
			}
			
			override public function get value():Object 
			{
//				var Arr:Array = ns.text.split(",");
//				var nf:spark.formatters.NumberFormatter = new spark.formatters.NumberFormatter;
//				nf.groupingSeparator = ".";
//				nf.fractionalDigits = 0;
//				ns.text = nf.format(Arr[0]);
//				if(Arr.length == 2 )
//				{
//					ns.text = ns.text + "," + Arr[1];	
//				}
				var hasil:String;
				if (ns.visible==true)
				{
					hasil = ns.text;
				}
				if(cns.visible==true)
				{
					hasil = cns.textInput.text;
				}
				return hasil;
			}
			
			override public function setFocus():void 
			{
				if(ns.visible==true)
				{
					ns.setFocus();	
				}
				if(cns.visible==true)
				{
					cns.setFocus();
				}
			}
			
			protected function ns_creationCompleteHandler(event:FlexEvent):void
			{
//				ns.restrict = ",0-9";
//				ns.maxChars = 10;
			}
			
			
			
		]]>
	</fx:Script>
	
	<s:TextInput id="ns" width="100%" height="100%" creationComplete="ns_creationCompleteHandler(event)" />
	<s:ComboBox id="cns" width="100%" height="100%" labelField="nilai"/>
</s:GridItemEditor>
