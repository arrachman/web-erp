<?xml version="1.0" encoding="utf-8"?>	
<s:GridItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009"
				  xmlns:s="library://ns.adobe.com/flex/spark"
				  xmlns:mx="library://ns.adobe.com/flex/mx"
				  clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.FlexEvent;
			
			import spark.formatters.NumberFormatter;
			
			override public function set value(newValue:Object):void 
			{
				cbx.selected =  Boolean(newValue as int);
			}
			
			override public function get value():Object 
			{
				return int(cbx.selected);
			}
			
			override public function setFocus():void 
			{
				cbx.setFocus();
			}
			
			protected function cbx_clickHandler():void
			{
				data[column.dataField] = int(cbx.selected);
				parentApplication.F_setProperty('checkBox', column.dataField, cbx.selected);
			}
			
			protected function griditemrenderer1_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode && Keyboard.SPACE){
					if(cbx.selected )
						data[column.dataField] = 0;
					else
						data[column.dataField] = 1;
				}
			}
			
			protected function cbx_creationCompleteHandler(event:FlexEvent):void
			{
				cbx.left = (this.width - 12)/2;
				
				if(data != null){
					if(data[column.dataField] == undefined){
						data[column.dataField] = 0;
						cbx.selected = false;
					}
					cbx.selected = Boolean(data[column.dataField]);
					if(data[column.dataField+'_enabled'] != undefined && data[column.dataField+'_enabled'] != null){
						cbx.enabled = Boolean(int(data[column.dataField+'_enabled']));
					}
				}
			}
			
		]]>
	</fx:Script>
	<s:CheckBox id="cbx" top="4" useHandCursor="true" buttonMode="true" mouseChildren="false" creationComplete="cbx_creationCompleteHandler(event)" click="cbx_clickHandler()"/>
</s:GridItemEditor>
