<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:net="flash.net.*"
		  width="100%" height="100%"
		  creationComplete="f_persiapan()">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			
			import org.hamcrest.mxml.object.Null;
			
			import spark.components.DataGrid;
			import spark.components.Image;
			import spark.events.GridSelectionEvent;
			import spark.events.IndexChangeEvent;
			//serial
			public var img:Image;
			public var o:Object = {};
			public var obj:Object = {}, n:Object = {};
			public function f_focusOnMe():void
			{
				dttgl1.setFocus();
			}
			protected function f_persiapan():void
			{
				parentApplication.F_DateFieldStandard([dttgl1, dttgl2]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtsumber]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi1, txtnotransaksi2]);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, simpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_reset);
				function simpan():void{
					f_simpan();
				}
				function f_reset():void{f_kondisiAwal();}
				
				f_kondisiAwal();
				
			}
			public function f_kondisiAwal():void{
				f_focusOnMe();
				FlexGlobals.topLevelApplication.F_SetNilaiText([dttgl1, dttgl2], FlexGlobals.topLevelApplication.DefaultTanggal);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtsumber, txtnotransaksi1, txtnotransaksi2]);
				chktdkjurnal.selected = false;	
				chkhpp.selected = false;
				chkhitunghpp.selected = false;
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String;
				FlexGlobals.topLevelApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					a = [FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text), FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text),
						txtsumber.text, txtnotransaksi1.text, txtnotransaksi2.text, int(chktdkjurnal), int(chkhpp), int(chkhitunghpp)];
					utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
					FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M0_JournalUlang", FlexGlobals.topLevelApplication.userid, false, utama);
				}
			}
			
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String = '';
				
				switch(target){
					case 'txtsumber':
						paket = 'CdM0_Nomor';
						wsfilter = 'transaksifa = 1 and kodetabel ="'+txtsumber.text+'"';
						csfilter = 'transaksifa = 1';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
			}
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				var ob : Object;
				if(FlexGlobals.topLevelApplication.wsSuccess == true){
					ws = FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtsumber':
							txtsumber.text = ws.kodetabel;
							break;
						case 'simpan':
							f_kondisiAwal();
							Alert.show("Success", "Information");
							break;
					}
				}
				
				else{
						switch(s){	
							case 'txtsumber':
								FlexGlobals.topLevelApplication.F_popUpCari('txtsumber');
								break;
							case 'simpan':
								Alert.show(FlexGlobals.topLevelApplication.wsErrmessage);
								break;
					}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtsumber':FlexGlobals.topLevelApplication.F_KosongkanText([txtsumber]);break;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch(components){
				}
			}
		
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/reset.png")] public var tbreset:Class;
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:XMLListCollection id="xmlListColl">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Hitung" icon="tbsave" enabled="true"/>
					<topmenu label="Reset" icon="tbreset" enabled="true"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>	
	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{xmlListColl}" iconField="@icon" labelField="@label"/>
	<s:Group left="0" top="30">
		<mx:DateField id="dttgl1" x="89" y="8" width="153"/>
		<mx:DateField id="dttgl2" x="270" y="7" width="153" focusIn="dttgl2.text = dttgl1.text"/>
		<s:TextInput id="txtsumber" left="89" top="30" width="128"/>
		<s:TextInput x="89" y="51" id="txtnotransaksi1"/>
		<s:TextInput x="270" y="51" id="txtnotransaksi2" focusIn="txtnotransaksi2.text = txtnotransaksi1.text"/>
		<s:Label x="8" y="12" text="Tanggal&#xd;"/>
		<s:Label x="8" y="35" text="Sumber"/>
		<s:Label x="247" y="57" text="s/d"/>
		<s:Label x="247" y="15" text="s/d"/>
		<s:Label x="8" y="57" text="No Transaksi"/>
		<s:CheckBox x="89" y="78" id="chktdkjurnal" label="Transaksi Tidak Ada Jurnal"/>
		<s:CheckBox x="89" y="102" id="chkhpp" label="Transaksi HPP" change="if(chkhpp.selected == false){chkhitunghpp.selected = false}"/>
		<s:CheckBox x="89" y="125" id="chkhitunghpp" label="Jurnal Hitung Ulang HPP" change="if(chkhitunghpp.selected == true){chkhpp.selected = true}"/>
		
	</s:Group>
</s:Module>
