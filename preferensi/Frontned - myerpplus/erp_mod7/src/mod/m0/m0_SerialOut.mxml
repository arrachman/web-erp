			public var p:Object,o:Object={},ojk:Object;
			[Bindable]private var acterpilih:ArrayCollection=new ArrayCollection();
			//serial
			public var ascGlobal:ArrayCollection=new ArrayCollection();
			public var ascGlobalb:ArrayCollection=new ArrayCollection();
			public var obj:Object = {};
			public var m:String = '', b:String = '';
			public var filtersb:String = '';
			
			private var filterserial:String='s',filterbatch:String='b';
			private function f_cekserial():void{
				filterserial='s';
				//if()
				var bs:int
				dgfserial.dataProvider.removeAll();
				
				for (var i:int=0;i< obj.p[obj.p.o.idgrid].dataProviderLength;i++){
					with(obj.p[obj.p.o.idgrid].dataProvider.getItemAt(i)){
						if(obj.p.o.moduleid == 3 && obj.p.o.mnid == 6){
							jmlbarangsb = jmlkeluar;
						}else if(obj.p.o.moduleid == 5 && obj.p.o.mnid == 8){
							if(obj.p.o.jenismutasi == 1){
								jmlbarangsb = jmlbarangkembali;
							}else{
								jmlbarangsb = jmlbarang;
							}
						}else{
							jmlbarangsb = jmlbarang;
						}
						
						if(bserial == 1 && jmlbarangsb > 0){
							obj.serialada = false;
							for (bs=0; bs<dgfserial.dataProviderLength; bs++)
								if (idbarang == dgfserial.dataProvider.getItemAt(bs).idbarang){
									dgfserial.dataProvider.setItemAt({idbarang:idbarang,kodebarang:kodebarang,jml:Number(Number(dgfserial.dataProvider.getItemAt(bs).jml)+Number(jmlbarangsb)), terpilih:0},bs);
									obj.serialada=true;
									break;
								}
							if (obj.serialada==false){
								dgfserial.dataProvider.addItem({idbarang:idbarang,kodebarang:kodebarang,jml:jmlbarangsb, terpilih:0});
								filterserial = obj.p.fserial;
								
							}
						}
					}
				}
				filterserial=filterserial;
			}
			
			private function f_cekbatch():void{
				filterbatch='b';
				//if()
				var bs:int;
				dgfbatch.dataProvider = new ArrayCollection([{idbarang:0}]);
				dgfbatch.dataProvider.removeAll();
				for(var i:int=0;i< obj.p[obj.p.o.idgrid].dataProviderLength;i++){
					with(obj.p[obj.p.o.idgrid].dataProvider.getItemAt(i)){
						if(obj.p.o.moduleid == 3 && obj.p.o.mnid == 6){
							jmlbarangsb = jmlkeluar;
						}else if(obj.p.o.moduleid == 5 && obj.p.o.mnid == 8){
							if(obj.p.o.jenismutasi == 1){
								jmlbarangsb = jmlbarangkembali;
							}else{
								jmlbarangsb = jmlbarang;
							}
						}else{
							jmlbarangsb = jmlbarang;
						}
						
						if(bbatch == 1 && jmlbarangsb > 0){
							obj.batchada = false;
							for (bs=0; bs<dgfbatch.dataProviderLength; bs++)
							{
								if(idbarang == dgfbatch.dataProvider.getItemAt(bs).idbarang){
									dgfbatch.dataProvider.setItemAt({idbarang:idbarang,kodebarang:kodebarang,jml:Number(Number(dgfbatch.dataProvider.getItemAt(bs).jml)+Number(jmlbarangsb)), terpilih:0},bs);
									obj.batchada=true;
									break;
								}
							}
								
							if (obj.batchada==false)
							{
								dgfbatch.dataProvider.addItem({idbarang:idbarang,kodebarang:kodebarang,jml:jmlbarangsb, terpilih:0});
								filterbatch = obj.p.fbatch;
							}
						}
					}
				}
				
				filterbatch=filterbatch;
			}
			
			protected function f_persiapan():void
			{
				obj.p = FlexGlobals.topLevelApplication.m[parentApplication.idmodcurr].child;
				p=parentApplication;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab1);
				FlexGlobals.topLevelApplication.F_RegGrid(0,7,[dgfbatch, dgfserial]);
				FlexGlobals.topLevelApplication.F_RegGrid(0,7,[dgbatch, dgserial], 'transaksi');
				dgfserial.dataProvider = p.m[p.idmodcurr].child.acserial;
				dgfbatch.dataProvider = p.m[p.idmodcurr].child.acbatch;
			
				obj.serial = false; obj.batch = false;
				for (var i:int=0;i< obj.p[obj.p.o.idgrid].dataProviderLength;i++){
					if(obj.p[obj.p.o.idgrid].dataProvider[i].bserial == 1){
						obj.serial = true;
					}
					if(obj.p[obj.p.o.idgrid].dataProvider[i].bbatch == 1){
						obj.batch = true;
					}
					
				}
				
				if(obj.serial == true){
					f_cekserial();
				}else{
					dgfserial.dataProvider.removeAll();
				}
				
				if(obj.batch == true){
					f_cekbatch();
				}else{
					dgfbatch.dataProvider.removeAll();
				}
				
				
					
				if(dgfserial.dataProviderLength > 0)dgfserial.selectedIndex = 0;
				if(dgfbatch.dataProviderLength > 0)dgfbatch.selectedIndex = 0;
				
				
				
				if(obj.p.o.aserial.length > 0 || obj.p.o.abatch.length > 0){
					var s:String, b:String;
					if(obj.p.o.aserial.length > 0){
						//untuk filter serial yang sudah ada ketika edit
						for(i=0;i<obj.p.o.aserial.length;i++){
								if(i==0){
									s = 'nsiidserialin <> '+obj.p.o.aserial[i].nstidserialin+'';
								}else{
									s+= ' and nsiidserialin <>'+obj.p.o.aserial[i].nstidserialin+'';
								}
						}
						s = "("+s+")";
						filterserial = "("+filterserial+") AND "+s; 
					}
					
					
					
					if(obj.p.o.abatch.length > 0){
						var idbarang: int = 0;
						//untuk filter batch yang sudah ada ketika edit
						for(i=0;i<obj.p.o.abatch.length;i++){
							if(i==0){
								b = 'nbiidbatchin <> '+obj.p.o.abatch[i].nbtidbatchin+'';
							}else{
								b+= ' and nbiidbatchin <>'+obj.p.o.abatch[i].nbtidbatchin+'';
							}
						}	
						b = "("+b+")";
						filterbatch = "("+filterbatch+") AND "+b;  
					}
				}
				if(obj.p.o.moduleid == 5 && obj.p.o.mnid == 8){
					if(obj.p.o.aseriallawan.length > 0){
						//untuk filter serial yang sudah ada ketika edit
						var sl:String='';
						for(i=0;i<obj.p.o.aseriallawan.length;i++){
							if(i==0){
								sl = 'nsiidserialin <> '+obj.p.o.aseriallawan[i].nstidserialin+'';
							}else{
								sl+= ' and nsiidserialin <>'+obj.p.o.aseriallawan[i].nstidserialin+'';
							}
						}
						sl = "("+sl+")";
						filterserial = filterserial+" AND "+sl; 
					}
				}
				
//				filtersb =  filterbatch + FlexGlobals.topLevelApplication.sptRow + filterserial;
				FlexGlobals.topLevelApplication.F_wsSearch('tampil', 'CdM1_No_BatchSerial_In', 0, 0, filterbatch+FlexGlobals.topLevelApplication.sptRow+filterserial, "nbiidbarang ASC, nbikode ASC"+parentApplication.sptRow+"nsiidbarang ASC, nsikode ASC");
//				FlexGlobals.topLevelApplication.F_wsSearch('tampil', 'CdM1_No_BatchSerial_In', 0, 0, filter, parentApplication.sptRow)
				
				f_pilih()
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_simpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_close);
				function f_simpan():void{
					f_simpanserial();
					f_simpanbatch();
					if(dgserial.dataProviderLength > 0){
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgserial);
					}
					if(dgbatch.dataProviderLength > 0){
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgbatch);
					}
					if(obj.simpanserial == true && obj.simpanbatch == true){
						FlexGlobals.topLevelApplication.closeFormPopUp(1);
					}else{
						Alert.show("Jumlah Barang Serial/ Batch yang dipilih harus sama dengan jumlah transaksi !", "Information");
						filterb();
						
					}
				}
				function f_close():void{
					FlexGlobals.topLevelApplication.closeFormPopUp(1);
				}
			}
			
