							dgserial.dataProvider.addItem({pilih:0, pilih_enabled:1, nsiid:0, nsijenismutasi:0 ,nsiidbarang:nsiidbarang ,nsikode:nsikode ,
								nsisumber:nsisumber ,
								nsiidtransaksi:nsiidtransaksi ,nsisatuan:nsisatuan ,nsijmlmasuk : nsijmlmasuk,
								nsijmlkeluar:nsijmlkeluar ,nsiisclose:nsiisclose ,nsijml:nsijmlkeluar, nsijmlsisa : nsijmlsisa,
								nsicustomtext1:nsicustomtext1 ,nsicustomtext2:nsicustomtext2 ,nsicustomtext3:nsicustomtext3 ,
								nsicustomdbl1:nsicustomdbl1 ,nsicustomdbl2:nsicustomdbl2 ,
								nsicustomdbl3:nsicustomdbl3 ,nsicustomdate1:nsicustomdate1 ,nsicustomdate2:nsicustomdate2 ,
								nsicustomdate3:nsicustomdate3 ,tglexpired:nsicustomdate1, kodebarang:kodebarang, nsigudang : obj.p.o.gudang, 
								nsiidserialin : nsiidserialin});
						}
					}
					
					if(obj.p.o.aserial.length > 0){
						for(i= 0; i<dgserial.dataProviderLength; i++)
							if(dgserial.dataProvider[i].pilih == 0 || dgserial.dataProvider[i].pilih == undefined){
								dgserial.dataProvider[i].pilih_enabled = 0;
								dgserial.dataProvider[i].tglexpired = dgserial.dataProvider[i].nsicustomdate1;
							}
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dgserial);
				}else{
					obj.p.o.aserial.removeAll();
