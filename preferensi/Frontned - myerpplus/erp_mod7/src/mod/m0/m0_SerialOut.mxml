			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				
				
				switch(components){
					case 'checkBoxHeader':
						var dg:DataGrid;
						if(tab1.selectedIndex == 0){
							dg = dgserial;
						}else{
							dg = dgbatch;
						}
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).pilih = data;
						}
						
						f_pilih();
						break;
					case 'checkBox':
						f_pilih();
						break;
				}
			}
			
			protected function f_pilih():void
			{
				//jika tab yang terpilih adalah tab pertama
//				Alert.show(dgfserial.dataProvider[dgfserial.selectedIndex].jml)
				if(tab1.selectedIndex == 0){
					j = 0;
					if(dgfserial.dataProviderLength > 0){
						for(i=0;i<dgserial.dataProviderLength;i++)
							//check box dicentang
							if(dgserial.dataProvider[i].pilih == 1)
								j += Number(dgserial.dataProvider[i].nsijmlsisa)
						//jika jumlah sisa sama dengan jumlah pada 
						if(j == dgfserial.dataProvider[dgfserial.selectedIndex].jml){
							for(i=0;i<dgserial.dataProviderLength;i++){
								if(dgserial.dataProvider[i].pilih == 0)
									dgserial.dataProvider[i].pilih_enabled = 0;
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgserial);
							//break;
						}
							//jika jumlah barang yg dipilih lebih besar dari yg di grid detail, cekboxnya di-disable dan muncul peringatan
						else if(j > dgfserial.dataProvider[dgfserial.selectedIndex].jml){
							for(i=0;i<dgserial.dataProviderLength;i++){
								if(dgserial.dataProvider[i].pilih == 0)
									dgserial.dataProvider[i].pilih_enabled = 0;	
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgserial);
							//						Alert.show("Quantity of serial item shouldn't be more than (Jumlah barang serial tidak boleh lebih dari) : "+dgfserial.dataProvider[dgfserial.selectedIndex].jml+"",'Information');
						}
						
						//jika jumlah barang yg dipilih lebih kecil dari yg di grid detail, cekboxnya di-enabled
						if(j < dgfserial.dataProvider[dgfserial.selectedIndex].jml){
							for(i=0;i<dgserial.dataProviderLength;i++)
								dgserial.dataProvider[i].pilih_enabled = 1;
							FlexGlobals.topLevelApplication.F_dgRefresh(dgserial);
						}
						//menghitung jumlah yang harus dipilih
						dgfserial.dataProvider[dgfserial.selectedIndex].n = Number(dgfserial.dataProvider[dgfserial.selectedIndex].jml) - j;
						dgfserial.validateNow();
						dgfserial.dataProvider[dgfserial.selectedIndex].terpilih = j;
						//lblbarangb.text = "Barang : " + dgfserial.dataProvider[dgfserial.selectedIndex].kodebarang + " ( Pilih : "+dgfserial.dataProvider[dgfserial.selectedIndex].n+" ) ";
						lblbarang.text = "Barang : " + dgfserial.dataProvider[dgfserial.selectedIndex].kodebarang + "";
						lbljumlah.text = "Jumlah : "+ dgfserial.dataProvider[dgfserial.selectedIndex].jml+"";
						lblterpilih.text = "Terpilih : "+dgfserial.dataProvider[dgfserial.selectedIndex].terpilih+"";
					}
					
				}
				
				
				
				//jika tab yang terpilih adalah tab kedua
				else{
					j = 0;
					if(dgfbatch.dataProviderLength > 0){
						for(i=0;i<dgbatch.dataProviderLength;i++)
							//check box dicentang
							if(dgbatch.dataProvider[i].pilih == 1)
								j += Number(dgbatch.dataProvider[i].nbijmlsisa)
						//jika jumlah sisa sama dengan jumlah pada 
						if(j == dgfbatch.dataProvider[dgfbatch.selectedIndex].jml){
							for(i=0;i<dgbatch.dataProviderLength;i++){
								if(dgbatch.dataProvider[i].pilih == 0)
									dgbatch.dataProvider[i].pilih_enabled = 0;
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgbatch);
							//break;
						}
							//jika jumlah barang yg dipilih lebih besar dari yg di grid detail, cekboxnya di-disable dan muncul peringatan
						else if(j > dgfbatch.dataProvider[dgfbatch.selectedIndex].jml){
							for(i=0;i<dgbatch.dataProviderLength;i++){
								if(dgbatch.dataProvider[i].pilih == 0)
									dgbatch.dataProvider[i].pilih_enabled = 0;	
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgbatch);
							//						Alert.show("Quantity of batch item shouldn't be more than (Jumlah barang batch tidak boleh lebih dari) : "+dgfbatch.dataProvider[dgfbatch.selectedIndex].jml+"",'Information');
						}
						
						//jika jumlah barang yg dipilih lebih kecil dari yg di grid detail, cekboxnya di-enabled
						if(j < dgfbatch.dataProvider[dgfbatch.selectedIndex].jml){
							for(i=0;i<dgbatch.dataProviderLength;i++)
								dgbatch.dataProvider[i].pilih_enabled = 1;
							FlexGlobals.topLevelApplication.F_dgRefresh(dgbatch);
						}
						//menghitung jumlah yang harus dipilih
						dgfbatch.dataProvider[dgfbatch.selectedIndex].n = Number(dgfbatch.dataProvider[dgfbatch.selectedIndex].jml) - j;
						dgfbatch.validateNow();
						dgfbatch.dataProvider[dgfbatch.selectedIndex].terpilih = j;
						//lblbarangb.text = "Barang : " + dgfbatch.dataProvider[dgfbatch.selectedIndex].kodebarang + " ( Pilih : "+dgfbatch.dataProvider[dgfbatch.selectedIndex].n+" ) ";
						lblbarangb.text = "Barang : " + dgfbatch.dataProvider[dgfbatch.selectedIndex].kodebarang + "";
						lbljumlahb.text = "Jumlah : "+ dgfbatch.dataProvider[dgfbatch.selectedIndex].jml+"";
						lblterpilihb.text = "Terpilih : "+dgfbatch.dataProvider[dgfbatch.selectedIndex].terpilih+"";
					}
					
				}
				
			}
			
