						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				//--------------------------------------------------------------------------------------------------
			}
			
			public function f_simpanserial():void{
				obj.simpanserial = true;
				f_pilih();
				
				for(i=0;i<dgfserial.dataProviderLength;i++){
					if(Number(dgfserial.dataProvider[i].n) > 0){
						dgfserial.selectedIndex = i;
						dgbserial_selectionChangeHandler();
						obj.simpanserial = false;
						return;
					}else if(Number(dgfserial.dataProvider[i].n) < 0){
						dgfserial.selectedIndex = i;
						dgbserial_selectionChangeHandler();
						obj.simpanserial = false;
					}else{
						obj.simpanserial = true;
					}
				}
				if(obj.simpanserial == true){
					(dgserial.dataProvider as ArrayCollection).filterFunction = null;
					(dgserial.dataProvider as ArrayCollection).refresh();
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgserial);
					obj.p.o.aserial.removeAll();
					for(i = 0; i< dgserial.dataProviderLength; i++){
						with(dgserial.dataProvider[i]){
							if(pilih == 1){
								obj.p.o.aserial.addItem({nstid:0, nstjenismutasi:0 ,nstidbarang:nsiidbarang ,nstkode:nsikode ,nstsumber:FlexGlobals.topLevelApplication.m[parentApplication.idmodcurr].child.o.sumber ,nstidtransaksi:nsiidtransaksi ,nstsatuan:nsisatuan ,nstjmlmasuk:nsijmlmasuk ,nstjml:1 ,
									nstjmlsisa:nsijmlsisa ,nstisclose:nsiisclose ,nstcustomtext1:nsicustomtext1 ,nstcustomtext2:nsicustomtext2 ,nstcustomtext3:nsicustomtext3 ,nstcustomdbl1:nsicustomdbl1 ,nstcustomdbl2:nsicustomdbl2 ,
									nstcustomdbl3:nsicustomdbl3 ,nstcustomdate1:nsicustomdate1 ,nstcustomdate2:nsicustomdate2 ,nstcustomdate3:nsicustomdate3 ,tglexpired:tglexpired, kodebarang:kodebarang,
									nstgudang : obj.p.o.gudang, nstidserialin:nsiidserialin});
								
							}
						}
					}
				}
					
			}
			
			public function f_simpanbatch():void{
				obj.simpanbatch = true;
				f_pilih();
				
				for(i=0;i<dgfbatch.dataProviderLength;i++)
					if(Number(dgfbatch.dataProvider[i].n) > 0){
						dgfbatch.selectedIndex = i;
						dgbbatch_selectionChangeHandler();
						obj.simpanbatch = false;
						return;
					}else if(Number(dgfbatch.dataProvider[i].n) < 0){
						dgfbatch.selectedIndex = i;
						dgbbatch_selectionChangeHandler();
						obj.simpanbatch = false;
					}
					else{
						(dgbatch.dataProvider as ArrayCollection).filterFunction = null;
						(dgbatch.dataProvider as ArrayCollection).refresh();
						obj.p.o.abatch.removeAll();
						for(i = 0; i< dgbatch.dataProviderLength; i++){
							with(dgbatch.dataProvider[i]){
								if(pilih == true){
									obj.p.o.abatch.addItem({nbtid:0, nbtjenismutasi:0 ,nbtidbarang:nbiidbarang ,nbtkode:nbikode ,
										nbtsumber:obj.p.o.sumber ,nbtidtransaksi:nbiidtransaksi ,nbtsatuan:nbisatuan ,
										nbtjmlmasuk:nbijmlmasuk ,nbtjml:nbijmlsisa ,
										nbtjmlsisa:nbijmlsisa ,nbtisclose:nbiisclose ,nbtcustomtext1:nbicustomtext1 ,nbtcustomtext2:nbicustomtext2 ,nbtcustomtext3:nbicustomtext3 ,
										nbtcustomdbl1:nbicustomdbl1 ,nbtcustomdbl2:nbicustomdbl2 ,
										nbtcustomdbl3:nbicustomdbl3 ,nbtcustomdate1:nbicustomdate1 ,nbtcustomdate2:nbicustomdate2 ,nbtcustomdate3:nbicustomdate3,
										tglexpired:tglexpired, kodebarang:kodebarang,
										nbtgudang : obj.p.o.gudang, nbtidbatchin:nbiidbatchin});
									
								}
							}
						}
						
					}
			}
