			public function filter():void{
				(dgserial.dataProvider as ArrayCollection).filterFunction = filterMyArrayCollection;
				(dgserial.dataProvider as ArrayCollection).refresh();
			}
			
			private function filterMyArrayCollection(item:Object):Boolean {
				var searchString:String = dgfserial.dataProvider[dgfserial.selectedIndex].kodebarang;
				var itemName:String = (item.kodebarang as String);
				
				if(itemName == null){
					return false;
				}
				
				return itemName.indexOf(searchString)>-1;
			}
			//END OF SERIAL
			
