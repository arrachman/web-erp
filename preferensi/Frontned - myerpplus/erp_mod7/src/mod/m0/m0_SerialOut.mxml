			{
				filterb();
				if(obj.p.o.abatch.length > 0){
					lblbarangb.text = "Barang : " + dgfbatch.dataProvider[dgfbatch.selectedIndex].kodebarang + "";
					lbljumlahb.text = "Jumlah : "+ dgfbatch.dataProvider[dgfbatch.selectedIndex].jml+"";
					lblterpilihb.text = "Terpilih : "+dgfbatch.dataProvider[dgfbatch.selectedIndex].jml+"";
				}else{
					lblbarangb.text = "Barang : " + dgfbatch.dataProvider[dgfbatch.selectedIndex].kodebarang + "";
					lbljumlahb.text = "Jumlah : "+ dgfbatch.dataProvider[dgfbatch.selectedIndex].jml+"";
					lblterpilihb.text = "Terpilih : "+dgfbatch.dataProvider[dgfbatch.selectedIndex].terpilih+"";
				}
				
			}
			private  function  filterb():void  {
				
				(dgbatch.dataProvider as ArrayCollection).filterFunction = filterMyArrayCollectionb;
				(dgbatch.dataProvider as ArrayCollection).refresh();
			}
			
			private  function  filterMyArrayCollectionb(item:Object):Boolean {
				var searchString:String = "";
				var itemName:String = "";
				
//				if(dgfbatch.selectedCell != null){
					searchString = dgfbatch.dataProvider.getItemAt(dgfbatch.selectedIndex).kodebarang;
					itemName = (item.kodebarang as  String);
//					Alert.show(dgfbatch.dataProvider.getItemAt(dgfbatch.selectedIndex).kodebarang+"  "+itemName);
					if(itemName == null){
						return false;
					}
					
//				}
				return  itemName.indexOf(searchString)>-1;
			}
			
			protected function dgserial_keyDownHandler(event:KeyboardEvent):void
			{
				if(dgserial.columns.getItemAt(dgserial.selectedCell.columnIndex).dataField == 'pilih' && event.keyCode == Keyboard.SPACE)
					if(dgserial.dataProvider[dgserial.selectedCell.rowIndex].pilih_enabled == 1){
						if(dgserial.dataProvider[dgserial.selectedCell.rowIndex].pilih == 0)
							dgserial.dataProvider[dgserial.selectedCell.rowIndex].pilih = 1;
						else
							dgserial.dataProvider[dgserial.selectedCell.rowIndex].pilih = 0;
						f_pilih();
						FlexGlobals.topLevelApplication.F_dgColumnFirst(dgserial, dgserial.selectedCell.rowIndex);
					}
				
			}
			
			protected function dgbatch_keyDownHandler(event:KeyboardEvent):void
			{
				if(dgbatch.columns.getItemAt(dgbatch.selectedCell.columnIndex).dataField == 'pilih' && event.keyCode == Keyboard.SPACE)
					if(dgbatch.dataProvider[dgbatch.selectedCell.rowIndex].pilih_enabled == 1){
						if(dgbatch.dataProvider[dgbatch.selectedCell.rowIndex].pilih == 0)
							dgbatch.dataProvider[dgbatch.selectedCell.rowIndex].pilih = 1;
						else
							dgbatch.dataProvider[dgbatch.selectedCell.rowIndex].pilih = 0;
						f_pilih();
						FlexGlobals.topLevelApplication.F_dgColumnFirst(dgbatch, dgbatch.selectedCell.rowIndex);
					}
			}
			
			
			public function filterdataserial():String{
					var f:String = obj.p.fserial;
						if(txtfilters.text.length > 0){
							f = FlexGlobals.topLevelApplication.TambahFilter(f,'nsikode ="'+txtfilters.text+'"'); 
						}
						for(i=0; i<dgserial.dataProviderLength; i++){
							if(dgserial.dataProvider[i].pilih == 1){
								f = FlexGlobals.topLevelApplication.TambahFilter(f,'nsikode <>"'+dgserial.dataProvider[i].nsikode+'"'); 
							}
						}
				return f;
			}
			
			public function filterdatabatch():String{
				var f:String = obj.p.fbatch;
				if(txtfilterb.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'nbikode ="'+txtfilterb.text+'"'); 
				}
				for(i=0; i<dgbatch.dataProviderLength; i++){
					if(dgbatch.dataProvider[i].pilih == 1){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'nbikode <>"'+dgbatch.dataProvider[i].nbikode+'"'); 
					}
				}
				
				return f;
			}
			
			protected function btntampilkan_clickHandler(event:MouseEvent):void
			{
				var subject:String ='';
				if(tab1.selectedIndex == 0)subject = "TampilSerial";
				else subject = "TampilBatch";
				FlexGlobals.topLevelApplication.F_wsSearch(subject, 'CdM1_No_BatchSerial_In', 0, 0,filterdatabatch()+FlexGlobals.topLevelApplication.sptRow+filterdataserial(), "nbiidbarang ASC, nbikode ASC"+parentApplication.sptRow+"nsiidbarang ASC, nsikode ASC");
			}
			
			public function f_wsHasil():void
			{
				var f:String='',v_myada:Boolean=false;
				p=parentApplication;
				var ws:Object;
				var o:Object, s:String = parentApplication.subject;
				var ob : Object;
				switch(s){
					case 'tampil':
						
						for(i=0;i<dgbatch.dataProviderLength;i++){
							dgbatch.dataProvider[i].pilih = 0;
							dgbatch.dataProvider[i].pilih_enabled = 1;
							dgbatch.dataProvider[i].tglexpired = 0;
						}
						
						f_setbatch();
						f_setserial();
						
						if(dgfbatch.dataProviderLength > 0){
							dgbatch.setSelectedCell(0, 0);
							dgbbatch_selectionChangeHandler();
							if(obj.p.isUpdate == true){
								dgfbatch.dataProvider[dgfbatch.selectedIndex].n = 0
							}
							
						}
						if(dgfserial.dataProviderLength > 0){
							dgfserial.setSelectedCell(0, 0);
							dgbserial_selectionChangeHandler();
							if(obj.p.isUpdate == true){
								dgfserial.dataProvider[dgfserial.selectedIndex].n = 0
								//dgfserial.dataProvider[dgfserial.selectedIndex].terpilih = 0;
							}
						}
						break;
					
					case 'TampilSerial':
						if(dgfserial.dataProviderLength >0){
							for(i = dgserial.dataProviderLength - 1; i>=0; i--){
								if(dgserial.dataProvider[i].pilih == 0 || dgserial.dataProvider[i].pilih == false){
									dgserial.dataProvider.removeItemAt(i);
								}
							}
							
							for(i = 0; i< FlexGlobals.topLevelApplication.wsArrDetail.length; i++){
								ws  = FlexGlobals.topLevelApplication.wsArrDetail[i]
								dgserial.dataProvider.addItem({pilih:0, pilih_enabled:1, nsiid:0, nsijenismutasi:0 ,nsiidbarang:ws.nsiidbarang ,nsikode:ws.nsikode ,
									nsisumber:ws.nsisumber ,
									nsiidtransaksi:ws.nsiidtransaksi ,nsisatuan:ws.nsisatuan ,nsijmlmasuk : ws.nsijmlmasuk,
									nsijmlkeluar: ws.nsijmlkeluar ,nsiisclose: ws.nsiisclose ,nsijml: ws.nsijmlkeluar, nsijmlsisa : ws.nsijmlsisa,
									nsicustomtext1: ws.nsicustomtext1 ,nsicustomtext2: ws.nsicustomtext2 ,nsicustomtext3: ws.nsicustomtext3 ,
									nsicustomdbl1: ws.nsicustomdbl1 ,nsicustomdbl2: ws.nsicustomdbl2 ,
									nsicustomdbl3: ws.nsicustomdbl3 ,nsicustomdate1: ws.nsicustomdate1 ,nsicustomdate2: ws.nsicustomdate2 ,
									nsicustomdate3: ws.nsicustomdate3 ,tglexpired: ws.nsicustomdate1, kodebarang:ws.kodebarang, nsigudang : obj.p.o.gudang, 
									nsiidserialin : ws.nsiidserialin});
								
								
							}
							for(i = 0; i<dgserial.dataProviderLength; i++){
								if(dgfserial.dataProvider[dgfserial.selectedIndex].terpilih == dgfserial.dataProvider[dgfserial.selectedIndex].jml){
									if(dgserial.dataProvider[i].pilih==0){
										dgserial.dataProvider[i].pilih=0; dgserial.dataProvider[i].pilih_enabled=0;
									}
								}
							}
						}
						break;
					
					case 'TampilBatch':
						if(dgfbatch.dataProviderLength > 0){
							for(i = dgbatch.dataProviderLength - 1; i>=0; i--){
								if(dgbatch.dataProvider[i].pilih == 0 || dgbatch.dataProvider[i].pilih == false){
									dgbatch.dataProvider.removeItemAt(i);
								}
							}
							
							for(i = 0; i< FlexGlobals.topLevelApplication.wsArrUtama.length; i++){
								ws  = FlexGlobals.topLevelApplication.wsArrUtama[i]
								dgbatch.dataProvider.addItem({pilih:0, pilih_enabled:1, nbiid:0, nbijenismutasi:0 ,nbiidbarang:ws.nbiidbarang ,nbikode:ws.nbikode ,
									nbisumber:ws.nbisumber, nbiidtransaksi:ws.nbiidtransaksi ,nbisatuan:ws.nbisatuan ,nbijmlmasuk : ws.nbijmlmasuk,
									nbijmlkeluar: ws.nbijmlkeluar ,nbiisclose: ws.nbiisclose ,nbijml: ws.nbijmlkeluar, nbijmlsisa : ws.nbijmlsisa,
									nbicustomtext1: ws.nbicustomtext1 ,nbicustomtext2: ws.nbicustomtext2 ,nbicustomtext3: ws.nbicustomtext3 ,
									nbicustomdbl1: ws.nbicustomdbl1 ,nbicustomdbl2: ws.nbicustomdbl2 ,
									nbicustomdbl3: ws.nbicustomdbl3 ,nbicustomdate1: ws.nbicustomdate1 ,nbicustomdate2: ws.nbicustomdate2 ,
									nbicustomdate3: ws.nbicustomdate3 ,tglexpired: ws.nbicustomdate1, kodebarang:ws.kodebarang, nbigudang : obj.p.o.gudang, 
									nbiidbatchin : ws.nbiidbatchin});
							}
							for(i = 0; i<dgbatch.dataProviderLength; i++){
								if(dgfbatch.dataProvider[dgfbatch.selectedIndex].terpilih == dgfbatch.dataProvider[dgfbatch.selectedIndex].jml){
									if(dgbatch.dataProvider[i].pilih==0){
										dgbatch.dataProvider[i].pilih=0; dgbatch.dataProvider[i].pilih_enabled=0;
									}
								}
							}
						}
						break;
				} 
			}
			
			
			[Bindable] [Embed(source="assets/tb/save.png")] public var tbsave:Class;
			[Bindable] [Embed(source="assets/tb/close.png")] public var tbclose:Class;
			[Bindable] [Embed(source="assets/tb/preview.png")] public var tbpreview:Class;
			
		
			
		]]>
	</fx:Script>
	
