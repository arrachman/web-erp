	<fx:Script> 
		<![CDATA[			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Text;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.CheckBox;
			import spark.components.DataGrid;
			import spark.components.Image;
			
			protected var validasi:Boolean,	vMsg:String, vMsgIng:String, img:Image, i:int,UFungsional:String, vUang:String, vTgl:String, vNotransaksi:String, vDefNotransaksi:String, vPosting:String, nreklawan:String, getNotransaksi:String;
			[Bindable] public var u:ArrayCollection;
			public var tglDB:String  = FlexGlobals.topLevelApplication.DefaultTanggal, isUpdate:Boolean;
			public var o:Object = {}, n:Object = {};
			public var obj:Object = {};
			[Bindable]public var ac_Serial:ArrayCollection = new ArrayCollection();
			[Bindable]public var ac_Batch:ArrayCollection = new ArrayCollection();
			[Bindable]public var ws_Serial:ArrayCollection = new ArrayCollection();
			[Bindable]public var ws_Batch:ArrayCollection = new ArrayCollection();
			[Bindable] public var acmaster:ArrayCollection = new ArrayCollection();
			[Bindable]public var ws_Master:ArrayCollection = new ArrayCollection();
			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				return new ArrayCollection([]);
			}
			
			// mengeset ketika change pada grid =========================================			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBox':																				// mengeset untuk checobox
						if(data == true && dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bhpp == 'I')		// melakukan pencarian ketika klik checkbox maka melakukan pencarian barang HPP khusus
							parentApplication.F_popUpCari('chk_HK');
						break;
					case 'calculator':
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex))
							switch(dataField){
								case 'nilaisatuan':
									jmlbarangmasuk = int(jmlmasuk) * nilaisatuan,
									jmlbarangkeluar = int(jmlkeluar) * nilaisatuan
									break;
								case 'jmlmasuk':
									jmlbarangmasuk = int(jmlmasuk) * nilaisatuan,
									jmlkeluar = 0,
									jmlbarangkeluar = 0
									if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bhpp == "I" && dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).jmlkeluar > 0){
										dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hk_enabled = 1;
									}else{
										dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hk_enabled = 0;
									}
									break;
								case 'jmlkeluar':
									jmlbarangkeluar = int(jmlkeluar) * nilaisatuan,
									jmlmasuk = 0,
									jmlbarangmasuk = 0
									if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).bhpp == "I" && dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).jmlkeluar > 0){
										dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hk_enabled = 1;
									}else{
										dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hk_enabled = 0;
									}
									break;
							}
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						break;
				}
			}
			
			// set fokus ketika pertama kali form diload ===================================
			public function f_focusOnMe():void
			{
				txtbagianpenyesuaian.setFocus();
			}
			
			// set persiapan form ==========================================================
			protected function f_persiapan():void
			{
				parentApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				parentApplication.F_TranslateLabel([tbagpenyesuaian, tgudang, turaian, ttanggal, tnotransaksi, tprogress, tkontakperson, tcatatan, tnoref, ttglnoref]);
				parentApplication.F_RequiredLabel([tgudang, ttanggal, tnotransaksi, tprogress]);
				parentApplication.F_DateFieldStandard([dttgl, dttglnoref]);
				parentApplication.F_ComboBoxStandard([cmbprogress]);
				parentApplication.F_txtpencarian([txtbagianpenyesuaian, txtgudang, txtmatauang]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtcatatan]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				vPosting = parentApplication.getSetting(0, 'accounting', 'AutoPosting');
				tab.tabFocusEnabled = false;
				
				//setting grid=========================================================================================
				FlexGlobals.topLevelApplication.F_RegGrid(7, 66, [dg], 'transaksi');
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M3_IbHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M7_AgGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
				//end of setting grid=========================================================================================
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbLinks);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbHistory);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbBantuan);
				function f_mbSimpan():void
				{
					f_simpan();
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					ac_Batch.removeAll();
					ac_Serial.removeAll();
					f_kondisiAwal();
				}
				function f_mbSerialIn():void {
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(mb.menuBarItems[2].enabled==true){
						o.moduleid = 3; o.mnid = 23; o.agid = u[0].agid; o.sumber = 'IB'; o.idgrid = dg.id;
						FlexGlobals.topLevelApplication.openFormX( "Serial / Batch Number",1,'mod/m0/m0_SerialBatchIn.swf',350,650,'t1');
					}
				}
				function f_mbUpload():void
				{
					if(mb.menuBarItems[3].enabled == true){
						parentApplication.F_OpenUploadFile('IB', o.agid, txtnotransaksi.text);
					}
				}
				function f_mbCatatan():void
				{
					if(mb.menuBarItems[4].enabled == true){
						parentApplication.F_OpenNotes('Ib', o.agid, txtnotransaksi.text);
					}
				}
				function f_mbLinks():void
				{
				}
				function f_mbHistory():void
				{
				}
				function f_mbBantuan():void
				{
				}
				f_kondisiAwal();
			}
			
			protected function f_kondisiAwal():void
			{
				acmaster.removeAll();
				o.txtmatauang = parentApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				isUpdate = false;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				parentApplication.F_SetNilaiText([dttgl, dttglnoref], parentApplication.DefaultTanggal);
				parentApplication.F_SetNilaiText([], 0);
				parentApplication.F_KosongkanText([txtbagianpenyesuaian, lblbagianpenyesuaian, txtkontakperson, txtgudang, lblgudang, txturaian, txtcatatan, txtnoref]);
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("AG");
				txtcatatan.text = parentApplication.getNomor("AG",1);
				txtgudang.text = parentApplication.ugudang;
				lblgudang.text = parentApplication.ugudangnama;
				cmbprogress.enabled = true;
				cmbprogress.selectedIndex = 1;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[2].enabled = false;
				mb.menuBarItems[3].enabled = false;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].visible = false;
				mb.menuBarItems[6].visible = false;
				if (vTgl == '0'){
					dttgl.enabled = false;
				}else{
					dttgl.enabled = true;
				}
				if (vNotransaksi == '1'){
					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				
				if (vPosting == '1'){
					chkposting.selected = true;
				}else{
					chkposting.selected = false;
				}
				
				o.agid = 0; o.agcabang = FlexGlobals.topLevelApplication.ucabang; o.aglokasi = FlexGlobals.topLevelApplication.ulokasi; 
				o.agsumber = "AG"; o.agkodepa = 0; o.agbagianag = 0; o.agstatussebelumnya = 0; o.agjmlrevisi = 0; o.agcetakanke = 0; 
				o.aginputuser = FlexGlobals.topLevelApplication.userid; o.aginputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.agmodifikasiuser = 0; 
				o.agmodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.agposting = 0; 
				o.agpostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.agtutupperiode = 0; o.agisclose = 0; 
				o.agcustomtext1 = ""; o.agcustomtext2 = 0; o.agcustomtext3 = ""; o.agcustomtext4 = ""; o.agcustomtext5 = ""; 
				o.agcustomint1 = 0; o.agcustomint2 = 0; o.agcustomint3 = 0; o.agcustomdbl1 = 0; o.agcustomdbl2 = 0; o.agcustomdbl3 = 0; 
				o.agcustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.agcustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.agcustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)f_simpan();
						break;
				}
			}	
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add')){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.nilaisatuan = 0;
					return
				}
				mb.menuBarItems[1].enabled = true;
				mb.menuBarItems[2].enabled = true;
				
				if(parentApplication.rowIndex < dg.dataProviderLength)
					with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
						switch(column){
							case 'namaasset':
								f_setDetail();
								break;
							case 'nilaisatuan':
								jmlbarangmasuk = Number(jmlmasuk) * nilaisatuan,
								jmlbarangkeluar = Number(jmlkeluar) * nilaisatuan
								break;
							case 'jml':
								//jmlbarang = int(jml) * int(nilaisatuan)
								jmlbarang = nilaisatuan * Number(jml);
								break;
						}
					}
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false, id:String='';
				if(dg.selectedCell != null && parentApplication.rowIndex < dg.dataProviderLength)obj = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
				switch(target){
					case 'txtbagianpenyesuaian':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M") AND kkode ="'+txtbagianpenyesuaian.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif = 1 AND kkategori="K" OR kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 and ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+o.agbagianag+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+o.agbagianag+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode ="'+txtgudang.text.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif = 1 AND tnsumber = "IB"';
						sort = 'tnkode asc';
						break;
					case 'kodebarang':
						paket = 'CdM1_Item';
						wsfilter = 'baktif = 1 AND bkode = "'+obj.kodebarang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = 'uaktif = 1 AND ukode = "'+obj.satuan.split('"').join('\\"')+'"';
						csfilter = 'uaktif = 1';
						sort = 'ukode asc';
						break;
					case 'chk_HK':
						paket = 'CdM1_Cogs_Special_In';
						csfilter = 'isclose = 0 AND idbarang ='+dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idbarang;
						break;
					case 'reklawan':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif = 1 AND cgd = "D" AND cnama = "'+obj.reklawan.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						sort = 'cnomor asc';
						break;
					case 'matauang':
						paket = 'CdM1_Currency';
						wsfilter = 'caktif = 1 AND ckode = "'+obj.matauang.split('"').join('\\"')+'"';
						csfilter = 'caktif = 1';
						sort = 'ckode asc';
						break;
					case 'cabang':
						paket = 'CdM1_Branch';
						wsfilter = 'baktif = 1 AND bkode = "'+obj.cabang.split('"').join('\\"')+'"';
						csfilter = 'baktif = 1';
						sort = 'bkode asc';
						break;
					case 'lokasi':
						paket = 'CdM1_Location';
						wsfilter = 'laktif = 1 AND lkode = "'+obj.lokasi.split('"').join('\\"')+'"';
						csfilter = 'laktif = 1';
						sort = 'lkode asc';
						break;
					case 'gudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'waktif = 1 AND wkode = "'+obj.gudang.split('"').join('\\"')+'"';
						csfilter = 'waktif = 1';
						sort = 'wkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif = 1 AND tndsumber = "IB"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'ccaktif = 1 AND cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						csfilter = 'ccaktif = 1';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'daktif = 1 AND dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						csfilter = 'daktif = 1';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'" AND sdkode = "'+obj.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif = 1 AND sddivisi = "'+obj.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case 'proyek':
						paket = 'CdM1_Project';
						wsfilter = 'paktif = 1 AND pkode = "'+obj.proyek.split('"').join('\\"')+'"';
						csfilter = 'paktif = 1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox, id];
			}
			
			public function f_wsHasil():void
			{
				if (dg.dataProvider != null && parentApplication.rowIndex < dg.dataProviderLength)
					var ob : Object = dg.dataProvider[parentApplication.rowIndex];
				var b:Object = {}; var g:int; var r:Object = {}; var j:int; var ws:Object; // variabel untuk setting serial
				var s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					obj = parentApplication.wsArrUtama[0];
					switch(s){	
						case 'txtbagianpenyesuaian':
							txtbagianpenyesuaian.text = obj.kkode;
							lblbagianpenyesuaian.text = obj.knama;
							o.agbagianag = obj.kid;
							break;
						case 'txtkontakperson':
							txtkontakperson.text = obj.kakodekontak;
							break;
						case 'txtgudang':
							txtgudang.text = obj.wkode;
							lblgudang.text = obj.wnama;
							for(i=0;i<dg.dataProvider.length;i++){
								dg.dataProvider.getItemAt(i).gudang = txtgudang.text;
							}
							break;
						case 'txtmatauang':
							var cekuang:Boolean, uang:String='';
							cekuang = false;
							for(i=0;i<dg.dataProvider.length;i++){
								if(((dg.dataProvider.getItemAt(i).idpodetail != undefined && dg.dataProvider.getItemAt(i).idpodetail != 0) || (dg.dataProvider.getItemAt(i).idgrndetail != undefined && dg.dataProvider.getItemAt(i).idgrndetail != 0)) && dg.dataProvider.getItemAt(i).matauang != parentApplication.wsArrUtama.getItemAt(0).ckode){
									cekuang = true; uang = dg.dataProvider.getItemAt(i).matauang;
								}
							}
							if(cekuang == true){
								Alert.show('Data akan dihapus, lanjutkan ?', 'Confirmation', 3, null, function(e:Object):void{	
									if(e.detail == Alert.YES){
										FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
										ws = parentApplication.wsArrUtama.getItemAt(0);
										txtmatauang.text = ws.ckode;
										o.txtkurs = ws.ckurs;
										txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
										for(i=0;i<dg.dataProvider.length;i++){
											with(dg.dataProvider.getItemAt(i)){
												matauang = txtmatauang.text;
												kurs = o.txtkurs;
											}
										}
										if(txtmatauang.text != UFungsional){
											txtkurs.enabled = true;
										}else{txtkurs.enabled = false;}
									}else{
										txtmatauang.text = uang;
										txtkurs.text = FlexGlobals.topLevelApplication.F_formatNominal(o.txtkurs);
									}
								});
							}else{
								ws = parentApplication.wsArrUtama.getItemAt(0);
								txtmatauang.text = ws.ckode;
								o.txtkurs = ws.ckurs
								txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
								for(i=0;i<dg.dataProvider.length;i++){
									with(dg.dataProvider.getItemAt(i)){
										matauang = txtmatauang.text;
										kurs = o.txtkurs;
									}
								}
								if(txtmatauang.text != UFungsional){
									txtkurs.enabled = true;
								}else{txtkurs.enabled = false;}
							}
							break;
						case 'txtcatatan':
							txtcatatan.text = obj.tncatatan;
							break;
						case 'kodebarang':
							ob.idibdetail = 0;
							ob.idib = 0; 
							ob.idbarang = obj.bid, 
							ob.kodebarang = obj.bkode;
							ob.tipebarang = obj.btipe;
							ob.namabarang = obj.bnama;
							ob.jml = 0, 
							ob.satuan = obj.bsatuandefault;
							ob.nilaisatuan = obj.bnilaisatuandefault;
							ob.jmlbarang = int(ob.jml) * int(ob.nilaisatuan); 
							ob.satuanbarang = obj.bsatuan;
							ob.matauang = o.txtmatauang; 
							ob.kurs = o.txtkurs;
							ob.hpplama = obj.bhppaverage;
							ob.hpp = obj.bhppaverage;
							ob.rekpersediaan = obj.brekpersediaan;
							ob.cabang = parentApplication.ucabang;
