						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M7_AgSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+master);
						
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg);
					vMsgIng = "";
					vMsg = "";
					if(txtgudang.text.length == 0)msgAlert(txtgudang,'Warehouse','Gudang');
					if(dttgl.text.length == 0)msgAlert(dttgl,'Date','Tanggal');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)msgAlert(cmbprogress,'Progress','Progress');
					if(vMsg != '' && vMsgIng != '')msgAlert('clear', '', '');	
					//					for(i = 0; i<dg.dataProviderLength; i++){
					//						if(dg.dataProvider[i].hpp == 0 || dg.dataProvider[i].hpp == undefined){
					//							validasi = false;
					//							for(var g:int=0;g<dg.columnsLength;g++){
					//								if(dg.columns.getItemAt(g).dataField == 'hpp')
					//									break;
					//							}
					//							dg.setFocus(); dg.setSelectedCell(i, g);
					//							Alert.show('HPP Update harus diisi dengan benar !', 'Information');
					//						}
					//					}
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi == true)focus.setFocus();
						vMsgIng += inggris+', ';
						vMsg += indonesia+', ';
						if(focus == 'clear'){
							vMsg = vMsg.substr(0, vMsg.length-4);
							vMsg += " harus diisi dengan benar";
							vMsgIng = vMsgIng.substr(0, vMsgIng.length-4);
							vMsgIng += " must be filled";
							Alert.show(vMsgIng+"  ("+vMsg+")" , "Information");}	
						validasi = false; 
					}
				}
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg.dataProvider.removeAll();
				parentApplication.F_acAdd(dg);
				dg.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
