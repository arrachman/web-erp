			public function f_hitungTotal():void
			{
				o.aototal = 0;
				o.aototalpajak1detail = 0;
				o.aototalpajak2detail = 0;
				o.aototaltransaksi = 0;
				for(i=0;i<dg.dataProvider.length;i++){
					if(dg.dataProvider.getItemAt(i).subtotal != undefined)o.aototal += Number(dg.dataProvider.getItemAt(i).subtotal);
					if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)o.aototalpajak1detail += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
					if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)o.aototalpajak2detail += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aototal);
				lbltotalpajak1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aototalpajak1detail);
				lbltotalpajak2.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aototalpajak2detail);
				
				o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.aototal, o.txtdiskonpersen);
				txtdiskonnominal.text = parentApplication.m.nfNominal.format(o.txtdiskonnominal);
				o.txtbiayalainnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, o.aototal, o.txtbiayalainpersen);
				txtbiayalainnominal.text = parentApplication.m.nfNominal.format(o.txtbiayalainnominal);
				f_hitungTotalUtama();
				//				o.pototaltransaksi= (Number(o.pototal) + Number(o.pototalpajak1detail) + Number(o.pototalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				//				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.pototaltransaksi);
			}
			
			public function f_hitungTotalUtama():void
			{
				o.aototaltransaksi= (Number(o.aototal) + Number(o.aototalpajak1detail) + Number(o.aototalpajak2detail) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				lbltotaltransaksi.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.aototaltransaksi);
			}
			
			public function f_hitungGrid():void{
				var dgrid:Object;
				for(i = 0; i<dg.dataProviderLength; i++){
					dgrid = dg.dataProvider[i]
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
					dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
					dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
				}
				
				f_hitungTotal();
			}
			
