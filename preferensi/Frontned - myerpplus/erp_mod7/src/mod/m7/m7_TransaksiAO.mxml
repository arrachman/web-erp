			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							f_simpan();
						}
						break;
				}
			}	
			
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array, dgrid1:Object;
				if(column == 'del'){
					idbs = 0;
				}
				switch(column){ 
					case 'namaasset':
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
						
						dgrid1.idaodetail = 0; 
						dgrid1.idao = 0; 
						dgrid1.idasset = 0; 
						dgrid1.jml = 1; 
						dgrid1.satuan = "";
						dgrid1.harga = 0;
						dgrid1.diskon = 0;
						dgrid1.jmldiskon = 0; 
						dgrid1.pajak1 = ""; 
						dgrid1.jmlpajak1 = 0; 
						dgrid1.pajak2 = ""; 
						dgrid1.jmlpajak2 = 0; 
						dgrid1.pajak1nilai = 0;
						dgrid1.pajak2nilai = 0;
						dgrid1.cabang = o.aocabang; 
						dgrid1.lokasi = o.aolokasi; 
						dgrid1.costcenter = ""; 
						dgrid1.divisi = ""; 
						dgrid1.subdivisi = ""; 
						dgrid1.proyek = ""; 
						dgrid1.catatan = ""; 
						dgrid1.idardetail = 0; 
						dgrid1.idaqdetail = 0;
						dgrid1.idabdetail = 0; 
						dgrid1.jmlae = 0; 
						dgrid1.statusae = 0; 
						dgrid1.jmlai = 0; 
						dgrid1.statusai = 0; 
						dgrid1.jmlrealisasi = 0;
						dgrid1.statusrealisasi = 0;
						dgrid1.isclose = 0;
						dgrid1.customtext1 = "";
						dgrid1.customtext2 = "";
						dgrid1.customtext3 = ""; 
						dgrid1.customdbl1 = 0;
						dgrid1.customdbl2 = 0;
						dgrid1.customdbl3 = 0;
						dgrid1.customdate1 = FlexGlobals.topLevelApplication.DefaultTanggal;
						dgrid1.customdate2 = FlexGlobals.topLevelApplication.DefaultTanggal;
						dgrid1.customdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
						break;
					case 'jml':
					case 'harga':
					case 'diskon':
						dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
						dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlasset = dgrid1.nilaisatuan * dgrid1.jml; 
						break;
					case 'jmldiskon':
						vMsg = ''; vMsgIng = '';
						dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
						if(dgrid1.jml == 0 || dgrid1.harga == 0){
							if(dgrid1.jml == 0)msgAlert(dg,'Jumlah asset', 'Item Amount');
							if(dgrid1.harga == 0)msgAlert(dg,"Harga", "Price");
							if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
							dgrid1.jmldiskon = 0;
							dgrid1.diskon= 0;
						}else{
							dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
							
						}
						dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
						dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
						dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'pajak1':
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
					case 'pajak2':
						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg);
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='',id:String = '', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
