				o.txtbiayalainnominal = 0;
				o.txtdiskonpersen = 0;
				o.txtbiayalainpersen = 0;
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Need Approval', v:1}, {l:'Approved', v:2}]);
				tab.selectedIndex=0;
				cmbprogress.selectedIndex=2;
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				f_focusOnMe(); 
				txtgudang.text = FlexGlobals.topLevelApplication.ugudang;
				lblgudang.text = FlexGlobals.topLevelApplication.ugudangnama;
				//				cmbasalasset.selectedIndex=0;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotal,lbltotalpajak1,lbltotalpajak2,lbltotaltransaksi,txtbiayalainnominal,txtbiayalainpersen,txtdiskonnominal, txtdiskonpersen],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				//FlexGlobals.topLevelApplication.F_SetNilaiText([txtdiskonpersen],0);
				isUpdate = false;
				txtnotransaksi.text = 'Auto';		
				txturaian.text = parentApplication.getNomor("AO");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("AO",1);
				parentApplication.F_SetNilaiText([dttgl,dttglnoref], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtsupplier, lblsupplier,txtkontakperson,txttermin,txtnoref,txaalamatkontakperson,txaalamatsupplier]);
				txtbiayalainnominal.toolTip = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'BiayaLain')+" : "+ FlexGlobals.topLevelApplication.getSetting(0, 'akunnama', 'BiayaLain');
				txtdiskonnominal.toolTip = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'DiskonPembelian')+" : "+ FlexGlobals.topLevelApplication.getSetting(0, 'akunnama', 'DiskonPembelian');
				lbltotalpajak1.toolTip = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'PajakPembelian')+" : "+ FlexGlobals.topLevelApplication.getSetting(0, 'akunnama', 'PajakPembelian');
				lbltotalpajak2.toolTip = FlexGlobals.topLevelApplication.getSetting(0, 'akun', 'PajakPembelian')+" : "+ FlexGlobals.topLevelApplication.getSetting(0, 'akunnama', 'PajakPembelian');
				
				o.aoid = 0; o.aocabang = FlexGlobals.topLevelApplication.ucabang; o.aolokasi = FlexGlobals.topLevelApplication.ulokasi; 
				o.aosumber = "AO"; o.aokodepa = 0; o.aosupplier = 0; 
				o.ao1alamat3 = ""; o.ao2alamat1 = ""; o.ao2alamat2 = ""; o.ao2alamat3 = ""; o.aobagianpembelian = 0; 
				o.aotgldipenuhi = FlexGlobals.topLevelApplication.DefaultTanggal; o.aotgljatuhtempo = FlexGlobals.topLevelApplication.DefaultTanggal;
				o.aotglpenutupan = FlexGlobals.topLevelApplication.DefaultTanggal; o.aohargatermasukpajak = 0; 
				o.aototal = 0; o.aodiskonpersen = 0; o.aojmldiskon = 0; o.aototalpajak1detail = 0; o.aototalpajak2detail = 0; o.aobiayalainpersen = 0; 
				o.aobiayalain = 0; o.aototaltransaksi = 0; o.aojmlbayar = 0; o.aorekdiskon = ""; o.aorekpajak1 = ""; o.aorekpajak2 = ""; 
				o.aorekbiayalain = ""; o.aorekbayar = ""; 
				o.aoidar = 0; o.aoidab = 0; o.aostatusae = 0; o.aostatusai = 0; o.aostatusrealisasi = 0; o.aostatussebelumnya = 0; 
				o.aojmlrevisi = 0; o.aocetakanke = 0; o.aoinputuser = FlexGlobals.topLevelApplication.userid; 
				o.aoinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aomodifikasiuser = 0; o.aomodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aoposting = 0; o.aopostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; o.aoisclose = 0; 
				o.aocustomtext1 = ""; o.aocustomtext2 = ""; o.aocustomtext3 = ""; o.aocustomtext4 = ""; o.aocustomtext5 = ""; 
				o.aocustomint1 = 0; o.aocustomint2 = 0; o.aocustomint3 = 0; o.aocustomdbl1 = 0; o.aocustomdbl2 = 0; o.aocustomdbl3 = 0;
				o.aocustomdate1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aocustomdate2 = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.aocustomdate3 = FlexGlobals.topLevelApplication.DefaultTanggal;
