			import net.user1.reactor.UserAccount;
			
			import spark.components.Image;
			import spark.events.IndexChangeEvent;
			
			protected var validasi:Boolean,	vMsg:String,vMsgIng:String, img:Image,UFungsional:String, idbs:int=0, 
				i:int, isUpdate:Boolean, hf:Object, ft:Object;
			public var o:Object = {};
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid1:Object
				switch (components){
					case 'checkBox':
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hargafix = data;
						break;
					case  'calculator':
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						switch (dataField){
							case 'jml':
							case 'harga':
							case 'diskon':
								dgrid1 = dg.dataProvider.getItemAt(parentApplication.rowIndex);
								dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlasset = dgrid1.nilaisatuan * dgrid1.jml, 
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							case 'jmldiskon':
								vMsg = ''; vMsgIng = '';
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg,'Jumlah asset', 'Item Amount');
									if(dgrid1.harga == 0)msgAlert(dg,"Harga", "Price");
									if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
									
								}
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								break;
							
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
			
			
			public function f_focusOnMe():void
			{
				txtsupplier.setFocus();
			}
			//validasi inputan wajib
			public function msgAlert(focus: Object, indonesia: String, inggris: String):void
			{		
				if(validasi == true)focus.setFocus();
				vMsgIng += inggris+', ';
				vMsg += indonesia+', ';
				if(focus == 'clear'){
					vMsg = vMsg.substr(0, vMsg.length-4);
					vMsg += " harus diisi dengan benar terlebih dahulu";
					
					vMsgIng = vMsgIng.substr(0, vMsgIng.length-4);
					vMsgIng += " must be filled in correctly first";
					Alert.show(vMsg+" !" , "Information");}	
				validasi = false;						
			}
			
			protected function f_persiapan():void
			{
				ft= FlexGlobals.topLevelApplication.F_tglFormatDB;
				hf=FlexGlobals.topLevelApplication.F_hapusFormatCurrency;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				tab.focusEnabled = false;
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				
				FlexGlobals.topLevelApplication.F_RequiredLabel([tsupplier, ttanggal, tnotransaksi, tmatauang, tprogress, tkurs]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tsupplier,tgudang, turaian, ttanggal, tnotransaksi, tmatauang, tprogress, tkontakperson, tcatatan, talamatkontakperson, talamatsupplier, ttotal, ttotaltransaksi, tdiskon, tbiayalain]);
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				//				cmbcarabayar.dataProvider = new ArrayCollection([{l:'Tunai', v:1}, {l:'Kredit', v: 2}]);
				//				cmbasalasset.dataProvider = new ArrayCollection([{l:'Lokal', v:1}, {l:'Import', v: 2}]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl,dttglnoref]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan,txtkontakperson,lbltotalpajak1,lbltotalpajak2,txtdiskonnominal,txtbiayalainnominal]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress]);
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs,txtdiskonnominal,txtbiayalainpersen,txtbiayalainnominal]);
				FlexGlobals.topLevelApplication.F_TextInputDiskonbertingkat([txtdiskonpersen]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtsupplier, txtmatauang,txtgudang,txttermin]);
				parentApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,chkauto, txtnoref]);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_AmbilAR);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_AmbilAQ);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				function f_mbUpload():void {
					if(mb.menuBarItems[4].enabled == true){FlexGlobals.topLevelApplication.F_OpenUploadFile('AO', o.poid,txtnotransaksi.text)};
				}
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled==true)f_simpan();
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
				}
				function f_AmbilAR():void{
					vMsg = ''; vMsgIng='';
					if(txtsupplier.text.length > 0 && txtmatauang.text.length > 0){
						FlexGlobals.topLevelApplication.F_popUpCari("AmbilAR");
					}else{
						if(txtsupplier.text.length <=0)msgAlert(txtsupplier, 'Supplier', 'Supplier');
						if(txtmatauang.text.length <=0)msgAlert(txtmatauang, 'Mata Uang', 'Currency');
						if(vMsg != '' && vMsgIng != '')msgAlert('clear', '','');	
					}
				}
				function f_AmbilAQ():void{
					
					vMsg = ''; vMsgIng='';
					if(txtsupplier.text.length > 0 && txtmatauang.text.length > 0){
						FlexGlobals.topLevelApplication.F_popUpCari("AmbilAQ");
					}else{
						if(txtmatauang.text.length <= 0)msgAlert(txtmatauang, 'Uang', 'Currency');
						if(txtsupplier.text.length <=0)msgAlert(txtsupplier, 'Supplier', 'Supplier');
						if(vMsg != '' && vMsgIng != '')msgAlert('clear', '','');	
					}
					
					
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[5].enabled==true){FlexGlobals.topLevelApplication.F_OpenNotes(o.posumber,o.poid,txtnotransaksi.text)};
				}
				//set persen biaya lain dan diskon
				txtdiskonnominal.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtdiskonpersen= (o.txtdiskonnominal / o.aototal) * 100;
					txtdiskonpersen.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtdiskonpersen);
					f_hitungTotalUtama();
				});
				
				txtbiayalainnominal.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtbiayalainpersen=(o.txtbiayalainnominal  / o.aototal) * 100;
					txtbiayalainpersen.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtbiayalainpersen)
					f_hitungTotalUtama();
				});
				
				//set nominal biayalain dan diskon
				txtdiskonpersen.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtdiskonnominal = FlexGlobals.topLevelApplication.F_diskonBertingkat(1,o.aototal,o.txtdiskonpersen);
					txtdiskonnominal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtdiskonnominal);
					f_hitungTotalUtama();
				});
				
				txtbiayalainpersen.addEventListener(spark.events.TextOperationEvent.CHANGE,function ():void{
					o.txtbiayalainnominal = o.txtbiayalainpersen/100 * o.aototal;
					txtbiayalainnominal.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtbiayalainnominal);
					f_hitungTotalUtama();
				});
				
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled==true)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected ==true){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
				}
				
				cmbprogress.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(e:KeyboardEvent):void{
					if(e.keyCode == Keyboard.ENTER){
						dg.setFocus();
						dg.setSelectedCell(0,1);
					}
				});
				//change auto no grup
				
				FlexGlobals.topLevelApplication.F_RegGrid(7,6,[dg],'transaksi')
				parentApplication.subject = 'get';
				
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_PoHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
							FlexGlobals.topLevelApplication.m.ArrFilter[0]
							if(FlexGlobals.topLevelApplication.m.ArrFilter == "copyTransaksi"){
								FlexGlobals.topLevelApplication.F_wsGetDataById('copyTransaksi', 'M4_PoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}else{
								f_kondisiAwal();
								FlexGlobals.topLevelApplication.F_wsGetDataById('tampilAQ', 'M4_RqGetdataById',FlexGlobals.topLevelApplication.m.ArrFilter[0], 0, 0, FlexGlobals.topLevelApplication.m.ArrFilter[1], 'urutan ASC', FlexGlobals.topLevelApplication.m.formatDate, FlexGlobals.topLevelApplication.m.formatDate);
							}
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M7_AoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							mb.menuBarItems[4].enabled =true;
							mb.menuBarItems[5].enabled =true;
						}
					}
				}
				//end ofset getdata by id===============================================================================================
			}
			
			protected function f_kondisiAwal():void
			{
