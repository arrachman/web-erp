						csfilter = "kaidkontak ="+o.atsupplier+"";
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtmatauang':
						paket = 'CdM1_Currency';
						wsfilter = "caktif=1 AND ckode = '"+txtmatauang.text+"'";
						csfilter = "caktif=1";
						sort = 'ckode asc';
						break;
					case 'txtmatauangRI':
						paket = 'CdM1_Currency';
						wsfilter = "caktif=1 AND ckode = '"+txtmatauangRI.text+"'";
						csfilter = "caktif=1";
						sort = 'ckode asc';
						break;
					
					case 'txtcatatan':
