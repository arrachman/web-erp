									with(obj.dataProvider.getItemAt(obj.dataProviderLength-1)){
										diskontermin = f_diskonTermin(dttgl.text, '', tgl, haridiskon1, haridiskon2, diskon1, diskon2);
										jmldiskontermin = jmlbayar*(diskontermin/100);
										jmldiskonterminvalas = jmlbayarvalas*(diskontermin/100); 
									}
								}
							}
							if(dgCOA.dataProviderLength == 0){
								FlexGlobals.topLevelApplication.F_defaultGrid([dgCOA]);
							}
							FlexGlobals.topLevelApplication.wsArrDetail = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[2], FlexGlobals.topLevelApplication.vData[2]);
							dgBayar.dataProvider = FlexGlobals.topLevelApplication.wsArrDetail;
							if(FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[2], FlexGlobals.topLevelApplication.vData[2]).length <= 0){
								FlexGlobals.topLevelApplication.F_defaultGridItem(dgBayar);
							}
							FlexGlobals.topLevelApplication.F_dgRefresh(dgRI);
							FlexGlobals.topLevelApplication.F_dgRefresh(dgCOA);
							FlexGlobals.topLevelApplication.F_dgRefresh(dgBayar);
							f_hitungTotal();
							break;
						case 'simpan':
							FlexGlobals.topLevelApplication.FormFilter='';
							FlexGlobals.topLevelApplication.F_defaultGridItem(dgRI);
							FlexGlobals.topLevelApplication.F_defaultGridItem(dgCOA);
							FlexGlobals.topLevelApplication.F_defaultGridItem(dgBayar);
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_alertCetak(4, 15, 'at', FlexGlobals.topLevelApplication.wsIdtransaksi, FlexGlobals.topLevelApplication.wsErrmessage, o.tanggal+" s.d "+o.tanggal);
							break;
						case 'print':
							FlexGlobals.topLevelApplication.F_openReportDefault(4,15,"atid = "+FlexGlobals.topLevelApplication.wsIdtransaksi+"");
							break;
					}
				}else{					
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case 'noakun': //noakun
								if(tab.selectedIndex==0)
									if(tab.selectedIndex==1)
										break;
							case 'costcenter': //coscenter / bank
								if(tab.selectedIndex==0)with(dgRI.dataProvider.getItemAt(parentApplication.rowIndex))costcenter = '';
								break;
							
							case 'divisi': //divisi
								with(dgRI.dataProvider.getItemAt(parentApplication.rowIndex)){
									divisi = '';
								}
								break;
							case 'subdivisi': // subdivisi
								dgRI.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi = '';
								break;
							case 'proyek': // proyek
								if(tab.selectedIndex==0){
									dgRI.dataProvider.getItemAt(parentApplication.rowIndex).proyek = '';
								}
								break;
							case 'rekbank':
								dgrid = dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex);
								dgrid.rekbank = '';
								dgrid.rekbanknama = ''; 
								dgrid.noacbank = '';
								break;
							case 'tampil':
							case 'tampilHistory':
							case 'simpan':
								Alert.show(parentApplication.l(parentApplication.wsErrmessage), parentApplication.l('Informasi'));
								break;
							case 'at_TakeData':
								if(loop == -1 || loop == 3)loop = tab.selectedIndex;
								if(loop == 0)dg = dgRI;
								for(i=dg.dataProviderLength-1;i>=0;i--){
									if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
										dg.dataProvider.removeItemAt(i);
									}
								}
								if(dg.dataProviderLength == 0){
									FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
								}
								f_hitungTotal();
								f_uangRefreshGrid();
								break;
						}
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgCOA);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgBayar);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgRI);
				f_hitungTotal();
			}
			
