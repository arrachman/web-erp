						f = FlexGlobals.topLevelApplication.TambahFilter(f,'tgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglRI1.text)+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglRI2.text)+'"');
					}else if(dttglRI1.text != ""){
						f = parentApplication.TambahFilter(f, 'tgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglRI1.text)+'"'); 
					}	
					else if(dttglRI2.text != ""){
						f = parentApplication.TambahFilter(f, 'tgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglRI2.text)+'"'); 
					}	
					if(txtfnotransaksiRI1.text!="" && txtfnotransaksiRI2.text!=""){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'notransaksi Between "'+txtfnotransaksiRI1.text+'" and "'+txtfnotransaksiRI2.text+'"');
					}
					if(txtmatauangRI.text !=""){
						matauangdetail = 'AND matauang ="'+txtmatauangRI.text+'"';
					}
					if(cmbstatusjtRI.selectedItem.v != "" && cmbstatusjtRI.textInput.text.length > 0){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'tanggaljatuhtempo '+cmbstatusjtRI.selectedItem.v+' "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text)+'"');
					}
					dg = dgRI;
				}
				for(i=0; i<dg.dataProviderLength; i++){
					if(dg.dataProvider[i].chk == true){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'notransaksi <>"'+dg.dataProvider[i].notransaksi+'"'); 
					}
					
				}
				if(txtmatauang.text != UFungsional && tab.selectedIndex == 1){
					if(matauangdetail ==  'AND matauang ="'+UFungsional+'"' || matauangdetail == ''){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'(matauang ="'+txtmatauang.text.split('"').join('\\"')+'" '+matauangdetail+') OR matauang ="'+UFungsional+'"');
					}else{
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'matauang ="'+txtmatauang.text.split('"').join('\\"')+'" '+matauangdetail);
					}
				}else{
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'matauang ="'+txtmatauang.text.split('"').join('\\"')+'" '+matauangdetail);
				}
				f = FlexGlobals.topLevelApplication.TambahFilter(f,'statuslunas <> 2 AND kontak = '+o.atsupplier);
				return f;
			}
			
