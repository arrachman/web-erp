			public function f_hitungTotal():void
			{
				//set total detail
				o.totalRI = 0; o.totalRIvalas = 0; o.totalAP = 0; o.totalAPvalas = 0;  o.totalPRT = 0; o.totalPRTvalas = 0; o.totalCOA = 0; o.totalCOAvalas = 0; 
				o.diskonterminRI = 0; o.diskonterminAP = 0; o.diskonterminPRT = 0;
				o.diskonterminRIvalas = 0; o.diskonterminAPvalas = 0; o.diskonterminPRTvalas = 0; 
				o.totaltransaksiRI = 0; o.totaltransaksiAP = 0; o.totaltransaksiPRT = 0; o.totaltransaksiCOA = 0; o.totaltransaksiBYR = 0;
				o.terbayarRI = 0; o.terbayarAP = 0; o.terbayarPRT = 0;
				o.sisaRI = 0; o.sisaAP = 0; o.sisaPRT = 0;
				//set total bawah
				o.attotalap = 0; o.attotalapvalas = 0; o.attotalar = 0; o.attotalarvalas = 0; o.atselisihkurs = 0;
				o.atdiskontermin = 0; o.atdiskonterminvalas =  0; o.atbayar = 0; o.atbayarvalas = 0;
				//dgRI
				for(i = 0; i< dgRI.dataProviderLength; i++){
					if(dgRI.dataProvider[i].chk == true){
						o.totalRI += Number(dgRI.dataProvider[i].jmlbayar);
						o.totalRIvalas += Number(dgRI.dataProvider[i].jmlbayarvalas);
						o.diskonterminRI += Number(dgRI.dataProvider[i].jmldiskontermin);
						o.diskonterminRIvalas += Number(dgRI.dataProvider[i].jmldiskonterminvalas);
						// hitung total tiap tiap tab
						o.totaltransaksiRI += Number(dgRI.dataProvider[i].totaltransaksi);
						o.terbayarRI += Number(dgRI.dataProvider[i].terbayar);
						o.sisaRI = Number(o.totaltransaksiRI - o.terbayarRI);
					}
				}
				//dg Coa
				for(i = 0; i< dgCOA.dataProviderLength; i++){
					if(dgCOA.dataProvider.getItemAt(i).jmlbayar != undefined){o.totalCOA += Number(dgCOA.dataProvider[i].jmlbayar);}
					if(dgCOA.dataProvider.getItemAt(i).jmlbayarvalas != undefined){o.totalCOAvalas += Number(dgCOA.dataProvider[i].jmlbayarvalas);}
					// hitung total tiap tiap tab
					if(dgCOA.dataProvider.getItemAt(i).jmlbayar != undefined){o.totaltransaksiCOA += Number(dgCOA.dataProvider[i].jmlbayar);}
				}
				//dg Bayar
				for(i = 0; i< dgBayar.dataProviderLength; i++){
					if(dgBayar.dataProvider.getItemAt(i).jumlah != undefined){o.totaltransaksiBYR += Number(dgBayar.dataProvider[i].jumlah);}
				}
				
				//hitungtotalap
				o.attotalap = o.totalRI + o.totalCOA;
				o.attotalapvalas = o.totalRIvalas + o.totalCOAvalas;
				//hitungtotalar
				o.attotalar = o.totalAP + o.totalPRT;
				o.attotalarvalas = o.totalAPvalas + o.totalPRTvalas;
				//hitung diskon termin
				o.atdiskontermin = o.diskonterminRI + o.diskonterminAP + o.diskonterminPRT;
				o.atdiskonterminvalas = o.diskonterminRIvalas + o.diskonterminAPvalas + o.diskonterminPRTvalas;
				//hitung selisih kurs
				if(txtmatauang.text != UFungsional){
					o.atselisihkurs = o.attotalap - o.attotalar - o.atdiskontermin - ((o.attotalapvalas - o.attotalarvalas - o.atdiskonterminvalas) * o.txtkurs);
				}
				//hitungbayar
				o.atbayar = o.attotalap - o.attotalar - o.atdiskontermin -  o.atselisihkurs;
				o.atbayarvalas = o.attotalapvalas - o.attotalarvalas - o.atdiskonterminvalas;
				//set label
				lbltotalAP.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.attotalap); lbltotalAPvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.attotalapvalas);
				lbldiskontermin.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.atdiskontermin); lbldiskonterminvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.atdiskonterminvalas);
				lblselisihkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.atselisihkurs);
				lblbayar.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.atbayar); lblbayarvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.atbayarvalas);
				// set label tiap tiap tab
				lbltotaltransaksiRI1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiRI); 
				lblterbayarRI1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.terbayarRI); 
				lblsisaRI1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.sisaRI); 
				lbltotaltransaksiCOA1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiCOA); lbltotaltransaksiBYR1.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksiBYR);
			}
			
			protected function f_dinamikValueGrid(dg:DataGrid, rowIndex:int):void{
				with(dg.dataProvider.getItemAt(rowIndex)){
					if(vUang == txtmatauang.text)
						jmlbayarvalas = 0;
					else jmlbayarvalas = jmlbayar/h.getItemAt(0).kurs;
					diskontermin = f_diskonTermin(dttgl.text, '', tgl, haridiskon1, haridiskon2, diskon1, diskon2);
					jmldiskontermin = jmlbayar*(diskontermin/100);
					jmldiskonterminvalas = jmlbayarvalas*(diskontermin/100); 
				}
			} 
			
			protected function f_diskonTermin(tglbayar:String, tglgiro:String, tgl:String, haridiskon1:int, haridiskon2:int, diskon1:int, diskon2:int):int
			{
				var tglselisih:int, i:int;
				if(tglbayar == '')
					return 0;
				if(tglgiro == '')tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglbayar, tgl)
				else tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglbayar, tglgiro);
				if(tglselisih <= haridiskon1)
					return diskon1;
				else if(tglselisih <= haridiskon2)
					return diskon2;
				else return 0;
			}
			
			
