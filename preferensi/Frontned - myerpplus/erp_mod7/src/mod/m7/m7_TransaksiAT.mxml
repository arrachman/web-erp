						csfilter = "tnaktif=1 AND tnsumber='at'";
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case 'txtbagpembelian':
						paket = 'CdM1_Contact';
						wsfilter = "kaktif='1' and kkategori='K' and kkode ='"+txtbagpembelian.text+"'";
						csfilter = "kaktif='1' and kkategori='K'";
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'Ambilat':
						paket = 'CdM4_at';
						csfilter = "atsupplier="+o.atsupplier+" AND atmatauang='"+txtmatauang.text+"' AND atstatusat <> 2 AND (atstatus = 2 OR atstatus = 3)";
						sort = 'attgl desc, atnotransaksi desc';
						break;
					case 'rekhutangpiutang':
						paket = 'CdM1_Coa';
						wsfilter = 'caktif=1 AND cgd ="D" AND cnomor ="'+dgCOA.dataProvider[dgCOA.selectedCell.rowIndex].rekhutangpiutang+'"';
						csfilter = 'caktif=1 AND cgd ="D"';
