						break;
					case 'bank':
						if(dgBayar.dataProvider[dgBayar.selectedCell.rowIndex].carabayar == 1 || dgBayar.dataProvider[dgBayar.selectedCell.rowIndex].carabayar == 2){
							paket = 'CdM1_Bank';
