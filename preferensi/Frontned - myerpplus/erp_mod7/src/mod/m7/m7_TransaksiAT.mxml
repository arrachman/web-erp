						if(tab.selectedIndex ==0 ){dg = dgRI}
						else if(tab.selectedIndex == 1){dg = dgCOA}
						else {dg = dgBayar}
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = "tndaktif=1 AND tndsumber='at'";
						sort = 'tndkode asc';
						break;
					case 'costcenter': // Cost Center
						paket = 'CdM1_Cost_Center';
						wsfilter = "ccaktif=1 AND cckode = '"+dgCOA.dataProvider.getItemAt(dgCOA.selectedCell.rowIndex).costcenter+"'";
						csfilter = "ccaktif=1";
						sort = 'cckode asc';
						break;
					case 'divisi': // Divisi
						paket = 'CdM1_Division';
						wsfilter = "daktif=1 AND dkode = '"+dgCOA.dataProvider.getItemAt(dgCOA.selectedCell.rowIndex).divisi+"'";
						csfilter = "daktif=1";
						sort = 'dkode asc';
