						csfilter = "sdaktif=1 AND sddivisi='"+dgCOA.dataProvider.getItemAt(dgCOA.selectedCell.rowIndex).divisi+"'";
						sort = 'sdkode asc';
						break;
					case 'proyek': // proyek
						paket = 'CdM1_Project';
						wsfilter = "paktif=1 AND pkode = '"+dgCOA.dataProvider.getItemAt(dgCOA.selectedCell.rowIndex).proyek+"'";
						csfilter = "paktif=1";
						sort = 'pkode asc';
						break;
					case 'carabayarnama':
						paket = 'CdM0_Carabayar';
						wsfilter = "kode <> 3 and nama ='"+dgBayar.dataProvider[dgBayar.selectedCell.rowIndex].carabayarnama+"'";
