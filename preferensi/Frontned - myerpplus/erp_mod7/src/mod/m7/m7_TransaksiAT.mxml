			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var mnid:int, dg:DataGrid, dgrid1:Object;
				if(tab.selectedIndex == 0){mnid = 7; dg = dgRI}
				
				switch (components){
					case 'checkBoxHeader':
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
						}
						break;
					
					case 'checkBox':
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						break;
					case 'link':
						FlexGlobals.topLevelApplication.openForm(7, mnid, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idtransaksi);
						break;
					case  'calculator':
						dg.dataProvider[dg.selectedCell.rowIndex][dataField] = data;
						
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg, dg.selectedCell.rowIndex);
						switch (dataField){
							case 'jmlbayar':
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.matauang != UFungsional){
									dgrid1.jmlbayarvalas = dgrid1.jmlbayar /  Number(dgrid1.kurs);
								}
								else{
									dgrid1.jmlbayarvalas = 0
									dgrid1.jmlbayar = data
								}
								
								dgrid1.diskontermin = f_diskonTermin(dttgl.text, '', dgrid1.tgl, dgrid1.haridiskon1, dgrid1.haridiskon2, dgrid1.diskon1, dgrid1.diskon2);
								dgrid1.jmldiskontermin = dgrid1.jmlbayar*(dgrid1.diskontermin/100);
								dgrid1.jmldiskonterminvalas = dgrid1.jmlbayarvalas*(dgrid1.diskontermin/100);
								f_hitungTotal();
								break;
							case 'jmlbayarvalas':
								dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								if(dgrid1.matauang != ''){
									if(dgrid1.matauang != UFungsional){
										dgrid1.jmlbayar = dgrid1.jmlbayarvalas *  Number(dgrid1.kurs);
									}
									else{
										dgrid1.jmlbayarvalas = 0
										dgrid1.jmlbayar = Number(dgrid1.totaltransaksi) - Number(dgrid1.terbayar)
									}
									
									dgrid1.diskontermin = f_diskonTermin(dttgl.text, '', dgrid1.tgl, dgrid1.haridiskon1, dgrid1.haridiskon2, dgrid1.diskon1, dgrid1.diskon2);
									dgrid1.jmldiskontermin = dgrid1.jmlbayar*(dgrid1.diskontermin/100);
									dgrid1.jmldiskonterminvalas = dgrid1.jmlbayarvalas*(dgrid1.diskontermin/100);
									f_hitungTotal();
								}
								break;
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
