<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.events.CalendarLayoutChangeEvent;
			override public function prepare(hasBeenRecycled:Boolean):void {
				Mydate.text = data[column.dataField]
			}
			
			protected function Mydate_changeHandler(event:CalendarLayoutChangeEvent):void
			{
				// TODO Auto-generated method stub
				data[column.dataField] = Mydate.text;
			}
			
		]]>
	</fx:Script>
	<mx:Box height="100%" width="100%" left="5" right="5">
		<mx:DateField width="100%" height="100%" id="Mydate" change="Mydate_changeHandler(event)">
			
		</mx:DateField>		
	</mx:Box>

</s:GridItemRenderer>
