<?xml version="1.0" encoding="utf-8"?>
<s:Application xmlns:fx="http://ns.adobe.com/mxml/2009"
			   xmlns:s="library://ns.adobe.com/flex/spark"
			   xmlns:mx="library://ns.adobe.com/flex/mx"
			   xmlns:flexlib="http://code.google.com/p/flexlib/"
			   xmlns:comp="comp.*"
			   width="100%" height="100%" minWidth="0" minHeight="0"
			   creationComplete="f_checkingFile()" initialize="f_initializeHandler()"
			   keyDown="App_keyDown(event)">
	<fx:Style>
		@namespace s "library://ns.adobe.com/flex/spark";
		@namespace mx "library://ns.adobe.com/flex/mx";
		@namespace flexlib "http://code.google.com/p/flexlib/";
		@namespace comp "comp.*";
		@font-face {
			src: url(/assets/font/AUBREY1__.TTF);
			fontFamily: myPlainFont2;
			advancedAntiAliasing: true;
		}
		
		.myStyle2 {
			fontFamily: myPlainFont2; 
			fontSize:12pt
		}
		
		@namespace supertabs "flexlib.controls.tabBarClasses.*";
		
		supertabs|SuperTab
		{
			tabCloseButtonStyleName: "closeButton";
		}   
	</fx:Style> 
	 
	<fx:Style source="script/MyERPPlus.css"/>
	<fx:Script source="script/MyERPPlus.as"/>
	
	<fx:Declarations>
		<fx:XML id="myMenuData">
			<root>
				<menuitem label="Logout" icon="mainlogout" eventName="evLogOut"/>
				<menuitem label="Inbox" icon="maininbox" eventName="evInbox"/>
				<menuitem label="Default Tanggal" icon="tbdate" eventName="evTanggal"/>
				<menuitem type="separator"/>
				<menuitem label="Setting" icon="mainsetting" eventName="evSetting"/>
			</root>
		</fx:XML>
		<fx:XML id="mbProfil">
			<r>
				<m l="Profil" i="mainuser"/>
				<m l="Tanggal" i="maindate"/>
				<m l="Log Out" i="mainlogout"/>
			</r>
		</fx:XML>
		<fx:Array id="Poparr">
			<fx:Object label="Alert" />
			<fx:Object label="Logout" icon="@Embed('assets/tb/add.png')" />
			<fx:Object label="ButtonBar" icon="@Embed('assets/tb/add.png')" />
			<fx:Object label="CheckBox" icon="@Embed('assets/tb/add.png')" />
			<fx:Object label="ColorPicker" icon="@Embed('assets/tb/add.png')" />
		</fx:Array>
	</fx:Declarations>

	<s:Rect id="ImgHeader" height="40" left="0" right="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="#ADEFFF" />
				<s:GradientEntry color="#81CBED" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Path id="pth1" height="20" left="0" right="0" y="0" data="M 0 0 L 84 0 L 84 15 C 84 15 44 5 0 15 C 0 15 0 0 0 0 Z">
		<s:fill>
			<s:LinearGradient x="43" y="0" scaleX="20" rotation="90" >
				<s:GradientEntry color="0xffffff" ratio="0" alpha="0.55"/>
				<s:GradientEntry color="0xffffff" ratio="1" alpha="0.15"/>
			</s:LinearGradient>
		</s:fill>
	</s:Path>
	<s:Image id="imgLogo" top="10" left="15"/>
	<mx:Label id="LblUsername" y="10" right="118" width="247"/>
	<s:Image id="imguser" y="11" right="96"/>
	<s:Image id="imgtgl" y="8" right="66"/>
	<s:Image id="imgscreen" y="12" right="41"/>
	<s:Image id="imglogout" y="10" right="14"/>
	
	<mx:HDividedBox id="hDiv" y="41" right="0" left="0" top="40" bottom="5">
		<mx:VBox id="BoxLeft" width="250" height="100%" verticalGap="0" maxWidth="300">
			<mx:HBox width="100%" height="25" backgroundColor="#EBF4FF" horizontalAlign="right" horizontalGap="2" verticalAlign="middle">	
				<mx:LinkButton id="BtnLinkJudul" x="11" width="100%"/>
				<s:Button id="BtnCollapse" width="23" height="23" icon="{mainleft}"/>
				<mx:Box width="0" height="100%"/>
			</mx:HBox>
			<mx:Box height="100%" width="100%" >
				<mx:VDividedBox width="100%" height="100%" liveDragging="true">
					<mx:Box width="100%" height="100%">
						<mx:Tree id="TreeKu" height="100%" width="100%"/>	
					</mx:Box>
					<mx:Box id="BoxGrupMenu" width="100%" height="210">
						<mx:VBox id="vx" width="100%"/>
						<mx:HBox id="hxbottom" horizontalGap="0" width="100%"> 
							<s:Button id="btnbottom" width="100%"/>
						</mx:HBox>
					</mx:Box>
				</mx:VDividedBox>
			</mx:Box>
		</mx:VBox>
		<flexlib:SuperTabNavigator id="MySuperTab" width="100%" height="100%" tabClose="MySuperTab_tabCloseHandler(event)"/>
	</mx:HDividedBox>
	<s:Image id="linebottom" x="33" y="421" height="5" left="0" right="0" bottom="0"/>
	<s:Button id="BtnExpand" top="150" width="23" height="23" icon="{pright}"/>
	<s:Group id="grpBusy" left="0" right="0" top="0" bottom="0" visible="false">
		<s:Rect id="backgroundRect" left="0" right="0" top="0" bottom="0">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry id="grpGEBusy" color="white" alpha="1" />
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
	</s:Group>
	<s:Label id="lblex" y="60" left="10" right="10" click="lblex_clickHandler(event)" text=""/>
</s:Application>