<?xml version="1.0" encoding="utf-8"?>
<s:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009"
			   xmlns:s="library://ns.adobe.com/flex/spark"
			   xmlns:mx="library://ns.adobe.com/flex/mx"
			   height="168" width="398" keyDown="titlewindow1_keyDownHandler(event)" close="titlewindow1_closeHandler()"
			   creationComplete="titlewindow1_initializeHandler(event)">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Menu;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.MenuEvent;
			import mx.managers.PopUpManager;
			
			[Bindable] [Embed(source="assets/tb/pdf.png")]  public var tbpdf:Class;
			[Bindable] [Embed(source="assets/tb/excel.png")]  public var tbexcel:Class;
			[Bindable] [Embed(source="assets/tb/txt.png")]  public var tbtxt:Class;
			[Bindable] [Embed(source="assets/tb/word.png")]  public var tbword:Class;
			[Bindable] [Embed(source="assets/tb/html.png")]  public var tbhtml:Class;
			[Bindable] [Embed(source="assets/tb/tif.png")]  public var tbtif:Class;
			[Bindable] [Embed(source="assets/tb/print.png")]  public var tbprint:Class;
			[Bindable] [Embed(source="assets/tb/export.png")]  public var tbexport:Class;
			[Bindable] [Embed(source="assets/tb/close.png")]  public var tbclose:Class;
			
			public var mod:int, menu:int, sumber:String, idtransaksi:int, notransaksi:String, param1:String = '', ex:int = 0;
			protected function titlewindow1_initializeHandler(event:FlexEvent):void
			{
				var m:Menu, o:Object;
				this.title = "Confirmation";
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbjenislaporan]);
				btnprint.addEventListener(MouseEvent.CLICK, f_mbPrint);
				btnclose.addEventListener(MouseEvent.CLICK, f_mbClose);
				btnprint.addEventListener(KeyboardEvent.KEY_DOWN, f_btnprintKEY_DOWN);
				btnexport.addEventListener(KeyboardEvent.KEY_DOWN, f_btnexportKEY_DOWN);
				btnclose.addEventListener(KeyboardEvent.KEY_DOWN, f_btncloseKEY_DOWN);
				cmbjenislaporan.addEventListener(KeyboardEvent.KEY_DOWN, f_cmbKEY_DOWN);
				m = new Menu();
				o = [{label: "PDF", icon: tbpdf, data: '0'},
					{label: "Excel", icon: tbexcel , data: '1'},
					{label: "HTML", icon: tbword , data: '2'},
					{label: "Doc", icon: tbhtml , data: '3'},
					{label: "Txt", icon: tbtxt , data: '4'},
					{label: "Jpg", icon: tbtif, data: '5'}];
				m.dataProvider = o;
				m.addEventListener("itemClick", f_mbExport);
				btnexport.popUp = m;
				cmbjenislaporan.setFocus();
				function f_mbPrint():void
				{
					if(cmbjenislaporan.textInput.text.length == 0){
						cmbjenislaporan.setFocus();
						Alert.show("Pilih Jenis Laporan dulu !", "Confirmation");
					}else{
						f_print();
//						parentApplication.F_wsSimpan(parentApplication.sptParam+'alertCetak', 'M'+mod+'_Print', parentApplication.userid, false, parentApplication.F_splitArrayToString([sumber, idtransaksi, notransaksi]));
					}
				}
				
				function f_mbExport(e:MenuEvent):void
				{
					
					if(cmbjenislaporan.textInput.text.length == 0){
						cmbjenislaporan.setFocus();
						Alert.show("Pilih Jenis Laporan dulu !", "Confirmation");
					}else{
						ex = e.item.data;
						f_print();
//						parentAppl/ication.F_wsSimpan(parentApplication.sptParam+'alertCetak', 'M'+mod+'_Print', parentApplication.userid, false, parentApplication.F_splitArrayToString([sumber, idtransaksi, notransaksi]));
					}
				}
				
				function f_mbClose():void
				{
					f_close();
				}
				function f_btnprintKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						f_mbPrint()
				}
				function f_btnexportKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						btnexport.open();
				}
				function f_btncloseKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						f_close();
				}
				function f_cmbKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						f_mbPrint()
				}
			}
			
			protected function titlewindow1_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ESCAPE)
					f_close();
			}
			
			protected function titlewindow1_closeHandler():void
			{
				f_close();
			}
			
			public function f_open():void
			{
				lblprint.text = "Print transaction (Cetak transaksi) : "+notransaksi+" ?";
				cmbjenislaporan.dataProvider = FlexGlobals.topLevelApplication.f_getReportAlertCetak(mod, menu);
				cmbjenislaporan.selectedIndex = 0;
				cmbjenislaporan.setFocus();
			}
			
			public function f_print():void
			{
				FlexGlobals.topLevelApplication.F_openReport(mod, menu, cmbjenislaporan.selectedItem.ritem, sumber+"id = "+idtransaksi, '', '', ex, param1);
				f_close();
			}
			
			protected function f_close():void
			{
				PopUpManager.removePopUp(this);
			}
		]]>
	</fx:Script>
	<s:Button id="btnprint" left="10" top="100" width="100" height="25" label="Print"
			  icon="{tbprint}"/>
	<mx:PopUpButton id="btnexport" left="112" top="100" width="100" height="25" label="Export"
					icon="{tbexport}" textAlign="left"/>
	<s:Button id="btnclose" right="10" top="100" width="100" height="25" label="Close" icon="{tbclose}"/>
	<s:BorderContainer left="10" right="10" top="10" bottom="43">
		<s:Label id="lblprint" y="17" left="8"
				 text="Print transaction (Cetak transaksi) : notransaksi ?"/>
		<s:Label y="49" left="8" text="Report"/>
		<s:ComboBox id="cmbjenislaporan" y="43" left="59" width="305"/>
	</s:BorderContainer>
</s:TitleWindow>