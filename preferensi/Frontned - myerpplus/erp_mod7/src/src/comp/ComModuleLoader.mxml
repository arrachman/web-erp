<?xml version="1.0" encoding="utf-8"?>
<s:ModuleLoader xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark"
				creationComplete="init()"
				xmlns:mx="library://ns.adobe.com/flex/mx">
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.IVisualElement;
			public function init():void 
			{
				addEventListener("loading" , onLoading);
				addEventListener("progress", onProgress);
				addEventListener("setup", onSetup);
				addEventListener("ready", onReady);
				addEventListener("error", onError);
				addEventListener("unload", onUnload);
//				mySWf.visible = true;
//				myLabel.visible = true;
				mybtn.visible = false;
				myLabel.text = "Loading...";
			}
			
			public function onLoading(event:Event):void 
			{
			}
			
			public function onUnload(event:Event):void 
			{
				mySWf.visible = true;
				myLabel.visible = true;
				mybtn.visible = false;
				myLabel.text = "Loading...";
			}
			
			
			public function onProgress(event:ProgressEvent):void 
			{
				mySWf.visible = true;
				myLabel.visible = true;
			}
			
			public function onSetup(event:Event):void 
			{
				mySWf.visible = true;
				myLabel.visible = true;
				mybtn.visible = false;
				myLabel.text = "Loading...";
			}
			
			public function onReady(event:Event):void 
			{
				mySWf.visible = false;
				myLabel.visible = false;
				mybtn.visible = false;
			}
			
			public function onError(event:Event):void 
			{
				mySWf.visible = false;
				myLabel.text = "Koneksi ke Menu " + url + " gagal. Silahkan coba lagi.";
				mybtn.visible = true;
			}
			
			protected function mybtn_clickHandler(event:MouseEvent):void
			{
				unloadModule();
				loadModule(url);
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<!--<s:Panel id="panel" width="100%" height="75">
		<mx:ProgressBar width="100%" id="progress" source="{this}"/>
	</s:Panel>-->
	<s:SWFLoader id="mySWf" autoLoad="true" horizontalCenter="0" scaleContent="true" source="mod/m0/m0_loading.swf" verticalCenter="0" visible="false"/>
	<s:Label id="myLabel" fontSize="20" horizontalCenter="0" text="Loading..." verticalCenter="42" visible="false"/>
	<s:Button label="Coba Lagi" horizontalCenter="0" verticalCenter="69" id="mybtn" visible="false" click="mybtn_clickHandler(event)"/>
</s:ModuleLoader>