<?xml version="1.0" encoding="utf-8"?>
<s:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009"
			   xmlns:s="library://ns.adobe.com/flex/spark"
			   xmlns:mx="library://ns.adobe.com/flex/mx"
			   height="276" width="198" keyDown="titlewindow1_keyDownHandler(event)" close="titlewindow1_closeHandler(event)"
			   creationComplete="titlewindow1_creationCompleteHandler(event)">
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.managers.PopUpManager;
			
			protected var i:int;
			public var data:String = '', kolom:String;
			
			protected function c(d:String):void
			{
				if(d == '.'){
					txtcal.text += '.';
				}else if(d == 'bs'){
					txtcal.text = txtcal.text.slice(0, txtcal.text.length-1);
					if(txtcal.text == '') txtcal.text = '0';
				}else if(d == 'akar'){
					txtcal.text = String( Math.sqrt( Number( eval(txtcal.text) ) ) );
				}else if(d == '+/-'){
				}else if(d == 'percent'){
					txtcal.text = String((Number(eval(txtcal.text))/100)*Number(eval(txtcal.text)));
				}else if(int(d) > 0 || txtcal.text.slice(txtcal.text.length-1, txtcal.text.length) == '0'){
					if(txtcal.text == '0')
						txtcal.text = d;
					else
						txtcal.text += d;
				}else {
					i = int(txtcal.text.slice(txtcal.text.length-1, txtcal.text.length));
					if(i > 0 || txtcal.text.slice(txtcal.text.length-1, txtcal.text.length) == '0')
						if(txtcal.text == '0')
							txtcal.text = d;
						else
							txtcal.text += d;
					else{
						txtcal.text = txtcal.text.slice(0, txtcal.text.length-1);
						if(txtcal.text == '')
							txtcal.text = '0';
						txtcal.text += d;
					}
				}
				
				function cekNumber(s:String):Number
				{
					for(i=s.length-1;i>0;i--){
						if(cekString(s.slice(i-1, i)) == false){
							if(cekString(s.slice(s.length-1, s.length)) == false){
								return Number(s.slice(i, s.length-1));
							}else
								return Number(s.slice(i, s.length));
						}
					}
					if(cekString(s.slice(s.length-1, s.length)) == false)
						return Number(s.slice(0, s.length-1));
					else
						return Number(s);
					function cekString(d:String):Boolean
					{
						if(d == '/' || d == '=' || d == '-' || d == '*')
							return false;
						else return true;
					}
				}
				
			}
			
			private function eval( str:String ):String
			{ 
				var n:String, s:String
				if ( ExternalInterface.available )
				{
					i = int(txtcal.text.slice(txtcal.text.length-1, txtcal.text.length));
					if(i <= 0 && String(i) != str && txtcal.text.slice(txtcal.text.length-1, txtcal.text.length) != '0'){
						s = txtcal.text.slice(txtcal.text.length-1, txtcal.text.length);
						str = txtcal.text.slice(0, txtcal.text.length-1);
						n = ExternalInterface.call ( "eval", str );
						str = n+s+n;
						return ExternalInterface.call ( "eval", str );
					}else{
						return ExternalInterface.call ( "eval", str );
					}
				}
				else 
				{
					return "Unavailable"
				}
			}
			
			protected function titlewindow1_keyDownHandler(event:KeyboardEvent):void
			{
				switch(event.keyCode){
					case Keyboard.ESCAPE:PopUpManager.removePopUp(this);break;
					case Keyboard.NUMPAD_ADD:c('+');break;
					case Keyboard.NUMPAD_DECIMAL:c('.');break;
					case Keyboard.NUMPAD_DIVIDE:c('/');break;
					case Keyboard.NUMPAD_ENTER:txtcal.text = eval(txtcal.text);break;
					case Keyboard.NUMPAD_MULTIPLY:c('*');break;
					case Keyboard.NUMPAD_SUBTRACT:c('-');break;
					case Keyboard.ENTER:
						if(event.ctrlKey){
							txtcal.text = eval(txtcal.text)
							if(parentApplication.m[parentApplication.idmod].child.hasOwnProperty('f_setProperty'))
								parentApplication.m[parentApplication.idmod].child.f_setProperty('calculator', kolom, txtcal.text);
							PopUpManager.removePopUp(this);
						}
						break;
				}
			}
			
			protected function titlewindow1_closeHandler(event:CloseEvent):void
			{
				PopUpManager.removePopUp(this);
			}
			
			protected function txtcal_creationCompleteHandler(event:FlexEvent):void
			{
				txtcal.restrict = ".0-9\\-+*";
				txtcal.maxChars = 15;
				txtcal.setFocus();
				txtcal.text = '0';
				this.title = 'Calculator';
			}
			
			protected function txtcal_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER)
					txtcal.text = eval(txtcal.text)
			}
			
			protected function titlewindow1_creationCompleteHandler(event:FlexEvent):void
			{
				if(data != ''){
					data = data.split(parentApplication.m.nfNominal.decimalSeparator).join('.')
					txtcal.text = data;
				}
				txtcal.setFocus();
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				txtcal.text = eval(txtcal.text);
				if(parentApplication.m[parentApplication.idmod].child.hasOwnProperty('f_setProperty'))
					parentApplication.m[parentApplication.idmod].child.f_setProperty('calculator', kolom, txtcal.text);
				PopUpManager.removePopUp(this);
			}
			
		]]>
	</fx:Script>
	<s:Group left="10" top="10">
		<s:TextInput id="txtcal" x="0" y="0" width="176" creationComplete="txtcal_creationCompleteHandler(event)" keyDown="txtcal_keyDownHandler(event)"/>
		<s:Button click="c('bs')" x="0" y="25" width="68" height="30" label="⌫" cornerRadius="0"/>
		<s:Button click="txtcal.text = '0'" x="72" y="26" width="32" height="30" label="C" cornerRadius="0"/>
		<s:Button click="c('1')" x="0" y="59" width="32" height="30" label="1" cornerRadius="0"/>
		<s:Button click="c('4')" x="0" y="92" width="32" height="30" label="4" cornerRadius="0"/>
		<s:Button click="c('7')" x="0" y="126" width="32" height="30" label="7" cornerRadius="0"/>
		<s:Button click="c('2')" x="36" y="59" width="32" height="30" label="2" cornerRadius="0"/>
		<s:Button click="c('3')" x="72" y="59" width="32" height="30" label="3" cornerRadius="0"/>
		<s:Button click="c('+')" x="108" y="160" width="32" height="30" label="+" cornerRadius="0"/>
		<s:Button click="c('+/-')" x="108" y="26" width="32" height="30" label="±" cornerRadius="0"/>
		<s:Button click="c('akar')" x="144" y="26" width="32" height="30" label="√" cornerRadius="0"/>
		<s:Button click="c('percent')" x="144" y="59" width="32" height="30" label="%" cornerRadius="0"/>
		<s:Button click="c('5')" x="36" y="92" width="32" height="30" label="5" cornerRadius="0"/>
		<s:Button click="c('6')" x="72" y="92" width="32" height="30" label="6" cornerRadius="0"/>
		<s:Button click="c('-')" x="108" y="126" width="32" height="30" label="-" cornerRadius="0"/>
		<s:Button click="c('8')" x="36" y="126" width="32" height="30" label="8" cornerRadius="0"/>
		<s:Button click="c('0')" x="0" y="160" width="68" height="30" label="0" cornerRadius="0"/>
		<s:Button click="c('.')" x="72" y="160" width="32" height="30" label="." cornerRadius="0"/>
		<s:Button click="c('9')" x="72" y="126" width="32" height="30" label="9" cornerRadius="0"/>
		<s:Button click="c('*')" x="108" y="92" width="32" height="30" label="*" cornerRadius="0"/>
		<s:Button click="c('/')" x="108" y="59" width="32" height="30" label="/" cornerRadius="0"/>
		<s:Button click="txtcal.text = eval(txtcal.text)" x="144" y="92" width="32" height="98" label="=" cornerRadius="0"/>
		<s:Button click="button1_clickHandler(event)" x="0" y="194" width="176" height="30" label="OK" cornerRadius="0"/>
	</s:Group>
</s:TitleWindow>