		<s:ComboBox id="cmboperator" left="154" top="0" width="65" height="25"
					dataProvider="{pengkondisi}" labelField="field" selectedIndex="0"/>
		<s:TextInput id="txtfilter" left="226" top="0" height="25" width="315" keyDown="f_txtFilterKeyDown(event)"/>
		<s:Button id="btnFilter" width="90" height="25" left="548" top="0" label="Filter" click="f_filter(event)"/>
	</s:Group>
	<s:DataGrid id="dg" left="10" right="10" top="42" bottom="40" editable="false"/>
	<s:Group left="10" bottom="10">
