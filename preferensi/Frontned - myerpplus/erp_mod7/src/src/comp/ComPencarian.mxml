				if(this.width > 700)this.width = 700;
				
				function set(width:int = 0, dataField:String = '', headerText:String = '', align:int = 0, labelFunction:Function = undefined):void
				{
					var headerRenderer:IFactory, itemRenderer:IFactory;
					vWidth += width;
					if(align==0){
						headerRenderer = p.vLeftHeader;
						itemRenderer = p.vLeftItem;
					}else if(align==1){
						headerRenderer = p.vCenterHeader;
						itemRenderer = p.vCenterItem;
					}else if(align==2){
						headerRenderer = p.vRightHeader;
						itemRenderer = p.vRightItem;
					}
					cmbFilter.dataProvider.addItem({l:headerText, v:dataField});
					dg.columns.addItem(p.F_tambahKolomGrid(width, dataField, headerText, false, true, labelFunction, headerRenderer, itemRenderer, undefined));
				}
				
				function l(s:String):String
				{
					return  FlexGlobals.topLevelApplication.l(s);
				}
			}
			
			
			import flashx.textLayout.elements.BreakElement;
			
			import mx.collections.ArrayCollection;
			import mx.collections.ArrayList;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.managers.PopUpManager; 
			
			[Bindable] [Embed(source="assets/nav/f.png")]  public var navf:Class; //First
			[Bindable] [Embed(source="assets/nav/p.png")]  public var navp:Class; //Previous
			[Bindable] [Embed(source="assets/nav/n.png")]  public var navn:Class; //Next
			[Bindable] [Embed(source="assets/nav/l.png")]  public var navl:Class; //Last
			[Bindable] public var pengkondisi:ArrayCollection = new ArrayCollection([{field:"Berisi"},{field:"="},{field:"<>"},{field:">"},{field:"<"},{field:">="},{field:"<="},{field:"Diawali"},{field:"Diakhiri"}]);
			[Bindable] public var arr:ArrayCollection = new ArrayCollection;
			public var kondisi:String = '', vPaket:String, vModeCB:Boolean, vSort:String = '', i:int, vFilterDefault:String, idmodule:String, vTarget:String, vFocus:Boolean = false, vWidth:int = 0, o:Object, p:Object;
			protected var sort:String = '', validasi:Boolean, judul:String;
			
			protected function f_initializeHandler():void
			{
				p = parentApplication;
				dg.setStyle("alternatingRowColors", ['#FFFFFF', '#EFF3FA']);
				FlexGlobals.topLevelApplication.F_ComboBoxStandardFilter([cmbFilter]);
				this.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				dg.addEventListener(flash.events.MouseEvent.DOUBLE_CLICK, f_dgDOUBLE_CLICK);
				dg.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_dgKEY_DOWN);
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				btnbatal.addEventListener(MouseEvent.CLICK, f_batalCLICK);
				btnpilih.addEventListener(MouseEvent.CLICK, f_pilihCLICK);
				txtpaging.restrict = "0-9";
				txtpaging.addEventListener(FocusEvent.FOCUS_OUT,TextfocusOutHandler);
				txtpaging.addEventListener(FocusEvent.FOCUS_IN,TextfocusInHandler);
				txtpaging.setStyle("textAlign","center");
				
				txtpaging.maxChars = 4;
				
				dg.dataProvider = new ArrayCollection;
				dg.columns = new ArrayList;
				dg.sortableColumns = false;
				cmbFilter.dataProvider = new ArrayCollection;
				function TextfocusInHandler(event:FocusEvent):void
				{
					event.currentTarget.text = event.currentTarget.text.split(",").join("");
				}
				
				function TextfocusOutHandler(event:FocusEvent):void
				{
					txtpaging.text = p.m.nfNumber.format(txtpaging.text);
				}
				
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.HOME:
							f_firstCLICK();
							break;
						case Keyboard.PAGE_UP:
							f_previousCLICK();
							break;
						case Keyboard.PAGE_DOWN:
							f_nextCLICK();
							break;
						case Keyboard.END:
							f_lastCLICK();
							break;
						case Keyboard.ESCAPE:
							f_batal();
							break;
					}
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if (int(txtpaging.text)>0 && int(txtpaging.text)<=int(txtpaging.text))
							f_paketFilter(int(txtpaging.text));
				}
				
				function f_dgDOUBLE_CLICK():void
				{
					if(vModeCB == false && dg.selectedIndex >= 0)		
						f_pilih();
				}
				
				function f_dgKEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.UP:
							if(dg.selectedIndex == 0 && vFocus == true)txtfilter.setFocus();
							else if(dg.selectedIndex == 0)vFocus = true;
							break;
						case Keyboard.DOWN:
							vFocus = false;
							break;
						case Keyboard.ENTER:
							if(vModeCB == true)select();
							else f_pilihCLICK();
							break;
						case Keyboard.SPACE:
							if(vModeCB == true)select();
							break; 
					}
					
					function select():void
					{
						if(dg.dataProvider.getItemAt(dg.selectedIndex).cb == true)
							f_select(false, dg.selectedIndex);
						else
							f_select(true, dg.selectedIndex);
					}
				}
				
				function f_firstCLICK():void
				{
					if(int(txtpaging.text)>1)
						f_paketFilter();
				}
				
				function f_previousCLICK():void
				{
					if(int(txtpaging.text)-1>0)
						f_paketFilter(int(txtpaging.text)-1);
				}
				
				function f_nextCLICK():void
				{
					f_paketFilter(int(txtpaging.text)+1);
				}
				
				function f_lastCLICK():void
				{
					f_paketFilter(-1);
				}
				
				function f_batalCLICK():void
				{
					f_batal();
				}
				
				function f_pilihCLICK():void
				{
					f_pilih();
				}
			}
			
			public function f_kondisiAwal():void
			{
				txtpaging.text="1";
				vWidth = 0;
				dg.columns.removeAll();
				if(vModeCB == false){
					dg.doubleClickEnabled = true; 
				}else{
					dg.doubleClickEnabled = false; 
					dg.columns.addItem(p.F_tambahKolomGrid(30, 'cb', '', false, true, undefined, new ClassFactory(ir_checkBoxHeader), new ClassFactory(ir_checkBox)));
				}
				arr.removeAll();
				cmbFilter.dataProvider.removeAll();
				f_buatPaket();
				cmbFilter.selectedIndex = 1;
				validasi = false;
				dg.dataProvider.removeAll();
				txtfilter.text = '';
				cmboperator.selectedIndex = 0;
				p.F_wsSearch("★bukacompencarian", vPaket, 1, 10, vFilterDefault, vSort);
			}
			
			public function f_persiapan():void
			{
				var j:int, ob:Object, b:Boolean, x:int;
				o = p.wsArrUtama.getItemAt;
				ob = arr.getItemAt;
				for(i=0;i<arr.length;i++){
					dg.dataProvider.addItem({cb:true});
					for(j=0;j<p.vKolomLength;j++)
						dg.dataProvider.setItemAt(arr.getItemAt(i), dg.dataProvider.length-1);
				}
				
				for(i=0;i<p.wsArrUtama.length;i++){
					b = true;
					for(j=0;j<arr.length;j++){
						if(o(i)[dg.columns.getItemAt(1).dataField] == ob(j)[dg.columns.getItemAt(1).dataField] && o(i)[dg.columns.getItemAt(2).dataField] == ob(j)[dg.columns.getItemAt(2).dataField] && o(i)[dg.columns.getItemAt(3).dataField] == ob(j)[dg.columns.getItemAt(3).dataField]){
							b = false;
							break;
						}
					}
					if(b == true){
						dg.dataProvider.addItem({cb:false});
						for(x=0;x<p.vKolomLength;x++)
							dg.dataProvider.setItemAt(o(i), dg.dataProvider.length-1);
					}
				}
				p.F_dgRefresh(dg);
				imgfirst.enabled = p.wsIsPrev;
				imgprevious.enabled = p.wsIsPrev;
				imgnext.enabled = p.wsIsNext;
				imglast.enabled = p.wsIsNext;
				txtpaging.text = p.wsCurPage;
				if(dg.dataProvider.length >= 0){
					dg.setFocus();
					dg.selectedIndex = 0;
					txtfilter.setFocus();
				}
				validasi = true;
			}  
			
			public function f_select(b:Boolean, idx:int):void
			{
				var ob:Object = dg.dataProvider.getItemAt(idx), j:int;
				if(b == true){
					arr.addItem({});
					for(j=0;j<p.vKolomLength;j++)
						arr.setItemAt(ob, arr.length-1);
					ob.cb = true;
				}else{
					ob.cb = false;
					for(i=0;i<arr.length;i++){
						o = arr.getItemAt(i);
						if(o[dg.columns.getItemAt(0).dataField] == ob[dg.columns.getItemAt(0).dataField] && o[dg.columns.getItemAt(1).dataField] == ob[dg.columns.getItemAt(1).dataField] && o[dg.columns.getItemAt(2).dataField] == ob[dg.columns.getItemAt(2).dataField]){
							arr.removeItemAt(i);
							break;
						}
					}
				}
				arr.refresh();
				p.F_dgRefresh(dg);
			}
			
			public function f_paketFilter(page:int=1):void
			{
				var tot:int=10;
				var ori:String="";
				if(vFilterDefault!='' && txtfilter.text!='')
				{
					ori = vFilterDefault;
					vFilterDefault = vFilterDefault + " and";
				}
				if(vSort == '')vSort = sort;
				dg.dataProvider.removeAll();
				if(txtfilter.text == '')
					p.F_wsSearch("★caridatacombo", vPaket, page, tot, vFilterDefault, vSort);
				else{
					switch(cmboperator.selectedIndex){
						case 0:vFilterDefault+=" "+cmbFilter.selectedItem.v+" like '%"+txtfilter.text+"%'"; break;
						case 1:vFilterDefault+=" "+cmbFilter.selectedItem.v+" ='"+txtfilter.text+"'"; break;
						case 2:vFilterDefault+=" "+cmbFilter.selectedItem.v+" <> '"+txtfilter.text+"'";	break;
						case 3:vFilterDefault+=" "+cmbFilter.selectedItem.v+" > '"+txtfilter.text+"'";	break;
						case 4:vFilterDefault+=" "+cmbFilter.selectedItem.v+" < '"+txtfilter.text+"'"; break;
						case 5:vFilterDefault+=" "+cmbFilter.selectedItem.v+" >= '"+txtfilter.text+"'";	break;
						case 6:vFilterDefault+=" "+cmbFilter.selectedItem.v+" <= '"+txtfilter.text+"'"; break;
						case 7:vFilterDefault+=" "+cmbFilter.selectedItem.v+" like '"+txtfilter.text+"%'"; break;
						case 8:vFilterDefault+=" "+cmbFilter.selectedItem.v+" like '%"+txtfilter.text+"'";	break;
					}
					p.F_wsSearch("★caridatacombo", vPaket, page, tot, vFilterDefault, vSort);
				}
				if(vFilterDefault!='' && txtfilter.text!='')
				{
					vFilterDefault = ori;
				}
			}
			
			protected function f_filter(event:MouseEvent):void
			{
				f_paketFilter();
			}
			
			protected function f_txtFilterKeyDown(event:KeyboardEvent):void
			{
				if(event.keyCode==Keyboard.ENTER)
					if(txtfilter.text.length > 0)
						f_paketFilter();
					else dg.setFocus();
				else if(event.keyCode==Keyboard.DOWN)
				{
					dg.selectedIndex = 0;
					dg.setFocus();
				}
			}

			public function f_cbClick():void
			{
				if(dg.dataProvider.getItemAt(dg.selectedIndex).cb == true)
					f_select(true, dg.selectedIndex);
				else
					f_select(false, dg.selectedIndex);
			}
			
			protected function f_pilih():void
			{
				if(validasi == true && dg.selectedIndex >= 0){
					PopUpManager.removePopUp(this);
					if(vModeCB == false) 
						if(dg.selectedIndex >= 0){
							arr.addItem({});
							for(i=0;i<p.vKolomLength;i++)
								arr.setItemAt(dg.dataProvider.getItemAt(dg.selectedIndex), arr.length-1);
						}else arr = null;
					arr.refresh();
					p.wsSuccess = true;
					p.subject = vTarget;
					p.wsArrUtama = arr;
					p.m[idmodule].child.f_wsHasil();
					p.F_csTrue();
					parentApplication.m.bukacompencarian = false;
				}
			} 
			
			protected function f_batal():void
			{
				if(validasi == true){
					p.F_csFalse();
					PopUpManager.removePopUp(this);
					p.wsSuccess = false;
					p.subject = vTarget;
					p.vpFocusEvent = true;
//					p.m[idmodule].child.f_wsHasil();
					parentApplication.m.bukacompencarian = false;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var x:int;
				if(components == 'checkBoxHeader')
					for(x=0;x<dg.dataProviderLength;x++){
						if(dg.dataProvider.getItemAt(x).cb != data)
							f_select(data, x);
					}
				else if(components == 'checkBox')
					f_cbClick();
			}
		]]>
	</fx:Script>
	<s:Group left="10" top="10">
