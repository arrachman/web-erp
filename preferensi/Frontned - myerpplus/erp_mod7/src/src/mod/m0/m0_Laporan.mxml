			protected function cmbreport_changeHandler(event:IndexChangeEvent):void
			{
				o.d = cmbreport.dataProvider[cmbreport.selectedIndex].rid;
				if(parentApplication.m.laporan.hasOwnProperty(o.i)){
					if(parentApplication.m.laporan[o.i].hasOwnProperty(o.d)){
						b = parentApplication.m.laporan[o.i][o.d][0].property;
						ob = parentApplication.m.laporan[o.i][o.d][1];
						gb = parentApplication.m.laporan[o.i][o.d][2];
						f_add();
					}else{
						grpf.removeAllElements();
						grpo.removeAllElements();
						grpg.removeAllElements();
					}
				}else{
