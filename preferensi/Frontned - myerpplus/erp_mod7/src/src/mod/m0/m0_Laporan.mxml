						}
					}
				}else{
					// 9.2 Result WS False		
					if(parentApplication.F_validasiFalse(s) == true){
					}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				for(i=0;i<b.length;i++){
					if(('item'+[i]) == target){
						o['item'+[i]].text = '';
						break;
					}else if(('item2'+[i]) == target){
						o['item2'+[i]].text = '';
