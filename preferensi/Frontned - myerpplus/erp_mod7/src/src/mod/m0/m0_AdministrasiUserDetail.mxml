			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Simpan" icon="tbsave"/>
					<topmenu label="Batal" icon="tbcancel"/>
					<topmenu label="Ganti Password" icon="mainpassword"/>
					<topmenu label="Photo" icon="tbphoto">
						<topmenu label="Browse File" icon="tbaddphoto"/>
						<topmenu label="Via Web Camera" icon="tbwebcam"/>
					</topmenu>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
		<net:FileReference id="fileReference"  select="fileReference_select(event);" complete="fileReference_complete(event);" />
	</fx:Declarations>
