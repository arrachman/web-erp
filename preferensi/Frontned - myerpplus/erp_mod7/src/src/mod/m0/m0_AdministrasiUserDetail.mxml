			<s:Group id="grp" left="10" top="0" bottom="0" right="0">
				<s:TextInput id="txtkode" left="108" top="0"/>
				<s:TextInput id="txtnama" left="108" top="21" width="191"/>
				<s:TextInput id="txtpassword" left="108" top="42" width="191" displayAsPassword="true"/>
				<s:TextInput id="txtkontak" left="108" top="63" width="100"/>
