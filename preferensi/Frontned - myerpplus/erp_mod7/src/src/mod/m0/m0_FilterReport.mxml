			public function f_getProperty(components:String, dataField:String, data:Boolean, info:String = ''):Object
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'k')
							return new ArrayCollection([{l:'String', v:0}, {l:'Pencarian', v:1}, {l:'Date', v:2}, {l:'ComboBox', v:3}, {l:'Angka', v:4}]);
						break;
				}
				return new ArrayCollection([]);
			}
			
			public function f_focusOnMe():void
			{
				mb.setFocus();
			}
			
			[Bindable] [Embed(source="assets/main/doubleright.gif")]  public var tbdoubleright:Class;
			protected function f_persiapan():void
			{
				BtnLinkJudul.label = parentApplication.l(BtnLinkJudul.label);
				function tbdownarrow():Class
				{
					[source="assets/main/doubleright.gif"] var a:Class;
					return a;
				}
				FlexGlobals.topLevelApplication.F_wsGetDataById('MenuTree', 'M0_MenuTree', parentApplication.ubahasa, 0, 0, 'mid <> 0', "mntype = 4")
				cmbreport.dataProvider = FlexGlobals.topLevelApplication.f_getReportMenuLaporan(idmodule, idmenu);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbreport]);
				btnbottom.setStyle('icontop', tbdoubleright);
				
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RegGrid(0, 8, [dgFilter, dgOrderBy, dgGroupBy], 'transaksi');
				dgFilter.addEventListener(KeyboardEvent.KEY_DOWN, f_dgFilter);
				dgGroupBy.addEventListener(KeyboardEvent.KEY_DOWN, f_dgGroupBy);
				dgOrderBy.addEventListener(KeyboardEvent.KEY_DOWN, f_dgOrderBy);
				function f_dgFilter(e:KeyboardEvent):void{
					f_GRID_KEY_DOWN(e, (dgFilter.dataProvider as ArrayCollection), dgFilter);
				}
				function f_dgGroupBy(e:KeyboardEvent):void{
					f_GRID_KEY_DOWN(e, (dgGroupBy.dataProvider as ArrayCollection), dgGroupBy);
				}
				function f_dgOrderBy(e:KeyboardEvent):void{
					f_GRID_KEY_DOWN(e, (dgOrderBy.dataProvider as ArrayCollection), dgOrderBy);
				}
				function f_GRID_KEY_DOWN(e:KeyboardEvent, ac:ArrayCollection, dg:DataGrid):void{
					switch(e.keyCode){
						case Keyboard.UP:
							if(e.ctrlKey && p.rowIndex > 0){
								o.g = ac.getItemAt(p.rowIndex-1);
								ac.setItemAt(ac.getItemAt(p.rowIndex), p.rowIndex-1);
								ac.setItemAt(o.g, p.rowIndex);
								ac.getItemAt(p.rowIndex-1).no = p.rowIndex;
								ac.getItemAt(p.rowIndex).no = p.rowIndex+1;
								dg.setSelectedCell(p.rowIndex-1, p.columnIndex);
							} 
							break;
						case Keyboard.DOWN:
							if(e.ctrlKey && p.rowIndex < ac.length-1){
								o.g = ac.getItemAt(p.rowIndex+1);
								ac.setItemAt(ac.getItemAt(p.rowIndex), p.rowIndex+1);
								ac.setItemAt(o.g, p.rowIndex);
								ac.getItemAt(p.rowIndex+1).no = p.rowIndex+2;
								ac.getItemAt(p.rowIndex).no = p.rowIndex+1;
								dg.setSelectedCell(p.rowIndex+1, p.columnIndex);
							}						
							break;
					}
				}
				
				o.first = true;
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				
				function f_mbSimpan():void{ 
					if(lblmenu.text.length == 0)
						Alert.show('Pilih Menu dulu', 'Informasi');
					else if(cmbreport.selectedIndex < 0)
						Alert.show('Pilih Jenis Report dulu', 'Informasi');
					else f_simpan();	
				}
			}
			
			
			public function f_wsHasil():void
			{
				var a:Array, j:Object, n:int;
				if(p.subject == 'MenuTree'){
					o.ArrTreeItem = p.ob_resultWs.split("Θ")[1].split("|");
					tree.dataProvider = XML(o.ArrTreeItem[0]);
					ExpandMenuPertama = true;
					
					var btn:spark.components.Button;
					var wsArrUtamaf:ArrayCollection=new ArrayCollection;
					wsArrUtamaf = p.f_ArrDetail(p.ob_resultWs.split("Θ")[0]);
					var jmlModuleAktif:int=wsArrUtamaf.length;
					
					vx.removeAllChildren();
					p.arrModule.removeAll();
					o.mod = []; 
					o.id = []; 
					for (i = 0; i < jmlModuleAktif; i++)
					{
						btn = new Button();
						btn.label = wsArrUtamaf[i].f2;
						btn.id = String(i);
						o.id[i] = wsArrUtamaf[i].f0;
						btn.styleName="parent";
						btn.useHandCursor = true;
						btn.buttonMode = true; 
						p.arrModule.addItem({mid:wsArrUtamaf[i].f0,mname:wsArrUtamaf[i].f2})
						if(wsArrUtamaf[i].f0 == "0"){btn.setStyle("icon", iconm0)}
						if(wsArrUtamaf[i].f0 == "1"){btn.setStyle("icon", iconm1)}
						if(wsArrUtamaf[i].f0 == "2"){btn.setStyle("icon", iconm2)}
						if(wsArrUtamaf[i].f0 == "3"){btn.setStyle("icon", iconm3)}
						if(wsArrUtamaf[i].f0 == "4"){btn.setStyle("icon", iconm4)}
						if(wsArrUtamaf[i].f0 == "5"){btn.setStyle("icon", iconm5)}
						if(wsArrUtamaf[i].f0 == "6"){btn.setStyle("icon", iconm6)}
						if(wsArrUtamaf[i].f0 == "7"){btn.setStyle("icon", iconm7)}
						if(wsArrUtamaf[i].f0 == "8"){btn.setStyle("icon", iconm8)}
						btn.addEventListener(MouseEvent.CLICK, f_btnModuleClick);
						btn.percentWidth = 100;
						btn.height = 30;
						o.mod[i] = btn;
						vx.addChild(btn);
						if(i==0){
							moduleid = o.id[i];
							BtnLinkJudul.label = wsArrUtamaf[i].f2;
						}
					}
					vx.height = jmlModuleAktif * 30;
					with (BoxGrupMenu){
						height = vx.height+28;
						maxHeight = height;
						minHeight = (4 * 30) + 28;	
					}
					
					function f_btnModuleClick(event:Event):void {
						moduleid = o.id[int(event.currentTarget.id)];
						tree.dataProvider = XML(o.ArrTreeItem[event.currentTarget.id]);
						BtnLinkJudul.label = event.currentTarget.label;
						ExpandMenuPertama=true;
					}
				}else if(p.subject == 'set'){
					FlexGlobals.topLevelApplication.F_wsJson('get', 'M0_GetFileLibrary', '/app/libs/report');
				}else if(p.subject == 'get'){
					if(parentApplication.wsSuccess)
						parentApplication.m.laporan = FlexGlobals.topLevelApplication.wsJson.form;
					else
						Alert.show('File report.json Not Found', 'Information');
				}
			}
			
			protected function f_treeClick(event:ListEvent):void
			{
				if(o.first == true){
					lbljenis.visible = true;
					lblmenu.visible = true;
					cmbreport.visible = true;
					tab.visible = true;
				}
				selectedNode=Tree(event.target).selectedItem as XML;
				var StrLabel:String = selectedNode.@l;
				var IsPopup:int = selectedNode.@p;
				var StrURL:String = selectedNode.@u;
				var Tinggi:int = selectedNode.@tg;
				var Lebar:int = selectedNode.@lb;
				var Tipe:String = selectedNode.@t;
				var j:Object, n:int, x:int, d:int;
				idmenu = selectedNode.@id;
				o.b = false;
				lblmenu.text = StrLabel;
				cmbreport.dataProvider = FlexGlobals.topLevelApplication.f_getReportMenuLaporan(moduleid, selectedNode.@idt);
				cmbreport.selectedIndex = 0;
				for(i=0;i<parentApplication.m.laporan.length;i++){
					if(parentApplication.m.laporan[i].n == moduleid+"_"+idmenu){
						idmodule = moduleid;
						o.ar1 = [];
						for(x=0;x<cmbreport.dataProvider.length;x++){
							o.d = cmbreport.dataProvider[x].rid;
							o.ar1[x] = {};
							o.ar1[x].a = o.d;
							if(parentApplication.m.laporan[i].hasOwnProperty(o.d)){
								o.ar1[x].dgFilter = new ArrayCollection(parentApplication.m.laporan[i][o.d][0].property);
								o.ar1[x].dgOrderBy = new ArrayCollection(parentApplication.m.laporan[i][o.d][1].property);
								o.ar1[x].dgGroupBy = new ArrayCollection(parentApplication.m.laporan[i][o.d][2].property);
								o.ar1[x].nsob = int(parentApplication.m.laporan[i][o.d][1].id);
								o.ar1[x].nsgb = int(parentApplication.m.laporan[i][o.d][2].id);
								for(d=0;d<o.ar1[x].dgFilter.length;d++)
									o.ar1[x].dgFilter[d].no = (d+1);
								for(d=0;d<o.ar1[x].dgOrderBy.length;d++)
									o.ar1[x].dgOrderBy[d].no = (d+1);
								for(d=0;d<o.ar1[x].dgGroupBy.length;d++)
									o.ar1[x].dgGroupBy[d].no = (d+1);
							}else{
								o.ar1[x].dgFilter = new ArrayCollection;
								o.ar1[x].dgOrderBy = new ArrayCollection;
								o.ar1[x].dgGroupBy = new ArrayCollection;
								o.ar1[x].nsob = 1;
								o.ar1[x].nsgb = 1;
								dgFilter.dataProvider = o.ar1[x].dgFilter;
								dgOrderBy.dataProvider = o.ar1[x].dgOrderBy;
								dgGroupBy.dataProvider = o.ar1[x].dgGroupBy;
								FlexGlobals.topLevelApplication.F_defaultGrid([dgFilter, dgGroupBy, dgOrderBy]);
							}
						}
						if(o.ar1.length == 0)
							tab.visible = false;
						else{
							tab.visible = true;
							dgFilter.dataProvider = o.ar1[0].dgFilter;
							dgOrderBy.dataProvider = o.ar1[0].dgOrderBy;
							dgGroupBy.dataProvider = o.ar1[0].dgGroupBy;
							nsob.value = int(o.ar1[0].nsob);
							nsgb.value = int(o.ar1[0].nsgb);
						}
						o.b = true;
						break;
					}
				}
				
				if(o.b == false){
					if(cmbreport.dataProvider.length > 0){
						idmodule = moduleid;
						o.ar1 = [];
						for(x=0;x<cmbreport.dataProvider.length;x++){
							o.d = cmbreport.dataProvider[x].rid;
							o.ar1[x] = {};
							o.ar1[x].a = o.d;
							o.ar1[x].dgFilter = new ArrayCollection;
							o.ar1[x].dgOrderBy = new ArrayCollection;
							o.ar1[x].dgGroupBy = new ArrayCollection;
							o.ar1[x].nsob = 1;
							o.ar1[x].nsgb = 1;
							dgFilter.dataProvider = o.ar1[x].dgFilter;
							dgOrderBy.dataProvider = o.ar1[x].dgOrderBy;
							dgGroupBy.dataProvider = o.ar1[x].dgGroupBy;
							FlexGlobals.topLevelApplication.F_defaultGrid([dgFilter, dgGroupBy, dgOrderBy]);
						}
						dgFilter.dataProvider = o.ar1[0].dgFilter;
						dgOrderBy.dataProvider = o.ar1[0].dgOrderBy;
						dgGroupBy.dataProvider = o.ar1[0].dgGroupBy;
						nsob.value = int(o.ar1[0].nsob);
						nsgb.value = int(o.ar1[0].nsgb);
						tab.visible = true;
						return;
					}else{
						tab.visible = false;
					}
				}
				
				FlexGlobals.topLevelApplication.F_dgRefresh(dgFilter);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgGroupBy);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgOrderBy);
			}
			
			protected function ExpandFavorit():void {
				if(ExpandMenuPertama == true){
					ExpandMenuPertama=false;
					tree.selectedIndex  = 0;
					selectedNode=tree.selectedItem as XML;
					tree.expandItem(selectedNode, true, false);
				}
			}
			
			protected function vx_resizeHandler(event:ResizeEvent):void
			{
				p = parentApplication;
				vx.height = BoxGrupMenu.height-28;
				vx.validateNow();
				if(event.oldHeight > BoxGrupMenu.height){
					// turun 
					if(parentApplication.m.objTemp.hasOwnProperty('mod'))
						if(o.mod[int(vx.height/30)] != null){
							for(i=int(vx.height/30);i<o.mod.length;i++){
								if(o.mod.length > (i+1)){
									o.mod[i+1].height = 28;
									o.mod[i+1].width = 28;
									hxbottom.addChild(o.mod[i+1]);
								}
							}
							if(((vx.height/30)-int(vx.height/30)) <= 0.1){
								o.mod[int(vx.height/30)].height = 28;
								o.mod[int(vx.height/30)].width = 28;
								hxbottom.addChildAt(o.mod[int(vx.height/30)], 0);
							} 
							if(bHxbottom == false){
								bHxbottom = true
								hxbottom.removeChild(btnbottom);
							}
						}
				}else{
					// naik
					if(parentApplication.m.objTemp.hasOwnProperty('mod'))
						if(o.mod[int(vx.height/30)] != null){
							for(i=0;i<int(vx.height/30);i++){
								if(o.mod.length > (i+1)){
									o.mod[i].height = 30;
									o.mod[i].percentWidth = 100;
									vx.addChildAt(o.mod[i], i);
								}
							}
							if(((vx.height/30)-int(vx.height/30)) > 0.1){
								o.mod[int(vx.height/30)].height = 30;
								o.mod[int(vx.height/30)].percentWidth = 100;
								vx.addChild(o.mod[int(vx.height/30)]);
							}
							if(hxbottom.numChildren == 0){
								bHxbottom = false;
								hxbottom.addChild(btnbottom);
							}
						}
				}
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				o.a = column.split('|');
				if(column == 'add' || o.a[0] == 'add'){
					if(o.a.length == 1)o.d = dg.dataProvider[dg.dataProviderLength-1];
					else o.d = dg.dataProvider[o.a[1]];
					o.d.l = parentApplication.l("New Komp")+" "+o.d.no;
					o.d.f = "";
					o.d.k = 0;
					o.d.w = 128;
					o.d.p = '';
					o.d.s = 0;
					if(o.a.length == 1)p.F_dgColumnRefresh(dg, dg.dataProviderLength-1);
					else p.F_dgColumnRefresh(dg, o.a[1]);
					o.a = null;
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch(components){
					case 'comboBox':
						if(dataField == 'k'){
							o.o = dgFilter.dataProvider[p.rowIndex];
							switch(data){
								case 0:
									o.o.w = 128;
									o.o.p = "";
									break;
								case 1:
									o.o.w = 128;
									o.o.p = "▼CdM1_Currency▼ckode▼▼0";
									break;
								case 2:
									o.o.w = 153;
									o.o.p = FlexGlobals.topLevelApplication.DefaultTanggal;
									break;
								case 3:
									o.o.w = 146;
									o.o.p = "0|New Item 1▼item1▲New Item 2▼item2▲New Item 3▼item3▲New Item 4▼item4▲New Item 5▼item5";
									break;
								case 4:
									o.o.w = 128;
									o.o.p = 0;
									break;
							}
							FlexGlobals.topLevelApplication.F_dgColumnRefresh(dgFilter, p.rowIndex);
						}
						break;
					case 'config':
						p.rowIndex = dgFilter.selectedCell.rowIndex;
						if(dataField == 'p')
							if(dgFilter.dataProvider[p.rowIndex].k == 0)
								FlexGlobals.topLevelApplication.openFormX("Property", 1, "mod/m0/m0_FilterReportProperty.swf", 70, 210);
							else if(dgFilter.dataProvider[p.rowIndex].k == 1)
								FlexGlobals.topLevelApplication.openFormX("Property", 1, "mod/m0/m0_FilterReportProperty.swf", 160, 400);
							else if(dgFilter.dataProvider[p.rowIndex].k == 2)
								FlexGlobals.topLevelApplication.openFormX("Property", 1, "mod/m0/m0_FilterReportProperty.swf", 70, 230);
							else if(dgFilter.dataProvider[p.rowIndex].k == 3)
								FlexGlobals.topLevelApplication.openFormX("Property", 1, "mod/m0/m0_FilterReportProperty.swf", 250, 225);
							else if(dgFilter.dataProvider[p.rowIndex].k == 4)
								FlexGlobals.topLevelApplication.openFormX("Property", 1, "mod/m0/m0_FilterReportProperty.swf", 70, 210);
						break;
				}
			}
			
			protected function f_simpan():void
			{				
				var s:String = '', d:String = '';
				for(i=0;i<o.ar1.length;i++){
					s = p.F_jsonEncode('f', o.ar1[i].dgFilter, ['l', 'f', 'k', 'w', 'p', 's']);
					s += ", "+p.F_jsonEncode(o.ar1[i].nsob, o.ar1[i].dgOrderBy, ['l', 'f']);
					s += ", "+p.F_jsonEncode(o.ar1[i].nsgb, o.ar1[i].dgGroupBy, ['l', 'f']);
					if(i == 0) d = "\""+o.ar1[i].a+"\":["+s+"]";
					else d += ", "+""+"\""+o.ar1[i].a+"\":["+s+"]";
				}
				d = "{"+d+"}";
				p.F_wsJson('set', 'M0_SetFileLibrary', "report/"+idmodule+"_"+idmenu, d);
			}
			
			protected function cmbreport_changeHandler(event:IndexChangeEvent):void
			{
				if(cmbreport.selectedIndex < 0)
					tab.visible = false;
				else{
					tab.visible = true;
					dgFilter.dataProvider = o.ar1[cmbreport.selectedIndex].dgFilter;
					dgOrderBy.dataProvider = o.ar1[cmbreport.selectedIndex].dgOrderBy;
					dgGroupBy.dataProvider = o.ar1[cmbreport.selectedIndex].dgGroupBy;
					nsob.value = int(o.ar1[cmbreport.selectedIndex].nsob);
					nsgb.value = int(o.ar1[cmbreport.selectedIndex].nsgb);
				}
			}
			
			protected function nsob_changeHandler(event:Event):void
			{
				o.ar1[cmbreport.selectedIndex].nsob = nsob.value;
			}
			
			protected function nsgb_changeHandler(event:Event):void
			{
				o.ar1[cmbreport.selectedIndex].nsgb = nsgb.value;
			}
			
		]]>
	</fx:Script>
