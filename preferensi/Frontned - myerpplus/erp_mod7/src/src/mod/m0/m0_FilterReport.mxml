	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{xmlListColl}" iconField="@icon" labelField="@label"/>
	<mx:VBox width="250" top="30" bottom="0" verticalGap="0" maxWidth="300" borderAlpha="1">
		<mx:HBox width="100%" height="25" backgroundColor="#EBF4FF" horizontalAlign="right" horizontalGap="2" verticalAlign="middle">	
			<mx:LinkButton x="11" width="100%" label="Judul" fontWeight="bold" textAlign="left" id="BtnLinkJudul"/>
			<mx:Box width="0" height="100%"/>
		</mx:HBox>
