<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" 
		  width="100%" height="100%" initialize="p=parentApplication"
          creationComplete="f_persiapan()">
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			
			import spark.components.RadioButton;
			
			[Bindable] [Embed(source="assets/tb/add.png")]  public var tbadd:Class;
			[Bindable] [Embed(source="assets/tb/edit.png")]  public var tbedit:Class;
			[Bindable] [Embed(source="assets/tb/delete.png")]  public var tbdelete:Class;
			[Bindable] [Embed(source="assets/tb/refresh.png")]  public var tbrefresh:Class;
			
			protected var p:Object, r:RadioButton;
			
			public function f_focusOnMe():void
			{
			}
			
			protected function f_persiapan():void
			{
				dg.dataProvider = new ArrayCollection;
				FlexGlobals.topLevelApplication.F_RegGrid(0, 5, [dg]);
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTambah);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbEdit);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbHapus);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbRefresh);
				function f_mbTambah():void
				{
					p.openFormX("User Role Detail", 1, "mod/m0/m0_RoleUserDetail.swf", 600, 750, "t1");
				}
				
				function f_mbEdit():void
				{
					if(dg.selectedIndex >= 0)
					p.openFormX("User Role Detail", 1, "mod/m0/m0_RoleUserDetail.swf", 600, 750, "t1", '@');
				}
				
				function f_mbHapus():void
				{
					if(dg.dataProviderLength > 0 && dg.selectedIndex >= 0)
						p.F_wsDelete('tampil', 'M0_RoleDelete', p.userid, dg.dataProvider.getItemAt(dg.selectedIndex).rkode);
				}
				
				function f_mbRefresh():void
				{
					f_kondisiAwal();
				}
				
			}
			
			protected function f_kondisiAwal():void
			{
				p.F_wsSearch('tampil', 'M0_RoleSearch');
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				FlexGlobals.topLevelApplication.openFormX("User Role Detail", 1, "mod/m0/m0_RoleUserDetail.swf", 600, 750, "t1", '@');
			}
			
			public function f_wsHasil():void
			{
				if(p.subject == 'tampil')
					dg.dataProvider = p.wsArrUtama;
				
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="xmlListColl">
			<s:source>
				<fx:XMLList xmlns="">
					<topmenu label="Tambah" icon="tbadd"/>
					<topmenu label="Edit" icon="tbedit"/>
					<topmenu label="Hapus" icon="tbdelete"/>
					<topmenu label="Segarkan" icon="tbrefresh"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection>
	</fx:Declarations>
	<mx:MenuBar id="mb" labelField="@label" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{xmlListColl}" iconField="@icon"/>
	<s:DataGrid id="dg" left="0" right="0" top="30" bottom="0"/>
</s:Module>
