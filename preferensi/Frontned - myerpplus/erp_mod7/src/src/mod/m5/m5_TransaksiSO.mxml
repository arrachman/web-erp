							parentApplication.F_openReportDefault(5, 4, 'soid = '+parentApplication.wsIdtransaksi);
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'kodebarang':
								ob.kodebarang = ''; ob.tipebarang = ''; ob.namabarang = ''; ob.jml = 0; ob.satuan = ''; ob.harga = 0; ob.diskon = 0; ob.jmldiskon = 0;
								ob.subtotal = 0; ob.pajak1 = ''; ob.pajak2 = ''; ob.gudang = ''; ob.sqnotransaksi = ''; ob.catatan = ''; ob.costcenter = ''; ob.divisi = '';
								ob.subdivisi = ''; ob.proyek = ''; ob.idsodetail = 0; ob.idso = 0; ob.idbarang = 0; ob.nilaisatuan = 0; ob.jmlbarang = 0;
								ob.satuanbarang = ''; ob.matauang = ''; ob.kurs = 0; ob.jmlpajak1 = 0; ob.jmlpajak2 = 0; ob.cabang = ''; ob.lokasi = ''; ob.idsqdetail = 0;
								ob.jmlpl = 0; ob.statuspl = 0; ob.jmldo = 0; ob.statusdo = 0; ob.jmldr = 0; ob.statusdr = 0; ob.jmlpi = 0; ob.statuspi = 0; ob.jmlsi = 0;
								ob.statussi = 0; ob.jmlrnr = 0; ob.statusrnr = 0; ob.jmlsr = 0; ob.statussr = 0; ob.isclose = 0; ob.customtext1 = ''; ob.customtext2 = '';
								ob.customtext3 = ''; ob.customdbl1 = 0; ob.customdbl2 = 0; ob.customdbl3 = 0; ob.customdate1 = ''; ob.customdate2 = ''; ob.customdate3 = '';
								ob.nilaipajak1 = 0; ob.nilaipajak2 = 0;
								break;
							case 'satuan':
								ob.satuan = '';
								break;
							case 'pajak1':
								ob.pajak1 = '';
								ob.nilaipajak1 = 0;
								ob.jmlpajak1 = 0;
								f_hitungTotalDetail();
								break;
							case 'pajak2':
								ob.pajak2 = '';
								ob.nilaipajak2 = 0;
								ob.jmlpajak2 = 0;
								f_hitungTotalDetail();
								break;
							case 'gudang':
								ob.gudang = '';
								break;
							case 'costcenter':
								ob.costcenter = '';
								break;
							case 'divisi':
								ob.divisi = '';
								break;
							case 'subdivisi':
								ob.subdivisi = '';
								break;
							case 'proyek':
								ob.proyek = '';
								break;
							case 'matauang':
								ob.matauang = '';
								ob.kurs = '';
								break;
							case 'cabang':
								ob.cabang = '';
								break;
							case 'lokasi':
								ob.lokasi = '';
								break;
							case 'tampil':
							case 'simpan':
								Alert.show(parentApplication.wsErrmessage);
								break;
						}
				}
				parentApplication.F_dgRefresh(dg1);
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtcustomer':parentApplication.F_KosongkanText([txtcustomer, lblcustomer]);break;
					case 'txtkontakperson':parentApplication.F_KosongkanText([txtkontakperson]);break;
					case 'txtsalesman':parentApplication.F_KosongkanText([txtsalesman, lblsalesman]);break;
					case 'txtgudang':parentApplication.F_KosongkanText([txtgudang, lblgudang]);break;
					case 'txtmatauang':parentApplication.F_KosongkanText([txtmatauang, txtkurs]);break;
					case 'txttermin':parentApplication.F_KosongkanText([txttermin, lbltermin]);break;
					case 'txtekspedisi':parentApplication.F_KosongkanText([txtekspedisi]);break;
				}
			}
			
			protected function f_simpan():void
			{
				var a:Array, utama:String, detail:String, tgl:String;
				n.dttanggal = dttanggal.text;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){
						u.refresh();
						// Set Utama
						with(u.getItemAt(0))
							a = [soid, socabang, solokasi, txtgudang.text, cmbasalbarang.textInput.text, soasalbarangkategori, sojenispenjualan, 
								sojenispenjualankategori, cmbcarabayar.selectedItem.v, sosumber, int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), sokodepa, 
								socustomer, txtkontakperson.text, txtalamatcustomer.text, so1alamat2, so1alamat3, txtalamatkirim.text, so2alamat2, 
								so2alamat3, sobagianpenjualan, txtekspedisi.text, parentApplication.F_tglFormatDB(dttanggalkirim.text), txttermin.text, parentApplication.F_tglFormatDB(sotgljatuhtempo), txturaian.text, 
								txtcatatan.text, txtnoref.text, parentApplication.F_tglFormatDB(dttanggalnoref.text), parentApplication.F_tglFormatDB(dttanggal.text), txtmatauang.text, o.txtkurs, sohargatermasukpajak, 
								n.vtotal, o.txtdiskonpersen, o.txtdiskonnilai, n.vtotalpajak1, n.vtotalpajak2, o.txtbiayalainpersen, o.txtbiayalainnilai, 
								n.vtotaltransaksi, sojmlbayar, vsorekdiskon, vsorekpajak1, vsorekpajak2, vsorekbiayalain, vsorekbayar, 
								soidsq, sostatuspl, sostatusdo, sostatusdr, sostatuspi, sostatussi, sostatusrnr, 
								sostatussr, cmbprogress.selectedItem.v, sostatussebelumnya, sojmlrevisi, socetakanke, soinputuser, parentApplication.F_tglFormatDB(soinputtgl), 
								somodifikasiuser, parentApplication.F_tglFormatDB(somodifikasitgl), soisclose, socustomtext1, socustomtext2, socustomtext3, socustomtext4, 
								socustomtext5, socustomint1, socustomint2, socustomint3, socustomdbl1, socustomdbl2, socustomdbl3, 
								parentApplication.F_tglFormatDB(socustomdate1), parentApplication.F_tglFormatDB(socustomdate2), parentApplication.F_tglFormatDB(socustomdate3)];
						utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						
						// Set Detail
						for(i=0;i<dg1.dataProviderLength;i++)
							with(dg1.dataProvider.getItemAt(i)){
								a = [idsodetail, idso, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(kurs), harga, diskon, 
									jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, lokasi, 
									gudang, costcenter, divisi, subdivisi, proyek, catatan, (i+1), 
									idsqdetail, jmlpl, statuspl, jmldo, statusdo, jmldr, statusdr, 
									jmlpi, statuspi, jmlsi, statussi, jmlrnr, statusrnr, jmlsr, 
									statussr, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
									customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else detail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						parentApplication.F_wsSimpan('simpan', "M5_SoSimpan", parentApplication.userid, isUpdate, utama, detail);	// kirim ketika simpan ke WS
						
					}
				}
				
				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					vMsgIng = "";
					vMsg = "";
					if(cmbasalbarang.selectedIndex < 0 || cmbasalbarang.textInput.text.length == 0)msgAlert(cmbasalbarang,'Item Origin','Asal Barang');
					if(cmbcarabayar.selectedIndex < 0 || cmbcarabayar.textInput.text.length == 0)msgAlert(cmbcarabayar,'Payment Method','Cara Bayar');
					if(txtcustomer.text.length == 0)msgAlert(txtcustomer,'Customer','Customer');
					if(txtsalesman.text.length == 0)msgAlert(txtsalesman,'Salesman','Salesman');
					if(txtgudang.text.length == 0)msgAlert(txtgudang,'Warehouse','Gudang');
					if(dttanggal.text.length == 0)msgAlert(dttanggal,'Date','Tanggal');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(txtmatauang.text.length == 0)msgAlert(txtmatauang,'Currency','Mata Uang');
					if(txtkurs.text.length == 0)msgAlert(txtkurs,'Rate','Kurs');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)msgAlert(cmbprogress,'Progress','Progress');
					if(dg1.dataProvider.getItemAt(0).idsqdetail == null)msgAlert(dg1,'Item Detail','Detail Item');
					if(vMsg != '')msgAlert('clear', '', '');
					
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi == true)focus.setFocus();
						vMsgIng += inggris+', ';
						vMsg += indonesia+', ';
						if(focus == 'clear'){
							vMsg = vMsg.substr(0, vMsg.length-4);
							vMsg += " harus diisi dengan benar";
							vMsgIng = vMsgIng.substr(0, vMsgIng.length-4);
							vMsgIng += " must be filled";
							Alert.show(vMsgIng+"  ("+vMsg+")"  , "Information");} 
						validasi = false; 
					}
				}
			}
			
			public function f_hitungTotalDetail():void
			{
				n.vtotal=0;
				n.vtotalpajak1=0;
				n.vtotalpajak2=0;
				for(var i:int=0;i<dg1.dataProvider.length;i++){
					if(dg1.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg1.dataProvider.getItemAt(i).subtotal);
					if(dg1.dataProvider.getItemAt(i).jmlpajak1 != undefined)n.vtotalpajak1 += Number(dg1.dataProvider.getItemAt(i).jmlpajak1);
					if(dg1.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg1.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = parentApplication.m.nfNominal.format(n.vtotal);
				lblpajak1.text = parentApplication.m.nfNominal.format(n.vtotalpajak1);
				lblpajak2.text = parentApplication.m.nfNominal.format(n.vtotalpajak2);
				
				o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
				txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
				o.txtbiayalainnilai = (o.txtbiayalainpersen/100) * n.vtotal;
				txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
				
				f_hitungTotalUtama();
			}
			
			public function f_hitungTotalUtama():void
			{
				n.vtotaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak1) + Number(n.vtotalpajak2) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
				
				lbltotaltransaksi.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
			}
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				parentApplication.F_acAdd(dg1);
				dg1.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected == true){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
