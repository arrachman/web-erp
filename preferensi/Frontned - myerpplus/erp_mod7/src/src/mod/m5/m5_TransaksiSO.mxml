			public function f_grid(dg:DataGrid, column:String):void
			{ 
				if(column == 'add'){
					
				}else if(column == 'del'){
					
				}else{
					with(dg1.dataProvider.getItemAt(parentApplication.rowIndex)){
						switch(column){
							case 'jml':
							case 'harga':
							case 'pajak1':
							case 'pajak2':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								jmlbarang = Number(jml) * Number(nilaisatuan);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								break;
							case 'diskon':
								jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
								subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
								jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
								jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								break;
							case 'jmldiskon':
								if(jml <= 0 || harga <= 0){
									Alert.show("Jumlah atau harga harus diisi dengan benar", "Information");
								}else{
									diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
								}
								break;
						}
					}
				}
				parentApplication.F_dgRefresh(dg);
				f_hitungTotalDetail();
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(mb.menuBarItems[0].enabled == true)
						if(e.ctrlKey)f_simpan();
						break;
				}
			}	
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				if(dg1.selectedCell != null)obj = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
				switch(target){
					case 'txtcustomer':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="C") AND kkode ="'+txtcustomer.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="C")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+u.getItemAt(0).socustomer+' and kakodekontak ="'+txtkontakperson.text.split('"').join('\\"')+'"';
						csfilter = 'kaidkontak ='+u.getItemAt(0).socustomer+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case 'txtsalesman':
						paket = 'CdM1_Contact';
						wsfilter = '(kaktif=1 AND kkategori="M") AND kkode ="'+txtsalesman.text.split('"').join('\\"')+'"';
						csfilter = '(kaktif=1 AND kkategori="M")';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case 'txtgudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'wkode ="'+txtgudang.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case 'txtmatauang':
						paket = 'CdM1_Currency';
						wsfilter = 'ckode = "'+txtmatauang.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'ckode asc';
						break;
					case 'txttermin':
						paket = 'CdM1_Terms';
						wsfilter = 'trkode = "'+txttermin.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'trkode asc';
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						wsfilter = 'tnsumber = "SO" AND tncatatan ="'+txtcatatan.text.split('"').join('\\"')+'"';
						csfilter = 'tnsumber = "SO"';
						sort = 'tnkode asc';
						break;
					case 'txtekspedisi':
						paket = 'CdM1_Expedition';
						wsfilter = 'ekode="'+txtekspedisi.text.split('"').join('\\"')+'"';
						csfield = 2;
						sort = 'ekode asc';
						break;
					case 'txtdiskonnilai':
						paket = 'CdM1_Coa';
						csfilter = 'cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'lblpajak1':
						paket = 'CdM1_Coa';
						csfilter = 'cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'lblpajak2':
						paket = 'CdM1_Coa';
						csfilter = 'cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'txtbiayalainnilai':
						paket = 'CdM1_Coa';
						csfilter = 'cgd = "D"';
						csfield = 2;
						sort = 'cnomor asc';
						break;
					case 'kodebarang':
						paket = 'CdM1_Item';
						wsfilter = 'bkode = "'+obj.kodebarang.split('"').join('\\"')+'"';
						sort = 'bkode asc';
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = 'ukode = "'+obj.satuan.split('"').join('\\"')+'"';
						sort = 'ukode asc';
						break;
					case 'pajak1':
						paket = 'CdM1_Tax';
						wsfilter = 'tkode = "'+obj.pajak1.split('"').join('\\"')+'"';
						sort = 'tkode asc';
						break;
					case 'pajak2':
						paket = 'CdM1_Tax';
						wsfilter = 'tkode = "'+obj.pajak2.split('"').join('\\"')+'"';
						sort = 'tkode asc';
						break;
					case 'gudang':
						paket = 'CdM1_Warehouse';
						wsfilter = 'wkode = "'+obj.gudang.split('"').join('\\"')+'"';
						sort = 'wkode asc';
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						wsfilter = 'tndsumber = "MR" AND tndcatatan ="'+obj.catatan.split('"').join('\\"')+'"';
						csfilter = 'tndsumber = "MR"';
						sort = 'tndkode asc';
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = 'cckode = "'+obj.costcenter.split('"').join('\\"')+'"';
						sort = 'cckode asc';
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = 'dkode = "'+obj.divisi.split('"').join('\\"')+'"';
						sort = 'dkode asc';
						break;
					case 'subdivisi':
						paket = 'CdM1_Subdivision';
						wsfilter = 'sddivisi = "'+obj.divisi.split('"').join('\\"')+'" AND sdkode = "'+obj.subdivisi.split('"').join('\\"')+'"';
