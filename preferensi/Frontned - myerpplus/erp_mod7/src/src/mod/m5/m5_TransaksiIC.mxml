			protected function f_dinamikValueGrid(dg:DataGrid, rowIndex:int):void{
				with(dg.dataProvider.getItemAt(rowIndex)){
					if(vUang == txtmatauang.text)
						jmlbayarvalas = 0;
					else jmlbayarvalas = jmlbayar/h.getItemAt(0).kurs;
					diskontermin = f_diskonTermin(dttglbayar.text, '', tgl, haridiskon1, haridiskon2, diskon1, diskon2);
					jmldiskontermin = jmlbayar*(diskontermin/100);
					jmldiskonterminvalas = jmlbayarvalas*(diskontermin/100); 
				}
			}
			
			protected function f_diskonTermin(tglbayar:String, tglgiro:String, tgl:String, haridiskon1:int=0, haridiskon2:int=0, diskon1:int=0, diskon2:int=0):int
			{
				var tglselisih:int, i:int;
				if(tglbayar == '')
					return 0;
				if(tglgiro == '' && tglgiro == null)tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglbayar, tgl)
				else tglselisih = FlexGlobals.topLevelApplication.F_tglSelisih(tglbayar, tglgiro);
				if(tglselisih <= haridiskon1)
					return diskon1;
				else if(tglselisih <= haridiskon2)
					return diskon2;
				else return 0;
			}
			
			protected function dvd_dividerPressHandler(event:DividerEvent):void
			{
				if(tab.selectedIndex == 0){
					if(boxfilter1.height < 5){
						lbl1.text = 'Sembunyikan Filter';
						btnexpand.visible = false;
						btncollapse.visible = true;
					}else{
						lbl1.text = 'Tampilkan Filter';
						btnexpand.visible = true;
						btncollapse.visible = false;
					}
				}
					
				else if(tab.selectedIndex == 1){
					if(boxfilter2.height < 5){
						lbl2.text = 'Sembunyikan Filter';
						btnexpand2.visible = false;
						btncollapse2.visible = true;
					}else{
						lbl2.text = 'Tampilkan Filter';
						btnexpand2.visible = true;
						btncollapse2.visible = false;
					}
				}
					
				else if(tab.selectedIndex == 2){
					if(boxfilter3.height < 5){
						lbl3.text = 'Sembunyikan Filter';
						btnexpand3.visible = false;
						btncollapse3.visible = true;
					}else{
