			public function f_grid(dg:DataGrid, column:String):void
			{
				var dg1d:Object;
				o.a = column.split('|');
				if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 5){
					if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
					else o.d = dg.dataProvider.getItemAt(o.a[1]);
					o.o.haridiskon1 = 0;
					o.o.haridiskon2 = 0;
					o.o.diskon1 = 0;
					o.o.diskon2 = 0;
					o.o.jmlbayar = 0;
					o.o.jmlbayarvalas = 0;
					return
				}
				dg1d = dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)
				switch(column){
					case 'jmlbayar':
						if(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).matauang != undefined){
							if(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).matauang != UFungsional){
								dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayarvalas = Number(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayar) / Number(hf(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).kurs));
							}else{
								dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayarvalas = 0;
							}
						}
						break;
					case 'jmlbayarvalas':
						if(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).matauang != undefined){
							if(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).matauang != UFungsional){
								dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayar = dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayarvalas *  Number(hf(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).kurs));
							}else{
								dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayarvalas = 0;
								dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayar = Number(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).totaltransaksi) - Number(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).terbayar);
							}
						}
						break;
				}
				dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).diskontermin = f_diskonTermin(dttglbayar.text, '', dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).tgl, dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).haridiskon1, dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).haridiskon2, dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).diskon1, dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).diskon2);
				dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmldiskontermin = dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayar*(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).diskontermin/100);
				dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmldiskonterminvalas = dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).jmlbayarvalas*(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex).diskontermin/100);
				f_hitungTotal();
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
