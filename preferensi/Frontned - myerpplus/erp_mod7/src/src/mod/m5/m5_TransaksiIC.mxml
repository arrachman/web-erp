				function validasiForm():void
				{
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg1);
					vMsgIng = "";
					vMsg = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
					if(txtcustomer.text.length == 0)msgAlert(txtcustomer,'Customer','Customer');
					if(txtmatauang.text.length == 0)msgAlert(txtmatauang,'Mata Uang','Mata Uang');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','Notransaksi');
					if(dttgl.text.length == 0)msgAlert(dttgl,'Date','Tanggal');
					if(dttglbayar.text.length == 0)msgAlert(dttglbayar,'Payment Date','Tanggal Bayar');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)msgAlert(cmbprogress,'Progress','Progress');
					if(vMsg != '')msgAlert('clear', '', '');
					
					function  msgAlert(focus: Object, inggris: String, indonesia: String):void
					{ 
						if(validasi == true)focus.setFocus();
						vMsgIng += inggris+', ';
						vMsg += indonesia+', ';
						if(focus == 'clear'){
							vMsg = vMsg.substr(0, vMsg.length-4);
							vMsg += " harus diisi dengan benar";
							vMsgIng = vMsgIng.substr(0, vMsgIng.length-4);
							vMsgIng += " must be filled";
							Alert.show(vMsgIng+"  ("+vMsg+")"  , "Information");} 
						validasi = false; 
					}
				}
			}
			
			public function f_hitungTotal():void
			{
				//set total detail
				o.totalRI = 0; o.totalRIvalas = 0; o.totalAP = 0; o.totalAPvalas = 0; o.totalPRT = 0; o.totalPRTvalas = 0; o.totalRP = 0; o.totalRPvalas = 0; o.totalIP = 0; o.totalIPvalas = 0; o.totalCOA = 0; o.totalCOAvalas = 0; 
				o.diskonterminRI = 0; o.diskonterminAP = 0; o.diskonterminPRT = 0; o.diskonterminRP = 0; o.diskonterminIP = 0; 
				o.diskonterminRIvalas = 0; o.diskonterminAPvalas = 0; o.diskonterminPRTvalas = 0; o.diskonterminRPvalas = 0; o.diskonterminIPvalas = 0; 
				//set total bawah
				o.vpptotalap = 0; o.vpptotalapvalas = 0; o.vpptotalar = 0; o.vpptotalarvalas = 0; o.vppselisihkurs = 0;
				o.vppdiskontermin = 0; o.vppdiskonterminvalas =  0; o.vppbayar = 0; o.vppbayarvalas = 0;
				//dg1
				for(i = 0; i< dg1.dataProviderLength; i++){
					if(dg1.dataProvider[i].chk == true){
						o.totalRI += Number(dg1.dataProvider[i].jmlbayar);
						o.totalRIvalas += Number(dg1.dataProvider[i].jmlbayarvalas);
						o.diskonterminRI += Number(dg1.dataProvider[i].jmldiskontermin);
						o.diskonterminRIvalas += Number(dg1.dataProvider[i].jmldiskonterminvalas);
					}
				}
				//dg2
				for(i = 0; i< dg2.dataProviderLength; i++){
					if(dg2.dataProvider[i].chk == true){
						o.totalAP += Number(dg2.dataProvider[i].jmlbayar);
						o.totalAPvalas += Number(dg2.dataProvider[i].jmlbayarvalas);
						o.diskonterminAP += Number(dg2.dataProvider[i].jmldiskontermin);
						o.diskonterminAPvalas += Number(dg2.dataProvider[i].jmldiskonterminvalas);
					}
				}
				//dg PRT
				for(i = 0; i< dg3.dataProviderLength; i++){
					if(dg3.dataProvider[i].chk == true){
						o.totalPRT += Number(dg3.dataProvider[i].jmlbayar);
						o.totalPRTvalas += Number(dg3.dataProvider[i].jmlbayarvalas);
						o.diskonterminPRT += Number(dg3.dataProvider[i].jmldiskontermin);
						o.diskonterminPRTvalas += Number(dg3.dataProvider[i].jmldiskonterminvalas);
					}
				}
				//dg4
				for(i = 0; i< dg4.dataProviderLength; i++){
					if(dg4.dataProvider[i].chk == true){
						o.totalRP += Number(dg4.dataProvider[i].jmlbayar);
						o.totalRPvalas += Number(dg4.dataProvider[i].jmlbayarvalas);
						o.diskonterminRP += Number(dg4.dataProvider[i].jmldiskontermin);
						o.diskonterminRPvalas += Number(dg4.dataProvider[i].jmldiskonterminvalas);
					}
				}
				//dg IP
				for(i = 0; i< dg5.dataProviderLength; i++){
					if(dg5.dataProvider[i].chk == true){
						o.totalIP += Number(dg5.dataProvider[i].jmlbayar);
						o.totalIPvalas += Number(dg5.dataProvider[i].jmlbayarvalas);
						o.diskonterminIP += Number(dg5.dataProvider[i].jmldiskontermin);
						o.diskonterminIPvalas += Number(dg5.dataProvider[i].jmldiskonterminvalas);
					}
				}
				//dg Coa
				for(i = 0; i< dgcoa.dataProviderLength; i++){
					if(dgcoa.dataProvider.getItemAt(i).jmlbayar != undefined){o.totalCOA += Number(dgcoa.dataProvider[i].jmlbayar);}
					if(dgcoa.dataProvider.getItemAt(i).jmlbayarvalas != undefined){o.totalCOAvalas += Number(dgcoa.dataProvider[i].jmlbayarvalas);}
				}
				
				//hitungtotalap
				o.vpptotalap = o.totalRI + o.totalCOA + o.totalIP;
				o.vpptotalapvalas = o.totalRIvalas + o.totalCOAvalas + o.totalIPvalas;
				//hitungtotalar
				o.vpptotalar = o.totalAP + o.totalPRT + o.totalRP;
				o.vpptotalarvalas = o.totalAPvalas + o.totalPRTvalas + o.totalRPvalas;
				//hitung diskon termin
				o.vppdiskontermin = o.diskonterminRI + o.diskonterminAP + o.diskonterminPRT + o.diskonterminRP + o.diskonterminIP;
				o.vppdiskonterminvalas = o.diskonterminRIvalas + o.diskonterminAPvalas + o.diskonterminPRTvalas + o.diskonterminRPvalas + o.diskonterminIPvalas;
				//hitung selisih kurs
				if(txtmatauang.text != UFungsional){
					o.vppselisihkurs = o.vpptotalap - o.vpptotalar - o.vppdiskontermin - ((o.vpptotalapvalas - o.vpptotalarvalas - o.vppdiskonterminvalas) * hf(txtkurs.text));
				}
				//hitungbayar
				o.vppbayar = o.vpptotalap - o.vpptotalar - o.vppdiskontermin -  o.vppselisihkurs;
				o.vppbayarvalas = o.vpptotalapvalas - o.vpptotalarvalas - o.vppdiskonterminvalas;
				//set label
				lbltotalAP.text = parentApplication.m.nfNominal.format(o.vpptotalap); lbltotalAPvalas.text = parentApplication.m.nfNominal.format(o.vpptotalapvalas);
				lbltotalAR.text = parentApplication.m.nfNominal.format(o.vpptotalar); lbltotalARvalas.text = parentApplication.m.nfNominal.format(o.vpptotalarvalas);
				lbldiskontermin.text = parentApplication.m.nfNominal.format(o.vppdiskontermin); lbldiskonterminvalas.text = parentApplication.m.nfNominal.format(o.vppdiskonterminvalas);
				lblselisihkurs.text = parentApplication.m.nfNominal.format(o.vppselisihkurs);
				lblbayar.text = parentApplication.m.nfNominal.format(o.vppbayar); lblbayarvalas.text = parentApplication.m.nfNominal.format(o.vppbayarvalas);
				lblselisihARAP.text = parentApplication.m.nfNominal.format(o.vpptotalar - o.vpptotalap);
			}
			
