//				dg3.dataProvider.removeAll();
//				dg4.dataProvider.removeAll();
//				dg5.dataProvider.removeAll();
				f_focusOnMe();
			}
			
			protected function f_refreshGrid():void
			{
				FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
