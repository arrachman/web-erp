			public function f_wsHasil():void
			{
				var j:int, a:ArrayCollection = new ArrayCollection;
				subject = subject.split(sptParam).join("");
				switch(subject){
					case 'checkdb':
						/* m['MlLogin'].child.lblDBVer.text = wsArrUtama[0].f0; */
						break;
					case 'login':
						if(wsSuccess == true){
							m.login = true;
							f_kondisiAwal();
						}else{
							m['MlLogin'].child.txtUsername.enabled = true;
							m['MlLogin'].child.txtPassword.enabled = true;
							m['MlLogin'].child.BtnLogin.enabled = true;
							Alert.show(wsErrmessage);
						}
						break;
					case 'M0_GetFileLibrary':
						if(m.objTemp.reset == true)
							m.objTemp.comLanguage = null;
						m.bahasa = wsJson.property; 
						break;
					case 'bukacompencarian':
						m.bukacompencarian = true;
						PopUpManager.addPopUp(winC, this, true);
						PopUpManager.centerPopUp(winC);
					case 'caridatacombo':
						winC.f_persiapan(); 
						break;
					case 'updateStatus':
						if(wsSuccess == false){
							Alert.show(wsErrmessage, l("Pesan Error"));
							return;
						}
					case 'tampilForm':
						f_refreshIDmodule()
						if(wsSuccess == true){
							ob = m[idmod].child;
							for(i=0;i<wsArrUtama.length;i++) 
								if(wsArrUtama[i][m.sumber+"modifikasiusernama"] == "")
									wsArrUtama[i][m.sumber+"modifikasitgl"] = ""
							ob.dg.dataProvider = wsArrUtama; 
							ob.dg.setSelectedCell(0,0);
							rowIndex = 0;
							ob.imgfirst.enabled = wsIsPrev;
							ob.imgprevious.enabled = wsIsPrev;
							ob.imgnext.enabled = wsIsNext;
							ob.imglast.enabled = wsIsNext;
							ob.txtpaging.text = wsCurPage;
							for(i=0;i<ob.dg.dataProviderLength;i++)
								ob.dg.dataProvider[i].no = (((wsCurPage-1)*20)+(i+1));
							F_dgRefresh(ob.dg);
						}else m[idmod].child.dg.dataProvider.removeAll();
						break;
					case 'tampilFDJurnalVocher':
						if(wsSuccess == true){
							m[idmod].child.ttwpopup.left = 0;
							m[idmod].child.ttwpopup.right = 0;
							m[idmod].child.grppopup.visible = true;
							m[idmod].child.ttwpopup.title = 'Jurnal Voucher';
							m[idmod].child.gridjv.visible = true;
							m[idmod].child.gridjv.dataProvider = wsArrUtama;
						}else Alert.show(wsErrmessage);
						break; 
					case 'tampilFDTransaksiTerkait':
						if(wsSuccess == true){
							m[idmod].child.ttwpopup.left = 325;
							m[idmod].child.ttwpopup.right = 325;
							m[idmod].child.grppopup.visible = true;
							m[idmod].child.ttwpopup.title = 'Transaki Terkait '+m[idmod].child.dg.dataProvider[m[idmod].child.dg.selectedCell.rowIndex][m[idmod].child.arr[6].toLowerCase()+"notransaksi"];
							m[idmod].child.gridtt.visible = true;
							m[idmod].child.gridtt.dataProvider = wsArrUtama;
						}else Alert.show(wsErrmessage);
						break;
					case 'comLanguage':
						m.objTemp.m0_SettingLanguage = wsJson;
						registerGrid([winLang.dg], 'data');
						F_wsSearch(sptParam+'comLanguageTampil', 'M0_LanguageSearch', 0, 0, '', 'lnama');
						break;
					case 'comLanguageTampil':
						winLang.dg.dataProvider.removeAll();
						if(wsSuccess == true)
							for(i=0;i<wsArrUtama.length;i++)
								with(wsArrUtama[i])
									if(lgambar != '')
										winLang.dg.dataProvider.addItem({lkode:lkode, lnama:lnama, laktif:laktif, lkode_source:m.url+'/files/f0/language/'+lgambar});
									else
										winLang.dg.dataProvider.addItem({lkode:lkode, lnama:lnama, laktif:laktif, lkode_source:''});
						F_dgRefresh(winLang.dg);
						break;
					case 'logout':
							m.MlLogin.loadModule();
							f_tabCloseAll();
							TreeKu.dataProvider = null;
							BtnLinkJudul.label = "";
						break;
					case 'languageSystem':
						m.NewSentence = undefined;
						F_wsSearch(sptParam+'logout', 'M0_Logout');
						break;
					case 'getFormData':
						registerGrid([m[idmod].child.dg], 'data');
						mod('f_persiapan');
						break;
					case 'terkaitFormMaster':
						if(wsSuccess == true){
							m[idmod].child.dg.dataProvider = wsArrUtama;
							m[idmod].child.dg.setSelectedCell(0,0);
							rowIndex = 0;
							m[idmod].child.txtpaging.text = wsCurPage;
						}else Alert.show(wsErrmessage, l('Pesan Error'));
						break;
					case "alertCetak":
						if(wsSuccess == true){
							winAlertCetak.f_print();
						}else Alert.show(wsErrmessage, l("Informasi"));
						break;
				}
			}
			
