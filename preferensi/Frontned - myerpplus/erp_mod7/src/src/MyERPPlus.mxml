			public function F_openReport(ModuleID:int, MenuID:int, ReportItem:int, Filter:String = "", Sort:String = "", GroupBy:String = "", FileExtention:int = 0, Param1:String = "", sumber:String = "", idtransaksi:int = 0):void
			{
				for(i=0;i<m.ArrReport.length;i++){
					om = m.ArrReport[i];
					if(parseInt(om.rmoduleid) == ModuleID && om.rmenuid == MenuID && om.ritem == ReportItem){
						f_createReport(ModuleID, MenuID, om.ritem, Filter, Sort, GroupBy, FileExtention, Param1, om.rtitle, om.rquery, sumber, idtransaksi);
