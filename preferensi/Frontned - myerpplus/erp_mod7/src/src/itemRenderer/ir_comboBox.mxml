<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
					xmlns:s="library://ns.adobe.com/flex/spark"
					xmlns:mx="library://ns.adobe.com/flex/mx"
					clipAndEnableScrolling="true"
					rollOver="griditemrenderer1_rollOverHandler(event)"
					rollOut="griditemrenderer1_rollOutHandler(event)">
	
	<fx:Script>
		<![CDATA[ 
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.events.FlexEvent;
			
			import spark.events.DropDownEvent;
			import spark.events.ListEvent;
			public var s:String, b:Boolean = true, i:int = 0, d:Boolean = true;
			override public function prepare(hasBeenRecycled:Boolean):void 
			{
//				lblData.text = cmb.selectedItem.l;
			}
			
			protected function cmb_changeHandler():void
			{
				if(cmb.selectedIndex >= 0){
					lblData.text = cmb.selectedItem.l;
					data[column.dataField] = cmb.selectedItem.v;
					parentApplication.F_setProperty('comboBox', column.dataField, cmb.selectedItem.v);
				}
			}
			
			protected function cmb_creationCompleteHandler(event:FlexEvent):void
			{
				cmb.dataProvider = parentApplication.F_getProperty('comboBox', column.dataField, '');
				parentApplication.F_ComboBoxStandard([cmb]);
				if(data != null)
					for(i=0;i<cmb.dataProvider.length;i++)
						if(cmb.dataProvider.getItemAt(i).v == data[column.dataField]){
							lblData.text = cmb.dataProvider.getItemAt(i).l;
							cmb.selectedIndex = i;
							break;
						}
			}
			
			
			protected function griditemrenderer1_rollOverHandler(event:MouseEvent):void
			{
				if(b == true){
					cmb.visible = true;
					lblData.visible = false;
				}
				d = false;
			}
			
			protected function griditemrenderer1_rollOutHandler(event:MouseEvent):void
			{
				d = true;
				if(b == true){
					cmb.visible = false;
					lblData.visible = true;
				}
			}
			
			protected function cmb_openHandler(event:DropDownEvent):void
			{
				b = false;
			}
			
			protected function cmb_closeHandler(event:DropDownEvent):void
			{
				b = true;
				if(d == true){
					lblData.text = cmb.textInput.text;
					data[column.dataField] = cmb.selectedItem.v;
					parentApplication.F_setProperty('comboBox', column.dataField, cmb.selectedItem.v);
					cmb.visible = false;
					lblData.visible = true;
				}
			}
			
			protected function lblData_renderHandler(event:Event):void
			{
				if(data != null)
					for(i=0;i<cmb.dataProvider.length;i++)
						if(cmb.dataProvider.getItemAt(i).v == data[column.dataField]){
							lblData.text = cmb.dataProvider.getItemAt(i).l;
							cmb.selectedIndex = i;
							break;
						}
			}
			
		]]> 
	</fx:Script>
	<s:ComboBox id="cmb" visible="false" left="5" right="5" top="1" bottom="1"
				change="cmb_changeHandler()" close="cmb_closeHandler(event)"
				open="cmb_openHandler(event)"
				creationComplete="cmb_creationCompleteHandler(event)"/>
	<s:Label id="lblData" top="9" left="7" visible="true" render="lblData_renderHandler(event)"/>
</s:GridItemRenderer>