<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			[Bindable] [Embed(source="assets/main/download.png")]  public var tbdownload:Class; // Download 
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			protected function imgCountry_clickHandler(event:MouseEvent):void
			{
				parentApplication.m[parentApplication.idmod].child.f_setProperty('download', column.dataField, null);
			}
			
		]]>
	</fx:Script>
	<s:Image id="img" horizontalCenter="0" verticalCenter="0" scaleMode="stretch" click="imgCountry_clickHandler(event)" source="{tbdownload}" useHandCursor="true" buttonMode="true" mouseChildren="false"/>
</s:GridItemRenderer>