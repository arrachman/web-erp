<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
					xmlns:s="library://ns.adobe.com/flex/spark"
					xmlns:mx="library://ns.adobe.com/flex/mx"
					xmlns:net="flash.net.*"
					clipAndEnableScrolling="true"
					creationComplete="griditemrenderer2_creationCompleteHandler(event)">
	
	<fx:Script>
		<![CDATA[ 
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.events.DropDownEvent;
			import spark.events.ListEvent;
			
			[Bindable] [Embed(source="assets/main/folderopen.png")]  public var folderopen:Class;
			[Bindable] [Embed(source="assets/main/folderopen_d.png")]  public var folderopen_d:Class;
			
			public var isUpload:Boolean;
			override public function prepare(hasBeenRecycled:Boolean):void 
			{
				if(data != null)
					lblData.text = data[column.dataField];
			}
			
			protected function griditemrenderer2_creationCompleteHandler(event:FlexEvent):void
			{
				isUpload = false;
				img.visible = true;
			}
			
			protected function lblData_renderHandler(event:Event):void
			{ 
				if(data != null){
					lblData.text = data[column.dataField];
					if(Boolean(data[column.dataField+'_d']) == true)
						img.source = folderopen;
					else
						img.source = folderopen_d;
				}
			}
			
			protected function img_clickHandler(event:MouseEvent):void
			{
				parentApplication.m[parentApplication.idmod].child.f_setProperty('uploadfile', column.dataField, null);
			}
			
			// Upload Foto
			
			
			
		]]> 
		
	</fx:Script>
	<fx:Declarations>
		
	</fx:Declarations>
	<s:Image id="imgget" visible="false" top="5" left="3" useHandCursor="true" mouseChildren="false" click="img_clickHandler(event)"/>
	<s:Label id="lblData" top="9" left="7" visible="true" render="lblData_renderHandler(event)"/>
	<s:Image id="img" source="{parentApplication.folderopen}" top="5" right="4" useHandCursor="true" buttonMode="true" mouseChildren="false" click="img_clickHandler(event)"/>
</s:GridItemRenderer>