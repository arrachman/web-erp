<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			override public function prepare(hasBeenRecycled:Boolean):void {
				if(data != null){
					if(data[column.dataField+'_visible'] != undefined)
						cbx.visible = Boolean(int(data[column.dataField+'_visible']));
					if(data[column.dataField] == undefined){
						data[column.dataField] = 0;
						cbx.selected = false;
					}
					cbx.selected = Boolean(int(data[column.dataField]));
					if(data[column.dataField+'_enabled'] != undefined && data[column.dataField+'_enabled'] != null){
						cbx.enabled = Boolean(int(data[column.dataField+'_enabled']));
					}
				}
			}
			
			protected function cbx_clickHandler():void
			{
				if(cbx.selected)
					cbx.selected = false;
				else
					cbx.selected = true;
				data[column.dataField] = int(cbx.selected);
				parentApplication.F_setProperty('checkBox', column.dataField, cbx.selected);
			}
			
			protected function cbx_renderHandler():void
			{
				cbx.selected = Boolean(int(data[column.dataField]));
			}
			
			protected function cbx_creationCompleteHandler():void
			{
				if(data != null){
					if(data[column.dataField+'_visible'] != undefined)
						cbx.visible = Boolean(int(data[column.dataField+'_visible']));
					if(data[column.dataField] == '')
						data[column.dataField] = 0;
				}
				cbx.selected = false;
			}
		]]>
	</fx:Script>
	<s:CheckBox id="cbx" top="6" bottom="6" width="14" height="14" horizontalCenter="0" verticalCenter="0" useHandCursor="true" buttonMode="true" mouseChildren="false" creationComplete="cbx_creationCompleteHandler()" click="cbx_clickHandler()" render="cbx_renderHandler()"/>
</s:GridItemRenderer>