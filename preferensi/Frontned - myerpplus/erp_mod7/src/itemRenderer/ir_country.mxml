<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.events.FlexEvent;
			override public function prepare(hasBeenRecycled:Boolean):void {
				if(data != null){
					lblData.text = data[column.dataField];
					if(data[column.dataField+'_source'] != '')
						imgCountry.source = data[column.dataField+'_source'];
					else
						imgCountry.source = '';
					
					if(data[column.dataField+'_width'] != undefined)
						imgCountry.width = data[column.dataField+'_width'];
					
					if(data[column.dataField+'_height'] != undefined)
						imgCountry.height = data[column.dataField+'_height'];
					
					if(data[column.dataField+'_ltop'] != undefined)
						lblData.top = data[column.dataField+'_ltop'];
					
					if(data[column.dataField+'_lleft'] != undefined)
						lblData.left = data[column.dataField+'_lleft'];
					if(data[column.dataField+'_lbottom'] != undefined)
						lblData.bottom = data[column.dataField+'_lbottom'];
					imgCountry.validateNow();
				}
			}
			
		]]>
	</fx:Script>
	<s:Image id="imgCountry" top="4" left="5" width="26" height="16" scaleMode="stretch"/>
	<s:Label id="lblData" top="9" left="40" />
</s:GridItemRenderer>