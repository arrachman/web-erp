<?xml version="1.0" encoding="utf-8"?>
<s:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009"
			   xmlns:s="library://ns.adobe.com/flex/spark"
			   xmlns:mx="library://ns.adobe.com/flex/mx"
			   width="500" height="90" initialize="f_persiapan()" close="f_close()"
			   keyDown="titlewindow1_keyDownHandler(event)">
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.managers.PopUpManager;
			public var jmlProgress:int, n:Number, j:int, close:Boolean;
			
			protected function f_persiapan():void
			{
				 this.title = parentApplication.l('Progress Upload');
				 f_kondisiAwal();
			}
			
			protected function f_kondisiAwal():void
			{
				 n = 0;
				 j = 0;
				 close = false;
			}
			
			public function f_sendProgress(data:String, status:Boolean):void
			{
				j++;
				if(status == true){
					if(j > jmlProgress){
						close = true;
						f_close();
						return;
					}
					lblProses.text = parentApplication.l("Uploading file")+" "+data;
				}else{
					lblProses.text = parentApplication.l("Upload failed")+" "+data;
					close = true;
					return;
				}
				pb.setProgress(n, 100);
				n += 100/jmlProgress;
				lblPersen.text = String(uint(n))+" %";
			}
			
			protected function f_close():void
			{
				if(close == true){
					f_kondisiAwal();
					PopUpManager.removePopUp(this);
				}
			}
			
			protected function titlewindow1_keyDownHandler(e:KeyboardEvent):void
			{
				switch(e.keyCode){
					case Keyboard.ESCAPE:
						f_close();
						break;
				}
			}
			
		]]>
	</fx:Script>
	<mx:ProgressBar id="pb" left="10" right="10" top="10" label=" " direction="right" mode="manual"/>
	<s:Label id="lblPersen" right="10" top="30" fontWeight="bold" text="0"/>
	<s:Label id="lblProses" left="10" top="30" fontWeight="bold" text=" "/>
</s:TitleWindow>