				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				
				o.pdtotalhargaout=0; o.pdtotalhppout = 0;
				for(var ih:int=0;ih<dg2.dataProviderLength;ih++){
					dg2.dataProvider.getItemAt(ih).subtotal= Number(dg2.dataProvider.getItemAt(ih).jml * dg2.dataProvider.getItemAt(ih).harga);
					if(dg2.dataProvider.getItemAt(ih).subtotal > 0){
						o.pdtotalhargaout += Number(dg2.dataProvider.getItemAt(ih).subtotal);
					}
					if(Number(dg2.dataProvider.getItemAt(ih).hpp) > 0){
						o.pdtotalhppout +=Number(dg2.dataProvider.getItemAt(ih).hpp);
					}
					
				}
				
				o.pdtotalhargain=0; o.pdtotalhppin = 0;
				for(var ib:int=0;ib<dg.dataProviderLength;ib++){
					dg.dataProvider.getItemAt(ib).subtotal = Number(dg.dataProvider.getItemAt(ib).jmltotal) * Number(dg.dataProvider.getItemAt(ib).harga);
					if(o.pcwajibwo == 3){
						dg.dataProvider.getItemAt(ib).subtotal = Number(dg.dataProvider.getItemAt(ib).hpppersen)/100*o.pdtotalhargaout;
						dg.dataProvider.getItemAt(ib).harga = Number(dg.dataProvider.getItemAt(ib).subtotal)/Number(dg.dataProvider.getItemAt(ib).jmltotal);
					}
					if(dg.dataProvider.getItemAt(ib).subtotal > 0){
						o.pdtotalhargain += Number(dg.dataProvider.getItemAt(ib).subtotal);
					}
					if(dg.dataProvider.getItemAt(ib).hpp){
						o.pdtotalhppin +=Number(dg.dataProvider.getItemAt(ib).hpp);
					}
					
				} 
				lbltotalhasil.text = parentApplication.m.nfNominal.format(o.pdtotalhargain);
				lbltotalbahan.text = parentApplication.m.nfNominal.format(o.pdtotalhargaout);
			}
			
			public function F_formatNominalPD(data:String):String
			{
				if(data == null || data == '')
					data = '0';
				
				data = data.split(parentApplication.m.nfNominalPD.decimalSeparator).join('.');
				parentApplication.m.temp = data.split('+');
				if(parentApplication.m.temp.length > 1){
					return data;
				}else
					return parentApplication.m.nfNominal.format(data);
			}
			
