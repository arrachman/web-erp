			public function f_grid(dg:DataGrid, column:String):void
			{
				//--------------------------------------------------------------------------------------------------//
				var i:int, n:Number, a:Array, dgrid1:Object;
				switch(column){ 
					case 'add':
						return;
						break;
					case 'jml':
					case 'reject':
						if(tab.selectedIndex == 0){
							dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
							if (o.pdtotalhargaout!=0){
								dgrid1.jmltotal = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.harga = (o.pdtotalhargaout* dgrid1.hpppersen)/100/dgrid1.jmltotal;
								dgrid1.subtotal = dgrid1.harga * dgrid1.jmltotal;
								dgrid1.customdbl1 = (Number(dgrid1.jmltotal) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
								dgrid1.jmlbarang = (Number(dgrid1.jml)+Number(dgrid1.reject)) * dgrid1.nilaisatuan;
							}else{
								dgrid1.jmltotal = Number(dgrid1.jml) + Number(dgrid1.reject);
								dgrid1.subtotal = dgrid1.harga * dgrid1.jmltotal;
								dgrid1.customdbl1 = (Number(dgrid1.jmltotal) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
								dgrid1.jmlbarang = (Number(dgrid1.jml)+Number(dgrid1.reject)) * dgrid1.nilaisatuan;
							}
							f_hitungTotal();
						}
						else{
							dgrid1 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
							dgrid1.customdbl1 = (Number(dgrid1.jml) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
							dgrid1.jmlbarang = dgrid1.jml * dgrid1.nilaisatuan;
							
							f_hitungTotal(); f_calc();
						}
						
						var detailsetbom:Object={};
						if((o.pcwajibwo == 2) || (o.pcwajibwo == 1)){							
							for(i=0; i<dg.dataProviderLength; i++){
								if(i == 0){ detailsetbom = dg.dataProvider.getItemAt(i).idbarang+"▼"+dg.dataProvider.getItemAt(i).jmltotal;
								}else{ detailsetbom += "▲"+dg.dataProvider.getItemAt(i).idbarang+"▼"+dg.dataProvider.getItemAt(i).jmltotal;
								}
							}						
							parentApplication.F_wsSimpan('SetBOM', 'M6_ItemBomSearch', parentApplication.userid, isUpdate, detailsetbom);
						}
						else if(o.pcwajibwo==3){
							for(i=0; i<dg2.dataProviderLength; i++){
								if(i == 0){ detailsetbom = dg2.dataProvider.getItemAt(i).idbarang+"▼"+dg2.dataProvider.getItemAt(i).jmlbarang;
								}else{ detailsetbom += "▲"+dg2.dataProvider.getItemAt(i).idbarang+"▼"+dg2.dataProvider.getItemAt(i).jmlbarang;
								}
							}
							parentApplication.F_wsSimpan('SetBOM', 'M6_ItemBomSearch', parentApplication.userid, isUpdate, detailsetbom);
						}
						break;
					case 'hpppersen':
						if(tab.selectedIndex == 0) {
							dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
							if (o.pdtotalhargaout!=0){
								dgrid1.jmltotal = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.harga = (o.pdtotalhargaout* dgrid1.hpppersen)/100/dgrid1.jmltotal;
								dgrid1.subtotal = dgrid1.harga * dgrid1.jmltotal;
								dgrid1.customdbl1 = (Number(dgrid1.jmltotal) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
								dgrid1.jmlbarang = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
							}else{
								dgrid1.jmltotal = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.subtotal = dgrid1.harga * dgrid1.jmltotal;
								dgrid1.customdbl1 = (Number(dgrid1.jmltotal) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
								dgrid1.jmlbarang = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
							}
							f_hitungTotal();
						}
							//detail bahan
						else {
							dgrid1 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
							dgrid1.customdbl1 = (Number(dgrid1.jml) *  Number(dgrid1.nilaisatuan))/ Number(dgrid1.nilaisatuanlapangan);
							dgrid1.jmlbarang = dgrid1.jml * dgrid1.nilaisatuan;
							
							f_hitungTotal(); f_calc();
						}
						break;
					case 'harga':
						if(tab.selectedIndex == 0) {
							dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
							if (o.pdtotalhargaout!=0){
								dgrid1.jmltotal = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.hpppersen=(dgrid1.harga/o.pdtotalhargaout)*100;
								dgrid1.subtotal = dgrid1.harga * dgrid1.jmltotal;
								dgrid1.jmlbarang = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								f_hitungTotal();
							}else{
								dgrid1 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
								dgrid1.subtotal = dgrid1.harga * dgrid1.jml;
								dgrid1.jmlbarang = dgrid1.jml * dgrid1.nilaisatuan;
							}
						}
						else {
							f_hitungTotal();
							f_calc();
						}
						break;
					case 'subtotal':
						hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
						break;
					case 'customdbl1':
						if(tab.selectedIndex == 0) {
							dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
							if (o.pdtotalhargaout!=0){
								dgrid1.jml = (Number(dgrid1.nilaisatuanlapangan) / Number(dgrid1.nilaisatuan)) * Number(dgrid1.customdbl1)
								dgrid1.jmltotal = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.jmlbarang = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.harga = (o.pdtotalhargaout* dgrid1.hpppersen)/100/dgrid1.jmltotal;
								dgrid1.subtotal = dgrid1.harga * dgrid1.jmltotal;
							}else{
								dgrid1.jml = (Number(dgrid1.nilaisatuanlapangan) / Number(dgrid1.nilaisatuan)) * Number(dgrid1.customdbl1)
								dgrid1.jmltotal = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.jmlbarang = (Number(dgrid1.jml)+Number(dgrid1.reject))*dgrid1.nilaisatuan;
								dgrid1.subtotal = dgrid1.harga * dgrid1.jmltotal;
							}
							f_hitungTotal();
						}
							//detail bahan
						else {
							dgrid1 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
							dgrid1.jml = (Number(dgrid1.nilaisatuanlapangan) / Number(dgrid1.nilaisatuan)) * Number(dgrid1.customdbl1)
							dgrid1.jmlbarang = Number(dgrid1.jml) * Number(dgrid1.nilaisatuan);
							
							f_hitungTotal(); f_calc();
						}
						
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				//--------------------------------------------------------------------------------------------------
			}
			
			
			private function f_calc():void{
				//--------------------------------------------------------------------------------------------------//
				var dgrid:Object;
				for (var i:int=0;i<dg.dataProviderLength;i++){
					dgrid = dg.dataProvider.getItemAt(i)
					if (o.pdtotalhargaout!=0){
						dgrid.jmltotal = Number(dgrid.jml) + Number(dgrid.reject);
						dgrid.harga = (o.pdtotalhargaout* dgrid.hpppersen)/100/dgrid.jmltotal;
						dgrid.subtotal = dgrid.harga * dgrid.jmltotal;
					}else{
						dgrid.jmltotal = Number(dgrid.jml) + Number(dgrid.reject);
						dgrid.harga = 0;
						dgrid.subtotal = dgrid.harga * dgrid.jmltotal;
					}
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				//--------------------------------------------------------------------------------------------------
			}
			
			
