			{
				if((event.keyCode == Keyboard.ENTER)/*  || (event.keyCode == Keyboard.TAB) */){
					if(o.pcwajibwo == 2){
						if(txtjenis.text == ""){
							txtjenis.setFocus();
							Alert.show("Tentukan Jenis Produksi Terlebih Dahulu");
						}
						else FlexGlobals.topLevelApplication.F_wsSearch('WoSearchRC', 'M6_Wo_RcSearch', 0, 0,"notransaksi = '"+txtroutecard.text+"'");
					}					
				}
			}
			
		]]>
