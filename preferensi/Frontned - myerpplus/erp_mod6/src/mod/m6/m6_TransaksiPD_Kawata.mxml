			public function f_filtersb():void{
				fserial = 's'; fbatch = 'b';
				for(i=0; i<dg2.dataProviderLength; i++){
					if(dg2.dataProvider[i].bserial ==	1){
						if(fserial == 's'){
							fserial = '(nsiidbarang = ' + dg2.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}else{
							fserial += ' or (nsiidbarang = ' + dg2.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}
					}
					
					if(dg2.dataProvider[i].bbatch ==	1){
						if(fbatch == 'b'){
							fbatch = '(nbiidbarang = ' + dg2.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}else{
							fbatch += ' or (nbiidbarang = ' + dg2.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}
					}
				}
			}
			
			public function msgAlert(focus: Object, indonesia: String, inggris: String):void
			{		
				if(validasi == true)focus.setFocus();
				pesanAlertIng += inggris+', ';
				pesanAlert += indonesia+', ';
				if(focus == 'clear'){
					pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
					pesanAlert += " harus diisi dengan benar";
					
					pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
					pesanAlertIng += " must be filled";
					Alert.show(pesanAlertIng+"  ("+pesanAlert+") !" , "Information");}	
				//\n
				validasi = false;						
			}
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBox':
						if(dataField == 'hargafix'){
							dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).hargafix = data;
						}
						// jika fokus di centang HK
						if(dataField == 'hk'){
							if(data == true && dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).bhpp == 'I'){
								parentApplication.F_popUpCari('hk');
								
							}
							
						}
						break;
					case  'calculator':
						var dgrid:DataGrid;
						if(tab.selectedIndex == 0){dgrid = dg;}
						else{dgrid = dg2;}
						dgrid.dataProvider[dgrid.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dgrid, dgrid.selectedCell.rowIndex);
						switch (dataField){
							case 'jml':
							case 'reject':
							case 'harga':
								f_hitungTotal();
								f_calc();
								break;
							case 'subtotal':
								hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
								break;
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
			
