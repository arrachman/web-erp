			protected function setTungku(cmbtungku:ComboBox):int
			{
				// Set tungku dari tabel setting
				var b:Object = {};
				b.pecahCombo = FlexGlobals.topLevelApplication.getSetting(6, 'options', 'Tungku').split('~');
				b.isiCombo = b.pecahCombo[0].split('|');
				if(b.isiCombo.length > 0)
				{
					cmbtungku.enabled = true;
					cmbtungku.dataProvider = new ArrayCollection;
					for(var cb:int=0;cb<b.isiCombo.length;cb++)
					{
						cmbtungku.dataProvider.addItem({l:b.isiCombo[cb], v:b.isiCombo[cb]});
					}
					cmbtungku.selectedIndex = b.pecahCombo[1];
				}
				return int(b.pecahCombo[1]);
			}
			
			protected function selectedTungku(cmb:ComboBox, status:String):void
			{
				var num:int;
				for(num = 0;num < cmb.dataProvider.length; num++)
				{
					if((cmb.dataProvider.getItemAt(num).v) == status)
					{
						cmb.selectedIndex = num;
						return;
					}
				}
				
				cmb.dataProvider.addItem({l:status, v:status});
				cmb.selectedIndex = cmb.dataProvider.length - 1;
			}
			
