			private function f_calc():void{
				//--------------------------------------------------------------------------------------------------//
				var dgrid:Object;
				for (var i:int=0;i<dg.dataProviderLength;i++){
					dgrid = dg.dataProvider.getItemAt(i)
					if (o.pdtotalhargaout!=0){
						dgrid.jml = Number(dgrid.jml) + Number(dgrid.reject);
						dgrid.harga = (o.pdtotalhargaout* dgrid.hpppersen)/100/dgrid.jml;
						dgrid.subtotal = dgrid.harga * dgrid.jml;
					}else{
						dgrid.jml = Number(dgrid.jml) + Number(dgrid.reject);
						dgrid.harga = 0;
						dgrid.subtotal = dgrid.harga * dgrid.jml;
					}
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				//--------------------------------------------------------------------------------------------------
			}
			
