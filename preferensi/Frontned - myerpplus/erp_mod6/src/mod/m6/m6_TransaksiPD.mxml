			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "SetBOM2":
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
						FlexGlobals.topLevelApplication.F_defaultGridItem(dg2)
						break;
					case 'txtjenis':p.F_KosongkanText([txtjenis, lbljenis]);break;
					case 'txtgudangasal':p.F_KosongkanText([txtgudangasal, lblgasal]);break;
					case 'txtcatatan':p.F_KosongkanText([txtcatatan]);break;
					case 'txtgudangproduksi':p.F_KosongkanText([txtgudangproduksi,lblgprod]);break;
					case 'txtmatauang':p.F_KosongkanText([txtmatauang, txtkurs]);break;
					case 'txtgudangtujuan':p.F_KosongkanText([txtgudangtujuan,lblgtuj]);break;
					case 'txtnowo':p.F_KosongkanText([txtnowo]);break;
					case 'txtestimasi':p.F_KosongkanText([txtestimasi]);break;
					case 'txtbagproduksi':p.F_KosongkanText([txtbagproduksi,lblbagianproduksi]);break;
					case "txtlokasi":parentApplication.F_KosongkanText([txtlokasi]);break;
					
					case 'txttungku':p.F_KosongkanText([txttungku]);break;
				}
			}
			public function f_delundefined():void{
				for (var i:int=0;i<dg.dataProviderLength;i++){
					with (dg.dataProvider.getItemAt(i)){
						if (dg.dataProvider.getItemAt(i)['divisi']==undefined){dg.dataProvider.getItemAt(i)['divisi']=''}
						if (dg.dataProvider.getItemAt(i)['subdivisi']==undefined){dg.dataProvider.getItemAt(i)['subdivisi']=''}
						if (dg.dataProvider.getItemAt(i)['proyek']==undefined){dg.dataProvider.getItemAt(i)['proyek']=''}
						if (dg.dataProvider.getItemAt(i)['catatan']==undefined){dg.dataProvider.getItemAt(i)['catatan']=''}
					}
				}
				for (var j:int=0;j<dg2.dataProviderLength;j++){
					with (dg2.dataProvider.getItemAt(j)){
						if (dg2.dataProvider.getItemAt(j)['divisi']==undefined){dg2.dataProvider.getItemAt(j)['divisi']=''}
						if (dg2.dataProvider.getItemAt(j)['subdivisi']==undefined){dg2.dataProvider.getItemAt(j)['subdivisi']=''}
						if (dg2.dataProvider.getItemAt(j)['proyek']==undefined){dg2.dataProvider.getItemAt(j)['proyek']=''}
						if (dg2.dataProvider.getItemAt(j)['catatan']==undefined){dg2.dataProvider.getItemAt(j)['catatan']=''}
					}
				}
			}
			
