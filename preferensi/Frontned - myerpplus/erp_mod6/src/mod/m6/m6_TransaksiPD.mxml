				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				
				o.pdtotalhargaout=0; o.pdtotalhppout = 0; o.pdtotalqtyout = 0
				for(var ih:int=0;ih<dg2.dataProviderLength;ih++){
					dg2.dataProvider.getItemAt(ih).subtotal= Number(dg2.dataProvider.getItemAt(ih).jml * dg2.dataProvider.getItemAt(ih).harga);
					o.pdtotalqtyout += Number(dg2.dataProvider.getItemAt(ih).jml);
					if(dg2.dataProvider.getItemAt(ih).subtotal > 0){
						o.pdtotalhargaout += Number(dg2.dataProvider.getItemAt(ih).subtotal);
					}
					if(Number(dg2.dataProvider.getItemAt(ih).hpp) > 0){
						o.pdtotalhppout +=Number(dg2.dataProvider.getItemAt(ih).hpp);
					}
				}
				o.pdtotalhargain=0; o.pdtotalhppin = 0;
				for(var ib:int=0;ib<dg.dataProviderLength;ib++){
					dg.dataProvider[ib].subtotal = Number(dg.dataProvider[ib].jml) * Number(dg.dataProvider[ib].harga);
					if(o.pcwajibwo == 3){
						dg.dataProvider[ib].subtotal = Number(dg.dataProvider.getItemAt(ib).hpppersen)/100*o.pdtotalhargaout;
						dg.dataProvider[ib].harga = Number(dg.dataProvider.getItemAt(ib).subtotal)/Number(dg.dataProvider.getItemAt(ib).jml);
					}
					if(dg.dataProvider[ib].subtotal > 0){
						o.pdtotalhargain += Number(dg.dataProvider.getItemAt(ib).subtotal);
					}
					if(dg.dataProvider.getItemAt(ib).hpp){
						o.pdtotalhppin +=Number(dg.dataProvider.getItemAt(ib).hpp);
					}
					
				} 
				
				f_hitungJenisWIP();
				lbltotalhasil.text = parentApplication.m.nfNominal.format(o.pdtotalhargain);
				lbltotalbahan.text = parentApplication.m.nfNominal.format(o.pdtotalhargaout);
			}
			
			public function f_hitungJenisWIP(){
				if(FlexGlobals.topLevelApplication.subject != "tampil"){
					if(f_ProduksiManual(txtaktivitas.text)){
						dg.dataProvider[0].jml = o.pdtotalqtyout;
						dg.dataProvider[0].jmlbarang = o.pdtotalqtyout*dg.dataProvider.getItemAt(0).nilaisatuan;
						if(dg.dataProvider != null)
							this.callLater((dg.dataProvider as ArrayCollection).refresh);
					}
				}
			}
			
			public function F_formatNominalPD(data:String):String
			{
				if(data == null || data == '')
					data = '0';
				
				data = data.split(parentApplication.m.nfNominalPD.decimalSeparator).join('.');
				parentApplication.m.temp = data.split('+');
				if(parentApplication.m.temp.length > 1){
					return data;
				}else
					return parentApplication.m.nfNominal.format(data);
			}
			
			public function F_HitungPersentase():void
			{
				//customdbl3  =  jumlah bagus, customdbl2 = reject
				var totalhasil : Number = 0
				for (var i:int = 0; i<dg.dataProviderLength; i++){
					totalhasil += Number(dg.dataProvider[i].jml);
				}
				
				for (var j:int = 0; j<dg.dataProviderLength; j++){
					dg.dataProvider[j].hpppersen = (dg.dataProvider[j].jml/ totalhasil) * 100;
				}
				
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
			}
			
			protected function f_ProduksiManual(proses:String):Boolean{
				var arrProses:Array = ["MAT", "WIPBW2", "Difference","FS-FG","FG-FS"];
				var result:Boolean = false
				
				for(var i:int = 0; i<arrProses.length; i++){
					if(proses.indexOf(arrProses[i]) > -1){
						result = true;
						break;
					}
				}
				return result
			}
			
