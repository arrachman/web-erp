			public function f_focusOnMe():void
			{
				txtjenis.setFocus();
			}
			
			public function msgAlert(focus: Object, indonesia: String, inggris: String):void
			{		
				if(validasi == true)focus.setFocus();
				pesanAlertIng += inggris+', ';
				pesanAlert += indonesia+', ';
				if(focus == 'clear'){
					pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
					pesanAlert += " harus diisi dengan benar";
					
					pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
					pesanAlertIng += " must be filled";
					Alert.show(pesanAlert+" !" , "Information");}	
				//\n
				validasi = false;						
			}
			
			public function f_filtersb():void{
				fserial = 's'; fbatch = 'b';
				for(i=0; i<dg2.dataProviderLength; i++){
					if(dg2.dataProvider[i].bserial ==	1){
						if(fserial == 's'){
							fserial = '(nsiidbarang = ' + dg2.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}else{
							fserial += ' or (nsiidbarang = ' + dg2.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}
					}
					
					if(dg2.dataProvider[i].bbatch ==	1){
						if(fbatch == 'b'){
							fbatch = '(nbiidbarang = ' + dg2.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}else{
							fbatch += ' or (nbiidbarang = ' + dg2.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg2.dataProvider[i].gudangproduksi+'")';
						}
					}
				}
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case 'checkBox':
						// jika fokus di centang HK
						if(dataField == 'hk'){
							if(data == true && dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).bhpp == 'I'){
								parentApplication.F_popUpCari('hk');
								
							}
							
						}
						break;
					case  'calculator':
						dg2.dataProvider[dg2.selectedCell.rowIndex][dataField] = data
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg2, dg2.selectedCell.rowIndex);
						switch (dataField){
							case 'jml':
							case 'harga':
								var dgrid1:Object;
								dgrid1 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
								dgrid1.subtotal = dgrid1.harga * dgrid1.jml;
								dgrid1.jmlbarang = dgrid1.jml * dgrid1.nilaisatuan;
								f_hitungTotal();
								break;
							case 'subtotal':
								hargaDariSubtotal.hitungHargaDariSubtotal(dg2, false);
								break;
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
				f_hitungTotal();
				
			}
			protected function f_persiapan():void
			{
				p = parentApplication;
				p.F_tabvalidatenow(tab);
				p.F_DateFieldStandard([dttgl,dttanggalnoref,dttgldibutuhkan]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress])
				p.F_TextInputNumberDesimalMode([txtkurs]);
				p.F_txtPencarianKhusus([txtkontakperson,txtcatatan]);
				p.F_txtpencarian([txtjenis,txtmatauang,txtbagretur,txtgudangproduksi,txtgudangterima,txtestimasi]);
				p.F_SetNavigasiKeyboard([txtnotransaksi,txtkurs,txturaian,txtnoref]);
				tab.tabFocusEnabled = false;
				
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				
				//set default
				vUang = p.getSetting(0, 'accounting', 'MataUangFungsional');//Ambil dari m0_setting 'kode currency'
				vKurs= p.getSetting(0, 'accounting', 'Kurs');//Ambil dari m0_setting 'kurs currency'
				txtgudangproduksi.text=p.ugudang;
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Ambil MRS", icon:"tbtake", enabled:"true"},
					{label:"No Serial/Batch Out", icon:"tbserialout", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"false"},
					{label:"File", icon:"tbattachment", enabled:"false"},
					{label:"Links", icon:"tblink", enabled:"false"},
					{label:"History", icon:"tbhistory", enabled:"true"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}])
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbGetBom);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbSerial);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[7].addEventListener(MouseEvent.CLICK, f_mbLinks);
				function f_mbSimpan():void
				{
					f_simpan();
				}
				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi("Mrn");
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
					f_kondisiAwal(); 
					tab.selectedIndex = 0;
					acserialdetail.removeAll();
					acbatchdetail.removeAll();
				}
				
				function f_mbGetBom():void{
					pesanAlert = ''; pesanAlertIng = ''; validasi = true;
					if(txtjenis.text.length == 0){
						if(txtjenis.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtjenis, 'Jenis Produksi');
						if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');
					}else{
						FlexGlobals.topLevelApplication.F_popUpCari('AmbilMrs');
					}
				}
				function f_mbSerial():void{
					o.ceks = true; o.cekb = true;
					o.sumber = 'MRN';
					o.moduleid = 6;
					o.mnid = 7;
					o.idgrid = dg2.id;
					o.gudang = txtgudangproduksi.text;
					f_filtersb();
					o.aserial = acserialdetail;
					o.abatch = acbatchdetail;
					FlexGlobals.topLevelApplication.openFormX("No. Serial/Batch",1,'mod/m0/m0_SerialOut.swf',426,602,'t1');
					
					
				}
				function f_mbCatatan():void{
					if (mb.menuBarItems[5].enabled==true){parentApplication.F_OpenNotes(o.mrnsumber,o.mrnid,txtnotransaksi.text);}
				}
				
				function f_mbUpload():void {
					if(mb.menuBarItems[6].enabled==true)FlexGlobals.topLevelApplication.F_OpenUploadFile('MRN', o.mrnid,txtnotransaksi.text);
				}
				function f_mbLinks():void
				{
					if(mb.menuBarItems[7].enabled==true)FlexGlobals.topLevelApplication.f_mbLinks(6,'Mrn');
				}
				
				this.addEventListener(KeyboardEvent.KEY_DOWN, f_KEY_DOWN);
				function f_KEY_DOWN(e:KeyboardEvent):void
				{
					switch(e.keyCode){
						case Keyboard.S:if(e.ctrlKey)f_simpan();break;
					}
				}
				//untuk ambil setting dari Json
				FlexGlobals.topLevelApplication.F_RegGrid(6,7,[dg2],'TransaksiBarang');
				f_validasi();
			}
			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi : String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					//input
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						//history
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M6_MrnHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						//edit
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M6_MrnGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
				//end of set getdata by id===============================================================================================
			}
			protected function f_kondisiAwal():void
			{
				isUpdate = false;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				cmbprogress.selectedIndex = 1;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].enabled = false;
				mb.menuBarItems[8].visible = false;
				mb.menuBarItems[9].visible = false;
				txturaian.text= p.getNomor('MRN');//ambil dari m0_nomor
				txtcatatan.text= p.getNomor('MRN',1);
				txtmatauang.text = vUang;
				o.txtkurs = vKurs;
				txtkurs.text = parentApplication.m.nfNominal.format(o.txtkurs);
				f_focusOnMe();
				txtgudangproduksi.text = FlexGlobals.topLevelApplication.getSetting(3,'defaultgudang','GudangProduksi');
				lblgprod.text = FlexGlobals.topLevelApplication.getSetting(3,'defaultgudang','GudangProduksiNama');
				txtgudangterima.text = FlexGlobals.topLevelApplication.ugudang;
				lblgudangterima.text = FlexGlobals.topLevelApplication.ugudangnama;
				txtbagretur.text = FlexGlobals.topLevelApplication.ukontakkode;
				lblbagianretur.text = FlexGlobals.topLevelApplication.ukontaknama;
				p.F_SetNilaiText([dttgl,dttanggalnoref,dttgldibutuhkan], p.DefaultTanggal);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtjenis, lbljenis, txtestimasi, txtkontakperson, txtnoref]);
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotalbahan],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				o.mrnid = 0; o.mrncabang = FlexGlobals.topLevelApplication.ucabang; o.mrnlokasi = FlexGlobals.topLevelApplication.ulokasi; o.mrnsumber = 'MRN'; 
				o.mrnkodepa = 0; o.mrnbagianmrn = FlexGlobals.topLevelApplication.ukontak; o.mrntotalhargain=0; o.mrntotalhargaout=0; o.mrntotalhppin=0; 
				o.mrntotalhppout=0; o.mrnidbom=0; o.mrnidpdr=0; 
				o.mrnidwo=0; o.mrnidmrs=0; o.mrnstatuspdin=0; o.mrnstatuspdout=0; o.mrnstatussebelumnya=0; o.mrnjmlrevisi=0; 
				o.mrncetakanke=0; o.mrninputuser=FlexGlobals.topLevelApplication.userid; o.mrninputtgl=FlexGlobals.topLevelApplication.m.DateFirst; 
				o.mrnmodifikasiuser=0; o.mrnmodifikasitgl=FlexGlobals.topLevelApplication.m.DateFirst; o.mrnisclose=0; o.mrncustomtext1=''; 
				o.mrncustomtext2=''; o.mrncustomtext3=''; o.mrncustomtext4=''; o.mrncustomtext5=''; o.mrncustomint1=0; o.mrncustomint2=0; o.mrncustomint3=0; 
				o.mrncustomdbl1=0; o.mrncustomdbl2=0; o.mrncustomdbl3=0; 
				o.mrncustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.mrncustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst;
				o.mrncustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
//				
				//--------------------------------------------------------------------------------------------------
				
				
				for(i=0; i<dg2.dataProviderLength; i++){
					dg2.dataProvider.getItemAt(i).kodebarang=''; 
				}
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				//--------------------------------------------------------------------------------------------------
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				//--------------------------------------------------------------------------------------------------//
				var i:int, n:Number, a:Array, dgrid1:Object;
				switch(column){ 
					case 'jml':
					case 'harga':
						dgrid1 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
						dgrid1.subtotal = dgrid1.harga * dgrid1.jml;
						dgrid1.jmlbarang = dgrid1.jml * dgrid1.nilaisatuan;
						break;
					case 'pre_del':
						hapusserial();
						hapusbatch();
						break;
					case 'subtotal':
						hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
				f_hitungTotal();
				//--------------------------------------------------------------------------------------------------
			}
			
			//hapus serial jika barangnya tidak ada
			public function hapusserial():void{
				var s:int;
				if(acserialdetail.length > 0){
					for(s=acserialdetail.length-1; s>=0; s--){
						if(acserialdetail[s].nstidbarang == dg2.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							acserialdetail.removeItemAt(s);
						}
					}
				}
			}
			
			public function hapusbatch():void{
				var b:int;
				if(acbatchdetail.length > 0){
					for(b=acbatchdetail.length-1; b>=0; b--){
						if(acbatchdetail[b].nbtidbarang == dg2.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
							acbatchdetail.removeItemAt(b);
						}
					}
				}
			}
			
			
			public function f_filter(target:String):Array
			{
				var paket:String='',dgrid: Object, wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				try{
					dgrid = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex)
				} 
				catch(error:Error){}
				switch(target){
//					case 'AmbilMrs': 
//						paket = 'CdM6_Mrs';
//						csfilter = '(mrsstatus = 2 or mrsstatus = 3) and mrsjenis = "'+txtjenis.text+'"';
//						sort = 'mrsnotransaksi desc';
//						//checkbox = true;
//						break;
					case 'AmbilMrs': 
						paket = "CdM6_Mrs_Out";
						csfilter = '(mrsstatus = 2 or mrsstatus = 3) and statusrealisasi <> 2 and gudangproduksi = "'+txtgudangproduksi.text+'" and mrsjenis = "'+txtjenis.text+'"';
						sort = "mrsnotransaksi desc";
						checkbox = true;
						id = "idmrsout";
						break;
					case "txtjenis":
						paket = "CdM1_Production_Category";
						wsfilter = 'pcaktif=1 AND pcwajibwo = 1 and pckode ="'+txtjenis.text+'"';
						csfilter = 'pcaktif=1 AND pcwajibwo = 1'
						sort = 'pckode asc';
						break;
					case 'txtestimasi':
						paket = 'CdM1_Working_Estimate';
						wsfilter = "weaktif=1 AND wekode ='"+txtestimasi.text+"'";
						csfilter = "weaktif=1";
						sort = "wekode asc";
						break;
					case 'txtgudangproduksi':
						paket = 'CdM1_Warehouse';
						wsfilter = "waktif=1 AND wkode ='"+txtgudangproduksi.text+"'";
						csfilter = "waktif=1";
						sort = "wkode asc";
						break;
					case 'txtgudangterima':
						paket = 'CdM1_Warehouse';
						wsfilter = "waktif=1 AND wkode ='"+txtgudangterima.text+"'";
						csfilter = "waktif=1";
						sort = "wkode asc";
						break;
					case 'txtkontakperson':
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ="'+o.mrnbagianmrn+'" AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ="'+o.mrnbagianmrn+ '"';
						sort = "kakodekontak asc";
						break;
					case 'txtmatauang':
						paket = 'CdM1_Currency';
						wsfilter = "caktif=1 AND ckode = '"+ txtmatauang.text +"'";
						csfilter = "caktif=1";
						sort = "ckode asc";
						break;
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = "tnaktif=1 AND tnsumber = 'MRN'";
						sort = "tnkode asc";
						break;
					case 'txtbagretur':
						paket = 'CdM1_Contact';
						wsfilter = "(kaktif=1 AND kkategori='K') AND kkode ='"+txtbagretur.text+"'";
						csfilter = "(kaktif=1 AND kkategori='K')";
						csfield = 4;
						sort = "kkode asc";
						break;
					case 'kodebarang':
						paket = 'CdM1_Item';
						wsfilter = '(baktif=1 AND bhpp="'+FlexGlobals.topLevelApplication.getSetting(0,'company','HppGlobal')+'" or bhpp = "I") and bkode = "'+dgrid.kodebarang+'"';
						wsfilter = '(baktif=1 AND bhpp="'+FlexGlobals.topLevelApplication.getSetting(0,'company','HppGlobal')+'" or bhpp = "I")';
						sort = "bkode asc";
						break;
					case 'satuan':
						paket = 'CdM1_Unit';
						wsfilter = "uaktif=1 AND ukode = '"+dgrid.satuan+"'";
						csfilter = "uaktif=1";
						sort = "ukode asc";
						break;
					case "hk":
						paket = "CdM1_Cogs_Special_In";
						csfilter ='isclose = 0 AND idbarang ='+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).idbarang+' and sisa > 0';
						wsfilter = "isclose = 0";
						break;
					case 'pajak1':
						paket = 'CdM1_Tax';
						wsfilter = "taktif=1 AND tkode = '"+ dgrid.pajak1 +"'";
						csfilter = "taktif=1";
						break;
					case 'pajak2':
						paket = 'CdM1_Tax';
						wsfilter = "taktif=1 AND tkode = '"+ dgrid.pajak2 +"'";
						csfilter = "taktif=1";
						break;
					case 'catatan':
						paket = 'CdM1_Transaction_Note_Detail';
						csfilter = 'tndaktif=1 AND tndsumber = "MRN"';
						sort = 'tndkode asc';
						break;
					case 'gudangasal':
						paket = 'CdM1_Warehouse';
						wsfilter = "waktif=1 AND wkode = '"+ dgrid.gudangasal +"'";
						csfilter = "waktif=1";
						sort = "wkode asc";
						break;
					case 'gudangproduksi':
						paket = 'CdM1_Warehouse';
						wsfilter = "waktif=1 AND wkode = '"+ dgrid.gudangproduksi +"'";
						csfilter = "waktif=1";
						sort = "wkode asc";
						break;
					case 'gudangtujuan':
						paket = 'CdM1_Warehouse';
						wsfilter = "waktif=1 AND wkode = '"+ dgrid.gudangtujuan +"'";
						csfilter = "waktif=1";
						sort = "wkode asc";
						break;
					case 'costcenter':
						paket = 'CdM1_Cost_Center';
						wsfilter = "ccaktif=1 AND cckode = '"+ dgrid.costcenter +"'";
						csfilter = "ccaktif=1";
						sort = "cckode asc";
						break;
					case 'divisi':
						paket = 'CdM1_Division';
						wsfilter = "daktif=1 AND dkode = '"+ dgrid.divisi +"'";
						csfilter = "daktif=1";
						sort = "dkode asc";
						break;
					case "subdivisi":
						paket = 'CdM1_Subdivision';
						wsfilter = 'sdaktif=1 AND sddivisi = "'+dgrid.divisi.split('"').join('\\"')+'" AND sdkode = "'+dgrid.subdivisi.split('"').join('\\"')+'"';
						csfilter = 'sdaktif=1 AND sddivisi = "'+dgrid.divisi.split('"').join('\\"')+'"';
						sort = 'sdkode asc';
						break;
					case 'proyek':
						paket = 'CdM1_Project';
						wsfilter = "paktif=1 AND pkode = '"+ dgrid.proyek +"'";
						csfilter = "paktif=1";
						sort = "pkode asc";
