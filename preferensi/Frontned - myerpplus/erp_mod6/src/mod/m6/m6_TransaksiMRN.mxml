			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'txtjenis':p.F_KosongkanText([txtjenis, lbljenis]);break;
					case 'txtcatatan':p.F_KosongkanText([txtcatatan]);break;
					case 'txtgudangproduksi':p.F_KosongkanText([txtgudangproduksi,lblgprod]);break;
					case 'txtmatauang':p.F_KosongkanText([txtmatauang, txtkurs]);break;
					case 'txtgudangterima':p.F_KosongkanText([txtgudangterima,lblgudangterima]);break;
					case 'txtestimasi':p.F_KosongkanText([txtestimasi]);break;
					case 'txtbagretur':p.F_KosongkanText([txtbagretur,lblbagianretur]);break;
					//case 'txtkontakperson':p.F_KosongkanText([txtkontakperson,lblkontakper]);break;
				}
			}
			
			
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var a:Array, utama:String, detailhasil:String = '', detailbahan:String = '', serial:String = '', batch:String = '';
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){
						//Set Utama
						with(o){
							a = [mrnid, mrncabang, mrnlokasi, FlexGlobals.topLevelApplication.ugudang, txtgudangproduksi.text, txtgudangterima.text, mrnsumber, 
								txtjenis.text, int(chkauto.selected), txtnotransaksi.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl.text), 
								mrnkodepa, mrnbagianmrn, txtkontakperson.text, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(dttgldibutuhkan.text), txtestimasi.text, 
								txtmatauang.text, o.txtkurs, mrntotalhargain, mrntotalhargaout, mrntotalhppin, 
								mrntotalhppout, txturaian.text, txtcatatan.text, txtnoref.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttanggalnoref.text), 
								mrnidbom, mrnidpdr,mrnidwo, mrnidmrs, mrnstatuspdin, mrnstatuspdout, 
								cmbprogress.selectedItem.v, 
								mrnstatussebelumnya, mrnjmlrevisi, 
								mrncetakanke, mrninputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(mrninputtgl), 
								mrnmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(mrnmodifikasitgl), mrnisclose, mrncustomtext1, 
								mrncustomtext2, mrncustomtext3, mrncustomtext4, mrncustomtext5, mrncustomint1, mrncustomint2, mrncustomint3, 
								mrncustomdbl1, mrncustomdbl2, mrncustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(mrncustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(mrncustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(mrncustomdate3)];
							utama = f_splitArrayToString(a);
						}
						//Set Detail
						
						
						for(i=0;i<dg2.dataProviderLength;i++){
							with(dg2.dataProvider.getItemAt(i)){
								a = [idmrnout, idmrn, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, kurs, harga, hpp, 
									idhppkhususkeluar, idhppfifokeluar, rekpersediaan, cabang, lokasi, FlexGlobals.topLevelApplication.ugudang, gudangproduksi, 
									gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, urutan, 
									idbomout, idpdrout, idwoout, idmrsout, jmlpd, statuspd, isclose, 
									customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								
								if(detailbahan == '')detailbahan =f_splitArrayToString(a);
								else detailbahan += "▲"+f_splitArrayToString(a);
							}
						}
						
						//set serial
						for(var ib:int=0;ib < acserialdetail.length;ib++){
							with(acserialdetail.getItemAt(ib)){
								a = [nstid, nstjenismutasi, nstidbarang, nstkode, nstsumber, nstidtransaksi, nstsatuan, 
									1, nstcustomtext1, nstcustomtext2, nstcustomtext3, nstcustomdbl1, nstcustomdbl2, nstcustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate3),
									txtgudangterima.text, nstidserialin];
								if(serial == '')serial =FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else serial += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						// Set batch
						for(var ibb:int=0; ibb < acbatchdetail.length; ibb++){
							with(acbatchdetail.getItemAt(ibb)){
								a = [nbtid, nbtjenismutasi, nbtidbarang, nbtkode, nbtsumber, nbtidtransaksi, nbtsatuan, 
									nbtjml, nbtcustomtext1, nbtcustomtext2, nbtcustomtext3, nbtcustomdbl1, nbtcustomdbl2, nbtcustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate3),
									txtgudangterima.text, nbtidbatchin];
								if(ibb == 0)batch =FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								else batch += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							}
						}
						//set serial
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M6_MrnSimpan", parentApplication.userid, isUpdate, utama, detailbahan+"△"+batch+"△"+serial);
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					parentApplication.F_hapusBarisKosongGrid(dg2);
					pesanAlert = "";
					pesanAlertIng = "";
					if(txtjenis.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtjenis, 'Jenis Produksi');
					if(txtgudangproduksi.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtgudangproduksi,'Gudang Produksi');
					if(txtgudangterima.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtgudangterima,'Gudang Tujuan');
					if(txtmatauang.text.length == 0)FlexGlobals.topLevelApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(txtkurs,'Kurs');
					if(dttgl.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgl,'Tanggal');
					if(dttgldibutuhkan.text.length <= 0)FlexGlobals.topLevelApplication.msgAlert(dttgldibutuhkan,'Tanggal dibutuhkan');
					if(cmbprogress.selectedIndex < 0)FlexGlobals.topLevelApplication.msgAlert(cmbprogress,'Progress');
					
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert','');
					
					
					f_hitungTotal();
					
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				
				o.mrntotalhargaout=0; o.mrntotalhppout = 0;
				for(var ih:int=0;ih<dg2.dataProviderLength;ih++){
					dg2.dataProvider.getItemAt(ih).subtotal= Number(dg2.dataProvider.getItemAt(ih).jml * dg2.dataProvider.getItemAt(ih).harga);
					o.mrntotalhargaout += Number(dg2.dataProvider.getItemAt(ih).subtotal);
					o.mrntotalhppout +=Number(dg2.dataProvider.getItemAt(ih).hpp);
				}
				
				lbltotalbahan.text = parentApplication.m.nfNominal.format(o.mrntotalhargaout);
			}
