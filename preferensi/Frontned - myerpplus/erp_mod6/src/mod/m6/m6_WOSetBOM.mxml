			public function f_hitungTotalDetail():void
			{
				n.vtotal=0;
				for(var i:int=0;i<dgBOM.dataProvider.length;i++){
					if(dgBOM.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dgBOM.dataProvider.getItemAt(i).subtotal);
				}
				lblTotal.text = parentApplication.m.nfNominal.format(n.vtotal);	
			}
			
			public function f_hitungGrid():void
			{ 
				var dgrid: Object; 
				for(i = 0; i<dgBOM.dataProviderLength; i++){ 
					dgrid = dgBOM.dataProvider[i];
					dgrid.subtotal = Number(dgrid.jml) * Number(dgrid.harga); 
				} 
