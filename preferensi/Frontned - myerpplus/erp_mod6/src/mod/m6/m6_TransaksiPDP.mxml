			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				o.DefaultProgress = FlexGlobals.topLevelApplication.setProgress(cmbprogress, 6, "PD");
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						//history
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M6_PdHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						//edit
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M6_PdpGetdataById', idtransaksi, 0, 0, '', 'mesin, urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
			}
