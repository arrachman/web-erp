			public function f_hitungTotal():void
			{
				totaljam = 0;
				totalproduksi = 0;
				for(var i:int = 0; i<dg2.dataProviderLength; i++){
					if(acMesin.getItemAt(i).jmljam != undefined)totaljam += Number(acMesin.getItemAt(i).jmljam);
					if(acMesin.getItemAt(i).jml != undefined)totalproduksi += Number(acMesin.getItemAt(i).jml);
				}
				
				lbltotaljam.text = parentApplication.m.nfNominal.format(totaljam)+" JAM";
				lbltotalproduksi.text = parentApplication.m.nfNominal.format(totalproduksi)+" KG";
				
//				f_GrandTotal();
			}
			public function f_GrandTotal():void{
				acMesin.filterFunction = null;
				acMesin.refresh();
				var totaljamglobal:Number = 0, totalproduksiglobal:Number = 0;
				for(var i:int = 0; i<dg2.dataProviderLength; i++){
					if(acMesin.getItemAt(i).jmljam != undefined)totaljamglobal += Number(acMesin.getItemAt(i).jmljam);
					if(acMesin.getItemAt(i).jml != undefined)totalproduksiglobal += Number(acMesin.getItemAt(i).jml);
				}
				
				lblgrandtotaljam.text = parentApplication.m.nfNominal.format(totaljamglobal)+" JAM";
				lblgrandtotalproduksi.text = parentApplication.m.nfNominal.format(totalproduksiglobal)+" KG";
				
				acMesin.filterFunction = filterMyArrayCollection;
				acMesin.refresh();
				if(dg2.dataProviderLength == 0){
					FlexGlobals.topLevelApplication.F_acAdd(dg2);
					dg.setFocus();
				}else{
//					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg2);
					dg.setFocus();
				}
			}
			

			
			private function filterMesin():void{
				
				acMesin.filterFunction = filterMyArrayCollection;
				acMesin.refresh();
					if(dg2.dataProviderLength == 0){
						FlexGlobals.topLevelApplication.F_acAdd(dg2);
						dg.setFocus();
					}else{
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg2);
						dg.setFocus();
					}
					f_hitungTotal();
					f_GrandTotal();
			}
			
			private function filterMyArrayCollection(item:Object):Boolean {
				var searchString:String;
				var itemName:String;
				if(dg.selectedCell != null) searchString = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).mesin+"Mesin";	
				if(item.mesin == undefined) item.mesin = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).mesin;
				itemName = String(item.mesin)+"Mesin";
				if(itemName == null || itemName == "")return true;
				return itemName.indexOf(searchString) > -1;
			}
