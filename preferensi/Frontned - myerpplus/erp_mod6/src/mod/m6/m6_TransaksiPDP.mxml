			public function f_grid(dg:DataGrid, column:String):void
			{ 
				var mesin:int
				var grid:Object;
				
				switch(column){
					case 'del':
//						Alert.show(dg2.dataProviderLength+"");
//						if(dg2.dataProviderLength == 0){
//							FlexGlobals.topLevelApplication.F_acAdd(dg2);
//							dg.setFocus();
//						}	
						break;
					case 'pre_del':
						if(tab.selectedIndex == 0){
							if(dg != dg2){
								mesin = dg.dataProvider[dg.selectedCell.rowIndex].mesin
								if(dg.selectedCell != null){
									for(var a:int = dg2.dataProviderLength - 1; a>=0; a--){
										if(mesin == dg2.dataProvider[a].mesin){
											dg2.dataProvider.removeItemAt(a);
										}
									}
								}
							}	
						}
						break;
					//PDP
					case 'prosentaseallowance':
						if(tab.selectedIndex == 1){
							grid = dg3.dataProvider[dg3.selectedCell.rowIndex];
							
						}
						grid.jmlallowance = Number(grid.prosentaseallowance)/100 * Number(grid.jmlso);
						grid.jmltotal = Number(grid.jmlso) + Number(grid.jmlallowance);
						f_hitungTotal()
						f_GrandTotal()
						break
					case 'jmlallowance':
						if(tab.selectedIndex == 1){
							grid = dg3.dataProvider[dg3.selectedCell.rowIndex];
						}
						grid.prosentaseallowance = Number(grid.jmlallowance)/Number(grid.jmlso) * 100;
						grid.jmltotal = Number(grid.jmlso) + Number(grid.jmlallowance);
						f_hitungTotal()
						f_GrandTotal()
						break
					case 'jmltotal':
						grid.jmlallowance = Number(grid.jmltotal) - Number(grid.jmlso);
						grid.prosentaseallowance = Number(grid.jmlallowance)/Number(grid.jmlso) * 100;
						f_hitungTotal()
						f_GrandTotal()
						break
					
					case 'jml2':
							with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
								if(operator != 0){
									jml2 = 0;
								}
							}	
							f_hitungTotal()
							f_GrandTotal()
						break;
					case "jml1":
						
						
						break;
					case 'jumlahvalas':
							with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
								if (txtmatauang.text != UFungsional){
									jumlah = Number(jumlahvalas) * o.txtkurs;
								}else{
									jumlahvalas = 0;
								}
							}	
							f_hitungTotal()
							f_GrandTotal()
						break;
				}
//				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
//				FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
				FlexGlobals.topLevelApplication.F_dgRefresh(dg3);
				
			}
			
