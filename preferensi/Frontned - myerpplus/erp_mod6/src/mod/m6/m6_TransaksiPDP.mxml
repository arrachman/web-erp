			public function f_filterdata():String{
				var f:String="";
				
				var	tgl1:String = parentApplication.F_tglFormatDB(dttgl1.text), tgl2:String = parentApplication.F_tglFormatDB(dttgl2.text);
				
				if(txtmesin1.text != '' && txtmesin2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'mesin BETWEEN "'+txtmesin1.text+'" AND "'+txtmesin2.text+'"');
				}
				else if(txtmesin1.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'mesin LIKE "%'+txtmesin1.text+'%"');
				}
				else if(txtmesin2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(txtmesin2, 'mesin LIKE "%'+txtmesin2.text+'%"');
				}
				
				if(dttgl1.text != '' && dttgl2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'tgl BETWEEN "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'" AND "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
				else if(dttgl1.text != '') 
					f = FlexGlobals.topLevelApplication.TambahFilter(f, f+'tgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'"'); 
				else if(dttgl2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, f+'tgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
				
				
				if(txtkategori1.text != '' && txtkategori2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'kelas BETWEEN "'+txtkategori1.text+'" AND "'+txtkategori2.text+'"');
				}
				else if(txtkategori1.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'kelas LIKE "%'+txtkategori1.text+'%"');
				}
				else if(txtkategori2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'kelas LIKE "%'+txtkategori2.text+'%"');
				}
				
				
				if(txtkelompok1.text != '' && txtkelompok2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'subkelas BETWEEN "'+txtkelompok1.text+'" AND "'+txtkelompok2.text+'"');
				}
				else if(txtkelompok1.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'subkelas LIKE "%'+txtkelompok1.text+'%"');
				}
				else if(txtkelompok2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'subkelas LIKE "%'+txtkelompok2.text+'%"');
				}
				
				
				return f;
			}
			
