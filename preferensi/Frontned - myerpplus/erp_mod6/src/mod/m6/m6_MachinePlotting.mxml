				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled ==true){
//						var jenissimpan:int = 1;
//						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
//						if(FlexGlobals.topLevelApplication.apaBisaAkses(12,54,jenissimpan)==true){
							f_simpan();
//						}
					}
				}
				function f_mbbuka():void{
					FlexGlobals.topLevelApplication.F_wsSearch('tampil', 'M6_Machine_PlottingSearch', 0, 0, f_filterdata(), "mesin, tgl", "", "", 0);
//					if(mb.menuBarItems[1].enabled ==true)FlexGlobals.topLevelApplication.f_bukaTransaksi('Bi');
				}
				function f_mbReset():void{
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
