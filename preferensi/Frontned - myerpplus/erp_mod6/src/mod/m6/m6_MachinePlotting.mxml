						mesin+= FlexGlobals.topLevelApplication.sptRow+dgmesin.dataProvider[i].mesin
					}else{
						mesin+= dgmesin.dataProvider[i].mesin
					}
						
				}
				
				var param: String = tgl+FlexGlobals.topLevelApplication.sptField+mesin+FlexGlobals.topLevelApplication.sptField+""+FlexGlobals.topLevelApplication.sptField+kategori+FlexGlobals.topLevelApplication.sptField+kelompok 
				FlexGlobals.topLevelApplication.F_wsSimpan("generate", "M6_Machine_PlottingGenerateMulti", parentApplication.userid, isUpdate, param);
			}
		
			
			
			public function f_filterdata():String{
				var f:String="";
				
				var	tgl1:String = parentApplication.F_tglFormatDB(dttgl1.text), tgl2:String = parentApplication.F_tglFormatDB(dttgl2.text);
				
				if(txtmesin1.text != '' && txtmesin2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'mesin BETWEEN "'+txtmesin1.text+'" AND "'+txtmesin2.text+'"');
				}
				else if(txtmesin1.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'mesin LIKE "%'+txtmesin1.text+'%"');
				}
				else if(txtmesin2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(txtmesin2, 'mesin LIKE "%'+txtmesin2.text+'%"');
				}
				
				if(dttgl1.text != '' && dttgl2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'tgl BETWEEN "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'" AND "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
				else if(dttgl1.text != '') 
					f = FlexGlobals.topLevelApplication.TambahFilter(f, f+'tgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+'"'); 
				else if(dttgl2.text != '')
					f = FlexGlobals.topLevelApplication.TambahFilter(f, f+'tgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text)+'"'); 
				
				
				if(txtkategori1.text != '' && txtkategori2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'kelas BETWEEN "'+txtkategori1.text+'" AND "'+txtkategori2.text+'"');
				}
				else if(txtkategori1.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'kelas LIKE "%'+txtkategori1.text+'%"');
				}
				else if(txtkategori2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'kelas LIKE "%'+txtkategori2.text+'%"');
				}
				
				
				if(txtkelompok1.text != '' && txtkelompok2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'subkelas BETWEEN "'+txtkelompok1.text+'" AND "'+txtkelompok2.text+'"');
				}
				else if(txtkelompok1.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'subkelas LIKE "%'+txtkelompok1.text+'%"');
				}
				else if(txtkelompok2.text != '')
				{
					f = FlexGlobals.topLevelApplication.TambahFilter(f, 'subkelas LIKE "%'+txtkelompok2.text+'%"');
				}
				
				return f;
			}
			
			protected function btnclose_changeHandler(event:IndexChangeEvent):void
			{
				f_close();
				
			}
			public function f_close(isclose:int = 0):void{
				var tgl : String = FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+FlexGlobals.topLevelApplication.sptField+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text);
				var mesin : String = txtmesin1.text+FlexGlobals.topLevelApplication.sptField+txtmesin2.text;
				var kategori : String = txtkategori1.text+FlexGlobals.topLevelApplication.sptField+txtkategori2.text;
				var kelompok : String = txtkelompok1.text+FlexGlobals.topLevelApplication.sptField+txtkelompok2.text;
				var param: String = tgl+FlexGlobals.topLevelApplication.sptField+mesin+FlexGlobals.topLevelApplication.sptField+kategori+FlexGlobals.topLevelApplication.sptField+kelompok 
				if(acMesin.length > 0){
					FlexGlobals.topLevelApplication.F_wsSimpan("close", "M6_Machine_PlottingClose", parentApplication.userid, isUpdate, param+FlexGlobals.topLevelApplication.sptField+isclose);
				}else{
					Alert.show("Tampilkan data terlebih dahulu sebelum close/unclose", "Informasi");
				}
				
				
			}
			
			protected function radiobutton1_clickHandler(event:MouseEvent):void
			{
				var tgl : String = FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text)+FlexGlobals.topLevelApplication.sptField+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text);
				var mesin : String = txtmesin1.text+FlexGlobals.topLevelApplication.sptField+txtmesin2.text;
				var kategori : String = txtkategori1.text+FlexGlobals.topLevelApplication.sptField+txtkategori2.text;
				var kelompok : String = txtkelompok1.text+FlexGlobals.topLevelApplication.sptField+txtkelompok2.text;
				var param: String = tgl+FlexGlobals.topLevelApplication.sptField+mesin+FlexGlobals.topLevelApplication.sptField+kategori+FlexGlobals.topLevelApplication.sptField+kelompok 
				var isclose:int = 0;
				// TODO Auto-generated method stub
				if(rbclose.selectedValue == "Close"){
					isclose = 1;
				}else{
					isclose = 0;
				}
				FlexGlobals.topLevelApplication.F_wsSimpan("close", "M6_Machine_PlottingClose", parentApplication.userid, isUpdate, param+FlexGlobals.topLevelApplication.sptField+isclose);
			}
			
		]]>
		
		
		
