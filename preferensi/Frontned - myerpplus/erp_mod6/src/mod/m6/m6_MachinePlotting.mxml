			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}
			}
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].enabled = false;
				mb.menuBarItems[8].visible = false;
				acMesin.removeAll();
				acMesin.refresh();
				tabbarang.enabled = true;
				isUpdate = false;
				txtmesin1.setFocus();
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("BI",1);
				parentApplication.F_SetNilaiText([dttgl1, dttgl2], parentApplication.DefaultTanggal);
				parentApplication.F_KosongkanText([txtmesin1, txtmesin2, txtkategori1, txtkategori2, txtkelompok1, txtkelompok2, txtkontakperson]);
	
				for(i=0; i<dg.dataProviderLength; i++){
					dg.dataProvider.getItemAt(i).mesin=''; 
				}	
				dg2.dataProvider.removeAll();
				FlexGlobals.topLevelApplication.F_defaultGridItem(dgmesin);
//				FlexGlobals.topLevelApplication.F_acAdd(dg2); 
//				filterMesin();
				f_focusOnMe();
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled ==true){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
								if(FlexGlobals.topLevelApplication.apaBisaAkses(12,54,jenissimpan)==true){
									f_simpan();
								}
							}
						break;
				}
			}	
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case  'calculator':
						
						break;
				}
				f_hitungTotal();
				f_hitungvalas();
				
			}
			
			public function f_grid(dg:DataGrid, column:String):void
			{ 
				var nogrup:int
				//				o.a = column.split('|');
				//				if(column == 'add' || o.a[0] == 'add'){
				//					if(dg == dg3){
				//						
				//						
				//					}
				//				}
				
				switch(column){
					case 'add':
						
						break;
					case 'pre_del':
							if(dg != dg2){
								nogrup = dg.dataProvider[dg.selectedCell.rowIndex].nogrup
								if(dg.selectedCell != null){
									for(var a:int = dg2.dataProviderLength - 1; a>=0; a--){
										if(nogrup == dg2.dataProvider[a].nogrup){
											dg2.dataProvider.removeItemAt(a);
										}
									}
								}
							}	
						break;
					case 'jml2':
							with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
								if(operator != 0){
									jml2 = 0;
								}
							}	
						break;
					case "jml1":
						
						
						break;
					case 'jumlahvalas':
							with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
								if (txtmatauang.text != UFungsional){
									jumlah = Number(jumlahvalas) * o.txtkurs;
								}else{
									jumlahvalas = 0;
								}
							}	
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal()
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case 'txtkategoripos':
						
						break;
					
					case 'mesin':
						paket = 'CdM1_Machine';
						wsfilter = 'maktif = 1 and mkode ="'+dgmesin.dataProvider.getItemAt(dgmesin.selectedCell.rowIndex).mesin+'"';
						csfilter = 'maktif = 1';
						csfield = 2;
						sort = '';
						break;
					
					case 'txtmesin1':
						paket = 'CdM1_Machine';
						wsfilter = 'maktif = 1 and mkode ="'+txtmesin1.text+'"';
						csfilter = 'maktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'txtmesin2':
						paket = 'CdM1_Machine';
						wsfilter = 'maktif = 1 and mkode ="'+txtmesin2.text+'"';
						csfilter = 'maktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'txtkategori1':
						paket = 'CdM1_Class';
						wsfilter = 'caktif = 1 and ckode ="'+txtkategori1.text+'"';
						csfilter = 'caktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'txtkategori2':
						paket = 'CdM1_Class';
						wsfilter = 'caktif = 1 and ckode ="'+txtkategori2.text+'"';
						csfilter = 'caktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'txtkelompok1':
						paket = 'M1_SubclassSearch';
						wsfilter = 'scaktif = 1 and sckode ="'+txtkelompok1.text+'"';
						csfilter = 'scaktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'txtkelompok2':
						paket = 'M1_SubclassSearch';
						wsfilter = 'scaktif = 1 and sckode ="'+txtkategori2.text+'"';
						csfilter = 'scaktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'kelas':
						paket = 'CdM1_Class';
						wsfilter = 'caktif = 1 and ckode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).kelas+'"';
						csfilter = 'caktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'subkelas':
						paket = 'M1_SubclassSearch';
						wsfilter = 'scaktif = 1 and sckode ="'+dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex).subkelas+'"';
						csfilter = 'scaktif = 1';
						csfield = 2;
						sort = '';
						break;
					case 'txtkontakperson':
						paket = 'CdM1_Contact_Attention';
						wsfilter = 'kaidkontak ='+o.bikontak+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.bikontak+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					
					case 'txtcatatan':
						paket = 'CdM1_Transaction_Note';
						csfilter = 'tnaktif=1 AND tnsumber="BI"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case 'kodebarang':
							
						break;
					
					case 'kodebarang2':
						
						break;
					
					case "costcenter": // Cost Center
						paket = "CdM1_Cost_Center";
						wsfilter = 'ccaktif=1 AND cckode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).costcenter+'"';
						csfilter = 'ccaktif=1';
						sort = 'cckode asc';
						break;
					case "divisi": // Divisi
						paket = "CdM1_Division";
						wsfilter = 'daktif=1 AND dkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						csfilter = 'daktif=1';
						sort = 'dkode asc';
						break;
					case "subdivisi": //sub divisi
						paket = "CdM1_Subdivision";
						wsfilter = 'sdkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi+'" AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'" AND sdaktif=1';
						csfilter = 'sdaktif=1 AND sddivisi="'+dg.dataProvider.getItemAt(parentApplication.rowIndex).divisi+'"';
						sort = 'sddivisi asc';
						break;
					case "proyek": // proyek
						paket = "CdM1_Project";
						wsfilter = 'paktif=1 AND pkode = "'+dg.dataProvider.getItemAt(parentApplication.rowIndex).proyek+'"';
						csfilter = 'paktif=1';
						sort = 'pkode asc';
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					switch(s){	
						case 'mesin':
							dgmesin.dataProvider.getItemAt(dgmesin.selectedCell.rowIndex).mesin = parentApplication.wsArrUtama.getItemAt(0).mkode;
							dgmesin.dataProvider.getItemAt(dgmesin.selectedCell.rowIndex).namamesin = parentApplication.wsArrUtama.getItemAt(0).mnama;
							FlexGlobals.topLevelApplication.F_dgRefresh(dgmesin);
							break;
						
						case 'txtmesin1':
							txtmesin1.text = parentApplication.wsArrUtama.getItemAt(0).mkode;
							txtmesin2.text = parentApplication.wsArrUtama.getItemAt(0).mkode;
							break;
						case 'txtmesin2':
							txtmesin2.text = parentApplication.wsArrUtama.getItemAt(0).mkode;
							break;
						case 'txtkategori1':
							txtkategori1.text = parentApplication.wsArrUtama.getItemAt(0).ckode;
							txtkategori2.text = parentApplication.wsArrUtama.getItemAt(0).ckode;
							break;
						case 'txtkategori2':
							txtkategori2.text = parentApplication.wsArrUtama.getItemAt(0).ckode;
							break;
						case 'txtkelompok1':
							txtkelompok1.text = parentApplication.wsArrUtama.getItemAt(0).sckode;
							txtkelompok2.text = parentApplication.wsArrUtama.getItemAt(0).sckode;
							break;
						case 'txtkategori2':
							txtkelompok2.text = parentApplication.wsArrUtama.getItemAt(0).sckode;
							break;
						case 'txtcabang':
							
							break;
						case 'txtkontakperson':
							txtkontakperson.text = parentApplication.wsArrUtama.getItemAt(0).kakodekontak;
							break;
						
						case 'txtcatatan':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							txtcatatan.text = ws.tncatatan;
							break;
						case 'kodebarang':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							var arr:Object ;
								arr = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
								arr.idbidetail = 0; 
								arr.idbi = 0; 
//								arr.bikategori = txtkategoripos.text; 
								arr.idbarang = ws.bid;
								arr.kodebarang = ws.bkode; 
								arr.namabarang = ws.bnama; 
								arr.operator = 1; 
								arr.jml1 = 1; 
								arr.jml2 = 0; 
								arr.customtext1 = ""; 
								arr.customtext2 = ""; 
								arr.customtext3 = ""; 
								arr.customtext4 = ""; 
								arr.customtext5 = ""; 
								arr.customint1 = 0; 
								arr.customint2 = 0; 
								arr.customint3 = 0; 
								arr.customdbl1 = 0; 
								arr.customdbl2 = 0; 
								arr.customdbl3 = 0; 
								arr.customdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
								arr.customdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
								arr.customdate3 = FlexGlobals.topLevelApplication.m.DateFirst; 
								arr.tgl1 = FlexGlobals.topLevelApplication.DefaultTanggal; 
								arr.tgl2 = FlexGlobals.topLevelApplication.F_tglJatuhTempo(FlexGlobals.topLevelApplication.DefaultTanggal, 1); 
								arr.nopromo = "";
								arr.nogrup = dg.dataProviderLength;
								arr.catatan = "";
								
								for(var a:int = 0; a<dg.dataProviderLength - 1; a++){
									if(arr.nogrup == dg.dataProvider[a].nogrup){
										arr.nogrup = Number(arr.nogrup) + 1
									}
								}
								arr.grup = "a"+arr.nogrup;
								FlexGlobals.topLevelApplication.F_dgRefresh(dg);
								filterMesin();
							break;
						
						case 'kelas':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							var arr2:Object;
							arr2 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
							arr2.kelas = ws.ckode; 
							break;
						case 'subkelas':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							var arr2:Object;
							arr2 = dg2.dataProvider.getItemAt(dg2.selectedCell.rowIndex);
							arr2.subkelas = ws.sckode; 
							break;
						
						case 'catatan':
							ws = parentApplication.wsArrUtama.getItemAt(0);
							dg.dataProvider.getItemAt(parentApplication.rowIndex).catatan = ws.tndcatatan;
							parentApplication.F_dgRefresh(dg);
							break;
						
						case 'generate':
							var b:Object = {};
							var indg:int = 0;
							var varmesin:String = ""
							var ngrup:int = 0;
							

							if(FlexGlobals.topLevelApplication.wsArrUtama.length > 0){
								dg.dataProvider.removeAll();
								dg2.dataProvider.removeAll();
								acMesin.filterFunction = null;
								acMesin.refresh();
								acMesin.removeAll();
								acMesin.refresh();
								for(var g:int=0; g < FlexGlobals.topLevelApplication.wsArrUtama.length; g++){
									if(b[FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(g).customdbl1] == undefined)
										b[FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(g).customdbl1] = 1;
									with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(g)){
										if(dg.dataProviderLength > 0){
											for (indg=0; indg<dg.dataProviderLength; indg++){
												if(varmesin != mesin){
													dg.dataProvider.addItem({mesin:mesin, mesinnama:mesinnama, nogrup:dg.dataProviderLength});
													b[customdbl1] = indg+1;
													customint1 = dg.dataProviderLength-1;
													varmesin = mesin;
												
												}
												
											}
										}else{
											dg.dataProvider.addItem({mesin:mesin, mesinnama:mesinnama, nogrup:dg.dataProviderLength})
											varmesin = mesin;
										}
										acMesin.addItem({no:b[customdbl1]++, mesin:mesin, tgl:tgl, kelas:kelas, subkelas:subkelas, jml:0, 
											satuan:"", nilaisatuan:1, 
											jmlbarang:0, satuanbarang:"", matauang:"", kurs:0, harga:0, 
											hpp:0, cabang:"", 
											lokasi:"", gudang:"", costcenter:"", divisi:"", subdivisi:"", 
											proyek:"", catatan:"", 
											urutan:urutan, jmlrealisasi:0, statusrealisasi:0, insertby:insertby, 
											isclose:isclose, inputuser:FlexGlobals.topLevelApplication.userid, inputtgl:FlexGlobals.topLevelApplication.DefaultTanggal, 
											modifikasiuser:modifikasiuser, modifikasitgl:modifikasitgl, customtext1:customtext1, 
											customtext2:customtext2, customtext3:customtext3, customtext4:customtext4, customtext5:customtext5, 
											customtext6:customtext6, customtext7:customtext7, customtext8:customtext8, customtext9:customtext9, 
											customtext10:customtext10, customint1:customint1, customint2:customint2, 
											customint3:customint3, customint4:customint4, customint5:customint5, customint6:customint6, 
											customint7:customint7, customint8:customint8, customint9:customint9, 
											customint10:customint10, customdbl1:customdbl1, customdbl2:customdbl2, customdbl3:customdbl3, 
											customdbl4:customdbl4, customdbl5:customdbl5, customdbl6:customdbl6, 
											customdbl7:customdbl7, customdbl8:customdbl8, customdbl9:customdbl9, customdbl10:customdbl10, 
											customdate1:customdate1, customdate2:customdate2, customdate3:customdate3, 
											customdate4:customdate4, customdate5:customdate5, customdate6:customdate6, customdate7:customdate7, 
											customdate8:customdate8, customdate9:customdate9, customdate10:customdate10, 
											mesinnama:mesinnama, kelasnama:kelasnama, subkelasnama:subkelasnama, inputusernama:inputusernama, 
											modifikasiusernama:modifikasiusernama, insertbynama:"", nogrup:customint1});
										
									}
								}
							}
							acMesin.refresh();
							for(var acm:int = 0; acm<acMesin.length; acm++){
								if(acMesin[acm].isclose == 0){
									acMesin[acm].isclosenama = "Open";
								}else{
									acMesin[acm].isclosenama = "Close";
								}
								
							}
							
							FlexGlobals.topLevelApplication.F_dgRefresh(dg2);
							dg.setSelectedCell(0, 1);
							filterMesin();
							break;
						case 'close':
						case 'tampil':
							var b:Object = {};
							var indg:int = 0;
							var varmesin:String = "";
							
							if(FlexGlobals.topLevelApplication.wsArrUtama.length > 0){
