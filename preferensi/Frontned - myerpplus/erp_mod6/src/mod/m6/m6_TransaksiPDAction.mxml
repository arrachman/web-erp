			public function f_writeExcel():void
			{
				var excelFile:ExcelFile = new ExcelFile();
				//ambil sheet pertama
				var sheet : Sheet = new Sheet;
				var fr:FileReference = new FileReference;
				for(var a:int = 0; a<ac2.length; a++){
					if(ac2[a].gagal == 1){
						if(sbj == "Draft"){
							acImportGagal.addItem({kode:ac2[a].pdnotransaksi, deskripsi:ac2[a].deskripsi});
						}
						else if(sbj == "Delete"){
							acImportGagal.addItem({kode:ac2[a].pdnotransaksi, deskripsi:ac2[a].deskripsi});
						}
						else if(sbj == "Approve"){
							acImportGagal.addItem({kode:ac2[a].pdnotransaksi, deskripsi:ac2[a].deskripsi});
						}
					}
				}
				
				for(var i:int = 0; i<acImportGagal.length; i++){
					if(sbj == "Draft"){
						sheet.setCell(0, 0, "No Transaksi");
						sheet.setCell(0, 1, "Deskripsi ");
						sheet.setCell(i+1,0,acImportGagal[i].kode);
						sheet.setCell(i+1,1,acImportGagal[i].deskripsi);
					}
					else if(sbj == "Delete"){
						sheet.setCell(0, 0, "No Transaksi");
						sheet.setCell(0, 1, "Deskripsi ");
						sheet.setCell(i+1,0,acImportGagal[i].kode);
						sheet.setCell(i+1,1,acImportGagal[i].deskripsi);			
					}
					else if(sbj == "Approve"){
						sheet.setCell(0, 0, "No Transaksi");
						sheet.setCell(0, 1, "Deskripsi ");
						sheet.setCell(i+1,0,acImportGagal[i].kode);
						sheet.setCell(i+1,1,acImportGagal[i].deskripsi);
					}
					excelFile.sheets.addItem(sheet);
				}
				FlexGlobals.topLevelApplication.F_wsUpload('Uploading', 'UploadFile', FlexGlobals.topLevelApplication.userid, "PD", "xls", excelFile.saveToByteArray(), 0, "Data Gagal.xls", "", "0", FlexGlobals.topLevelApplication.DefaultTanggalforDB, 0, 0, '', '');
			}
			
