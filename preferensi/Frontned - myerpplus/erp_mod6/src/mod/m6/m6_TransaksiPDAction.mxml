				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(ac2.length <= 0){
						FlexGlobals.topLevelApplication.msgAlert(dg,'Data')
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					
					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi == true)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						validasi = false;						
					}
				}

			}
			
			public function f_simpan():void{
				var a:Array, utama:String = '', detailhasil:String = '', detailbahan:String = '', serial:String = '', batch:String = '';
				// Set Utama
				
				with(arrutama.getItemAt(0)){
					a = [pdid, pdcabang, pdlokasi, pdgudangasal, pdgudangproduksi, pdgudangtujuan, pdsumber, pdjenis, pdautonotransaksi, 
						pdnotransaksi, parentApplication.F_tglFormatDB(pdtgl), pdkodepa, pdbagianpd, pdbagianpdkontak, 
						parentApplication.F_tglFormatDB(pdtgldipakai), pdestimasikerja, pdmatauang, pdkurs, pdtotalhargain, pdtotalhargaout, 
						pdtotalhppin, pdtotalhppout, pduraian, pdcatatan, pdnoref, parentApplication.F_tglFormatDB(pdtglnoref), pdidbom, 
						pdidpdr, pdidwo, pdidmrs, pdidmrn, 2, pdstatussebelumnya, pdjmlrevisi, pdcetakanke, pdinputuser, 
						parentApplication.F_tglFormatDB(pdinputtgl), pdmodifikasiuser, parentApplication.F_tglFormatDB(pdmodifikasitgl), 
						pdposting, pdtutupperiode, pdisclose, pdcustomtext1, pdcustomtext2, pdcustomtext3, pdcustomtext4, pdcustomtext5, 
						pdcustomint1, pdcustomint2, pdcustomint3, pdcustomdbl1, pdcustomdbl2, pdcustomdbl3, 
						parentApplication.F_tglFormatDB(pdcustomdate1), parentApplication.F_tglFormatDB(pdcustomdate2), parentApplication.F_tglFormatDB(pdcustomdate3)];
					utama = parentApplication.F_splitArrayToString(a);				
				}
				
				// Set Detail Hasil
				for(i=0;i<arrdetailhasil.length;i++)
					with(arrdetailhasil.getItemAt(i)){
						a = [idpdin, idpd, idbarang, namabarang, tipebarang, jml, satuan, nilaisatuan, jmlbarang, satuanbarang, matauang, 
							kurs, harga, hpppersen, hpp, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, gudangtujuan, costcenter, 
							divisi, subdivisi, proyek, catatan, urutan, idbomin, idpdrin, idwoin, idmrsin, idmrnin, isclose, customtext1, 
							customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
							FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
						if(detailhasil == '')detailhasil = parentApplication.F_splitArrayToString(a);
						else detailhasil += "▲"+parentApplication.F_splitArrayToString(a);
					}
				
				// Set Detail Bahan
				for(i=0;i<arrdetailbahan.length;i++)
					with(arrdetailbahan.getItemAt(i)){
						a = [idpdout, idpd, idbarang, namabarang, tipebarang, jml, satuan, nilaisatuan, jmlbarang, satuanbarang, matauang, 
							kurs, harga, hpp, idhppkhususmasuk, idhppfifomasuk, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, 
							gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, urutan, idbomout, idpdrout, idwoout, idmrsout, 
							idmrnout, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
							FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
							FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
						if(detailbahan == '')detailbahan = parentApplication.F_splitArrayToString(a);
						else detailbahan += "▲"+parentApplication.F_splitArrayToString(a);
					}
				
				// Set batch
				if(arrbatch.length>0){
					for(var bm:int=0; bm< arrbatch.length; bm++){
						with(arrbatch.getItemAt(bm)){
							a = [nbtid, nbtjenismutasi, nbtidbarang, nbtkode, nbtsumber, nbtidtransaksi, nbtsatuan, nbtjml, nbtcustomtext1, 
								nbtcustomtext2, nbtcustomtext3, nbtcustomdbl1, nbtcustomdbl2, nbtcustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(nbtcustomdate3), nbtgudang, nbtidbatchin];
							if(batch == '')batch =parentApplication.F_splitArrayToString(a);
							else batch += "▲"+parentApplication.F_splitArrayToString(a);
						}
					}
				}
				
				//set serial
				if(arrserial.length >0){
					for(var sm:int=0; sm< arrserial.length; sm++){
						with(arrserial.getItemAt(sm)){
							a = [nstid, nstjenismutasi, nstidbarang, nstkode, nstsumber, nstidtransaksi, nstsatuan, nstjml, nstcustomtext1, 
								nstcustomtext2, nstcustomtext3, nstcustomdbl1, nstcustomdbl2, nstcustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate1), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate2), 
								FlexGlobals.topLevelApplication.F_tglFormatDB(nstcustomdate3), nstgudang, nstidserialin];
							if(serial == '')serial =parentApplication.F_splitArrayToString(a);
							else serial += "▲"+parentApplication.F_splitArrayToString(a);
						}
					}
				}
				
				FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M6_PdSimpanImport", parentApplication.userid, isUpdate, utama, detailhasil+"△"+detailbahan+"△"+batch+"△"+serial);
			}
			
			public function f_UlangImport():void
			{
				var s:String = parentApplication.subject;
				if(jmlProgress < jmldata - 1){
					if(sbj == "Draft"){
						jmlProgress ++;
						f_draft();
					}
					else if(sbj == "Delete"){
						jmlProgress ++;
						f_delete();
					}
					else if(sbj == "Approve"){
						jmlProgress ++;
						f_approve();
					}
				}else{
					if(jmlgagal > 0){
						Alert.show("Import Data Selesai: \n "+jmlberhasil+" berhasil \n "+jmlgagal+" gagal \n Apakah anda ingin download data yang gagal?", "Informasi", 3, null, function (e:Object):void
						{
							if(e.detail == Alert.YES)
							{
								f_writeExcel();
							}
							f_kondisiAwal();
							dg.dataProvider.removeAll();
						});
					}else{
						Alert.show("Import Data Selesai: \n "+jmlberhasil+" berhasil \n "+jmlgagal+" gagal.", "Informasi", 4, null, function ():void
						{
							f_kondisiAwal();
							dg.dataProvider.removeAll();
						});
					}
				}
			}
			
