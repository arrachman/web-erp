			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					
					case 'txtlokasi':
						paket = 'CdM1_Location';
						csfilter = "laktif=1";
						wsfilter = "laktif=1 AND lkode ='"+txtlokasi.text+"'";
						break;
					case 'txtcabang':
						paket = 'CdM1_Branch';
						csfilter = "baktif=1";
						wsfilter = "baktif=1 AND bkode ='"+txtcabang.text+"'";
						break;
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject;
				if(parentApplication.wsSuccess == true){
					ws = parentApplication.wsArrUtama.getItemAt(0);
					switch(s){	
						case 'txtlokasi':
							txtlokasi.text = ws.lkode;
							break;
						case 'txtcabang':
							txtcabang.text = ws.bkode;
							break;
						case 'tampil':
							for(i = dg.dataProviderLength - 1; i>=0; i--){
								if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
									dg.dataProvider.removeItemAt(i);
								}
							}
							ws = FlexGlobals.topLevelApplication.wsArrUtama;
							for(i=0;i<ws.length;i++){
								dg.dataProvider.addItem({chk:0,
									pdid:ws.getItemAt(i).pdid,
									pdnotransaksi:ws.getItemAt(i).pdnotransaksi,
									pdtgl:ws.getItemAt(i).pdtgl,
									pdbagianpdnama:ws.getItemAt(i).pdbagianpdnama,
									pdstatusnama:ws.getItemAt(i).pdstatusnama,
									pduraian:ws.getItemAt(i).pduraian,
									pdcatatan:ws.getItemAt(i).pdcatatan,
									pdinputusernama:ws.getItemAt(i).pdinputusernama,
									pdinputtgl:ws.getItemAt(i).pdinputtgl,
									pdmodifikasiusernama:ws.getItemAt(i).pdmodifikasiusernama,
									pdmodifikasitgl:ws.getItemAt(i).pdmodifikasitgl}); 
							}
							break;
						case 'draft':
							jmlberhasil ++;
							f_UlangImport();
							break;
						case 'delete':
							jmlberhasil ++;
							f_UlangImport();
							break;
						case 'GetData':
							validasi = true;
							arrutama = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[0], FlexGlobals.topLevelApplication.vData[0]);
							arrdetailhasil = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[1], FlexGlobals.topLevelApplication.vData[1]);
							arrdetailbahan = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[2], FlexGlobals.topLevelApplication.vData[2]);
							arrbatch = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[3], FlexGlobals.topLevelApplication.vData[3]);
							arrserial = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[4], FlexGlobals.topLevelApplication.vData[4]);
							f_simpan();
							break;
						case 'simpan':
							jmlberhasil ++;
							f_UlangImport();
							break;
						case "Uploading":
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_wsSearch('tampilFile', 'M6_FilesSearch', 1, 1, 'fsumber = "PD" AND fidtransaksi = "0"', 'finputtgl desc');
							break;
						case "tampilFile":
							navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f6/PD/"+FlexGlobals.topLevelApplication.wsArrUtama[0].fnamafile));
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s) == true)
						switch(s){
							case 'draft':
								jmlgagal ++;
								ac2[jmlProgress].gagal = 1;
								ac2[jmlProgress].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangImport();
								break;
							case 'delete':
								jmlgagal ++;
								ac2[jmlProgress].gagal = 1;
								ac2[jmlProgress].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangImport();
								break;
							case 'simpan':
								jmlgagal ++;
								ac2[jmlProgress].gagal = 1;
								ac2[jmlProgress].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangImport();
								break;
							case 'GetData':
								Alert.show(FlexGlobals.topLevelApplication.l(FlexGlobals.topLevelApplication.wsErrmessage), FlexGlobals.topLevelApplication.l('Informasi'));
								break;
							case 'tampil':
								dg.dataProvider.removeAll();
								Alert.show(FlexGlobals.topLevelApplication.l(FlexGlobals.topLevelApplication.wsErrmessage), FlexGlobals.topLevelApplication.l('Informasi'));
								break;
							case "Uploading":
								Alert.show(FlexGlobals.topLevelApplication.wsErrmessage);
								navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f6/PD/Data Gagal Import_"+jmlfile+".xls"));
								break;
						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case 'GetData':Alert.show('a');break;
					case 'txtlokasi':parentApplication.F_KosongkanText([txtlokasi]);break;
					case 'txtcabang':parentApplication.F_KosongkanText([txtcabang]);break;
					case 'tampilGiro':
						for(i=dg.dataProviderLength-1;i>=0;i--){
							if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
								dg.dataProvider.removeItemAt(i);
							}
						}
						break;
				}
			}
			
			public function centang():void{
				ac2.removeAll();
				for (var i:int = 0; i < dg.dataProviderLength; i++) 
					if(dg.dataProvider.getItemAt(i).chk==1){
						with(dg.dataProvider.getItemAt(i))
							ac2.addItem({pdid:pdid, pdnotransaksi:pdnotransaksi});
					}
			}
			
			protected function f_approve():void
			{
				var dataId:String="", a:Array;
				parentApplication.vpFocusEvent = true;
				
				with (ac2[jmlProgress]){					
					a = [pdid];
				}
				
				if(mb.menuBarItems[0].enabled == true){
					validasiForm();
					if(validasi == true){						
						dataId = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
						FlexGlobals.topLevelApplication.F_wsGetDataById('GetData', 'M6_PdGetdataById', dataId, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					pesanAlert = "";
					pesanAlertIng = "";
					FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg);
					if(ac2.length <= 0){
						FlexGlobals.topLevelApplication.msgAlert(dg,'Data')
					}
					if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');		
					
					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi == true)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						validasi = false;						
					}
				}
			}
			
