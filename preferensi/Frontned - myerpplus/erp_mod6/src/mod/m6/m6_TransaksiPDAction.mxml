			protected function f_wsTampil(page:int = 0, sort:String = 'pdinputtgl desc'):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("tampil", "M6_PdSearch", page, 0, f_filterdata(), sort);
			}
			
			public function f_filterdata():String{
				var f:String="";
				
				if(dttgl1.text.length > 0 && dttgl2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdtgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text.split('"').join('\\"'))+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text.split('"').join('\\"'))+'"');
				}else if(dttgl1.text.length > 0 && dttgl2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdtgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl1.text.split('"').join('\\"'))+'"');
				}else if(dttgl1.text.length <= 0 && dttgl2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdtgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttgl2.text.split('"').join('\\"'))+'"');
				}
				
				if(txtnotransaksi1.text.length > 0 && txtnotransaksi2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdnotransaksi Between "'+txtnotransaksi1.text.split('"').join('\\"')+'" and "'+txtnotransaksi2.text.split('"').join('\\"')+'"');
				}else if(txtnotransaksi1.text.length > 0 && txtnotransaksi2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdnotransaksi >= "'+txtnotransaksi1.text.split('"').join('\\"')+'"');
				}else if(txtnotransaksi1.text.length <= 0 && txtnotransaksi2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdnotransaksi <= "'+txtnotransaksi2.text.split('"').join('\\"')+'"');
				}
				
				if(txturaian.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pduraian Like "%'+txturaian.text.split('"').join('\\"')+'%"');
				}
				if(txtcatatan.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdcatatan Like "%'+txtcatatan.text.split('"').join('\\"')+'%"');
				}
				if(txtcabang.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdcabang ="'+txtcabang.text.split('"').join('\\"')+'"');
				}
				if(txtlokasi.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdlokasi ="'+txtlokasi.text.split('"').join('\\"')+'"');
				}
				if(cmbstatus.selectedIndex >= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdstatus ="'+cmbstatus.selectedItem.v+'"');
				}
				for(i=0; i<dg.dataProviderLength; i++){
					if(dg.dataProvider[i].chk == 1){
						f = FlexGlobals.topLevelApplication.TambahFilter(f,'pdid <>"'+dg.dataProvider.getItemAt(i).pdid.split('"').join('\\"')+'"'); 
					}
					
				}
				
				return f;
				
			}
			
