				public function f_grid(dg:DataGrid, column:String):void
				{ 
					var detailsetbomm:Object={};
					o.a = column.split('|');
					if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 2){
						if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
						else o.d = dg.dataProvider.getItemAt(o.a[1]);
						o.o.nilaisatuan = 0;
						return
					}
					if(tab.selectedIndex ==0 ){dg = dg1}
					else if(tab.selectedIndex == 1){dg = dg2}
					else if(tab.selectedIndex == 3){dg = dgRouteCard}
					if(column == 'add'){
					}else if(column == 'del'){
					}else{
						with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
							switch(column){
								case 'jml':
									FlexGlobals.topLevelApplication.F_defaultGridItem(dg3);
									if(nilaisatuan != undefined){
										jmlbarang = Number(jml) * Number(nilaisatuan);
									}else{
										jmlbarang = Number(jml);
									}
									
									if(o.pcwajibwo == 2){
										parentApplication.F_wsGetDataById("WOdetail", 'M1_ItemGetdataById',dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).idbarang, 0, 0, '', '');
									}
									else{
										if(dg == dg1 && (FlexGlobals.topLevelApplication.getSetting(6,'options','OtomatisSetBOM') == 1)){
											parentApplication.vpFocusEvent = true;
											for(i=0; i<dg1.dataProviderLength; i++){
												if(i == 0){ detailsetbomm = dg1.dataProvider.getItemAt(i).idbarang+"▼"+dg1.dataProvider.getItemAt(i).jmlbarang;
												}else{ detailsetbomm += "▲"+dg1.dataProvider.getItemAt(i).idbarang+"▼"+dg1.dataProvider.getItemAt(i).jmlbarang;
												}
											}
											pesanAlert = ''; validasi = true;
											if(detailsetbomm == 'undefined▼undefined'){
												if(detailsetbomm == 'undefined▼undefined')parentApplication.msgAlert(dg1,'Detail Hasil');
												if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
											}else{
												parentApplication.F_wsSimpan('SetBOM', 'M6_ItemBomSearch', parentApplication.userid, isUpdate, detailsetbomm);
											}
										}
									}
									break;	
								case 'customdbl2':
									if(o.pcwajibwo == 2){
										if(Number(customdbl2) != 0)FlexGlobals.topLevelApplication.F_wsSearch('SetMaxBatch', 'M0_GlobalAllowanceSearch', 0, 0, Number(customdbl2)+" BETWEEN minbatch AND maxbatch", "", "", "", 0);
									}
									break;
								case 'hpppersen':
									harga = (Number(hpppersen/100) * Number(n.vtotalbahan)) / Number(jml); break;
								case 'harga':
									vMsg = ''; vMsgIng = '';
									dgrid1 = dg1.dataProvider.getItemAt(dg.selectedCell.rowIndex);
									if(dgrid1.jml == 0 || dgrid1.hpppersen == 0){
										if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
										if(dgrid1.hpppersen == 0)msgAlert(dg, "Price [%]", "Harga [%]");
										if(vMsg != '' && vMsgIng != '')msgAlert('clear','','');
										dgrid1.jmldiskon = 0;
										dgrid1.diskon= 0;
									}else{
										if(n.vtotalbahan != 0)
										hpppersen = ((Number(jml) * Number(harga)) / Number(n.vtotalbahan)) * 100; 
									}break;
								case 'subtotal':
									hargaDariSubtotal.hitungHargaDariSubtotal(dg, false);
									break;
							}
							subtotal = Number(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).jml) * Number(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).harga);
						}
					}
					f_hitungTotalUtama();
					f_hitungHasil();
					parentApplication.F_dgRefresh(dg);
				}

