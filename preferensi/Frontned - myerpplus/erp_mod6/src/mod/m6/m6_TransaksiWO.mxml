				public var a:Array, utama:String, detailhasil:String="", detailbahan:String="", detailaktivitas:String, detailroutecard:String, tgl:String, dbatch:String, dserial:String, isiSimpan:String = "", isiStok:String = "";
				protected function f_simpan():void
				{					
					n.dttanggal = dttanggal.text;
					parentApplication.vpFocusEvent = true;
					if(mb.menuBarItems[0].enabled == true){
						validasiForm();
						if(validasi == true){
							u.refresh(); 
							// Set Utama
							with(u.getItemAt(0)){
								a=[woid, wocabang, wolokasi, wogudangasal, wogudangproduksi, wogudangtujuan, wosumber, 
									txtjenisproduksi.text, int(chkauto.selected), txtnotransaksi.text, parentApplication.F_tglFormatDB(dttanggal.text), wokodepa, wodimintaoleh, txtkontakperson.text, 
									womintake,  parentApplication.F_tglFormatDB(dttanggaldibutuhkan.text), txtestimasi.text, womatauang, o.txtkurs, n.vtotalhasil, n.vtotalbahan, 
									wototalhppin, wototalhppout, txturaian.text, txtcatatan.text, txtnoref.text,  parentApplication.F_tglFormatDB(dttanggalnoref.text), woidbom, 
									woidpdr, wostatusmrsin, wostatusmrsout, wostatusmrnin, wostatusmrnout, wostatuspdin, wostatuspdout, 
									cmbprogress.selectedItem.v, wostatussebelumnya, wojmlrevisi, wocetakanke, woinputuser, parentApplication.F_tglFormatDB(woinputtgl), womodifikasiuser, 
									parentApplication.F_tglFormatDB(womodifikasitgl), woisclose, wocustomtext1, wocustomtext2, wocustomtext3, wocustomtext4, wocustomtext5, 
									cmbJenisWO.selectedIndex, wocustomint2, wocustomint3, wocustomdbl1, wocustomdbl2, wocustomdbl3, parentApplication.F_tglFormatDB(wocustomdate1), 
									parentApplication.F_tglFormatDB(wocustomdate2), parentApplication.F_tglFormatDB(wocustomdate3), o.idpr];
							utama = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
							
							// Set Detail 'hasil
							for(i=0;i<dg1.dataProviderLength;i++){
								with(dg1.dataProvider.getItemAt(i)){
									a = [idwoin, idwo, idbarang, namabarang, tipebarang, jml, satuan, 
										nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(kurs), harga, hpppersen, 
										hpp, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, gudangtujuan, 
										costcenter, divisi, subdivisi, proyek, catatan, (i+1), idbomin, 
										idpdrin, jmlmrs, statusmrs, jmlmrn, statusmrn, jmlpd, statuspd, 
										isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
									if(i == 0)detailhasil = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									else detailhasil += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								}
							}
									
							 if(o.pcwajibwo == 2){
								for(i=0;i<ac_Bahan.length;i++)
									with(ac_Bahan.getItemAt(i)){ 
										 a = [idwoout, idwo, idbarang, namabarang, tipebarang, jml, satuan, 
											 nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(kurs), harga, hpp, 
											 idhppkhususmasuk, idhppfifomasuk, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, 
											 gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, (i+1), 
											 idbomout, idpdrout, jmlmrs, statusmrs, jmlmrn, statusmrn, jmlpd, 
											 statuspd, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
											 customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
										if(i == 0) detailbahan = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
										else detailbahan += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									}
							 }
							 else{
								 if (dg2.dataProviderLength == 1 && dg2.dataProvider.getItemAt(0).kodebarang == ''){
									 detailbahan = ""
								 }else{
									 for(i=0;i<dg2.dataProviderLength;i++)
										 with(dg2.dataProvider.getItemAt(i)){
											 a = [idwoout, idwo, idbarang, namabarang, tipebarang, jml, satuan, 
												 nilaisatuan, jmlbarang, satuanbarang, matauang, parentApplication.F_hapusFormatCurrency(kurs), harga, hpp, 
												 idhppkhususmasuk, idhppfifomasuk, rekpersediaan, cabang, lokasi, gudangasal, gudangproduksi, 
												 gudangtujuan, costcenter, divisi, subdivisi, proyek, catatan, (i+1), 
												 idbomout, idpdrout, jmlmrs, statusmrs, jmlmrn, statusmrn, jmlpd, 
												 statuspd, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
												 customdbl3, parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
											 if(i == 0)detailbahan = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
											 else detailbahan += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
										 }
								 }
																	
							 }
								
							 if(dg3.dataProviderLength > 0 && dg3.dataProvider.getItemAt(0).namaaktivitas != null && dg3.dataProvider.getItemAt(0).namaaktivitas != ""){
								 for(i=0;i<dg3.dataProviderLength;i++)
									 with(dg3.dataProvider.getItemAt(i)){
										 a = [idwoactivity, idwo, idpa, namaaktivitas, kodemesin, 
											 costcenter, divisi, subdivisi, proyek, catatan, (i+1), customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
											 parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3)];
										 if(i == 0)detailaktivitas = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
										 else detailaktivitas += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									 }
							 }
							 else detailaktivitas = '';
							 
							 if(dgRouteCard.dataProviderLength > 0 && dgRouteCard.dataProvider.getItemAt(0).jml != null && dgRouteCard.dataProvider.getItemAt(0).jml != 0){
								 for(i=0;i<dgRouteCard.dataProviderLength;i++)
									 with(dgRouteCard.dataProvider.getItemAt(i)){
										 a = [idworoutecard, idwo, notransaksi, jml, satuann, 
											 costcenter, divisi, subdivisi, proyek, catatan, (i+1), customtext1, customtext2, customtext3, lanjut, customdbl2, customdbl3, 
											 parentApplication.F_tglFormatDB(customdate1), parentApplication.F_tglFormatDB(customdate2), parentApplication.F_tglFormatDB(customdate3), kodemesin];
										 if(i == 0)detailroutecard = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
										 else detailroutecard += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									 }
							 }
							 else detailroutecard = '';
								 
							 isiSimpan = "";
							 isiStok = "";
							 for(i=0;i<dg2.dataProviderLength;i++){
								 if(Number(dg2.dataProvider.getItemAt(i).jml) > Number(dg2.dataProvider.getItemAt(i).customdbl3)){										 
									if(i == 0){
										isiSimpan = (i+1).toString();
										isiStok = dg2.dataProvider.getItemAt(i).customdbl3;
									}
									else{
										isiSimpan = isiSimpan + ", " +(i+1).toString();
										isiStok = isiStok + ", " + dg2.dataProvider.getItemAt(i).customdbl3;
									}
								 }
							 }
							 cekstok();	
							}
						}
					}
					
					function validasiForm():void
					{
						validasi = true;
						pesanAlert = '';
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg1);
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg2);
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dg3);
						FlexGlobals.topLevelApplication.F_hapusBarisKosongGrid(dgRouteCard);
						if(txtjenisproduksi.text.length == 0)parentApplication.msgAlert(txtjenisproduksi,'Jenis Produksi');
						if(txtNoWO.text.length == 0 && txtNoWO.enabled == true && cmbJenisWO.selectedIndex == 1)parentApplication.msgAlert(txtNoWO,'No. WO');
						if(dttanggal.text.length == 0)parentApplication.msgAlert(dttanggal,'Tanggal');
						if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
						if(dttanggaldibutuhkan.text.length == 0)parentApplication.msgAlert(dttanggaldibutuhkan,'Tanggal Dibutuhkan');
						if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)parentApplication.msgAlert(cmbprogress,'Progress');
						if(o.pcwajibwo == 1 && (dg2.dataProvider.getItemAt(0).idwoout == null || dg1.dataProvider.getItemAt(0).idwoin == null || dgRouteCard.dataProvider.getItemAt(0).idworoutecard == null))parentApplication.msgAlert(dg1,'Detail Item');
						if(pesanAlert != '')FlexGlobals.topLevelApplication.msgAlert('pesanAlert', '');
					}
				}
				
				public function f_hitungTotalUtama():void
				{
					n.vtotalbahan=0;
					n.vtotalhasil=0;
					n.vtotalpersen=0;
					for(var j:int=0;j<dg1.dataProvider.length;j++){
						if(dg1.dataProvider.getItemAt(j).subtotal != undefined)n.vtotalhasil += Number(dg1.dataProvider.getItemAt(j).subtotal);n.vtotalpersen += Number(dg1.dataProvider.getItemAt(j).hpppersen);
					}
					for(var i:int=0;i<dg2.dataProvider.length;i++){
						if(dg2.dataProvider.getItemAt(i).subtotal != undefined)n.vtotalbahan += Number(dg2.dataProvider.getItemAt(i).subtotal);
					}
					lbltotalbahan.text = parentApplication.m.nfNominal.format(n.vtotalbahan);
					lbltotalhasil.text = parentApplication.m.nfNominal.format(n.vtotalhasil);
				}
				
				public function f_defaultGrid():void
				{
					parentApplication.rowIndex = 0;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg1);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg2);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg3);
					FlexGlobals.topLevelApplication.F_defaultGridItem(dgRouteCard);
					dg1.setSelectedCell(0, 1);
					dg2.setSelectedCell(0, 1);
					dg3.setSelectedCell(0, 1);
					dgRouteCard.setSelectedCell(0, 1);
					ac_Bahan.removeAll();
					f_focusOnMe();
				}
				
				public function f_hitungHasil():void
				{
					var ob:Object={};
					for(i=0; i<dg1.dataProviderLength; i++){
						ob = dg1.dataProvider.getItemAt(i);
						ob.harga = (Number(ob.hpppersen/100) * Number(n.vtotalbahan)) / Number(ob.jml);
						ob.subtotal = Number(ob.jml) * Number(ob.harga);
					}
					parentApplication.F_dgRefresh(dg1);
					f_hitungTotalUtama();
				}
				
