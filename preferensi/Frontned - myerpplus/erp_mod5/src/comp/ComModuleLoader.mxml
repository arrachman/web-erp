<?xml version="1.0" encoding="utf-8"?>
<s:ModuleLoader xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark"
				creationComplete="init()" initialize="moduleloader1_initializeHandler(event)"  
				xmlns:mx="library://ns.adobe.com/flex/mx">
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.controls.ProgressBar;
			import mx.core.IVisualElement;
			import mx.events.FlexEvent;
			import mx.events.ModuleEvent;
			
			protected function moduleloader1_initializeHandler(event:FlexEvent):void
			{ 
				if(url == "mod/m0/m0_Report.swf" || url == "mod/m0/m0_Statistic.swf")
				{
					p.visible = false;
					myLabel.visible = false;
					mybtn.visible = false; 
				}
				else
				{
					p.visible = true;
					myLabel.visible = true;
					mybtn.visible = true; 
				}
			}
			
			public function init():void 
			{
				loadModule(url);
				
				addEventListener("progress", onProgress);
				addEventListener("error", onError);
				addEventListener(ModuleEvent.ERROR, onError);
				addEventListener("ready", onReady);
				addEventListener("urlChanged", onUrlChanged);
				addEventListener("loading", onLoading);
				addEventListener("setup", onSetup);
				addEventListener("unload", onUnload);
			}
			
			public function onUrlChanged(event:Event):void
			{
			}
			public function onLoading(event:Event):void
			{
			}
			
			public function onSetup(event:Event):void
			{
				p.visible = true;
				myLabel.visible = true;
				mybtn.visible = true; 
			}
			 
			public function onUnload(event:Event):void
			{
				p.setProgress(0, 100);
				p.visible = true;
				myLabel.visible = true;
				mybtn.visible = true;
			}
			
			public function onProgress(event:ProgressEvent):void
			{
				var percentLoaded:Number = event.bytesLoaded / event.bytesTotal;
				percentLoaded = Math.round(percentLoaded * 100) ;
				p.setProgress(percentLoaded, 100);
			}
			
			public function onReady(event:Event):void 
			{
				p.visible = false;
				myLabel.visible = false;
				mybtn.visible = false;
			}
			 
			public function onError(event:Event):void 
			{
				myLabel.text = "Request menu failed " + url ;
			}
			
			protected function mybtn_clickHandler(event:MouseEvent):void
			{
				unloadModule();
				loadModule(url);
			}
			
		]]>
	</fx:Script>
	<s:Label id="myLabel" fontSize="20" horizontalCenter="0" text="Please Wait" verticalCenter="42" visible="false"/>
	<s:Button label="Reload" horizontalCenter="0" verticalCenter="69" id="mybtn" click="mybtn_clickHandler(event)" visible="false"/>
	<mx:ProgressBar id="p" width="300" horizontalCenter="0" verticalCenter="0" mode="manual"/>
</s:ModuleLoader>