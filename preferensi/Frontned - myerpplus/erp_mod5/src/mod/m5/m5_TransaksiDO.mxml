				public function  msgAlert(focus: Object, inggris: String, indonesia: String):void
				{ 
					if(validasi)focus.setFocus();
					pesanAlertIng += inggris+', ';
					pesanAlert += indonesia+', ';
					if(focus == 'clear'){
						pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
						pesanAlert += " harus diisi dengan benar";
						pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
						pesanAlertIng += " must be filled";
						Alert.show(pesanAlertIng+"  ("+pesanAlert+")"  , "Information");} 
					validasi = false; 
				}
				
				private var vtotal:Number=0,vvalas:Number=0;
				public function f_hitungGrid():void{
					var dgrid:Object;
					for(i = 0; i<dg.dataProviderLength; i++){
						dgrid = dg.dataProvider[i]
						dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon);
						dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon;
						dgrid.jmlpajak1 = (Number(dgrid.pajak1nilai)/100) * dgrid.subtotal;
						dgrid.jmlpajak2 = (Number(dgrid.pajak2nilai)/100) * dgrid.subtotal;
					}
					
					f_hitungTotal();
				}
				
				public function f_hitungTotal():void
				{
					n.vtotal=0; n.vtotalpajak1=0; n.vtotalpajak2=0; n.vjmlbiayalain=0; n.vjmldiskon=0; n.vbiayalainpersen=0; n.vdiskonpersen=0; n.subtotal=0
					for(var i:int=0;i<dg.dataProvider.length;i++){
						if(dg.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg.dataProvider.getItemAt(i).subtotal);
						if(dg.dataProvider.getItemAt(i).jmlpajak1 != undefined)n.vtotalpajak1 += Number(dg.dataProvider.getItemAt(i).jmlpajak1);
						if(dg.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg.dataProvider.getItemAt(i).jmlpajak2);
					}
					n.totaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak1) + Number(n.vtotalpajak2) + Number(n.vjmlbiayalain)) - Number(n.vjmldiskon);
				}
				
