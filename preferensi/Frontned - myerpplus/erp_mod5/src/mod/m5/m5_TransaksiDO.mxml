					var idtransaksi : String = filtersplit[0];
					o.DefaultProgress = parentApplication.setProgress(cmbprogress, 5, "DO");
					settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
					if(FlexGlobals.topLevelApplication.FormFilter == ''){
						//input
						f_kondisiAwal();
					}else{
						if(filtersplit[1] == 'history'){
							//history
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_DoHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else {
							//edit
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_DoGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
					//end of set getdata by id===============================================================================================
					
