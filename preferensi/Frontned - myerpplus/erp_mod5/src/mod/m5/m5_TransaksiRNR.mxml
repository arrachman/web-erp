			protected function chkhargapajak_changeHandler(event:Event):void
			{
				// TODO Auto-generated method stub
				for(var Index:int = 0; Index<dg.dataProviderLength; Index++){
					var dgrid:Object;
					dgrid = dg.dataProvider[Index];
					if(chkhargapajak.selected){
						dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(true, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					}else{
						dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
						dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(false, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					}
					
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				//f_hitungTotalDetail();
				
			}
			
		]]>
