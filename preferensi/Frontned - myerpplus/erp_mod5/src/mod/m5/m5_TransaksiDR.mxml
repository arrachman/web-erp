				public function f_filtersb():void{
					fserial = 's'; fbatch = 'b'; faktiva = 'a';
					for(i=0; i<dg.dataProviderLength; i++){
						if(dg.dataProvider[i].bserial == 1){
							if(fserial == 's'){
								fserial = '(nsiidbarang = ' + dg.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg.dataProvider[i].gudangtransit+'")';
							}else{
								fserial += ' or (nsiidbarang = ' + dg.dataProvider[i].idbarang +' and nsiisclose = 0 and nsigudang = "'+dg.dataProvider[i].gudangtransit+'")';
							}
						}
						
						if(dg.dataProvider[i].bbatch ==	1){
							if(fbatch == 'b'){
								fbatch = '(nbiidbarang = ' + dg.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg.dataProvider[i].gudangtransit+'")';
							}else{
								fbatch += ' or (nbiidbarang = ' + dg.dataProvider[i].idbarang +' and nbiisclose = 0 and nbigudang = "'+dg.dataProvider[i].gudangtransit+'")';
							}
						}
						
						if(dg.dataProvider[i].basset ==	1){
							if(faktiva == 'a'){
								faktiva = '(aidbarang = ' + dg.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg.dataProvider[i].gudangtransit+'")';
							}else{
								faktiva += ' or (aidbarang = ' + dg.dataProvider[i].idbarang +' and aisclose = 0 and agudang = "'+dg.dataProvider[i].gudangtransit+'")';
							}
						}
					}
				}
				
