				public function f_grid(dg:DataGrid, column:String):void
				{ 
					o.a = column.split('|');
					if((column == 'add' || o.a[0] == 'add') && tab.selectedIndex < 2){
						if(o.a.length == 1)o.o = dg.dataProvider.getItemAt(dg.dataProviderLength-1);
						else o.d = dg.dataProvider.getItemAt(o.a[1]);
						o.o.nilaisatuan = 0;
						o.o.nilaipajak1 = 0;
						o.o.nilaipajak2 = 0;
						return
					}
					if(column == 'add'){
					}else if(column == 'del'){
						
					}else{
						with(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)){
							switch(column){
								case "jml":
								case "jmlkembali":
									customdbl1 = (Number(jml) *  Number(nilaisatuan))/ Number(nilaisatuanlapangan);
//									customdbl1 = Number(jml) / Number(nilaisatuanlapangan);
									jmlbarang = Number(jml) * Number(nilaisatuan);
//									customdbl2 = Number(jmlkembali) / Number(nilaisatuanlapangan);
									customdbl2 = (Number(jmlkembali) *  Number(nilaisatuan))/ Number(nilaisatuanlapangan);
									jmlbarangkembali = Number(jmlkembali) * Number(nilaisatuan);
									parentApplication.F_hargaTotal(dg);
									break;
//								case "customdbl1":
//									jml = Number(customdbl1) * Number(nilaisatuanlapangan);
//									jmlbarang = Number(jml) * Number(nilaisatuan);
//									break;
								case "customdbl1":
									//									jml = Number(customdbl1) * Number(nilaisatuanlapangan);
									//									jmlbarang = Number(jml) * Number(nilaisatuan);
									jml = (Number(nilaisatuanlapangan) / Number(nilaisatuan)) * Number(customdbl1)
									jmlbarang = Number(jml) * Number(nilaisatuan);
									break;
								case "customdbl2":
//									jmlkembali = Number(customdbl2) * Number(nilaisatuanlapangan);
//									jmlbarangkembali = Number(jmlkembali) * Number(nilaisatuan);
									jmlkembali = (Number(nilaisatuanlapangan) / Number(nilaisatuan)) * Number(customdbl2)
									jmlbarangkembali = Number(jmlkembali) * Number(nilaisatuan);
									break;
								case "harga":
//								case "pajak1":
//								case "pajak2":
									jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									parentApplication.F_hargaTotal(dg);
									break;
								case "diskon":
									jmldiskon = parentApplication.F_diskonBertingkat(jml, harga, diskon);
									subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
									jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
									jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									parentApplication.F_hargaTotal(dg);
									break;
								case "jmldiskon":
									pesanAlert = ''; pesanAlertIng = ''; validasi = true;
									dgrid1 = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex);
									if(dgrid1.jml == 0 || dgrid1.harga == 0){
										if(dgrid1.jml == 0)msgAlert(dg,'Item Amount', 'Jumlah barang');
										if(dgrid1.harga == 0)msgAlert(dg, "Price", "Harga");
										if(pesanAlert != '' && pesanAlertIng != '')msgAlert('clear','','');
										dgrid1.jmldiskon = 0;
										dgrid1.diskon= 0;
									}else{
										diskon = (Number(jmldiskon)/(Number(jml)*Number(harga)))*100;
										subtotal = (Number(jml) * Number(harga)) - Number(jmldiskon);
										jmlpajak1 = (Number(nilaipajak1)/100) *  Number (subtotal);
										jmlpajak2 = (Number(nilaipajak2)/100) *  Number (subtotal);
									}
									break;
								case "pre_del":
									hapusserial();
									hapusbatch();
									hapusaktiva();
									break;
								case "pajak1":
									f_hitungGrid();
									FlexGlobals.topLevelApplication.F_dgRefresh(dg);
									break;
								case "pajak2":
									f_hitungGrid();
									FlexGlobals.topLevelApplication.F_dgRefresh(dg);
									break;
							}
						}
					}
					FlexGlobals.topLevelApplication.F_dgRefresh(dg);
					f_hitungTotal()
				}
				public function hapusserial():void{
					var s:int, arrayserial:ArrayCollection = new ArrayCollection;
					if(dg.dataProvider[dg.selectedCell.rowIndex].jmlkembali > 0){
						arrayserial = acserialdetail;
					}else if(dg.dataProvider[dg.selectedCell.rowIndex].jml > 0){
						arrayserial = ac_Serial;
					}
					if(arrayserial.length > 0){
						for(s=arrayserial.length-1; s>=0; s--){
							if(arrayserial[s].nstidbarang == dg.dataProvider[FlexGlobals.topLevelApplication.rowIndex].idbarang){
								arrayserial.removeItemAt(s);
							}
						}
					}
				}
				
