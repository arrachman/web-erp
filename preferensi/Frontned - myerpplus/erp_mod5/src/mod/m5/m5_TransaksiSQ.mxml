				parentApplication.F_ComboBoxStandard([cmbprogress, cmbasalbarang, cmbcarabayar]);
				parentApplication.F_txtpencarian([txtcustomer, txtsalesman, txtmatauang, txtgudang, txttermin]);
				parentApplication.F_txtPencarianKhusus([txtkontakperson, txtalamatcustomer, txtalamatkirim]);
				parentApplication.F_SetNavigasiKeyboard([txtnotransaksi, txturaian, txtnoref, txtmasaberlaku, txtfranco, txtwaktupengiriman, tvalidity]);
				parentApplication.F_TextInputDiskonbertingkat([txtdiskonpersen, txtbiayalainpersen]);
				//				parentApplication.F_TextInputNumberOnlyMode([txtdiskonpersen, txtbiayalainpersen]);
				parentApplication.F_TextInputNumberDesimalMode([txtdiskonnilai, txtbiayalainnilai, txtkurs]);
				parentApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				vTgl = parentApplication.getSetting(0, 'accounting', 'EditableDate');
				vNotransaksi = parentApplication.getSetting(0, 'accounting', 'AutoNoTransaction');
				vDefNotransaksi = parentApplication.getSetting(0, 'accounting', 'DefaultAutoNoTransaction');
				tab.tabFocusEnabled = false;
				
				// fungsi menubar
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
