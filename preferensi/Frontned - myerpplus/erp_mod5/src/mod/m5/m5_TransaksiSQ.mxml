			}
			
			public function f_validasi():void
			{
				var  filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]")
				var  idtransaksi : String = filtersplit[0];
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 5, "SQ");
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit[1] == 'history'){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M5_SqHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else{
						if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
							FlexGlobals.topLevelApplication.F_wsGetDataById('copyTransaksi', 'M5_SqGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M5_SqGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
					}
				}
			}
			
			protected function f_kondisiAwal():void
			{
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 5, "SQ");
				isUpdate = false;
				dg1.editable = false;
				dg1.toolTip = "Customer harus diisi terlebih dahulu sebelum memilih barang";
				n.vtotal = 0;
				n.vtotalpajak1 = 0;
				n.vtotalpajak2 = 0;
				o.txtbiayalainnilai = 0;
				o.txtdiskonnilai = 0;
				n.diskonnilai = 0;
				n.biayalainnilai = 0;
				o.txtdiskonpersen = 0;
				o.txtbiayalainpersen = 0;
				o.txtkurs = 0;
