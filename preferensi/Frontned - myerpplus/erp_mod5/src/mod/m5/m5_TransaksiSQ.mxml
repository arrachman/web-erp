					sqinputtgl:tglDB, sqmodifikasiuser:0, sqmodifikasitgl:tglDB, sqisclose:0, sqcustomtext1:txtmasaberlaku.text, sqcustomtext2:txtfranco.text, sqcustomtext3:txtwaktupengiriman.text, 
					sqcustomtext4:txtvalidity.text, sqcustomtext5:'', sqcustomint1:0, sqcustomint2:0, sqcustomint3:0, sqcustomdbl1:0, sqcustomdbl2:0, 
					sqcustomdbl3:0, sqcustomdate1:parentApplication.m.DateFirst, sqcustomdate2:parentApplication.m.DateFirst, sqcustomdate3:parentApplication.m.DateFirst, sqidpr:0
