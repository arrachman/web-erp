					chkauto.selected = true;
					chkauto.enabled = false;
				}else{
					if (vDefNotransaksi == '0'){
						chkauto.selected = false;
					}else{
						chkauto.selected = true;
					}
				}
				f_chkAuto();
				f_focusOnMe();
				f_defaultGrid();
				f_matauangFungsional();
				
				u = new ArrayCollection([{
					sqid:0, sqcabang:parentApplication.ucabang, sqlokasi:parentApplication.ulokasi, sqgudang:txtgudang.text, sqasalbarang:cmbasalbarang.textInput.text, sqasalbarangkategori:0, sqjenispenjualan:'', 
