				parentApplication.F_tabvalidatenow(tab);
				chkauto.label = FlexGlobals.topLevelApplication.l(chkauto.label);
				parentApplication.F_TranslateLabel([tcustomer, tsalesman, turaian, ttanggal, tnotransaksi, tuang, tkurs, tprogress, tkontakperson, ttermin, tcatatan, talamatcustomer, talamatkirim, ttglkirim, tnoref, ttglnoref, tmasaberlaku, tfranco, twaktupengiriman, tvalidity, ttotal, tdiskon, tpajak1, tpajak2, tbiayalain, ttotaltransaksi, tprogress0, tgudang, ttanggaljt]);
				parentApplication.F_RequiredLabel([tcustomer, tsalesman, ttanggal, tnotransaksi, tuang, tkurs, tprogress]);
				cmbasalbarang.dataProvider = new ArrayCollection([{l:'Lokal', v:'0'}, {l:'Import', v:'1'}]);
