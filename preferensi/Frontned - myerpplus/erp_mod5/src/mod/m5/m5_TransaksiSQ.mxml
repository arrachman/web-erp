				for(i=0; i<dg1.dataProviderLength; i++){
					dg1.dataProvider.getItemAt(i).kodebarang=''; 
					dg1.dataProvider.getItemAt(i).subtotal=0; 
					dg1.dataProvider.getItemAt(i).nilaipajak1=0; 
					dg1.dataProvider.getItemAt(i).nilaipajak1=0; 
					//					dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai
				}
				
				for(i=0; i<dg3.dataProviderLength; i++){
					dg3.dataProvider.getItemAt(i).kodebarang=''; 
					dg3.dataProvider.getItemAt(i).subtotal=0; 
					dg3.dataProvider.getItemAt(i).nilaipajak1=0; 
					dg3.dataProvider.getItemAt(i).nilaipajak1=0; 
