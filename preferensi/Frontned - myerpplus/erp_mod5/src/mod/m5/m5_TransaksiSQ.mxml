				function f_mbBuka():void
				{
					FlexGlobals.topLevelApplication.f_bukaTransaksi('Sq');
				}
				function f_mbReset():void
				{
					FlexGlobals.topLevelApplication.FormFilter = '';
					f_kondisiAwal();
				}
				function f_mbAmbilSQ():void
				{
					if(txtcustomer.text.length <= 0 || txtmatauang.text.length <= 0){
						pesanAlert = ''; validasi = true;
						if(txtcustomer.text.length <=0 || txtmatauang.text.length <= 0){
							if(txtcustomer.text.length <=0)parentApplication.msgAlert(txtcustomer,'Customer');
							if(txtmatauang.text.length <=0)parentApplication.msgAlert(txtmatauang,'Uang');
							if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
						}
					}else{
						parentApplication.F_popUpCari("ambilSQ");
					}
				}
				function f_mbSetBom():void
				{
					parentApplication.vpFocusEvent = true;
					var detailsetbom:Object={}
					for(i=0; i<dg1.dataProviderLength; i++){
						if(i == 0){ detailsetbom = dg1.dataProvider.getItemAt(i).idbarang+"▼"+dg1.dataProvider.getItemAt(i).jmlbarang;
						}else{ detailsetbom += "▲"+dg1.dataProvider.getItemAt(i).idbarang+"▼"+dg1.dataProvider.getItemAt(i).jmlbarang;
						}
					}
					pesanAlert = ''; validasi = true;
					if(detailsetbom == 'undefined▼undefined'){
						if(detailsetbom == 'undefined▼undefined')parentApplication.msgAlert(dg1,'Detail');
						if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
					}else{
						parentApplication.F_wsSimpan('SetBOM', 'M6_ItemBomSearch', parentApplication.userid, isUpdate, detailsetbom);
					}
				}
