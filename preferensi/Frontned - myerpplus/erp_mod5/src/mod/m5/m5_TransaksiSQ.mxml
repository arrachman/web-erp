					sqcustomer:0, sqcustomerkontak:txtkontakperson.text, sq1alamat1:txtalamatcustomer.text, sq1alamat2:'', sq1alamat3:'', sq2alamat1:txtalamatkirim.text, sq2alamat2:'', 
					sq2alamat3:'', sqbagianpenjualan:0, sqtglkirim:dttanggalkirim.text, sqtermin:txttermin.text, sqtgljatuhtempo:tglDB, squraian:txturaian.text, sqcatatan:txtcatatan.text, 
					sqnoref:txtnoref.text, sqtglnoref:dttanggalnoref.text, sqtglpenutupan:parentApplication.m.DateFirst, sqmatauang:txtmatauang.text, sqkurs:o.txtkurs, sqhargatermasukpajak:0, sqtotal:0, 
					sqdiskonpersen:0, sqjmldiskon:0, sqtotalpajak1detail:0, sqtotalpajak2detail:0, sqbiayalainpersen:0, sqbiayalain:0, sqtotaltransaksi:0, 
