				parentApplication.F_SetNilaiText([txtdiskonnilai, txtdiskonpersen, txtbiayalainnilai, txtbiayalainpersen], parentApplication.m.nfNominal.format(0));
				parentApplication.F_KosongkanText([txtcustomer, txtkontakperson, txtsalesman, txtgudang, txtnotransaksi, txtmatauang, txtkurs, txtgudang, txttermin, txturaian, txtcatatan, txtalamatcustomer, txtalamatkirim, txtnoref, txtmasaberlaku, txtfranco, txtwaktupengiriman, txtvalidity, lblcustomer, lblsalesman, lblgudang, lbltermin]);
