				function validasiForm():void
				{
					validasi = true;
					pesanAlert = '';
					parentApplication.F_hapusBarisKosongGrid(dg1);
					if(cmbasalbarang.selectedIndex < 0 || cmbasalbarang.textInput.text.length == 0)parentApplication.msgAlert(cmbasalbarang,'Asal Barang');
					if(cmbcarabayar.selectedIndex < 0 || cmbcarabayar.textInput.text.length == 0)parentApplication.msgAlert(cmbcarabayar,'Cara Bayar');
					if(txtcustomer.text.length == 0)parentApplication.msgAlert(txtcustomer,'Customer');
					if(txtsalesman.text.length == 0)parentApplication.msgAlert(txtsalesman,'Salesman');
					if(txtgudang.text.length == 0)parentApplication.msgAlert(txtgudang,'Gudang');
					if(dttanggal.text.length == 0)parentApplication.msgAlert(dttanggal,'Tanggal');
					if(txtnotransaksi.text.length == 0)parentApplication.msgAlert(txtnotransaksi,'No Transaksi');
					if(txtmatauang.text.length == 0)parentApplication.msgAlert(txtmatauang,'Mata Uang');
					if(txtkurs.text.length == 0)parentApplication.msgAlert(txtkurs,'Kurs');
					if(cmbprogress.selectedIndex < 0 || cmbprogress.textInput.text.length == 0)parentApplication.msgAlert(cmbprogress,'Progress');
					if(dg1.dataProvider.getItemAt(0).idsqdetail == null)parentApplication.msgAlert(dg1,'Detail Item');
					if(pesanAlert != '')parentApplication.msgAlert('pesanAlert', '');
				}
			}
			
			public function f_hitungTotalDetail():void
			{
				n.vtotal=0;
				n.vtotalpajak1=0;
				n.vtotalpajak2=0;
				for(var i:int=0;i<dg1.dataProvider.length;i++){
					if(dg1.dataProvider.getItemAt(i).subtotal != undefined)n.vtotal += Number(dg1.dataProvider.getItemAt(i).subtotal);
					if(dg1.dataProvider.getItemAt(i).jmlpajak1 != undefined)n.vtotalpajak1 += Number(dg1.dataProvider.getItemAt(i).jmlpajak1);
					if(dg1.dataProvider.getItemAt(i).jmlpajak2 != undefined)n.vtotalpajak2 += Number(dg1.dataProvider.getItemAt(i).jmlpajak2);
				}
				lbltotal.text = parentApplication.m.nfNominal.format(n.vtotal);
				lblpajak1.text = parentApplication.m.nfNominal.format(n.vtotalpajak1);
				lblpajak2.text = parentApplication.m.nfNominal.format(n.vtotalpajak2);
				
				//				o.txtdiskonnilai = (o.txtdiskonpersen/100) * n.vtotal;
				o.txtdiskonnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtdiskonpersen);
				txtdiskonnilai.text = parentApplication.m.nfNominal.format(o.txtdiskonnilai.toString());
				//				o.txtbiayalainnilai = (o.txtbiayalainpersen/100) * n.vtotal;
				o.txtbiayalainnilai = FlexGlobals.topLevelApplication.F_diskonBertingkat(1, n.vtotal, o.txtbiayalainpersen);
				txtbiayalainnilai.text = parentApplication.m.nfNominal.format(o.txtbiayalainnilai.toString());
				
				f_hitungTotalUtama();
			}
			
			public function f_hitungTotalUtama():void
			{
				if(chkhargapajak.selected == false){
					n.vtotaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak1) + Number(n.vtotalpajak2) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
				}else{
					n.vtotaltransaksi = (Number(n.vtotal) + Number(n.vtotalpajak2) + Number(o.txtbiayalainnilai)) - Number(o.txtdiskonnilai);
				}
				
				
				lbltotaltransaksi.text = parentApplication.m.nfNominal.format(n.vtotaltransaksi);
			}
			
			public function f_hitungGrid():void
			{ 
				var dgrid: Object; 
				for(i = 0; i<dg1.dataProviderLength; i++){ 
					dgrid = dg1.dataProvider[i];
					dgrid.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid.jml, dgrid.harga, dgrid.diskon); 
					dgrid.subtotal = (Number(dgrid.jml) * Number(dgrid.harga))- dgrid.jmldiskon; 
					//					dgrid.jmlpajak1 = (Number(dgrid.nilaipajak1)/100) * dgrid.subtotal; 
					//					dgrid.jmlpajak2 = (Number(dgrid.nilaipajak2)/100) * dgrid.subtotal; 
					dgrid.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.nilaipajak1, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
					dgrid.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid.nilaipajak2, dgrid.subtotal, dgrid.nilaipajak1, dgrid.nilaipajak2);
				} 
			} 
			
			public function f_defaultGrid():void
			{
				parentApplication.rowIndex = 0;
				dg1.dataProvider.removeAll();
				parentApplication.F_acAdd(dg1);
				dg1.setSelectedCell(0, 1);
				dg2.dataProvider.removeAll();
				parentApplication.F_acAdd(dg2);
				dg2.setSelectedCell(0, 1);
				dg3.dataProvider.removeAll();
				parentApplication.F_acAdd(dg3);
				dg3.setSelectedCell(0, 1);
				f_focusOnMe();
			}
			
			protected function f_chkAuto():void
			{
				if(FlexGlobals.topLevelApplication.FormFilter != ''){
					if(chkauto.selected){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = getNotransaksi;
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = getNotransaksi;
						txtnotransaksi.setFocus();
					}
				}else{
					if(chkauto.selected){
						txtnotransaksi.enabled = false;
						txtnotransaksi.text = 'Auto';
					}else{
						txtnotransaksi.enabled = true;
						txtnotransaksi.text = '';
						txtnotransaksi.setFocus();
					}
				}
			}
			
