<?xml version="1.0" encoding="utf-8"?>	
<s:GridItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009"
				  xmlns:s="library://ns.adobe.com/flex/spark"
				  xmlns:mx="library://ns.adobe.com/flex/mx"
				  clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.FlexEvent;
			
			import spark.formatters.NumberFormatter;
			
			override public function set value(newValue:Object):void 
			{
				txt.text = newValue as String;
				txt.text = txt.text.split(".").join("");
			}
			
			override public function get value():Object 
			{
				//return txt.text;
				var arDefault:Array;
				var ob:Object = txt;
				var ss:String = ob.text;
				var arD:Array;
				var d1:String;
				var d2:String;
				var d3:String;
				//------------------------------------
				//distandarkan format tanggalnya
				ss = ss.split(" ").join("/");
				ss = ss.split("-").join("/");
				//------------------------------------
				//Default Hari ini
				var sd:String = FlexGlobals.topLevelApplication.DefaultTanggal;
				arDefault = sd.split("/");
				
				if (ss.length==2)
				{
					ss = f_stgl(ss);
					ob.text = ss + "/"+ arDefault[1] + "/" + arDefault[2];
				}
				else if(ss.length==4)
				{
					d1 = ss.slice(0,2);
					d2 = ss.slice(2,4);
					d1 = f_stgl(d1);
					d2 = f_sbln(d2);
					ob.text = d1 + "/" + d2 + "/" + arDefault[2];
				}
				else if(ss.length==6)
				{
					d1 = ss.slice(0,2);
					d2 = ss.slice(2,4);
					d1 = f_stgl(d1);
					d2 = f_sbln(d2);
					d3 = ss.slice(4,6);
					ob.text = d1 + "/" + d2 + "/20" + d3;
				}
				else if(ss.length==8)
				{
					arD = ss.split("/");
					if(arD.length==1)
					{
						d1 = ss.slice(0,2);
						d2 = ss.slice(2,4);
						d1 = f_stgl(d1);
						d2 = f_sbln(d2);
						d3 = ss.slice(4,8);
						ob.text = d1 + "/" + d2 + "/" + d3;	
					}
					else
					{
						arD = ss.split("/");
						d1 = f_stgl(arD[0]);
						d2 = f_sbln(arD[1]);
						ob.text = d1 + "/" + d2 + "/20" + arD[2];
					}
				}
				else if(ss.length==5)
				{
					arD = ss.split("/");
					d1 = f_stgl(arD[0]);
					d2 = f_sbln(arD[1]);
					ob.text = d1 + "/" + d2 + "/" + arDefault[2];
				}
				else if(ss.length==10)
				{
					arD = ss.split("/");
					d1 = f_stgl(arD[0]);
					d2 = f_sbln(arD[1]);
					ob.text = d1 + "/" + d2 + "/" + arD[2];
				}
				
				
				return txt.text;
			}
			
			private function f_stgl(ds:String):String
			{
				var has:String;
				if(int(ds)>31)
				{
					has="31";
				}
				else
				{
					has = ds;
				}
				return has;
			}
			
			private function f_sbln(ms:String):String
			{
				var has:String;
				if(int(ms)>12)
				{
					has="12";
				}
				else
				{
					has = ms;
				}
				return has;
			}
			
			override public function setFocus():void 
			{
				txt.setFocus();
			}
			
			protected function ns_creationCompleteHandler(event:FlexEvent):void
			{
				txt.restrict = ",0-9";
				txt.text = FlexGlobals.topLevelApplication.DefaultTanggal;
				parentApplication.F_DateFieldStandard([txt],true);
				parentApplication.F_DateFieldStandard([dt]);
			}
			
			protected function dt_changeHandler(event:CalendarLayoutChangeEvent):void
			{
				txt.text = dt.text;
				var a:Array = txt.text.split('/');
				dt.selectedDate = new Date(a[2], int(a[1])-1, a[0]);
			}
			
			protected function dt_focusInHandler(event:FocusEvent):void
			{
				var a:Array = txt.text.split('/');
				dt.selectedDate = new Date(a[2], int(a[1])-1, a[0]);
			}
			
		]]>
	</fx:Script>
	
	<s:TextInput id="txt" right="25" width="100%" height="100%" creationComplete="ns_creationCompleteHandler(event)" />
	<mx:DateField id="dt" right="0" width="25" height="100%" visible="true" focusIn="dt_focusInHandler(event)" change="dt_changeHandler(event)"/>
</s:GridItemEditor>
