<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
					xmlns:s="library://ns.adobe.com/flex/spark"
					xmlns:mx="library://ns.adobe.com/flex/mx"
					clipAndEnableScrolling="true"
					rollOver="griditemrenderer1_rollOverHandler(event)"
					rollOut="griditemrenderer1_rollOutHandler(event)">
	
	<fx:Script>
		<![CDATA[ 
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.DropdownEvent;
			import mx.events.FlexEvent;
			
			import spark.events.DropDownEvent;
			import spark.events.ListEvent;
			
			protected var b:Boolean = true, d:Boolean = true;
			override public function prepare(hasBeenRecycled:Boolean):void 
			{
				if(data != null)
					lbl.text = data[column.dataField];
			}
			
			
			protected function griditemrenderer1_rollOverHandler(event:MouseEvent):void
			{
				if(b)
					dt.visible = true;
				d = false;
			}
			
			protected function griditemrenderer1_rollOutHandler(event:MouseEvent):void
			{
				d = true;
				if(b)
					dt.visible = false;
			}
			
			protected function lblData_renderHandler(event:Event):void
			{ 
				lbl.text = data[column.dataField];
			}
			
			protected function dt_changeHandler(event:CalendarLayoutChangeEvent):void
			{
				var a:Array = dt.text.split('/');
				if(d){
					lbl.text = dt.text;
					data[column.dataField] = dt.text;
					dt.selectedDate = new Date(a[2], a[1], a[0]);
					dt.visible = false;
				}
				parentApplication.F_setProperty('date', column.dataField, dt.text);
			}
			
			protected function dt_openHandler(event:DropdownEvent):void
			{
				b = false;
			}
			
			protected function dt_closeHandler(event:DropdownEvent):void
			{
				b = true;
			}
			
			protected function dt_creationCompleteHandler(event:FlexEvent):void
			{
				parentApplication.F_DateFieldStandard([dt]);
			}
			
		]]> 
	</fx:Script>
	<mx:DateField id="dt" right="0" width="25" height="100%" change="dt_changeHandler(event)" close="dt_closeHandler(event)" creationComplete="dt_creationCompleteHandler(event)" open="dt_openHandler(event)" useHandCursor="true" buttonMode="true" visible="false"/>
	<s:Label id="lbl" top="9" left="7" visible="true" render="lblData_renderHandler(event)"/>
</s:GridItemRenderer>