<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			override public function prepare(hasBeenRecycled:Boolean):void {
				if(data != null){
					lblData.text = data[column.dataField];
					
					if(data[column.dataField+"_right"] != undefined && data[column.dataField+"_right"]){
						lblData.left = undefined;
						lblData.right = 7;
					}
				}
			}
			
			protected function lblData_clickHandler(event:MouseEvent):void
			{
				FlexGlobals.topLevelApplication.f_refreshIDmodule(this);
				if(parentApplication.m[parentApplication.module].child.hasOwnProperty('o'))
					if(parentApplication.m[parentApplication.module].child.o.hasOwnProperty('jt')){
						if(column.dataField.split("notransaksi").length == 2)
							parentApplication.m[parentApplication.module].child.f_setProperty('link', column.dataField, null);
						else
							parentApplication.m[parentApplication.module].child.o.jt.f_jt('link', column.dataField, null);
						return;
					}
				parentApplication.m[parentApplication.module].child.f_setProperty('link', column.dataField, null);

			}
			
		]]>
	</fx:Script>
	<s:Label id="lblData" top="9" left="7" color='#009ad4' rollOver="setStyle('textDecoration','underline')" rollOut="setStyle('textDecoration','none')" useHandCursor="true" buttonMode="true" mouseChildren="false" click="lblData_clickHandler(event)"/>
</s:GridItemRenderer>