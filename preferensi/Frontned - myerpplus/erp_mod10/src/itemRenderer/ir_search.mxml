<?xml version="1.0" encoding="utf-8"?>
<s:GridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
					xmlns:s="library://ns.adobe.com/flex/spark"
					xmlns:mx="library://ns.adobe.com/flex/mx"
					clipAndEnableScrolling="true"
					rollOver="griditemrenderer1_rollOverHandler(event)"
					rollOut="griditemrenderer1_rollOutHandler(event)">
	
	<fx:Script>
		<![CDATA[ 
			import MyClass.KelasKu;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.DataGrid;
			import spark.events.DropDownEvent;
			import spark.events.ListEvent;
			
			[Bindable] [Embed(source="assets/tb/find.png")]  public var tbfind:Class;
			
			override public function prepare(hasBeenRecycled:Boolean):void 
			{
				if(data != null)
					lblData.text = data[column.dataField];
			}
			
			
			protected function griditemrenderer1_rollOverHandler(event:MouseEvent):void
			{
				img.visible = true;
			}
			
			protected function griditemrenderer1_rollOutHandler(event:MouseEvent):void
			{
				img.visible = false;
			}
			
			protected function lblData_renderHandler(event:Event):void
			{ 
				if(data != null)
					lblData.text = data[column.dataField];
			}
			
			protected function img_clickHandler(event:MouseEvent):void
			{
				var m:Object = {}
				m.dg = this.parent.parent.parent.parent.parent.parent.parent.parent.parent;
				m.kls = new KelasKu;
				if(m.dg.id.split("_lock").length == 1)
					m.b = m.kls.KondisiEditGrid(m.dg, parentApplication.m.mod[parentApplication.idmod]["e"+m.dg.id]);
				else
					m.b = m.kls.KondisiEditGrid(m.dg, parentApplication.m.mod[parentApplication.idmod]["e_l"+m.dg.id]);
				if(m.b)
					FlexGlobals.topLevelApplication.F_popUpCari(column.dataField);
			}
			
		]]> 
	</fx:Script>
	<s:Label id="lblData" top="9" left="7" visible="true" render="lblData_renderHandler(event)"/>
	<s:Image id="img" source="{tbfind}" visible="false" top="5" right="4" useHandCursor="true" buttonMode="true" mouseChildren="false" click="img_clickHandler(event)"/>
</s:GridItemRenderer>