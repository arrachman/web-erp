<?xml version="1.0" encoding="utf-8"?>	
<s:GridItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009" 
				  xmlns:s="library://ns.adobe.com/flex/spark" 
				  xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.events.DropDownEvent;
			import spark.events.TextOperationEvent;
			import spark.formatters.NumberFormatter;
			
			protected var i:int;
			override public function set value(newValue:Object):void 
			{
				if(parentApplication.F_getProperty('custom', column.dataField, rowIndex) != "comboBox")
					txt.text = String(newValue);
			}
			
			override public function get value():Object 
			{
				if(parentApplication.F_getProperty('custom', column.dataField, rowIndex) == "comboBox"){
					parentApplication.m.focusComboBox = false;
					if(cmb.selectedIndex >= 0)
						return cmb.selectedItem.v;
					else
						return '';
				}else{
					return txt.text;
				}
			}
			
			override public function setFocus():void 
			{
				if(parentApplication.F_getProperty('custom', column.dataField, rowIndex) == "comboBox"){
					cmb.setFocus();
				}else{
					txt.setFocus();	
				}
			}
			
			protected function cmb_creationCompleteHandler(event:FlexEvent):void
			{
				if(parentApplication.F_getProperty('custom', column.dataField, rowIndex) == "comboBox"){
					cmb.dataProvider = parentApplication.F_getProperty('comboBox', column.dataField, '');
					parentApplication.F_ComboBoxStandard([cmb]);
					if(data != null && cmb.dataProvider != null)
						for(i=0;i<cmb.dataProvider.length;i++)
							if(cmb.dataProvider.getItemAt(i).v == data[column.dataField]){
								cmb.selectedIndex = i;
								break;
							}
				}else{
					cmb.visible = false;
					txt.visible = true;
				}
			} 	
			
			protected function cmb_closeHandler(event:DropDownEvent):void
			{
				data[column.dataField] = cmb.selectedItem.v;
				parentApplication.F_setProperty('comboBox', column.dataField, cmb.selectedItem.v);
			}
			
			protected function cmb_changeHandler():void
			{
				if(cmb.selectedIndex >= 0){
					data[column.dataField] = cmb.selectedItem.v;
					parentApplication.F_setProperty('comboBox', column.dataField, cmb.selectedItem.v);
				}
			}
			
			protected function txt_changeHandler(event:TextOperationEvent):void
			{
				data[column.dataField] = txt.text;
			}
			 
		]]>
	</fx:Script>
	<s:ComboBox id="cmb" width="100%" height="100%"
				change="cmb_changeHandler()" close="cmb_closeHandler(event)"
				creationComplete="cmb_creationCompleteHandler(event)"/>
	<s:TextInput id="txt" width="100%" height="100%" visible="false" change="txt_changeHandler(event)" />
</s:GridItemEditor>