						}
						break;
				}
			}	
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='',id:String = '', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtsupplier":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif=1 and kkategori="S" and kkode ="'+txtsupplier.text+'"';
						csfilter = 'kaktif=1 and kkategori="S"';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtsumber":
						paket = "CdM0_Nomor";
						wsfilter = '(kodetabel = "RI" or kodetabel="PRT") and kodetabel ="'+txtsumber.text+'"';
						csfilter = 'kodetabel = "RI" or kodetabel="PRT"';
						csfield = 2;
						sort = 'kodetabel asc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
