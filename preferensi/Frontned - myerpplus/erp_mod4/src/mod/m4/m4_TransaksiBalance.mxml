									prtjmlbayar, prtstatuslunas, FlexGlobals.topLevelApplication.F_tglFormatDB(prttgllunas), txtnofaktur.text, prtsdhbayarpajak, FlexGlobals.topLevelApplication.F_tglFormatDB(prttglbayarpajak), prtrekdiskon, 
									prtrekpajak1, prtrekpajak2, prtrekbiayalain, prtrekbayar, prtreksisa, prtidpr, prtidcs, 
									prtidrq, prtidbs, prtidpo, prtidipc, prtidgrn, prtidri, prtiddnr, 
									cmbprogress.selectedItem.v, prtstatussebelumnya, prtjmlrevisi, prtcetakanke, prtinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(prtinputtgl), prtmodifikasiuser, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(prtmodifikasitgl), int(chkposting.selected), prttutupperiode, prtisclose, prtcustomtext1, prtcustomtext2, prtcustomtext3, 
									prtcustomtext4, prtcustomtext5, prtcustomint1, prtcustomint2, prtcustomint3, prtcustomdbl1, prtcustomdbl2, 
									prtcustomdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(prtcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(prtcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(prtcustomdate3)];
								utama = f_splitArrayToString(a);
							}
							FlexGlobals.topLevelApplication.F_wsSimpan("simpanPRT", "M4_PrtBalance", parentApplication.userid, isUpdate, utama);
						}
					}
					
					
				}
				
				function validasiForm():void
				{
					var i:int;
					validasi = true;
					vMsg = "";
					vMsgIng = "";
					if(txttermin.text.length == 0){
						o.ritgljatuhtempo = dttgl.text;
					}
					if(txtsumber.text.length <= 0)msgAlert(txtsumber,'Sumber', 'Sumber');
					if(txtsupplier.text.length <= 0)msgAlert(txtsupplier,'Supplier', 'Supplier');
					if(txtmatauang.text.length <= 0)msgAlert(txtmatauang,'Mata Uang','Currency');
					if(txtkurs.text.length <= 0)msgAlert(txtkurs,'Kurs','Rate');
					if(txtnotransaksi.text.length == 0)msgAlert(txtnotransaksi,'Transaction Number','No Transaksi');
					if(dttgl.text.length <= 0)msgAlert(dttgl,'Tanggal','Date');
					if(cmbprogress.selectedIndex < 0)msgAlert(cmbprogress,'Progress','Progress');
					
					
					if(vMsg != '')msgAlert('clear', '', '');
					f_hitungTotal();
				}
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
			public function f_hitungTotal():void
			{
				o.totaltransaksi= (Number(o.txttotal) + Number(o.txttotalpajak1) + Number(o.txttotalpajak2) + Number(o.txtbiayalainnominal)) - Number(o.txtdiskonnominal);
				o.sisa= o.totaltransaksi;
				lbltotaltransaksi.text =  FlexGlobals.topLevelApplication.m.nfNominal.format(o.totaltransaksi);
			}
			
			
