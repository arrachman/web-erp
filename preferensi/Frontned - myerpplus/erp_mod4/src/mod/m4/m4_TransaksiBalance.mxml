				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled)f_simpan();
				}
				function f_mbBuka():void{
					if(txtsumber.text == "RI"){
						FlexGlobals.topLevelApplication.f_bukaTransaksi("Ri","risaldoawal = 1")
