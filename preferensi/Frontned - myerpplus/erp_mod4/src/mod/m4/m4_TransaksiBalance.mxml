			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				
				if(FlexGlobals.topLevelApplication.FormFilter== ''){
					f_kondisiAwal();
				}else{
					var sumber:String = "";
					if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
						sumber = FlexGlobals.topLevelApplication.m.ArrFilter[0];
					}else{
						sumber = txtsumber.text;
					}
					if(filtersplit.length > 1){
						if(sumber == 'RI'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilHistoryRI', 'M4_Ri_HistorySearch',1,1, 'riidhistory = "'+idtransaksi+'"','', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else if(sumber == 'RI'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilHistoryPRT', 'M4_Prt_HistorySearch',1,1, 'prtidhistory = "'+idtransaksi+'"','', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
						
					}else {
						if(sumber == 'RI'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilRI', 'M4_RiBSearch',1,1,'riid = "'+idtransaksi+'"','',FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else if(sumber == 'PRT'){
							FlexGlobals.topLevelApplication.F_wsSearch('tampilPRT', 'M4_PrtBSearch',1,1,'prtid = "'+idtransaksi+'"','',FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
						
					}
				}
				//end of set getdata by id===============================================================================================
			}
