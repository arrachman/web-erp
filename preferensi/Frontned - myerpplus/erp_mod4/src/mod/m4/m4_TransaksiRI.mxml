			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 4, "RI");
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
					ac_Batch.removeAll();
					ac_Serial.removeAll();
					ac_Aktiva.removeAll();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_RiHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
							idtransaksi = parentApplication.m.ArrFilter[0];
							idtransaksi = idtransaksi.replace('p1  = "', '');
							idtransaksi = idtransaksi.replace('"', '');
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_RiGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_RiGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
						}
							
							
						
					}
				}
				
			}
