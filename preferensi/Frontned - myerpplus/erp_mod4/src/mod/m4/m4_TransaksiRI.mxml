						f_hitungTotal();
						FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
						FlexGlobals.topLevelApplication.F_dgRefresh(dgbiaya);
						FlexGlobals.topLevelApplication.F_dgRefresh(dgap);
