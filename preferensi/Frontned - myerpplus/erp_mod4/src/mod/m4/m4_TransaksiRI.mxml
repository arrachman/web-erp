			public function msgAlert(focus: Object, indonesia: String, inggris: String):void
			{		
				if(validasi)focus.setFocus();
				pesanAlertIng += inggris+', ';
				pesanAlert += indonesia+', ';
				if(focus == 'clear'){
					pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
					pesanAlert += " harus diisi dengan benar terlebih dahulu";
					
					pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
					pesanAlertIng += " must be filled in correctly first";
					Alert.show(pesanAlert+" !" , "Information");}	
				validasi = false;
			}
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				var dgrid1:Object;
				switch (components){
					case "checkBox":
						if(tab.selectedIndex == 0){
							dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex).hargafix = data;
						}else{
							dgbiaya.dataProvider.getItemAt(dgbiaya.selectedCell.rowIndex).termasukpajak = data;
						}
						
						break;
					case "calculator":
						dg1.dataProvider[dg1.selectedCell.rowIndex][dataField] = data;
						FlexGlobals.topLevelApplication.F_dgColumnRefresh(dg1, dg1.selectedCell.rowIndex);
						switch (dataField){
							case "jml":
							case "harga":
							case "diskon":
								dgrid1 = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
								dgrid1.jmldiskon = FlexGlobals.topLevelApplication.F_diskonBertingkat(dgrid1.jml, dgrid1.harga, dgrid1.diskon);
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
//								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
//								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								
								dgrid1.jmlbarang = dgrid1.nilaisatuan * dgrid1.jml;
								
								FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
								FlexGlobals.topLevelApplication.F_hargaTotal(dg1);
								break;
							case "jmldiskon":
								dgrid1 = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
								pesanAlert = ''; pesanAlertIng = '';
								dgrid1 = dg1.dataProvider.getItemAt(dg1.selectedCell.rowIndex);
								if(dgrid1.jml == 0 || dgrid1.harga == 0){
									if(dgrid1.jml == 0)msgAlert(dg1,'Jumlah barang', 'Item Amount');
									if(dgrid1.harga == 0)msgAlert(dg1,"Harga", "Price");
									if(pesanAlert != '' && pesanAlertIng != '')msgAlert('clear','','');
									dgrid1.jmldiskon = 0;
									dgrid1.diskon= 0;
								}else{
									dgrid1.diskon = (Number(dgrid1.jmldiskon)/(Number(dgrid1.jml)*Number(dgrid1.harga)))*100;
								}
								dgrid1.subtotal = (Number(dgrid1.jml)*Number(dgrid1.harga)) - Number(dgrid1.jmldiskon);
//								dgrid1.jmlpajak1 = (Number(dgrid1.pajak1nilai)/100) *  Number (dgrid1.subtotal);
//								dgrid1.jmlpajak2 = (Number(dgrid1.pajak2nilai)/100) *  Number (dgrid1.subtotal);
								dgrid1.jmlpajak1 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak1nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								dgrid1.jmlpajak2 = vjmlpajak.f_JmlPajak(chkhargapajak.selected, dgrid1.pajak2nilai, dgrid1.subtotal, dgrid1.pajak1nilai, dgrid1.pajak2nilai);
								
								FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
								break;
							case "subtotal":
								hargaDariSubtotal.hitungHargaDariSubtotal(dg1);
								break;
						}
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
				f_hitungTotal();
			}
			
