				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg1);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgbiaya);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgap);
				f_hitungTotal();
			}
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='',id:String = '', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				var filtergudang :String;
				switch(target){
					case "txtsupplier":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif=1 and kkategori="S" and kkode ="'+txtsupplier.text+'"';
						csfilter = 'kaktif=1 and kkategori="S"';
						csfield = 2;
						sort = 'kkode asc';
						break;
					case "txtlokasi":
						paket = "CdM1_Location";
						wsfilter = 'laktif=1 AND lkode="'+txtlokasi.text+'"';
						csfilter = 'laktif=1';
						//csfield = 2;
						sort = 'lkode asc';
						break;
					case "txtnoap":
						paket = 'CdM4_Ap';
						wsfilter = '(apkontak = '+o.risupplier+') and (apstatus IN (2, 3)) and apmatauang = "'+txtmatauang.text+'" and apnotransaksi = "'+txtnoap.text+'"';
						csfilter = '(apkontak = '+o.risupplier+') and (apstatus IN (2, 3)) and apmatauang = "'+txtmatauang.text+'" ';
						csfield = 2;
						sort = 'apnotransaksi desc';
						break;
					case "txtkontakperson":
						paket = "CdM1_Contact_Attention";
						wsfilter = 'kaidkontak ='+o.risupplier+' AND kakodekontak ="'+txtkontakperson.text+'"';
						csfilter = 'kaidkontak ='+o.risupplier+'';
						csfield = 2;
						sort = 'kakodekontak asc';
						break;
					case "txtgudang":
						paket = "CdM1_Warehouse";
						wsfilter = 'waktif=1 AND wkode="'+txtgudang.text+'"';
						csfilter = 'waktif=1';
						csfield = 2;
						sort = 'wkode asc';
						break;
					case "txtmatauang":
						paket = "CdM1_Currency";
						wsfilter = 'caktif=1 and ckode = "'+txtmatauang.text+'"';
						csfilter = 'caktif=1';
						sort = 'ckode asc';
						break;
					case "txttermin":
						paket = "CdM1_Terms";
						wsfilter = 'traktif=1 and trkode = "'+txttermin.text+'"';
						csfilter = 'traktif=1';
						sort = 'trkode asc';
						break;
					case "txtcatatan":
						paket = "CdM1_Transaction_Note";
						csfilter = 'tnaktif=1 and tnsumber="RI"';
						csfield = 2;
						sort = 'tnkode asc';
						break;
					case "txtbagpembelian":
						paket = "CdM1_Contact";
						wsfilter = 'kaktif="1" and kkategori="K" and kkode ="'+txtbagpembelian.text+'"';
