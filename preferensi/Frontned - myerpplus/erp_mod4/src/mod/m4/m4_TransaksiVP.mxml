			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey){
							var  jenissimpan:int = 1;
							if(isUpdate == false){
								jenissimpan = 1
							}else{
								jenissimpan = 2
							}
							if(FlexGlobals.topLevelApplication.apaBisaAkses(4,15,jenissimpan)){
								f_simpan();
							}
						}
						break;
				}
			}	
			
			
			public function f_grid(dg:DataGrid, column:String):void
			{
				var i:int, n:Number, a:Array; 
				var dgrid:Object;
				switch(column){
					case "jmlbayar":
						dgrid = dg.dataProvider.getItemAt(dg.selectedCell.rowIndex)
						if(dgrid.matauang != ''){
							if(dgrid.matauang == UFungsional){
								dgrid.jmlbayarvalas = 0 ;
							}
							else{
								dgrid.jmlbayarvalas = Number(dgrid.jmlbayar) / Number(dgrid.kurs);
							}
							dgrid.diskontermin = f_diskonTermin(dttgl.text, '', dgrid.tgl, dgrid.haridiskon1, dgrid.haridiskon2, dgrid.diskon1, dgrid.diskon2);
							dgrid.jmldiskontermin = dgrid.jmlbayar*(dgrid.diskontermin/100);
							dgrid.jmldiskonterminvalas = dgrid.jmlbayarvalas*(dgrid.diskontermin/100);
							f_hitungTotal();
						}
						break;
					case "jmlbayarvalas":
						dgrid = dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)
						if(dgrid.matauang != ''){
							if(dgrid.matauang != UFungsional){
								dgrid.jmlbayar = dgrid.jmlbayarvalas *  Number(dgrid.kurs);
							}else{
								dgrid.jmlbayarvalas = 0
								dgrid.jmlbayar = Number(dgrid.totaltransaksi) - Number(dgrid.terbayar)
							}
							
							dgrid.diskontermin = f_diskonTermin(dttgl.text, '', dgrid.tgl, dgrid.haridiskon1, dgrid.haridiskon2, dgrid.diskon1, dgrid.diskon2);
							dgrid.jmldiskontermin = dgrid.jmlbayar*(dgrid.diskontermin/100);
							dgrid.jmldiskonterminvalas = dgrid.jmlbayarvalas*(dgrid.diskontermin/100);
							f_hitungTotal();
						}
						break;
					case "jumlah":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlahvalas = Number(jumlah) / o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
						}
						
						break;
					case "jumlahvalas":
						with(dg.dataProvider.getItemAt(FlexGlobals.topLevelApplication.rowIndex)){
							if (txtmatauang.text != UFungsional){
								jumlah = Number(jumlahvalas) * o.txtkurs;
							}else{
								jumlahvalas = 0;
							}
						}
						break;
					case "bank":
					case "nogiro":
					case "noacbank":
						editable();
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
			}
			
			public function editable():void{
				if(dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex).carabayar ==0 || dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex).carabayar ==3){
					dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex).bank = '';
					dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex).nogiro = '';
					dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex).noacbank = '';
				}
					
				else {
					if(dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex).carabayar == 1){
						dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex).nogiro = '';
						
					}
				}
			}
			
