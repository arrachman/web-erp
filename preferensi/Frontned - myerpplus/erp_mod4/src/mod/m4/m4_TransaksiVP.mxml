					if(parentApplication.F_validasiFalse(s))
						switch(s){
							// 9.2.1 Result untuk WS False apa saja
							case "noakun": //noakun
								if(tab.selectedIndex==0)
									if(tab.selectedIndex==1)
										break;
							case "costcenter": //coscenter / bank
								if(tab.selectedIndex==0)with(dgRI.dataProvider.getItemAt(parentApplication.rowIndex))costcenter = '';
								break;
							
							case "divisi": //divisi
								with(dgRI.dataProvider.getItemAt(parentApplication.rowIndex)){
									divisi = '';
								}
								break;
							case "subdivisi": // subdivisi
								dgRI.dataProvider.getItemAt(parentApplication.rowIndex).subdivisi = '';
								break;
							case "proyek": // proyek
								if(tab.selectedIndex==0){
									dgRI.dataProvider.getItemAt(parentApplication.rowIndex).proyek = '';
								}
								break;
							case "rekbank":
								dgrid = dgBayar.dataProvider.getItemAt(dgBayar.selectedCell.rowIndex);
								dgrid.rekbank = '';
								dgrid.rekbanknama = ''; 
								dgrid.noacbank = '';
								break;
							case "tampil":
							case "tampilHistory":
							case "simpan":
								Alert.show(parentApplication.l(parentApplication.wsErrmessage), parentApplication.l('Informasi'));
								break;
							case "Vpp_TakeData":
								if(loop == -1 || loop == 3)loop = tab.selectedIndex;
								if(loop == 0)dg = dgRI;
								else if(loop == 1)dg = dgAP;
								else if(loop == 2)dg = dgPRT;
								for(i=dg.dataProviderLength-1;i>=0;i--){
									if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
										dg.dataProvider.removeItemAt(i);
									}
								}
								if(dg.dataProviderLength == 0){
									FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
								}
								f_hitungTotal();
								f_uangRefreshGrid();
								break;
						}
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dgAP);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgCOA);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgBayar);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgPRT);
				FlexGlobals.topLevelApplication.F_dgRefresh(dgRI);
				f_hitungTotal();
			}
			
