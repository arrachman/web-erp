	<fx:Script> 
		<![CDATA[			
			import MyClass.SettingNoTransaction;
			
			import flashx.textLayout.elements.TCYElement;
			
			import itemRenderer.ir_checkBox;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.components.CheckBox;
			import spark.components.Image;
			import spark.components.TitleWindow;
			
			public var validasi:Boolean,t:TitleWindow,pesanAlert:String, pesanAlertIng:String, c:CheckBox, img:Image, i:int, isUpdate:Boolean, UFungsional:String;
			public var o:Object = {},no:int;
			[Bindable] public var ac2:ArrayCollection = new ArrayCollection();
			public var vIdkontak:int, arrColumn:Array = new Array;
			[Bindable]protected var arrMenuBar:ArrayCollection;
			public var settingNotransaksi:SettingNoTransaction = new SettingNoTransaction, getNotransaksi:String;
			[Bindable]protected var acEdit:ArrayCollection = new ArrayCollection();
			public function f_focusOnMe():void
			{
				txtsumber.setFocus();
			}
			
			
			public function f_setProperty(components:String, dataField:String, data:Object, info:String = ''):void
			{
				switch (components){
					case "checkBoxHeader":
						for (i=0; i<dg.dataProviderLength; i++){
							dg.dataProvider.getItemAt(i).chk = data;
							
							dg.dataProvider.getItemAt(i).statusubah = 1;
							f_EditData();

							
						}
						
						break;
					case "checkBox":
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).chk = data;
						dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).statusubah = 1
						f_EditData();
						
						break;
					
					case "link":
						if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).sumber == "RI"){
							FlexGlobals.topLevelApplication.openForm(4, 11, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idtransaksi);
						}else if(dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).sumber == "PRT"){
							FlexGlobals.topLevelApplication.openForm(4, 13, dg.dataProvider.getItemAt(dg.selectedCell.rowIndex).idtransaksi);
						}
						
						break;
				}
				FlexGlobals.topLevelApplication.F_dgRefresh(dg);
				f_hitungTotal();
				
			}
			
			public function f_EditData():void{
				var iAC:int;
				for(var m:int = 0; m<dg.dataProviderLength; m++){
					
					with(dg.dataProvider[m]){
						if(statusubah == 1){
							if(acEdit.length > 0){
								f_SetDatatoArray(m);
							}else{
								acEdit.addItem({
									chk:chk,
									idpiedetail : idpiedetail, 
									idpie : idpie, 
									notransaksi : notransaksi,
									supplierkode : supplierkode,
									suppliernama : suppliernama,
									uraian : uraian,
									tgl : tgl,
									sumber : sumber, 
									idtransaksi :idtransaksi, 
									sumber: sumber, 
									termin: termin,
									catatan :catatan, 
									urutan : urutan, 
									isclose : isclose, 
									customtext1 : customtext1, 
									customtext2 : customtext2, 
									customtext3 : customtext3, 
									customdbl1 : customdbl1, 
									customdbl2 : customdbl2, 
									customdbl3 : customdbl3, 
									customdate1 : customdate1, 
									customdate2 : customdate2, 
									customdate3 : customdate3,
									statusubah : 0});
							}
						}	
						else if(statusubah == 0){
							for(iAC = acEdit.length - 1; iAC >= 0 ; iAC--){
								if(idtransaksi != undefined && sumber != undefined){
									if(idtransaksi == acEdit[iAC].idtransaksi && sumber != acEdit[iAC].sumber){
										acEdit.removeItemAt(iAC);
									}
								}
								
							}
							
						}
					}
				}
				
				
				
			}
			public var ada:Boolean;
			public var statusedit:Boolean;
			public function f_SetDatatoArray(Index:int):void{
				ada = false;
				acEdit.refresh();
				for(var i:int = 0; i<acEdit.length; i++){
					if(dg.dataProvider[Index].notransaksi == acEdit[i].notransaksi){
						
						acEdit[i].chk= dg.dataProvider[Index].chk; 
						acEdit[i].idpiedetail= dg.dataProvider[Index].idpiedetail; 
						acEdit[i].idpie= dg.dataProvider[Index].idpie; 
						acEdit[i].notransaksi= dg.dataProvider[Index].notransaksi; 
						acEdit[i].supplierkode= dg.dataProvider[Index].supplierkode; 
						acEdit[i].suppliernama= dg.dataProvider[Index].suppliernama; 
						acEdit[i].uraian= dg.dataProvider[Index].uraian; 
						acEdit[i].tgl= dg.dataProvider[Index].tgl; 
						acEdit[i].sumber= dg.dataProvider[Index].sumber; 
						acEdit[i].termin= dg.dataProvider[Index].termin; 
						acEdit[i].catatan= dg.dataProvider[Index].catatan; 
						acEdit[i].urutan= dg.dataProvider[Index].urutan; 
						acEdit[i].isclose= dg.dataProvider[Index].isclose; 
						acEdit[i].customtext1= dg.dataProvider[Index].customtext1; 
						acEdit[i].customtext2= dg.dataProvider[Index].customtext2; 
						acEdit[i].customtext3= dg.dataProvider[Index].customtext3; 
						acEdit[i].customdbl1= dg.dataProvider[Index].customdbl1; 
						acEdit[i].customdbl2= dg.dataProvider[Index].customdbl2; 
						acEdit[i].customdbl3= dg.dataProvider[Index].customdbl3; 
						acEdit[i].customdate1= dg.dataProvider[Index].customdate1; 
						acEdit[i].customdate2= dg.dataProvider[Index].customdate2; 
						acEdit[i].customdate3= dg.dataProvider[Index].customdate3; 
						
						ada = true;
					}
					
					
				}
				if(ada == false){
					acEdit.addItem({chk: dg.dataProvider[Index].chk, 
						
						chk: dg.dataProvider[Index].chk,
						idpiedetail : dg.dataProvider[Index].idpiedetail, 
						idpie : dg.dataProvider[Index].idpie, 
						notransaksi : dg.dataProvider[Index].notransaksi,
						supplierkode : dg.dataProvider[Index].supplierkode,
						suppliernama : dg.dataProvider[Index].suppliernama,
						uraian : dg.dataProvider[Index].uraian,
						tgl : dg.dataProvider[Index].tgl,
						sumber : dg.dataProvider[Index].sumber, 
						idtransaksi : dg.dataProvider[Index].idtransaksi, 
						sumber: dg.dataProvider[Index].sumber, 
						termin: dg.dataProvider[Index].termin,
						catatan : dg.dataProvider[Index].catatan, 
						urutan : dg.dataProvider[Index].urutan, 
						isclose : dg.dataProvider[Index].isclose, 
						customtext1 : dg.dataProvider[Index].customtext1, 
						customtext2 : dg.dataProvider[Index].customtext2, 
						customtext3 : dg.dataProvider[Index].customtext3, 
						customdbl1 : dg.dataProvider[Index].customdbl1, 
						customdbl2 : dg.dataProvider[Index].customdbl2, 
						customdbl3 : dg.dataProvider[Index].customdbl3, 
						customdate1 : dg.dataProvider[Index].customdate1, 
						customdate2 : dg.dataProvider[Index].customdate2, 
						customdate3 : dg.dataProvider[Index].customdate3
					});
				}
			}
			
			protected function f_persiapan():void
			{
				tab.focusEnabled = false;
				FlexGlobals.topLevelApplication.F_tabvalidatenow(tab);
				FlexGlobals.topLevelApplication.F_RequiredLabel([ttanggal, tnotransaksi, tprogress]);
				FlexGlobals.topLevelApplication.F_TranslateLabel([tnogiro, ttanggaljt, turaian, ttanggal, tnotransaksi, tprogress, tcatatan, tnogiro0, tnoref, ttanggalnoref])
				UFungsional = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				
				//setting autoposting
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'AutoPosting')==1) chkposting.selected=true;
				else chkposting.selected = false;
				//setting editable tanggal
				if (FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'EditableDate')==1) dttgl.enabled=true;
				else dttgl.enabled = false;
				FlexGlobals.topLevelApplication.F_AutoNoTransaksi(txtnotransaksi, chkauto);
				
				arrMenuBar = new ArrayCollection([
					{label:"Simpan", icon:"tbsave", enabled:"true"},
					{label:"Buka Transaksi", icon:"tbbuka", enabled:"true"},
					{label:"Reset", icon:"tbreset", enabled:"true"},
					{label:"Tampilkan", icon:"tbpreview", enabled:"true"},
					{label:"Catatan", icon:"tbnote", enabled:"true"},
					{label:"File", icon:"tbattachment", enabled:"true"},
					{label:"Link", icon:"tblink", enabled:"false"},
					{label:"Bantuan", icon:"tbhelp", enabled:"true"}]);
				
				FlexGlobals.topLevelApplication.F_settingmb(mb, arrMenuBar);
				
				//				<s:XMLListCollection id="xmlListColl">
				//					<s:source>
				//						<fx:XMLList xmlns="">
				
				//						</fx:XMLList>
				//					</s:source>
				//				</s:XMLListCollection>
				//					
				FlexGlobals.topLevelApplication.F_TextInputNumberDesimalMode([txtkurs]);
				FlexGlobals.topLevelApplication.F_DateFieldStandard([dttgl, dttglnoref,dttglF,dttglF2]);
				FlexGlobals.topLevelApplication.F_ComboBoxStandard([cmbprogress]);
				FlexGlobals.topLevelApplication.F_txtPencarianKhusus([txtcatatan]);
				FlexGlobals.topLevelApplication.F_txtpencarian([txtmatauang, txtsumber, txtsupplier1, txtsupplier2]);
				FlexGlobals.topLevelApplication.F_SetNavigasiKeyboard([txturaian, txtnotransaksi,chkauto,chkposting, txtnotransaksi1, txtnotransaksi2, txtnoref]);
				
				
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbSimpan);
				mb.menuBarItems[1].addEventListener(MouseEvent.CLICK, f_mbBuka);
				mb.menuBarItems[2].addEventListener(MouseEvent.CLICK, f_mbReset);
				mb.menuBarItems[3].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				mb.menuBarItems[4].addEventListener(MouseEvent.CLICK, f_mbCatatan);
				mb.menuBarItems[5].addEventListener(MouseEvent.CLICK, f_mbUpload);
				mb.menuBarItems[6].addEventListener(MouseEvent.CLICK, f_mbLink);
				function f_mbSimpan():void{
					if(mb.menuBarItems[0].enabled){
						var jenissimpan:int = 1;
						if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
						if(FlexGlobals.topLevelApplication.apaBisaAkses(2,9,jenissimpan)){
							f_simpan();
						}
					}
				}
				function f_mbBuka():void{FlexGlobals.topLevelApplication.f_bukaTransaksi("Pie");}
				function f_mbReset():void{
					mb.menuBarItems[4].enabled = false;
					mb.menuBarItems[5].enabled = false;
					FlexGlobals.topLevelApplication.F_defaultGridItem(dg);
					f_kondisiAwal(); 
				}
				
				function f_mbTampilkan():void{
					f_wsTampil();
				}
				function f_mbCatatan():void{
					if(mb.menuBarItems[4].enabled){
						FlexGlobals.topLevelApplication.F_OpenNotes(o.piesumber,o.pieid,txtnotransaksi.text);
					}
				}
				function f_mbUpload():void {
					if(mb.menuBarItems[5].enabled){
						FlexGlobals.topLevelApplication.F_OpenUploadFile('PIE', o.pieid,txtnotransaksi.text);
					}
					
				}
				function f_mbLink():void {
					if(mb.menuBarItems[6].enabled)FlexGlobals.topLevelApplication.f_mbLinks(4,'Pie');
				}
				
				// Config Paging
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = "0";
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				function f_firstCLICK():void{
					txtpaging.text = String(1)
					f_wsTampil(1);
				}
				function f_previousCLICK():void{
					f_wsTampil(int(txtpaging.text) - 1);
					txtpaging.text = String(int(txtpaging.text) - 1)
				}
				function f_nextCLICK():void{
					f_wsTampil(int(txtpaging.text) + 1)
					txtpaging.text = String(int(txtpaging.text) + 1)
				}
				function f_lastCLICK():void{
					f_wsTampil(int(- 1))
					
				}
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_wsTampil(int(txtpaging.text));
				}
				
				dttglF2.addEventListener(FocusEvent.FOCUS_IN, function setdate():void{
					dttglF2.text = dttglF.text;
				});
				txtnotransaksi1.addEventListener(FocusEvent.FOCUS_IN, function setdate():void{
					txtnotransaksi2.text = txtnotransaksi1.text;
				});
				txtsupplier1.addEventListener(FocusEvent.FOCUS_IN, function setdate():void{
					txtsupplier2.text = txtsupplier1.text;
				});
				//change auto notransaksi
				chkauto.addEventListener(Event.CHANGE,f_change);
				function f_change ():void{
					if(FlexGlobals.topLevelApplication.FormFilter== ''){
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
							txtnotransaksi.text = 'Auto';
						}else{
							txtnotransaksi.enabled = true;
							txtnotransaksi.text = '';
							if(txtnotransaksi.enabled)txtnotransaksi.setFocus();
						}
					}else{
						if (chkauto.selected){
							txtnotransaksi.enabled =false;
						}else{
							txtnotransaksi.enabled =true;
							txtnotransaksi.setFocus();
						}
					}
					
				}
				
				chkposting.addEventListener(KeyboardEvent.KEY_DOWN,function keydown(event:KeyboardEvent):void{
					if(event.keyCode == Keyboard.ENTER){
						dg.setFocus();
						dg.setSelectedCell(0,0);
					}
				}
				);
				FlexGlobals.topLevelApplication.F_RegGrid(4,56,[dg],'transaksi');
				
				f_validasi();
			}
			public function f_validasi():void{
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M2_RgHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_PieGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}
					
				}
			}
			protected function f_kondisiAwal():void
			{
				mb.menuBarItems[0].enabled=true;
				mb.menuBarItems[4].enabled = false;
				mb.menuBarItems[5].enabled = false;
				mb.menuBarItems[6].enabled = false;
				mb.menuBarItems[7].visible = false;
				cmbprogress.enabled = true;
				cmbprogress.dataProvider = new ArrayCollection([{l:'Draft', v:0}, {l:'Approved', v:2}]);
				FlexGlobals.topLevelApplication.FormFilter = '';
				cmbprogress.selectedIndex = 1;
				txtnotransaksi.text = 'Auto';
				txtmatauang.text = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional');
				o.txtkurs = FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'Kurs')
				txtkurs.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtkurs);
				txtkurs.enabled = false;
				FlexGlobals.topLevelApplication.F_SetNilaiText([lbltotalvalas],FlexGlobals.topLevelApplication.m.nfNominal.format(0));
				isUpdate = false;
				txturaian.text = FlexGlobals.topLevelApplication.getNomor("PIE");
				txtcatatan.text = FlexGlobals.topLevelApplication.getNomor("PIE",1);
				parentApplication.F_SetNilaiText([dttgl, dttglnoref, dttglF, dttglF2], parentApplication.DefaultTanggal);
				FlexGlobals.topLevelApplication.F_KosongkanText([txtsumber, txtnotransaksi1, txtnotransaksi2, txtsupplier1, txtsupplier2]);
				
				
				o.pieid = 0; o.piecabang = FlexGlobals.topLevelApplication.ucabang; o.pielokasi = FlexGlobals.topLevelApplication.ulokasi; 
				o.piesumber = "PIE";
				o.piekodepa = 0; o.piekontak = FlexGlobals.topLevelApplication.ukontak; 
				o.piekontakperson = ""; o.pie1alamat1 = ""; 
				o.pie1alamat2 = ""; o.pie1alamat3 = ""; o.pie2alamat1 = ""; 
				o.pie2alamat2 = ""; o.pie2alamat3 = ""; 
				o.piestatussebelumnya = 0; o.piejmlrevisi = 0; o.piecetakanke = 0; 
				o.pieinputuser = FlexGlobals.topLevelApplication.userid; 
				o.pieinputtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.piemodifikasiuser = 0; o.piemodifikasitgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.pieposting = 0; o.piepostingtgl = FlexGlobals.topLevelApplication.DefaultTanggal; 
				o.pieisclose = 0; o.piecustomtext1 = ""; 
				o.piecustomtext2 = ""; o.piecustomtext3 = ""; o.piecustomtext4 = ""; 
				o.piecustomtext5 = ""; o.piecustomint1 = 0; o.piecustomint2 = 0; 
				o.piecustomint3 = 0; o.piecustomdbl1 = 0; o.piecustomdbl2 = 0; o.piecustomdbl3 = 0; 
				o.piecustomdate1 = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.piecustomdate2 = FlexGlobals.topLevelApplication.m.DateFirst; 
				o.piecustomdate3 = FlexGlobals.topLevelApplication.m.DateFirst;
				
				f_focusOnMe();
				
				FlexGlobals.topLevelApplication.FormFilter = "";
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
			}
			
			
			protected function f_wsTampil(page:int = 1, sort:String = 'tgl desc, notransaksi desc'):void
			{
				FlexGlobals.topLevelApplication.F_wsSearch("TakeData", "M4_PieTakedataSearch", page, 20, f_filterdata(), sort);
			}
			public function f_filterdata():String{
				var f:String="";
				var arrfiltersumber : Array;
				arrfiltersumber = FlexGlobals.topLevelApplication.getSetting(4,"tukarfaktur","FilterSumberTransaksi").split("|")
				
				for (var s:int = 0; s<arrfiltersumber.length; s++){
					if(s == 0){f = "sumber = '"+arrfiltersumber[s]+"'"}
					else{f += " OR sumber = '"+arrfiltersumber[s]+"'"}
				}
				
				f = "(("+f+") AND statuspie = 0)";
				
				if(dttglF.text.length > 0 && dttglF2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'tgl Between "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglF.text.split('"').join('\\"'))+'" and "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglF2.text.split('"').join('\\"'))+'"');
				}else if(dttglF.text.length > 0 && dttglF2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'tgl >= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglF.text.split('"').join('\\"'))+'"');
				}else if(dttglF.text.length <= 0 && dttglF2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'tgl <= "'+FlexGlobals.topLevelApplication.F_tglFormatDB(dttglF2.text.split('"').join('\\"'))+'"');
				}
				
				if(txtnotransaksi1.text.length > 0 && txtnotransaksi2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'notransaksi Between "'+txtnotransaksi1.text.split('"').join('\\"')+'" and "'+txtnotransaksi2.text.split('"').join('\\"')+'"');
				}else if(txtnotransaksi1.text.length > 0 && txtnotransaksi2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'notransaksi >= "'+txtnotransaksi1.text.split('"').join('\\"')+'"');
				}else if(txtnotransaksi1.text.length <= 0 && txtnotransaksi2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'notransaksi <= "'+txtnotransaksi2.text.split('"').join('\\"')+'"');
				}
				
				if(txtsupplier1.text.length > 0 && txtsupplier2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'supplierkode Between "'+txtsupplier1.text.split('"').join('\\"')+'" and "'+txtsupplier2.text.split('"').join('\\"')+'"');
				}else if(txtsupplier1.text.length > 0 && txtsupplier2.text.length <= 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'supplierkode >= "'+txtsupplier1.text.split('"').join('\\"')+'"');
				}else if(txtsupplier1.text.length <= 0 && txtsupplier2.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'supplierkode <= "'+txtsupplier2.text.split('"').join('\\"')+'"');
				}
				
				if(txtsumber.text.length > 0){
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'sumber = "'+txtsumber.text.split('"').join('\\"')+'"');
				}
				
//				for(i=0; i<dg.dataProviderLength; i++){ 
//					if(dg.dataProvider[i].chk == 1){
//						f = FlexGlobals.topLevelApplication.TambahFilter(f,'glnogiro <>"'+dg.dataProvider.getItemAt(i).nogiro.split('"').join('\\"')+'"'); 
//					}
//					
//				}
				
				return f;
				
			}
			
			protected function f_keyDownModule(e:KeyboardEvent):void
			{				
				switch(e.keyCode){
					case Keyboard.S:
						if(e.ctrlKey)
							if(mb.menuBarItems[0].enabled){
								var jenissimpan:int = 1;
								if(isUpdate == false){jenissimpan = 1}else{jenissimpan = 2}
