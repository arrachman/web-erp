					function msgAlert(focus: Object, inggris: String, indonesia: String):void
					{		
						if(validasi)focus.setFocus();
						pesanAlertIng += inggris+', ';
						pesanAlert += indonesia+', ';
						if(focus == 'clear'){
							pesanAlert = pesanAlert.substr(0, pesanAlert.length-4);
							pesanAlert += " harus diisi dengan benar";
							
							pesanAlertIng = pesanAlertIng.substr(0, pesanAlertIng.length-4);
							pesanAlertIng += " must be filled";
							Alert.show(pesanAlert+" !" , "Information");}	
						//return myalert;
						//\n
						validasi = false;						
					}
					
					//					if(ac2.length <= 0){
					//						ac2.addItem({No:0, noakun:'', idrgdetail:0, idrg:0, nogiro:'',matauang:txtmatauang.text, kurs:o.txtkurs, jumlah:0,jumlahvalas:0,catatan:'',  statusrgc:0, isclose:0, customtext1:'', customtext2:'', customtext3:'', customdbl1:0, customdbl2:0,
					//							customdbl3:0,customdate1:FlexGlobals.topLevelApplication.m.DateFirst,customdate2:FlexGlobals.topLevelApplication.m.DateFirst,customdate3:FlexGlobals.topLevelApplication.m.DateFirst,rekgiro:'',statusgiro:0, noacbank:'',
					//							tgljt:FlexGlobals.topLevelApplication.m.DateFirst, kontakid:0, bank:''});
					//					}
				}
				
				
			}
			public function f_hitungTotal():void
			{
				o.rgjumlah = 0; o.rgjumlahvalas=0;
				for(i=0;i<dg.dataProviderLength;i++){
					if(dg.dataProvider.getItemAt(i).chk==1){
						o.rgjumlah += Number(dg.dataProvider.getItemAt(i).jumlah);
						o.rgjumlahvalas += Number(dg.dataProvider.getItemAt(i).jumlahvalas);
					}
				}
				lbltotalvalas.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.rgjumlahvalas);
			}
			
