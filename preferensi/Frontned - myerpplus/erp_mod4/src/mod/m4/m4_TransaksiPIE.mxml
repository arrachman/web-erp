			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					case "txtsumber":
						paket = "CdM0_Nomor";
						var fsumber :String = "";
						var arrfiltersumber : Array;
						arrfiltersumber = FlexGlobals.topLevelApplication.getSetting(4,"tukarfaktur","FilterSumberTransaksi").split("|")
						
						for (var s:int = 0; s<arrfiltersumber.length; s++){
							if(s == 0){fsumber = "kodetabel = '"+arrfiltersumber[s]+"'"}
							else{fsumber += "OR kodetabel = '"+arrfiltersumber[s]+"'"}
						}
						fsumber = "("+fsumber+")";
						
						wsfilter = fsumber+' and kodetabel ="'+txtsumber.text+'"';
						csfilter = fsumber;
						csfield = 2;
						sort = 'kodetabel asc';
						break;
					
					case "txtsupplier1":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif=1 AND kkategori = "S" AND kkode = "'+txtsupplier1.text+'"';
						csfilter = 'kaktif=1 AND kkategori = "S"';
						sort = 'kkode asc';
						break
					case "txtsupplier2":
						paket = 'CdM1_Contact';
						wsfilter = 'kaktif=1 AND kkategori = "S" AND kkode = "'+txtsupplier2.text+'"';
						csfilter = 'kaktif=1 AND kkategori = "S"';
						sort = 'kkode asc';
						break
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
