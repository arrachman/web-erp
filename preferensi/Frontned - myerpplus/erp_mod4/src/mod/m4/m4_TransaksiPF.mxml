								pf2alamat3, pfbagianpembelian, FlexGlobals.topLevelApplication.F_tglFormatDB(pftgldipenuhi), txttermin.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttgljt.text), txturaian.text, txtcatatan.text, 
								txtnoref.text, FlexGlobals.topLevelApplication.F_tglFormatDB(dttglnoref.text), FlexGlobals.topLevelApplication.F_tglFormatDB(pftglpenutupan), txtmatauang.text, o.txtkurs, int(chkhargapajak.selected), pftotal, 
