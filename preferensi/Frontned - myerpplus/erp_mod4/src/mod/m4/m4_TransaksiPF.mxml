			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit : Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi :String = filtersplit[0];
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 4, "PF");
				if(FlexGlobals.topLevelApplication.FormFilter == ''){
					f_kondisiAwal();
				}else{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_PfHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
					}else {
						if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
							FlexGlobals.topLevelApplication.m.ArrFilter[0]
							if(FlexGlobals.topLevelApplication.FormFilter == 'statistik'){
								idtransaksi = parentApplication.m.ArrFilter[0];
								idtransaksi = idtransaksi.replace('p1  = "', '');
								idtransaksi = idtransaksi.replace('"', '');
								FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_PfGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							}else{
								if(FlexGlobals.topLevelApplication.m.ArrFilter == "copyTransaksi"){
									FlexGlobals.topLevelApplication.F_wsGetDataById('copyTransaksi', 'M4_PfGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
								}else{
									f_kondisiAwal();
									FlexGlobals.topLevelApplication.F_wsGetDataById('tampilRQ', 'M4_RqGetdataById',FlexGlobals.topLevelApplication.m.ArrFilter[0], 0, 0, FlexGlobals.topLevelApplication.m.ArrFilter[1], 'urutan ASC', FlexGlobals.topLevelApplication.m.formatDate, FlexGlobals.topLevelApplication.m.formatDate);
								}
							}
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById('tampil', 'M4_PfGetdataById', idtransaksi, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
							mb.menuBarItems[4].enabled =true;
							mb.menuBarItems[6].enabled =true;
						}
					}
				}
				ttotalbiaya.text = "Total Biaya ["+FlexGlobals.topLevelApplication.getSetting(0, 'accounting', 'MataUangFungsional')+"]"
				//end ofset getdata by id===============================================================================================
			}
			protected function f_kondisiAwal():void
			{
				CloseItem = false;
				btnCloseItem.enabled = false;
				txtlokasi.text = FlexGlobals.topLevelApplication.ulokasi;
				lbllokasi.text = FlexGlobals.topLevelApplication.ulokasinama;
				o.pflokasi=FlexGlobals.topLevelApplication.ulokasi;
				o.txtdiskonnominal = 0;
				o.txtbiayalainnominal = 0;
				o.txtdiskonpersen = 0;
				o.txtbiayalainpersen = 0;
				o.totalbiaya = 0;
				o.txtdp = 0;
				txtdp.text = FlexGlobals.topLevelApplication.m.nfNominal.format(o.txtdp);
				mb.menuBarItems[0].enabled = true;
				mb.menuBarItems[6].enabled = false;
//				mb.menuBarItems[7].enabled = false;
//				mb.menuBarItems[8].enabled = false;
//				mb.menuBarItems[9].visible = false;
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 4, "PF");
				
