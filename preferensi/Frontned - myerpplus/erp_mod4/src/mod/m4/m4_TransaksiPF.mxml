								pfjmlbayar, pfrekdiskon, pfrekpajak1, pfrekpajak2, pfrekbiayalain, pfrekbayar, pfidpr, 
								pfidcs, pfidrq, pfidbs, pfstatusipc, pfstatusgrn, pfstatusri, pfstatusdnr, 
								pfstatusprt, statusprogress, pfstatussebelumnya, pfjmlrevisi, pfcetakanke, pfinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(pfinputtgl), 
								pfmodifikasiuser, FlexGlobals.topLevelApplication.F_tglFormatDB(pfmodifikasitgl), pfisclose, txtbank.text, txtakun.text, pfcustomtext3, pfcustomtext4, 
								pfcustomtext5, pfcustomint1, pfcustomint2, pfcustomint3, o.txtdp, pfcustomdbl2, pfcustomdbl3, 
								FlexGlobals.topLevelApplication.F_tglFormatDB(pfcustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(pfcustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(pfcustomdate3)];
							utama = f_splitArrayToString(a);
						}
						
						//Set Detail
						for(i=0;i<dg.dataProviderLength;i++){
							with(dg.dataProvider.getItemAt(i)){
								a = [idpfdetail, idpf, idbarang, namabarang, tipebarang, jml, satuan, 
									nilaisatuan, jmlbarang, satuanbarang, matauang, o.txtkurs, Number(hargafix), harga, 
									diskon, jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, 
									lokasi, gudang, costcenter, divisi, subdivisi, proyek, catatan, 
									(i+1), idprdetail, idcsdetail, idrqdetail, idbsdetail, jmlipc, statusipc, 
									jmlgrn, statusgrn, jmlri, statusri, jmldnr, statusdnr, jmlprt, 
									statusprt, isclose, customtext1, customtext2, customtext3, 0, 
									customdbl2, customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
									FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
								if(i == 0)detail =f_splitArrayToString(a);
								else detail += "▲"+f_splitArrayToString(a);
							}
						}
						
						// Set Cost
						for(var ib:int=0;ib<dgbiaya.dataProviderLength;ib++){
							with(dgbiaya.dataProvider.getItemAt(ib)){
								if(dgbiaya.dataProvider.getItemAt(ib).idpfcost != undefined){
									a = [idpfcost, idpf, kodecost, matauang, kurs, jumlah, rekdebit, 
										rekkredit, kontak, termasukhpp, catatan, costcenter, divisi, subdivisi, 
										proyek, ib+1, idprcost, idcscost, idrqcost, idbscost, jumlahipc, 
										statusipc, jumlahgrn, statusgrn, jumlahri, statusri, jumlahbayar, statusbayar, 
										isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(ib == 0)cost = f_splitArrayToString(a);
									else cost += "▲"+f_splitArrayToString(a);
								}
								
							}
						}
						
						//Set Transaksi
						for(i=0;i<dg_transaksi.dataProviderLength;i++)
							with(dg_transaksi.dataProvider.getItemAt(i))
							{
								if(hasOwnProperty("idtransaksi"))
								{ 
									a = [idpftrans, idpf, sumber, idtransaksi, catatan, urutan, isclose, 
										customtext1, customtext2, customtext3, customtext4, customtext5, customdbl1, customdbl2, 
										customdbl3, customdbl4, customdbl5, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate4), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate5)];
									if(i <= 0)
									{ 
										trans = FlexGlobals.topLevelApplication.F_splitArrayToString(a);
									}
									else trans += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(a);
								} 
							}
						
						FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M4_PfSimpan", parentApplication.userid, isUpdate, utama, detail+"△"+cost+"△"+trans);
						
					}
				}
				
