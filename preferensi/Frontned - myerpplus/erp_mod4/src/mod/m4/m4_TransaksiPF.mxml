			protected function btnCloseItem_clickHandler(event:MouseEvent):void
			{
				o.tanggal = dttgl.text;
				var a:Array, detail:String;
				if(mb.menuBarItems[0].enabled ==false){
						//Set Detail
					for(i=0;i<dg.dataProviderLength;i++){
						with(dg.dataProvider.getItemAt(i)){
							a = [idpfdetail, 
								customdbl2];
							if(i == 0)detail =f_splitArrayToString(a);
							else detail += "▲"+f_splitArrayToString(a);
						}
					}
					
					FlexGlobals.topLevelApplication.F_wsSimpan("CloseItem", "M4_PfCloseItem", parentApplication.userid, isUpdate, detail);
					
				}
				
				function f_splitArrayToString(a:Array):String
				{
					var s:String, j:int;
					for(j=0;j<a.length;j++){
						if(j==0)s = a[j];
						else s += "▼"+a[j];
					}
					return s;
				}
			}
			
