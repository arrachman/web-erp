			}
			
			
			protected function f_simpan():void
			{
				o.tanggal = dttgl.text;
				var statusprogress:int = cmbprogress.dataProvider.getItemAt(cmbprogress.selectedIndex).v, a:Array, utama:String, detail:String, cost:String = "", trans:String = "", tgl:String;
				parentApplication.vpFocusEvent = true;
				if(mb.menuBarItems[0].enabled ==true || CloseItem == true){
					tgl = FlexGlobals.topLevelApplication.DefaultTanggalforDB;
					validasiForm();
					if (CloseItem ==true){
						statusprogress = o.pfstatus
					}else{
						statusprogress =  cmbprogress.selectedItem.v
					}
					if(validasi){
						if(o.txtdp == null)
						{
							o.txtdp = 0;
						}
//						Alert.show(cmbprogress.selectedItem.v);
						//Set Utama
						with(o){
							a = [pfid, pfcabang, txtlokasi.text, txtgudang.text, pfasalbarang, 0, pfjenispembelian, 
								pfjenispembeliankategori, 0, pfsumber, int(chkauto.selected), txtnotransaksi.text, 
