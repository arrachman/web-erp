			//Import Data From Excel
			private function f_browseFile():void
			{
				var arr:Array = [];
				arr.push(new FileFilter("Excel File","*.xls"));
				fileReference.browse(arr);
			}
			private function fileReference_select(evt:Event):void {
				fileReference.load();
			}
			
			private function fileReference_complete(evt:Event):void {
				
				var excelFile:ExcelFile = new ExcelFile();
				excelFile.loadFromByteArray(fileReference.data);
				var sheet : Sheet = excelFile.sheets[0];
				F_SetDataExcel()
			}
			public var filterbarang:String = "", filtersatuan:String = "";
			public function F_SetDataExcel():void{
				//Ambil Byte Array file excel yang terpilih
				var excelFile:ExcelFile = new ExcelFile();
				excelFile.loadFromByteArray(fileReference.data);
				//ambil sheet pertama
				var sheet : Sheet = excelFile.sheets[0];
				//variabel jumlah baris dan jumlah kolom
				var noOfRows:int = 0, noOfColumns:int = 0;
				noOfRows = sheet.rows; //jumlah data
				noOfColumns = sheet.cols; //jumlah kolom
				
				//var nama kolom, datafield, untuk penamaan dan datafield kolom
				var namakolom:String = "";
				var datafield:String = "";
				
				
				
				//var nama kolom, datafield, untuk penamaan dan datafield kolom
				
				
				dg.dataProvider.removeAll();
				for(var row:int = 1; row<=noOfRows; row++){
					if(sheet.getCell(row,1).value != ""){
						dg.dataProvider.addItem({
							no : row,
							kodebarang : sheet.getCell(row,1).value,
							namabarang : sheet.getCell(row,2).value,
							jml : sheet.getCell(row,3).value,
							satuan : sheet.getCell(row,4).value,
							harga : sheet.getCell(row,5).value,
							diskon : sheet.getCell(row,6).value,
							jmldiskon : sheet.getCell(row,7).value,
							catatan : sheet.getCell(row,8).value
//							subtotal : Number(sheet.getCell(row,3).value) * Number(sheet.getCell(row,5).value)
							
						});
						
						if(row == 1){
							filterbarang = "'"+sheet.getCell(row,1).value+"'";
							filtersatuan = "'"+sheet.getCell(row,4).value+"'";
						}else{
							filterbarang += ", '"+sheet.getCell(row,1).value+"'";
							filtersatuan += ",'"+sheet.getCell(row,4).value+"'";
						}
					}
//					if(dg.dataProvider[row-1].jml == "" || dg.dataProvider[row-1].jml == undefined){dg.dataProvider[row-1].jml = 0}
//					if(dg.dataProvider[row-1].harga == "" || dg.dataProvider[row-1].harga == undefined){dg.dataProvider[row-1].harga = 0}
//					if(dg.dataProvider[row-1].diskon == "" || dg.dataProvider[row-1].diskon == undefined){dg.dataProvider[row-1].diskon = 0}
//					if(dg.dataProvider[row-1].jmldiskon == "" || dg.dataProvider[row-1].jmldiskon == undefined){dg.dataProvider[row-1].jmldiskon = 0}
//					if(row == 1){
//						filterbarang = "bkode = '"+sheet.getCell(row,1).value+"'"
//					}else{
//						filterbarang += " OR bkode = '"+sheet.getCell(row,1).value+"'"
//					}
					
					
				}
				if(dg.dataProviderLength > 0){
					FlexGlobals.topLevelApplication.F_wsSearch("AmbilIDBarang", "CdM1_Item", 0, 0, "bkode in ("+filterbarang+")", "", "bkode asc");
				}else{
					Alert.show("kode barang di excel harus diisi terlebih dahulu, dan ulangi import", "Informasi");
				}
				
			}
