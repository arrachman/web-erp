			public function f_validasi():void{
				//set getdata by id===============================================================================================
				var filtersplit:Array = FlexGlobals.topLevelApplication.FormFilter.split("[]");
				var idtransaksi:String = filtersplit[0];
				settingNotransaksi.F_KondisiAwalNoTransaksi(txtnotransaksi, chkauto);
				o.DefaultProgress = parentApplication.setProgress(cmbprogress, 4, "PR");
				if(FlexGlobals.topLevelApplication.FormFilter == '')
				{
					f_kondisiAwal();
				}
				else
				{
					if(filtersplit.length > 1){
						FlexGlobals.topLevelApplication.F_wsGetDataById('tampilHistory', 'M4_PrHistoryGetdataById', idtransaksi, 0, 0, '', 'urutan ASC');
					}else {
						if(FlexGlobals.topLevelApplication.m.ArrFilter != null){
							FlexGlobals.topLevelApplication.F_wsGetDataById('copyTransaksi', 'M4_PrGetdataById', idtransaksi, 0, 0, '', 'urutan ASC');
						}else{
							FlexGlobals.topLevelApplication.F_wsGetDataById("tampil", 'M4_PrGetdataById', idtransaksi, 0, 0, '', 'urutan ASC');
						}
					}
				}
				//end ofset getdata by id===============================================================================================
			}
			
