					switch(s){	
						case "txtterimadari1":
							txtterimadari1.text = ws.kkode;
							idkontak = ws.kid;
							break;
						case "txtlokasi":
							txtlokasi.text = ws.lkode;
							break;
						case "txtcabang":
							txtcabang.text = ws.bkode;
							break;
						case "txtuser":
							txtuser.text = ws.ukode;
							iduser = ws.userid;
							break;
						case "txtuang":
							txtuang.text = ws.ckode;
							break;
						case "tampilGiro":
							for(i = dg.dataProviderLength - 1; i>=0; i--){
								if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
									dg.dataProvider.removeItemAt(i);
								}
							}
							dg.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
							break;
						
						case "M4_PoGetdataById":
							var adt:Array, poutama:String, podetail:String = '', pocost:String = '', potrans:String = ''
							var ws_cost:ArrayCollection = new ArrayCollection();
							var ws_trans:ArrayCollection = new ArrayCollection();
							
							//Utama
							with(FlexGlobals.topLevelApplication.wsArrUtama.getItemAt(0))
							{
								adt = [poid, pocabang, polokasi, pogudang, poasalbarang, poasalbarangkategori, pojenispembelian, 
									pojenispembeliankategori, pocarabayar, posumber, poautonotransaksi, ponotransaksi, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(potgl), pokodepa, 
									posupplier, posupplierkontak, po1alamat1, po1alamat2, po1alamat3, po2alamat1, po2alamat2, 
									po2alamat3, pobagianpembelian, FlexGlobals.topLevelApplication.F_tglFormatDB(potgldipenuhi), potermin, FlexGlobals.topLevelApplication.F_tglFormatDB(potgljatuhtempo), pouraian, pocatatan, 
									ponoref, FlexGlobals.topLevelApplication.F_tglFormatDB(potglnoref), FlexGlobals.topLevelApplication.F_tglFormatDB(potglpenutupan), pomatauang, pokurs, pohargatermasukpajak, pototal, 
									podiskonpersen, pojmldiskon, pototalpajak1detail, pototalpajak2detail, pobiayalainpersen, pobiayalain, pototaltransaksi, 
									pojmlbayar, porekdiskon, porekpajak1, porekpajak2, porekbiayalain, porekbayar, poidpr, 
									poidcs, poidrq, poidbs, postatusipc, postatusgrn, postatusri, postatusdnr, 
									postatusprt, 2, postatussebelumnya, pojmlrevisi, pocetakanke, poinputuser, FlexGlobals.topLevelApplication.F_tglFormatDB(poinputtgl), 
									FlexGlobals.topLevelApplication.userid, FlexGlobals.topLevelApplication.F_tglFormatDB(FlexGlobals.topLevelApplication.DefaultTanggal), poisclose, pocustomtext1, pocustomtext2, pocustomtext3, pocustomtext4, 
									pocustomtext5, pocustomint1, pocustomint2, pocustomint3, pocustomdbl1, pocustomdbl2, pocustomdbl3, 
									FlexGlobals.topLevelApplication.F_tglFormatDB(pocustomdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(pocustomdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(pocustomdate3)];
								poutama = FlexGlobals.topLevelApplication.F_splitArrayToString(adt);
							}
							
							//Detail						
							for(var i:int = 0; i < FlexGlobals.topLevelApplication.wsArrDetail.length; i++){
								with(FlexGlobals.topLevelApplication.wsArrDetail[i]){
									adt = [idpodetail, idpo, idbarang, namabarang, tipebarang, jml, satuan, 
										nilaisatuan, jmlbarang, satuanbarang, matauang, kurs, Number(hargafix), harga, 
										diskon, jmldiskon, pajak1, jmlpajak1, pajak2, jmlpajak2, cabang, 
										lokasi, gudang, costcenter, divisi, subdivisi, proyek, catatan, 
										urutan, idprdetail, idcsdetail, idrqdetail, idbsdetail, jmlipc, statusipc, 
										jmlgrn, statusgrn, jmlri, statusri, jmldnr, statusdnr, jmlprt, 
										statusprt, isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, 
										customdbl3, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(i == 0)podetail =FlexGlobals.topLevelApplication.F_splitArrayToString(adt);
									else podetail += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(adt);
								}								
							}
							
							//Cost
							ws_cost = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[2], FlexGlobals.topLevelApplication.vData[2]);
							for(var ib:int = 0; ib < ws_cost.length; ib++){
								with(ws_cost[ib]){
									adt = [idpocost, idpo, kodecost, matauang, kurs, jumlah, rekdebit, 
										rekkredit, kontak, termasukhpp, catatan, costcenter, divisi, subdivisi, 
										proyek, urutan, idprcost, idcscost, idrqcost, idbscost, jumlahipc, 
										statusipc, jumlahgrn, statusgrn, jumlahri, statusri, jumlahbayar, statusbayar, 
										isclose, customtext1, customtext2, customtext3, customdbl1, customdbl2, customdbl3, 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3)];
									if(ib == 0)pocost =FlexGlobals.topLevelApplication.F_splitArrayToString(adt);
									else pocost += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(adt);
								}								
							}
							
							//Trans
							ws_trans = FlexGlobals.topLevelApplication.f_SplitData(FlexGlobals.topLevelApplication.vNamaKolom[3], FlexGlobals.topLevelApplication.vData[3]);
							for(var it:int = 0; it < ws_trans.length; it++){
								with(ws_trans[it]){
									adt = [idpotrans, idpo, sumber, idtransaksi, catatan, urutan, isclose, 
