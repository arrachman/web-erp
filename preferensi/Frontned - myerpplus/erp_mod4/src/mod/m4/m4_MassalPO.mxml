			//SET ARRAY PO
			protected function f_SetArraySimpanPO():void
			{
				var dgmap:Object, dgimp:Object;
				var validasifield : Boolean;
				var namakolom : String = "";
				
				acSimpan.removeAll();
				for(var i:int = 0; i < dg.dataProviderLength; i++)
				{
					dgimp = dg.dataProvider[i];
					
					// JIKA DATA DICENTANG
					if(dgimp.chk == 1)
					{
						f_setDatatoArraySimpan(i, dgimp.poid)
						validasifield = true;
						
					}
				}
				
				function f_setDatatoArraySimpan(row:int, data:String):void
				{
					dgimp = dg.dataProvider[row];
					acSimpan.addItem({
						poid : dgimp.poid,
						ponotransaksi : dgimp.ponotransaksi
					});
				}
				
				if(acSimpan.length > 0)
				{
					if(validasifield) // JIKA DI MAPPING FIELD SUDAH DIISI KOLOM SUMBERNYA, DAN DI ARRAY SIMPAN SUDAH OK
					{ 
						f_ImportPO1();
					}
					else if(!validasifield) // JIKA DI MAPPING FIELD ADA YANG BELUM DIISI KOLOM SUMBERNYA
					{
						Alert.show("Mapping Field '"+namakolom +"' harus diisi dengan benar", "Informasi");
					}
				}
				else
				{
					Alert.show("Data harus dipilih terlebih dahulu", "Informasi");
				}
			}
			
			public function f_ImportPO1():void
			{
				grppopup.visible = true;
				jmlProgress = acSimpan.length; 
				f_sendProgress('PO notransaksi : '+acSimpan[index].ponotransaksi, true);
				FlexGlobals.topLevelApplication.F_wsGetDataById('M4_PoGetdataById', 'M4_PoGetdataById', acSimpan[index].poid, 0, 0, '', 'urutan ASC', FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
				
			}
			
			//SET ARRAY DRAFT PO
			protected function f_SetArrayDraftPO():void
			{
				var dgmap:Object, dgimp:Object;
				var validasifield : Boolean;
				var namakolom : String = "";
				
				acSimpan.removeAll();
				for(var i:int = 0; i < dg.dataProviderLength; i++)
				{
					dgimp = dg.dataProvider[i];
					
					// JIKA DATA DICENTANG
					if(dgimp.chk == 1)
					{
						f_setDatatoArraySimpan(i, dgimp.poid)
						validasifield = true;
						
					}
				}
				
				function f_setDatatoArraySimpan(row:int, data:String):void
				{
					dgimp = dg.dataProvider[row];
					acSimpan.addItem({
						poid : dgimp.poid,
						ponotransaksi : dgimp.ponotransaksi
					});
				}
				
				if(acSimpan.length > 0)
				{
					if(validasifield) // JIKA DI MAPPING FIELD SUDAH DIISI KOLOM SUMBERNYA, DAN DI ARRAY SIMPAN SUDAH OK
					{ 
						f_DraftPO1();
					}
					else if(!validasifield) // JIKA DI MAPPING FIELD ADA YANG BELUM DIISI KOLOM SUMBERNYA
					{
						Alert.show("Mapping Field '"+namakolom +"' harus diisi dengan benar", "Informasi");
					}
				}
				else
				{
					Alert.show("Data harus dipilih terlebih dahulu", "Informasi");
				}
			}
			
			public function f_DraftPO1():void
			{
				grppopup.visible = true;
				jmlProgress = acSimpan.length; 
				f_sendProgress('PO notransaksi : '+acSimpan[index].ponotransaksi, true);
				FlexGlobals.topLevelApplication.F_wsSimpan('draftpo', 'M4_PoUpdateStatus', FlexGlobals.topLevelApplication.userid, false, acSimpan[index].poid,0,0,0,"poid = " + acSimpan[index].poid,"", FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'), FlexGlobals.topLevelApplication.getSetting(0, 'company', 'FormatTanggalWS'));
				
			}
			
			public function f_sendProgress(data:String, status:Boolean):void
			{
				j++;
				if(status)
				{
					if(j > jmlProgress)
					{
						close = true;
						return;
					}
					lblProses.text = data;
				}
				else
				{
					lblProses.text = parentApplication.l("Upload failed")+" "+data;
					close = true;
					return;
				}
				num += 100/jmlProgress;
				pb.setProgress(num, 100);
				lblPersen.text = String(uint(num))+" %";
			}
			
			public function f_UlangImport():void
			{
				if(index < jmlProgress - 1)
				{
					index ++;
					f_ImportPO1();
				}
				else
				{
					index = 0;
					jmlProgress = 0;
					f_sendProgress('Import Data Done', true);
					lblProses.text = "Import Data Done";
					lblPersen.text = "100 %";
					//					f_writeExcel();
					if(gagal>0)
					{
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal \n Apakah anda ingin download data yang gagal?", "Informasi", 3, null, function (e:Object):void
						{
							if(e.detail == Alert.YES)
							{
								f_writeExcel();
							}
							f_kondisiAwal();
						});
					}
					else
					{
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal.", "Informasi", 4, null, function ():void
						{
							f_kondisiAwal();
						});
					}
				}
			}
			
			public function f_UlangDraftPO():void
			{
				if(index < jmlProgress - 1)
				{
					index ++;
					f_DraftPO1();
				}
				else
				{
					index = 0;
					jmlProgress = 0;
					f_sendProgress('Import Data Done', true);
					lblProses.text = "Import Data Done";
					lblPersen.text = "100 %";
					//					f_writeExcel();
					if(gagal>0)
					{
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal \n Apakah anda ingin download data yang gagal?", "Informasi", 3, null, function (e:Object):void
						{
							if(e.detail == Alert.YES)
							{
								f_writeExcel();
							}
							f_kondisiAwal();
						});
					}
					else
					{
						Alert.show("Import Data Selesai: \n "+berhasil+" berhasil \n "+gagal+" gagal.", "Informasi", 4, null, function ():void
						{
							f_kondisiAwal();
						});
					}
				}
			}
			
			public var jmlfile : int = 0;
			public function f_writeExcel():void
			{
				var excelFile:ExcelFile = new ExcelFile();
				//ambil sheet pertama
				var sheet : Sheet = new Sheet;
				var arrKode : Array = kodegagalimport.split("^|^"); 
				var arrDesk : Array = deskripsi.split("^|^");
				var fr:FileReference = new FileReference;
				for(var a:int = 0; a<acSimpan.length; a++){
					if(acSimpan[a].gagal == 1){
						acImportGagal.addItem({kode:acSimpan[a].ponotransaksi, deskripsi:acSimpan[a].deskripsi})					}
				}
				
				for(var i:int = 0; i<acImportGagal.length; i++){
					sheet.setCell(0, 0, "PO notransaksi");
					sheet.setCell(0, 1, "Deskripsi");
					sheet.setCell(i+1,0,acImportGagal[i].kode);
					sheet.setCell(i+1,1,acImportGagal[i].deskripsi);

					excelFile.sheets.addItem(sheet);
				}
				FlexGlobals.topLevelApplication.F_wsUpload('Uploading', 'UploadFile', FlexGlobals.topLevelApplication.userid, "CR", "xls", excelFile.saveToByteArray(), 0, "Data Gagal Import.xls", "", "0", FlexGlobals.topLevelApplication.DefaultTanggalforDB, 0, 0, '', '');
			}
			
