										customdbl3, customdbl4, customdbl5, FlexGlobals.topLevelApplication.F_tglFormatDB(customdate1), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate2), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate3), FlexGlobals.topLevelApplication.F_tglFormatDB(customdate4), 
										FlexGlobals.topLevelApplication.F_tglFormatDB(customdate5)];
									if(it == 0)potrans =FlexGlobals.topLevelApplication.F_splitArrayToString(adt);
									else potrans += "▲"+FlexGlobals.topLevelApplication.F_splitArrayToString(adt);
								}								
							}
							
							
							FlexGlobals.topLevelApplication.F_wsSimpan("simpan", "M4_PoSimpan", FlexGlobals.topLevelApplication.userid, true, poutama, podetail+"△"+pocost+"△"+potrans);
							break;
						
						case "Uploading":
							f_kondisiAwal();
							FlexGlobals.topLevelApplication.F_wsSearch('tampilFile', 'M2_FilesSearch', 1, 1, 'fsumber = "CR" AND fidtransaksi = "0"', 'finputtgl desc');
							break;
						case "tampilFile":
							navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f2/CR/"+FlexGlobals.topLevelApplication.wsArrUtama[0].fnamafile));
							break
						
						case "simpan":
							berhasil ++;
							f_UlangImport();
							break;
						case "draftpo":
							berhasil ++;
							f_UlangDraftPO();
							break;
					}
				}else{					
					if(parentApplication.F_validasiFalse(s)){
						switch(s){
							case "tampilGiro":
								for(i=dg.dataProviderLength-1;i>=0;i--){
									if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
										dg.dataProvider.removeItemAt(i);
									}
								}
								break;
							case "M4_PoGetdataById":
								gagal ++;
								acSimpan[index].gagal = 1;
								acSimpan[index].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangImport();
								if(FlexGlobals.topLevelApplication.wsErrmessage == "Invalid Website Access Key.")
								{
									btnlanjut.enabled = true;
								}
								break;
							case "simpan":
								gagal ++;
								acSimpan[index].gagal = 1;
								acSimpan[index].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangImport();
								if(FlexGlobals.topLevelApplication.wsErrmessage == "Invalid Website Access Key.")
								{
									btnlanjut.enabled = true;
								}
								break;	
							case "draftpo":
								gagal ++;
								acSimpan[index].gagal = 1;
								acSimpan[index].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangDraftPO()();
								if(FlexGlobals.topLevelApplication.wsErrmessage == "Invalid Website Access Key.")
								{
									btnlanjut.enabled = true;
								}
								break;	
							case "Uploading":
								Alert.show(FlexGlobals.topLevelApplication.wsErrmessage);
								navigateToURL(new URLRequest(FlexGlobals.topLevelApplication.m.url+"/files/f2/CR/Data Gagal Import_"+jmlfile+".xls"));
								break;}
					}else{
						switch (FlexGlobals.topLevelApplication.subject){
							case "M4_PoGetdataById":
								gagal ++;
								acSimpan[index].gagal = 1;
								acSimpan[index].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangImport();
								if(FlexGlobals.topLevelApplication.wsErrmessage == "Invalid Website Access Key.")
								{
									btnlanjut.enabled = true;
								}
								break;
							case "draftpo":
								gagal ++;
								acSimpan[index].gagal = 1;
								acSimpan[index].deskripsi = FlexGlobals.topLevelApplication.wsErrmessage;
								f_UlangDraftPO()();
								if(FlexGlobals.topLevelApplication.wsErrmessage == "Invalid Website Access Key.")
								{
									btnlanjut.enabled = true;
								}
								break;	
						}
					}
						
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					case "tampilGiro":
						for(i=dg.dataProviderLength-1;i>=0;i--){
							if(dg.dataProvider[i].chk == 0 || dg.dataProvider[i].chk == false){
								dg.dataProvider.removeItemAt(i);
							}
						}
						
						break;
					case "txtterimadari1":FlexGlobals.topLevelApplication.F_KosongkanText([txtterimadari1]);break;
					case "txtlokasi":FlexGlobals.topLevelApplication.F_KosongkanText([txtlokasi]);break;
					case "txtcabang":FlexGlobals.topLevelApplication.F_KosongkanText([txtcabang]);break;
					case "txtuser":FlexGlobals.topLevelApplication.F_KosongkanText([txtuser]);break;
					case "txtuang":FlexGlobals.topLevelApplication.F_KosongkanText([txtuang]);break;
				}
			}
			
			public function centang():void{
				ac2.removeAll();
				for (var i:int = 0; i < dg.dataProviderLength; i++) 
					if(dg.dataProvider[i].noakun.length > 0){
						if(dg.dataProvider.getItemAt(i).chk==1){
							with(dg.dataProvider.getItemAt(i))
								ac2.addItem({No:i+1, noakun:noakun, idrgdetail:idrgdetail, idrg:idrg, nogiro:nogiro,matauang:matauang,kurs:kurs, jumlah:jumlah,jumlahvalas:jumlahvalas,catatan:catatan,  statusrgc:statusrgc, isclose:isclose, customtext1:customtext1, customtext2:customtext2, customtext3:customtext3, customdbl1:customdbl1, customdbl2:customdbl2,
									customdbl3:customdbl3,customdate1:customdate1,customdate2:customdate2,customdate3:customdate3,rekgiro:rekgiro,statusgiro:statusgiro, noacbank:noacbank,tgljt:tgljt, kontakid:kontakid, bank:bank});
						}
					}
			}
			
