				if(txtterimadari1.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'posupplier = '+idkontak+'');
				if(txtuser.text!='')
					f = FlexGlobals.topLevelApplication.TambahFilter(f,'poinputuser="'+iduser+'"');
				if(txtuang.text!='')
