<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  width="100%" height="100%" creationComplete="f_persiapan()">
	<fx:Script>
		<![CDATA[
			import avmplus.FLASH10_FLAGS;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			public var a:Array = new Array, o:Object = {}, saveas:Boolean=false;
			public var ar:Array, grid:DataGrid, primary:String='', primary2:String='', sumber:String, arrFilter:Array;
			
			public function f_focusOnMe():void
			{
				
			}
			
			public function f_tampildata(halaman:int = 1):void{
//				if(sumber.length == 0){
					FlexGlobals.topLevelApplication.F_wsSearch('tampil', arrFilter[0], halaman, 20, arrFilter[1]+" = '"+primary+"'", arrFilter[2]);
//				}else{
//					FlexGlobals.topLevelApplication.F_wsSearch('tampil', arrFilter[0], halaman, 20, arrFilter[1]+" = '"+primary+"' AND "+sumber+" = '"+primary2+"'", arrFilter[2]);
//				}
			}
			
			public function f_persiapan():void
			{
				ar = [parentApplication.o.arr[2], parentApplication.o.arr[3], parentApplication.o.arr[5], parentApplication.o.arr[4]];
				grid = parentApplication.m.ArrFilter[0];
				primary = grid.dataProvider.getItemAt(grid.selectedCell.rowIndex)[parentApplication.m.ArrFilter[2]];
				primary2 = grid.dataProvider.getItemAt(grid.selectedCell.rowIndex).ojenis;
				sumber = FlexGlobals.topLevelApplication.m.ArrFilter[4];
				arrFilter = [parentApplication.m.ArrFilter[1], parentApplication.m.ArrFilter[2], parentApplication.m.ArrFilter[3]];
				
				FlexGlobals.topLevelApplication.F_RegGrid(parentApplication.o.arr[8][0], parentApplication.o.arr[8][1], [dghistory], 'data');
				f_tampildata();
				
				// Config Paging
				mb.menuBarItems[0].addEventListener(MouseEvent.CLICK, f_mbTampilkan);
				dghistory.addEventListener(flash.events.MouseEvent.DOUBLE_CLICK, f_dgDOUBLE_CLICK);
				txtpaging.addEventListener(flash.events.KeyboardEvent.KEY_DOWN, f_pagingKEY_DOWN);
				txtpaging.restrict = "0-9";
				txtpaging.setStyle("textAlign","center");
				txtpaging.text = "1";
				txtpaging.maxChars = 4;
				imgfirst.addEventListener(MouseEvent.CLICK, f_firstCLICK);
				imgprevious.addEventListener(MouseEvent.CLICK, f_previousCLICK);
				imgnext.addEventListener(MouseEvent.CLICK, f_nextCLICK);
				imglast.addEventListener(MouseEvent.CLICK, f_lastCLICK);
				
				function f_firstCLICK():void
				{
					if(int(txtpaging.text)>1)
						f_tampildata();
				}
				
				function f_previousCLICK():void
				{
					if(int(txtpaging.text)-1>0)
						f_tampildata(int(txtpaging.text)-1);
				}
				
				function f_nextCLICK():void
				{
					f_tampildata(int(txtpaging.text)+1);
				}
				
				function f_lastCLICK():void
				{
					f_tampildata(int(-1));
				}
				
				function f_pagingKEY_DOWN(e:KeyboardEvent):void
				{
					if(e.keyCode == Keyboard.ENTER)
						if(int(txtpaging.text)>0)
							f_tampildata(int(txtpaging.text));
				}
				
				function f_mbTampilkan():void
				{
					if(mb.menuBarItems[0].enabled)
						f_tampildata(int(txtpaging.text));
				}
				
				function f_dgDOUBLE_CLICK():void
				{	
					var idtransaksi:int;
					if(sumber != null){
						idtransaksi = dghistory.dataProvider[dghistory.selectedCell.rowIndex][sumber.toLowerCase()+"idhistory"];
					}
					
					try
					{
						if(dghistory.dataProviderLength > 0)
							FlexGlobals.topLevelApplication.openFormX(parentApplication.l(ar[0]), 1, ar[1], ar[2], ar[3], 't1', '@', ['History', idtransaksi])

					} 
					catch(error:Error) 
					{
						Alert.show(error.message)
					}
				}
			}
			
			
			public function f_filter(target:String):Array
			{
				var paket:String='', wsfilter:String='', sort:String='', wspagenumber:int=0, wsitemlimit:int=0, csfilter:String="", csfield:int=0, checkbox:Boolean = false;
				switch(target){
					
				}
				return [paket, wsfilter, sort, wspagenumber, wsitemlimit, csfilter, csfield, checkbox];
			}
			
			public function f_wsHasil():void
			{
				var ws:Object, s:String = parentApplication.subject, i:int;
				if(parentApplication.wsSuccess){
					if(parentApplication.wsArrUtama.getItemAt.length >= 0)ws = parentApplication.wsArrUtama.getItemAt(0)
					switch(s){
						case "tampil":
							dghistory.dataProvider = FlexGlobals.topLevelApplication.wsArrUtama;
							imgfirst.enabled = parentApplication.wsIsPrev;
							imgprevious.enabled = parentApplication.wsIsPrev;
							imgnext.enabled = parentApplication.wsIsNext;
							imglast.enabled = parentApplication.wsIsNext;
							txtpaging.text = parentApplication.wsCurPage;
							for(i=0;i<dghistory.dataProviderLength;i++)
								dghistory.dataProvider[i].no = (((parentApplication.wsCurPage-1)*20)+(i+1));
							parentApplication.F_dgRefresh(dghistory)
							dghistory.setFocus();
							dghistory.setSelectedCell(0, 0);
							break;
					}
				}else{	
					Alert.show(parentApplication.wsErrmessage, 'Information');
//					if(parentApplication.F_validasiFalse(s))
//						switch(s){
//							case "tampil":
//								break;
//						}
				}
			}
			
			public function f_kosongkanText(target:String):void
			{
				switch(target){
					
				}
			}
			
			public function f_hitungTotal():void{}
			
			[Bindable] [Embed(source="assets/tb/preview.png")]  public var tbpreview:Class;
			[Bindable] [Embed(source="assets/nav/f.png")] public var navf:Class;
			[Bindable] [Embed(source="assets/nav/p.png")] public var navp:Class;
			[Bindable] [Embed(source="assets/nav/n.png")] public var navn:Class;
			[Bindable] [Embed(source="assets/nav/l.png")] public var navl:Class;
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:XMLListCollection id="xmlListColl">
			<s:source>
				<fx:XMLList xmlns="list">
					<topmenu label="Tampilkan" icon="tbpreview"/>
				</fx:XMLList>
			</s:source>
		</s:XMLListCollection> 
	</fx:Declarations>
	<mx:MenuBar id="mb" left="0" right="0" top="0" height="30" cornerRadius="0" dataProvider="{xmlListColl}" iconField="@icon" labelField="@label"/>
	<s:Group right="5" top="4">
		<s:Image id="imgfirst" left="1" bottom="3" source="{navf}"/>
		<s:Image id="imgprevious" left="18" bottom="3" source="{navp}"/>
		<s:TextInput id="txtpaging" left="35" bottom="0" width="42" text="0"/>
		<s:Image id="imgnext" left="78" bottom="3" source="{navn}"/>
		<s:Image id="imglast" left="96" bottom="3" source="{navl}"/>
	</s:Group>
	<s:DataGrid left="0" right="0" bottom="0" top="28" id="dghistory" doubleClickEnabled="true" sortableColumns="false"/>
</s:Module>