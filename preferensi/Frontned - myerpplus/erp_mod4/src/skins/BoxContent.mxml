<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:mx="library://ns.adobe.com/flex/mx">
	<!-- host component -->
	<fx:Metadata>
		[HostComponent("spark.components.BorderContainer")]
	</fx:Metadata>
	
	<!-- states -->
	<s:states>
		<s:State name="disabled" />
		<s:State name="normal" />
	</s:states>
	<!--backgroundColor="#202328"
	borderAlpha="500" borderColor="#1e2125" borderStyle="inset"
	borderVisible="true" borderWeight="5"-->
	<!-- SkinParts
	name=contentGroup, type=spark.components.Group, required=false
	-->
	<!-- background -->
	<s:Rect  radiusX="4" radiusY="4"
		left="0" right="0" 
		top="0" bottom="0"
		>
		<s:fill>
			<s:SolidColor 
				color="#202328"
				/>
		</s:fill>
	</s:Rect>
	
	<s:Rect id="ImgHeader" height="2" left="2" right="2" y="0">
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry color="#1e2125" />
				<s:GradientEntry color="#121417" />
				<s:GradientEntry color="#1d2024" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect width="2" top="2" bottom="2" y="0">
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry color="#1e2125" />
				<s:GradientEntry color="#121417" />
				<s:GradientEntry color="#1d2024" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect height="2" left="2" right="2" bottom="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry color="#1e2125" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect height="2" top="2" bottom="2" right="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry color="#1e2125" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
</s:Skin>
